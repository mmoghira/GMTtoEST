---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import RelatedToolsWidget from "theme/components/RelatedToolsWidget.astro";

type Props = {
  lang: string;
  dir: 'ltr' | 'rtl';
  title: string;
  description: string;
  slug: string;
  toolName: string;
  toolDescription: string;
  meta?: any;
  pubDate?: string;
  updatedDate?: string;
};

const { lang, dir, title, description, slug, toolName, toolDescription, meta, pubDate, updatedDate } = Astro.props;
---

<BaseLayout 
  lang={lang} 
  dir={dir} 
  title={title} 
  description={description} 
  slug={slug} 
  meta={meta}
  enableFaqSchema={true}
  enableArticleSchema={false}
>
  <div class="tool-hero hero-banner">
    <h1 class="hero-banner-title">{toolName}</h1>
    <p class="tool-hero-desc">{toolDescription}</p>
  </div>
  
  <div class="tool-container">
    <slot name="tool" />
  </div>

  <div class="content">
    <slot />
  </div>
  
  <div class="faq">
    <slot name="faq" />
  </div>

  <RelatedToolsWidget currentSlug={slug} lang={lang} />

  {updatedDate && (
    <div class="last-updated">
      <p>Last updated: <time datetime={updatedDate}>{new Date(updatedDate).toLocaleDateString()}</time></p>
    </div>
  )}
</BaseLayout>
