    <script is:inline>
      // Back to Top Button Handler
      (function setupBackToTop() {
        const btn = document.getElementById('back-to-top');
        if (!btn) return;

        let ticking = false;
        function updateButtonState() {
          if (window.pageYOffset > 300) {
            btn.classList.add('show');
          } else {
            btn.classList.remove('show');
          }
          ticking = false;
        }

        function onScroll() {
          if (!ticking) {
            window.requestAnimationFrame(updateButtonState);
            ticking = true;
          }
        }

        window.addEventListener('scroll', onScroll, { passive: true });
        btn.addEventListener('click', function() {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });

        updateButtonState();
      })();
    </script>
        <script is:inline>
      // Shopping Clutter & Sticky Shopping Bar Controller
      (function initShoppingClutterControl() {
        var DISMISSED_KEY = 'gmt_shopping_bar_dismissed';

        function cleanMidParagraphShoppingPills() {
          var paragraphs = document.querySelectorAll('p');
          for (var i = 0; i < paragraphs.length; i++) {
            var p = paragraphs[i];
            var pills = p.querySelectorAll('.google-anno, [class*="google-anno"], .shopping-pill, a[href*="google.com/search"][class*="anno"]');
            for (var j = 0; j < pills.length; j++) {
              pills[j].remove();
            }
            var inlineLinks = p.querySelectorAll('a');
            for (var k = 0; k < inlineLinks.length; k++) {
              var a = inlineLinks[k];
              var text = (a.textContent || '').trim().toLowerCase();
              if (text === 'order calendars' || text === 'order calendar' || text === 'shop wall clocks' || text === 'shop wall clock') {
                a.remove();
              }
            }
          }
        }

        function setupStickyShoppingBars() {
          var isDismissed = false;
          try {
            isDismissed = localStorage.getItem(DISMISSED_KEY) === 'true';
          } catch (e) {}

          var shoppingBars = document.querySelectorAll('.gmt-sticky-shopping-bar, [class*="shopping-bar"], [id*="shopping-bar"]');

          if (isDismissed) {
            shoppingBars.forEach(function(bar) {
              bar.classList.add('is-hidden');
              bar.style.display = 'none';
            });
            return;
          }

          shoppingBars.forEach(function(bar) {
            if (!bar.querySelector('.gmt-shopping-bar-close')) {
              var closeBtn = document.createElement('button');
              closeBtn.type = 'button';
              closeBtn.className = 'gmt-shopping-bar-close';
              closeBtn.setAttribute('aria-label', 'Close shopping recommendation');
              closeBtn.innerHTML = '&times;';
              closeBtn.addEventListener('click', function(e) {
                e.stopPropagation();
                bar.classList.add('is-hidden');
                setTimeout(function() { bar.style.display = 'none'; }, 250);
                try {
                  localStorage.setItem(DISMISSED_KEY, 'true');
                } catch (err) {}
              });
              bar.appendChild(closeBtn);
            }
          });

          // Prevent covering #converter or converter interactive elements
          var converterEl = document.getElementById('converter') || document.querySelector('.converter-section');
          if (converterEl && 'IntersectionObserver' in window) {
            var observer = new IntersectionObserver(function(entries) {
              var isIntersecting = entries.some(function(entry) { return entry.isIntersecting; });
              shoppingBars.forEach(function(bar) {
                if (isDismissed) return;
                if (isIntersecting) {
                  bar.classList.add('is-hidden');
                } else {
                  bar.classList.remove('is-hidden');
                }
              });
            }, { threshold: 0.1 });
            observer.observe(converterEl);
          }
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', function() {
            cleanMidParagraphShoppingPills();
            setupStickyShoppingBars();
          });
        } else {
          cleanMidParagraphShoppingPills();
          setupStickyShoppingBars();
        }

        if ('MutationObserver' in window) {
          var mutObserver = new MutationObserver(function() {
            cleanMidParagraphShoppingPills();
            setupStickyShoppingBars();
          });
          mutObserver.observe(document.body, { childList: true, subtree: true });
        }
      })();
    </script>

