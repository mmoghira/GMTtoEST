---
import "src/styles/global.css";
import Header from "theme/components/Header.astro";
import NavigationSchema from "theme/components/NavigationSchema.astro";
import { getTranslation, languages, pageUrl, siteUrl } from "theme/i18n/config";

type Props = {
  lang: string;
  dir: "ltr" | "rtl";
  title: string;
  description: string;
  slug?: string;
  mode?: string;
  meta?: any;
};

const { lang, dir, title, description, slug = "", mode = "gmt-est", meta = {} } = Astro.props;
const t = getTranslation(lang);
const canonical = `${siteUrl}${pageUrl(lang, slug)}`;
const metaKeywords = meta && meta.keywords ? meta.keywords : t.seoKeywords;

// Navigation structure for schema
const navItems = [
  { url: pageUrl(lang, ""), name: t.pages?.home || "Home", position: 1 },
  { url: pageUrl(lang, "gmt-to-est"), name: t.pages?.gmtToEst || "GMT to EST", position: 2 },
  { url: pageUrl(lang, "est-to-gmt"), name: t.pages?.estToGmt || "EST to GMT", position: 3 },
  { url: pageUrl(lang, "gmt-vs-est"), name: t.pages?.gmtVsEst || "GMT vs EST", position: 4 },
  { url: pageUrl(lang, "time-zone-guide"), name: t.pages?.guide || "Time Zone Guide", position: 5 }
];

const isHome = slug === "";

const schema = [
  // ── 1. WebSite (enables Sitelinks Searchbox & site identity) ──────────────
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${siteUrl}/#website`,
    url: siteUrl,
    name: "GMT to EST Converter",
    alternateName: "GMTtoEST",
    description: "Free, accurate GMT to EST and EST to GMT timezone converter. Accounts for daylight saving time.",
    inLanguage: languages.map(l => l.code),
    potentialAction: {
      "@type": "SearchAction",
      target: {
        "@type": "EntryPoint",
        urlTemplate: `${siteUrl}/?q={search_term_string}`
      },
      "query-input": "required name=search_term_string"
    }
  },

  // ── 2. Organization ────────────────────────────────────────────────────────
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": `${siteUrl}/#organization`,
    name: "GMT to EST Converter",
    url: siteUrl,
    logo: {
      "@type": "ImageObject",
      "@id": `${siteUrl}/#logo`,
      url: `${siteUrl}/assets/logo.png`,
      width: 512,
      height: 512,
      caption: "GMT to EST Converter"
    },
    image: { "@id": `${siteUrl}/#logo` },
    description: "Free timezone converter and guide for GMT and Eastern Standard Time (EST/EDT).",
    foundingDate: "2024",
    contactPoint: {
      "@type": "ContactPoint",
      contactType: "customer support",
      email: "gmttoestconverter@gmail.com",
      availableLanguage: languages.map(l => l.code),
      areaServed: "Worldwide"
    }
  },

  // ── 3. WebApplication (per-page) ───────────────────────────────────────────
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "@id": `${canonical}#app`,
    name: title,
    url: canonical,
    description,
    applicationCategory: "UtilitiesApplication",
    operatingSystem: "Any",
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "USD"
    },
    featureList: [
      "GMT to EST conversion",
      "EST to GMT conversion",
      "Daylight Saving Time aware",
      "Multi-language support"
    ],
    isPartOf: { "@id": `${siteUrl}/#website` },
    author: { "@id": `${siteUrl}/#organization` }
  },

  // ── 4. BreadcrumbList (per-page) ───────────────────────────────────────────
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${canonical}#breadcrumb`,
    itemListElement: isHome
      ? [{ "@type": "ListItem", position: 1, name: t.brand || "GMT to EST Converter", item: `${siteUrl}${pageUrl(lang, "")}` }]
      : [
          { "@type": "ListItem", position: 1, name: t.brand || "GMT to EST Converter", item: `${siteUrl}${pageUrl(lang, "")}` },
          { "@type": "ListItem", position: 2, name: title, item: canonical }
        ]
  },

  // ── 5. FAQPage (homepage only) ─────────────────────────────────────────────
  ...(isHome && t.faqs?.items?.length ? [{
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${canonical}#faq`,
    mainEntity: t.faqs.items.map((item: any) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a }
    }))
  }] : [])
];
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | GMT to EST</title>
    <meta name="description" content={description} />
    {metaKeywords && <meta name="keywords" content={metaKeywords} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/assets/favicon-192.png" sizes="192x192" />
    <link rel="image_src" href="/assets/logo.png" />
    <meta property="og:image" content="/assets/logo.png" />
    {languages.map((item) => <link rel="alternate" hreflang={item.code} href={`${siteUrl}${pageUrl(item.code, slug)}`} />)}
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}${pageUrl("en", slug)}`} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <NavigationSchema lang={lang} t={t} />
    <script is:inline>
      const savedTheme = localStorage.getItem("theme");
      if (savedTheme) document.documentElement.dataset.theme = savedTheme;
    </script>
    <slot name="head" />
  </head>
  <body data-lang={lang} data-mode={mode}>
    <Header lang={lang} t={t} slug={slug} />
    <main>
      <slot />
    </main>
    <footer>
      <div class="footer-container">
        <!-- Brand Section -->
        <div class="footer-section brand-section">
          <a href={pageUrl(lang, "")} class="footer-logo">
            <img src="/assets/logo.png" alt="GMT to EST logo" class="footer-logo-icon" />
            <span class="site-name">GMT to EST Converter</span>
          </a>
          <p class="brand-desc">{t.brand} - Free timezone converter for GMT and EST time zones</p>
          <div class="social-links">
            <a href="#" aria-label="Facebook" title="Facebook">
              <svg viewBox="0 0 24 24" fill="currentColor" height="20" width="20"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.469h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
            <a href="#" aria-label="Instagram" title="Instagram">
              <svg viewBox="0 0 24 24" fill="currentColor" height="20" width="20"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
            </a>
            <a href="#" aria-label="LinkedIn" title="LinkedIn">
              <svg viewBox="0 0 24 24" fill="currentColor" height="20" width="20"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            </a>
            <a href="#" aria-label="Pinterest" title="Pinterest">
              <svg viewBox="0 0 24 24" fill="currentColor" height="20" width="20"><path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.354-.629-2.758-1.379l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146 1.123.345 2.306.535 3.55.535 6.607 0 11.985-5.365 11.985-11.987C23.97 5.367 18.624 0 12.017 0z"/></svg>
            </a>
          </div>
        </div>

        <!-- Links Section -->
        <div class="footer-section links-section">
          <h3 class="footer-heading">PAGES</h3>
          <ul class="footer-links">
            <li><a href={lang === "en" ? "/about-us/" : `/${lang}/about/`}>{t.footer.about}</a></li>
            <li><a href={pageUrl(lang, "gmt-to-est")}>{t.footer.gmtToEst}</a></li>
            <li><a href={pageUrl(lang, "est-to-gmt")}>{t.footer.estToGmt}</a></li>
            <li><a href={pageUrl(lang, "gmt-vs-est")}>{t.footer.difference}</a></li>
            <li><a href={lang === "en" ? "/privacy-policy/" : `/${lang}/privacy-policy/`}>{t.footer.privacy}</a></li>
            <li><a href={lang === "en" ? "/terms-of-service/" : `/${lang}/terms-of-service/`}>{t.footer.terms || "Terms of Service"}</a></li>
            <li><a href={lang === "en" ? "/contact-us/" : `/${lang}/contact-us/`}>{t.footer.contact}</a></li>
            <li><a href={lang === "en" ? "/sitemap/" : `/${lang}/sitemap/`}>{t.footer.sitemap}</a></li>
          </ul>
        </div>

        <!-- Contact Section -->
        <div class="footer-section contact-section">
          <h3 class="footer-heading">CONTACT</h3>
          <div class="contact-item">
            <span class="contact-icon">✉</span>
            <a href="mailto:gmttoestconverter@gmail.com">gmttoestconverter@gmail.com</a>
          </div>
          <div class="contact-item">
            <span class="contact-icon">📞</span>
            <a href="tel:+1234567890">Support Available</a>
          </div>
        </div>

        <!-- Language Switch Section -->
        <div class="footer-section language-section">
          <h3 class="footer-heading">LANGUAGE</h3>
          <div class="footer-lang-grid">
            {languages.map((item) => (
              <a
                href={pageUrl(item.code, slug)}
                class={`footer-lang-item ${item.code === lang ? 'active' : ''}`}
                title={item.name}
                aria-label={item.name}
              >
                {item.code.toUpperCase()}
              </a>
            ))}
          </div>
        </div>

      </div>

      <!-- Copyright -->
      <div class="footer-bottom">
        <p>&copy; {new Date().getFullYear()} {t.brand}. All rights reserved.</p>
      </div>
    </footer>
    <button id="back-to-top" class="back-to-top" aria-label="Back to top" title="Back to top">
      ↑
    </button>
    <script is:inline>
      // Back to Top Button Handler
      (function setupBackToTop() {
        const btn = document.getElementById('back-to-top');
        if (!btn) return;

        let ticking = false;
        function updateButtonState() {
          if (window.pageYOffset > 300) {
            btn.classList.add('show');
          } else {
            btn.classList.remove('show');
          }
          ticking = false;
        }

        function onScroll() {
          if (!ticking) {
            window.requestAnimationFrame(updateButtonState);
            ticking = true;
          }
        }

        window.addEventListener('scroll', onScroll, { passive: true });
        btn.addEventListener('click', function() {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });

        // Initial state
        updateButtonState();
      })();
    </script>
    <script defer src="/assets/app.js"></script>
  </body>
</html>

<style>
  footer {
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    margin-top: 4rem;
    padding: 3rem 2rem 1.5rem;
  }

  .footer-container {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 2fr 1.2fr 1.2fr 1.2fr;
    gap: 3rem;
    margin-bottom: 2rem;
  }

  /* Brand Section */
  .brand-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    width: fit-content;
    text-decoration: none;
  }

  .footer-logo .footer-logo-icon,
  .footer-logo img {
    width: 56px;
    height: 56px;
    border-radius: 8px;
    object-fit: contain;
  }

  .footer-logo .site-name {
    font-size: 1.2rem;
    font-weight: 700;
    color: #e5e7eb;
  }

  .brand-desc {
    color: #9ca3af;
    font-size: 0.95rem;
    line-height: 1.5;
    margin: 0;
    max-width: 280px;
  }

  .social-links {
    display: flex;
    gap: 1rem;
  }

  .social-links a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 8px;
    color: #e5e7eb;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s ease;
  }

  .social-links a:hover {
    background: #0ea5e9;
    border-color: #0ea5e9;
    color: white;
  }

  /* Section Headings */
  .footer-heading {
    margin: 0 0 1.25rem 0;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #e5e7eb;
    text-transform: uppercase;
  }

  /* Links Section */
  .links-section {
    display: flex;
    flex-direction: column;
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-links a {
    color: #bfdbfe;
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.3s ease;
  }

  .footer-links a:hover {
    color: #0ea5e9;
  }

  /* Contact Section */
  .contact-section {
    display: flex;
    flex-direction: column;
  }

  .contact-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1rem;
    color: #bfdbfe;
    font-size: 0.95rem;
  }

  .contact-icon {
    flex-shrink: 0;
    font-size: 1.25rem;
    width: 1.5rem;
    text-align: center;
  }

  .contact-item a {
    color: #bfdbfe;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .contact-item a:hover {
    color: #0ea5e9;
  }

  /* Language Section */
  .language-section {
    display: flex;
    flex-direction: column;
  }

  .footer-lang-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.5rem;
  }

  .footer-lang-item {
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #9ca3af;
    text-decoration: none;
    border-radius: 8px;
    height: 40px;
    font-size: 0.8rem;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .footer-lang-item:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #e5e7eb;
    border-color: rgba(255, 255, 255, 0.2);
  }

  .footer-lang-item.active {
    background: rgba(14, 165, 233, 0.15);
    border-color: #0ea5e9;
    color: #0ea5e9;
  }

  /* Footer Bottom */
  .footer-bottom {
    max-width: 1400px;
    margin: 0 auto;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    text-align: center;
  }

  .footer-bottom p {
    margin: 0;
    color: #6b7280;
    font-size: 0.9rem;
  }

  /* Back to Top Button */
  .back-to-top {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    width: 50px;
    height: 50px;
    background: #0ea5e9;
    border: none;
    border-radius: 50%;
    color: white;
    font-size: 1.5rem;
    font-weight: bold;
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
    z-index: 1000;
    box-shadow: 0 4px 12px rgba(14, 165, 233, 0.3);
  }

  .back-to-top.show {
    opacity: 1;
    visibility: visible;
  }

  .back-to-top:hover {
    background: #0284c7;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(14, 165, 233, 0.4);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .footer-container {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
    }

  }

  @media (max-width: 768px) {
    footer {
      padding: 2rem 1rem 1rem;
      margin-top: 2rem;
    }

    .footer-container {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .brand-desc {
      max-width: 100%;
    }

    .footer-heading {
      margin-bottom: 1rem;
    }
  }

  @media (max-width: 480px) {
    .footer-links,
    .contact-item {
      font-size: 0.9rem;
    }

    .back-to-top {
      bottom: 1rem;
      right: 1rem;
      width: 44px;
      height: 44px;
      font-size: 1.25rem;
    }
  }
</style>
