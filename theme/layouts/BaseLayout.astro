          // 1. Anchor ads (top or bottom banner)
          var isAnchor = (node.hasAttribute && node.hasAttribute('data-anchor-status')) ||
            (node.className && typeof node.className === 'string' && (node.className.indexOf('google-anno-container') !== -1 || node.className.indexOf('anchor') !== -1)) ||
            (node.id && typeof node.id === 'string' && node.id.indexOf('anchor') !== -1);
          if (isAnchor) {
            node.style.setProperty('position', 'fixed', 'important');
            guardLayoutStyles();
          }

          // 2. Shopping annotations & related topics mid-article
          var text = (node.textContent || '').toLowerCase();
          var isShoppingAnnotation = text.indexOf('topics related to the article') !== -1 ||
            text.indexOf('might interest you') !== -1 ||
            text.indexOf('related topics') !== -1 ||
