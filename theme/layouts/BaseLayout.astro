        var interactEvents = ['scroll', 'touchstart', 'pointerdown'];
        function onInteract() {
          interactEvents.forEach(function(evt) {
            window.removeEventListener(evt, onInteract, { passive: true });
          });
          loadAdSense();
        }
        interactEvents.forEach(function(evt) {
          window.addEventListener(evt, onInteract, { passive: true, once: true });
        });

        // Deferred third-party loaders after window 'load'
        function scheduleDeferred() {
          loadGtag();
          loadAdSense();
          loadSeoSignalX();
        }

        if ('requestIdleCallback' in window) {
          window.addEventListener('load', function() {
            requestIdleCallback(scheduleDeferred, { timeout: 3500 });
          });
        } else {
          window.addEventListener('load', function() {
            setTimeout(scheduleDeferred, 2500);
          });
        }
      })();
    </script>
    <GlobalSearchModal lang={lang} t={t} />
    <CookieConsent lang={lang} />
  </body>
</html>

