---
import "src/styles/global.css";
import Header from "theme/components/Header.astro";
import NavigationSchema from "theme/components/NavigationSchema.astro";
import { getTranslation, languages, pageUrl, siteUrl } from "theme/i18n/config";

type Props = {
  lang: string;
  dir: "ltr" | "rtl";
  title: string;
  description: string;
  slug?: string;
  mode?: string;
  meta?: any;
  enableFaqSchema?: boolean;
  enableArticleSchema?: boolean;
  canonicalPath?: string;
  homePath?: string;
};

const { lang, dir, title, description, slug = "", mode = "gmt-est", meta = {}, enableFaqSchema = false, enableArticleSchema = false, canonicalPath, homePath } = Astro.props;
const t = getTranslation(lang);

function ensureTrailingSlash(pathname: string) {
  if (!pathname || pathname === "/") return "/";
  return pathname.endsWith("/") ? pathname : `${pathname}/`;
}

function toAbsoluteUrl(pathOrUrl: string) {
  const url = new URL(pathOrUrl, `${siteUrl}/`);
  if (!url.pathname.includes(".")) {
    url.pathname = ensureTrailingSlash(url.pathname);
  }
  return url.toString();
}

const canonicalPathResolved = canonicalPath || pageUrl(lang, slug);
const canonical = toAbsoluteUrl(canonicalPathResolved);
const homePathResolved = homePath || pageUrl(lang, "");
const homeUrl = toAbsoluteUrl(homePathResolved);
const hreflangAlternates = [
  { code: lang, href: canonical },
  ...languages
    .filter((item) => item.code !== lang)
    .map((item) => ({
      code: item.code,
      href: toAbsoluteUrl(pageUrl(item.code, slug))
    }))
];
const xDefaultHref = toAbsoluteUrl(pageUrl("en", slug));
const seoTitle = meta?.seoTitle || title;
const metaKeywords = meta && meta.keywords ? meta.keywords : t.seoKeywords;
const rawMetaImage = meta?.image || "/favicon.png";
const metaImage = rawMetaImage.startsWith("http") ? rawMetaImage : `${siteUrl}${rawMetaImage.startsWith("/") ? rawMetaImage : `/${rawMetaImage}`}`;
const metaImageAlt = meta?.imageAlt || title;
const articleDatePublished = meta?.pubDate;
const articleDateModified = meta?.updatedDate || meta?.pubDate;
const articleImageSource = meta?.articleImage || meta?.image || meta?.preloadImage || "/assets/gmt-to-est-converter-featured-image-960.avif";
const articleImage = articleImageSource.startsWith("http") ? articleImageSource : `${siteUrl}${articleImageSource.startsWith("/") ? articleImageSource : `/${articleImageSource}`}`;
const ogType = meta?.ogType || (slug.startsWith("blog/") ? "article" : "website");
const twitterCard = meta?.twitterCard || (meta?.image ? "summary_large_image" : "summary");
const preloadImage = meta?.preloadImage || "/assets/gmt-to-est-converter-featured-image-960.avif";
const preloadImageSrcset = meta?.preloadImageSrcset || "/assets/gmt-to-est-converter-featured-image-480.avif 480w, /assets/gmt-to-est-converter-featured-image-960.avif 960w";
const preloadImageSizes = meta?.preloadImageSizes || "(max-width: 720px) 92vw, 960px";
const preloadImageType = meta?.preloadImageType || "image/avif";

// Navigation structure for schema
const navItems = [
  { url: homePathResolved, name: t.pages?.home || "Home", position: 1 },
  { url: pageUrl(lang, "gmt-to-est"), name: t.pages?.gmtToEst || "GMT to EST", position: 2 },
  { url: pageUrl(lang, "est-to-gmt"), name: t.pages?.estToGmt || "EST to GMT", position: 3 },
  { url: pageUrl(lang, "gmt-vs-est"), name: t.pages?.gmtVsEst || "GMT vs EST", position: 4 },
  { url: pageUrl(lang, "time-zone-guide"), name: t.pages?.guide || "Time Zone Guide", position: 5 }
];

const footerLinks = [
  { href: pageUrl(lang, "about-us"), label: t.footer.about },
  { href: pageUrl(lang, "author"), label: t.footer.author || "Author" },
  { href: pageUrl(lang, "gmt-to-est"), label: t.footer.gmtToEst },
  { href: pageUrl(lang, "est-to-gmt"), label: t.footer.estToGmt },
  { href: pageUrl(lang, "gmt-vs-est"), label: t.footer.difference },
  { href: pageUrl(lang, "privacy-policy"), label: t.footer.privacy },
  { href: pageUrl(lang, "terms-of-service"), label: t.footer.terms || "Terms of Service" },
  { href: pageUrl(lang, "contact-us"), label: t.footer.contact },
  { href: pageUrl(lang, "disclaimer"), label: t.footer.disclaimer || "Disclaimer" },
  { href: pageUrl(lang, "sitemap"), label: t.footer.sitemap }
];

const isHome = slug === "";
const isEnglishHome = lang === "en" && isHome;
const articleSchemas = enableArticleSchema && articleDatePublished ? [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "@id": `${canonical}#article`,
    mainEntityOfPage: canonical,
    headline: seoTitle,
    description,
    image: articleImage,
    datePublished: articleDatePublished,
    dateModified: articleDateModified,
    inLanguage: lang,
    keywords: metaKeywords,
    author: {
      "@type": "Organization",
      name: t.brand || "GMT to EST Converter"
    },
    publisher: {
      "@type": "Organization",
      name: t.brand || "GMT to EST Converter",
      logo: {
        "@type": "ImageObject",
        url: `${siteUrl}/logo.svg`
      }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "@id": `${canonical}#blogposting`,
    mainEntityOfPage: canonical,
    headline: seoTitle,
    description,
    image: articleImage,
    datePublished: articleDatePublished,
    dateModified: articleDateModified,
    inLanguage: lang,
    keywords: metaKeywords,
    author: {
      "@type": "Organization",
      name: t.brand || "GMT to EST Converter"
    },
    publisher: {
      "@type": "Organization",
      name: t.brand || "GMT to EST Converter",
      logo: {
        "@type": "ImageObject",
        url: `${siteUrl}/logo.svg`
      }
    }
  }
] : [];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    // ── 1. WebSite (enables Sitelinks Searchbox & site identity) ──────────────
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      url: siteUrl,
      name: "GMT to EST Converter",
      alternateName: "GMTtoEST",
      description: "Free, accurate GMT to EST and EST to GMT timezone converter. Accounts for daylight saving time.",
      inLanguage: languages.map(l => l.code),
      potentialAction: {
        "@type": "SearchAction",
        target: {
          "@type": "EntryPoint",
          urlTemplate: `${siteUrl}/?q={search_term_string}`
        },
        "query-input": "required name=search_term_string"
      }
    },

    // ── 2. Organization ────────────────────────────────────────────────────────
    {
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      name: "GMT to EST Converter",
      url: siteUrl,
      logo: {
        "@type": "ImageObject",
        "@id": `${siteUrl}/#logo`,
        url: `${siteUrl}/logo.svg`,
        width: 512,
        height: 512,
        caption: "GMT to EST Converter"
      },
      image: { "@id": `${siteUrl}/#logo` },
      description: "Free timezone converter and guide for GMT and Eastern Standard Time (EST/EDT).",
      foundingDate: "2024",
      contactPoint: {
        "@type": "ContactPoint",
        contactType: "customer support",
        email: "gmttoestconverter@gmail.com",
        availableLanguage: languages.map(l => l.code),
        areaServed: "Worldwide"
      }
    },

    // ── 3. WebApplication (per-page) ───────────────────────────────────────────
    {
      "@type": "WebApplication",
      "@id": `${canonical}#app`,
      name: seoTitle,
      url: canonical,
      description,
      applicationCategory: "UtilitiesApplication",
      operatingSystem: "Any",
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD"
      },
      featureList: [
        "GMT to EST conversion",
        "EST to GMT conversion",
        "Daylight Saving Time aware",
        "Multi-language support"
      ],
      isPartOf: { "@id": `${siteUrl}/#website` },
      author: { "@id": `${siteUrl}/#organization` }
    },

    // ── 4. BreadcrumbList (per-page) ───────────────────────────────────────────
    {
      "@type": "BreadcrumbList",
      "@id": `${canonical}#breadcrumb`,
      itemListElement: isHome
        ? [{ "@type": "ListItem", position: 1, name: t.brand || "GMT to EST Converter", item: homeUrl }]
        : [
            { "@type": "ListItem", position: 1, name: t.brand || "GMT to EST Converter", item: homeUrl },
            { "@type": "ListItem", position: 2, name: title, item: canonical }
          ]
    },

    ...articleSchemas,

    // ── 5. FAQPage (pages with a visible FAQ section) ─────────────────────────
    ...(enableFaqSchema && t.faqs?.items?.length ? [{
      "@type": "FAQPage",
      "@id": `${canonical}#faq`,
      mainEntity: t.faqs.items.map((item: any) => ({
        "@type": "Question",
        name: item.q,
        acceptedAnswer: { "@type": "Answer", text: item.a }
      }))
    }] : [])
  ]
};
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-ZY6RBZFSY3"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-ZY6RBZFSY3');
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seoTitle} | GMT to EST</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
    {metaKeywords && <meta name="keywords" content={metaKeywords} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={`${seoTitle} | GMT to EST`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={metaImage} />
    <meta property="og:image:alt" content={metaImageAlt} />
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={`${seoTitle} | GMT to EST`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={metaImage} />
    <meta name="twitter:image:alt" content={metaImageAlt} />
    {articleDatePublished && <meta property="article:published_time" content={articleDatePublished} />}
    {articleDateModified && <meta property="article:modified_time" content={articleDateModified} />}
    <meta name="p:domain_verify" content="9b3f625230ead5b92611adf407a5d0ca"/>
    <meta name="google-site-verification" content="nSvVnbDG53Fvz4UTBw5d1E6sxCuFM0LsuqwPXvCJr1Q" />
    <meta name="msvalidate.01" content="9BB978FBFAF8F85CFFB7B099B245BAA7" />
    <meta name="yandex-verification" content="04e699461da51bbb" />
    <meta name="apple-domain-verification" content="g0KrOt0z2BSpOIO5" />
    <script async type="application/javascript" src="https://news.google.com/swg/js/v1/swg-basic.js"></script>
    <script is:inline>
      (self.SWG_BASIC = self.SWG_BASIC || []).push((basicSubscriptions) => {
        basicSubscriptions.init({
          type: "NewsArticle",
          isPartOfType: ["Product"],
          isPartOfProductId: "CAowiLzgCw:openaccess",
          clientOptions: { theme: "light", lang: "en" }
        });
      });
    </script>
    <link rel="canonical" href={canonical} />
    <link
      rel="preload"
      href={preloadImage}
      imagesrcset={preloadImageSrcset}
      imagesizes={preloadImageSizes}
      as="image"
      type={preloadImageType}
      fetchpriority="high"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/favicon.png" sizes="192x192" />
    <link rel="image_src" href={metaImage} />
    {hreflangAlternates.map((item) => (
      <link rel="alternate" hreflang={item.code} href={item.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <NavigationSchema lang={lang} t={t} homePath={homePathResolved} />
    <script is:inline>
      const savedTheme = localStorage.getItem("theme");
      if (savedTheme) document.documentElement.dataset.theme = savedTheme;
    </script>
    <!-- Microsoft Clarity tracking code, deferred until after first paint/interaction. -->
    <script type="text/javascript" is:inline>
      (function(w,d,a,i){
        w[a]=w[a]||function(){(w[a].q=w[a].q||[]).push(arguments)};
        var loaded=false;
        var events=["pointerdown","keydown","touchstart","scroll"];
        function cleanup(){events.forEach(function(e){w.removeEventListener(e,load,{passive:true});});}
        function load(){
          if(loaded)return;
          loaded=true;
          cleanup();
          var s=d.createElement("script");
          s.async=true;
          s.src="https://www.clarity.ms/tag/"+i;
          d.head.appendChild(s);
        }
        function schedule(){
          var idle=w.requestIdleCallback||function(cb){return w.setTimeout(cb,2500)};
          idle(load,{timeout:3500});
        }
        events.forEach(function(e){w.addEventListener(e,load,{once:true,passive:true});});
        if(d.readyState==="complete")schedule();
        else w.addEventListener("load",schedule,{once:true});
      })(window, document, "clarity", "wp0u5jkzbf");
    </script>
    <slot name="head" />
  </head>
  <body data-lang={lang} data-mode={mode}>
    {isEnglishHome && (
      <p class="seo-keyword-intro seo-keyword-intro--top">
        <strong>{title}</strong> gives instant, date-aware GMT to EST conversion with live clocks, DST handling, meeting presets, and a 24-hour chart.
      </p>
    )}
    <Header lang={lang} t={t} slug={slug} />

    <main>
      <slot />
    </main>
    <footer>
      <div class="footer-container">
        <!-- Brand Section -->
        <div class="footer-section brand-section">
          <a href={homePathResolved} class="footer-logo">
            <img src="/logo.svg" alt="GMT to EST logo" class="footer-logo-icon" width="56" height="56" loading="lazy" decoding="async" />
            <span class="site-name">GMT to EST Converter</span>
          </a>
          <p class="brand-desc">{t.brand} - Free timezone converter for GMT and EST time zones</p>
          <div class="social-links">
            <a href="https://www.facebook.com/GMTtoESTConverter" aria-label="Facebook" title="Facebook" class="social-fb" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" fill="currentColor" height="20" width="20"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.469h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
            <a href="https://x.com/GMTtoEST" aria-label="X (Twitter)" title="X (Twitter)" class="social-x" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" fill="currentColor" height="20" width="20"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"/></svg>
            </a>
            <a href="https://www.linkedin.com/company/gmttoestconverter/" aria-label="LinkedIn" title="LinkedIn" class="social-in" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" fill="currentColor" height="20" width="20"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            </a>
            <a href="https://www.pinterest.com/gmttoestconverter/" aria-label="Pinterest" title="Pinterest" class="social-pi" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" fill="currentColor" height="20" width="20"><path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.354-.629-2.758-1.379l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146 1.123.345 2.306.535 3.55.535 6.607 0 11.985-5.365 11.985-11.987C23.97 5.367 18.624 0 12.017 0z"/></svg>
            </a>
          </div>
        </div>

        <!-- Links Section -->
        <div class="footer-section links-section">
          <h3 class="footer-heading">PAGES</h3>
          <ul class="footer-links">
            {footerLinks.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </div>

        <!-- Contact Section -->
        <div class="footer-section contact-section">
          <h3 class="footer-heading">CONTACT</h3>
          <div class="contact-item">
            <span class="contact-icon">✉</span>
            <a href="mailto:gmttoestconverter@gmail.com">gmttoestconverter@gmail.com</a>
          </div>
          <div class="contact-item">
            <span class="contact-icon">📞</span>
            <a href="tel:+1234567890">Support Available</a>
          </div>
        </div>

        <!-- Language Switch Section -->
        <div class="footer-section language-section">
          <h3 class="footer-heading">LANGUAGE</h3>
          <div class="footer-lang-grid">
            {languages.map((item) => (
              <a
                href={pageUrl(item.code, slug)}
                hreflang={item.code}
                class={`footer-lang-item ${item.code === lang ? 'active' : ''}`}
                title={item.name}
                aria-label={item.name}
                aria-current={item.code === lang ? "page" : undefined}
              >
                {item.code.toUpperCase()}
              </a>
            ))}
          </div>
        </div>

      </div>

      <!-- Copyright -->
      <div class="footer-bottom">
        <div class="footer-bottom-inner">
          <p>&copy; {new Date().getFullYear()} {t.brand}. All rights reserved.</p>
          <a href="https://www.dmca.com/Protection/Status.aspx?ID=YOUR_SITE_ID" title="DMCA.com Protection Status" class="dmca-badge" target="_blank" rel="noopener noreferrer">
            DMCA Protected
          </a>
        </div>
      </div>
    </footer>
    <button id="back-to-top" class="back-to-top" aria-label="Back to top" title="Back to top">
      ↑
    </button>
    <script is:inline>
      // Back to Top Button Handler
      (function setupBackToTop() {
        const btn = document.getElementById('back-to-top');
        if (!btn) return;

        let ticking = false;
        function updateButtonState() {
          if (window.pageYOffset > 300) {
            btn.classList.add('show');
          } else {
            btn.classList.remove('show');
          }
          ticking = false;
        }

        function onScroll() {
          if (!ticking) {
            window.requestAnimationFrame(updateButtonState);
            ticking = true;
          }
        }

        window.addEventListener('scroll', onScroll, { passive: true });
        btn.addEventListener('click', function() {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });

        // Initial state
        updateButtonState();
      })();
    </script>
    <script defer src="/assets/app.js"></script>
  </body>
</html>

<style>
  footer {
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    margin-top: 4rem;
    padding: 3rem 2rem 1.5rem;
  }

  .footer-container {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 2fr 1.2fr 1.2fr 1.2fr;
    gap: 3rem;
    margin-bottom: 2rem;
  }

  /* Brand Section */
  .brand-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    width: fit-content;
    text-decoration: none;
  }

  .footer-logo .footer-logo-icon,
  .footer-logo img {
    width: 56px;
    height: 56px;
    border-radius: 8px;
    object-fit: contain;
  }

  .footer-logo .site-name {
    font-size: 1.2rem;
    font-weight: 700;
    color: #e5e7eb;
  }

  .brand-desc {
    color: #9ca3af;
    font-size: 0.95rem;
    line-height: 1.5;
    margin: 0;
    max-width: 280px;
  }

  .social-links {
    display: flex;
    gap: 1rem;
  }

  .social-links a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 8px;
    color: #e5e7eb;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s ease;
  }

  .social-links a.social-fb { background: rgba(24, 119, 242, 0.1); border-color: rgba(24, 119, 242, 0.2); color: #1877F2; }
  .social-links a.social-fb:hover { background: #1877F2; border-color: #1877F2; color: white; transform: translateY(-3px); }

