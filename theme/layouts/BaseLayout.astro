---
import "src/styles/global.css";
import Header from "theme/components/Header.astro";
import NavigationSchema from "theme/components/NavigationSchema.astro";
import GlobalSearchModal from "theme/components/GlobalSearchModal.astro";
import Footer from "theme/components/Footer.astro";
import CookieConsent from "theme/components/CookieConsent.astro";
import { getConverterDisplayName, getTranslation, languages, keptLanguageCodes, isKeptLanguage, keptLanguages, pageUrl, pages, siteUrl } from "theme/i18n/config";

type Props = {
  lang: string;
  dir: "ltr" | "rtl";
  title: string;
  description: string;
  slug?: string;
  mode?: string;
  meta?: any;
  enableFaqSchema?: boolean;
  enableArticleSchema?: boolean;
  canonicalPath?: string;
  homePath?: string;
  allowAds?: boolean;
  robots?: string;
  breadcrumbHomeLabel?: string;
  breadcrumbLabel?: string;
  hreflangCodes?: string[];
};

const { lang, dir, title, description, slug = "", mode = "gmt-est", meta = {}, enableFaqSchema = false, enableArticleSchema = false, canonicalPath, homePath, allowAds, robots, breadcrumbHomeLabel, breadcrumbLabel, hreflangCodes } = Astro.props;
const t = getTranslation(lang);

function ensureTrailingSlash(pathname: string) {
  if (!pathname || pathname === "/") return "/";
  return pathname.endsWith("/") ? pathname : `${pathname}/`;
}

function toAbsoluteUrl(pathOrUrl: string) {
  const url = new URL(pathOrUrl, `${siteUrl}/`);
  if (!url.pathname.includes(".")) {
    url.pathname = ensureTrailingSlash(url.pathname);
  }
  return url.toString();
}

function truncateSeoText(value: string, maxLength: number) {
  if (value.length <= maxLength) return value;
  const sliced = value.slice(0, maxLength - 1);
  const lastSpace = sliced.lastIndexOf(" ");
  const clean = lastSpace >= Math.floor(maxLength * 0.65) ? sliced.slice(0, lastSpace) : sliced;
  return `${clean.trim()}…`;
}

const canonicalPathResolved = canonicalPath || pageUrl(lang, slug);
const canonical = toAbsoluteUrl(canonicalPathResolved);
const homePathResolved = homePath || pageUrl(lang, "");
const homeUrl = toAbsoluteUrl(homePathResolved);
const globalStaticSlugs = [
  "terms-of-service",
  "contact-us",
  "about-us",
  "author",
  "author/jackie-bruce",
  "privacy-policy",
  "disclaimer",
  "sitemap"
];

const utilitySlugs = [
  "tools",
  "world-clock",
  "meeting-planner",
  "event-time-converter",
  "time-difference-calculator",
  "business-hours-overlap",
  "holiday-calendar",
  "travel-planner",
  "developer-tools"
];

const isNonEnglishBoilerplateOrUtility = lang !== "en" && (globalStaticSlugs.includes(slug) || slug.startsWith("author") || utilitySlugs.includes(slug));
const defaultRobots = isNonEnglishBoilerplateOrUtility ? "noindex,follow" : "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1";
const robotsContent = robots || meta?.robots || defaultRobots;
const isEs = lang === "es";
const isDe = lang === "de";
const isFr = lang === "fr";
const isIt = lang === "it";
const isPt = lang === "pt";
const isPl = lang === "pl";
const isNl = lang === "nl";
const isTr = lang === "tr";
const ogLocaleMap: Record<string, string> = {
  de: "de_DE",
  es: "es_ES",
  fr: "fr_FR",
  it: "it_IT",
  pt: "pt_BR",
  ru: "ru_RU",
  ja: "ja_JP",
  ko: "ko_KR",
  zh: "zh_CN",
  ar: "ar_AR",
  tr: "tr_TR",
  pl: "pl_PL",
  nl: "nl_NL",
  en: "en_US"
};
const ogLocale = ogLocaleMap[lang] || "en_US";
const breadcrumbHome = breadcrumbHomeLabel || (isEs ? "Inicio" : isDe ? "Startseite" : isFr ? "Accueil" : isIt ? "Home" : isPt ? "Início" : isPl ? "Strona główna" : isNl ? "Startpagina" : isTr ? "Ana Sayfa" : "Home");
const isNoindexPage = robotsContent.toLowerCase().includes("noindex");
const isKept = isKeptLanguage(lang);
const mainTranslatedSlugs = ["", "gmt-to-est", "est-to-gmt", "gmt-vs-est", "time-zone-guide"];

// Hreflang alternates: ONLY generated on indexable kept language pages, and ONLY among kept language versions
let computedHreflangCodes: string[] = [];

if (isNoindexPage || !isKept) {
  // Suppress hreflang on noindexed pages and demoted languages to ensure 100% reciprocal hygiene
  computedHreflangCodes = [];
} else if (hreflangCodes) {
  computedHreflangCodes = hreflangCodes.filter((code) => isKeptLanguage(code));
} else if (mainTranslatedSlugs.includes(slug) || pages.some((p: any) => p.slug === slug)) {
  computedHreflangCodes = [...keptLanguageCodes];
} else {
  // English-only pages (e.g. guides)
  computedHreflangCodes = ["en"];
}

const hreflangAlternates = computedHreflangCodes.map((code) => ({
  code,
  href: toAbsoluteUrl(pageUrl(code, slug))
}));

const showXDefault = !isNoindexPage && isKept && computedHreflangCodes.length > 0;
const xDefaultHref = toAbsoluteUrl(pageUrl("en", slug));
const seoTitle = (lang === "en" ? meta?.seoTitle : undefined) || title;
const titleNeedsLongBrand = !meta?.exactTitle && seoTitle.length < 30;
const titleCanUseShortBrand = !meta?.exactTitle && !["de", "es", "fr", "it", "pt", "pl", "nl"].includes(lang) && !seoTitle.toLowerCase().includes("gmt to est") && seoTitle.length + 13 <= 60;
const brandedTitle = meta?.exactTitle
  ? seoTitle
  : isDe
  ? (titleNeedsLongBrand && !seoTitle.includes("GMT zu EST") ? `${seoTitle} | GMT zu EST Umrechner` : seoTitle)
  : isEs
    ? (titleNeedsLongBrand && !seoTitle.includes("GMT a EST") ? `${seoTitle} | Convertidor GMT a EST` : seoTitle)
    : isFr
      ? (titleNeedsLongBrand && !seoTitle.includes("GMT vers EST") ? `${seoTitle} | Convertisseur GMT vers EST` : seoTitle)
      : isIt
        ? (titleNeedsLongBrand && !seoTitle.includes("da GMT a EST") && !seoTitle.includes("GMT a EST") ? `${seoTitle} | Convertitore da GMT a EST` : seoTitle)
        : isPt
          ? (titleNeedsLongBrand && !seoTitle.includes("de GMT para EST") && !seoTitle.includes("GMT para EST") ? `${seoTitle} | Conversor de GMT para EST` : seoTitle)
          : isPl
            ? (titleNeedsLongBrand && !seoTitle.includes("GMT na EST") ? `${seoTitle} | Konwerter GMT na EST` : seoTitle)
            : isTr
              ? (titleNeedsLongBrand && !seoTitle.includes("GMT EST") && !seoTitle.includes("GMT - EST") ? `${seoTitle} | GMT EST Dönüştürücü` : seoTitle)
            : isNl
              ? (titleNeedsLongBrand && !seoTitle.includes("GMT naar EST") ? `${seoTitle} | GMT naar EST Omrekenaar` : seoTitle)
              : titleNeedsLongBrand
                ? `${seoTitle} | GMT to EST Time Converter`
                : titleCanUseShortBrand
                  ? `${seoTitle} | GMT to EST`
                  : seoTitle;
const documentTitle = truncateSeoText(brandedTitle, 60);
const descriptionWithContext = description.length < 70 ? `${title}. ${description}` : description;
const descriptionExtensions: Record<string, string> = {
  ja: "日付に応じた正確な時差と変換結果を確認できます。",
  ko: "날짜별 정확한 시차와 변환 결과를 확인할 수 있습니다.",
  zh: "可按日期查看准确时差、夏令时状态和转换结果。"
};
const expandedDescription = descriptionWithContext.length < 70 && descriptionExtensions[lang]
  ? `${descriptionWithContext} ${descriptionExtensions[lang]}`
  : descriptionWithContext;
const seoDescription = truncateSeoText(expandedDescription, 155);
const suppliedKeywords = meta?.keywords || t.seoKeywords || "time zone converter, GMT, EST, daylight saving time";
const metaKeywords = `${title}, ${suppliedKeywords}`;
const rawMetaImage = meta?.image || "/images/og/default.png";
const metaImage = rawMetaImage.startsWith("http") ? rawMetaImage : `${siteUrl}${rawMetaImage.startsWith("/") ? rawMetaImage : `/${rawMetaImage}`}`;
const metaImageAlt = meta?.imageAlt || title;
const imageExtension = rawMetaImage.split('.').pop()?.toLowerCase();
const ogImageType = imageExtension === 'webp' ? 'image/webp' :
                    imageExtension === 'avif' ? 'image/avif' :
                    imageExtension === 'jpg' || imageExtension === 'jpeg' ? 'image/jpeg' :
                    imageExtension === 'svg' ? 'image/svg+xml' : 'image/png';
const articleDatePublished = meta?.pubDate;
const articleDateModified = meta?.updatedDate || meta?.pubDate;
const articleImageSource = meta?.articleImage || meta?.image || meta?.preloadImage || "/assets/gmt-to-est-converter-featured-image-960.avif";
const articleImage = articleImageSource.startsWith("http") ? articleImageSource : `${siteUrl}${articleImageSource.startsWith("/") ? articleImageSource : `/${articleImageSource}`}`;
const ogType = meta?.ogType || (slug.startsWith("blog/") ? "article" : "website");
const showArticleMetaTags = ogType === "article" && !!articleDatePublished;
const twitterCard = meta?.twitterCard || "summary_large_image";
const preloadImage = meta?.preloadImage;
const preloadImageSrcset = meta?.preloadImageSrcset;
const preloadImageSizes = meta?.preloadImageSizes || "(max-width: 720px) 92vw, 960px";
const preloadImageType = meta?.preloadImageType || "image/avif";

// Navigation structure for schema
const navItems = [
  { url: homePathResolved, name: t.pages?.gmtToEst?.title || (isEs ? "Convertidor GMT a EST" : isDe ? "GMT zu EST Umrechner" : "GMT to EST Converter"), position: 1 },
  { url: pageUrl(lang, "est-to-gmt"), name: t.pages?.estToGmt?.title || (isEs ? "Convertidor EST a GMT" : isDe ? "EST in GMT umrechnen" : "EST to GMT Converter"), position: 2 },
  { url: pageUrl(lang, "gmt-vs-est"), name: t.pages?.gmtVsEst?.title || (isEs ? "Diferencia entre GMT y EST" : isDe ? "GMT vs. EST Unterschied" : "GMT vs EST Difference"), position: 3 },
  { url: pageUrl(lang, "time-zone-guide"), name: t.pages?.guide?.title || (isEs ? "Guía de zonas horarias" : isDe ? "Zeitzonen-Ratgeber" : "Time Zone Guide"), position: 4 }
];

const isHome = slug === "";
const isEnglishHome = lang === "en" && isHome;
const isComparison = slug === "gmt-vs-est";
const isReverse = slug === "est-to-gmt";
const isGuide = slug === "time-zone-guide";
const registeredPage = pages.find((p: any) => p.slug === slug);
const isDynamic = registeredPage ? registeredPage.kind === "dynamic" : (slug.endsWith("-to-est") || slug.startsWith("gmt-to-"));
const isConverterPage = isHome || isComparison || isReverse || isDynamic;
const breadcrumbCurrentLabel = breadcrumbLabel || title;

const isUtilityPage = ["", "est-to-gmt", "gmt-vs-est", "time-zone-guide"].includes(slug);
// AdSense is now approved. Load Auto Ads site-wide on all pages.
// Pages can still opt out individually with allowAds={false}.
const shouldLoadAds = allowAds !== false;

// SoftwareApplication schema for the homepage and every converter page.
const converterAppSchema = isConverterPage ? [
  {
    "@type": "SoftwareApplication",
    "@id": `${canonical}#software-application`,
    name: getConverterDisplayName(pages.find((page: any) => page.slug === slug), lang) || seoTitle,
    url: canonical,
    inLanguage: lang,
    description: meta?.appDescription || description,
    applicationCategory: meta?.applicationCategory || "UtilityApplication",
    operatingSystem: meta?.operatingSystem || "Any",
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "USD"
    }
  }
] : [];

const organizationSchema = {
  "@type": "Organization",
  "@id": `${siteUrl}/#organization`,
  name: t.brand || "GMT to EST Converter",
  url: siteUrl,
  logo: {
    "@type": "ImageObject",
    url: `${siteUrl}/logo.svg`
  },
  sameAs: [
    "https://www.facebook.com/GMTtoESTConverter",
    "https://x.com/GMTtoEST",
    "https://www.linkedin.com/company/gmttoestconverter",
    "https://www.youtube.com/@gmttoestconverter",
    "https://www.instagram.com/gmttoestconverter/",
    "https://www.pinterest.com/gmttoestconverter/",
    "https://www.tiktok.com/@gmttoestconverter"
  ],
  publishingPrinciples: `${siteUrl}/editorial-policy/`,
  knowsAbout: [
    { "@type": "Thing", "name": "Coordinated Universal Time", "sameAs": "http://www.wikidata.org/entity/Q1536" },
    { "@type": "Thing", "name": "Greenwich Mean Time", "sameAs": "http://www.wikidata.org/entity/Q30" },
    { "@type": "Thing", "name": "Eastern Standard Time", "sameAs": "http://www.wikidata.org/entity/Q20853" },
    { "@type": "Thing", "name": "Daylight Saving Time", "sameAs": "http://www.wikidata.org/entity/Q36669" },
    { "@type": "Thing", "name": "IANA Time Zone Database", "sameAs": "http://www.wikidata.org/entity/Q1052601" },
    "Coordinated Universal Time (UTC)",
    "Greenwich Mean Time (GMT)",
    "Eastern Standard Time (EST)",
    "Daylight Saving Time (DST)",
    "IANA Time Zone Database",
    "Time Zone Conversion Math"
  ]
};

const authorPersonSchema = {
  "@type": "Person",
  "@id": `${siteUrl}/author/#author`,
  name: "Jackie Bruce",
  jobTitle: isFr
    ? "Spécialiste de la conversion de fuseaux horaires"
    : isDe
      ? "Senior Zeitzonenspezialist & Systemingenieur"
      : isEs
        ? "Especialista sénior en zonas horarias"
        : isIt
          ? "Specialista in conversioni di fusi orari e ingegneria dei sistemi"
          : isPt
            ? "Especialista sênior em fusos horários e engenharia de sistemas"
            : isPl
              ? "Specjalistka ds. treści o strefach czasowych"
              : isTr
                ? "Kıdemli Saat Dilimi Uzmanı ve Sistem Mühendisi"
                : isNl
                ? "Senior Tijdzonespecialist & Systeemingenieur"
                : "Senior Time Zone Specialist & Systems Engineer",
  url: isPl ? `${siteUrl}/pl/author/` : isNl ? `${siteUrl}/nl/author/` : isTr ? `${siteUrl}/tr/author/` : `${siteUrl}/author/`,
  worksFor: { "@id": `${siteUrl}/#organization` }
};

const webPageSchema = {
  "@type": "WebPage",
  "@id": `${canonical}#webpage`,
  url: canonical,
  name: seoTitle,
  description: seoDescription,
  inLanguage: lang,
  isPartOf: { "@id": `${siteUrl}/#website` },
  breadcrumb: { "@id": `${canonical}#breadcrumb` },
  primaryImageOfPage: {
    "@type": "ImageObject",
    url: metaImage
  },
  dateModified: meta?.updatedDate || articleDateModified || undefined
};

// 2. TechArticle schema for Comparison
const comparisonSchema = isComparison ? [
  {
    "@type": "TechArticle",
    "@id": `${canonical}#techarticle`,
    mainEntityOfPage: canonical,
    headline: seoTitle,
    description: description,
    image: metaImage,
    inLanguage: lang,
    author: {
      "@type": "Organization",
      name: t.brand || "GMT to EST Converter"
    },
    publisher: {
      "@type": "Organization",
      name: t.brand || "GMT to EST Converter",


      logo: {
        "@type": "ImageObject",
        url: `${siteUrl}/logo.svg`
      }
    },
    articleBody: isTr
      ? "Greenwich Mean Time (GMT) ile Doğu Saati (EST/EDT) arasında ayrıntılı saat dilimi karşılaştırması. Standart saat, yaz saati farkları ve toplantı planlama analizi."
      : isDe
      ? "Detaillierter Zeitzonenvergleich zwischen Greenwich Mean Time (GMT) und Eastern Standard Time (EST/EDT). Analyse von Normalzeit, Sommerzeit-Verschiebungen und praktischer Terminplanung."
      : isEs
        ? "Comparativa detallada de zonas horarias entre Greenwich Mean Time y Eastern Standard Time. Análisis de horarios estándar, cambios estacionales y programación internacional."
        : isIt
          ? "Confronto dettagliato dei fusi orari tra Greenwich Mean Time (GMT) ed Eastern Standard Time (EST/EDT). Analisi di ora solare, ora legale e pianificazione pratica."
          : isPt
            ? "Comparação detalhada de fusos horários entre Greenwich Mean Time (GMT) e Eastern Standard Time (EST/EDT). Análise de horário padrão, variações sazonais e agendamento internacional."
            : isPl
              ? "Szczegółowe porównanie stref czasowych między Greenwich Mean Time (GMT) a Eastern Standard Time (EST/EDT). Analiza czasu standardowego, przesunięć czasu letniego oraz planowania spotkań."
              : isNl
                ? "Gedetailleerde tijdzonevergelijking tussen Greenwich Mean Time (GMT) en Eastern Standard Time (EST/EDT). Analyse van standaardtijd, zomertijdverschuivingen en praktische vergaderplanning."
                : "Detailed timezone comparison between Greenwich Mean Time and Eastern Standard Time. Analyzing standard hours, seasonal shifts, and common scheduling pitfalls."
  }
] : [];

// 3. Article schema for Guide
const guideSchema = isGuide ? [
  {
    "@type": "Article",
    "@id": `${canonical}#article`,
    mainEntityOfPage: canonical,
    headline: seoTitle,
    description: description,
    image: metaImage,
    inLanguage: lang,
    author: {
      "@type": "Organization",
      name: t.brand || "GMT to EST Converter"
    },
    publisher: {
      "@type": "Organization",
      name: t.brand || "GMT to EST Converter",
      logo: {
        "@type": "ImageObject",
        url: `${siteUrl}/logo.svg`
      }
    },
    articleBody: isTr
      ? "Koordineli Evrensel Zaman (UTC), Greenwich Mean Time (GMT) ve Doğu Saati (EST/EDT) üzerine kapsamlı eğitim rehberi. Tarihsel gelişim ve yaz saati kuralları."
      : isDe
      ? "Umfassender Ratgeber zu koordinierter Weltzeit (UTC), Greenwich Mean Time (GMT) und Eastern Time (EST/EDT) mit historischer Entwicklung und Sommerzeit-Regeln."
      : isEs
        ? "Guía educativa sobre Tiempo Universal Coordinado (UTC), Greenwich Mean Time (GMT) y Eastern Standard Time (EST). Historia de los husos horarios y reglas de horario de verano."
        : isIt
          ? "Guida didattica completa sul Tempo Coordinato Universale (UTC), Greenwich Mean Time (GMT) ed Eastern Time (EST/EDT) con evoluzione storica e regole dell'ora legale."
          : isPt
            ? "Guia educativo completo sobre Tempo Universal Coordenado (UTC), Horário de Greenwich (GMT) e Horário do Leste (EST/EDT) com evolução histórica e regras do horário de verão."
            : isPl
              ? "Kompleksowy przewodnik po uniwersalnym czasie koordynowanym (UTC), Greenwich Mean Time (GMT) i czasie wschodnim (EST/EDT) wraz z regułami czasu letniego."
              : isNl
                ? "Uitgebreide gids over gecoördineerde wereldtijd (UTC), Greenwich Mean Time (GMT) en Eastern Time (EST/EDT) met historische achtergrond en zomertijdregels."
                : "An educational hub regarding Coordinated Universal Time (UTC), Greenwich Mean Time (GMT), and Eastern Standard Time (EST). Explores DST history and offsets."
  }
] : [];

// 4. HowTo schema for Reverse
const reverseSchema = isReverse ? [
  {
    "@type": "HowTo",
    "@id": `${canonical}#howto`,
    name: seoTitle,
    description: description,
    step: isTr ? [
      {
        "@type": "HowToStep",
        position: 1,
        name: "Doğu Saati (Eastern Time) durumunu belirleyin",
        text: "ABD Doğu Yakası'nın o tarihte standart saatte (EST, UTC−5) mi yoksa yaz saatinde (EDT, UTC−4) mi olduğunu kontrol edin."
      },
      {
        "@type": "HowToStep",
        position: 2,
        name: "Saat farkını ekleyin",
        text: "Kışın EST saatine 5 saat, yazın EDT saatine 4 saat ekleyerek GMT saatini hesaplayın."
      },
      {
        "@type": "HowToStep",
        position: 3,
        name: "Tarih değişimini ve sonucu doğrulayın",
        text: "Hesaplanan GMT saatinin 24 saatlik formatta gün değişimine (sonraki güne geçiş) uğrayıp uğramadığını kontrol edin."
      }
    ] : isDe ? [
      {
        "@type": "HowToStep",
        position: 1,
        name: "Eastern-Time-Status ermitteln",
        text: "Prüfe, ob an der US-Ostküste aktuell Normalzeit (EST, UTC−5) oder Sommerzeit (EDT, UTC−4) gilt."
      },
      {
        "@type": "HowToStep",
        position: 2,
        name: "Zeitverschiebung anwenden",
        text: "Addiere 5 Stunden zur EST-Uhrzeit (im Winter) bzw. 4 Stunden zur EDT-Uhrzeit (im Sommer), um die GMT-Zeit zu erhalten."
      },
      {
        "@type": "HowToStep",
        position: 3,
        name: "Ergebnis abgleichen",
        text: "Überprüfe das berechnete GMT-Ergebnis anhand der 24-Stunden-Zeitskala für fehlerfreie Termine."
      }
    ] : isIt ? [
      {
        "@type": "HowToStep",
        position: 1,
        name: "Verificare lo stato dell'Eastern Time",
        text: "Verifica se nella costa orientale degli Stati Uniti è attualmente in vigore l'ora solare (EST, UTC−5) o l'ora legale (EDT, UTC−4)."
      },
      {
        "@type": "HowToStep",
        position: 2,
        name: "Applicare il calcolo dello scarto",
        text: "Aggiungi 5 ore all'orario EST (in inverno) oppure 4 ore all'orario EDT (in estate) per calcolare l'ora GMT."
      },
      {
        "@type": "HowToStep",
        position: 3,
        name: "Confermare il risultato",
        text: "Verifica che il risultato GMT calcolato corrisponda all'orario sulla scala a 24 ore UTC."
      }
    ] : isPt ? [
      {
        "@type": "HowToStep",
        position: 1,
        name: "Verificar o status do Horário do Leste",
        text: "Verifique se a costa leste dos EUA está atualmente em horário padrão (EST, UTC−5) ou horário de verão (EDT, UTC−4)."
      },
      {
        "@type": "HowToStep",
        position: 2,
        name: "Aplicar o cálculo de diferença",
        text: "Adicione 5 horas ao horário EST (no inverno) ou 4 horas ao horário EDT (no verão) para calcular o horário GMT."
      },
      {
        "@type": "HowToStep",
        position: 3,
        name: "Confirmar o resultado",
        text: "Verifique se o resultado GMT calculado corresponde à linha do tempo de 24 horas em UTC."
      }
    ] : isPl ? [
      {
        "@type": "HowToStep",
        position: 1,
        name: "Sprawdź status czasu wschodniego",
        text: "Ustal, czy na wschodnim wybrzeżu USA obowiązuje aktualnie czas standardowy (EST, UTC-5), czy czas letni (EDT, UTC-4)."
      },
      {
        "@type": "HowToStep",
        position: 2,
        name: "Zastosuj przesunięcie godzinowe",
        text: "Dodaj 5 godzin do godziny EST (zimą) lub 4 godziny do godziny EDT (latem), aby uzyskać czas GMT."
      },
      {
        "@type": "HowToStep",
        position: 3,
        name: "Zweryfikuj zmianę daty",
        text: "Upewnij się, czy dodanie godzin nie przesunęło wyniku na kolejny dzień kalendarzowy w strefie GMT."
      }
    ] : isNl ? [
      {
        "@type": "HowToStep",
        position: 1,
        name: "Eastern Time-status bepalen",
        text: "Controleer of aan de Amerikaanse oostkust standaardtijd (EST, UTC-5) of zomertijd (EDT, UTC-4) van kracht is."
      },
      {
        "@type": "HowToStep",
        position: 2,
        name: "Uurverschil toepassen",
        text: "Tel 5 uur op bij de EST-kloktijd (in de winter) of 4 uur bij de EDT-kloktijd (in de zomer) om GMT te berekenen."
      },
      {
        "@type": "HowToStep",
        position: 3,
