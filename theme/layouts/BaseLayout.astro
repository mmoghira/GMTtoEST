    <!-- Core Web Vitals Real User Monitoring (RUM) -->
    <script is:inline>
      (function(w) {
        if (!('PerformanceObserver' in w)) return;
        var vitals = { TTFB: 0, LCP: 0, CLS: 0, INP: 0 };
        
        // TTFB measurement
        if (performance.getEntriesByType) {
          var nav = performance.getEntriesByType('navigation')[0];
          if (nav) vitals.TTFB = Math.round(nav.responseStart);
        }
        
        // LCP measurement
        var lcpObs = new PerformanceObserver(function(list) {
          var entries = list.getEntries();
          var lastEntry = entries[entries.length - 1];
          vitals.LCP = Math.round(lastEntry.startTime);
        });
        lcpObs.observe({ type: 'largest-contentful-paint', buffered: true });

        // CLS measurement
        var clsObs = new PerformanceObserver(function(list) {
          list.getEntries().forEach(function(entry) {
            if (!entry.hadRecentInput) vitals.CLS += entry.value;
          });
        });
        clsObs.observe({ type: 'layout-shift', buffered: true });

        // INP measurement
        var inpObs = new PerformanceObserver(function(list) {
          list.getEntries().forEach(function(entry) {
            if (entry.duration > vitals.INP) vitals.INP = Math.round(entry.duration);
          });
        });
        inpObs.observe({ type: 'event', buffered: true, durationThreshold: 40 });

        // Reporting
        function report() {
          console.log('[Core Web Vitals RUM]', {
            ttfb: vitals.TTFB + 'ms',
            lcp: vitals.LCP + 'ms',
            cls: parseFloat(vitals.CLS.toFixed(4)),
            inp: vitals.INP + 'ms'
          });
        }
        w.addEventListener('load', function() { setTimeout(report, 3000); });
        w.addEventListener('pagehide', report);
      })(window);
    </script>
