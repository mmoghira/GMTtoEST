---
import "src/styles/global.css";
import Header from "theme/components/Header.astro";
import NavigationSchema from "theme/components/NavigationSchema.astro";
import { getConverterDisplayName, getTranslation, languages, pageUrl, pages, siteUrl } from "theme/i18n/config";

type Props = {
  lang: string;
  dir: "ltr" | "rtl";
  title: string;
  description: string;
  slug?: string;
  mode?: string;
  meta?: any;
  enableFaqSchema?: boolean;
  enableArticleSchema?: boolean;
  canonicalPath?: string;
  homePath?: string;
  allowAds?: boolean;
  robots?: string;
  breadcrumbHomeLabel?: string;
  breadcrumbLabel?: string;
  hreflangCodes?: string[];
};

const { lang, dir, title, description, slug = "", mode = "gmt-est", meta = {}, enableFaqSchema = false, enableArticleSchema = false, canonicalPath, homePath, allowAds, robots, breadcrumbHomeLabel, breadcrumbLabel, hreflangCodes } = Astro.props;
const t = getTranslation(lang);

function ensureTrailingSlash(pathname: string) {
  if (!pathname || pathname === "/") return "/";
  return pathname.endsWith("/") ? pathname : `${pathname}/`;
}

function toAbsoluteUrl(pathOrUrl: string) {
  const url = new URL(pathOrUrl, `${siteUrl}/`);
  if (!url.pathname.includes(".")) {
    url.pathname = ensureTrailingSlash(url.pathname);
  }
  return url.toString();
}

function truncateSeoText(value: string, maxLength: number) {
  if (value.length <= maxLength) return value;
  const sliced = value.slice(0, maxLength - 1);
  const lastSpace = sliced.lastIndexOf(" ");
  const clean = lastSpace >= Math.floor(maxLength * 0.65) ? sliced.slice(0, lastSpace) : sliced;
  return `${clean.trim()}…`;
}

const canonicalPathResolved = canonicalPath || pageUrl(lang, slug);
const canonical = toAbsoluteUrl(canonicalPathResolved);
const homePathResolved = homePath || pageUrl(lang, "");
const homeUrl = toAbsoluteUrl(homePathResolved);
const robotsContent = robots || meta?.robots || "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1";
const isNoindexPage = robotsContent.toLowerCase().includes("noindex");
const hasLocalizedVersion = pages.some((page: any) => page.slug === slug);
const availableHreflangCodes = hreflangCodes || (hasLocalizedVersion ? languages.map((item) => item.code) : ["en"]);
const alternateLanguages = isNoindexPage
  ? []
  : languages.filter((item) => availableHreflangCodes.includes(item.code));
const hreflangAlternates = isNoindexPage
  ? []
  : [
      { code: lang, href: canonical },
      ...alternateLanguages
        .filter((item) => item.code !== lang)
        .map((item) => ({
          code: item.code,
          href: toAbsoluteUrl(pageUrl(item.code, slug))
        }))
    ];
const xDefaultHref = toAbsoluteUrl(pageUrl("en", slug));
const seoTitle = (lang === "en" ? meta?.seoTitle : undefined) || title;
const titleNeedsLongBrand = seoTitle.length < 30;
const titleCanUseShortBrand = !seoTitle.toLowerCase().includes("gmt to est") && seoTitle.length + 13 <= 60;
const brandedTitle = titleNeedsLongBrand
  ? `${seoTitle} | GMT to EST Time Converter`
  : titleCanUseShortBrand
    ? `${seoTitle} | GMT to EST`
    : seoTitle;
const documentTitle = truncateSeoText(brandedTitle, 60);
const descriptionWithContext = description.length < 70 ? `${title}. ${description}` : description;
const descriptionExtensions: Record<string, string> = {
  ja: "日付に応じた正確な時差と変換結果を確認できます。",
  ko: "날짜별 정확한 시차와 변환 결과를 확인할 수 있습니다.",
  zh: "可按日期查看准确时差、夏令时状态和转换结果。"
};
const expandedDescription = descriptionWithContext.length < 70 && descriptionExtensions[lang]
  ? `${descriptionWithContext} ${descriptionExtensions[lang]}`
  : descriptionWithContext;
const seoDescription = truncateSeoText(expandedDescription, 155);
const suppliedKeywords = meta?.keywords || t.seoKeywords || "time zone converter, GMT, EST, daylight saving time";
const metaKeywords = `${title}, ${suppliedKeywords}`;
const rawMetaImage = meta?.image || "/images/og/default.png";
const metaImage = rawMetaImage.startsWith("http") ? rawMetaImage : `${siteUrl}${rawMetaImage.startsWith("/") ? rawMetaImage : `/${rawMetaImage}`}`;
const metaImageAlt = meta?.imageAlt || title;
const imageExtension = rawMetaImage.split('.').pop()?.toLowerCase();
const ogImageType = imageExtension === 'webp' ? 'image/webp' :
                    imageExtension === 'avif' ? 'image/avif' :
                    imageExtension === 'jpg' || imageExtension === 'jpeg' ? 'image/jpeg' :
                    imageExtension === 'svg' ? 'image/svg+xml' : 'image/png';
const articleDatePublished = meta?.pubDate;
const articleDateModified = meta?.updatedDate || meta?.pubDate;
const articleImageSource = meta?.articleImage || meta?.image || meta?.preloadImage || "/assets/gmt-to-est-converter-featured-image-960.avif";
const articleImage = articleImageSource.startsWith("http") ? articleImageSource : `${siteUrl}${articleImageSource.startsWith("/") ? articleImageSource : `/${articleImageSource}`}`;
const ogType = meta?.ogType || (slug.startsWith("blog/") ? "article" : "website");
const showArticleMetaTags = ogType === "article" && !!articleDatePublished;
const twitterCard = meta?.twitterCard || "summary_large_image";
const preloadImage = meta?.preloadImage || "/assets/gmt-to-est-converter-featured-image-960.avif";
const preloadImageSrcset = meta?.preloadImageSrcset || "/assets/gmt-to-est-converter-featured-image-480.avif 480w, /assets/gmt-to-est-converter-featured-image-960.avif 960w";
const preloadImageSizes = meta?.preloadImageSizes || "(max-width: 720px) 92vw, 960px";
const preloadImageType = meta?.preloadImageType || "image/avif";

// Navigation structure for schema
const navItems = [
  { url: homePathResolved, name: t.pages?.gmtToEst?.title || "GMT to EST Converter", position: 1 },
  { url: pageUrl(lang, "est-to-gmt"), name: t.pages?.estToGmt?.title || "EST to GMT Converter", position: 2 },
  { url: pageUrl(lang, "gmt-vs-est"), name: t.pages?.gmtVsEst?.title || "GMT vs EST Difference", position: 3 },
  { url: pageUrl(lang, "time-zone-guide"), name: t.pages?.guide?.title || "Time Zone Guide", position: 4 }
];

const companyFooterLinks = [
  { href: "/about-us/", label: t.footer.about },
  { href: "/editorial-policy/", label: "Editorial Policy" },
  { href: "/contact-us/", label: t.footer.contact },
  { href: "/author/", label: t.footer.author || "Author" },
  { href: "/privacy-policy/", label: t.footer.privacy },
  { href: "/privacy-policy/#privacy-rights", label: "Privacy Choices" },
  { href: "/terms-of-service/", label: t.footer.terms || "Terms of Service" },
  { href: "/disclaimer/", label: t.footer.disclaimer || "Disclaimer" },
  { href: "/sitemap/", label: t.footer.sitemap }
];

const currentConverterLinks = [
  { href: pageUrl(lang, ""), label: "GMT to EST Converter" },
  { href: pageUrl(lang, "est-to-gmt"), label: "EST to GMT Converter" },
  { href: pageUrl(lang, "gmt-vs-est"), label: "GMT vs EST Difference" },
  { href: pageUrl(lang, "gmt-to-acdt"), label: "GMT to ACDT Converter" },
  { href: pageUrl(lang, "cdt-to-est"), label: "CDT to EST Converter" },
  { href: pageUrl(lang, "cst-to-est"), label: "CST to EST Converter" },
  { href: pageUrl(lang, "pdt-to-est"), label: "PDT to EST Converter" },
  { href: pageUrl(lang, "mst-to-est"), label: "MST to EST Converter" },
  { href: pageUrl(lang, "ast-to-est"), label: "AST to EST Converter" },
  { href: pageUrl(lang, "kst-to-est"), label: "KST to EST Converter" }
];

const generatedConverterLinks = pages
  .filter((page: any) => {
    if (!["converter", "reverse", "difference", "dynamic"].includes(page.kind)) return false;
    return !page.slug || page.slug === "est-to-gmt" || page.slug === "gmt-vs-est" || page.slug.endsWith("-to-est") || page.slug.startsWith("gmt-to-");
  })
  .map((page: any) => ({
    href: pageUrl(lang, page.slug),
    label: getConverterDisplayName(page) || page.slug
  }));

const converterFooterLinks = [...currentConverterLinks, ...generatedConverterLinks].filter((item, index, items) =>
  items.findIndex((candidate) => candidate.href === item.href) === index
);

const isHome = slug === "";
const isEnglishHome = lang === "en" && isHome;
const isComparison = slug === "gmt-vs-est";
const isReverse = slug === "est-to-gmt";
const isGuide = slug === "time-zone-guide";
const isDynamic = slug.endsWith("-to-est") || slug.startsWith("gmt-to-");
const isConverterPage = isHome || isComparison || isReverse || isDynamic;
const breadcrumbCurrentLabel = breadcrumbLabel || title;

const isUtilityPage = ["", "est-to-gmt", "gmt-vs-est", "time-zone-guide"].includes(slug);
// Keep the initial AdSense review focused on the strongest, fully reviewed
// English content. Other locales can be enabled individually after a human
// translation/content-quality review.
const isAdsenseEligiblePage = isUtilityPage || slug.startsWith("blog/");
const shouldLoadAds = lang === "en" && !isNoindexPage && (allowAds ?? isAdsenseEligiblePage);

// SoftwareApplication schema for the homepage and every converter page.
const converterAppSchema = isConverterPage ? [
  {
    "@type": "SoftwareApplication",
    "@id": `${canonical}#software-application`,
    name: getConverterDisplayName(pages.find((page: any) => page.slug === slug)) || seoTitle,
    url: canonical,
    description: meta?.appDescription || description,
    applicationCategory: meta?.applicationCategory || "UtilityApplication",
    operatingSystem: meta?.operatingSystem || "Any",
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "USD"
    }
  }
] : [];

const webPageSchema = {
  "@type": "WebPage",
  "@id": `${canonical}#webpage`,
  url: canonical,
  name: seoTitle,
  description: seoDescription,
  inLanguage: lang,
  isPartOf: { "@id": `${siteUrl}/#website` },
  breadcrumb: { "@id": `${canonical}#breadcrumb` },
  primaryImageOfPage: {
    "@type": "ImageObject",
    url: metaImage
  },
  dateModified: meta?.updatedDate || articleDateModified || undefined
};

// 2. TechArticle schema for Comparison
const comparisonSchema = isComparison ? [
  {
    "@type": "TechArticle",
    "@id": `${canonical}#techarticle`,
    mainEntityOfPage: canonical,
    headline: seoTitle,
    description: description,
    image: metaImage,
    inLanguage: lang,
    author: {
      "@type": "Organization",
      name: t.brand || "GMT to EST Converter"
    },
    publisher: {
      "@type": "Organization",
      name: t.brand || "GMT to EST Converter",
      logo: {
        "@type": "ImageObject",
        url: `${siteUrl}/logo.svg`
      }
    },
    articleBody: "Detailed timezone comparison between Greenwich Mean Time and Eastern Standard Time. Analyzing standard hours, seasonal shifts, and common scheduling pitfalls."
  }
] : [];

// 3. Article schema for Guide
const guideSchema = isGuide ? [
  {
    "@type": "Article",
    "@id": `${canonical}#article`,
    mainEntityOfPage: canonical,
    headline: seoTitle,
    description: description,
    image: metaImage,
    inLanguage: lang,
    author: {
      "@type": "Organization",
      name: t.brand || "GMT to EST Converter"
    },
    publisher: {
      "@type": "Organization",
      name: t.brand || "GMT to EST Converter",
      logo: {
        "@type": "ImageObject",
        url: `${siteUrl}/logo.svg`
      }
    },
    articleBody: "An educational hub regarding Coordinated Universal Time (UTC), Greenwich Mean Time (GMT), and Eastern Standard Time (EST). Explores DST history and offsets."
  }
] : [];

// 4. HowTo schema for Reverse
const reverseSchema = isReverse ? [
  {
    "@type": "HowTo",
    "@id": `${canonical}#howto`,
    name: seoTitle,
    description: description,
    step: [
      {
        "@type": "HowToStep",
        position: 1,
        name: "Check Eastern Time status",
        text: "Determine if Eastern Time is in Standard Time (EST, UTC-5) or Daylight Saving Time (EDT, UTC-4)."
      },
      {
        "@type": "HowToStep",
        position: 2,
        name: "Apply offset calculation",
        text: "Add 5 hours to the EST clock time, or add 4 hours to the EDT clock time to calculate GMT."
      },
      {
        "@type": "HowToStep",
        position: 3,
        name: "Confirm standard result",
        text: "Verify the calculated GMT output matches the 24-hour UTC timeline."
      }
    ]
  }
] : [];

const customHowToSchema = meta?.howToSteps?.length ? [
  {
    "@type": "HowTo",
    "@id": `${canonical}#howto`,
    name: meta?.howToName || `How to use ${seoTitle}`,
    description: meta?.howToDescription || description,
    step: meta.howToSteps.map((step: any, index: number) => ({
      "@type": "HowToStep",
      position: index + 1,
      name: step.name,
      text: step.text
    }))
  }
] : [];

const articleSchemas = enableArticleSchema && articleDatePublished ? [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "@id": `${canonical}#article`,
    mainEntityOfPage: canonical,
    headline: seoTitle,
    description,
    image: articleImage,
    datePublished: articleDatePublished,
    dateModified: articleDateModified,
    inLanguage: lang,
    keywords: metaKeywords,
    author: {
      "@type": "Organization",
      name: t.brand || "GMT to EST Converter"
    },
    publisher: {
      "@type": "Organization",
      name: t.brand || "GMT to EST Converter",
      logo: {
        "@type": "ImageObject",
        url: `${siteUrl}/logo.svg`
      }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "@id": `${canonical}#blogposting`,
    mainEntityOfPage: canonical,
    headline: seoTitle,
    description,
    image: articleImage,
    datePublished: articleDatePublished,
    dateModified: articleDateModified,
    inLanguage: lang,
    keywords: metaKeywords,
    author: {
      "@type": "Organization",
      name: t.brand || "GMT to EST Converter"
    },
    publisher: {
      "@type": "Organization",
      name: t.brand || "GMT to EST Converter",
      logo: {
        "@type": "ImageObject",
        url: `${siteUrl}/logo.svg`
      }
    }
  }
] : [];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    // ── 1. WebSite (enables Sitelinks Searchbox & site identity) ──────────────
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      url: siteUrl,
      name: t.brand || "GMT to EST Converter",
      alternateName: "GMTtoEST",
      description: t.pages?.home?.description || "Free, accurate GMT to EST and EST to GMT timezone converter. Accounts for daylight saving time.",
      inLanguage: languages.map(l => l.code)
    },

    // ── 2. Organization ────────────────────────────────────────────────────────
    {
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      name: t.brand || "GMT to EST Converter",
      url: siteUrl,
      logo: {
        "@type": "ImageObject",
        "@id": `${siteUrl}/#logo`,
        url: `${siteUrl}/logo.svg`,
        width: 512,
        height: 512,
        caption: t.brand || "GMT to EST Converter"
      },
      image: { "@id": `${siteUrl}/#logo` },
      description: "Free timezone converter and guide for GMT and Eastern Standard Time (EST/EDT).",
      foundingDate: "2024",
      contactPoint: {
        "@type": "ContactPoint",
        contactType: "customer support",
        email: "contact@gmttoestconverter.com",
        availableLanguage: languages.map(l => l.code),
        areaServed: "Worldwide"
      }
    },

    webPageSchema,

    // ── 3. BreadcrumbList (per-page) ───────────────────────────────────────────
    {
      "@type": "BreadcrumbList",
      "@id": `${canonical}#breadcrumb`,
      itemListElement: isHome
        ? [{ "@type": "ListItem", position: 1, name: t.brand || "GMT to EST Converter", item: homeUrl }]
        : [
            { "@type": "ListItem", position: 1, name: breadcrumbHomeLabel || t.brand || "GMT to EST Converter", item: homeUrl },
            { "@type": "ListItem", position: 2, name: breadcrumbLabel || title, item: canonical }
          ]
    },

    ...converterAppSchema,
    ...comparisonSchema,
    ...guideSchema,
    ...reverseSchema,
    ...customHowToSchema,
    ...articleSchemas,

    // ── 5. FAQPage (pages with a visible FAQ section) ─────────────────────────
    ...(enableFaqSchema && (meta?.faqs?.length || t.faqs?.items?.length) ? [{
      "@type": "FAQPage",
      "@id": `${canonical}#faq`,
      mainEntity: (meta?.faqs || t.faqs?.items || []).map((item: any) => ({
        "@type": "Question",
        name: item.q,
        acceptedAnswer: { "@type": "Answer", text: item.a }
      }))
    }] : [])
  ]
};
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://pagead2.googlesyndication.com" />
    <link rel="preload" href="/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/space-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <!-- Privacy-first Consent Mode defaults. A Google-certified CMP must update
         these values after the visitor makes a choice. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        wait_for_update: 500
      });
      gtag('js', new Date());
      gtag('config', 'G-ZY6RBZFSY3');
    </script>
    <meta name="google-adsense-account" content="ca-pub-3364858473460532" />
    {shouldLoadAds && (
      <script
        async
        src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3364858473460532"
        crossorigin="anonymous"
        is:inline
      ></script>
    )}
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    <meta name="description" content={seoDescription} />
    <meta name="robots" content={robotsContent} />
    {metaKeywords && <meta name="keywords" content={metaKeywords} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={metaImage} />
    <meta property="og:image:alt" content={metaImageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:site_name" content="GMT to EST Converter" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={seoDescription} />
    <meta name="twitter:image" content={metaImage} />
    <meta name="twitter:image:alt" content={metaImageAlt} />
    {showArticleMetaTags && <meta property="article:published_time" content={articleDatePublished} />}
    {showArticleMetaTags && articleDateModified && <meta property="article:modified_time" content={articleDateModified} />}
    <meta name="p:domain_verify" content="9b3f625230ead5b92611adf407a5d0ca"/>
    <meta name="google-site-verification" content="nSvVnbDG53Fvz4UTBw5d1E6sxCuFM0LsuqwPXvCJr1Q" />
    <meta name="google-site-verification" content="L9kjVxomGCuSzz8YZfAfd7C6_I_coIAcFZ4efsfCBF4" />
    <meta name="msvalidate.01" content="9BB978FBFAF8F85CFFB7B099B245BAA7" />
    <meta name="yandex-verification" content="04e699461da51bbb" />
    <meta name="apple-domain-verification" content="g0KrOt0z2BSpOIO5" />
    <link rel="canonical" href={canonical} />
    <link
      rel="preload"
      href={preloadImage}
      imagesrcset={preloadImageSrcset}
      imagesizes={preloadImageSizes}
      as="image"
      type={preloadImageType}
      fetchpriority="high"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/favicon.png" sizes="192x192" />
    <link rel="image_src" href={metaImage} />
    {hreflangAlternates.map((item) => (
      <link rel="alternate" hreflang={item.code} href={item.href} />
    ))}
    {!isNoindexPage && <link rel="alternate" hreflang="x-default" href={xDefaultHref} />}
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <NavigationSchema lang={lang} t={t} homePath={homePathResolved} />
    <script is:inline>
      const savedTheme = localStorage.getItem("theme");
      if (savedTheme) document.documentElement.dataset.theme = savedTheme;
    </script>
    <slot name="head" />
  </head>
  <body data-lang={lang} data-mode={mode}>
    {isEnglishHome && (
      <p class="seo-keyword-intro seo-keyword-intro--top">
        <strong>{title}</strong> gives instant, date-aware GMT to EST conversion with live clocks, DST handling, meeting presets, and a 24-hour chart.
      </p>
    )}
    <Header lang={lang} t={t} slug={slug} />

    <main>
      {!isHome && (
        <nav aria-label="Breadcrumb" class="breadcrumb">
          <ol>
            <li><a href={homePathResolved}>{breadcrumbHomeLabel || "Home"}</a></li>
            <li aria-current="page">{breadcrumbCurrentLabel}</li>
          </ol>
        </nav>
      )}
      <slot />
    </main>
    <footer>
      <div class="footer-container">
        <!-- Brand Section -->
        <div class="footer-section brand-section">
          <a href={homePathResolved} class="footer-logo">
            <img src="/logo.svg" alt="GMT to EST logo" class="footer-logo-icon" width="56" height="56" loading="lazy" decoding="async" />
            <span class="site-name">GMT to EST Converter</span>
          </a>
          <p class="brand-desc">{t.brand} - Free timezone converter for GMT and EST time zones</p>
          <div class="social-links">
            <a href="https://www.facebook.com/GMTtoESTConverter" aria-label="Facebook" title="Facebook" class="social-fb" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" fill="currentColor" height="20" width="20"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.469h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
            <a href="https://x.com/GMTtoEST" aria-label="X (Twitter)" title="X (Twitter)" class="social-x" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" fill="currentColor" height="20" width="20"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"/></svg>
            </a>
