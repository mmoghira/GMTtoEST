---
const { intent = "converter", t, context } = Astro.props;
const variant = t.converter.variants[intent] || t.converter.variants.converter;

function replaceTemplates(text: string, replacements: Record<string, string>): string {
  if (!text) return "";
  let result = text;
  for (const [key, value] of Object.entries(replacements)) {
    result = result.replace(new RegExp(`{${key}}`, "g"), value);
  }
  return result;
}

const from = context?.from || "GMT";
const to = context?.to || "EST";
const replacements = { from, to };

const heading = replaceTemplates(variant.heading, replacements);
const input = replaceTemplates(variant.input, replacements);
const note = replaceTemplates(variant.note, replacements);

const sourceZone = context ? context.fromZone : "UTC";
const targetZone = context ? context.toZone : "America/New_York";
const sourceLabel = context?.from || "GMT";
const targetLabel = context?.to === "EST" ? "EST / EDT" : context?.to || "EST / EDT";
const targetTimeLabel = context?.to === "EST" ? "Eastern Time" : context?.to ? `${context.to} time` : t.converter.toEastern;
---

<form
  class="converter"
  data-component="converter"
  data-intent={intent}
  data-start-mode={variant.startMode}
  data-labels={JSON.stringify(t.converter)}
  data-source-zone={sourceZone}
  data-target-zone={targetZone}
  data-source-label={sourceLabel}
  data-target-label={context?.to || "EST"}
>
  <div class="converter-head">
    <div>
      <span class="step">1</span>
      <strong data-role="converterHeading">{heading}</strong>
    </div>
    {variant.swap && <button type="button" data-role="swap" class="swap-button" aria-label={t.converter.swap || "Swap conversion direction"}>⇄</button>}
  </div>
  <div class:list={["mode-tabs", !variant.swap && "single-mode"]} role="tablist" aria-label={t.converter.direction || "Conversion direction"}>
    <button type="button" class:list={["mode", variant.startMode === "gmt-est" && "active"]} role="tab" aria-selected={variant.startMode === "gmt-est" ? "true" : "false"} data-role="mode" data-mode="gmt-est"><span>{t.converter.from}</span><b>{sourceLabel}</b><small>to {targetTimeLabel}</small></button>
    <button type="button" class:list={["mode", variant.startMode === "est-gmt" && "active"]} role="tab" aria-selected={variant.startMode === "est-gmt" ? "true" : "false"} data-role="mode" data-mode="est-gmt"><span>{t.converter.from}</span><b>{targetLabel}</b><small>to {sourceLabel}</small></button>
  </div>
  <label class="datetime-label">
    <span data-role="inputZoneName">{context ? `${sourceLabel} time` : input}</span>
    <input data-role="datetime" type="datetime-local" aria-label={input || `${sourceLabel} date and time input`} />
  </label>
  <div class="controls">
    <button type="button" data-role="now">{t.converter.now}</button>
    <label class="toggle"><input data-role="formatToggle" type="checkbox" checked /> {t.converter.format}</label>
  </div>
  <div class="answer-card">
    <span class="step">2</span>
    <div class="answer-grid">
      <div>
        <span data-role="sourceZone">{sourceLabel}</span>
        <strong data-role="sourcePreview">--</strong>
      </div>
      <div class="arrow" aria-hidden="true">→</div>
      <div>
        <span data-role="outputZoneName">{targetTimeLabel}</span>
        <output class="result" data-role="conversion-output" aria-live="polite">--</output>
      </div>
    </div>
    <div class="result-actions">
      <strong class="offset-badge" data-role="offsetBadge">{t.converter.dstAware}</strong>
      <button
        type="button"
        data-role="copy-result"
        data-copied={t.converter.copied}
        aria-label="Copy conversion result to clipboard"
        title="Copy to clipboard"
      >{t.converter.copy}</button>
    </div>
  </div>
  <p class="difference" data-role="difference">{note}</p>
</form>
