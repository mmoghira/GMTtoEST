---
const { intent = "converter", t, context, lang = "en" } = Astro.props;
const isDe = lang === "de";
const isEs = lang === "es";
const isFr = lang === "fr";
const isIt = lang === "it";
const isPt = lang === "pt";
const variant = t.converter?.variants?.[intent] || t.converter?.variants?.converter || {};

import { replaceTemplates } from "theme/i18n/config";

const from = context?.from || "GMT";
const to = context?.to || "EST";
const sourceZone = context ? context.fromZone : "UTC";
const targetZone = context ? context.toZone : "America/New_York";
const replacements = { from, to, fromZone: sourceZone, toZone: targetZone, source: from, target: to };

const heading = replaceTemplates(variant.heading, replacements);
const input = replaceTemplates(variant.input, replacements);
const note = replaceTemplates(variant.note, replacements);
const sourceLabel = context?.from || "GMT";
const targetLabel = context?.to === "EST" ? "EST / EDT" : context?.to || "EST / EDT";

const defaultEastern = isDe
  ? "Eastern Time"
  : isEs
    ? "la hora del Este"
    : isFr
      ? "l'heure de l'Est"
      : isIt
        ? "l'Eastern Time"
        : isPt
          ? "o Horário do Leste"
          : "Eastern Time";

const targetTimeLabel = context?.to === "EST"
  ? defaultEastern
  : context?.to
    ? (isDe
        ? `${context.to}-Zeit`
        : isEs
          ? `hora ${context.to}`
          : isFr
            ? `heure ${context.to}`
            : isIt
              ? `ora ${context.to}`
              : isPt
                ? `horário ${context.to}`
                : `${context.to} time`)
    : (t.converter?.toEastern || defaultEastern);

const toPrefix = isDe ? "in " : isEs ? "a " : isFr ? "vers " : isIt ? "a " : isPt ? "para " : "to ";
const targetTimeButtonLabel = isIt
  ? (context?.to === "EST" || !context?.to ? "all'Eastern Time" : (/^[AEIOU]/i.test(context.to) ? `all'${context.to}` : `a ${context.to}`))
  : `${toPrefix}${targetTimeLabel}`;
const sourceTimeButtonLabel = isIt
  ? (/^[AEIOU]/i.test(sourceLabel) ? `all'${sourceLabel}` : `a ${sourceLabel}`)
  : `${toPrefix}${sourceLabel}`;
const inputLabel = context
  ? (isDe ? `${sourceLabel}-Zeit` : isEs ? `Hora ${sourceLabel}` : isFr ? `Heure ${sourceLabel}` : isIt ? `Ora ${sourceLabel}` : isPt ? `Hora ${sourceLabel}` : `${sourceLabel} time`)
  : input;
const inputDateAria = isDe ? `Datum und Uhrzeit für ${sourceLabel} eingeben` : isEs ? `Entrada de fecha y hora para ${sourceLabel}` : isFr ? `Saisie de date et heure pour ${sourceLabel}` : isIt ? `Inserimento data e ora per ${sourceLabel}` : isPt ? `Entrada de data e hora para ${sourceLabel}` : `${sourceLabel} date and time input`;
const swapAria = t.converter.swap || (isDe ? "Umrechnungsrichtung wechseln" : isEs ? "Cambiar dirección de conversión" : isFr ? "Inverser le sens de conversion" : isIt ? "Inverti direzione di conversione" : isPt ? "Inverter direção da conversão" : "Swap conversion direction");
const directionAria = t.converter.direction || (isDe ? "Umrechnungsrichtung" : isEs ? "Dirección de la conversión" : isFr ? "Sens de la conversion" : isIt ? "Direzione della conversione" : isPt ? "Direção da conversão" : "Conversion direction");
const copyAria = isDe ? "Ergebnis in die Zwischenablage kopieren" : isEs ? "Copiar resultado de la conversión al portapapeles" : isFr ? "Copier le résultat de la conversion dans le presse-papiers" : isIt ? "Copia il risultato della conversione negli appunti" : isPt ? "Copiar resultado da conversão para a área de transferência" : "Copy conversion result to clipboard";
const copyTitle = isDe ? "In Zwischenablage kopieren" : isEs ? "Copiar al portapapeles" : isFr ? "Copier dans le presse-papiers" : isIt ? "Copia negli appunti" : isPt ? "Copiar para a área de transferência" : "Copy to clipboard";
const converterLabelsJson = replaceTemplates(JSON.stringify(t.converter), replacements);
---

<form
  class="converter"
  data-component="converter"
  data-intent={intent}
  data-start-mode={variant.startMode}
  data-labels={converterLabelsJson}
  data-source-zone={sourceZone}
  data-target-zone={targetZone}
  data-source-label={sourceLabel}
  data-target-label={context?.to || "EST"}
>
  <div class="converter-head">
    <div>
      <span class="step">1</span>
      <strong data-role="converterHeading">{heading}</strong>
    </div>
    {variant.swap && <button type="button" data-role="swap" class="swap-button" aria-label={swapAria}>⇄</button>}
  </div>
  <div class:list={["mode-tabs", !variant.swap && "single-mode"]} role="tablist" aria-label={directionAria}>
    <button type="button" class:list={["mode", variant.startMode === "gmt-est" && "active"]} role="tab" aria-selected={variant.startMode === "gmt-est" ? "true" : "false"} data-role="mode" data-mode="gmt-est"><span>{t.converter.from || (isDe ? "Von" : isEs ? "De" : isFr ? "De" : isIt ? "Da" : isPt ? "De" : "From")}</span><b>{sourceLabel}</b><small>{targetTimeButtonLabel}</small></button>
    <button type="button" class:list={["mode", variant.startMode === "est-gmt" && "active"]} role="tab" aria-selected={variant.startMode === "est-gmt" ? "true" : "false"} data-role="mode" data-mode="est-gmt"><span>{t.converter.from || (isDe ? "Von" : isEs ? "De" : isFr ? "De" : isIt ? "Da" : isPt ? "De" : "From")}</span><b>{targetLabel}</b><small>{sourceTimeButtonLabel}</small></button>
  </div>
  <label class="datetime-label">
    <span data-role="inputZoneName">{inputLabel}</span>
    <input data-role="datetime" type="datetime-local" aria-label={inputDateAria} />
  </label>
  <div class="controls">
    <button type="button" data-role="now">{t.converter.now}</button>
    <label class="toggle"><input data-role="formatToggle" type="checkbox" checked /> {t.converter.format}</label>
  </div>
  <div class="answer-card">
    <span class="step">2</span>
    <div class="answer-grid">
      <div>
        <span data-role="sourceZone">{sourceLabel}</span>
        <strong data-role="sourcePreview">--</strong>
      </div>
      <div class="arrow" aria-hidden="true">→</div>
      <div>
        <span data-role="outputZoneName">{targetTimeLabel}</span>
        <output class="result" data-role="conversion-output" aria-live="polite">--</output>
      </div>
    </div>
    <div class="result-actions">
      <strong class="offset-badge" data-role="offsetBadge">{t.converter.dstAware}</strong>
      <button
        type="button"
        data-role="copy-result"
        data-copied={t.converter.copied || (isDe ? "Kopiert!" : isEs ? "¡Copiado!" : isFr ? "Copié !" : isIt ? "Copiato!" : isPt ? "Copiado!" : "Copied")}
        data-copy-failed={t.converter.copyFailed || (isDe ? "Fehler beim Kopieren" : isEs ? "Error al copiar" : isFr ? "Échec de la copie" : isIt ? "Copia non riuscita" : isPt ? "Falha ao copiar" : "Copy failed")}
        aria-label={copyAria}
        title={copyTitle}
      >{t.converter.copy}</button>
    </div>
  </div>
  <p class="difference" data-role="difference">{note}</p>
</form>
