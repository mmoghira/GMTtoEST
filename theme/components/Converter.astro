---
const { intent = "converter", t, context } = Astro.props;
const variant = t.converter.variants[intent] || t.converter.variants.converter;

function replaceTemplates(text: string, replacements: Record<string, string>): string {
  if (!text) return "";
  let result = text;
  for (const [key, value] of Object.entries(replacements)) {
    result = result.replace(new RegExp(`{${key}}`, "g"), value);
  }
  return result;
}

const from = context?.from || "GMT";
const to = context?.to || "EST";
const replacements = { from, to };

const heading = replaceTemplates(variant.heading, replacements);
const input = replaceTemplates(variant.input, replacements);
const note = replaceTemplates(variant.note, replacements);

const sourceZone = context ? context.fromZone : "UTC";
const targetZone = context ? context.toZone : "America/New_York";
const sourceLabel = context?.from || "GMT";
const targetLabel = context?.to === "EST" ? "EST / EDT" : context?.to || "EST / EDT";
const targetTimeLabel = context?.to === "EST" ? "Eastern Time" : context?.to ? `${context.to} time` : t.converter.toEastern;
---

<form class="converter" id="converter" data-intent={intent} data-start-mode={variant.startMode} data-labels={JSON.stringify(t.converter)} data-source-zone={sourceZone} data-target-zone={targetZone}>
  <div class="converter-head">
    <div>
      <span class="step">1</span>
      <strong id="converterHeading">{heading}</strong>
    </div>
    {variant.swap && <button type="button" id="swap" class="swap-button" aria-label={t.converter.swap}>⇄</button>}
  </div>
  <div class:list={["mode-tabs", !variant.swap && "single-mode"]} role="tablist" aria-label={t.converter.direction}>
    <button type="button" class:list={["mode", variant.startMode === "gmt-est" && "active"]} data-mode="gmt-est"><span>{t.converter.from}</span><b>{sourceLabel}</b><small>to {targetTimeLabel}</small></button>
    <button type="button" class:list={["mode", variant.startMode === "est-gmt" && "active"]} data-mode="est-gmt"><span>{t.converter.from}</span><b>{targetLabel}</b><small>to {sourceLabel}</small></button>
  </div>
  <label class="datetime-label"><span id="inputZoneName">{context ? `${sourceLabel} time` : input}</span><input id="datetime" type="datetime-local" /></label>
  <div class="controls">
    <button type="button" id="now">{t.converter.now}</button>
    <label class="toggle"><input id="formatToggle" type="checkbox" checked /> {t.converter.format}</label>
  </div>
  <div class="answer-card">
    <span class="step">2</span>
    <div class="answer-grid">
      <div>
        <span id="sourceZone">{sourceLabel}</span>
        <strong id="sourcePreview">--</strong>
      </div>
      <div class="arrow" aria-hidden="true">→</div>
      <div>
        <span id="outputZoneName">{targetTimeLabel}</span>
        <output class="result" id="result" aria-live="polite">--</output>
      </div>
    </div>
    <div class="result-actions">
      <strong class="offset-badge" id="offsetBadge">{t.converter.dstAware}</strong>
      <button type="button" id="copy" data-copied={t.converter.copied}>{t.converter.copy}</button>
    </div>
  </div>
  <p class="difference" id="difference">{note}</p>
</form>
