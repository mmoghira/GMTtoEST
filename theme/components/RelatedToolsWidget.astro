---
type Props = {
  currentSlug: string;
  lang?: string;
};

const { currentSlug, lang = 'en' } = Astro.props;

const allTools = [
  { slug: 'world-clock', name: 'World Clock', icon: '🌍', desc: 'Live time in 200+ cities worldwide' },
  { slug: 'meeting-planner', name: 'Meeting Planner', icon: '📅', desc: 'Find the best time for global meetings' },
  { slug: 'event-time-converter', name: 'Event Time Converter', icon: '🎯', desc: 'Convert event times across time zones' },
  { slug: 'time-difference-calculator', name: 'Time Difference Calculator', icon: '⏱️', desc: 'Calculate exact time differences' },
  { slug: 'business-hours-overlap', name: 'Business Hours Overlap', icon: '💼', desc: 'Find overlapping work hours' },
  { slug: 'dst-calendar', name: 'DST Calendar', icon: '📆', desc: 'Daylight Saving Time dates & schedules' },
  { slug: 'holiday-calendar', name: 'Holiday Calendar', icon: '🎉', desc: 'Public holidays for 40+ countries' },
  { slug: 'travel-planner', name: 'Travel Planner', icon: '✈️', desc: 'Plan travel across time zones' },
  { slug: 'developer-tools', name: 'Developer Toolkit', icon: '🛠️', desc: 'Unix timestamp, ISO 8601 & more' },
  { slug: 'tools', name: 'All Tools', icon: '🧰', desc: 'Browse all time zone tools' },
];

const relatedTools = allTools.filter(t => t.slug !== currentSlug).slice(0, 4);
---

<section class="related-tools-widget content-section">
  <div class="widget-header">
    <div class="eyebrow">Related Tools</div>
    <h2>Related Tools</h2>
  </div>
  <div class="related-grid">
    {relatedTools.map(tool => (
      <article class="related-card">
        <h3 class="related-card-title"><a href={`/${tool.slug}/`}>{tool.icon} {tool.name}</a></h3>
        <p class="related-card-text">{tool.desc}</p>
      </article>
    ))}
  </div>
</section>
