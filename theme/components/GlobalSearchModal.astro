  function normalizeText(str: string): string {
    return (str || '')
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .trim();
  }

  function initSearchModal() {
    const modal = document.getElementById('global-search-modal');
    const input = document.getElementById('global-search-input') as HTMLInputElement | null;
    const resultsContainer = document.getElementById('search-results-list');
    const quickLinks = document.getElementById('search-quick-links');
    const closeBtn = document.getElementById('search-modal-close');

    if (!modal || !input || !resultsContainer) return;

    let selectedIndex = -1;
    let currentResults: SearchItem[] = [];
    let lastActiveElement: HTMLElement | null = null;

    const langCode = modal.getAttribute('data-lang') || 'en';
    const index = langCode === 'tr'
      ? SEARCH_INDEX_TR
      : langCode === 'fr' 
        ? SEARCH_INDEX_FR 
        : langCode === 'it'
          ? SEARCH_INDEX_IT
          : langCode === 'pt'
            ? SEARCH_INDEX_PT
            : langCode === 'nl'
              ? SEARCH_INDEX_NL
              : langCode === 'de' 
                ? SEARCH_INDEX_DE 
                : langCode === 'es' 
                  ? SEARCH_INDEX_ES 
                  : SEARCH_INDEX_EN;

    const scoreItem = (item: SearchItem, query: string, normQuery: string, words: string[]): number => {
      const normTitle = normalizeText(item.title);
      const normDesc = normalizeText(item.desc);
      const normCategory = normalizeText(item.category);
      const normKeywords = normalizeText(item.keywords || '');
      const haystack = `${normTitle} ${normDesc} ${normCategory} ${normKeywords}`;

      if (!words.every(w => haystack.includes(w))) {
        return -1;
      }

      let score = item.priority || 0;

      // 1. Exact phrase match in Title (Massive boost)
      if (normTitle === normQuery) {
        score += 2000;
      } else if (normTitle.includes(normQuery)) {
        score += 1000;
        if (normTitle.startsWith(normQuery)) score += 200;
      }

      // 2. Exact phrase match in Keywords / Description
      if (normKeywords.includes(normQuery)) {
        score += 400;
      }
      if (normDesc.includes(normQuery)) {
        score += 200;
      }

      // 3. Word matches weighting
      for (const w of words) {
        if (normTitle.includes(w)) score += 150;
        if (normDesc.includes(w)) score += 40;
        if (normCategory.includes(w)) score += 30;
        if (normKeywords.includes(w)) score += 20;
      }

      // 4. Directional & Intent Boosts
      if (normQuery.includes('est vers gmt') || normQuery.includes('est in gmt') || normQuery.includes('est a gmt') || normQuery.includes('est da gmt') || normQuery.includes('est para gmt') || normQuery.includes('est to gmt') || normQuery.includes('est naar gmt')) {
        if (item.url.includes('est-to-gmt')) score += 800;
        if (item.url === '/fr/' || item.url === '/it/' || item.url === '/pt/' || item.url === '/nl/' || item.url === '/de/' || item.url === '/es/' || item.url.includes('gmt-to-est')) score -= 400;
      } else if (normQuery.includes('gmt vers est') || normQuery.includes('gmt zu est') || normQuery.includes('gmt a est') || normQuery.includes('gmt da est') || normQuery.includes('gmt para est') || normQuery.includes('gmt to est') || normQuery.includes('gmt naar est')) {
        if (item.url === '/fr/' || item.url === '/it/' || item.url === '/pt/' || item.url === '/nl/' || item.url === '/de/' || item.url === '/es/' || item.url === '/') score += 800;
        if (item.url.includes('gmt-to-est')) score += 500;
        if (item.url.includes('est-to-gmt')) score -= 400;
      }

      return score;
    };

    const openSearch = (triggerEl?: HTMLElement | null) => {
      lastActiveElement = triggerEl || (document.activeElement as HTMLElement | null);
      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      if (lastActiveElement) lastActiveElement.setAttribute('aria-expanded', 'true');
      setTimeout(() => {
        input.focus();
        input.select();
      }, 50);
    };

    const closeSearch = () => {
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      if (lastActiveElement) {
        lastActiveElement.setAttribute('aria-expanded', 'false');
        lastActiveElement.focus();
      }
      input.value = '';
      selectedIndex = -1;
      currentResults = [];
      resultsContainer.innerHTML = '';
      if (quickLinks) quickLinks.style.display = 'block';
    };

    const updateSelection = (newIndex: number) => {
      const items = resultsContainer.querySelectorAll<HTMLAnchorElement>('.result-item');
      if (items.length === 0) {
        selectedIndex = -1;
        return;
      }

      items.forEach((item, i) => {
        if (i === newIndex) {
          item.classList.add('is-selected');
          item.setAttribute('aria-selected', 'true');
          item.scrollIntoView({ block: 'nearest' });
        } else {
          item.classList.remove('is-selected');
          item.setAttribute('aria-selected', 'false');
        }
      });
      selectedIndex = newIndex;
    };

    // Global Keydown (Ctrl+K, Cmd+K, Escape)
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        modal.classList.contains('is-open') ? closeSearch() : openSearch();
      } else if (e.key === 'Escape' && modal.classList.contains('is-open')) {
        e.preventDefault();
        closeSearch();
      }
    });

    if (closeBtn) {
      closeBtn.addEventListener('click', (e) => {
        e.preventDefault();
        closeSearch();
      });
    }

    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeSearch();
    });

    // Attach search triggers across site
    document.querySelectorAll('.trigger-global-search').forEach(el => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        openSearch(el as HTMLElement);
      });
    });

    // Input events
    input.addEventListener('input', () => {
      const query = input.value.trim();
      const normQuery = normalizeText(query);

      if (!normQuery) {
        selectedIndex = -1;
        currentResults = [];
        resultsContainer.innerHTML = '';
        if (quickLinks) quickLinks.style.display = 'block';
        return;
      }

      if (quickLinks) quickLinks.style.display = 'none';

      const words = normQuery.split(/\s+/).filter(Boolean);
      const scored: { item: SearchItem; score: number }[] = [];
      for (const item of index) {
        const s = scoreItem(item, query, normQuery, words);
        if (s > 0) {
          scored.push({ item, score: s });
        }
      }
      scored.sort((a, b) => b.score - a.score);
      currentResults = scored.map(s => s.item).slice(0, 8);

      if (currentResults.length === 0) {
        selectedIndex = -1;
        const noResultsText = langCode === 'pt'
          ? `Nenhum resultado encontrado para « ${query} »`
          : langCode === 'it'
            ? `Nessun risultato trovato per « ${query} »`
            : langCode === 'de' 
              ? `Keine Treffer gefunden für „${query}“` 
              : langCode === 'es' 
                ? `No se encontraron resultados para "${query}"` 
                : langCode === 'fr' 
                  ? `Aucun résultat trouvé pour « ${query} »` 
                  : `No matching results found for "${query}"`;
        resultsContainer.innerHTML = `<div style="text-align: center; padding: 1.5rem; color: var(--muted);">${noResultsText}</div>`;
        return;
      }

      resultsContainer.innerHTML = currentResults.map((item, idx) => `
        <a href="${item.url}" class="result-item" role="option" aria-selected="false" data-index="${idx}">
          <div>
            <div class="result-title">${item.title}</div>
            <div class="result-desc">${item.desc}</div>
          </div>
          <span class="result-badge">${item.category}</span>
        </a>
      `).join('');

      selectedIndex = -1;
    });

    // Keydown inside input for arrow navigation & enter
    input.addEventListener('keydown', (e) => {
      if (currentResults.length === 0) return;

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        const next = selectedIndex < currentResults.length - 1 ? selectedIndex + 1 : 0;
        updateSelection(next);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        const prev = selectedIndex > 0 ? selectedIndex - 1 : currentResults.length - 1;
        updateSelection(prev);
      } else if (e.key === 'Enter') {
        e.preventDefault();
        const targetIndex = selectedIndex >= 0 ? selectedIndex : 0;
        if (currentResults[targetIndex]) {
          window.location.href = currentResults[targetIndex].url;
        }
      }
    });

    // Tab key trapping inside modal
    modal.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab' || !modal.classList.contains('is-open')) return;
      const focusable = modal.querySelectorAll<HTMLElement>('input, button, [href], [tabindex]:not([tabindex="-1"])');
      if (focusable.length === 0) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];

      if (e.shiftKey) {
        if (document.activeElement === first) {
          e.preventDefault();
          last.focus();
        }
      } else {
        if (document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSearchModal);
  } else {
    initSearchModal();
  }
</script>
