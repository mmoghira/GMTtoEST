---
// Global Search Modal Component (Module 14 - Intelligent Search)
import { pageUrl } from "theme/i18n/config";

const { lang = "en", t } = Astro.props;
const isEs = lang === "es";
const isDe = lang === "de";
const isFr = lang === "fr";
const isIt = lang === "it";
const isPt = lang === "pt";
const isNl = lang === "nl";
const isTr = lang === "tr";
const categoryTitle = isDe ? "Beliebte Tools & Funktionen" : isEs ? "Herramientas y funciones populares" : isFr ? "Outils et fonctionnalités populaires" : isIt ? "Strumenti e funzioni popolari" : isPt ? "Ferramentas e recursos populares" : isNl ? "Populaire tools & functies" : isTr ? "Popüler Araçlar ve Özellikler" : "Popular Tools & Features";
const placeholderText = t?.nav?.searchPlaceholder || (isDe ? "Städte, Zeitzonen, Umrechner oder Ratgeber suchen..." : isEs ? "Buscar ciudades, zonas horarias, convertidores o guías..." : isFr ? "Rechercher des villes, fuseaux horaires, convertisseurs ou guides…" : isIt ? "Cerca città, fusi orari, convertitori o guide..." : isPt ? "Pesquisar cidades, fusos horários, conversores ou guias..." : isNl ? "Zoek steden, tijdzones, omrekenaars of gidsen..." : isTr ? "Şehirler, saat dilimleri, dönüştürücüler veya rehberler arayın..." : "Search cities, time zones, converters, or guides... (e.g. London, EST, Python)");
const closeAria = isDe ? "Suche schließen" : isEs ? "Cerrar búsqueda" : isFr ? "Fermer la recherche" : isIt ? "Chiudi ricerca" : isPt ? "Fechar pesquisa" : isNl ? "Zoeken sluiten" : isTr ? "Aramayı kapat" : "Close search";
const tagWorldClock = isDe ? "🌐 Weltuhr" : isEs ? "🌐 Reloj mundial" : isFr ? "🌐 Horloge mondiale" : isIt ? "🌐 Orologio mondiale" : isPt ? "🌐 Relógio mundial" : isNl ? "🌐 Wereldklok" : isTr ? "🌐 Dünya Saati" : "🌐 World Clock";
const tagMeetingPlanner = isDe ? "📅 Meeting-Planer" : isEs ? "📅 Planificador de reuniones" : isFr ? "📅 Planificateur de réunion" : isIt ? "📅 Pianificatore di riunioni" : isPt ? "📅 Planejador de reuniões" : isNl ? "📅 Vergaderplanner" : isTr ? "📅 Toplantı Planlayıcı" : "📅 Meeting Planner";
const tagTimeDiff = isDe ? "⏱️ Zeitdifferenz-Rechner" : isEs ? "⏱️ Calculadora de diferencia" : isFr ? "⏱️ Calculateur de décalage" : isIt ? "⏱️ Calcolatore di differenza" : isPt ? "⏱️ Calculadora de diferença" : isNl ? "⏱️ Tijdsverschilcalculator" : isTr ? "⏱️ Saat Farkı Hesaplayıcı" : "⏱️ Time Diff Calc";
const tagDevTools = isDe ? "👨‍💻 Entwickler-Tools" : isEs ? "👨‍💻 Herramientas de desarrollador" : isFr ? "👨‍💻 Outils développeur" : isIt ? "👨‍💻 Strumenti per sviluppatori" : isPt ? "👨‍💻 Ferramentas para desenvolvedores" : isNl ? "👨‍💻 Ontwikkelaarstools" : isTr ? "👨‍💻 Geliştirici Araçları" : "👨‍💻 Developer Tools";
const tagMap = isDe ? "🗺️ Zeitzonenkarte" : isEs ? "🗺️ Mapa interactivo" : isFr ? "🗺️ Carte interactive" : isIt ? "📚 Guida ai fusi" : isPt ? "📚 Guia de fusos" : isNl ? "📚 Tijdzonegids" : isTr ? "📚 Saat Dilimi Rehberi" : "🗺️ Interactive Map";
const tagTravel = isDe ? "✈️ Reiseplaner" : isEs ? "✈️ Planificador de viajes" : isFr ? "✈️ Planificateur de voyage" : isIt ? "✈️ Pianificatore di viaggio" : isPt ? "✈️ Planejador de viagem" : isNl ? "✈️ Reisplanner" : isTr ? "✈️ Seyahat Planlayıcı" : "✈️ Travel Planner";
const footerNav = isDe ? "Navigation: ↑ ↓ zum Auswählen" : isEs ? "Navegación: ↑ ↓ para seleccionar" : isFr ? "Navigation : ↑ ↓ pour sélectionner" : isIt ? "Navigazione: ↑ ↓ per selezionare" : isPt ? "Navegação: ↑ ↓ para selecionar" : isNl ? "Navigatie: ↑ ↓ om te selecteren" : isTr ? "Gezinti: ↑ ↓ seçmek için" : "Navigation: ↑ ↓ to select";
const footerOpen = isDe ? "Öffnen: ↵ Enter" : isEs ? "Abrir: ↵ Enter" : isFr ? "Ouvrir : ↵ Entrée" : isIt ? "Apri: ↵ Invio" : isPt ? "Abrir: ↵ Enter" : isNl ? "Openen: ↵ Enter" : isTr ? "Aç: ↵ Enter" : "Open: ↵ Enter";
const footerClose = isDe ? "Schließen: ESC" : isEs ? "Cerrar: ESC" : isFr ? "Fermer : Échap" : isIt ? "Chiudi: ESC" : isPt ? "Fechar: ESC" : isNl ? "Sluiten: ESC" : isTr ? "Kapat: ESC" : "Close: ESC";
---
<div id="global-search-modal" class="search-modal-backdrop" data-lang={lang} aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="search-modal-title">
  <div class="search-modal-container">
    <div class="search-modal-header">
      <div class="search-input-wrapper">
        <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input 
          type="text" 
          id="global-search-input" 
          placeholder={placeholderText} 
          autocomplete="off" 
          spellcheck="false"
        />
        <button id="search-modal-close" class="close-btn" aria-label={closeAria}>
          <kbd>ESC</kbd>
        </button>
      </div>
    </div>

    <div class="search-modal-body">
      <div id="search-quick-links" class="search-categories">
        <div class="category-title">{categoryTitle}</div>
        <div class="quick-tags">
          <a href={pageUrl(lang, "world-clock")} class="search-tag">{tagWorldClock}</a>
          <a href={pageUrl(lang, "meeting-planner")} class="search-tag">{tagMeetingPlanner}</a>
          <a href={pageUrl(lang, "time-difference-calculator")} class="search-tag">{tagTimeDiff}</a>
          <a href={pageUrl(lang, "developer-tools")} class="search-tag">{tagDevTools}</a>
          <a href={isFr || isIt || isPt || isNl || isTr ? pageUrl(lang, "time-zone-guide") : "/time-zone-map/"} class="search-tag">{isFr ? "📚 Guide des fuseaux" : isIt ? "📚 Guida ai fusi" : isPt ? "📚 Guia de fusos" : isNl ? "📚 Tijdzonegids" : isTr ? "📚 Saat Dilimi Rehberi" : tagMap}</a>
          <a href={pageUrl(lang, "travel-planner")} class="search-tag">{tagTravel}</a>
        </div>
      </div>

      <div id="search-results-list" class="results-list" role="listbox"></div>
    </div>

    <div class="search-modal-footer">
      <span>{footerNav}</span>
      <span>{footerOpen}</span>
      <span>{footerClose}</span>
    </div>
  </div>
</div>

<style>
  .search-modal-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(15, 23, 42, 0.75);
    backdrop-filter: blur(8px);
    z-index: 99999;
    display: none;
    align-items: flex-start;
    justify-content: center;
    padding-top: 10vh;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .search-modal-backdrop.is-open {
    display: flex;
    opacity: 1;
  }

  .search-modal-container {
    background: var(--panel, #1e293b);
    border: 1px solid var(--line, rgba(255,255,255,0.15));
    border-radius: 12px;
    width: 90%;
    max-width: 680px;
    max-height: 80vh;
    display: flex;
    flex-direction: column;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    overflow: hidden;
    color: var(--text, #f8fafc);
  }

  .search-modal-header {
    padding: 1rem;
    border-bottom: 1px solid var(--line, rgba(255,255,255,0.1));
  }

  .search-input-wrapper {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--background, #0f172a);
    padding: 0.75rem 1rem;
    border-radius: 8px;
    border: 1px solid var(--line, rgba(255,255,255,0.1));
  }

  .search-icon {
    color: var(--muted, #94a3b8);
    flex-shrink: 0;
  }

  #global-search-input {
    flex: 1;
    background: transparent;
    border: none;
    color: var(--text, #f8fafc);
    font-size: 1.05rem;
    outline: none;
    font-family: inherit;
  }

  .close-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    color: var(--muted, #94a3b8);
  }

  kbd {
    background: var(--panel, #334155);
    color: var(--muted, #cbd5e1);
    font-size: 0.75rem;
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    border: 1px solid var(--line, #475569);
    font-family: monospace;
  }

  .search-modal-body {
    padding: 1rem;
    overflow-y: auto;
    max-height: 55vh;
  }

  .category-title {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted, #94a3b8);
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  .quick-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .search-tag {
    background: var(--background, #0f172a);
    border: 1px solid var(--line, rgba(255,255,255,0.1));
    color: var(--text, #f8fafc);
    padding: 0.4rem 0.8rem;
    border-radius: 20px;
    font-size: 0.85rem;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .search-tag:hover {
    border-color: var(--accent, #38bdf8);
    color: var(--accent, #38bdf8);
  }

  .results-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .result-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    background: var(--background, #0f172a);
    border-radius: 8px;
    text-decoration: none;
    color: var(--text, #f8fafc);
    border: 1px solid transparent;
    transition: all 0.15s ease;
  }

  .result-item:hover, .result-item.is-selected {
    border-color: var(--accent, #38bdf8);
    background: rgba(56, 189, 248, 0.08);
  }

  .result-title {
    font-weight: 600;
    font-size: 0.95rem;
  }

  .result-desc {
    font-size: 0.8rem;
    color: var(--muted, #94a3b8);
  }

  .result-badge {
    font-size: 0.75rem;
    background: var(--panel, #334155);
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    color: var(--accent, #38bdf8);
  }

  .search-modal-footer {
    padding: 0.75rem 1rem;
    background: var(--background, #0f172a);
    border-top: 1px solid var(--line, rgba(255,255,255,0.1));
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.8rem;
    color: var(--muted, #94a3b8);
  }
</style>

<script defer src="/assets/search-modal.js?v=2.2"></script>
