---
// Global Search Modal Component (Module 14 - Intelligent Search)
import { pageUrl } from "theme/i18n/config";

const { lang = "en", t } = Astro.props;
const isEs = lang === "es";
const isDe = lang === "de";
const isFr = lang === "fr";
const isIt = lang === "it";
const isPt = lang === "pt";
const isNl = lang === "nl";
const isTr = lang === "tr";
const categoryTitle = isDe ? "Beliebte Tools & Funktionen" : isEs ? "Herramientas y funciones populares" : isFr ? "Outils et fonctionnalités populaires" : isIt ? "Strumenti e funzioni popolari" : isPt ? "Ferramentas e recursos populares" : isNl ? "Populaire tools & functies" : isTr ? "Popüler Araçlar ve Özellikler" : "Popular Tools & Features";
const placeholderText = t?.nav?.searchPlaceholder || (isDe ? "Städte, Zeitzonen, Umrechner oder Ratgeber suchen..." : isEs ? "Buscar ciudades, zonas horarias, convertidores o guías..." : isFr ? "Rechercher des villes, fuseaux horaires, convertisseurs ou guides…" : isIt ? "Cerca città, fusi orari, convertitori o guide..." : isPt ? "Pesquisar cidades, fusos horários, conversores ou guias..." : isNl ? "Zoek steden, tijdzones, omrekenaars of gidsen..." : isTr ? "Şehirler, saat dilimleri, dönüştürücüler veya rehberler arayın..." : "Search cities, time zones, converters, or guides... (e.g. London, EST, Python)");
const closeAria = isDe ? "Suche schließen" : isEs ? "Cerrar búsqueda" : isFr ? "Fermer la recherche" : isIt ? "Chiudi ricerca" : isPt ? "Fechar pesquisa" : isNl ? "Zoeken sluiten" : isTr ? "Aramayı kapat" : "Close search";
const tagWorldClock = isDe ? "🌐 Weltuhr" : isEs ? "🌐 Reloj mundial" : isFr ? "🌐 Horloge mondiale" : isIt ? "🌐 Orologio mondiale" : isPt ? "🌐 Relógio mundial" : isNl ? "🌐 Wereldklok" : isTr ? "🌐 Dünya Saati" : "🌐 World Clock";
const tagMeetingPlanner = isDe ? "📅 Meeting-Planer" : isEs ? "📅 Planificador de reuniones" : isFr ? "📅 Planificateur de réunion" : isIt ? "📅 Pianificatore di riunioni" : isPt ? "📅 Planejador de reuniões" : isNl ? "📅 Vergaderplanner" : isTr ? "📅 Toplantı Planlayıcı" : "📅 Meeting Planner";
const tagTimeDiff = isDe ? "⏱️ Zeitdifferenz-Rechner" : isEs ? "⏱️ Calculadora de diferencia" : isFr ? "⏱️ Calculateur de décalage" : isIt ? "⏱️ Calcolatore di differenza" : isPt ? "⏱️ Calculadora de diferença" : isNl ? "⏱️ Tijdsverschilcalculator" : isTr ? "⏱️ Saat Farkı Hesaplayıcı" : "⏱️ Time Diff Calc";
const tagDevTools = isDe ? "👨‍💻 Entwickler-Tools" : isEs ? "👨‍💻 Herramientas de desarrollador" : isFr ? "👨‍💻 Outils développeur" : isIt ? "👨‍💻 Strumenti per sviluppatori" : isPt ? "👨‍💻 Ferramentas para desenvolvedores" : isNl ? "👨‍💻 Ontwikkelaarstools" : isTr ? "👨‍💻 Geliştirici Araçları" : "👨‍💻 Developer Tools";
const tagMap = isDe ? "🗺️ Zeitzonenkarte" : isEs ? "🗺️ Mapa interactivo" : isFr ? "🗺️ Carte interactive" : isIt ? "📚 Guida ai fusi" : isPt ? "📚 Guia de fusos" : isNl ? "📚 Tijdzonegids" : isTr ? "📚 Saat Dilimi Rehberi" : "🗺️ Interactive Map";
const tagTravel = isDe ? "✈️ Reiseplaner" : isEs ? "✈️ Planificador de viajes" : isFr ? "✈️ Planificateur de voyage" : isIt ? "✈️ Pianificatore di viaggio" : isPt ? "✈️ Planejador de viagem" : isNl ? "✈️ Reisplanner" : isTr ? "✈️ Seyahat Planlayıcı" : "✈️ Travel Planner";
const footerNav = isDe ? "Navigation: ↑ ↓ zum Auswählen" : isEs ? "Navegación: ↑ ↓ para seleccionar" : isFr ? "Navigation : ↑ ↓ pour sélectionner" : isIt ? "Navigazione: ↑ ↓ per selezionare" : isPt ? "Navegação: ↑ ↓ para selecionar" : isNl ? "Navigatie: ↑ ↓ om te selecteren" : isTr ? "Gezinti: ↑ ↓ seçmek için" : "Navigation: ↑ ↓ to select";
const footerOpen = isDe ? "Öffnen: ↵ Enter" : isEs ? "Abrir: ↵ Enter" : isFr ? "Ouvrir : ↵ Entrée" : isIt ? "Apri: ↵ Invio" : isPt ? "Abrir: ↵ Enter" : isNl ? "Openen: ↵ Enter" : isTr ? "Aç: ↵ Enter" : "Open: ↵ Enter";
const footerClose = isDe ? "Schließen: ESC" : isEs ? "Cerrar: ESC" : isFr ? "Fermer : Échap" : isIt ? "Chiudi: ESC" : isPt ? "Fechar: ESC" : isNl ? "Sluiten: ESC" : isTr ? "Kapat: ESC" : "Close: ESC";
---
<div id="global-search-modal" class="search-modal-backdrop" data-lang={lang} aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="search-modal-title">
  <div class="search-modal-container">
    <div class="search-modal-header">
      <div class="search-input-wrapper">
        <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input 
          type="text" 
          id="global-search-input" 
          placeholder={placeholderText} 
          autocomplete="off" 
          spellcheck="false"
        />
        <button id="search-modal-close" class="close-btn" aria-label={closeAria}>
          <kbd>ESC</kbd>
        </button>
      </div>
    </div>

    <div class="search-modal-body">
      <div id="search-quick-links" class="search-categories">
        <div class="category-title">{categoryTitle}</div>
        <div class="quick-tags">
          <a href={pageUrl(lang, "world-clock")} class="search-tag">{tagWorldClock}</a>
          <a href={pageUrl(lang, "meeting-planner")} class="search-tag">{tagMeetingPlanner}</a>
          <a href={pageUrl(lang, "time-difference-calculator")} class="search-tag">{tagTimeDiff}</a>
          <a href={pageUrl(lang, "developer-tools")} class="search-tag">{tagDevTools}</a>
          <a href={isFr || isIt || isPt || isNl || isTr ? pageUrl(lang, "time-zone-guide") : "/time-zone-map/"} class="search-tag">{isFr ? "📚 Guide des fuseaux" : isIt ? "📚 Guida ai fusi" : isPt ? "📚 Guia de fusos" : isNl ? "📚 Tijdzonegids" : isTr ? "📚 Saat Dilimi Rehberi" : tagMap}</a>
          <a href={pageUrl(lang, "travel-planner")} class="search-tag">{tagTravel}</a>
        </div>
      </div>

      <div id="search-results-list" class="results-list" role="listbox"></div>
    </div>

    <div class="search-modal-footer">
      <span>{footerNav}</span>
      <span>{footerOpen}</span>
      <span>{footerClose}</span>
    </div>
  </div>
</div>

<style>
  .search-modal-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(15, 23, 42, 0.75);
    backdrop-filter: blur(8px);
    z-index: 99999;
    display: none;
    align-items: flex-start;
    justify-content: center;
    padding-top: 10vh;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .search-modal-backdrop.is-open {
    display: flex;
    opacity: 1;
  }

  .search-modal-container {
    background: var(--panel, #1e293b);
    border: 1px solid var(--line, rgba(255,255,255,0.15));
    border-radius: 12px;
    width: 90%;
    max-width: 680px;
    max-height: 80vh;
    display: flex;
    flex-direction: column;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    overflow: hidden;
    color: var(--text, #f8fafc);
  }

  .search-modal-header {
    padding: 1rem;
    border-bottom: 1px solid var(--line, rgba(255,255,255,0.1));
  }

  .search-input-wrapper {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--background, #0f172a);
    padding: 0.75rem 1rem;
    border-radius: 8px;
    border: 1px solid var(--line, rgba(255,255,255,0.1));
  }

  .search-icon {
    color: var(--muted, #94a3b8);
    flex-shrink: 0;
  }

  #global-search-input {
    flex: 1;
    background: transparent;
    border: none;
    color: var(--text, #f8fafc);
    font-size: 1.05rem;
    outline: none;
    font-family: inherit;
  }

  .close-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    color: var(--muted, #94a3b8);
  }

  kbd {
    background: var(--panel, #334155);
    color: var(--muted, #cbd5e1);
    font-size: 0.75rem;
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    border: 1px solid var(--line, #475569);
    font-family: monospace;
  }

  .search-modal-body {
    padding: 1rem;
    overflow-y: auto;
    max-height: 55vh;
  }

  .category-title {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted, #94a3b8);
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  .quick-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .search-tag {
    background: var(--background, #0f172a);
    border: 1px solid var(--line, rgba(255,255,255,0.1));
    color: var(--text, #f8fafc);
    padding: 0.4rem 0.8rem;
    border-radius: 20px;
    font-size: 0.85rem;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .search-tag:hover {
    border-color: var(--accent, #38bdf8);
    color: var(--accent, #38bdf8);
  }

  .results-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .result-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    background: var(--background, #0f172a);
    border-radius: 8px;
    text-decoration: none;
    color: var(--text, #f8fafc);
    border: 1px solid transparent;
    transition: all 0.15s ease;
  }

  .result-item:hover, .result-item.is-selected {
    border-color: var(--accent, #38bdf8);
    background: rgba(56, 189, 248, 0.08);
  }

  .result-title {
    font-weight: 600;
    font-size: 0.95rem;
  }

  .result-desc {
    font-size: 0.8rem;
    color: var(--muted, #94a3b8);
  }

  .result-badge {
    font-size: 0.75rem;
    background: var(--panel, #334155);
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    color: var(--accent, #38bdf8);
  }

  .search-modal-footer {
    padding: 0.75rem 1rem;
    background: var(--background, #0f172a);
    border-top: 1px solid var(--line, rgba(255,255,255,0.1));
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.8rem;
    color: var(--muted, #94a3b8);
  }
</style>

<script>
  interface SearchItem {
    title: string;
    url: string;
    desc: string;
    category: string;
    keywords?: string;
    priority?: number;
  }

  const SEARCH_INDEX_FR: SearchItem[] = [
    { title: "Convertisseur GMT vers EST", url: "/fr/", desc: "Convertisseur principal heure GMT vers EST/EDT en direct avec tableau 24 h", category: "Convertisseur", keywords: "gmt vers est heure est edt conversion direct accueil principal", priority: 10 },
    { title: "GMT vers EST : Calculateur d'heure", url: "/fr/gmt-to-est/", desc: "Calculateur de décalage horaire GMT vers EST/EDT et tableau 24 h", category: "Convertisseur", keywords: "gmt vers est calcul tableau 24h conversion heure par heure decalage", priority: 8 },
    { title: "Convertisseur EST vers GMT", url: "/fr/est-to-gmt/", desc: "Convertir l'heure de l'Est (EST/EDT) vers GMT en direct avec gestion heure d'été", category: "Convertisseur", keywords: "est vers gmt conversion inverse heure de l est heure d ete", priority: 9 },
    { title: "Différence GMT vs EST", url: "/fr/gmt-vs-est/", desc: "Comparaison des fuseaux horaires GMT et EST/EDT, décalage et dates de changement d'heure d'été", category: "Comparaison", keywords: "gmt vs est difference decalage comparaison hiver ete 5 heures 4 heures fuseau horaire heure d ete", priority: 7 },
    { title: "Guide des fuseaux horaires", url: "/fr/time-zone-guide/", desc: "Comprendre GMT, UTC, EST, EDT et les règles de l'heure d'été", category: "Guide", keywords: "guide fuseaux horaires fuseau horaire utc gmt est edt ete hiver calcul explication heure d ete", priority: 8 },
    { title: "Horloge mondiale", url: "/fr/world-clock/", desc: "Horloges en direct et fuseaux horaires des grandes villes du monde", category: "Outil", keywords: "horloge mondiale world clock villes heure monde temps paris new york londres tokyo direct fuseaux horaires", priority: 7 },
    { title: "Planificateur de réunion", url: "/fr/meeting-planner/", desc: "Trouver les créneaux communs et heures de travail entre plusieurs villes", category: "Outil", keywords: "planificateur de reunion meeting planner fuseaux horaires overlap travail synchronisation creneaux", priority: 6 },
    { title: "Calculateur de décalage horaire", url: "/fr/time-difference-calculator/", desc: "Calculer la différence d'heures exacte entre deux villes ou fuseaux", category: "Outil", keywords: "calculateur de decalage horaire time difference difference d heure calcul fuseau horaire", priority: 7 },
    { title: "Convertisseur d'heure d'événement", url: "/fr/event-time-converter/", desc: "Créer des liens d'événements et exporter vers les calendriers .ics", category: "Outil", keywords: "evenement event calendrier ics export heure reunion invitation", priority: 5 },
    { title: "Outils pour développeurs", url: "/fr/developer-tools/", desc: "Conversion Timestamp Unix, ISO 8601, fuseaux IANA et extraits de code", category: "Développeur", keywords: "outils developpeur dev timestamp unix iso 8601 iana api code javascript python timestamp conversion", priority: 5 },
    { title: "Chevauchement des heures de bureau", url: "/fr/business-hours-overlap/", desc: "Visualiser les plages horaires compatibles pour équipes à distance", category: "Outil", keywords: "heures de bureau business hours travail remote equipe distance compatibilite", priority: 4 },
    { title: "Calendrier des jours fériés", url: "/fr/holiday-calendar/", desc: "Jours fériés internationaux et jours ouvrés", category: "Outil", keywords: "jours feries holiday calendar calendrier travail ouvrees ferie", priority: 4 },
    { title: "Planificateur de voyage", url: "/fr/travel-planner/", desc: "Heures d'arrivée et gestion du décalage horaire (jet lag)", category: "Outil", keywords: "voyage travel planner jet lag vol avion arrivee vol fuseau", priority: 4 },
    { title: "Heure à Paris", url: "/fr/world-clock/", desc: "Heure locale actuelle à Paris, France (CET/CEST)", category: "Ville", keywords: "paris france heure cet cest europe capitale", priority: 3 },
    { title: "Heure à New York", url: "/fr/world-clock/", desc: "Heure locale actuelle à New York, États-Unis (EST/EDT)", category: "Ville", keywords: "new york usa etats-unis heure est edt amerique", priority: 3 },
    { title: "Heure à Londres", url: "/fr/world-clock/", desc: "Heure locale actuelle à Londres, Royaume-Uni (GMT/BST)", category: "Ville", keywords: "londres london royaume-uni uk gmt bst angleterre", priority: 3 },
    { title: "À propos", url: "/fr/about-us/", desc: "En savoir plus sur Convertisseur GMT vers EST et notre équipe", category: "Information", keywords: "a propos about equipe mission contact fonctionnement", priority: 2 },
    { title: "Contact", url: "/fr/contact-us/", desc: "Contacter l'équipe du Convertisseur GMT vers EST", category: "Information", keywords: "contact support aide email message assistance", priority: 2 }
  ];

  const SEARCH_INDEX_IT: SearchItem[] = [
    { title: "Convertitore da GMT a EST", url: "/it/", desc: "Convertitore principale ora GMT verso EST/EDT in tempo reale con tabella 24 ore", category: "Convertitore", keywords: "gmt a est convertitore ora est edt conversione tempo reale home principale", priority: 10 },
    { title: "Convertitore da EST a GMT", url: "/it/est-to-gmt/", desc: "Converti l'Eastern Time (EST/EDT) in GMT in tempo reale con orologi live", category: "Convertitore", keywords: "est a gmt conversione inversa eastern time ora legale edt", priority: 9 },
    { title: "Differenza tra GMT ed EST", url: "/it/gmt-vs-est/", desc: "Confronto dei fusi orari GMT ed EST/EDT, scarto orario e date ora legale negli USA", category: "Confronto", keywords: "gmt vs est differenza scarto orario confronto inverno estate 5 ore 4 ore fuso orario ora legale", priority: 7 },
    { title: "Guida ai fusi orari", url: "/it/time-zone-guide/", desc: "Comprendere GMT, UTC, EST, EDT e le regole dell'ora legale", category: "Guida", keywords: "guida fusi orari fuso orario utc gmt est edt estate inverno calcolo spiegazione ora legale", priority: 8 },
    { title: "Orologio mondiale", url: "/it/world-clock/", desc: "Orologi in tempo reale e fusi orari delle principali metropoli mondiali", category: "Strumento", keywords: "orologio mondiale world clock citta ora mondo tempo roma new york londra tokyo diretta fusi orari", priority: 7 },
    { title: "Pianificatore di riunioni", url: "/it/meeting-planner/", desc: "Trova le fasce orarie compatibili e l'orario lavorativo condiviso tra più città", category: "Strumento", keywords: "pianificatore riunioni meeting planner fusi orari lavoro sovrapposizione sincronizzazione", priority: 6 },
    { title: "Calcolatore di differenza oraria", url: "/it/time-difference-calculator/", desc: "Calcola l'esatta differenza di fuso orario in ore tra due città o zone", category: "Strumento", keywords: "calcolatore differenza oraria time difference differenza di orario calcolo fuso", priority: 7 },
    { title: "Convertitore di orario per eventi", url: "/it/event-time-converter/", desc: "Crea link di eventi condivisibili ed esporta in formato calendario .ics", category: "Strumento", keywords: "evento event calendario ics export ora riunione invito", priority: 5 },
    { title: "Strumenti per sviluppatori", url: "/it/developer-tools/", desc: "Timestamp Unix, generatore ISO 8601, fusi IANA ed esempi di codice", category: "Sviluppatore", keywords: "strumenti sviluppatori dev timestamp unix iso 8601 iana api codice javascript python conversione timestamp", priority: 5 },
    { title: "Sovrapposizione orario lavorativo", url: "/it/business-hours-overlap/", desc: "Visualizza le fasce di lavoro condivise per team che collaborano da remoto", category: "Strumento", keywords: "orario di ufficio business hours lavoro remoto team distanza compatibilita", priority: 4 },
    { title: "Calendario delle festività", url: "/it/holiday-calendar/", desc: "Festività internazionali e conteggio dei giorni lavorativi", category: "Strumento", keywords: "giorni festivi holiday calendar calendario lavoro festivi feriali", priority: 4 },
    { title: "Pianificatore di viaggio", url: "/it/travel-planner/", desc: "Orari di arrivo locali e gestione del jet lag", category: "Strumento", keywords: "viaggio travel planner jet lag volo aereo arrivo fuso", priority: 4 },
    { title: "Ora a Roma", url: "/it/world-clock/", desc: "Ora locale attuale a Roma, Italia (CET/CEST)", category: "Città", keywords: "roma italia ora cet cest europa capitale", priority: 3 },
    { title: "Ora a New York", url: "/it/world-clock/", desc: "Ora locale attuale a New York, Stati Uniti (EST/EDT)", category: "Città", keywords: "new york usa stati uniti ora est edt america", priority: 3 },
    { title: "Ora a Londra", url: "/it/world-clock/", desc: "Ora locale attuale a Londra, Regno Unito (GMT/BST)", category: "Città", keywords: "londra london regno unito uk gmt bst inghilterra", priority: 3 },
    { title: "Tabella da GMT a EST", url: "/it/gmt-to-est/", desc: "Calcolo e conversione da GMT a EST con tabella oraria a 24 ore", category: "Convertitore", keywords: "gmt to est tabella oraria calcolo fuso orario conversione 24 ore", priority: 8 },
    { title: "Blog e guide", url: "/it/blog/", desc: "Articoli, approfondimenti e notizie sui fusi orari mondiali", category: "Blog", keywords: "blog guide articoli notizie nba finali orari fusi", priority: 6 },
    { title: "Chi siamo", url: "/it/about-us/", desc: "Informazioni sul Convertitore da GMT a EST e sul nostro team editoriale", category: "Informazioni", keywords: "chi siamo about team missione redazione contatti", priority: 2 },
    { title: "Contattaci", url: "/it/contact-us/", desc: "Contatta il team di GMTtoEST Converter per domande o supporto", category: "Informazioni", keywords: "contattaci contatto supporto aiuto email messaggio assistenza", priority: 2 }
  ];

  const SEARCH_INDEX_PT: SearchItem[] = [
    { title: "Conversor de GMT para EST", url: "/pt/", desc: "Conversor principal de horário GMT para EST/EDT em tempo real com tabela de 24 horas", category: "Conversor", keywords: "gmt para est conversor hora est edt conversao tempo real home principal", priority: 10 },
    { title: "Conversor de EST para GMT", url: "/pt/est-to-gmt/", desc: "Converta o Horário do Leste (EST/EDT) para GMT em tempo real com relógios ao vivo", category: "Conversor", keywords: "est para gmt conversao inversa eastern time horario de verao edt", priority: 9 },
    { title: "Diferença entre GMT e EST", url: "/pt/gmt-vs-est/", desc: "Comparação de fusos horários GMT e EST/EDT, diferença horária e calendário do horário de verão", category: "Comparação", keywords: "gmt vs est diferenca diferenca de horario comparacao inverno verao 5 horas 4 horas fuso horario", priority: 7 },
    { title: "Guia de fusos horários", url: "/pt/time-zone-guide/", desc: "Entenda GMT, UTC, EST, EDT e as regras do horário de verão", category: "Guia", keywords: "guia fusos horarios fuso horario utc gmt est edt verao inverno calculo explicacao horario de verao", priority: 8 },
    { title: "Relógio mundial", url: "/pt/world-clock/", desc: "Relógios em tempo real e fusos horários das principais cidades do mundo", category: "Ferramenta", keywords: "relogio mundial world clock cidades hora mundo tempo sao paulo lisboa nova york londres toquio ao vivo", priority: 7 },
    { title: "Planejador de reuniões", url: "/pt/meeting-planner/", desc: "Encontre horários de trabalho compartilhados e compatíveis entre várias cidades", category: "Ferramenta", keywords: "planejador de reunioes meeting planner fusos horarios trabalho sobreposicao sincronizacao", priority: 6 },
