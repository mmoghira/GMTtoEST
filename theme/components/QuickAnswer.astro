---
import { getQuickAnswerPayload } from "../utils/quickAnswerData";

interface Props {
  context?: {
    from?: string;
    to?: string;
    fromZone?: string;
    toZone?: string;
  };
  sourceZone?: string;
}

const { context, sourceZone } = Astro.props;
const source = context?.from || sourceZone || "GMT";
const target = context?.to || "EST";
const payload = getQuickAnswerPayload(source, target);
const isGmtToEst = (source === "GMT" || source === "UTC") && (target === "EST" || target === "EDT" || target === "ET");
---

<aside
  class="quick-answer-card google-anno-skip adsbygoogle-noablate"
  data-google-query-id="none"
  data-ad-status="unfilled"
  data-source={source}
  data-target={target}
  aria-label={`Quick Answer: ${payload.zoneA} to ${payload.zoneB} Conversion`}
>
  <div class="quick-answer-badge">
    <span class="quick-answer-badge-icon" aria-hidden="true">⚡</span>
    <span>Quick Answer</span>
  </div>

  <p class="quick-answer-definition">
    {payload.definitionSentence}
  </p>

  <p class="quick-answer-live" id={isGmtToEst ? "qa-live-line" : undefined}>
    <span class="live-pulse" aria-hidden="true"></span>
    {payload.liveLineHtml ? (
      <span id={isGmtToEst ? "qa-live-text" : undefined} set:html={payload.liveLineHtml} />
    ) : (
      <span id={isGmtToEst ? "qa-live-text" : undefined}>Right now: <strong>{payload.sourceLiveTime} {payload.zoneA}</strong> = <strong>{payload.targetLiveTime} {payload.zoneB}</strong></span>
    )}
  </p>

  <div class="quick-answer-table-wrapper google-anno-skip adsbygoogle-noablate">
    <table class="quick-answer-table google-anno-skip adsbygoogle-noablate">
      <caption class="quick-answer-caption">
        {payload.tableCaption}
      </caption>
      <thead>
        <tr>
          <th scope="col">{payload.zoneA} Time</th>
          <th scope="col" id={isGmtToEst ? "qa-target-header" : undefined}>{payload.zoneBHeader}</th>
        </tr>
      </thead>
      <tbody id={isGmtToEst ? "qa-table-body" : undefined}>
        {payload.tableConversions.map((row) => (
          <tr>
            <td><strong>{row.sourceTime}</strong></td>
            <td><strong>{row.targetTime || row.estTime}</strong></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</aside>

{isGmtToEst && (
  <script is:inline>
    (function initQuickAnswerLiveClock() {
      function updateQaLiveClock() {
        var textEl = document.getElementById('qa-live-text');
        if (!textEl) return;
        var now = new Date();
        var gmtStr = new Intl.DateTimeFormat('en-US', {
          hour: 'numeric',
          minute: '2-digit',
          hour12: true,
          timeZone: 'UTC'
        }).format(now);

        var estParts = new Intl.DateTimeFormat('en-US', {
          hour: 'numeric',
          minute: '2-digit',
          timeZoneName: 'short',
          hour12: true,
          timeZone: 'America/New_York'
        }).formatToParts(now);

        var estTime = estParts
          .filter(function(p) { return p.type !== 'timeZoneName'; })
          .map(function(p) { return p.value; })
          .join('')
          .trim();
        var estZoneObj = estParts.find(function(p) { return p.type === 'timeZoneName'; });
        var estZoneName = estZoneObj ? estZoneObj.value.trim() : '';
        var zoneLabel = (estZoneName === 'EDT' || estZoneName === 'EST') 
          ? estZoneName 
          : (new Intl.DateTimeFormat('en-US', { timeZone: 'America/New_York', month: 'numeric' }).format(now) >= 3 && new Intl.DateTimeFormat('en-US', { timeZone: 'America/New_York', month: 'numeric' }).format(now) <= 11 ? 'EDT' : 'EST');

        textEl.innerHTML = 'Right now: <strong>' + gmtStr + ' GMT</strong> = <strong>' + estTime + ' ' + zoneLabel + '</strong>';
      }

      updateQaLiveClock();
      setInterval(updateQaLiveClock, 60000);

      function evictAdsFromQuickAnswer() {
        var card = document.querySelector('.quick-answer-card');
        if (!card) return;
        var ads = card.querySelectorAll('ins.adsbygoogle, .google-anno, .google-anno-container, [id*="google-anno"], [class*="google-anno"], iframe[id*="aswift"], iframe[src*="google"], [data-ad-slot], [data-ad-client]');
        for (var i = 0; i < ads.length; i++) {
          var ad = ads[i];
          if (card.contains(ad)) {
            card.parentNode.insertBefore(ad, card.nextSibling);
          }
        }
      }
      evictAdsFromQuickAnswer();
      if (window.MutationObserver) {
        var card = document.querySelector('.quick-answer-card');
        if (card) {
          var observer = new MutationObserver(evictAdsFromQuickAnswer);
          observer.observe(card, { childList: true, subtree: true });
        }
      }
    })();
  </script>
)}

<style>
  .quick-answer-card {
    background: var(--panel, #0f172a);
    border: 1px solid rgba(54, 199, 181, 0.3);
    border-radius: 12px;
    padding: 1.25rem 1.5rem;
    margin: 0 auto 1.5rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
    color: var(--text, #f8fafc);
  }

  .quick-answer-card ins.adsbygoogle,
  .quick-answer-card .google-anno-container,
  .quick-answer-card [class*="google-anno"],
  .quick-answer-card [id*="google-anno"] {
    display: none !important;
  }

  .quick-answer-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.65rem;
    background: rgba(54, 199, 181, 0.15);
    border: 1px solid var(--accent, #36c7b5);
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent, #36c7b5);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
  }

  .quick-answer-badge-icon {
    font-size: 0.85rem;
    line-height: 1;
  }

  .quick-answer-definition {
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.6;
    margin: 0 0 0.75rem;
    color: var(--text, #f8fafc);
  }

  .quick-answer-live {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    color: var(--muted, #94a3b8);
    margin: 0 0 1rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--line, rgba(255, 255, 255, 0.1));
  }

  .quick-answer-live strong {
    color: var(--accent-2, #5eead4);
  }

  .live-pulse {
    width: 8px;
    height: 8px;
    background: #10b981;
    border-radius: 50%;
    display: inline-block;
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.25);
    flex-shrink: 0;
  }

  .quick-answer-table-wrapper {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .quick-answer-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    text-align: left;
  }

  .quick-answer-table th {
    padding: 0.5rem 0.75rem;
    background: rgba(255, 255, 255, 0.03);
    color: var(--muted, #94a3b8);
    font-weight: 600;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border-bottom: 1px solid var(--line, rgba(255, 255, 255, 0.1));
  }

  .quick-answer-table td {
    padding: 0.55rem 0.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    color: var(--text, #f8fafc);
  }

  .quick-answer-table tbody tr:last-child td {
    border-bottom: none;
  }

  .quick-answer-table tbody tr:hover td {
    background: rgba(54, 199, 181, 0.05);
  }

  .quick-answer-caption {
    caption-side: bottom;
    padding-top: 0.65rem;
    font-size: 0.8rem;
    color: var(--muted, #94a3b8);
    line-height: 1.4;
    text-align: left;
  }

  @media (max-width: 640px) {
    .quick-answer-card {
      padding: 1rem;
    }

    .quick-answer-definition {
      font-size: 0.98rem;
    }

    .quick-answer-table th,
    .quick-answer-table td {
      padding: 0.45rem 0.5rem;
      font-size: 0.85rem;
    }
  }
</style>
