---
const { t, keywordHeading = "", lang = "en" } = Astro.props;
const blocks = Array.from({ length: 12 }, (_, i) => i);
const isEs = lang === "es";
const isDe = lang === "de";
const isFr = lang === "fr";
const isIt = lang === "it";
const visualHeading = isEs || isDe || isFr || isIt ? (t.visual?.title || (isDe ? "Zeitverschiebung im Überblick" : isEs ? "Explora la diferencia horaria" : isFr ? "Visualiser le décalage horaire" : isIt ? "Visualizza la differenza oraria" : "Visual Time Lab")) : (keywordHeading ? `${keywordHeading} ${t.visual.title}` : t.visual.title);
const visualCardTitles = t.visual.cards.map((card) => (isEs || isDe || isFr || isIt ? card.title : (keywordHeading ? `${keywordHeading} ${card.title}` : card.title)));
---

<section class="visual-lab" aria-labelledby="visual-lab">
  <div>
    <p class="eyebrow">{t.visual.eyebrow}</p>
    <h2 id="visual-lab">{visualHeading}</h2>
  </div>
  <article class="motion-card reveal">
    <div class="orbit-visual" aria-hidden="true">
      <span class="planet"></span>
      <span class="orbit-dot dot-a"></span>
      <span class="orbit-dot dot-b"></span>
    </div>
    <h3>{visualCardTitles[0]}</h3>
    <p>{t.visual.cards[0].text}</p>
  </article>
  <article class="motion-card reveal">
    <div class="wave-visual" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
    <h3>{visualCardTitles[1]}</h3>
    <p>{t.visual.cards[1].text}</p>
  </article>
  <article class="motion-card reveal">
    <div class="blocks-visual" aria-hidden="true">
      {blocks.map((item) => <span style={`--i:${item}`}></span>)}
    </div>
    <h3>{visualCardTitles[2]}</h3>
    <p>{t.visual.cards[2].text}</p>
  </article>
</section>

<style>
  .visual-lab {
    display: grid;
    gap: 12px;
    grid-template-columns: 1.2fr repeat(3, 1fr);
    align-items: stretch;
    padding-top: 20px;
  }

  .visual-lab > div:first-child {
    display: grid;
    align-content: center;
    min-height: 220px;
  }

  .motion-card {
    padding: 16px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
    position: relative;
    overflow: hidden;
    min-height: 220px;
    transition: transform .25s ease, border-color .25s ease, box-shadow .25s ease;
  }

  .motion-card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--accent) 60%, var(--line));
    box-shadow: var(--shadow);
  }

  .motion-card h3 {
    margin: 18px 0 8px;
  }

  .motion-card p {
    margin: 0;
    color: var(--muted);
  }

  .orbit-visual {
    position: relative;
    width: 136px;
    height: 136px;
    border: 1px dashed color-mix(in srgb, var(--accent-2) 55%, var(--line));
    border-radius: 999px;
  }

  .planet {
    position: absolute;
    inset: 30px;
    border-radius: 999px;
    background: linear-gradient(90deg, color-mix(in srgb, var(--accent-2) 28%, var(--panel)) 0 48%, color-mix(in srgb, var(--text) 18%, var(--panel)) 48% 100%);
    border: 1px solid var(--line);
  }

  .orbit-dot {
    position: absolute;
    width: 18px;
    height: 18px;
    border-radius: 999px;
    background: var(--sun);
    box-shadow: 0 0 22px color-mix(in srgb, var(--sun) 60%, transparent);
    animation: orbit 8s linear infinite;
    transform-origin: 68px 68px;
    left: 59px;
    top: -9px;
  }

  .dot-b {
    animation-delay: -4s;
    background: var(--accent);
  }

  @keyframes orbit {
    to {
      transform: rotate(360deg);
    }
  }

  .wave-visual {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    align-items: end;
    gap: 8px;
    width: 150px;
    height: 118px;
  }

  .wave-visual span {
    display: block;
    border-radius: 8px 8px 0 0;
    background: linear-gradient(180deg, var(--accent-2), var(--accent));
    animation: wave 2.2s ease-in-out infinite;
  }

  .wave-visual span:nth-child(1) {
    height: 48%;
  }

  .wave-visual span:nth-child(2) {
    height: 76%;
    animation-delay: .16s;
  }

  .wave-visual span:nth-child(3) {
    height: 58%;
    animation-delay: .32s;
  }

  .wave-visual span:nth-child(4) {
    height: 88%;
    animation-delay: .48s;
  }

  @keyframes wave {
    0%,
    100% {
      transform: scaleY(.78);
      opacity: .72;
    }

    50% {
      transform: scaleY(1);
      opacity: 1;
    }
  }

  .blocks-visual {
    display: grid;
    grid-template-columns: repeat(6, 22px);
    grid-auto-rows: 22px;
    gap: 7px;
    width: max-content;
    padding-top: 8px;
  }

  .blocks-visual span {
    border-radius: 6px;
    background: color-mix(in srgb, var(--accent) 18%, var(--panel));
    border: 1px solid var(--line);
    animation: blockGlow 3.8s ease-in-out infinite;
    animation-delay: calc(var(--i) * .12s);
  }

  .blocks-visual span:nth-child(n+5):nth-child(-n+9) {
    background: color-mix(in srgb, var(--accent) 58%, var(--panel));
    border-color: var(--accent);
  }

  @keyframes blockGlow {
    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(-5px);
    }
  }

  @media (max-width: 860px) {
    .visual-lab {
      grid-template-columns: 1fr;
    }
  }
</style>
