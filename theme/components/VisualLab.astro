---
const { t } = Astro.props;
const blocks = Array.from({ length: 12 }, (_, i) => i);
---

<section class="visual-lab" aria-labelledby="visual-lab">
  <div>
    <p class="eyebrow">{t.visual.eyebrow}</p>
    <h2 id="visual-lab">{t.visual.title}</h2>
  </div>
  <article class="motion-card reveal">
    <div class="orbit-visual" aria-hidden="true">
      <span class="planet"></span>
      <span class="orbit-dot dot-a"></span>
      <span class="orbit-dot dot-b"></span>
    </div>
    <h3>{t.visual.cards[0].title}</h3>
    <p>{t.visual.cards[0].text}</p>
  </article>
  <article class="motion-card reveal">
    <div class="wave-visual" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
    <h3>{t.visual.cards[1].title}</h3>
    <p>{t.visual.cards[1].text}</p>
  </article>
  <article class="motion-card reveal">
    <div class="blocks-visual" aria-hidden="true">
      {blocks.map((item) => <span style={`--i:${item}`}></span>)}
    </div>
    <h3>{t.visual.cards[2].title}</h3>
    <p>{t.visual.cards[2].text}</p>
  </article>
</section>
