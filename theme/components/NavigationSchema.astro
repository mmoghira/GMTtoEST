---
/**
 * NavigationSchema Component
 * Generates structured data for site navigation elements
 * Helps search engines understand site structure and improve navigation display
 */
import { siteUrl, pageUrl, languages } from "theme/i18n/config";

interface Props {
  lang: string;
  t: any;
  homePath?: string;
}

const { lang, t, homePath = "" } = Astro.props;
const homeUrlPath = homePath || pageUrl(lang, "");

const isDe = lang === "de";
const isEs = lang === "es";
const isFr = lang === "fr";
const isIt = lang === "it";
const isPt = lang === "pt";
const isPl = lang === "pl";

const navItems = [
  { 
    url: homeUrlPath, 
    name: t.brand || (isFr ? "Convertisseur GMT vers EST" : isIt ? "Convertitore da GMT a EST" : isPt ? "Conversor de GMT para EST" : isPl ? "Konwerter GMT na EST" : "GMT to EST Converter"), 
    description: t.pages?.home?.description || (isDe ? "GMT in EST oder EDT schnell und einfach umrechnen." : isFr ? "Convertissez l'heure GMT en EST ou EDT instantanément avec détection de la date." : isIt ? "Converti l'ora GMT in EST o EDT all'istante con rilevamento della data." : isPt ? "Converta o horário GMT em EST ou EDT instantaneamente com ajuste do horário de verão." : isPl ? "Przeliczaj czas GMT na EST i EDT w czasie rzeczywistym." : "Convert GMT time to EST instantly"),
    position: 1 
  },
  { 
    url: pageUrl(lang, "about-us"),
    name: t.footer?.about || (isDe ? "Über uns" : isEs ? "Sobre nosotros" : isFr ? "À propos" : isIt ? "Chi siamo" : isPt ? "Sobre nós" : isPl ? "O nas" : "About Us"), 
    description: t.pages?.about?.description || (isDe ? "Erfahren Sie mehr über den GMT zu EST Umrechner und unser Team." : isFr ? "Découvrez l'équipe et la mission derrière le convertisseur GMT vers EST." : isIt ? "Scopri il team editoriale e la missione del Convertitore da GMT a EST." : isPt ? "Conheça a equipe editorial e o funcionamento do Conversor de GMT para EST." : isPl ? "Poznaj zespół stojący za serwisem Konwerter GMT na EST." : "Learn about the team behind GMT to EST Converter"),
    position: 2 
  },
  { 
    url: pageUrl(lang, "contact-us"),
    name: t.footer?.contact || (isDe ? "Kontakt" : isEs ? "Contacto" : isFr ? "Contact" : isIt ? "Contattaci" : isPt ? "Fale conosco" : isPl ? "Kontakt" : "Contact Us"), 
    description: t.pages?.contact?.description || (isDe ? "Kontaktieren Sie das Team von GMT to EST Converter." : isFr ? "Contactez l'équipe du convertisseur GMT vers EST pour vos questions et retours." : isIt ? "Contatta il team del convertitore per domande e segnalazioni." : isPt ? "Entre em contato com a equipe editorial para dúvidas, sugestões e correções." : isPl ? "Skontaktuj się z zespołem serwisu Konwerter GMT na EST." : "Get in touch with the GMT to EST Converter team"),
    position: 3 
  },
  { 
    url: pageUrl(lang, "privacy-policy"),
    name: t.footer?.privacy || (isDe ? "Datenschutz" : isEs ? "Política de privacidad" : isFr ? "Politique de confidentialité" : isIt ? "Informativa sulla privacy" : isPt ? "Política de privacidade" : isPl ? "Polityka prywatności" : "Privacy Policy"), 
    description: t.pages?.privacy?.description || (isDe ? "Unsere Datenschutzerklärung." : isFr ? "Consultez notre politique de confidentialité et de gestion des données." : isIt ? "Consulta la nostra informativa sulla privacy e protezione dei dati." : isPt ? "Consulte nossa política de privacidade, cookies e tratamento de dados." : isPl ? "Zasady ochrony prywatności i przetwarzania danych osobowych." : "Read our privacy policy"),
    position: 4 
  },
  { 
    url: pageUrl(lang, "terms-of-service"),
    name: t.footer?.terms || (isDe ? "Nutzungsbedingungen" : isEs ? "Términos del servicio" : isFr ? "Conditions d'utilisation" : isIt ? "Termini di servizio" : isPt ? "Termos de serviço" : isPl ? "Regulamin serwisu" : "Terms of Service"), 
    description: t.pages?.terms?.description || (isDe ? "Nutzungsbedingungen für unseren Zeitzonenumrechner." : isFr ? "Consultez les conditions d'utilisation de notre convertisseur de fuseaux horaires." : isIt ? "Consulta i termini di servizio del nostro convertitore di fusi orari." : isPt ? "Consulte os termos e condições de uso do Conversor de GMT para EST." : isPl ? "Regulamin i warunki korzystania z serwisu Konwerter GMT na EST." : "Read our terms of service"),
    position: 5 
  },
  { 
    url: pageUrl(lang, "time-zone-guide"), 
    name: t.nav?.guide || (isDe ? "Ratgeber" : isEs ? "Guía" : isFr ? "Guide des fuseaux horaires" : isIt ? "Guida ai fusi orari" : isPt ? "Guia de fusos horários" : isPl ? "Przewodnik po strefach" : "Guide"), 
    description: t.pages?.guide?.description || (isDe ? "Praktischer Leitfaden zu Zeitzonen und Sommerzeit." : isFr ? "Guide complet des fuseaux horaires mondiaux et des transitions d'heure d'été." : isIt ? "Guida completa ai fusi orari mondiali e ai passaggi all'ora legale." : isPt ? "Guia completo sobre fusos horários, GMT, UTC, EST, EDT e horário de verão." : isPl ? "Kompleksowy przewodnik po światowych strefach czasu." : "Complete guide to timezones and conversions"),
    position: 6 
  },
  ...(isDe ? [{
    url: "/de/blog/",
    name: t.nav?.blog || "Blog",
    description: "Aktuelle Zeitzonen-Artikel und Ratgeber rund um GMT und EST",
    position: 7
  }] : (!isFr && !isIt && !isPt && !isPl ? [{
    url: "/blog/",
    name: t.nav?.blog || "Blog",
    description: "Browse our timezone blog posts and updates",
    position: 7
  }] : []))
];

const navigationSchema = {
  "@context": "https://schema.org",
  "@type": "SiteNavigationElement",
  "@id": `${siteUrl}${homeUrlPath}#navigation`,
  name: isFr ? "Navigation principale" : isIt ? "Navigazione principale" : isPt ? "Navegação principal" : isDe ? "Hauptnavigation" : isEs ? "Navegación principal" : isPl ? "Menu główne" : "Primary Navigation",
  url: `${siteUrl}${homeUrlPath}`,
  inLanguage: lang,
  speakable: {
    "@type": "SpeakableSpecification",
    xpath: ["/html/head/title", "/html/head/meta[@name='description']/@content"]
  },
  hasPart: navItems.map((item) => ({
    "@type": "SiteNavigationElement",
    name: item.name,
    description: item.description,
    url: `${siteUrl}${item.url}`,
    position: item.position
  }))
};
---

<script type="application/ld+json" set:html={JSON.stringify(navigationSchema)} />
