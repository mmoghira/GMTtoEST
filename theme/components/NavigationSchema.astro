---
/**
 * NavigationSchema Component
 * Generates structured data for site navigation elements
 * Helps search engines understand site structure and improve navigation display
 */
import { siteUrl, pageUrl, languages } from "theme/i18n/config";

interface Props {
  lang: string;
  t: any;
  homePath?: string;
}

const { lang, t, homePath = "" } = Astro.props;
const homeUrlPath = homePath || pageUrl(lang, "");

const isDe = lang === "de";
const isEs = lang === "es";
const isFr = lang === "fr";

const navItems = [
  { 
    url: homeUrlPath, 
    name: t.brand || (isFr ? "Convertisseur GMT vers EST" : "GMT to EST Converter"), 
    description: t.pages?.home?.description || (isDe ? "GMT in EST oder EDT schnell und einfach umrechnen." : isFr ? "Convertissez l'heure GMT en EST ou EDT instantanément avec détection de la date." : "Convert GMT time to EST instantly"),
    position: 1 
  },
  { 
    url: pageUrl(lang, "about-us"),
    name: t.footer?.about || (isDe ? "Über uns" : isEs ? "Sobre nosotros" : isFr ? "À propos" : "About Us"), 
    description: t.pages?.about?.description || (isDe ? "Erfahren Sie mehr über den GMT zu EST Umrechner und unser Team." : isFr ? "Découvrez l'équipe et la mission derrière le convertisseur GMT vers EST." : "Learn about the team behind GMT to EST Converter"),
    position: 2 
  },
  { 
    url: pageUrl(lang, "contact-us"),
    name: t.footer?.contact || (isDe ? "Kontakt" : isEs ? "Contacto" : isFr ? "Contact" : "Contact Us"), 
    description: t.pages?.contact?.description || (isDe ? "Kontaktieren Sie das Team von GMT to EST Converter." : isFr ? "Contactez l'équipe du convertisseur GMT vers EST pour vos questions et retours." : "Get in touch with the GMT to EST Converter team"),
    position: 3 
  },
  { 
    url: pageUrl(lang, "privacy-policy"),
    name: t.footer?.privacy || (isDe ? "Datenschutz" : isEs ? "Política de privacidad" : isFr ? "Politique de confidentialité" : "Privacy Policy"), 
    description: t.pages?.privacy?.description || (isDe ? "Unsere Datenschutzerklärung." : isFr ? "Consultez notre politique de confidentialité et de gestion des données." : "Read our privacy policy"),
    position: 4 
  },
  { 
    url: pageUrl(lang, "terms-of-service"),
    name: t.footer?.terms || (isDe ? "Nutzungsbedingungen" : isEs ? "Términos del servicio" : isFr ? "Conditions d'utilisation" : "Terms of Service"), 
    description: t.pages?.terms?.description || (isDe ? "Nutzungsbedingungen für unseren Zeitzonenumrechner." : isFr ? "Consultez les conditions d'utilisation de notre convertisseur de fuseaux horaires." : "Read our terms of service"),
    position: 5 
  },
  { 
    url: pageUrl(lang, "time-zone-guide"), 
    name: t.nav?.guide || (isDe ? "Ratgeber" : isEs ? "Guía" : isFr ? "Guide des fuseaux horaires" : "Guide"), 
    description: t.pages?.guide?.description || (isDe ? "Praktischer Leitfaden zu Zeitzonen und Sommerzeit." : isFr ? "Guide complet des fuseaux horaires mondiaux et des transitions d'heure d'été." : "Complete guide to timezones and conversions"),
    position: 6 
  },
  ...(isDe ? [{
    url: "/de/blog/",
    name: t.nav?.blog || "Blog",
    description: "Aktuelle Zeitzonen-Artikel und Ratgeber rund um GMT und EST",
    position: 7
  }] : (!isFr ? [{
    url: "/blog/",
    name: t.nav?.blog || "Blog",
    description: "Browse our timezone blog posts and updates",
    position: 7
  }] : []))
];

const navigationSchema = {
  "@context": "https://schema.org",
  "@type": "SiteNavigationElement",
  "@id": `${siteUrl}${homeUrlPath}#navigation`,
  name: isFr ? "Navigation principale" : isDe ? "Hauptnavigation" : isEs ? "Navegación principal" : "Primary Navigation",
  url: `${siteUrl}${homeUrlPath}`,
  inLanguage: lang,
  speakable: {
    "@type": "SpeakableSpecification",
    xpath: ["/html/head/title", "/html/head/meta[@name='description']/@content"]
  },
  hasPart: navItems.map((item) => ({
    "@type": "SiteNavigationElement",
    name: item.name,
    description: item.description,
    url: `${siteUrl}${item.url}`,
    position: item.position
  }))
};
---

<script type="application/ld+json" set:html={JSON.stringify(navigationSchema)} />
