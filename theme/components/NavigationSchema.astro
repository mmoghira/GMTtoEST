---
/**
 * NavigationSchema Component
 * Generates structured data for site navigation elements
 * Helps search engines understand site structure and improve navigation display
 */
import { siteUrl, pageUrl, languages } from "theme/i18n/config";

interface Props {
  lang: string;
  t: any;
  homePath?: string;
}

const { lang, t, homePath = "" } = Astro.props;
const homeUrlPath = homePath || pageUrl(lang, "");

const navItems = [
  { 
    url: homeUrlPath, 
    name: t.brand || "GMT to EST Converter", 
    description: t.pages?.home?.description || "Convert GMT time to EST instantly",
    position: 1 
  },
  { 
    url: "/about-us/",
    name: t.footer.about || "About Us", 
    description: t.pages?.about?.description || "Learn about the team behind GMT to EST Converter",
    position: 2 
  },
  { 
    url: "/contact-us/",
    name: t.footer.contact || "Contact Us", 
    description: t.pages?.contact?.description || "Get in touch with the GMT to EST Converter team",
    position: 3 
  },
  { 
    url: "/privacy-policy/",
    name: t.footer.privacy || "Privacy Policy", 
    description: t.pages?.privacy?.description || "Read our privacy policy",
    position: 4 
  },
  { 
    url: "/terms-of-service/",
    name: t.footer.terms || "Terms of Service", 
    description: t.pages?.terms?.description || "Read our terms of service",
    position: 5 
  },
  { 
    url: pageUrl(lang, "time-zone-guide"), 
    name: t.nav.guide || "Guide", 
    description: t.pages?.guide?.description || "Complete guide to timezones and conversions",
    position: 6 
  },
  {
    url: "/blog/",
    name: t.nav.blog || "Blog",
    description: "Browse our timezone blog posts and updates",
    position: 7
  }
];

const navigationSchema = {
  "@context": "https://schema.org",
  "@type": "SiteNavigationElement",
  "@id": `${siteUrl}${homeUrlPath}#navigation`,
  name: "Primary Navigation",
  url: `${siteUrl}${homeUrlPath}`,
  inLanguage: lang,
  speakable: {
    "@type": "SpeakableSpecification",
    xpath: ["/html/head/title", "/html/head/meta[@name='description']/@content"]
  },
  hasPart: navItems.map((item) => ({
    "@type": "SiteNavigationElement",
    name: item.name,
    description: item.description,
    url: `${siteUrl}${item.url}`,
    position: item.position
  }))
};
---

<script type="application/ld+json" set:html={JSON.stringify(navigationSchema)} />
