---
/**
 * NavigationSchema Component
 * Generates structured data for site navigation elements
 * Helps search engines understand site structure and improve navigation display
 */
import { siteUrl, pageUrl, languages } from "theme/i18n/config";

interface Props {
  lang: string;
  t: any;
  homePath?: string;
}

const { lang, t, homePath = "" } = Astro.props;
const homeUrlPath = homePath || pageUrl(lang, "");

const navItems = [
  { 
    url: homeUrlPath, 
    name: t.pages?.home || "Home", 
    description: t.pages?.homeDesc || "Free timezone converter",
    position: 1 
  },
  { 
    url: pageUrl(lang, "gmt-to-est"), 
    name: t.pages?.gmtToEst || "GMT to EST", 
    description: t.pages?.gmtToEstDesc || "Convert GMT time to EST instantly",
    position: 2 
  },
  { 
    url: pageUrl(lang, "est-to-gmt"), 
    name: t.pages?.estToGmt || "EST to GMT", 
    description: t.pages?.estToGmtDesc || "Convert EST time to GMT instantly",
    position: 3 
  },
  { 
    url: pageUrl(lang, "gmt-vs-est"), 
    name: t.pages?.gmtVsEst || "GMT vs EST", 
    description: t.pages?.gmtVsEstDesc || "Understand the difference between GMT and EST",
    position: 4 
  },
  { 
    url: pageUrl(lang, "time-zone-guide"), 
    name: t.pages?.guide || "Time Zone Guide", 
    description: t.pages?.guideDesc || "Complete guide to timezones and conversions",
    position: 5 
  },
  {
    url: pageUrl(lang, "author"),
    name: t.pages?.author?.title || "Author",
    description: "Author and editorial information for timezone content",
    position: 6
  },
  {
    url: pageUrl(lang, "contact-us"), 
    name: t.pages?.contact?.title || "Contact Us", 
    description: t.pages?.contact?.description || "Get in touch with the GMT to EST Converter team",
    position: 7 
  }
];

const navigationSchema = {
  "@context": "https://schema.org",
  "@type": "SiteNavigationElement",
  "@id": `${siteUrl}${homeUrlPath}#navigation`,
  name: "Primary Navigation",
  url: `${siteUrl}${homeUrlPath}`,
  inLanguage: lang,
  speakable: {
    "@type": "SpeakableSpecification",
    xpath: ["/html/head/title", "/html/head/meta[@name='description']/@content"]
  },
  hasPart: navItems.map((item) => ({
    "@type": "SiteNavigationElement",
    name: item.name,
    description: item.description,
    url: `${siteUrl}${item.url}`,
    position: item.position
  }))
};
---

<script type="application/ld+json" set:html={JSON.stringify(navigationSchema)} />
