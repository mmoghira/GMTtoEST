---
/**
 * NavigationSchema Component
 * Generates structured data for site navigation elements
 * Helps search engines understand site structure and improve navigation display
 */
import { siteUrl, pageUrl, languages } from "theme/i18n/config";

interface Props {
  lang: string;
  t: any;
  homePath?: string;
}

const { lang, t, homePath = "" } = Astro.props;
const homeUrlPath = homePath || pageUrl(lang, "");

const isDe = lang === "de";
const isEs = lang === "es";

const navItems = [
  { 
    url: homeUrlPath, 
    name: t.brand || "GMT to EST Converter", 
    description: t.pages?.home?.description || (isDe ? "GMT in EST oder EDT schnell und einfach umrechnen." : "Convert GMT time to EST instantly"),
    position: 1 
  },
  { 
    url: "/about-us/",
    name: t.footer.about || (isDe ? "Über uns" : "About Us"), 
    description: t.pages?.about?.description || (isDe ? "Erfahre mehr über den GMT zu EST Umrechner und unser Team." : "Learn about the team behind GMT to EST Converter"),
    position: 2 
  },
  { 
    url: "/contact-us/",
    name: t.footer.contact || (isDe ? "Kontakt" : "Contact Us"), 
    description: t.pages?.contact?.description || (isDe ? "Kontaktiere das Team von GMT to EST Converter." : "Get in touch with the GMT to EST Converter team"),
    position: 3 
  },
  { 
    url: "/privacy-policy/",
    name: t.footer.privacy || (isDe ? "Datenschutz" : "Privacy Policy"), 
    description: t.pages?.privacy?.description || (isDe ? "Unsere Datenschutzerklärung." : "Read our privacy policy"),
    position: 4 
  },
  { 
    url: "/terms-of-service/",
    name: t.footer.terms || (isDe ? "Nutzungsbedingungen" : "Terms of Service"), 
    description: t.pages?.terms?.description || (isDe ? "Nutzungsbedingungen für unseren Zeitzonenumrechner." : "Read our terms of service"),
    position: 5 
  },
  { 
    url: pageUrl(lang, "time-zone-guide"), 
    name: t.nav.guide || (isDe ? "Ratgeber" : "Guide"), 
    description: t.pages?.guide?.description || (isDe ? "Praktischer Leitfaden zu Zeitzonen und Sommerzeit." : "Complete guide to timezones and conversions"),
    position: 6 
  },
  {
    url: isDe ? "/de/blog/" : "/blog/",
    name: t.nav.blog || "Blog",
    description: isDe ? "Aktuelle Zeitzonen-Artikel und Ratgeber rund um GMT und EST" : "Browse our timezone blog posts and updates",
    position: 7
  }
];

const navigationSchema = {
  "@context": "https://schema.org",
  "@type": "SiteNavigationElement",
  "@id": `${siteUrl}${homeUrlPath}#navigation`,
  name: "Primary Navigation",
  url: `${siteUrl}${homeUrlPath}`,
  inLanguage: lang,
  speakable: {
    "@type": "SpeakableSpecification",
    xpath: ["/html/head/title", "/html/head/meta[@name='description']/@content"]
  },
  hasPart: navItems.map((item) => ({
    "@type": "SiteNavigationElement",
    name: item.name,
    description: item.description,
    url: `${siteUrl}${item.url}`,
    position: item.position
  }))
};
---

<script type="application/ld+json" set:html={JSON.stringify(navigationSchema)} />
