---
const { lang, t, slug = "" } = Astro.props;
import { pageUrl, languages } from "theme/i18n/config";

const isEs = lang === "es";
const isDe = lang === "de";
const navItems = [
  { href: "/world-clock/", label: t.nav?.worldClock || (isDe ? "Weltuhr" : isEs ? "Reloj mundial" : "World Clock"), position: 2, key: "world-clock" },
  { href: "/meeting-planner/", label: t.nav?.meetingPlanner || (isDe ? "Meeting-Planer" : isEs ? "Planificador de reuniones" : "Meeting Planner"), position: 3, key: "meeting-planner" },
  { href: "/time-zone-map/", label: t.nav?.map || (isDe ? "Karte" : isEs ? "Mapa" : "Map"), position: 4, key: "time-zone-map" },
  { href: "/developer-tools/", label: t.nav?.developerTools || (isDe ? "Entwickler-Tools" : isEs ? "Herramientas para desarrolladores" : "Dev Tools"), position: 5, key: "developer-tools" },
  { href: pageUrl(lang, "time-zone-guide"), label: t.nav?.guide || (isDe ? "Ratgeber" : isEs ? "Guía" : "Guide"), position: 6, key: "time-zone-guide" },
  { href: isDe ? "/de/blog/" : "/blog/", label: t.nav?.blog || "Blog", position: 7, key: "blog" },
];

const isCurrentItem = (key: string) => key === "" ? slug === "" : slug === key || slug.startsWith(`${key}/`);
const navAriaLabel = isDe ? "Hauptnavigation" : isEs ? "Navegación principal" : "Primary";
const searchAriaLabel = t.nav?.searchAriaLabel || (isDe ? "Website durchsuchen (Strg+K)" : isEs ? "Buscar en el sitio (Ctrl+K)" : "Search site (Ctrl+K)");
const searchBtnText = t.nav?.search || (isDe ? "Suchen..." : isEs ? "Buscar..." : "Search...");
---

<header class="header" role="banner">
  <div class="header-container">
    <!-- Logo Section -->
    <div class="logo-section">
      <a href={pageUrl(lang, "")} class="logo-link" aria-label={t.brand} data-position="1">
        <img src="/logo.svg" alt="GMT to EST logo" class="logo-icon" width="40" height="40" fetchpriority="high" decoding="async" />
        <span class="site-name">{isDe ? "GMT zu EST Umrechner" : isEs ? "Convertidor GMT a EST" : "GMT to EST Converter"}</span>
      </a>
    </div>

    <!-- Navigation Section -->
    <nav class="nav-section" aria-label={navAriaLabel} role="navigation">
      <ul class="nav-list" itemscope itemtype="https://schema.org/SiteNavigationElement">
        {navItems.map((item) => (
          <li class="nav-item" data-position={item.position}>
            <a 
              href={item.href} 
              class:list={["nav-link", isCurrentItem(item.key) && "nav-active"]}
              aria-current={isCurrentItem(item.key) ? "page" : undefined}
              itemprop="url"
              data-nav-item={item.position}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Global Search Trigger Button -->
    <button type="button" class="trigger-global-search search-header-btn" aria-label={searchAriaLabel}>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <span class="search-btn-text">{searchBtnText}</span>
      <kbd>{isDe ? "Strg+K" : "⌘K"}</kbd>
    </button>
  </div>

  <!-- Hidden controls -->
  <button id="theme" type="button" aria-label={t.nav.theme} style="display:none"></button>
</header>

<style define:vars={{ "--accent": "#0ea5e9", "--text-light": "#e5e7eb", "--bg-dark": "#0f172a" }}>
  .header {
    background: linear-gradient(135deg, var(--bg-dark) 0%, #1e293b 100%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    position: sticky;
    top: 0;
    z-index: 1000;
    backdrop-filter: blur(12px);
  }

  .header-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0.85rem 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  .search-header-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--text-light);
    padding: 0.4rem 0.8rem;
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.85rem;
    transition: all 0.2s ease;
  }
  .search-header-btn:hover {
    background: rgba(14, 165, 233, 0.15);
    border-color: var(--accent);
    color: var(--accent);
  }
  .search-header-btn kbd {
    background: rgba(0, 0, 0, 0.3);
    padding: 0.15rem 0.35rem;
    border-radius: 4px;
    font-size: 0.7rem;
  }



  /* Logo Section */
  .logo-section {
    flex-shrink: 0;
  }

  .logo-link {
    display: flex;
    align-items: center;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .logo-link:hover {
    opacity: 0.85;
  }

  .logo-icon {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    object-fit: contain;
    display: inline-block;
    vertical-align: middle;
  }

  .site-name {
    color: var(--text-light);
    font-weight: 700;
    margin-left: 10px;
    font-size: 1.05rem;
    display: inline-block;
    vertical-align: middle;
    letter-spacing: -0.01em;
  }

  /* Navigation */
  .nav-section {
    display: flex;
    justify-content: flex-end;
  }

  .nav-list {
    list-style: none;
    display: flex;
    gap: 2rem;
    margin: 0;
    padding: 0;
    align-items: center;
  }

  .nav-item {
    position: relative;
  }

  .nav-link {
    color: rgba(229, 231, 235, 0.8);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    transition: color 0.3s ease;
    position: relative;
    letter-spacing: 0.01em;
  }

  .nav-link:hover {
    color: #ffffff;
  }

  .nav-link.nav-active {
    color: #ffffff;
    font-weight: 700;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    bottom: -6px;
    left: 0;
    width: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--accent), transparent);
    transition: width 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .nav-link:hover::after {
    width: 100%;
  }

  .nav-link.nav-active::after {
    width: 100%;
    background: var(--accent);
  }

  /* Search Overlay */
  .search-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(8px);
    z-index: 2000;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 6rem;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, visibility 0.25s ease;
  }

  .search-overlay.show {
    opacity: 1;
    visibility: visible;
  }

  .search-overlay-inner {
    width: 100%;
    max-width: 680px;
    padding: 0 1.5rem;
    transform: translateY(-16px);
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .search-overlay.show .search-overlay-inner {
    transform: translateY(0);
  }

  .search-box {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    border: 1px solid rgba(14, 165, 233, 0.4);
    border-radius: 14px;
    padding: 0.85rem 1rem;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(14, 165, 233, 0.1);
  }

  .search-icon-inline {
    color: #9ca3af;
    flex-shrink: 0;
  }

  .search-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: var(--text-light);
    font-size: 1.05rem;
    font-family: inherit;
    caret-color: var(--accent);
  }

  .search-input::placeholder {
    color: #4b5563;
  }

  .search-input::-webkit-search-cancel-button {
    display: none;
  }

  .search-close {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #9ca3af;
    border-radius: 8px;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    transition: all 0.2s ease;
  }

  .search-close:hover {
    background: rgba(255, 255, 255, 0.12);
    color: var(--text-light);
  }

  .search-results {
    margin-top: 0.75rem;
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 1rem 1.25rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
  }

  .search-hint {
    color: #4b5563;
    font-size: 0.9rem;
    margin: 0;
    text-align: center;
    padding: 0.5rem 0;
  }

  .search-result-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 0.5rem;
    border-radius: 8px;
    text-decoration: none;
    color: #bfdbfe;
    font-size: 0.95rem;
    transition: all 0.15s ease;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .search-result-item:last-child {
    border-bottom: none;
  }

  .search-result-item:hover {
    background: rgba(14, 165, 233, 0.08);
    color: #e5e7eb;
    padding-left: 0.85rem;
  }

  .search-result-icon {
    color: var(--accent);
    flex-shrink: 0;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .nav-list {
      gap: 1.5rem;
    }

    .nav-link {
      font-size: 0.85rem;
    }
  }

  @media (max-width: 768px) {
    .header {
      position: relative;
    }

    .header-container {
      flex-wrap: wrap;
      gap: 1rem;
      padding: 0.75rem 1.25rem;
    }

    .logo-section {
      order: 1;
    }

    .nav-section {
      order: 2;
      width: 100%;
      justify-content: flex-start;
    }

    .nav-list {
      gap: 1rem;
      flex-wrap: wrap;
    }

    .nav-link {
      font-size: 0.82rem;
    }
  }

  @media (max-width: 480px) {
    .header-container {
      padding: 0.75rem 1rem;
      gap: 0.75rem;
    }

    .logo-icon {
      width: 30px;
      height: 30px;
    }

    .site-name {
      font-size: 0.9rem;
    }

    .nav-list {
      gap: 0.6rem;
    }

    .search-overlay {
      padding-top: 4rem;
  }
</style>
