---
const { lang, t, slug = "" } = Astro.props;
import { pageUrl, languages } from "theme/i18n/config";

const navItems = [
  { href: pageUrl(lang, ""), label: t.nav.gmtToEst, position: 2 },
  { href: pageUrl(lang, "est-to-gmt"), label: t.nav.estToGmt, position: 3 },
  { href: pageUrl(lang, "gmt-vs-est"), label: t.nav.gmtVsEst, position: 4 },
  { href: pageUrl(lang, "time-zone-guide"), label: t.nav.guide, position: 5 },
  { href: pageUrl(lang, "blog"), label: t.nav.blog || "Blog", position: 6 },
  { href: pageUrl(lang, "author"), label: t.nav.author || "Author", position: 7 },
];
---

<header class="header" role="banner">
  <div class="header-container">
    <!-- Logo Section -->
    <div class="logo-section">
      <a href={pageUrl(lang, "")} class="logo-link" aria-label={t.brand} data-position="1">
        <img src="/logo.svg" alt="GMT to EST logo" class="logo-icon" width="40" height="40" fetchpriority="high" decoding="async" />
        <span class="site-name">GMT to EST Converter</span>
      </a>
    </div>

    <!-- Navigation Section -->
    <nav class="nav-section" aria-label="Primary" role="navigation">
      <ul class="nav-list" itemscope itemtype="https://schema.org/SiteNavigationElement">
        {navItems.map((item) => (
          <li class="nav-item" data-position={item.position}>
            <a 
              href={item.href} 
              class="nav-link"
              itemprop="url"
              data-nav-item={item.position}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <!-- Hidden controls -->
  <button id="search-toggle" type="button" aria-label="Search" aria-expanded="false" style="display:none"></button>
  <button id="theme" type="button" aria-label={t.nav.theme} style="display:none"></button>

  <!-- Search Overlay -->
  <div id="search-overlay" class="search-overlay" role="dialog" aria-modal="true" aria-label="Search">
    <div class="search-overlay-inner">
      <div class="search-box">
        <svg class="search-icon-inline" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <input
          id="search-input"
          type="search"
          class="search-input"
          placeholder="Search pages, guides, converters…"
          autocomplete="off"
          spellcheck="false"
        />
        <button id="search-close" class="search-close" type="button" aria-label="Close search">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
      <div id="search-results" class="search-results">
        <p class="search-hint">Type to search the site…</p>
      </div>
    </div>
  </div>
</header>

<style define:vars={{ "--accent": "#0ea5e9", "--text-light": "#e5e7eb", "--bg-dark": "#0f172a" }}>
  .header {
    background: linear-gradient(135deg, var(--bg-dark) 0%, #1e293b 100%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    position: sticky;
    top: 0;
    z-index: 1000;
    backdrop-filter: blur(12px);
  }

  .header-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0.85rem 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }



  /* Logo Section */
  .logo-section {
    flex-shrink: 0;
  }

  .logo-link {
    display: flex;
    align-items: center;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .logo-link:hover {
    opacity: 0.85;
  }

  .logo-icon {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    object-fit: contain;
    display: inline-block;
    vertical-align: middle;
  }

  .site-name {
    color: var(--text-light);
    font-weight: 700;
    margin-left: 10px;
    font-size: 1.05rem;
    display: inline-block;
    vertical-align: middle;
    letter-spacing: -0.01em;
  }

  /* Navigation */
  .nav-section {
    display: flex;
    justify-content: flex-end;
  }

  .nav-list {
    list-style: none;
    display: flex;
    gap: 2rem;
    margin: 0;
    padding: 0;
    align-items: center;
  }

  .nav-item {
    position: relative;
  }

  .nav-link {
    color: rgba(229, 231, 235, 0.8);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    transition: color 0.3s ease;
    position: relative;
    letter-spacing: 0.01em;
  }

  .nav-link:hover {
    color: #ffffff;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    bottom: -6px;
    left: 0;
    width: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--accent), transparent);
    transition: width 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .nav-link:hover::after {
    width: 100%;
  }

  /* Search Overlay */
  .search-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(8px);
    z-index: 2000;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 6rem;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, visibility 0.25s ease;
  }

  .search-overlay.show {
    opacity: 1;
    visibility: visible;
  }

  .search-overlay-inner {
    width: 100%;
    max-width: 680px;
    padding: 0 1.5rem;
    transform: translateY(-16px);
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .search-overlay.show .search-overlay-inner {
    transform: translateY(0);
  }

  .search-box {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    border: 1px solid rgba(14, 165, 233, 0.4);
    border-radius: 14px;
    padding: 0.85rem 1rem;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(14, 165, 233, 0.1);
  }

  .search-icon-inline {
    color: #9ca3af;
    flex-shrink: 0;
  }

  .search-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: var(--text-light);
    font-size: 1.05rem;
    font-family: inherit;
    caret-color: var(--accent);
  }

  .search-input::placeholder {
    color: #4b5563;
  }

  .search-input::-webkit-search-cancel-button {
    display: none;
  }

  .search-close {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #9ca3af;
    border-radius: 8px;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    transition: all 0.2s ease;
  }

  .search-close:hover {
    background: rgba(255, 255, 255, 0.12);
    color: var(--text-light);
  }

  .search-results {
    margin-top: 0.75rem;
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 1rem 1.25rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
  }

  .search-hint {
    color: #4b5563;
    font-size: 0.9rem;
    margin: 0;
    text-align: center;
    padding: 0.5rem 0;
  }

  .search-result-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 0.5rem;
    border-radius: 8px;
    text-decoration: none;
    color: #bfdbfe;
    font-size: 0.95rem;
    transition: all 0.15s ease;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .search-result-item:last-child {
    border-bottom: none;
  }

  .search-result-item:hover {
    background: rgba(14, 165, 233, 0.08);
    color: #e5e7eb;
    padding-left: 0.85rem;
  }

  .search-result-icon {
    color: var(--accent);
    flex-shrink: 0;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .nav-list {
      gap: 1.5rem;
    }

    .nav-link {
      font-size: 0.85rem;
    }
  }

  @media (max-width: 768px) {
    .header {
      position: relative;
    }

    .header-container {
      flex-wrap: wrap;
      gap: 1rem;
      padding: 0.75rem 1.25rem;
    }

    .logo-section {
      order: 1;
    }

    .nav-section {
      order: 2;
      width: 100%;
      justify-content: flex-start;
    }

    .nav-list {
      gap: 1rem;
      flex-wrap: wrap;
    }

    .nav-link {
      font-size: 0.82rem;
    }
  }

  @media (max-width: 480px) {
    .header-container {
      padding: 0.75rem 1rem;
      gap: 0.75rem;
    }

    .logo-icon {
      width: 30px;
      height: 30px;
    }

    .site-name {
      font-size: 0.9rem;
    }

    .nav-list {
      gap: 0.6rem;
    }

    .search-overlay {
      padding-top: 4rem;
    }
  }
</style>

<script>
  (function setupSearch() {
    // ── Site pages index ──────────────────────────────────────────────────────
    const PAGES = [
      { title: 'Home – GMT to EST Converter', url: '/', desc: 'Free real-time GMT to EST / EST to GMT converter' },
      { title: 'GMT to EST Conversion', url: '/', desc: 'Convert Greenwich Mean Time to Eastern Standard Time' },
      { title: 'EST to GMT Conversion', url: '/est-to-gmt/', desc: 'Convert Eastern Standard Time to Greenwich Mean Time' },
      { title: 'GMT vs EST – Difference', url: '/gmt-vs-est/', desc: 'Understand the difference between GMT and EST time zones' },
      { title: 'Time Zone Guide', url: '/time-zone-guide/', desc: 'Complete guide to world time zones' },
      { title: 'About Us', url: '/about-us/', desc: 'Learn about GMT to EST Converter' },
      { title: 'Author', url: '/author/', desc: 'Meet the author and editorial team behind GMT to EST content' },
      { title: 'Contact', url: '/contact-us/', desc: 'Get in touch with us' },
      { title: 'Privacy Policy', url: '/privacy-policy/', desc: 'Our privacy policy and data usage' },
      { title: 'Terms of Service', url: '/terms-of-service/', desc: 'Terms and conditions of use' },
      { title: 'Sitemap', url: '/sitemap/', desc: 'All pages on this website' },
    ];

    const overlay    = document.getElementById('search-overlay');
    const toggleBtn  = document.getElementById('search-toggle');
    const closeBtn   = document.getElementById('search-close');
    const input      = document.getElementById('search-input');
    const resultsBox = document.getElementById('search-results');

    if (!overlay || !toggleBtn || !closeBtn || !input || !resultsBox) return;

    function openSearch() {
      overlay.classList.add('show');
      toggleBtn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      setTimeout(() => input.focus(), 50);
      renderResults('');
    }

    function closeSearch() {
      overlay.classList.remove('show');
      toggleBtn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      input.value = '';
    }

    function renderResults(query) {
      const q = query.trim().toLowerCase();
      if (!q) {
        resultsBox.innerHTML = '<p class="search-hint">Type to search the site…</p>';
        return;
      }
      const matches = PAGES.filter(p =>
        p.title.toLowerCase().includes(q) ||
        p.desc.toLowerCase().includes(q) ||
        p.url.toLowerCase().includes(q)
      );
      if (!matches.length) {
        resultsBox.innerHTML = '<p class="search-hint">No results found.</p>';
        return;
      }
      resultsBox.innerHTML = matches.map(p => `
        <a href="${p.url}" class="search-result-item">
          <svg class="search-result-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
          <div>
            <div style="font-weight:600;color:#e5e7eb;font-size:.9rem">${p.title}</div>
            <div style="font-size:.8rem;color:#6b7280;margin-top:2px">${p.desc}</div>
          </div>
        </a>
      `).join('');
    }

    toggleBtn.addEventListener('click', openSearch);
    closeBtn.addEventListener('click', closeSearch);

    // Close on backdrop click
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) closeSearch();
    });

    // Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && overlay.classList.contains('show')) closeSearch();
    });

    // Live filter
    input.addEventListener('input', () => renderResults(input.value));
  })();
</script>
