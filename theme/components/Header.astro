---
const { lang, t, slug = "" } = Astro.props;
import { pageUrl, languages } from "theme/i18n/config";

const navItems = [
  { href: pageUrl(lang, "gmt-to-est"), label: t.nav.gmtToEst, position: 2 },
  { href: pageUrl(lang, "est-to-gmt"), label: t.nav.estToGmt, position: 3 },
  { href: pageUrl(lang, "gmt-vs-est"), label: t.nav.gmtVsEst, position: 4 },
  { href: pageUrl(lang, "time-zone-guide"), label: t.nav.guide, position: 5 },
];
---

<header class="header" role="banner">
  <div class="header-container">
    <!-- Logo Section -->
    <div class="logo-section">
      <a href={pageUrl(lang, "")} class="logo-link" aria-label={t.brand} data-position="1">
        <img src="/assets/logo.png" alt="GMT to EST logo" class="logo-icon" />
        <span class="site-name">GMT to EST Converter</span>
      </a>
    </div>

    <!-- Navigation Section -->
    <nav class="nav-section" aria-label="Primary" role="navigation">
      <ul class="nav-list" itemscope itemtype="https://schema.org/SiteNavigationElement">
        {navItems.map((item) => (
          <li class="nav-item" data-position={item.position}>
            <a 
              href={item.href} 
              class="nav-link"
              itemprop="url"
              data-nav-item={item.position}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Right Section (Theme Toggle & Language) -->
    <div class="header-right">
      <div class="lang-switcher">
        <button id="lang-toggle" class="lang-toggle" type="button" aria-label="Language" aria-expanded="false">
          {lang.toUpperCase()}
        </button>
        <div class="lang-dropdown" id="lang-dropdown">
          <div class="lang-dropdown-header">LANGUAGE</div>
          <div class="lang-grid">
            {languages.map((item) => (
              <a 
                href={pageUrl(item.code, slug)} 
                class={`lang-item ${item.code === lang ? 'active' : ''}`}
                title={item.name}
              >
                {item.code.toUpperCase()}
              </a>
            ))}
          </div>
        </div>
      </div>
      <button id="theme" class="theme-toggle" type="button" aria-label={t.nav.theme}>
        ◐
      </button>
    </div>
  </div>
</header>

<style define:vars={{ "--accent": "#0ea5e9", "--text-light": "#e5e7eb", "--bg-dark": "#0f172a" }}>
  .header {
    background: linear-gradient(135deg, var(--bg-dark) 0%, #1e293b 100%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    position: sticky;
    top: 0;
    z-index: 1000;
    backdrop-filter: blur(12px);
  }

  .header-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 1rem 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
  }

  /* Logo Section */
  .logo-section {
    flex-shrink: 0;
  }

  .logo-link {
    display: flex;
    align-items: center;
    text-decoration: none;
    transition: transform 0.2s ease;
  }

  .logo-link:hover {
    transform: translateY(-2px);
  }

  .logo-text {
    font-size: 1.5rem;
    font-weight: 600;
    color: white;
    letter-spacing: -0.5px;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .logo-icon {
    width: 48px;
    height: 48px;
    border-radius: 8px;
    object-fit: contain;
    display: inline-block;
    vertical-align: middle;
  }

  .site-name {
    color: var(--text-light);
    font-weight: 700;
    margin-left: 8px;
    font-size: 1.125rem;
    display: inline-block;
    vertical-align: middle;
  }

  /* Navigation */
  .nav-section {
    flex: 1;
    display: flex;
    justify-content: center;
  }

  .nav-list {
    list-style: none;
    display: flex;
    gap: 2.5rem;
    margin: 0;
    padding: 0;
    align-items: center;
  }

  .nav-item {
    position: relative;
  }

  .nav-link {
    color: var(--text-light);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    transition: color 0.3s ease;
    position: relative;
  }

  .nav-link:hover {
    color: var(--accent);
  }

  .nav-link::after {
    content: "";
    position: absolute;
    bottom: -6px;
    left: 0;
    width: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--accent), transparent);
    transition: width 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .nav-link:hover::after {
    width: 100%;
  }

  /* Right Section */
  .header-right {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }

  .theme-toggle {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--text-light);
    border-radius: 8px;
    width: 44px;
    height: 44px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    transition: all 0.25s ease;
    flex-shrink: 0;
  }

  .theme-toggle:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.25);
  }

  .theme-toggle:focus {
    outline: none;
    background: rgba(255, 255, 255, 0.12);
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.15);
  }

  /* Language Switcher */
  .lang-switcher {
    position: relative;
  }

  .lang-toggle {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--text-light);
    border-radius: 8px;
    padding: 0 1rem;
    height: 44px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.95rem;
    font-weight: 600;
    transition: all 0.25s ease;
  }

  .lang-toggle:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.25);
  }

  .lang-dropdown {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    width: 340px;
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 1.5rem;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition: all 0.2s ease;
    z-index: 100;
  }

  .lang-dropdown.show {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .lang-dropdown-header {
    color: var(--text-light);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
  }

  .lang-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.75rem;
  }

  .lang-item {
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #9ca3af;
    text-decoration: none;
    border-radius: 8px;
    height: 44px;
    font-size: 0.85rem;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .lang-item:hover {
    background: rgba(255, 255, 255, 0.1);
    color: var(--text-light);
    border-color: rgba(255, 255, 255, 0.2);
  }

  .lang-item.active {
    background: rgba(14, 165, 233, 0.1);
    border-color: var(--accent);
    color: var(--accent);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .header-container {
      gap: 2rem;
    }

    .nav-list {
      gap: 1.5rem;
    }

    .nav-link {
      font-size: 0.9rem;
    }
  }

  @media (max-width: 768px) {
    .header {
      position: relative;
    }

    .header-container {
      flex-wrap: wrap;
      gap: 1.5rem;
      padding: 1rem 1.5rem;
    }

    .logo-section {
      order: 1;
    }

    .nav-section {
      order: 3;
      width: 100%;
      justify-content: flex-start;
    }

    .nav-list {
      gap: 1rem;
      flex-wrap: wrap;
    }

    .header-right {
      order: 2;
      margin-left: auto;
    }

    .nav-link {
      font-size: 0.85rem;
      padding: 0.25rem;
    }

    .nav-link::after {
      bottom: -4px;
    }
  }

  @media (max-width: 480px) {
    .header-container {
      padding: 0.875rem 1rem;
      gap: 1rem;
    }

    .logo-text {
      font-size: 1.125rem;
    }

    .logo-icon {
      width: 40px;
      height: 40px;
    }

    .nav-list {
      gap: 0.75rem;
    }

    .theme-toggle {
      padding: 0.5rem;
      width: 40px;
      height: 40px;
    }

    .lang-toggle {
      padding: 0 0.75rem;
      height: 40px;
    }

    .lang-dropdown {
      width: 300px;
      right: -40px;
    }

    .lang-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>

<script is:inline>
  (function setupLanguageSwitcher() {
    const langToggle = document.getElementById('lang-toggle');
    const langDropdown = document.getElementById('lang-dropdown');
    
    if (langToggle && langDropdown) {
      langToggle.addEventListener('click', function(e) {
        e.stopPropagation();
        const isExpanded = langToggle.getAttribute('aria-expanded') === 'true';
        langToggle.setAttribute('aria-expanded', String(!isExpanded));
        langDropdown.classList.toggle('show');
      });

      document.addEventListener('click', function(e) {
        if (!langDropdown.contains(e.target) && !langToggle.contains(e.target)) {
          langToggle.setAttribute('aria-expanded', 'false');
          langDropdown.classList.remove('show');
        }
      });
    }
  })();
</script>
