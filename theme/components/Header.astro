---
const { lang, t, slug = "" } = Astro.props;
import { pageUrl, languages } from "theme/i18n/config";

const isEs = lang === "es";
const isDe = lang === "de";
const isFr = lang === "fr";
const isIt = lang === "it";
const isPt = lang === "pt";
const navItems = isFr ? [
  { href: pageUrl(lang, "world-clock"), label: "Horloge mondiale", position: 2, key: "world-clock" },
  { href: pageUrl(lang, "meeting-planner"), label: "Planificateur de réunion", position: 3, key: "meeting-planner" },
  { href: pageUrl(lang, "time-difference-calculator"), label: "Calculateur de décalage", position: 4, key: "time-difference-calculator" },
  { href: pageUrl(lang, "developer-tools"), label: "Outils pour développeurs", position: 5, key: "developer-tools" },
  { href: pageUrl(lang, "time-zone-guide"), label: "Guide des fuseaux horaires", position: 6, key: "time-zone-guide" }
] : isIt ? [
  { href: pageUrl(lang, "world-clock"), label: "Orologio mondiale", position: 2, key: "world-clock" },
  { href: pageUrl(lang, "meeting-planner"), label: "Pianificatore di riunioni", position: 3, key: "meeting-planner" },
  { href: pageUrl(lang, "time-difference-calculator"), label: "Calcolatore di differenza", position: 4, key: "time-difference-calculator" },
  { href: pageUrl(lang, "developer-tools"), label: "Strumenti per sviluppatori", position: 5, key: "developer-tools" },
  { href: pageUrl(lang, "time-zone-guide"), label: "Guida ai fusi orari", position: 6, key: "time-zone-guide" }
] : isPt ? [
  { href: pageUrl(lang, "world-clock"), label: "Relógio mundial", position: 2, key: "world-clock" },
  { href: pageUrl(lang, "meeting-planner"), label: "Planejador de reuniões", position: 3, key: "meeting-planner" },
  { href: pageUrl(lang, "time-difference-calculator"), label: "Calculadora de diferença", position: 4, key: "time-difference-calculator" },
  { href: pageUrl(lang, "developer-tools"), label: "Ferramentas para desenvolvedores", position: 5, key: "developer-tools" },
  { href: pageUrl(lang, "time-zone-guide"), label: "Guia de fusos horários", position: 6, key: "time-zone-guide" }
] : [
  { href: pageUrl(lang, "world-clock"), label: t.nav?.worldClock || (isDe ? "Weltuhr" : isEs ? "Reloj mundial" : "World Clock"), position: 2, key: "world-clock" },
  { href: pageUrl(lang, "meeting-planner"), label: t.nav?.meetingPlanner || (isDe ? "Meeting-Planer" : isEs ? "Planificador de reuniones" : "Meeting Planner"), position: 3, key: "meeting-planner" },
  { href: "/time-zone-map/", label: t.nav?.map || (isDe ? "Karte" : isEs ? "Mapa" : "Map"), position: 4, key: "time-zone-map" },
  { href: pageUrl(lang, "developer-tools"), label: t.nav?.developerTools || (isDe ? "Entwickler-Tools" : isEs ? "Herramientas para desarrolladores" : "Dev Tools"), position: 5, key: "developer-tools" },
  { href: pageUrl(lang, "time-zone-guide"), label: t.nav?.guide || (isDe ? "Ratgeber" : isEs ? "Guía" : "Guide"), position: 6, key: "time-zone-guide" },
  { href: isDe ? "/de/blog/" : "/blog/", label: t.nav?.blog || "Blog", position: 7, key: "blog" },
];

const isCurrentItem = (key: string) => key === "" ? slug === "" : slug === key || slug.startsWith(`${key}/`);
const navAriaLabel = isDe ? "Hauptnavigation" : isEs ? "Navegación principal" : isFr ? "Navigation principale" : isIt ? "Navigazione principale" : isPt ? "Navegação principal" : "Primary";
const searchAriaLabel = t.nav?.searchAriaLabel || (isDe ? "Website durchsuchen (Strg+K)" : isEs ? "Buscar en el sitio (Ctrl+K)" : isFr ? "Rechercher sur le site (Ctrl+K)" : isIt ? "Cerca nel sito (Ctrl+K)" : isPt ? "Pesquisar no site (Ctrl+K)" : "Search site (Ctrl+K)");
const searchBtnText = t.nav?.search || (isDe ? "Suchen..." : isEs ? "Buscar..." : isFr ? "Rechercher…" : isIt ? "Cerca..." : isPt ? "Pesquisar..." : "Search...");
const menuAriaLabel = isDe ? "Menü öffnen/schließen" : isEs ? "Abrir/cerrar menú" : isFr ? "Ouvrir/fermer le menu" : isIt ? "Apri/chiudi menu" : isPt ? "Abrir/fechar menu" : "Toggle navigation menu";
---

<header class="header" role="banner">
  <div class="header-container">
    <!-- Logo Section -->
    <div class="logo-section">
      <a href={pageUrl(lang, "")} class="logo-link" aria-label={t.brand} data-position="1">
        <img src="/logo.svg" alt="GMT to EST logo" class="logo-icon" width="40" height="40" fetchpriority="high" decoding="async" />
        <span class="site-name">{isDe ? "GMT zu EST Umrechner" : isEs ? "Convertidor GMT a EST" : isFr ? "Convertisseur GMT vers EST" : isIt ? "Convertitore da GMT a EST" : isPt ? "Conversor de GMT para EST" : "GMT to EST Converter"}</span>
      </a>
    </div>

    <!-- Desktop Navigation Section -->
    <nav class="nav-section desktop-nav" aria-label={navAriaLabel} role="navigation">
      <ul class="nav-list" itemscope itemtype="https://schema.org/SiteNavigationElement">
        {navItems.map((item) => (
          <li class="nav-item" data-position={item.position}>
            <a 
              href={item.href} 
              class:list={["nav-link", isCurrentItem(item.key) && "nav-active"]}
              aria-current={isCurrentItem(item.key) ? "page" : undefined}
              itemprop="url"
              data-nav-item={item.position}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Header Actions (Search + Mobile Hamburger) -->
    <div class="header-actions">
      <!-- Global Search Trigger Button -->
      <button type="button" class="trigger-global-search search-header-btn" aria-label={searchAriaLabel}>
        <svg class="search-btn-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <span class="search-btn-text">{searchBtnText}</span>
        <kbd class="search-btn-kbd">{isDe ? "Strg+K" : "⌘K"}</kbd>
      </button>

      <!-- Mobile Menu Button -->
      <button type="button" id="mobile-menu-toggle" class="mobile-menu-btn" aria-label={menuAriaLabel} aria-expanded="false" aria-controls="mobile-nav-drawer">
        <svg class="icon-menu" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg class="icon-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div id="mobile-nav-drawer" class="mobile-nav-drawer" aria-hidden="true">
    <nav class="mobile-nav-content" aria-label={navAriaLabel}>
      <ul class="mobile-nav-list" itemscope itemtype="https://schema.org/SiteNavigationElement">
        {navItems.map((item) => (
          <li class="mobile-nav-item" data-position={item.position}>
            <a 
              href={item.href} 
              class:list={["mobile-nav-link", isCurrentItem(item.key) && "mobile-nav-active"]}
              aria-current={isCurrentItem(item.key) ? "page" : undefined}
              itemprop="url"
              data-nav-item={item.position}
            >
              <span>{item.label}</span>
              <svg class="chevron-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </a>
          </li>
        ))}
      </ul>
      <div class="mobile-nav-footer">
        <button type="button" class="trigger-global-search mobile-search-trigger" aria-label={searchAriaLabel}>
          <div class="mobile-search-left">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <span>{searchBtnText}</span>
          </div>
          <kbd>{isDe ? "Strg+K" : "⌘K"}</kbd>
        </button>
      </div>
    </nav>
  </div>

  <!-- Hidden controls -->
  <button id="theme" type="button" aria-label={t.nav.theme} style="display:none"></button>
</header>

<script is:inline>
  (function initMobileHeader() {
    const btn = document.getElementById('mobile-menu-toggle');
    const drawer = document.getElementById('mobile-nav-drawer');
    if (!btn || !drawer) return;

    function setMenuState(open) {
      btn.classList.toggle('is-active', open);
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      drawer.classList.toggle('is-open', open);
      drawer.setAttribute('aria-hidden', open ? 'false' : 'true');
    }

    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      const isOpen = btn.classList.contains('is-active');
      setMenuState(!isOpen);
    });

    // Close when clicking any link or button inside drawer
    drawer.querySelectorAll('a, button').forEach(function(el) {
      el.addEventListener('click', function() {
        setMenuState(false);
      });
    });

    // Close on click outside header
    document.addEventListener('click', function(e) {
      if (btn.classList.contains('is-active')) {
        const header = document.querySelector('.header');
        if (header && !header.contains(e.target)) {
          setMenuState(false);
        }
      }
    });

    // Close on Escape key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && btn.classList.contains('is-active')) {
        setMenuState(false);
      }
    });

    // Close automatically when resizing to desktop viewport
    window.addEventListener('resize', function() {
      if (window.innerWidth > 768 && btn.classList.contains('is-active')) {
        setMenuState(false);
      }
    }, { passive: true });
  })();
</script>

<style define:vars={{ "--accent": "#0ea5e9", "--text-light": "#e5e7eb", "--bg-dark": "#0f172a" }}>
  .header {
    background: linear-gradient(135deg, var(--bg-dark) 0%, #1e293b 100%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    position: sticky;
    top: 0;
    z-index: 1000;
    backdrop-filter: blur(12px);
    width: 100%;
  }

  .header-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0.85rem 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    box-sizing: border-box;
  }

  /* Logo Section */
  .logo-section {
    flex-shrink: 0;
    min-width: 0;
  }

  .logo-link {
    display: flex;
    align-items: center;
    text-decoration: none;
    transition: opacity 0.2s ease;
    min-width: 0;
  }

  .logo-link:hover {
    opacity: 0.85;
  }

  .logo-icon {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    object-fit: contain;
    display: inline-block;
    vertical-align: middle;
    flex-shrink: 0;
  }

  .site-name {
    color: var(--text-light);
    font-weight: 700;
    margin-left: 10px;
    font-size: 1.05rem;
    display: inline-block;
    vertical-align: middle;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  /* Desktop Navigation */
  .desktop-nav {
    display: flex;
    justify-content: flex-end;
  }

  .nav-list {
    list-style: none;
    display: flex;
    gap: 2rem;
    margin: 0;
    padding: 0;
    align-items: center;
  }

  .nav-item {
    position: relative;
  }

  .nav-link {
    color: rgba(229, 231, 235, 0.8);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    transition: color 0.3s ease;
    position: relative;
    letter-spacing: 0.01em;
  }

  .nav-link:hover {
    color: #ffffff;
  }

  .nav-link.nav-active {
    color: #ffffff;
    font-weight: 700;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    bottom: -6px;
    left: 0;
    width: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--accent), transparent);
    transition: width 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .nav-link:hover::after {
    width: 100%;
  }

  .nav-link.nav-active::after {
    width: 100%;
    background: var(--accent);
  }

  /* Actions Area */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .search-header-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--text-light);
    padding: 0.4rem 0.8rem;
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.85rem;
    transition: all 0.2s ease;
  }

  .search-header-btn:hover {
    background: rgba(14, 165, 233, 0.15);
    border-color: var(--accent);
    color: var(--accent);
  }

  .search-header-btn kbd {
    background: rgba(0, 0, 0, 0.3);
    padding: 0.15rem 0.35rem;
    border-radius: 4px;
    font-size: 0.7rem;
  }

  .mobile-menu-btn {
    display: none;
  }

  .mobile-nav-drawer {
    display: none;
  }

  /* Responsive Breakpoints */
  @media (max-width: 1024px) {
    .nav-list {
      gap: 1.25rem;
    }

    .nav-link {
      font-size: 0.85rem;
    }
  }

  @media (max-width: 768px) {
    .header-container {
      padding: 0.55rem 1rem;
      min-height: 54px;
    }

    /* Hide desktop navigation */
    .desktop-nav {
      display: none;
    }

    /* Logo scaling on mobile */
    .logo-section {
      flex: 1 1 auto;
      max-width: calc(100% - 92px);
      overflow: hidden;
    }

    .logo-icon {
      width: 32px;
      height: 32px;
    }

    .site-name {
      font-size: 0.95rem;
      margin-left: 8px;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 100%;
      display: block;
    }

    .header-actions {
      gap: 0.45rem;
    }

    /* Search button becomes compact icon button on mobile */
    .search-header-btn {
      padding: 0;
      width: 38px;
      height: 38px;
      justify-content: center;
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.15);
    }

    .search-btn-text,
    .search-btn-kbd {
      display: none;
    }

    .search-btn-icon {
      width: 18px;
      height: 18px;
    }

    /* Mobile hamburger menu button */
    .mobile-menu-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 38px;
      height: 38px;
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.15);
      color: var(--text-light);
      cursor: pointer;
      padding: 0;
      transition: all 0.2s ease;
    }

    .mobile-menu-btn:hover,
    .mobile-menu-btn:active {
      background: rgba(14, 165, 233, 0.15);
      border-color: var(--accent);
      color: var(--accent);
    }

    .mobile-menu-btn .icon-menu {
      display: block;
    }

    .mobile-menu-btn .icon-close {
      display: none;
    }

    .mobile-menu-btn.is-active {
      background: rgba(14, 165, 233, 0.2);
      border-color: var(--accent);
      color: var(--accent);
    }

    .mobile-menu-btn.is-active .icon-menu {
      display: none;
    }

    .mobile-menu-btn.is-active .icon-close {
      display: block;
    }

    /* Mobile Drawer */
    .mobile-nav-drawer {
      display: block;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      width: 100%;
      background: linear-gradient(180deg, #0f172a 0%, #1e293b 100%);
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
      max-height: calc(100vh - 58px);
      overflow-y: auto;
      z-index: 999;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translateY(-8px);
      transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s ease;
    }

    .mobile-nav-drawer.is-open {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translateY(0);
    }

    .mobile-nav-content {
      padding: 1rem;
    }

    .mobile-nav-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }

    .mobile-nav-link {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.75rem 1rem;
      border-radius: 8px;
      color: var(--text-light);
      font-size: 0.95rem;
      font-weight: 500;
      text-decoration: none;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid transparent;
      transition: all 0.2s ease;
    }

    .mobile-nav-link:hover,
    .mobile-nav-link:active {
      background: rgba(14, 165, 233, 0.12);
      border-color: rgba(14, 165, 233, 0.3);
      color: #ffffff;
    }

    .mobile-nav-link.mobile-nav-active {
      background: rgba(14, 165, 233, 0.18);
      border-color: var(--accent);
      color: #ffffff;
      font-weight: 700;
    }

    .chevron-icon {
      color: #64748b;
      transition: transform 0.2s ease;
    }

    .mobile-nav-link:hover .chevron-icon,
    .mobile-nav-link.mobile-nav-active .chevron-icon {
      color: var(--accent);
      transform: translateX(3px);
    }

    .mobile-nav-footer {
      margin-top: 1rem;
      padding-top: 1rem;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
    }

    .mobile-search-trigger {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.12);
      color: var(--text-light);
      padding: 0.75rem 1rem;
      border-radius: 8px;
      font-size: 0.95rem;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .mobile-search-left {
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }

    .mobile-search-trigger:hover {
      background: rgba(14, 165, 233, 0.15);
      border-color: var(--accent);
      color: var(--accent);
    }

    .mobile-search-trigger kbd {
      background: rgba(0, 0, 0, 0.3);
      padding: 0.2rem 0.4rem;
      border-radius: 4px;
      font-size: 0.75rem;
    }
  }

  @media (max-width: 480px) {
    .header-container {
      padding: 0.5rem 0.85rem;
    }

    .site-name {
      font-size: 0.9rem;
    }
  }

  @media (max-width: 360px) {
    .header-container {
      padding: 0.45rem 0.65rem;
    }

    .logo-icon {
      width: 28px;
      height: 28px;
    }

    .site-name {
      font-size: 0.82rem;
      margin-left: 6px;
    }

    .search-header-btn,
    .mobile-menu-btn {
      width: 34px;
      height: 34px;
    }
  }
</style>
