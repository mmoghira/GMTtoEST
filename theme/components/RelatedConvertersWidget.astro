---
import { getRelatedConverters } from "theme/i18n/clusters";

type Props = {
  slug: string;
  lang?: string;
};

const { slug, lang = "en" } = Astro.props;
const items = getRelatedConverters(slug, lang);
---

<section class="related-converters-widget content-section" aria-labelledby="related-converters-heading">
  <div class="widget-header">
    <div class="eyebrow">Related Tools</div>
    <h2 id="related-converters-heading">Related Time Zone Converters</h2>
    <p class="widget-desc">Explore semantically matched conversion calculators to quickly translate times across regional standards.</p>
  </div>
  <div class="related-grid">
    {items.map((item) => (
      <article class="related-card">
        <h3 class="related-card-title"><a href={item.href}>{item.label}</a></h3>
        <p class="related-card-text">{item.description}</p>
      </article>
    ))}
  </div>
</section>

<style>
  .related-converters-widget {
    margin: 3rem 0;
    padding: 2rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 12px;
  }

  .widget-header {
    margin-bottom: 1.5rem;
  }

  .widget-header .eyebrow {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent);
    font-weight: 700;
    margin-bottom: 0.25rem;
  }

  .widget-header h2 {
    margin: 0 0 0.5rem;
    font-family: 'Space Grotesk', sans-serif;
  }

  .widget-desc {
    color: var(--muted);
    margin: 0;
    font-size: 0.95rem;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1rem;
  }

  .related-card {
    padding: 1rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--line);
    border-radius: 8px;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .related-card:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
  }

  .related-card-title {
    margin: 0 0 0.35rem;
    font-size: 1rem;
    font-family: 'Space Grotesk', sans-serif;
  }

  .related-card-title a {
    color: var(--text);
    text-decoration: none;
  }

  .related-card-title a:hover {
    color: var(--accent);
  }

  .related-card-text {
    margin: 0;
    font-size: 0.85rem;
    color: var(--muted);
    line-height: 1.4;
  }
</style>
