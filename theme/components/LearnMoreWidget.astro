---
import { getEducationalGuides } from "theme/i18n/clusters";

type Props = {
  slug: string;
};

const { slug } = Astro.props;
const guides = getEducationalGuides(slug);
---

<section class="learn-more-widget content-section" aria-labelledby="learn-more-heading">
  <div class="widget-header">
    <div class="eyebrow">Knowledge Hub</div>
    <h2 id="learn-more-heading">Learn More About Time Zones</h2>
    <p class="widget-desc">Deepen your understanding of Coordinated Universal Time, daylight saving rules, and UTC offsets with our educational guides.</p>
  </div>

  <div class="guides-grid">
    {guides.map((guide) => (
      <a href={guide.href} class="guide-card">
        <div class="guide-card-icon">📚</div>
        <div class="guide-card-body">
          <h3>{guide.label}</h3>
          <p>{guide.description}</p>
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .learn-more-widget {
    margin: 3rem 0;
    padding: 2rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 12px;
  }

  .widget-header {
    margin-bottom: 1.5rem;
  }

  .widget-header .eyebrow {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent);
    font-weight: 700;
    margin-bottom: 0.25rem;
  }

  .widget-header h2 {
    margin: 0 0 0.5rem;
    font-family: 'Space Grotesk', sans-serif;
  }

  .widget-desc {
    color: var(--muted);
    margin: 0;
    font-size: 0.95rem;
  }

  .guides-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }

  .guide-card {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--line);
    border-radius: 8px;
    text-decoration: none;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .guide-card:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
  }

  .guide-card-icon {
    font-size: 1.5rem;
    line-height: 1;
    flex-shrink: 0;
    padding-top: 0.2rem;
  }

  .guide-card-body h3 {
    margin: 0 0 0.25rem;
    font-size: 0.98rem;
    font-family: 'Space Grotesk', sans-serif;
    color: var(--text);
  }

  .guide-card:hover .guide-card-body h3 {
    color: var(--accent);
  }

  .guide-card-body p {
    margin: 0;
    font-size: 0.83rem;
    color: var(--muted);
    line-height: 1.4;
  }
</style>
