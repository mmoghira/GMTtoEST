    <!-- Brand & Social Column -->
    <div class="footer-section brand-section">
      <a href={homePathResolved} class="footer-logo">
        <img 
          src="/assets/logo.webp" 
          alt={isTr ? "GMT - EST Logosu" : isDe ? "GMT zu EST Logo" : isEs ? "Logo de Convertidor GMT a EST" : isFr ? "Logo Convertisseur GMT vers EST" : isIt ? "Logo Convertitore da GMT a EST" : isPt ? "Logotipo do Conversor de GMT para EST" : isPl ? "Logo Konwertera GMT na EST" : isNl ? "GMT naar EST logo" : "GMT to EST logo"} 
          class="footer-logo-icon" 
          width="48" 
          height="48" 
          loading="lazy" 
          decoding="async" 
        />
        <span class="site-name">{isTr ? "GMT - EST Dönüştürücü" : isDe ? "GMT zu EST Umrechner" : isEs ? "Convertidor GMT a EST" : isFr ? "Convertisseur GMT vers EST" : isIt ? "Convertitore da GMT a EST" : isPt ? "Conversor de GMT para EST" : isPl ? "Konwerter GMT na EST" : isNl ? "GMT naar EST Omrekenaar" : "GMT to EST Converter"}</span>
      </a>
      <p class="brand-desc">
