        </a>
      </div>
    </div>

    <!-- Top Converters Column (6 links) -->
    <nav class="footer-section links-section" aria-labelledby="footer-converters-heading">
      <h3 id="footer-converters-heading" class="footer-heading">
        {isTr ? "DÖNÜŞTÜRÜCÜLER" : isDe ? "UMRECHNER" : isEs ? "CONVERTIDORES" : isFr ? "CONVERTISSEURS" : isIt ? "CONVERTITORI" : isPt ? "CONVERSORES" : isPl ? "KONWERTERY" : isNl ? "OMREKENAARS" : "CONVERTERS"}
      </h3>
      <ul class="footer-links">
        {topConverters.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <!-- Top Guides Column (4 links + 1 All Tools link) -->
    <nav class="footer-section links-section" aria-labelledby="footer-guides-heading">
      <h3 id="footer-guides-heading" class="footer-heading">
        {isTr ? "REHBERLER & ARAÇLAR" : isDe ? "RATGEBER & TOOLS" : isEs ? "GUÍAS Y RECURSOS" : isFr ? "GUIDES & OUTILS" : isIt ? "GUIDE & STRUMENTI" : isPt ? "GUIAS & FERRAMENTAS" : "GUIDES & TOOLS"}
      </h3>
      <ul class="footer-links">
        {topGuides.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
        <li class="tools-highlight-link">
          <a href={toolsLink.href} class="highlight-link">{toolsLink.label}</a>
        </li>
      </ul>
    </nav>

    <!-- Company & Legal Column (5 links) -->
    <nav class="footer-section links-section" aria-labelledby="footer-company-heading">
      <h3 id="footer-company-heading" class="footer-heading">
        {isTr ? "KURUMSAL" : isDe ? "UNTERNEHMEN" : isEs ? "EMPRESA" : isFr ? "ENTREPRISE" : isIt ? "AZIENDA" : isPt ? "EMPRESA" : isPl ? "FIRMA" : isNl ? "BEDRIJF" : "COMPANY"}
      </h3>
      <ul class="footer-links">
        {companyLinks.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <!-- Language Selector Column (Step-4 Kept 6 Languages) -->
    <div class="footer-section language-section" aria-labelledby="footer-lang-heading">
      <h3 id="footer-lang-heading" class="footer-heading">
        {isTr ? "DİL" : isDe ? "SPRACHE" : isEs ? "IDIOMA" : isFr ? "LANGUE" : isIt ? "LINGUA" : isPt ? "IDIOMA" : isPl ? "JĘZYK" : isNl ? "TAAL" : "LANGUAGE"}
      </h3>
      <div class="footer-lang-grid">
        {keptLanguages.map((item) => (
          <a
            href={pageUrl(item.code, slug)}
            hreflang={item.code}
            class={`footer-lang-item ${item.code === lang ? 'active' : ''}`}
            title={item.name}
            aria-label={item.name}
            aria-current={item.code === lang ? "page" : undefined}
          >
            {item.code.toUpperCase()}
          </a>
        ))}
      </div>
    </div>
  </div>

  <!-- Footer Bottom / Copyright / DMCA -->
  <div class="footer-bottom">
    <div class="footer-bottom-inner">
      <p>&copy; {new Date().getFullYear()} {t.brand || "GMT to EST Converter"}. {isTr ? "Tüm hakları saklıdır." : isDe ? "Alle Rechte vorbehalten." : isEs ? "Todos los derechos reservados." : isFr ? "Tous droits réservés." : isIt ? "Tutti i diritti riservati." : isPt ? "Todos os direitos reservados." : isPl ? "Wszelkie prawa zastrzeżone." : isNl ? "Alle rechten voorbehouden." : "All rights reserved."}</p>
      <a 
        href="https://www.dmca.com/Protection/Status.aspx?ID=01cb090d-0a05-4b4c-b0d2-949abb6ea9c5"
        title="DMCA.com Protection Status"
        class="dmca-badge"
        target="_blank"
        rel="noopener noreferrer"
      >
        <img
          src="https://images.dmca.com/Badges/dmca_protected_sml_120aj.png?ID=01cb090d-0a05-4b4c-b0d2-949abb6ea9c5"
          alt="DMCA.com Protection Status"
          width="121"
          height="24"
          loading="lazy"
          decoding="async"
        />
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: linear-gradient(180deg, rgba(12, 53, 74, 0.4) 0%, rgba(8, 28, 40, 0.95) 100%);
    border-top: 1px solid var(--line);
    padding: 3rem 1.5rem 1.5rem;
    margin-top: 4rem;
    color: var(--muted);
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr 0.8fr;
    gap: 2.5rem;
  }

  .footer-section {
    display: flex;
    flex-direction: column;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    margin-bottom: 0.85rem;
  }

  .footer-logo-icon {
    width: 44px;
    height: 44px;
    border-radius: 8px;
  }

  .footer-logo .site-name {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.01em;
  }

  .brand-desc {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--muted);
    margin: 0 0 1.25rem 0;
    max-width: 320px;
  }

  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .social-links a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    color: #e5e7eb;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .social-links a:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
    color: var(--accent);
  }

  .social-links a.social-fb:hover { background: #1877F2; border-color: #1877F2; color: white; }
  .social-links a.social-x:hover { background: #ffffff; border-color: #ffffff; color: #000000; }
  .social-links a.social-in:hover { background: #0A66C2; border-color: #0A66C2; color: white; }
  .social-links a.social-yt:hover { background: #FF0000; border-color: #FF0000; color: white; }
  .social-links a.social-ig:hover { background: #dc2743; border-color: #dc2743; color: white; }
  .social-links a.social-pi:hover { background: #E60023; border-color: #E60023; color: white; }
  .social-links a.social-tt:hover { background: #000000; border-color: #fe2c55; color: #fe2c55; }

  .footer-heading {
    margin: 0 0 1.1rem 0;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--text);
    text-transform: uppercase;
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer-links a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.875rem;
    transition: color 0.2s ease;
  }

  .footer-links a:hover {
    color: var(--accent);
  }

  .tools-highlight-link {
    margin-top: 0.35rem;
    padding-top: 0.45rem;
    border-top: 1px dashed rgba(255, 255, 255, 0.12);
  }

  .tools-highlight-link .highlight-link {
    color: var(--accent-2);
    font-weight: 600;
  }

