---
import { pageUrl, keptLanguages, getConverterDisplayName } from "theme/i18n/config";

interface Props {
  lang: string;
  slug?: string;
  t?: any;
}

const { lang = "en", slug = "", t = {} } = Astro.props;

const isEs = lang === "es";
const isDe = lang === "de";
const isFr = lang === "fr";
const isIt = lang === "it";
const isPt = lang === "pt";
const isPl = lang === "pl";
const isNl = lang === "nl";
const isTr = lang === "tr";

const homePathResolved = pageUrl(lang, "");

// Top 6 Converters (Highest Search Demand)
const topConverters = [
  { href: pageUrl(lang, ""), label: isDe ? "GMT zu EST Umrechner" : isEs ? "Convertidor GMT a EST" : isFr ? "Convertisseur GMT vers EST" : isIt ? "Convertitore da GMT a EST" : isPt ? "Conversor de GMT para EST" : isTr ? "GMT - EST Dönüştürücü" : "GMT to EST Converter" },
  { href: pageUrl(lang, "est-to-gmt"), label: isDe ? "EST in GMT umrechnen" : isEs ? "Convertidor EST a GMT" : isFr ? "Convertisseur EST vers GMT" : isIt ? "Convertitore da EST a GMT" : isPt ? "Conversor de EST para GMT" : isTr ? "EST - GMT Dönüştürücü" : "EST to GMT Converter" },
  { href: pageUrl(lang, "cst-to-est"), label: isDe ? "CST zu EST Umrechner" : isEs ? "Convertidor CST a EST" : isFr ? "Convertisseur CST vers EST" : isIt ? "Convertitore da CST a EST" : isPt ? "Conversor de CST para EST" : isTr ? "CST - EST Dönüştürücü" : "CST to EST Converter" },
  { href: pageUrl(lang, "gmt-to-ist"), label: isDe ? "GMT zu IST Umrechner" : isEs ? "Convertidor GMT a IST" : isFr ? "Convertisseur GMT vers IST" : isIt ? "Convertitore da GMT a IST" : isPt ? "Conversor de GMT para IST" : isTr ? "GMT - IST Dönüştürücü" : "GMT to IST Converter" },
  { href: pageUrl(lang, "cdt-to-est"), label: isDe ? "CDT zu EST Umrechner" : isEs ? "Convertidor CDT a EST" : isFr ? "Convertisseur CDT vers EST" : isIt ? "Convertitore da CDT a EST" : isPt ? "Conversor de CDT para EST" : isTr ? "CDT - EST Dönüştürücü" : "CDT to EST Converter" },
  { href: pageUrl(lang, "gmt-to-cst"), label: isDe ? "GMT zu CST Umrechner" : isEs ? "Convertidor GMT a CST" : isFr ? "Convertisseur GMT vers CST" : isIt ? "Convertitore da GMT a CST" : isPt ? "Conversor de GMT para CST" : isTr ? "GMT - CST Dönüştürücü" : "GMT to CST Converter" }
];

// Top 4 Guides
const topGuides = [
  { href: pageUrl(lang, "est-vs-edt"), label: isDe ? "EST vs. EDT Vergleich" : isEs ? "EST vs EDT Explicado" : isFr ? "Différence EST vs EDT" : isIt ? "Differenza EST vs EDT" : isPt ? "Diferença EST vs EDT" : "EST vs EDT Difference" },
  { href: pageUrl(lang, "gmt-vs-utc"), label: isDe ? "GMT vs. UTC Leitfaden" : isEs ? "GMT vs UTC Explicado" : isFr ? "Différence GMT vs UTC" : isIt ? "Differenza GMT vs UTC" : isPt ? "Diferença GMT vs UTC" : "GMT vs UTC Difference" },
  { href: pageUrl(lang, "canada-time-zones"), label: isDe ? "Zeitzonen Kanadas" : isEs ? "Zonas horarias de Canadá" : isFr ? "Fuseaux horaires du Canada" : isIt ? "Fusi orari del Canada" : isPt ? "Fusos horários do Canadá" : "Canada Time Zones" },
  { href: pageUrl(lang, "daylight-saving-time-explained"), label: isDe ? "Sommerzeit erklärt" : isEs ? "Horario de verano explicado" : isFr ? "Heure d'été expliquée" : isIt ? "Ora legale spiegata" : isPt ? "Horário de verão explicado" : "DST Explained" }
];

// Folded Tools link
const toolsLink = {
  href: pageUrl(lang, "tools"),
  label: isDe ? "Alle Zeitzonen-Tools & Rechner →" : isEs ? "Todas las herramientas de hora →" : isFr ? "Tous les outils de fuseaux horaires →" : isIt ? "Tutti gli strumenti e calcolatori →" : isPt ? "Todas as ferramentas de fusos →" : isTr ? "Tüm Saat Dilimi Araçları →" : "All Time Zone Tools & Clocks →"
};

// Company & Legal Links (Clean: link only for Contact, no form)
const companyLinks = [
  { href: pageUrl(lang, "about-us"), label: t.footer?.about || (isDe ? "Über uns" : isEs ? "Sobre nosotros" : isFr ? "À propos" : isIt ? "Chi siamo" : isPt ? "Sobre nós" : "About Us") },
  { href: pageUrl(lang, "contact-us"), label: t.footer?.contact || (isDe ? "Kontakt" : isEs ? "Contacto" : isFr ? "Contact" : isIt ? "Contattaci" : isPt ? "Contato" : "Contact Us") },
  { href: pageUrl(lang, "privacy-policy"), label: t.footer?.privacy || (isDe ? "Datenschutz" : isEs ? "Privacidad" : isFr ? "Confidentialité" : isIt ? "Privacy" : isPt ? "Privacidade" : "Privacy Policy") },
  { href: pageUrl(lang, "terms-of-service"), label: t.footer?.terms || (isDe ? "Nutzungsbedingungen" : isEs ? "Términos" : isFr ? "Conditions" : isIt ? "Termini" : isPt ? "Termos" : "Terms of Service") },
  { href: "/editorial-policy/", label: isDe ? "Redaktionsrichtlinien" : isEs ? "Política editorial" : isFr ? "Politique éditoriale" : isIt ? "Politica editoriale" : isPt ? "Política editorial" : "Editorial Policy" }
];
---

<footer class="site-footer" role="contentinfo">
