---
import { getCountryCitySuggestions } from "theme/i18n/clusters";

type Props = {
  slug: string;
};

const { slug } = Astro.props;
const { countries, cities } = getCountryCitySuggestions(slug);
---

<section class="country-city-widget content-section" aria-labelledby="country-city-heading">
  <h3 id="country-city-heading" class="widget-title">Regional Country & City Clocks</h3>
  <div class="geo-grid">
    <div class="geo-column">
      <h4>Country Guides</h4>
      <ul>
        {countries.map((c) => (
          <li>
            <a href={c.href}>
              <strong>{c.label}</strong>
              <small>{c.description}</small>
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div class="geo-column">
      <h4>Major Cities</h4>
      <ul>
        {cities.map((city) => (
          <li>
            <a href={city.href}>
              <strong>{city.label}</strong>
              <small>{city.description}</small>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .country-city-widget {
    margin: 2.5rem 0;
    padding: 1.75rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 12px;
  }

  .widget-title {
    font-size: 1.15rem;
    margin: 0 0 1.25rem;
    font-family: 'Space Grotesk', sans-serif;
    color: var(--text);
  }

  .geo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
  }

  .geo-column h4 {
    margin: 0 0 0.75rem;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent);
    font-family: 'Space Grotesk', sans-serif;
  }

  .geo-column ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .geo-column a {
    display: flex;
    flex-direction: column;
    padding: 0.75rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--line);
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .geo-column a:hover {
    border-color: var(--accent);
    transform: translateX(2px);
  }

  .geo-column strong {
    color: var(--text);
    font-size: 0.95rem;
  }

  .geo-column a:hover strong {
    color: var(--accent);
  }

  .geo-column small {
    color: var(--muted);
    font-size: 0.8rem;
    margin-top: 0.2rem;
  }
</style>
