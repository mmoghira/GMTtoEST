---
import { getCollection } from "astro:content";
import { getPageMeta, languages, pageUrl, pages } from "theme/i18n/config";

type SitemapItem = {
  slug: string;
  label: string;
};

const { lang = "en" } = Astro.props;

const corePages: SitemapItem[] = pages
  .filter((page) => page.kind !== "dynamic")
  .map((page) => {
    const meta = getPageMeta("en", page.labelKey, page.context);
    return { slug: page.slug, label: meta.title };
  });

const dynamicPages: SitemapItem[] = pages
  .filter((page) => page.kind === "dynamic")
  .map((page) => ({
    slug: page.slug,
    label: `${page.context.from} to ${page.context.to} Converter`,
  }));

// Since all dynamic timezone converter pages (gmt-to-* and *-to-est) are currently
// permanently redirected to the homepage in vercel.json, they are excluded here
// to prevent listing redirected URLs in the HTML sitemap.
const gmtConverters = dynamicPages.filter((page) => 
  page.slug.startsWith("gmt-to-") && false // Exclude all since they redirect
);
const estConverters = dynamicPages.filter((page) => 
  page.slug.endsWith("-to-est") && false // Exclude all since they redirect
);

const sitePages: SitemapItem[] = [
  { slug: "about-us", label: "About Us" },
  { slug: "author", label: "Author" },
  { slug: "contact-us", label: "Contact Us" },
  { slug: "privacy-policy", label: "Privacy Policy" },
  { slug: "terms-of-service", label: "Terms of Service" },
  { slug: "disclaimer", label: "Disclaimer" },
  { slug: "sitemap", label: "Sitemap" },
  { slug: "blog", label: "Blog" },
];

const blogPosts = (await getCollection("blog"))
  .filter((post) => post.id.startsWith("en/"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map((post) => ({
    slug: `blog/${post.id.split("/").slice(1).join("/")}`,
    label: post.data.title,
  }));

const groups = [
  { title: "Core pages", items: corePages },
  { title: "GMT to time zone converters", items: gmtConverters },
  { title: "Time zone to EST converters", items: estConverters },
  { title: "Site pages", items: sitePages },
  { title: "Blog posts", items: blogPosts },
].filter((group) => group.items.length);

const totalUrls = languages.length * groups.reduce((sum, group) => sum + group.items.length, 0);
---

<div class="html-sitemap">
  <p class="sitemap-summary">
    This sitemap links the public pages and language versions on GMT to EST Converter.
    It includes {totalUrls} internal URLs across {languages.length} languages.
  </p>

  <nav class="language-jump" aria-label="Sitemap language sections">
    {languages.map((language) => (
      <a href={`#sitemap-${language.code}`} class={language.code === lang ? "active" : ""}>
        {language.code.toUpperCase()}
      </a>
    ))}
  </nav>

  {languages.map((language) => (
    <section class="sitemap-language" id={`sitemap-${language.code}`} aria-labelledby={`sitemap-${language.code}-heading`}>
      <h2 id={`sitemap-${language.code}-heading`}>{language.name}</h2>
      {groups.map((group) => (
        <section class="sitemap-group" aria-labelledby={`sitemap-${language.code}-${group.title.toLowerCase().replaceAll(" ", "-")}`}>
          <h3 id={`sitemap-${language.code}-${group.title.toLowerCase().replaceAll(" ", "-")}`}>{group.title}</h3>
          <ul>
            {group.items.map((item) => (
              <li>
                <a href={pageUrl(language.code, item.slug)} hreflang={language.code}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </section>
  ))}
</div>

<style>
  .html-sitemap {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .sitemap-summary {
    margin: 0;
    max-width: 72ch;
    color: var(--muted);
    line-height: 1.7;
  }

  .language-jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .language-jump a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 3rem;
    min-height: 2.25rem;
    padding: 0.35rem 0.65rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    color: var(--accent);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .language-jump a.active,
  .language-jump a:hover {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }

  .sitemap-language {
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .sitemap-language h2 {
    margin: 0 0 1.25rem;
  }

  .sitemap-group {
    margin: 0 0 1.75rem;
  }

  .sitemap-group h3 {
    margin: 0 0 0.75rem;
    font-size: 1rem;
  }

  .sitemap-group ul {
    columns: 3 14rem;
    column-gap: 2rem;
    margin: 0;
    padding-left: 1.25rem;
  }

  .sitemap-group li {
    break-inside: avoid;
    margin: 0 0 0.45rem;
    line-height: 1.35;
  }

  .sitemap-group a {
    color: var(--accent);
    text-decoration: none;
  }

  .sitemap-group a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 640px) {
    .sitemap-group ul {
      columns: 1;
    }
  }
</style>
