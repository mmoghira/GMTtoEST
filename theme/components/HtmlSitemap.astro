---
import { getCollection } from "astro:content";
import { getConverterDisplayName, getPageMeta, languages, pageUrl, pages } from "theme/i18n/config";

type SitemapItem = {
  slug: string;
  label: string;
};

const { lang = "en" } = Astro.props;

const corePages: SitemapItem[] = pages
  .filter((page) => page.kind !== "dynamic")
  .map((page) => {
    const meta = getPageMeta("en", page.labelKey, page.context);
    return { slug: page.slug, label: getConverterDisplayName(page) || meta.title };
  });

const dynamicPages: SitemapItem[] = pages
  .filter((page) => page.kind === "dynamic")
  .map((page) => ({
    slug: page.slug,
    label: getConverterDisplayName(page) || `${page.context.from} to ${page.context.to} Converter`,
  }));

const gmtConverters = dynamicPages.filter((page) => page.slug.startsWith("gmt-to-"));
const estConverters = dynamicPages.filter((page) => page.slug.endsWith("-to-est"));

const educationalSitemap: SitemapItem[] = [
  { slug: "blog/what-is-gmt", label: "What is GMT?" },
  { slug: "what-is-utc", label: "What is UTC?" },
  { slug: "blog/what-is-est", label: "What is EST?" },
  { slug: "what-is-edt", label: "What is EDT?" },
  { slug: "gmt-vs-utc", label: "GMT vs UTC Difference" },
  { slug: "est-vs-edt", label: "EST vs EDT Difference" },
  { slug: "utc-vs-est", label: "UTC vs EST Difference" },
  { slug: "standard-time-vs-daylight-saving-time", label: "Standard Time vs Daylight Saving Time" },
  { slug: "how-time-zones-work", label: "How Time Zones Work" },
  { slug: "what-is-utc-offset", label: "What is a UTC Offset?" },
  { slug: "how-to-convert-time-zones", label: "How to Convert Time Zones" },
  { slug: "why-time-zones-exist", label: "Why Time Zones Exist" },
  { slug: "international-date-line-explained", label: "International Date Line Explained" },
  { slug: "iso-8601-date-time-format", label: "ISO 8601 Date & Time Format" },
  { slug: "unix-time-explained", label: "Unix Time & POSIX Timestamps" },
  { slug: "daylight-saving-time-explained", label: "Daylight Saving Time Explained" },
  { slug: "world-time-zones-guide", label: "World Time Zones Guide" },
  { slug: "military-time-converter-guide", label: "Military Time Guide" },
  { slug: "time-zone-abbreviations", label: "Time Zone Abbreviations" },
];

const dstSitemap: SitemapItem[] = [
  { slug: "what-is-daylight-saving-time", label: "What is Daylight Saving Time?" },
  { slug: "dst-start-end-dates", label: "DST Start & End Dates" },
  { slug: "countries-that-use-dst", label: "Countries That Use DST" },
  { slug: "countries-without-dst", label: "Countries Without DST" },
  { slug: "why-dst-exists", label: "Why DST Exists" },
  { slug: "dst-history", label: "DST History & Evolution" },
  { slug: "business-impact-of-dst", label: "Business Impact of DST" },
  { slug: "dst-calendar", label: "DST Calendar & Schedules" },
];

const toolsSitemap: SitemapItem[] = [
  { slug: "world-clock", label: "Global World Clock Tool" },
  { slug: "meeting-planner", label: "Global Meeting Planner Tool" },
  { slug: "event-time-converter", label: "Event Time Converter & Calendar Exporter" },
  { slug: "time-difference-calculator", label: "Time Difference Calculator" },
  { slug: "business-hours-overlap", label: "Business Hours Overlap Tool" },
  { slug: "holiday-calendar", label: "Holiday Calendar & Business Day Calculator" },
  { slug: "travel-planner", label: "Travel Planner & Jet Lag Minimizer" },
  { slug: "developer-tools", label: "Developer Toolkit (Unix, ISO 8601 & Offsets)" },
  { slug: "tools", label: "All Time Zone Tools Hub" },
  { slug: "dst-calendar-tool", label: "Daylight Saving Time Calendar Tool" },
  { slug: "workday-calculator", label: "Holiday & Working Day Calculator" },
  { slug: "time-zone-map", label: "Interactive World Time Zone Map" },
  { slug: "widgets", label: "Embeddable Clock & Converter Widgets" },
  { slug: "downloads", label: "Time Intelligence Download Center" },
];

const countrySitemap: SitemapItem[] = [
  { slug: "usa-time-zones", label: "United States Time Zones" },
  { slug: "canada-time-zones", label: "Canada Time Zones" },
  { slug: "australia-time-zones", label: "Australia Time Zones" },
  { slug: "united-kingdom-time-zone", label: "United Kingdom Time Zone" },
  { slug: "india-time-zone", label: "India Time Zone" },
  { slug: "japan-time-zone", label: "Japan Time Zone" },
  { slug: "china-time-zone", label: "China Time Zone" },
  { slug: "pakistan-time-zone", label: "Pakistan Time Zone" },
  { slug: "germany-time-zone", label: "Germany Time Zone" },
  { slug: "france-time-zone", label: "France Time Zone" },
  { slug: "brazil-time-zones", label: "Brazil Time Zones" },
  { slug: "mexico-time-zones", label: "Mexico Time Zones" },
  { slug: "russia-time-zones", label: "Russia Time Zones" },
  { slug: "south-africa-time-zone", label: "South Africa Time Zone" },
  { slug: "uae-time-zone", label: "UAE Time Zone" },
];

const citySitemap: SitemapItem[] = [
  { slug: "new-york-time", label: "New York Time" },
  { slug: "los-angeles-time", label: "Los Angeles Time" },
  { slug: "chicago-time", label: "Chicago Time" },
  { slug: "toronto-time", label: "Toronto Time" },
  { slug: "vancouver-time", label: "Vancouver Time" },
  { slug: "london-time", label: "London Time" },
  { slug: "paris-time", label: "Paris Time" },
  { slug: "berlin-time", label: "Berlin Time" },
  { slug: "dubai-time", label: "Dubai Time" },
  { slug: "karachi-time", label: "Karachi Time" },
  { slug: "mumbai-time", label: "Mumbai Time" },
  { slug: "delhi-time", label: "Delhi Time" },
  { slug: "tokyo-time", label: "Tokyo Time" },
  { slug: "seoul-time", label: "Seoul Time" },
  { slug: "singapore-time", label: "Singapore Time" },
  { slug: "sydney-time", label: "Sydney Time" },
  { slug: "auckland-time", label: "Auckland Time" },
];

const businessSitemap: SitemapItem[] = [
  { slug: "best-time-us-europe-meetings", label: "Best Time for US–Europe Meetings" },
  { slug: "best-time-us-asia-meetings", label: "Best Time for US–Asia Meetings" },
  { slug: "remote-team-scheduling", label: "Remote Team Scheduling Guide" },
  { slug: "time-zones-for-freelancers", label: "Time Zones for Freelancers" },
  { slug: "global-customer-support-scheduling", label: "24/7 Global Customer Support" },
  { slug: "stock-market-opening-times", label: "Global Stock Market Opening Times" },
];

const developerSitemap: SitemapItem[] = [
  { slug: "handling-time-zones-javascript", label: "Time Zones in JavaScript" },
  { slug: "time-zones-in-python", label: "Time Zones in Python" },
  { slug: "php-datetime-guide", label: "PHP DateTime Guide" },
  { slug: "java-time-api", label: "Java Time API Guide" },
  { slug: "time-zone-database-iana", label: "IANA Time Zone Database" },
];

const sitePages: SitemapItem[] = [
  { slug: "about-us", label: "About Us" },
  { slug: "editorial-policy", label: "Editorial Policy" },
  { slug: "author", label: "Author" },
  { slug: "contact-us", label: "Contact Us" },
  { slug: "privacy-policy", label: "Privacy Policy" },
  { slug: "terms-of-service", label: "Terms of Service" },
  { slug: "disclaimer", label: "Disclaimer" },
  { slug: "sitemap", label: "Sitemap" },
  { slug: "blog", label: "Blog" },
];

const blogPosts = (await getCollection("blog"))
  .filter((post) => post.id.startsWith("en/"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map((post) => ({
    slug: `blog/${post.id.split("/").slice(1).join("/")}`,
    label: post.data.title,
  }));

const groups = [
  { title: "Core pages", items: corePages },
  { title: "GMT to time zone converters", items: gmtConverters },
  { title: "Time zone to EST converters", items: estConverters },
  { title: "Interactive tools & utilities", items: toolsSitemap },
  { title: "Time zone guides & science", items: educationalSitemap },
  { title: "Daylight saving time center", items: dstSitemap },
  { title: "Country time zone guides", items: countrySitemap },
  { title: "City clocks & local time", items: citySitemap },
  { title: "Business & global scheduling", items: businessSitemap },
  { title: "Developer resources & time APIs", items: developerSitemap },
  { title: "Company & site pages", items: sitePages },
  { title: "Blog posts", items: blogPosts },
].filter((group) => group.items.length);

const allBlogPosts = await getCollection("blog");

function getLocalizedLabel(item: SitemapItem, languageCode: string): string {
  const p = pages.find((page) => page.slug === item.slug);
  if (p) {
    const disp = getConverterDisplayName(p, languageCode);
    if (disp) return disp;
    const meta = getPageMeta(languageCode, p.labelKey, p.context);
    if (meta?.title) return meta.title;
  }
  if (item.slug.startsWith("blog/")) {
    const blogSlug = item.slug.replace("blog/", "");
    const post = allBlogPosts.find((b) => b.id === `${languageCode}/${blogSlug}.md` || b.id === `${languageCode}/${blogSlug}.mdx` || b.id === `${languageCode}/${blogSlug}`);
    if (post?.data?.title) return post.data.title;
  }
  if (item.slug === "about-us") return languageCode === "tr" ? "Hakkımızda" : languageCode === "fr" ? "À propos" : languageCode === "de" ? "Über uns" : languageCode === "es" ? "Sobre nosotros" : languageCode === "it" ? "Chi siamo" : languageCode === "nl" ? "Over ons" : "About Us";
  if (item.slug === "author") return languageCode === "tr" ? "Yazarlar ve Editör Ekibi" : languageCode === "fr" ? "Équipe éditoriale et auteurs" : languageCode === "de" ? "Autorenteam" : languageCode === "es" ? "Autor" : languageCode === "it" ? "Team editoriale e autori" : languageCode === "nl" ? "Redactieteam en auteurs" : "Author";
  if (item.slug === "contact-us") return languageCode === "tr" ? "İletişim" : languageCode === "fr" ? "Contactez-nous" : languageCode === "de" ? "Kontakt" : languageCode === "es" ? "Contacto" : languageCode === "it" ? "Contattaci" : languageCode === "nl" ? "Contact opnemen" : languageCode === "th" ? "ติดต่อเรา" : "Contact Us";
  if (item.slug === "privacy-policy") return languageCode === "tr" ? "Gizlilik Politikası" : languageCode === "fr" ? "Politique de confidentialité" : languageCode === "de" ? "Datenschutzerklärung" : languageCode === "es" ? "Política de privacidad" : languageCode === "it" ? "Informativa sulla privacy" : languageCode === "nl" ? "Privacybeleid" : "Privacy Policy";
  if (item.slug === "terms-of-service") return languageCode === "tr" ? "Kullanım Koşulları" : languageCode === "fr" ? "Conditions d'utilisation" : languageCode === "de" ? "Nutzungsbedingungen" : languageCode === "es" ? "Términos del servicio" : languageCode === "it" ? "Termini di servizio" : languageCode === "nl" ? "Algemene voorwaarden" : languageCode === "ja" ? "利用規約" : "Terms of Service";
  if (item.slug === "disclaimer") return languageCode === "tr" ? "Sorumluluk Reddi" : languageCode === "fr" ? "Avis de non-responsabilité" : languageCode === "de" ? "Haftungsausschluss" : languageCode === "es" ? "Descargo de responsabilidad" : languageCode === "it" ? "Dichiarazione di non responsabilità" : languageCode === "nl" ? "Disclaimer" : "Disclaimer";
  if (item.slug === "sitemap") return languageCode === "tr" ? "Site Haritası" : languageCode === "fr" ? "Plan du site" : languageCode === "de" ? "Sitemap" : languageCode === "es" ? "Mapa del sitio" : languageCode === "it" ? "Mappa del sito" : languageCode === "nl" ? "Sitemap" : "Sitemap";
  if (item.slug === "blog") return languageCode === "fr" ? "Blog" : languageCode === "de" ? "Blog & Ratgeber" : languageCode === "nl" ? "Blog & gidsen" : "Blog";
  return item.label;
}

function getGroupTitle(title: string, languageCode: string): string {
  if (languageCode === "tr") {
    switch (title) {
      case "Core pages": return "Ana Sayfalar";
      case "GMT to time zone converters": return "GMT Saat Dilimi Dönüştürücüleri";
      case "Time zone to EST converters": return "EST Saat Dilimi Dönüştürücüleri";
      case "Interactive tools & utilities": return "Etkileşimli Saat Araçları ve Hesaplayıcılar";
      case "Time zone guides & science": return "Saat Dilimi Rehberleri";
      case "Daylight saving time center": return "Yaz Saati Uygulaması Merkezi";
      case "Country time zone guides": return "Ülke Saat Dilimleri";
      case "City clocks & local time": return "Şehir Saatleri ve Yerel Zaman";
      case "Business & global scheduling": return "İş Dünyası ve Küresel Planlama";
      case "Developer resources & time APIs": return "Geliştirici Kaynakları ve API'ler";
      case "Company & site pages": return "Kurumsal ve Yasal Sayfalar";
      case "Blog posts": return "Blog Yazıları";
      default: return title;
    }
  }
  if (languageCode === "nl") {
    switch (title) {
      case "Core pages": return "Hoofdpagina's";
      case "GMT to time zone converters": return "GMT-omrekenaars";
      case "Time zone to EST converters": return "EST-omrekenaars";
      case "Interactive tools & utilities": return "Interactieve tools & calculators";
      case "Time zone guides & science": return "Tijdzonegidsen & achtergrond";
      case "Daylight saving time center": return "Zomertijdgidsen & regels";
      case "Country time zone guides": return "Tijdzones per land";
      case "City clocks & local time": return "Stadsklokken & lokale tijd";
      case "Business & global scheduling": return "Zakelijke planning & internationale meetings";
      case "Developer resources & time APIs": return "Ontwikkelaarsbronnen & tijd-API's";
      case "Company & site pages": return "Bedrijfs- en juridische pagina's";
      case "Blog posts": return "Blogartikelen";
      default: return title;
    }
  }
  if (languageCode === "fr") {
    switch (title) {
      case "Core pages": return "Pages principales";
      case "GMT to time zone converters": return "Convertisseurs GMT vers fuseaux mondiaux";
      case "Time zone to EST converters": return "Convertisseurs fuseaux vers heure de l'Est";
      case "Interactive tools & utilities": return "Outils et calculateurs interactifs";
      case "Time zone guides & science": return "Guides et culture des fuseaux horaires";
      case "Daylight saving time center": return "Changements d'heure et heure d'été";
      case "Country time zone guides": return "Guides des fuseaux par pays";
      case "City clocks & local time": return "Heures locales des grandes villes";
      case "Business & global scheduling": return "Planification professionnelle internationale";
      case "Developer resources & time APIs": return "Ressources et outils pour développeurs";
      case "Company & site pages": return "Pages institutionnelles et légales";
      case "Blog posts": return "Articles de blog";
      default: return title;
    }
  }
  if (languageCode === "it") {
    switch (title) {
      case "Core pages": return "Pagine principali";
      case "GMT to time zone converters": return "Convertitori da GMT a fusi orari mondiali";
      case "Time zone to EST converters": return "Convertitori da fusi orari a Eastern Time";
      case "Interactive tools & utilities": return "Strumenti e calcolatori interattivi";
      case "Time zone guides & science": return "Guide e cultura dei fusi orari";
      case "Daylight saving time center": return "Ora legale e cambi di orario";
      case "Country time zone guides": return "Guide ai fusi orari per paese";
      case "City clocks & local time": return "Orologi locali delle grandi città";
      case "Business & global scheduling": return "Pianificazione aziendale internazionale";
      case "Developer resources & time APIs": return "Risorse e strumenti per sviluppatori";
      case "Company & site pages": return "Pagine aziendali e legali";
      case "Blog posts": return "Articoli del blog";
      default: return title;
    }
  }
  if (languageCode === "de") {
    switch (title) {
      case "Core pages": return "Hauptseiten";
      case "GMT to time zone converters": return "GMT-Umrechner";
      case "Time zone to EST converters": return "EST-Umrechner";
      case "Interactive tools & utilities": return "Interaktive Werkzeuge";
      case "Time zone guides & science": return "Zeitzonen-Ratgeber";
      case "Daylight saving time center": return "Sommerzeit-Zentrum";
      case "Country time zone guides": return "Länder-Zeitzonen";
      case "City clocks & local time": return "Städteuhren & Ortszeit";
      case "Business & global scheduling": return "Business & Terminplanung";
      case "Developer resources & time APIs": return "Entwickler-Ressourcen";
      case "Company & site pages": return "Unternehmensseiten";
      case "Blog posts": return "Blogbeiträge";
      default: return title;
    }
  }
  return title;
}

const englishOnlySlugs = new Set([
  ...educationalSitemap.map((item) => item.slug),
  ...dstSitemap.map((item) => item.slug),
  ...countrySitemap.map((item) => item.slug),
  ...citySitemap.map((item) => item.slug),
  ...businessSitemap.map((item) => item.slug),
  ...developerSitemap.map((item) => item.slug),
  "dst-calendar-tool",
  "workday-calculator",
  "time-zone-map",
  "travel-time-planner",
  "widgets",
  "downloads",
  "editorial-policy"
]);

const isAvailableForLanguage = (item: SitemapItem, languageCode: string) => {
  if (languageCode === "en") return true;
  if (englishOnlySlugs.has(item.slug)) return false;
  if (item.slug === "blog") {
    return allBlogPosts.some((b) => b.id.startsWith(`${languageCode}/`));
  }
  if (item.slug.startsWith("blog/")) {
    const blogSlug = item.slug.replace("blog/", "");
    return allBlogPosts.some((b) => b.id.startsWith(`${languageCode}/${blogSlug}`));
  }
  return true;
};

const isTrLocale = lang === "tr";
const displayedLanguages = isTrLocale ? languages.filter((l) => l.code === "tr") : languages;
const turkishUrlCount = groups.reduce((sum, group) => sum + group.items.filter((item) => isAvailableForLanguage(item, "tr")).length, 0);

const totalUrls = languages.reduce(
  (total, language) =>
    total + groups.reduce(
      (sum, group) => sum + group.items.filter((item) => isAvailableForLanguage(item, language.code)).length,
      0
    ),
  0
);
---

<div class="html-sitemap">
  <p class="sitemap-summary">
    {isTrLocale ? (
      <>Bu site haritası, GMT - EST Dönüştürücü üzerindeki tüm Türkçe sayfaları ve araçları listeler. Genel bakış, {turkishUrlCount} dahili Türkçe URL'yi içerir.</>
    ) : lang === "nl" ? (
      <>Deze sitemap bevat alle openbare pagina's en taalversies van de GMT naar EST Omrekenaar. Het overzicht omvat {totalUrls} interne URL's in {languages.length} talen.</>
    ) : lang === "de" ? (
      <>Diese Sitemap verlinkt die öffentlichen Seiten und Sprachversionen auf dem GMT zu EST Umrechner. Sie umfasst {totalUrls} interne URLs in {languages.length} Sprachen.</>
    ) : lang === "fr" ? (
      <>Ce plan du site répertorie l'ensemble des pages publiques et versions linguistiques disponibles sur le Convertisseur GMT vers EST. Il comprend {totalUrls} URLs internes réparties en {languages.length} langues.</>
    ) : lang === "it" ? (
      <>Questa mappa del sito elenca tutte le pagine pubbliche e le versioni linguistiche disponibili su Convertitore da GMT a EST. Include {totalUrls} URL interni suddivisi in {languages.length} lingue.</>
    ) : (
      <>This sitemap links the public pages and language versions on GMT to EST Converter. It includes {totalUrls} internal URLs across {languages.length} languages.</>
    )}
  </p>

  {!isTrLocale && (
  <nav class="language-jump" aria-label="Sitemap language sections">
    {languages.map((language) => (
      <a href={`#sitemap-${language.code}`} class={language.code === lang ? "active" : ""}>
        {language.code.toUpperCase()}
      </a>
    ))}
  </nav>
  )}

  {displayedLanguages.map((language) => (
    <section class="sitemap-language" id={`sitemap-${language.code}`} aria-labelledby={`sitemap-${language.code}-heading`}>
      <h2 id={`sitemap-${language.code}-heading`}>{language.name}</h2>
      {groups.filter((group) => group.items.some((item) => isAvailableForLanguage(item, language.code))).map((group) => (
        <section class="sitemap-group" aria-labelledby={`sitemap-${language.code}-${group.title.toLowerCase().replaceAll(" ", "-")}`}>
          <h3 id={`sitemap-${language.code}-${group.title.toLowerCase().replaceAll(" ", "-")}`}>{getGroupTitle(group.title, language.code)}</h3>
          <ul>
            {group.items
              .filter((item) => isAvailableForLanguage(item, language.code))
              .map((item) => (
              <li>
                <a href={pageUrl(language.code, item.slug)} hreflang={language.code}>
                  {getLocalizedLabel(item, language.code)}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </section>
  ))}
</div>

<style>
  .html-sitemap {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .sitemap-summary {
    margin: 0;
    max-width: 72ch;
    color: var(--muted);
    line-height: 1.7;
  }

  .language-jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .language-jump a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 3rem;
    min-height: 2.25rem;
    padding: 0.35rem 0.65rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    color: var(--accent);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .language-jump a.active,
  .language-jump a:hover {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }

  .sitemap-language {
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .sitemap-language h2 {
    margin: 0 0 1.25rem;
  }

  .sitemap-group {
    margin: 0 0 1.75rem;
  }

  .sitemap-group h3 {
    margin: 0 0 0.75rem;
    font-size: 1rem;
  }

  .sitemap-group ul {
    columns: 3 14rem;
    column-gap: 2rem;
    margin: 0;
    padding-left: 1.25rem;
  }

  .sitemap-group li {
    break-inside: avoid;
    margin: 0 0 0.45rem;
    line-height: 1.35;
  }

  .sitemap-group a {
    color: var(--accent);
    text-decoration: none;
  }

  .sitemap-group a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 640px) {
    .sitemap-group ul {
      columns: 1;
    }
  }
</style>
