---
import { getUsersAlsoVisit } from "theme/i18n/clusters";

type Props = {
  slug: string;
  lang?: string;
};

const { slug, lang = "en" } = Astro.props;
const items = getUsersAlsoVisit(slug, lang);
---

<section class="users-also-visit-widget content-section" aria-labelledby="users-visit-heading">
  <h3 id="users-visit-heading" class="widget-title">Users Also Visit</h3>
  <div class="chip-grid">
    {items.map((item) => (
      <a href={item.href} class="chip-link">
        <span class="chip-icon">⇄</span>
        <span>{item.label}</span>
      </a>
    ))}
  </div>
</section>

<style>
  .users-also-visit-widget {
    margin: 2rem 0;
    padding: 1.5rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--line);
    border-radius: 10px;
  }

  .widget-title {
    font-size: 1.1rem;
    margin: 0 0 1rem;
    font-family: 'Space Grotesk', sans-serif;
    color: var(--text);
  }

  .chip-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .chip-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 20px;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    transition: all 0.2s ease;
  }

  .chip-link:hover {
    color: var(--accent);
    border-color: var(--accent);
    transform: translateY(-1px);
  }

  .chip-icon {
    color: var(--accent);
    font-weight: bold;
  }
</style>
