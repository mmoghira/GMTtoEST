---
import Converter from "theme/components/Converter.astro";
import VisualLab from "theme/components/VisualLab.astro";
import { pageUrl } from "theme/i18n/config";
import { ensureKeywordInAlt, getPrimaryKeyword } from "theme/utils/seo";

const { title, description, kind, t, context, lang = "en", primaryKeyword, meta = {} } = Astro.props;
const lead = kind === "difference" ? t.hero.differenceLead : kind === "guide" ? t.hero.guideLead : description;
const seoKeyword = kind === "converter" && lang === "en" ? "GMT to EST Converter" : title;
const clocksTitle = `${seoKeyword} Live Clocks`;
const keyword = getPrimaryKeyword(primaryKeyword || seoKeyword, seoKeyword);
const heroAlt = ensureKeywordInAlt(t.images.heroAlt, keyword, `${keyword} featured image`);
const clockAlt = ensureKeywordInAlt(t.images.clockAlt, keyword, `${keyword} clock comparison image`);
const mapAlt = ensureKeywordInAlt(t.images.mapAlt, keyword, `${keyword} world time map image`);
const keywordIntroRest = "gives instant, date-aware conversion between GMT and Eastern Time with DST handling, live clocks, and a full comparison chart.";
const showArticleMeta = kind === "converter" && lang === "en" && !!meta?.pubDate;
const formatHomeDate = (value?: string) => {
  if (!value) return "";
  const datePart = value.slice(0, 10);
  return new Intl.DateTimeFormat("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  }).format(new Date(`${datePart}T00:00:00Z`));
};
const publishedDateLabel = formatHomeDate(meta?.pubDate);
const updatedDateLabel = formatHomeDate(meta?.updatedDate || meta?.pubDate);
const tocItems = [
  { href: "#converter", label: "GMT to EST Converter" },
  { href: "#visual-lab", label: t.visual.title },
  { href: "#live-clocks", label: t.clocks.title },
  { href: "#quick-presets", label: t.presets.title },
  { href: "#other-tools", label: "More time zone conversions" },
  { href: "#chart", label: t.chart.title },
  { href: "#strip", label: t.strip.title },
  { href: "#uses", label: t.useCases.title },
  { href: "#topics", label: t.topics.title },
  { href: "#faq", label: t.faqs.title },
];

const gmtList = ["ACDT","ACST","ADT","AEDT","AEST","AKDT","AKST","AST","AWST","BST","CAT","CDT","CEST","CET","ChST","CST","EAT","EDT","EEST","EET","EST","HDT","HKT","HST","IDT","IST","JST","KST","MDT","MEST","MET","MSK","MST","NDT","NST","NZDT","NZST","PDT","PKT","PST","SAST","SST","UTC","WAT","WEST","WET","WIB","WIT","WITA"];
const estList = ["ACDT","ACST","ADT","AEDT","AEST","AKDT","AKST","AST","AWST","BST","CAT","CDT","CEST","CET","ChST","CST","EAT","EDT","EEST","EET","GMT","HDT","HKT","HST","IDT","IST","JST","KST","MDT","MEST","MET","MSK","MST","NDT","NST","NZDT","NZST","PDT","PKT","PST","SAST","SST","UTC","WAT","WEST","WET","WIB","WIT","WITA"];
const chunk = (items: string[], size = 13) => Array.from({ length: Math.ceil(items.length / size) }, (_, index) => items.slice(index * size, index * size + size));
---

<section class="hero-banner">
  <h1 class="hero-banner-title">
    {title.split(' ').slice(0, -1).join(' ')}{' '}
    <span class="gradient-text">{title.split(' ').slice(-1)[0]}</span>
  </h1>
</section>

<p class="seo-keyword-intro"><strong>{seoKeyword}</strong> {keywordIntroRest}</p>

<section class="hero">
  <div class="hero-copy">
    <p class="eyebrow">{t.hero.eyebrow}</p>
    <p>{lead}</p>
    <figure class="hero-visual reveal">
      <picture>
        <source type="image/avif" srcset="/assets/gmt-to-est-converter-featured-image-480.avif 480w, /assets/gmt-to-est-converter-featured-image-960.avif 960w" sizes="(max-width: 720px) 92vw, 960px" />
        <source type="image/webp" srcset="/assets/gmt-to-est-converter-featured-image-480.webp 480w, /assets/gmt-to-est-converter-featured-image-960.webp 960w" sizes="(max-width: 720px) 92vw, 960px" />
        <img width="960" height="420" src="/assets/gmt-to-est-converter-featured-image.svg" alt={heroAlt} fetchpriority="high" loading="eager" decoding="async" />
      </picture>
    </figure>
  </div>
  <Converter intent={kind} t={t} context={context} />
</section>

{showArticleMeta && (
  <section class="home-meta" aria-label="Publication details">
    <p class="post-meta home-meta__line">
      <span>Published</span>
      <time datetime={meta.pubDate} itemprop="datePublished">{publishedDateLabel}</time>
      <span aria-hidden="true">|</span>
      <span>Last updated</span>
      <time datetime={meta.updatedDate || meta.pubDate} itemprop="dateModified">{updatedDateLabel}</time>
    </p>
  </section>
)}

{showArticleMeta && (
  <nav class="table-of-contents" aria-labelledby="table-of-contents">
    <p class="toc-kicker">Navigation aid</p>
    <h2 id="table-of-contents">Table of Contents</h2>
    <ol>
      {tocItems.map((item) => (
        <li><a href={item.href}>{item.label}</a></li>
      ))}
    </ol>
  </nav>
)}

<VisualLab t={t} keywordHeading={seoKeyword} />

<section class="clock-grid" aria-labelledby="live-clocks">
  <h2 id="live-clocks">{clocksTitle}</h2>
  <div class="clock-card"><span>{t.clocks.gmt}</span><strong id="gmtClock">--:--</strong></div>
  <div class="clock-card"><span>{t.clocks.eastern}</span><strong id="estClock">--:--</strong><em id="estZone">EST</em></div>
</section>

<section class="band" id="quick-presets">
  <div>
    <h2>{seoKeyword} Quick Presets</h2>
    <div class="preset-row">
      <button type="button" data-preset="meeting">{t.presets.meeting}</button>
      <button type="button" data-preset="event">{t.presets.event}</button>
      <button type="button" data-preset="trading">{t.presets.trading}</button>
    </div>
  </div>
  <picture>
    <source type="image/avif" srcset="/assets/gmt-to-est-converter-clock-visual-450.avif 450w, /assets/gmt-to-est-converter-clock-visual-900.avif 900w" sizes="(max-width: 720px) 92vw, 900px" />
    <source type="image/webp" srcset="/assets/gmt-to-est-converter-clock-visual-450.webp 450w, /assets/gmt-to-est-converter-clock-visual-900.webp 900w" sizes="(max-width: 720px) 92vw, 900px" />
    <img loading="lazy" decoding="async" width="900" height="380" src="/assets/gmt-to-est-converter-clock-visual.svg" alt={clockAlt} />
  </picture>
</section>

<section class="other-tools" aria-labelledby="other-tools">
  <h2 id="other-tools">{seoKeyword} More Time Zone Conversions</h2>
  <div class="tools-grid">
    <div class="tools-list">
      <h3>{seoKeyword} GMT To Other Time Zones</h3>
      <div class="tools-link-groups">
        {chunk(gmtList).map(group => (
          <ul>
            {group.map(tz => <li><a href={pageUrl(lang || "en", `gmt-to-${tz.toLowerCase()}`)}>GMT to {tz}</a></li>)}
          </ul>
        ))}
      </div>
    </div>
    <div class="tools-list">
      <h3>{seoKeyword} EST To Other Time Zones</h3>
      <div class="tools-link-groups">
        {chunk(estList).map(group => (
          <ul>
            {group.map(tz => <li><a href={pageUrl(lang || "en", `${tz.toLowerCase()}-to-est`)}>{tz} to EST</a></li>)}
          </ul>
        ))}
      </div>
    </div>
  </div>
</section>

<section aria-labelledby="chart">
  <h2 id="chart">{seoKeyword} Chart</h2>
  <div class="table-wrap"><table id="timeTable"><thead><tr><th>GMT</th><th>{t.chart.eastern}</th><th>{t.chart.offset}</th></tr></thead><tbody></tbody></table></div>
</section>

<section aria-labelledby="strip">
  <h2 id="strip">{seoKeyword} Workday Overlap</h2>
  <div class="time-strip" id="timeStrip" aria-label={t.strip.aria}></div>
</section>

<section class="use-cases" aria-labelledby="uses">
  <h2 id="uses">{seoKeyword} Use Cases</h2>
  {t.useCases.items.map((item) => (
    <article><h3>{item.title}</h3><p>{item.text}</p></article>
  ))}
</section>

<section class="content" aria-labelledby="topics">
  <h2 id="topics">{seoKeyword} Time Zone Authority</h2>
  {t.topics.items.map((topic) => (
    <article>
      <h3>{topic.title}</h3>
      <p>{topic.text}</p>
    </article>
  ))}
</section>

<section class="faq" aria-labelledby="faq">
  <h2 id="faq">{seoKeyword} FAQs</h2>
  {t.faqs.items.map((item) => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}
</section>

<figure class="map">
  <picture>
    <source type="image/avif" srcset="/assets/gmt-to-est-converter-world-time-map-600.avif 600w, /assets/gmt-to-est-converter-world-time-map-1200.avif 1200w" sizes="(max-width: 720px) 92vw, 1200px" />
    <source type="image/webp" srcset="/assets/gmt-to-est-converter-world-time-map-600.webp 600w, /assets/gmt-to-est-converter-world-time-map-1200.webp 1200w" sizes="(max-width: 720px) 92vw, 1200px" />
    <img loading="lazy" decoding="async" width="1200" height="520" src="/assets/gmt-to-est-converter-world-time-map.svg" alt={mapAlt} />
  </picture>
</figure>
