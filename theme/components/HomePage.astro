          <ul style="line-height: 1.7; color: var(--text-muted); padding-left: 1.25rem;">
            <li>{isFr ? "Vérifiez toujours si l'une des villes applique l'heure d'été (DST) à la date prévue de l'événement." : "Always check whether daylight saving time is active at the planned date."}</li>
            <li>{isFr ? "Faites attention au passage de la date (changement de jour lors du franchissement de minuit)." : "Be mindful of date rollover when crossing midnight."}</li>
            <li>{isFr ? "Utilisez le format 24 heures pour éliminer toute ambiguïté entre matin (AM) et après-midi (PM)." : "Use 24-hour military time to avoid AM/PM confusion."}</li>
          </ul>
        </article>
      </section>
    )}

    <section class="use-cases" aria-labelledby="uses">
      <h2 id="uses">{t.useCases?.title || (isFr ? "Cas d'usage pratiques" : "Use Cases")}</h2>
      {activeUseCases.map((item: any) => (
        <article><h3>{item.title}</h3><p>{item.text}</p></article>
      ))}
    </section>

    {activeTopics && activeTopics.length > 0 && (
      <section class="content" aria-labelledby="topics">
        <h2 id="topics">{t.topics?.title || (isFr ? "Repères essentiels" : "Key Topics")}</h2>
        {activeTopics.map((topic: any) => (
          <article>
            <h3>{topic.title}</h3>
            <p>{topic.text}</p>
          </article>
        ))}
      </section>
    )}

    <section class="faq" aria-labelledby="faq">
      <h2 id="faq">{t.faqs?.title || (isFr ? "Foire aux questions (FAQ)" : "FAQs")}</h2>
      {activeFaqs.map((item: any) => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}
    </section>

    <section class="other-tools" aria-labelledby="other-tools">
      <h2 id="other-tools">{isFr ? "Autres outils recommandés" : "Recommended Tools"}</h2>
      <div class="related-grid">
        <article class="related-card">
          <div class="related-card-title"><a href={pageUrl(lang, "")}>{isFr ? "Convertisseur GMT vers EST" : "GMT to EST Converter"}</a></div>
          <div class="related-card-text">{isFr ? "Convertissez l'heure GMT en direct vers l'heure de l'Est (EST/EDT) avec tableau 24 h." : "Convert GMT directly to Eastern Time."}</div>
        </article>
        <article class="related-card">
          <div class="related-card-title"><a href={pageUrl(lang, "world-clock")}>{isFr ? "Horloge mondiale" : "World Clock"}</a></div>
          <div class="related-card-text">{isFr ? "Consultez l'heure actuelle dans plus de 200 métropoles mondiales." : "Live time in 200+ cities worldwide."}</div>
        </article>
        <article class="related-card">
          <div class="related-card-title"><a href={pageUrl(lang, "time-zone-guide")}>{isFr ? "Guide des fuseaux horaires" : "Time Zone Guide"}</a></div>
          <div class="related-card-text">{isFr ? "Comprenez le fonctionnement de l'UTC, du GMT, de l'EST et des décalages d'heure d'été." : "Learn the fundamentals of UTC, GMT and DST."}</div>
        </article>
      </div>
    </section>
  </>
)}
