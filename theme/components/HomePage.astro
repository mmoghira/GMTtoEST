function formatChartHour(hour: number, currentLang = "en") {
  const normalized = ((hour % 24) + 24) % 24;
  if (currentLang === "es" || currentLang === "de" || currentLang === "fr" || currentLang === "it" || currentLang === "pt" || currentLang === "pl") {
    return `${String(normalized).padStart(2, "0")}:00`;
  }
  const period = normalized < 12 ? "AM" : "PM";
  const displayHour = normalized % 12 || 12;
  return `${String(displayHour).padStart(2, "0")}:00 ${period}`;
}

function easternChartValue(gmtHour: number, offset: number, label: string, currentLang = "en") {
  const easternHour = gmtHour + offset;
  const prevDayText = currentLang === "de" ? " (Vortag)" : currentLang === "es" ? " (día anterior)" : currentLang === "fr" ? " (jour précédent)" : currentLang === "it" ? " (giorno precedente)" : currentLang === "pt" ? " (dia anterior)" : currentLang === "pl" ? " (poprzedni dzień)" : " (prev day)";
  return `${formatChartHour(easternHour, currentLang)} ${label}${easternHour < 0 ? prevDayText : ""}`;
}

function gmtFromEasternChartValue(easternHour: number, offset: number, label: string, currentLang = "en") {
  const gmtHour = easternHour + offset;
  const nextDayText = currentLang === "de" ? " (Folgetag)" : currentLang === "es" ? " (día siguiente)" : currentLang === "fr" ? " (jour suivant)" : currentLang === "it" ? " (giorno successivo)" : currentLang === "pt" ? " (dia seguinte)" : currentLang === "pl" ? " (następny dzień)" : " (next day)";
  return `${formatChartHour(gmtHour, currentLang)} ${label}${gmtHour >= 24 ? nextDayText : ""}`;
}

const gmtEstChartRows = Array.from({ length: 24 }, (_, hour) => ({
  gmt: `${String(hour).padStart(2, "0")}:00 GMT`,
  eastern: `${easternChartValue(hour, -5, "EST", lang)} / ${easternChartValue(hour, -4, "EDT", lang)}`,
  offset: "UTC−5 / UTC−4",
}));

const estGmtChartRows = Array.from({ length: 24 }, (_, hour) => ({
  eastern: `${formatChartHour(hour, lang)} EST/EDT`,
  gmt: `${gmtFromEasternChartValue(hour, 5, "GMT", lang)} / ${gmtFromEasternChartValue(hour, 4, "GMT", lang)}`,
  offset: "UTC+5 (EST) / UTC+4 (EDT)",
}));
