---
import Converter from "theme/components/Converter.astro";
import VisualLab from "theme/components/VisualLab.astro";
import { dynamicConvertersEnabled, pageUrl, replaceTemplates } from "theme/i18n/config";
import { ensureKeywordInAlt, getPrimaryKeyword } from "theme/utils/seo";

const { labelKey = "home", title, description, kind, t, context, lang = "en", primaryKeyword, meta = {} } = Astro.props;

const from = context?.from || "GMT";
const to = context?.to || "EST";
const fromZone = context?.fromZone || "UTC";
const toZone = context?.toZone || "America/New_York";
const replacements = { from, to, fromZone, toZone, source: from, target: to };

const activeKey = labelKey || kind;

// Resolve page-specific arrays and text blocks with safe template interpolation
const rawFaqs = meta.faqs || t[`faqs_${activeKey}`]?.items || t[`faqs_${kind}`]?.items || t.faqs_dynamic || t.faqs?.items || [];
const rawUseCases = meta.useCases || t[`useCases_${activeKey}`]?.items || t[`useCases_${kind}`]?.items || t.useCases_dynamic || t.useCases?.items || [];
const rawTopics = meta.topics || t[`topics_${activeKey}`]?.items || t[`topics_${kind}`]?.items || t.topics_dynamic || t.topics?.items || [];

const activeFaqs = rawFaqs.map((item: any) => ({
  q: replaceTemplates(item.q, replacements),
  a: replaceTemplates(item.a, replacements)
}));
const activeUseCases = rawUseCases.map((item: any) => ({
  title: replaceTemplates(item.title, replacements),
  text: replaceTemplates(item.text, replacements)
}));
const activeTopics = rawTopics.map((topic: any) => ({
  title: replaceTemplates(topic.title, replacements),
  text: replaceTemplates(topic.text, replacements)
}));

const pageH1 = replaceTemplates(meta.h1 || t.pages[labelKey]?.h1 || title || t.pages[labelKey]?.title || "GMT to EST Converter", replacements);

const isEs = lang === "es";
const isDe = lang === "de";
const isFr = lang === "fr";
const isIt = lang === "it";

const pageIntro = replaceTemplates(t[`intro_${activeKey}`] || t[`intro_${kind}`] || description, replacements);
const pageExplanation = replaceTemplates(t[`explanation_${activeKey}`] || t[`explanation_${kind}`] || "", replacements);
const pageConclusion = replaceTemplates(t[`conclusion_${activeKey}`] || t[`conclusion_${kind}`] || "", replacements);
const pageCTA = replaceTemplates(t[`cta_${activeKey}`] || t[`cta_${kind}`] || "", replacements);

const explanationHeadingMap = {
  difference: isDe ? "Analyse des Zeitunterschieds zwischen GMT und EST" : isEs ? "Análisis de la diferencia horaria" : isFr ? "Analyse du décalage horaire entre GMT et EST" : "Analyzing the Time Gap",
  reverse: isDe ? "So funktioniert die Umrechnung von EST in GMT" : isEs ? "Cómo funciona la conversión inversa" : isFr ? "Comment fonctionne la conversion inverse EST vers GMT" : "How the Reverse Calculation Works",
  guide: isDe ? "Historische Entwicklung und Zeitzonen-Standards" : isEs ? "Evolución histórica y estándares" : isFr ? "Évolution historique et normes de fuseaux horaires" : "Evolution of Global Time Standards",
  dynamic: isDe ? "Uhrzeit zwischen {from} und {to} berechnen" : isEs ? "Cómo calcular la hora entre {from} y {to}" : isFr ? "Calculer l'heure entre {from} et {to}" : "Calculating Time Between {from} and {to}"
};
const pageExplanationHeading = isDe
  ? replaceTemplates(explanationHeadingMap[kind] || "Verständnis des Zeitunterschieds", replacements)
  : isEs
    ? replaceTemplates(explanationHeadingMap[kind] || "Entendiendo la diferencia horaria", replacements)
    : isFr
      ? replaceTemplates(explanationHeadingMap[kind] || "Comprendre le décalage horaire", replacements)
      : `${title}: ${replaceTemplates(explanationHeadingMap[kind] || "Understanding the timezone difference", replacements)}`;

const conclusionHeadingMap = {
  converter: isDe ? "Zusammenfassung & Nächste Schritte" : isEs ? "Conclusión y Siguiente Paso" : isFr ? "Résumé rapide et prochaines étapes" : "Quick Summary & Next Steps",
  difference: isDe ? "Wichtigste Erkenntnisse zum Zeitunterschied" : isEs ? "Resumen de la Diferencia" : isFr ? "Points clés sur le décalage horaire" : "Key Takeaways on Time Differences",
  reverse: isDe ? "Zusammenfassung der Rückrechnung" : isEs ? "Resumen de Conversión Inversa" : isFr ? "Bilan sur la conversion inverse" : "Final Thoughts on Reverse Scheduling",
  guide: isDe ? "Zusammenfassung der Zeitzonen-Grundlagen" : isEs ? "Resumen del Aprendizaje" : isFr ? "Synthèse des normes horaires" : "Time Standards Wrap-Up",
  dynamic: isDe ? "Zusammenfassung der Umrechnung von {from} in {to}" : isEs ? "Resumen de {from} a {to}" : isFr ? "Résumé de la conversion de {from} vers {to}" : "Summary of {from} to {to} Conversion"
};
const pageConclusionHeading = replaceTemplates(conclusionHeadingMap[kind] || conclusionHeadingMap.converter, replacements);

// Custom SEO keyword & alt strings
const seoKeyword = kind === "converter"
  ? (lang === "en" ? "GMT to EST Converter" : isDe ? "GMT zu EST Umrechner" : isEs ? "Convertidor GMT a EST" : isFr ? "Convertisseur GMT vers EST" : isIt ? "Convertitore da GMT a EST" : title)
  : title;
const clocksTitle = isFr ? "Horloges en direct" : isDe ? "Live-Uhren" : isEs ? "Relojes en vivo" : isIt ? "Orologi in tempo reale" : `${seoKeyword} Live Clocks`;
const keyword = getPrimaryKeyword(primaryKeyword || seoKeyword, seoKeyword);
const heroAlt = ensureKeywordInAlt(t.images.heroAlt, keyword, `${keyword} featured image`);
const clockAlt = ensureKeywordInAlt(t.images.clockAlt, keyword, `${keyword} clock comparison image`);
const mapAlt = ensureKeywordInAlt(t.images.mapAlt, keyword, `${keyword} world time map image`);

const showArticleMeta = kind === "converter" && (lang === "en" || lang === "de") && !!meta?.pubDate;
const formatHomeDate = (value?: string) => {
  if (!value) return "";
  const datePart = value.slice(0, 10);
  return new Intl.DateTimeFormat(lang === "de" ? "de-DE" : "en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  }).format(new Date(`${datePart}T00:00:00Z`));
};
const publishedDateLabel = formatHomeDate(meta?.pubDate);
const updatedDateLabel = formatHomeDate(meta?.updatedDate || meta?.pubDate);

// Show editorial sections on homepage in English and German
const showEditorialSections = kind === "converter" && (lang === "en" || lang === "de" || lang === "fr" || lang === "it");

// TOC Items
const tocItems = [
  { href: "#converter", label: seoKeyword },
  ...(kind === "converter" ? [{ href: "#visual-lab", label: t.visual?.title || (isDe ? "Live-Zeitumrechnung" : "Visual Lab") }] : []),
  ...(showEditorialSections ? [
    { href: "#how-it-works", label: isDe ? "Berechnungsmethode" : isFr ? "Méthode de calcul" : isIt ? "Metodo di calcolo" : "How the conversion works" },
    { href: "#conversion-examples", label: isDe ? "Umrechnungsbeispiele" : isFr ? "Exemples de conversion" : isIt ? "Esempi di conversione" : "Conversion examples" },
    ...(isDe ? [{ href: "#deutschland-gmt-new-york", label: "Deutschland, GMT & New York" }] : isFr ? [{ href: "#france-gmt-new-york", label: "France, GMT et New York" }] : isIt ? [{ href: "#italia-gmt-new-york", label: "Italia, GMT e New York" }] : []),
    { href: "#source-notes", label: isDe ? "Quellen & Datenpflege" : isFr ? "Sources et méthodologie" : isIt ? "Fonti e metodologia" : "Sources and maintenance" },
  ] : []),
  ...(kind !== "guide" && kind !== "difference" && kind !== "reverse" ? [
    { href: "#live-clocks", label: t.clocks.title },
    { href: "#quick-presets", label: t.presets.title },
    { href: "#chart", label: t.chart.title },
    { href: "#strip", label: t.strip.title }
  ] : []),
  { href: "#uses", label: t.useCases.title },
  ...(activeTopics.length > 0 ? [{ href: "#topics", label: t.topics.title }] : []),
  { href: "#faq", label: t.faqs.title },
];

const relatedResourcesMap = {
  converter: isFr ? [
    { href: pageUrl(lang, "est-to-gmt"), title: "Convertisseur EST vers GMT", text: "Convertissez l'heure de l'Est (EST ou EDT) vers GMT instantanément avec horloges en direct." },
    { href: pageUrl(lang, "gmt-vs-est"), title: "Différence GMT vs EST", text: "Comparez GMT et l'heure de l'Est avec les décalages EST, EDT et le calendrier des changements d'heure." },
    { href: pageUrl(lang, "time-zone-guide"), title: "Guide des fuseaux horaires", text: "Guide pratique complet pour comprendre GMT, UTC, EST, EDT et l'heure d'été." }
  ] : isIt ? [
    { href: pageUrl(lang, "est-to-gmt"), title: "Convertitore da EST a GMT", text: "Converti l'orario della costa orientale (EST o EDT) in GMT all'istante con orologi in tempo reale." },
    { href: pageUrl(lang, "gmt-vs-est"), title: "Differenza tra GMT ed EST", text: "Confronta GMT ed Eastern Time con i relativi scarti orari EST/EDT e il calendario dell'ora legale." },
    { href: pageUrl(lang, "time-zone-guide"), title: "Guida ai fusi orari", text: "Guida pratica completa per comprendere GMT, UTC, EST, EDT e l'ora legale." }
  ] : [
    { href: pageUrl(lang || "en", "pdt-to-est"), title: isDe ? "PDT zu EST Umrechner" : lang === "es" ? "Convertidor PDT a EST" : "PDT to EST Converter", text: isDe ? "Zeitumrechner von der US-Westküste zur US-Ostküste." : lang === "es" ? "Calculadora de tiempo de la costa oeste a la costa este." : "West Coast to East Coast timezone calculator." },
    { href: pageUrl(lang || "en", "kst-to-est"), title: isDe ? "KST zu EST Umrechner" : lang === "es" ? "Convertidor KST a EST" : "KST to EST Converter", text: isDe ? "Zeitumrechner von Seoul nach New York." : lang === "es" ? "Conversor de Seúl a hora de Nueva York." : "Seoul to New York time converter." },
    { href: pageUrl(lang || "en", "cst-to-est"), title: isDe ? "CST zu EST Umrechner" : lang === "es" ? "Convertidor CST a EST" : "CST to EST Converter", text: isDe ? "Zeitzonenrechner von Central Time zu Eastern Time." : lang === "es" ? "Calculadora para la zona central y el este." : "Central to Eastern time calculator." }
  ],
  difference: isFr ? [
    { href: pageUrl(lang, "est-to-gmt"), title: "Convertisseur EST vers GMT", text: "Effectuez des conversions inverses de l'heure de l'Est vers le méridien de Greenwich." },
    { href: pageUrl(lang, "time-zone-guide"), title: "Guide des fuseaux horaires", text: "Consultez l'historique et les définitions officielles de GMT, UTC, EST et EDT." }
  ] : isIt ? [
    { href: pageUrl(lang, "est-to-gmt"), title: "Convertitore da EST a GMT", text: "Effettua conversioni inverse dall'Eastern Time al meridiano di Greenwich." },
    { href: pageUrl(lang, "time-zone-guide"), title: "Guida ai fusi orari", text: "Consulta la storia e le definizioni ufficiali di GMT, UTC, EST ed EDT." }
  ] : [
    { href: pageUrl(lang || "en", "est-to-gmt"), title: isDe ? "EST in GMT umrechnen" : lang === "es" ? "Calculadora inversa EST a GMT" : "EST to GMT Reverse Tool", text: isDe ? "Analysieren Sie den Zeitfluss von Eastern Time zu GMT." : lang === "es" ? "Analice el flujo inverso de la hora estándar del este a GMT." : "Analyze the reverse time flow from Eastern to GMT." },
    { href: pageUrl(lang || "en", "time-zone-guide"), title: isDe ? "Zeitzonen-Ratgeber" : lang === "es" ? "Guía completa de husos horarias" : "Global Timekeeping Guide", text: isDe ? "UTC, GMT Standards und Historie der Zeitzonen verstehen." : lang === "es" ? "Estudie los estándares UTC, GMT e historia del meridiano." : "Study UTC, GMT standards, and meridian history." }
  ],
  reverse: isFr ? [
    { href: pageUrl(lang, ""), title: "Convertisseur GMT vers EST", text: "Accédez au convertisseur principal de Greenwich vers l'heure de l'Est." },
    { href: pageUrl(lang, "gmt-vs-est"), title: "Différence GMT vs EST", text: "Analysez les règles de décalage horaire et les variations de l'heure d'été." }
  ] : isIt ? [
    { href: pageUrl(lang, ""), title: "Convertitore da GMT a EST", text: "Accedi al convertitore principale dal meridiano di Greenwich all'Eastern Time." },
    { href: pageUrl(lang, "gmt-vs-est"), title: "Differenza tra GMT ed EST", text: "Analizza le regole di scarto orario e le variazioni dovute all'ora legale." }
  ] : [
    { href: pageUrl(lang || "en", ""), title: isDe ? "GMT zu EST Umrechner" : lang === "es" ? "Convertidor principal GMT a EST" : "Direct GMT to EST Converter", text: isDe ? "Zurück zum Hauptumrechner von Greenwich zu Eastern Time." : lang === "es" ? "Regrese al convertidor principal de Greenwich a la hora del Este." : "Return to the main Greenwich to Eastern converter." },
    { href: pageUrl(lang || "en", "pdt-to-est"), title: isDe ? "PDT zu EST Umrechner" : lang === "es" ? "Calculadora de PDT a EST" : "PDT to EST Calculator", text: isDe ? "Zeitumrechner von Pazifischer Sommerzeit zu Eastern Time." : lang === "es" ? "Conversor de horario de verano del Pacífico a hora estándar del Este." : "Pacific Daylight to Eastern Standard time converter." }
  ],
  cdtToEst: [
    { href: pageUrl(lang || "en", "cst-to-est"), title: isDe ? "CST zu EST Umrechner" : lang === "es" ? "Convertidor CST a EST estándar" : "CST to EST Standard Calculator", text: isDe ? "Planen Sie für die Wintermonate mit Standardzeit." : lang === "es" ? "Planifique para los meses de invierno cuando rige el horario estándar." : "Plan for winter months when standard time is active." },
    { href: pageUrl(lang || "en", "mst-to-est"), title: isDe ? "MST zu EST Umrechner" : lang === "es" ? "Convertidor MST a EST de montaña" : "MST to EST Mountain Calculator", text: isDe ? "Vergleichen Sie Mountain Time in Denver mit Eastern Time." : lang === "es" ? "Compare la zona de montaña de Denver con la hora del este." : "Compare Denver Mountain time to Eastern time." }
  ],
  cstToEst: [
    { href: pageUrl(lang || "en", "cdt-to-est"), title: isDe ? "CDT zu EST Umrechner" : lang === "es" ? "Convertidor CDT a EST de verano" : "CDT to EST Summer Calculator", text: isDe ? "Planen Sie für die Sommerzeit zwischen Chicago und New York." : lang === "es" ? "Planifique para el horario de verano entre Chicago y Nueva York." : "Plan for daylight saving time between Chicago and New York." },
    { href: pageUrl(lang || "en", "pdt-to-est"), title: isDe ? "PDT zu EST Umrechner" : lang === "es" ? "Convertidor PDT a EST del Pacífico" : "PDT to EST Pacific Calculator", text: isDe ? "Berechnen Sie den Unterschied zwischen Pacific Time und Eastern Time." : lang === "es" ? "Calcule la diferencia del Pacífico con la hora del este." : "Calculate Pacific difference to Eastern time." }
  ],
  kstToEst: [
    { href: pageUrl(lang || "en", "ast-to-est"), title: isDe ? "AST zu EST Umrechner" : lang === "es" ? "Convertidor AST a EST del Atlántico" : "AST to EST Atlantic Calculator", text: isDe ? "Berechnen Sie die Zeit von Atlantic Time zur Ostküste." : lang === "es" ? "Calcule la hora desde el Atlántico a la costa este." : "Calculate time from Atlantic zone to East Coast." },
    { href: pageUrl(lang || "en", "pdt-to-est"), title: isDe ? "PDT zu EST Umrechner" : lang === "es" ? "Convertidor PDT a EST de California" : "PDT to EST California Calculator", text: isDe ? "Vergleichen Sie Westküsten- und Ostküstenzeiten in den USA." : lang === "es" ? "Compare la costa oeste con la costa este de EE. UU." : "Compare West Coast to East Coast times." }
  ],
  pdtToEst: [
    { href: pageUrl(lang || "en", "mst-to-est"), title: isDe ? "MST zu EST Umrechner" : lang === "es" ? "Convertidor MST a EST de montaña" : "MST to EST Mountain Calculator", text: isDe ? "Vergleichen Sie Denver und Phoenix mit New York Time." : lang === "es" ? "Compare Denver y Phoenix con la hora de Nueva York." : "Compare Denver and Phoenix with New York time." },
    { href: pageUrl(lang || "en", "cst-to-est"), title: isDe ? "CST zu EST Umrechner" : lang === "es" ? "Convertidor CST a EST de Chicago" : "CST to EST Chicago Calculator", text: isDe ? "Berechnen Sie die Zeit vom Mittleren Westen zur Ostküste." : lang === "es" ? "Calcule la hora del medio oeste a la costa este." : "Calculate Midwestern time to East Coast." }
  ],
  mstToEst: [
    { href: pageUrl(lang || "en", "pdt-to-est"), title: isDe ? "PDT zu EST Umrechner" : lang === "es" ? "Convertidor PDT a EST de California" : "PDT to EST California Calculator", text: isDe ? "Vergleichen Sie die Westküste mit der Ostküste der USA." : lang === "es" ? "Compare la costa oeste con la costa este de EE. UU." : "Compare West Coast to East Coast times." },
    { href: pageUrl(lang || "en", "ast-to-est"), title: isDe ? "AST zu EST Umrechner" : lang === "es" ? "Convertidor AST a EST del Atlántico" : "AST to EST Atlantic Calculator", text: isDe ? "Vergleichen Sie Atlantic Time mit Eastern Time." : lang === "es" ? "Compare el tiempo del Atlántico con la hora del este." : "Compare Atlantic time to Eastern time." }
  ],
  astToEst: [
    { href: pageUrl(lang || "en", "cdt-to-est"), title: isDe ? "CDT zu EST Umrechner" : lang === "es" ? "Convertidor CDT a EST de verano" : "CDT to EST Summer Calculator", text: isDe ? "Vergleichen Sie Central Time mit der US-Ostküste." : lang === "es" ? "Compare la zona central con la costa este de EE. UU." : "Compare Central zone to US East Coast." },
    { href: pageUrl(lang || "en", "kst-to-est"), title: isDe ? "KST zu EST Umrechner" : lang === "es" ? "Convertidor KST a EST de Corea" : "KST to EST Korea Calculator", text: isDe ? "Vergleichen Sie die Uhrzeit von Seoul mit New York." : lang === "es" ? "Compare la hora de Seúl con la hora de Nueva York." : "Compare Seoul time to New York time." }
  ],
  dynamic: [
    { href: pageUrl(lang || "en", ""), title: isDe ? "GMT zu EST Umrechner" : lang === "es" ? "Calculadora de GMT a EST principal" : "Main GMT to EST Dashboard", text: isDe ? "Zurück zu unserem primären Zeitzonenumrechner." : lang === "es" ? "Regresa a nuestro convertidor base." : "Return to our primary timezone conversion utility." },
    { href: pageUrl(lang || "en", "est-to-gmt"), title: isDe ? "EST in GMT umrechnen" : lang === "es" ? "Convertidor inverso de EST a GMT" : "Reverse EST to GMT Tool", text: isDe ? "Führen Sie Rückberechnungen für die US-Ostküste durch." : lang === "es" ? "Calcula la dirección inversa para la costa este." : "Perform reverse calculations for the East Coast." }
  ]
};
const activeRelatedResources = relatedResourcesMap[labelKey] || relatedResourcesMap[kind] || relatedResourcesMap.converter;

const eyebrowMap = {
  converter: t.hero?.eyebrow || (isDe ? "Präziser Zeitzonenrechner" : isFr ? "Calculateur instantané de fuseau horaire" : "Instant timezone calculator"),
  difference: isDe ? "Zeitzonenvergleich & Analyse" : lang === "es" ? "Comparación de zonas horarias" : isFr ? "Comparaison et analyse des fuseaux horaires" : "Timezone difference analyser",
  reverse: isDe ? "Rückrechnung & Zeitzonen-Tool" : lang === "es" ? "Calculadora de hora inversa" : isFr ? "Calculateur de conversion inverse" : "Reverse timezone calculator",
  guide: isDe ? "Zeitzonen-Wissensressource" : lang === "es" ? "Recurso de aprendizaje de zona horaria" : isFr ? "Ressource pédagogique sur les fuseaux horaires" : "Timezone learning resource",
  cdtToEst: isDe ? "CDT zu EST Live-Umrechner" : lang === "es" ? "Convertidor CDT a EST en vivo" : "CDT to EST live calculator",
  cstToEst: isDe ? "CST zu EST Live-Umrechner" : lang === "es" ? "Convertidor CST a EST en vivo" : "CST to EST live calculator",
  kstToEst: isDe ? "KST zu EST Live-Umrechner" : lang === "es" ? "Convertidor KST a EST en vivo" : "KST to EST live calculator",
  pdtToEst: isDe ? "PDT zu EST Live-Umrechner" : lang === "es" ? "Convertidor PDT a EST en vivo" : "PDT to EST live calculator",
  mstToEst: isDe ? "MST zu EST Live-Umrechner" : lang === "es" ? "Convertidor MST a EST en vivo" : "MST to EST live calculator",
  astToEst: isDe ? "AST zu EST Live-Umrechner" : lang === "es" ? "Convertidor AST a EST en vivo" : "AST to EST live calculator",
  dynamic: isDe ? "Lokaler Zeitzonenumrechner" : lang === "es" ? "Conversión de zona horaria local" : "Local timezone calculator"
};
const pageEyebrow = eyebrowMap[labelKey] || eyebrowMap[kind] || eyebrowMap.converter;

// Page-specific diagram visuals
const heroDiagramMap = {
  converter: "/assets/gmt-to-est-timeflow-hero.svg",
  difference: "/assets/clocks-change-2026-uk-us-offset-timeline.svg",
  reverse: "/assets/timeflow-hero.svg",
  guide: "/assets/world-time-map.svg",
  cdtToEst: "/assets/cdt-to-est-converter-chart.svg",
  cstToEst: "/assets/cst-to-est-hourly-comparison-chart.png",
  kstToEst: "/assets/seoul-new-york-time-arc.svg",
  pdtToEst: "/assets/pdt-to-est-daylight-saving-guide-1200.webp",
  mstToEst: "/assets/mst-est-offset-bridge.svg",
  astToEst: "/assets/world-time-map.svg"
};
const heroDiagram = heroDiagramMap[labelKey] || heroDiagramMap[kind] || "/assets/world-time-map.svg";

const clockDiagramMap = {
  converter: "/assets/gmt-to-est-converter-clock-visual.svg",
  difference: "/assets/gmt-to-est-clock-visual.svg",
  reverse: "/assets/clock-visual.svg",
  cdtToEst: "/assets/clock-visual.svg",
  cstToEst: "/assets/clock-visual.svg",
  kstToEst: "/assets/kst-est-remote-team-board.svg",
  pdtToEst: "/assets/clock-visual.svg",
  mstToEst: "/assets/mountain-eastern-overlap-board.svg",
  astToEst: "/assets/clock-visual.svg"
};
const clockDiagram = clockDiagramMap[labelKey] || clockDiagramMap[kind] || "/assets/clock-visual.svg";

const mapDiagramMap = {
  converter: "/assets/gmt-to-est-converter-world-time-map.svg",
  difference: "/assets/world-time-map.svg",
  reverse: "/assets/gmt-to-est-world-time-map.svg",
  cdtToEst: "/assets/world-time-map.svg",
  cstToEst: "/assets/world-time-map.svg",
  kstToEst: "/assets/korea-eastern-map-bridge.svg",
  pdtToEst: "/assets/world-time-map.svg",
  mstToEst: "/assets/mountain-eastern-control-room.svg",
  astToEst: "/assets/world-time-map.svg"
};
const mapDiagram = mapDiagramMap[labelKey] || mapDiagramMap[kind] || "/assets/world-time-map.svg";

function formatChartHour(hour: number, currentLang = "en") {
  const normalized = ((hour % 24) + 24) % 24;
  if (currentLang === "es" || currentLang === "de" || currentLang === "fr") {
    return `${String(normalized).padStart(2, "0")}:00`;
  }
  const period = normalized < 12 ? "AM" : "PM";
  const displayHour = normalized % 12 || 12;
  return `${String(displayHour).padStart(2, "0")}:00 ${period}`;
}

function easternChartValue(gmtHour: number, offset: number, label: string, currentLang = "en") {
  const easternHour = gmtHour + offset;
  const prevDayText = currentLang === "de" ? " (Vortag)" : currentLang === "es" ? " (día anterior)" : currentLang === "fr" ? " (jour précédent)" : " (prev day)";
  return `${formatChartHour(easternHour, currentLang)} ${label}${easternHour < 0 ? prevDayText : ""}`;
}

const gmtEstChartRows = Array.from({ length: 24 }, (_, hour) => ({
  gmt: `${String(hour).padStart(2, "0")}:00 GMT`,
  eastern: `${easternChartValue(hour, -5, "EST", lang)} / ${easternChartValue(hour, -4, "EDT", lang)}`,
  offset: "UTC−5 / UTC−4",
}));
---

<!-- Core Headings and Intros rendered on all pages -->
<section class="hero-banner">
  <h1 class="hero-banner-title">
    {pageH1.split(' ').slice(0, -1).join(' ')}{' '}
    <span class="gradient-text">{pageH1.split(' ').slice(-1)[0]}</span>
  </h1>
</section>

