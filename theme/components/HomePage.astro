        <div class="table-wrap">
          <table>
            <caption class="sr-only">{isEs ? `Solapamiento de horarios entre ${context?.from} y ${context?.to}` : `${context?.from} to ${context?.to} Schedule Overlap and standard business hour matching`}</caption>
            <thead>
              <tr><th>{isEs ? `Hora ${context?.from}` : `${context?.from} Time`}</th><th>{isEs ? `Hora ${context?.to} (Estándar)` : `${context?.to} Time (Standard Offset)`}</th><th>{isEs ? `Hora ${context?.to} (Verano)` : `${context?.to} Time (Daylight Offset)`}</th><th>{isEs ? "Estado de programación" : "Scheduling Status"}</th></tr>
            </thead>
            <tbody>
              <tr><td>9:00 AM</td><td>10:00 PM</td><td>11:00 PM</td><td>{isEs ? "Diferencia de jornada" : "Time shift gap"}</td></tr>
              <tr><td>1:00 PM</td><td>2:00 AM</td><td>3:00 AM</td><td>{isEs ? "Fuera de horario laboral" : "Out of hours"}</td></tr>
              <tr><td>5:00 PM</td><td>6:00 AM</td><td>7:00 AM</td><td>{isEs ? "Madrugada" : "Early morning"}</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section aria-labelledby="chart">
      <h2 id="chart">{t.chart?.title || (isEs ? "Tabla de horarios de 24 horas" : `${seoKeyword} Hourly Schedule Grid`)}</h2>
      <div class="table-wrap">
        <table id="timeTable">
          <caption class="sr-only">{isEs ? "Tabla de conversión horaria para cada hora del día" : `${seoKeyword} conversion grid mapping every hour of the day`}</caption>
          <thead><tr><th>GMT</th><th>{t.chart.eastern}</th><th>{t.chart.offset}</th></tr></thead>
          <tbody></tbody>
        </table>
      </div>
    </section>

    <section class="clock-grid" aria-labelledby="live-clocks">
      <h2 id="live-clocks">{t.clocks?.title || (isEs ? "Relojes en vivo" : clocksTitle)}</h2>
      <div class="clock-card"><span>{isEs ? `Hora ${from} actual` : `Current ${from}`}</span><strong id="gmtClock">--:--</strong></div>
      <div class="clock-card"><span>{isEs ? `Hora ${to} actual` : `Current ${to}`}</span><strong id="estClock">--:--</strong><em id="estZone">EST</em></div>
    </section>

    <section aria-labelledby="strip">
      <h2 id="strip">{t.strip?.title || (isEs ? "Solapamiento de la jornada laboral" : `${seoKeyword} Overlap Visualizer`)}</h2>
      <div class="time-strip" id="timeStrip" aria-label={t.strip.aria}></div>
    </section>

    <section class="use-cases" aria-labelledby="uses">
      <h2 id="uses">{t.useCases?.title || (isEs ? "Casos de uso" : `${seoKeyword} Regional Use Cases`)}</h2>
      {activeUseCases.map((item: any) => (
        <article><h3>{item.title}</h3><p>{item.text}</p></article>
      ))}
    </section>

    {activeTopics && activeTopics.length > 0 && (
      <section class="content" aria-labelledby="topics">
        <h2 id="topics">{t.topics?.title || (isEs ? `Información de zonas horarias para ${from} y ${to}` : `Time Zone Details for ${from} and ${to}`)}</h2>
        {activeTopics.map((topic: any) => (
          <article>
            <h3>{topic.title}</h3>
            <p>{topic.text}</p>
          </article>
        ))}
      </section>
    )}

    <section class="faq" aria-labelledby="faq">
      <h2 id="faq">{t.faqs?.title || (isEs ? "Preguntas frecuentes" : `${seoKeyword} Zone FAQs`)}</h2>
      {activeFaqs.map((item: any) => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}
    </section>

    <figure class="map">
      <picture>
        <img loading="lazy" decoding="async" width="1200" height="520" src={mapDiagram} alt={mapAlt} />
      </picture>
    </figure>

    <section class="other-tools" aria-labelledby="other-tools">
      <h2 id="other-tools">{isEs ? `Convertidores relacionados entre ${from} y ${to}` : `Related ${from} and ${to} Converters`}</h2>
      <div class="related-grid">
        {activeRelatedResources.map((item) => (
          <article class="related-card">
            <div class="related-card-title"><a href={item.href}>{replaceTemplates(item.title, replacements)}</a></div>
            <div class="related-card-text">{replaceTemplates(item.text, replacements)}</div>
          </article>
        ))}
      </div>
    </section>

    <section class="source-notes" style="margin-top: 40px; border-top: 1px solid var(--line); padding-top: 20px;">
      <h2>{pageConclusionHeading || (isEs ? "Resumen y siguiente paso" : "Quick Summary & Next Steps")}</h2>
      <p>{pageConclusion}</p>
      <p><strong>{isEs ? "Siguiente paso:" : "Next Step:"}</strong> {pageCTA}</p>
    </section>
  </>
)}
