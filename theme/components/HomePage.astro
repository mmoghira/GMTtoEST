---
import Converter from "theme/components/Converter.astro";
import VisualLab from "theme/components/VisualLab.astro";
import { dynamicConvertersEnabled, pageUrl } from "theme/i18n/config";
import { ensureKeywordInAlt, getPrimaryKeyword } from "theme/utils/seo";

const { labelKey = "home", title, description, kind, t, context, lang = "en", primaryKeyword, meta = {} } = Astro.props;

function replaceTemplates(text: string, replacements: Record<string, string>): string {
  if (!text) return "";
  let result = text;
  for (const [key, value] of Object.entries(replacements)) {
    result = result.replace(new RegExp(`{${key}}`, "g"), value);
  }
  return result;
}

const from = context?.from || "GMT";
const to = context?.to || "EST";
const fromZone = context?.fromZone || "UTC";
const toZone = context?.toZone || "UTC";
const replacements = { from, to, fromZone, toZone };

// Resolve page-specific arrays and text blocks
const activeFaqs = meta.faqs || t.faqs?.items || [];
const activeUseCases = meta.useCases || t.useCases?.items || [];
const activeTopics = meta.topics || t.topics?.items || [];

const pageH1 = replaceTemplates(title || t.pages[labelKey]?.title || "GMT to EST Converter", replacements);

const activeKey = labelKey || kind;
const pageIntro = replaceTemplates(t[`intro_${activeKey}`] || t[`intro_${kind}`] || description, replacements);
const pageExplanation = replaceTemplates(t[`explanation_${activeKey}`] || t[`explanation_${kind}`] || "", replacements);
const pageConclusion = replaceTemplates(t[`conclusion_${activeKey}`] || t[`conclusion_${kind}`] || "", replacements);
const pageCTA = replaceTemplates(t[`cta_${activeKey}`] || t[`cta_${kind}`] || "", replacements);

const explanationHeadingMap = {
  difference: lang === "es" ? "Análisis de la diferencia horaria" : "Analyzing the Time Gap",
  reverse: lang === "es" ? "Cómo funciona la conversión inversa" : "How the Reverse Calculation Works",
  guide: lang === "es" ? "Evolución histórica y estándares" : "Evolution of Global Time Standards",
  dynamic: lang === "es" ? "Cómo calcular la hora entre {from} y {to}" : "Calculating Time Between {from} and {to}"
};
const pageExplanationHeading = `${title}: ${replaceTemplates(explanationHeadingMap[kind] || "Understanding the timezone difference", replacements)}`;

const conclusionHeadingMap = {
  converter: lang === "es" ? "Conclusión y Siguiente Paso" : "Quick Summary & Next Steps",
  difference: lang === "es" ? "Resumen de la Diferencia" : "Key Takeaways on Time Differences",
  reverse: lang === "es" ? "Resumen de Conversión Inversa" : "Final Thoughts on Reverse Scheduling",
  guide: lang === "es" ? "Resumen del Aprendizaje" : "Time Standards Wrap-Up",
  dynamic: lang === "es" ? "Resumen de {from} a {to}" : "Summary of {from} to {to} Conversion"
};
const pageConclusionHeading = replaceTemplates(conclusionHeadingMap[kind] || conclusionHeadingMap.converter, replacements);

// Custom SEO keyword & alt strings
const seoKeyword = kind === "converter" && lang === "en" ? "GMT to EST Converter" : title;
const clocksTitle = `${seoKeyword} Live Clocks`;
const keyword = getPrimaryKeyword(primaryKeyword || seoKeyword, seoKeyword);
const heroAlt = ensureKeywordInAlt(t.images.heroAlt, keyword, `${keyword} featured image`);
const clockAlt = ensureKeywordInAlt(t.images.clockAlt, keyword, `${keyword} clock comparison image`);
const mapAlt = ensureKeywordInAlt(t.images.mapAlt, keyword, `${keyword} world time map image`);

const showArticleMeta = kind === "converter" && lang === "en" && !!meta?.pubDate;
const formatHomeDate = (value?: string) => {
  if (!value) return "";
  const datePart = value.slice(0, 10);
  return new Intl.DateTimeFormat("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  }).format(new Date(`${datePart}T00:00:00Z`));
};
const publishedDateLabel = formatHomeDate(meta?.pubDate);
const updatedDateLabel = formatHomeDate(meta?.updatedDate || meta?.pubDate);

// Show editorial sections only on homepage in English
const showEditorialSections = kind === "converter" && lang === "en";

// TOC Items
const tocItems = [
  { href: "#converter", label: seoKeyword },
  ...(kind === "converter" ? [{ href: "#visual-lab", label: t.visual.title }] : []),
  ...(showEditorialSections ? [
    { href: "#how-it-works", label: "How the conversion works" },
    { href: "#conversion-examples", label: "Conversion examples" },
    { href: "#source-notes", label: "Sources and maintenance" },
  ] : []),
  ...(kind !== "guide" && kind !== "difference" && kind !== "reverse" ? [
    { href: "#live-clocks", label: t.clocks.title },
    { href: "#quick-presets", label: t.presets.title },
    { href: "#chart", label: t.chart.title },
    { href: "#strip", label: t.strip.title }
  ] : []),
  { href: "#uses", label: t.useCases.title },
  ...(activeTopics.length > 0 ? [{ href: "#topics", label: t.topics.title }] : []),
  { href: "#faq", label: t.faqs.title },
];

const relatedResourcesMap = {
  converter: [
    { href: pageUrl(lang || "en", "pdt-to-est"), title: lang === "es" ? "Convertidor PDT a EST" : "PDT to EST Converter", text: lang === "es" ? "Calculadora de tiempo de la costa oeste a la costa este." : "West Coast to East Coast timezone calculator." },
    { href: pageUrl(lang || "en", "kst-to-est"), title: lang === "es" ? "Convertidor KST a EST" : "KST to EST Converter", text: lang === "es" ? "Conversor de Seúl a hora de Nueva York." : "Seoul to New York time converter." },
    { href: pageUrl(lang || "en", "cst-to-est"), title: lang === "es" ? "Convertidor CST a EST" : "CST to EST Converter", text: lang === "es" ? "Calculadora para la zona central y el este." : "Central to Eastern time calculator." }
  ],
  difference: [
    { href: pageUrl(lang || "en", "est-to-gmt"), title: lang === "es" ? "Calculadora inversa EST a GMT" : "EST to GMT Reverse Tool", text: lang === "es" ? "Analice el flujo inverso de la hora estándar del este a GMT." : "Analyze the reverse time flow from Eastern to GMT." },
    { href: pageUrl(lang || "en", "time-zone-guide"), title: lang === "es" ? "Guía completa de husos horarias" : "Global Timekeeping Guide", text: lang === "es" ? "Estudie los estándares UTC, GMT e historia del meridiano." : "Study UTC, GMT standards, and meridian history." }
  ],
  reverse: [
    { href: pageUrl(lang || "en", ""), title: lang === "es" ? "Convertidor principal GMT a EST" : "Direct GMT to EST Converter", text: lang === "es" ? "Regrese al convertidor principal de Greenwich a la hora del Este." : "Return to the main Greenwich to Eastern converter." },
    { href: pageUrl(lang || "en", "pdt-to-est"), title: lang === "es" ? "Calculadora de PDT a EST" : "PDT to EST Calculator", text: lang === "es" ? "Conversor de horario de verano del Pacífico a hora estándar del Este." : "Pacific Daylight to Eastern Standard time converter." }
  ],
  cdtToEst: [
    { href: pageUrl(lang || "en", "cst-to-est"), title: lang === "es" ? "Convertidor CST a EST estándar" : "CST to EST Standard Calculator", text: lang === "es" ? "Planifique para los meses de invierno cuando rige el horario estándar." : "Plan for winter months when standard time is active." },
    { href: pageUrl(lang || "en", "mst-to-est"), title: lang === "es" ? "Convertidor MST a EST de montaña" : "MST to EST Mountain Calculator", text: lang === "es" ? "Compare la zona de montaña de Denver con la hora del este." : "Compare Denver Mountain time to Eastern time." }
  ],
  cstToEst: [
    { href: pageUrl(lang || "en", "cdt-to-est"), title: lang === "es" ? "Convertidor CDT a EST de verano" : "CDT to EST Summer Calculator", text: lang === "es" ? "Planifique para el horario de verano entre Chicago y Nueva York." : "Plan for daylight saving time between Chicago and New York." },
    { href: pageUrl(lang || "en", "pdt-to-est"), title: lang === "es" ? "Convertidor PDT a EST del Pacífico" : "PDT to EST Pacific Calculator", text: lang === "es" ? "Calcule la diferencia del Pacífico con la hora del este." : "Calculate Pacific difference to Eastern time." }
  ],
  kstToEst: [
    { href: pageUrl(lang || "en", "ast-to-est"), title: lang === "es" ? "Convertidor AST a EST del Atlántico" : "AST to EST Atlantic Calculator", text: lang === "es" ? "Calcule la hora desde el Atlántico a la costa este." : "Calculate time from Atlantic zone to East Coast." },
    { href: pageUrl(lang || "en", "pdt-to-est"), title: lang === "es" ? "Convertidor PDT a EST de California" : "PDT to EST California Calculator", text: lang === "es" ? "Compare la costa oeste con la costa este de EE. UU." : "Compare West Coast to East Coast times." }
  ],
  pdtToEst: [
    { href: pageUrl(lang || "en", "mst-to-est"), title: lang === "es" ? "Convertidor MST a EST de montaña" : "MST to EST Mountain Calculator", text: lang === "es" ? "Compare Denver y Phoenix con la hora de Nueva York." : "Compare Denver and Phoenix with New York time." },
    { href: pageUrl(lang || "en", "cst-to-est"), title: lang === "es" ? "Convertidor CST a EST de Chicago" : "CST to EST Chicago Calculator", text: lang === "es" ? "Calcule la hora del medio oeste a la costa este." : "Calculate Midwestern time to East Coast." }
  ],
  mstToEst: [
    { href: pageUrl(lang || "en", "pdt-to-est"), title: lang === "es" ? "Convertidor PDT a EST de California" : "PDT to EST California Calculator", text: lang === "es" ? "Compare la costa oeste con la costa este de EE. UU." : "Compare West Coast to East Coast times." },
    { href: pageUrl(lang || "en", "ast-to-est"), title: lang === "es" ? "Convertidor AST a EST del Atlántico" : "AST to EST Atlantic Calculator", text: lang === "es" ? "Compare el tiempo del Atlántico con la hora del este." : "Compare Atlantic time to Eastern time." }
  ],
  astToEst: [
    { href: pageUrl(lang || "en", "cdt-to-est"), title: lang === "es" ? "Convertidor CDT a EST de verano" : "CDT to EST Summer Calculator", text: lang === "es" ? "Compare la zona central con la costa este de EE. UU." : "Compare Central zone to US East Coast." },
    { href: pageUrl(lang || "en", "kst-to-est"), title: lang === "es" ? "Convertidor KST a EST de Corea" : "KST to EST Korea Calculator", text: lang === "es" ? "Compare la hora de Seúl con la hora de Nueva York." : "Compare Seoul time to New York time." }
  ],
  dynamic: [
    { href: pageUrl(lang || "en", ""), title: lang === "es" ? "Calculadora de GMT a EST principal" : "Main GMT to EST Dashboard", text: lang === "es" ? "Regresa a nuestro convertidor base." : "Return to our primary timezone conversion utility." },
    { href: pageUrl(lang || "en", "est-to-gmt"), title: lang === "es" ? "Convertidor inverso de EST a GMT" : "Reverse EST to GMT Tool", text: lang === "es" ? "Calcula la dirección inversa para la costa este." : "Perform reverse calculations for the East Coast." }
  ]
};
const activeRelatedResources = relatedResourcesMap[labelKey] || relatedResourcesMap[kind] || relatedResourcesMap.converter;

const eyebrowMap = {
  converter: t.hero?.eyebrow || "Instant timezone calculator",
  difference: lang === "es" ? "Comparación de zonas horarias" : "Timezone difference analyser",
  reverse: lang === "es" ? "Calculadora de hora inversa" : "Reverse timezone calculator",
  guide: lang === "es" ? "Recurso de aprendizaje de zona horaria" : "Timezone learning resource",
  cdtToEst: lang === "es" ? "Convertidor CDT a EST en vivo" : "CDT to EST live calculator",
  cstToEst: lang === "es" ? "Convertidor CST a EST en vivo" : "CST to EST live calculator",
  kstToEst: lang === "es" ? "Convertidor KST a EST en vivo" : "KST to EST live calculator",
  pdtToEst: lang === "es" ? "Convertidor PDT a EST en vivo" : "PDT to EST live calculator",
  mstToEst: lang === "es" ? "Convertidor MST a EST en vivo" : "MST to EST live calculator",
  astToEst: lang === "es" ? "Convertidor AST a EST en vivo" : "AST to EST live calculator",
  dynamic: lang === "es" ? "Conversión de zona horaria local" : "Local timezone calculator"
};
const pageEyebrow = eyebrowMap[labelKey] || eyebrowMap[kind] || eyebrowMap.converter;

// Page-specific diagram visuals
const heroDiagramMap = {
  converter: "/assets/gmt-to-est-timeflow-hero.svg",
  difference: "/assets/clocks-change-2026-uk-us-offset-timeline.svg",
  reverse: "/assets/timeflow-hero.svg",
  guide: "/assets/world-time-map.svg",
  cdtToEst: "/assets/cdt-to-est-converter-chart.svg",
  cstToEst: "/assets/cst-to-est-hourly-comparison-chart.png",
  kstToEst: "/assets/seoul-new-york-time-arc.svg",
  pdtToEst: "/assets/pdt-to-est-daylight-saving-guide-1200.webp",
  mstToEst: "/assets/mst-est-offset-bridge.svg",
  astToEst: "/assets/world-time-map.svg"
};
const heroDiagram = heroDiagramMap[labelKey] || heroDiagramMap[kind] || "/assets/world-time-map.svg";

const clockDiagramMap = {
  converter: "/assets/gmt-to-est-converter-clock-visual.svg",
  difference: "/assets/gmt-to-est-clock-visual.svg",
  reverse: "/assets/clock-visual.svg",
  cdtToEst: "/assets/clock-visual.svg",
  cstToEst: "/assets/clock-visual.svg",
  kstToEst: "/assets/kst-est-remote-team-board.svg",
  pdtToEst: "/assets/clock-visual.svg",
  mstToEst: "/assets/mountain-eastern-overlap-board.svg",
  astToEst: "/assets/clock-visual.svg"
};
const clockDiagram = clockDiagramMap[labelKey] || clockDiagramMap[kind] || "/assets/clock-visual.svg";

const mapDiagramMap = {
  converter: "/assets/gmt-to-est-converter-world-time-map.svg",
  difference: "/assets/world-time-map.svg",
  reverse: "/assets/gmt-to-est-world-time-map.svg",
  cdtToEst: "/assets/world-time-map.svg",
  cstToEst: "/assets/world-time-map.svg",
  kstToEst: "/assets/korea-eastern-map-bridge.svg",
  pdtToEst: "/assets/world-time-map.svg",
  mstToEst: "/assets/mountain-eastern-control-room.svg",
  astToEst: "/assets/world-time-map.svg"
};
const mapDiagram = mapDiagramMap[labelKey] || mapDiagramMap[kind] || "/assets/world-time-map.svg";

function formatChartHour(hour: number, currentLang = "en") {
  const normalized = ((hour % 24) + 24) % 24;
  if (currentLang === "es") {
    return `${String(normalized).padStart(2, "0")}:00`;
  }
  const period = normalized < 12 ? "AM" : "PM";
  const displayHour = normalized % 12 || 12;
  return `${String(displayHour).padStart(2, "0")}:00 ${period}`;
}

function easternChartValue(gmtHour: number, offset: number, label: string, currentLang = "en") {
  const easternHour = gmtHour + offset;
  const prevDayText = currentLang === "es" ? " (día anterior)" : " (prev day)";
  return `${formatChartHour(easternHour, currentLang)} ${label}${easternHour < 0 ? prevDayText : ""}`;
}

const isEs = lang === "es";
const gmtEstChartRows = Array.from({ length: 24 }, (_, hour) => ({
  gmt: `${String(hour).padStart(2, "0")}:00 GMT`,
  eastern: `${easternChartValue(hour, -5, "EST", lang)} / ${easternChartValue(hour, -4, "EDT", lang)}`,
  offset: "UTC−5 / UTC−4",
}));
---

<!-- Core Headings and Intros rendered on all pages -->
<section class="hero-banner">
  <h1 class="hero-banner-title">
    {pageH1.split(' ').slice(0, -1).join(' ')}{' '}
    <span class="gradient-text">{pageH1.split(' ').slice(-1)[0]}</span>
  </h1>
</section>

<p class="seo-keyword-intro"><strong>{seoKeyword}</strong> {pageIntro}</p>

<!-- 1. HOMEPAGE LAYOUT SEQUENCE -->
{kind === "converter" && (
  <>
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">{pageEyebrow}</p>
        <p>{meta.description || description}</p>
        <figure class="hero-visual reveal">
          <picture>
            <img width="960" height="420" src={heroDiagram} alt={heroAlt} fetchpriority="high" loading="eager" decoding="async" />
          </picture>
        </figure>
      </div>
      <Converter intent={kind} t={t} context={context} lang={lang} />
    </section>

    {showArticleMeta && (
      <section class="home-meta" aria-label={isEs ? "Detalles de publicación" : "Publication details"}>
        <p class="post-meta home-meta__line">
          <span>{isEs ? "Publicado" : "Published"}</span>
          <time datetime={meta.pubDate} itemprop="datePublished">{publishedDateLabel}</time>
          <span aria-hidden="true">|</span>
          <span>{isEs ? "Última actualización" : "Last updated"}</span>
          <time datetime={meta.updatedDate || meta.pubDate} itemprop="dateModified">{updatedDateLabel}</time>
        </p>
      </section>
    )}

    {showArticleMeta && (
      <nav class="table-of-contents" aria-labelledby="table-of-contents">
        <p class="toc-kicker">{isEs ? "Guía de navegación" : "Navigation aid"}</p>
        <h2 id="table-of-contents">{isEs ? "Tabla de contenidos" : "Table of Contents"}</h2>
        <ol>
          {tocItems.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ol>
      </nav>
    )}

    <VisualLab t={t} keywordHeading={seoKeyword} lang={lang} />

    {showEditorialSections && (
      <section class="method-section" id="how-it-works" aria-labelledby="how-it-works-title">
        <div class="method-intro">
          <p class="eyebrow">{isEs ? "Método de conversión" : "Conversion method"}</p>
          <h2 id="how-it-works-title">{isEs ? "Cómo funciona la conversión de GMT a hora del Este" : "How this GMT to EST conversion works"}</h2>
          <p>
            {isEs ? (
              <>El convertidor trata GMT como UTC+0 y la hora del Este como la zona IANA <code>America/New_York</code>. Esta distinción es fundamental porque Eastern Time opera en EST (UTC−5) durante el horario estándar y en EDT (UTC−4) durante el horario de verano.</>
            ) : (
              <>The converter treats GMT as UTC+0 and Eastern Time as the IANA zone <code>America/New_York</code>. That distinction matters because Eastern Time is EST at UTC-5 during standard time and EDT at UTC-4 during daylight saving time.</>
            )}
          </p>
        </div>
        <div class="method-grid">
          <article class="method-card">
            <h3>{isEs ? "Desfase según la fecha" : "Date-aware offset"}</h3>
            <p>{isEs ? "La fecha seleccionada forma parte del cálculo, por lo que enero y julio muestran desfases distintos para la misma hora GMT." : "The selected date is part of the calculation, so January and July can return different Eastern Time labels for the same GMT clock time."}</p>
          </article>
          <article class="method-card">
            <h3>{isEs ? "Reglas de zona oficial" : "Named zone rules"}</h3>
            <p>{isEs ? <>Utilizar la zona <code>America/New_York</code> evita asumir erróneamente que la hora del Este siempre es EST.</> : <>Using <code>America/New_York</code> avoids assuming that Eastern Time is always EST, which is a common scheduling mistake.</>}</p>
          </article>
          <article class="method-card">
            <h3>{isEs ? "Resultado claro y verificable" : "Human-readable result"}</h3>
            <p>{isEs ? "El convertidor muestra la hora convertida, la etiqueta activa (EST o EDT) y el desfase con GMT para que verifiques todo antes de compartirlo." : "The output shows the converted time, the active EST or EDT label, and the GMT offset so you can verify the result before sharing it."}</p>
          </article>
        </div>
      </section>
    )}

    <section class="clock-grid" aria-labelledby="live-clocks">
      <h2 id="live-clocks">{t.clocks?.title || (isEs ? "Relojes en vivo" : clocksTitle)}</h2>
      <div class="clock-card"><span>{t.clocks.gmt}</span><strong id="gmtClock">--:--</strong></div>
      <div class="clock-card"><span>{t.clocks.eastern}</span><strong id="estClock">--:--</strong><em id="estZone">EST</em></div>
    </section>

    <section class="band" id="quick-presets">
      <div>
        <h2>{t.presets?.title || (isEs ? "Accesos rápidos" : `${seoKeyword} Quick Presets`)}</h2>
        <div class="preset-row">
          <button type="button" data-preset="meeting">{t.presets.meeting}</button>
          <button type="button" data-preset="event">{t.presets.event}</button>
          <button type="button" data-preset="trading">{t.presets.trading}</button>
        </div>
      </div>
      <picture>
        <img loading="lazy" decoding="async" width="900" height="380" src={clockDiagram} alt={clockAlt} />
      </picture>
    </section>

    <section class="examples-section" id="comparison-table" aria-labelledby="comparison-table-title" style="padding-top: 20px; padding-bottom: 25px;">
      <div>
        <h2 id="comparison-table-title">{isEs ? "Resumen de la diferencia horaria actual" : "GMT to EST Current Offset Summary"}</h2>
        <p>{isEs ? "Un resumen rápido de las diferencias horarias entre GMT y Eastern Time durante el horario estándar y el horario de verano." : "A quick summary of standard and daylight saving offsets between GMT and Eastern Time."}</p>
        <div class="table-wrap">
          <table>
            <caption class="sr-only">{isEs ? "Resumen de la diferencia horaria entre GMT y Eastern Time" : "GMT to EST Standard and Daylight Saving Offset Summary"}</caption>
            <thead>
              <tr><th>{isEs ? "Zona horaria" : "Time Zone"}</th><th>{isEs ? "Hora estándar" : "Standard Time Offset"}</th><th>{isEs ? "Horario de verano" : "Daylight Saving Offset"}</th><th>{isEs ? "Estado" : "Status"}</th></tr>
            </thead>
            <tbody>
              <tr><td>Greenwich Mean Time (GMT)</td><td>UTC+0</td><td>UTC+0</td><td>{isEs ? "Permanente" : "Permanent"}</td></tr>
              <tr><td>Eastern Standard Time (EST)</td><td>UTC-5</td><td>UTC-4 (EDT)</td><td>{isEs ? "Estacional" : "Seasonal"}</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    {showEditorialSections && (
      <section class="examples-section" id="conversion-examples" aria-labelledby="conversion-examples-title">
        <h2 id="conversion-examples-title">{isEs ? "Ejemplos de conversión de GMT a hora del Este" : "GMT to Eastern Time examples"}</h2>
        <p>
          {isEs ? "Estos ejemplos demuestran por qué un convertidor con detección de fecha es más seguro que restar cinco horas en todo momento. Usa el selector arriba para la fecha exacta que necesites." : "These examples show why a date-aware converter is safer than subtracting five hours every time. Use the input above for the exact date and time you need."}
        </p>
        <div class="table-wrap">
          <table>
            <caption class="sr-only">{isEs ? "Ejemplos de conversión de GMT a hora del Este por estación" : "GMT to Eastern Time conversions examples by season"}</caption>
            <thead>
              <tr><th>{isEs ? "Hora GMT" : "GMT time"}</th><th>{isEs ? "Resultado en hora del Este" : "Eastern result"}</th><th>{isEs ? "Motivo del cambio" : "Why it changes"}</th></tr>
            </thead>
            <tbody>
              <tr><td>{isEs ? "15 de enero, 12:00 GMT" : "January 15, 12:00 GMT"}</td><td>{isEs ? "07:00 EST" : "7:00 AM EST"}</td><td>{isEs ? "Eastern Time opera en horario estándar (EST, UTC−5)." : "Eastern Time is on standard time, UTC-5."}</td></tr>
              <tr><td>{isEs ? "15 de julio, 12:00 GMT" : "July 15, 12:00 GMT"}</td><td>{isEs ? "08:00 EDT" : "8:00 AM EDT"}</td><td>{isEs ? "Eastern Time opera en horario de verano (EDT, UTC−4)." : "Eastern Time is on daylight time, UTC-4."}</td></tr>
              <tr><td>{isEs ? "Fechas de cambio estacional" : "November transition dates"}</td><td>{isEs ? "Verificar fecha exacta" : "Check the exact date"}</td><td>{isEs ? "El desfase cambia entre 4 y 5 horas según la fecha del cambio." : "The local offset changes near the daylight saving transition."}</td></tr>
            </tbody>
          </table>
        </div>
      </section>
    )}

    {showEditorialSections && (
      <section class="source-notes" id="source-notes" aria-labelledby="source-notes-title">
        <h2 id="source-notes-title">{isEs ? "Fuentes y mantenimiento" : "Sources and maintenance"}</h2>
        <p>
