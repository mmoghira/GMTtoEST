{
    "cleanUrls": true,
    "trailingSlash": true,
    "redirects": [
      {
        "source": "/(.*)",
        "has": [{ "type": "host", "value": "www.gmttoestconverter.com" }],
        "destination": "https://gmttoestconverter.com/$1",
        "permanent": true
      },
      {
        "source": "/:lang(es|hi|pt|ja|fr|tr|ur|vi|th|id|pl)/blog/:path*",
        "destination": "/blog/:path*",
        "permanent": true
      },
      {
        "source": "/:lang(es|hi|pt|ja|fr|tr|ur|vi|th|id|pl)/blog",
        "destination": "/blog/",
        "permanent": true
      },
      {
        "source": "/:lang(zh|hi|ar|pt|ru|ja|de|fr|ko|it|tr|ur|bn|vi|th|id|fa|pl)/gmt-to-:zone((?!est)[a-z0-9]+)",
        "destination": "/gmt-to-:zone/",
        "permanent": true
      },
      {
        "source": "/:lang(zh|hi|ar|pt|ru|ja|de|fr|ko|it|tr|ur|bn|vi|th|id|fa|pl)/gmt-to-:zone((?!est)[a-z0-9]+)/",
        "destination": "/gmt-to-:zone/",
        "permanent": true
      },
      {
        "source": "/:lang(zh|hi|ar|pt|ru|ja|de|fr|ko|it|tr|ur|bn|vi|th|id|fa|pl)/:zone((?!gmt)[a-z0-9]+)-to-est",
        "destination": "/:zone-to-est/",
        "permanent": true
      },
      {
        "source": "/:lang(zh|hi|ar|pt|ru|ja|de|fr|ko|it|tr|ur|bn|vi|th|id|fa|pl)/:zone((?!gmt)[a-z0-9]+)-to-est/",
        "destination": "/:zone-to-est/",
        "permanent": true
      },
      { "source": "/gmt-to-est-converter", "destination": "/", "permanent": true },
      { "source": "/gmt-to-est-converter/", "destination": "/", "permanent": true },
      { "source": "/gmt-to-:zone((?!acdt|acst|adt|aedt|aest|akdt|akst|ast|awst|bst|cat|cdt|cest|cet|chst|cst|eat|edt|eest|eet|est|hdt|hkt|hst|idt|ist|jst|kst|mdt|mest|met|msk|mst|ndt|nst|nzdt|nzst|pdt|pkt|pst|sast|sst|utc|wat|west|wet|wib|wit|wita)[a-z0-9]+)", "destination": "/", "permanent": true },
      { "source": "/gmt-to-:zone((?!acdt|acst|adt|aedt|aest|akdt|akst|ast|awst|bst|cat|cdt|cest|cet|chst|cst|eat|edt|eest|eet|est|hdt|hkt|hst|idt|ist|jst|kst|mdt|mest|met|msk|mst|ndt|nst|nzdt|nzst|pdt|pkt|pst|sast|sst|utc|wat|west|wet|wib|wit|wita)[a-z0-9]+)/", "destination": "/", "permanent": true },

      { "source": "/:zone((?!acdt|acst|adt|aedt|aest|akdt|akst|ast|awst|bst|cat|cdt|cest|cet|chst|cst|eat|edt|eest|eet|hdt|hkt|hst|idt|ist|jst|kst|mdt|mest|met|msk|mst|ndt|nst|nzdt|nzst|pdt|pkt|pst|sast|sst|utc|wat|west|wet|wib|wit|wita)[a-z0-9]+)-to-est", "destination": "/", "permanent": true },
      { "source": "/:zone((?!acdt|acst|adt|aedt|aest|akdt|akst|ast|awst|bst|cat|cdt|cest|cet|chst|cst|eat|edt|eest|eet|hdt|hkt|hst|idt|ist|jst|kst|mdt|mest|met|msk|mst|ndt|nst|nzdt|nzst|pdt|pkt|pst|sast|sst|utc|wat|west|wet|wib|wit|wita)[a-z0-9]+)-to-est/", "destination": "/", "permanent": true },
      { "source": "/index.php", "destination": "/", "permanent": true },
      { "source": "/index.php/", "destination": "/", "permanent": true },
      { "source": "/contact/", "destination": "/contact-us/", "permanent": true },
      { "source": "/en/", "destination": "/", "permanent": true },
      { "source": "/en", "destination": "/", "permanent": true },
      { "source": "/what-is-gmt", "destination": "/blog/what-is-gmt/", "permanent": true },
      { "source": "/what-is-gmt/", "destination": "/blog/what-is-gmt/", "permanent": true }
    ],
    "headers": [
      {
        "source": "/(.*)",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          }
        ]
      },
      {
        "source": "/assets/(.*)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/_astro/(.*)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/fonts/(.*)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "buildCommand": "npm run generate:logos && npm run build"
}
