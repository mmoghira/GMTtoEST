{
    "cleanUrls": true,
    "trailingSlash": true,
    "redirects": [
      { "source": "/index.php", "destination": "/", "permanent": true },
      { "source": "/index.php/", "destination": "/", "permanent": true },
      { "source": "/contact/", "destination": "/contact-us/", "permanent": true }
    ],
    "headers": [
      {
        "source": "/assets/(.*)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/_astro/(.*)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/(.*)\\.(?:avif|webp|png|jpg|jpeg|gif|svg|ico|css|js|woff2?)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/(.*)\\.(?:html|xml|txt|json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      }
    ],
    "buildCommand": "npm run generate:logos && npm run build"
}
