---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import Converter from "theme/components/Converter.astro";
import { getTranslation, pageUrl, siteUrl } from "theme/i18n/config";

const lang = "en";
const dir = "ltr";
const slug = "ist-to-est";
const t = getTranslation(lang);

const pageTitle = "IST to EST Converter";
const seoTitle = "IST to EST Converter – India Standard Time to Eastern Standard Time";
const pageDescription = "Convert IST to EST instantly. Calculate the exact 10.5-hour time difference between India Standard Time (UTC+5:30) and US Eastern Standard Time (UTC-5) with live clocks and meeting planners.";

const context = {
  from: "IST",
  to: "EST",
  fromZone: "Asia/Kolkata",
  toZone: "America/New_York"
};

const canonical = `${siteUrl}/ist-to-est/`;

// ═══════════════════════════════════════════════════════════════════════════
// 24-HOUR CONVERSION TABLE DATA & HELPER FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════
// IST → EST: EST is 10 hours 30 minutes behind IST
// ═══════════════════════════════════════════════════════════════════════════
function formatHour12(hour: number, minutes: number = 0) {
  const normalizedHour = ((hour % 24) + 24) % 24;
  const period = normalizedHour < 12 ? "AM" : "PM";
  const displayHour = normalizedHour % 12 || 12;
  const displayMinutes = minutes < 10 ? `0${minutes}` : `${minutes}`;
  return `${displayHour}:${displayMinutes} ${period}`;
}

const conversionRows = Array.from({ length: 24 }, (_, hour) => {
  // Convert IST hour:minute to total minutes, subtract 10h 30m (630 mins)
  const totalIstMins = hour * 60;
  let totalEstMins = totalIstMins - 630;
  const prevDay = totalEstMins < 0;
  if (prevDay) {
    totalEstMins += 1440; // Add 24 hours in minutes
  }
  const estHour = Math.floor(totalEstMins / 60);
  const estMins = totalEstMins % 60;

  return {
    ist: formatHour12(hour, 0),
    est: `${formatHour12(estHour, estMins)}${prevDay ? " (-1 day)" : ""}`,
    dayNote: prevDay ? "Previous day in US" : "Same day"
  };
});

// Popular conversions
const popularConversions = [
  { ist: "12:00 AM (Midnight) IST", est: "1:30 PM EST (Prev Day)", note: "US afternoon business hours while India enters night" },
  { ist: "2:00 AM IST", est: "3:30 PM EST (Prev Day)", note: "US East Coast afternoon work shift wrap-up" },
  { ist: "6:00 AM IST", est: "7:30 PM EST (Prev Day)", note: "US evening prime time while India begins early morning" },
  { ist: "8:30 AM IST", est: "10:00 PM EST (Prev Day)", note: "India office opening hours while US East Coast sleeps" },
  { ist: "10:00 AM IST", est: "11:30 PM EST (Prev Day)", note: "Mid-morning focus hours across Bengaluru, Mumbai, and Delhi" },
  { ist: "1:00 PM IST", est: "2:30 AM EST", note: "Afternoon shift in India; overnight in Eastern US" },
  { ist: "3:30 PM IST", est: "5:00 AM EST", note: "Late afternoon in India; early pre-dawn on US East Coast" },
  { ist: "6:30 PM IST", est: "8:00 AM EST", note: "Prime collaboration window: India evening sync with US morning start" },
  { ist: "7:30 PM IST", est: "9:00 AM EST", note: "Peak daily handoff hour for global tech and engineering teams" },
  { ist: "9:00 PM IST", est: "10:30 AM EST", note: "India late evening shift connecting with US mid-morning focus" },
  { ist: "10:30 PM IST", est: "12:00 PM (Noon) EST", note: "India night shift / US lunchtime meeting window" },
  { ist: "11:30 PM IST", est: "1:00 PM EST", note: "Late night in India; US afternoon operations continue" },
];

// FAQ data (20 detailed FAQs)
const faqs = [
  { q: "What is India Standard Time (IST)?", a: "India Standard Time (IST) is the official time zone for India and Sri Lanka. It runs at an offset of UTC+5:30 (five hours and thirty minutes ahead of Coordinated Universal Time)." },
  { q: "What is Eastern Standard Time (EST)?", a: "Eastern Standard Time (EST) is the standard time used on the East Coast of North America (UTC-5), including cities like New York, Washington D.C., Toronto, Boston, and Atlanta." },
  { q: "How many hours is EST behind IST?", a: "Eastern Standard Time (EST) is exactly 10 hours and 30 minutes behind India Standard Time (IST). To calculate EST from IST, subtract 10 hours and 30 minutes from the IST clock time." },
  { q: "Why does India have a half-hour offset (+5:30)?", a: "India selected UTC+5:30 in 1906 to establish a single unified timezone that evenly split the country's geographic expanse between longitude 68°E and 97°E, centered on 82.5°E longitude at Mirzapur near Allahabad." },
  { q: "Does India observe Daylight Saving Time (DST)?", a: "No. India does not observe Daylight Saving Time. IST remains fixed at UTC+5:30 throughout the entire year." },
  { q: "Does Eastern Standard Time (EST) observe Daylight Saving Time?", a: "Yes. The US East Coast switches to Eastern Daylight Time (EDT, UTC-4) from the second Sunday in March to the first Sunday in November. During the EDT summer period, the gap narrows to 9.5 hours (9 hours 30 minutes)." },
  { q: "What is the best time for a meeting between India and New York?", a: "The best overlap window is between 6:30 PM IST and 8:30 PM IST. In New York (EST), this corresponds to 8:00 AM EST to 10:00 AM EST, allowing US teams to start their morning just as Indian teams wrap up their day." },
  { q: "How do tech outsourcing companies handle the 10.5-hour difference?", a: "Global IT service companies in Bengaluru, Hyderabad, Pune, and Gurugram operate dual-shift patterns (including night shifts from 6:00 PM IST to 3:00 AM IST) to provide real-time support during US business hours." },
  { q: "What cities operate on India Standard Time?", a: "All major Indian hubs run on IST, including Mumbai, New Delhi, Bengaluru, Hyderabad, Chennai, Kolkata, Pune, Ahmedabad, and Jaipur, as well as Colombo in Sri Lanka." },
  { q: "How do I calculate IST to EST manually?", a: "Subtract 10 hours and 30 minutes from the IST time. For example, 7:30 PM IST minus 10 hours = 9:30 AM, then minus 30 minutes = 9:00 AM EST on the same day." },
  { q: "What happens to calendar dates when converting IST morning to EST?", a: "Because EST is 10.5 hours behind IST, morning hours in India (between 12:00 AM Midnight and 10:29 AM IST) correspond to the previous calendar afternoon/evening in EST." },
  { q: "Is Sri Lanka Standard Time the same as IST?", a: "Yes. Sri Lanka Standard Time (SLST) operates at UTC+5:30, identical to India Standard Time year-round." },
  { q: "What is the IANA time zone identifier for IST?", a: "The standardized IANA database key for India Standard Time is Asia/Kolkata (formerly Asia/Calcutta)." },
  { q: "How does the stock market timing overlap between NSE/BSE and NYSE?", a: "The National Stock Exchange of India (NSE) trades from 9:15 AM to 3:30 PM IST (10:45 PM to 5:00 AM EST). There is zero daytime trading overlap between Indian markets and the New York Stock Exchange." },
  { q: "Why is 6:30 PM IST often called the 'golden window' for transatlantic calls?", a: "At 6:30 PM IST, it is 8:00 AM EST. This provides a fresh start for US East Coast professionals while allowing Indian teams to conduct daily handoffs before finishing work." },
  { q: "Does Pakistan or Bangladesh share the same time zone as India?", a: "No. Pakistan uses Pakistan Standard Time (PKT, UTC+5), which is 30 minutes behind IST. Bangladesh uses Bangladesh Standard Time (BST, UTC+6), which is 30 minutes ahead of IST." },
  { q: "How do airlines calculate flight times from India to North America?", a: "Non-stop flights from Delhi or Mumbai to New York take approximately 15 to 16 hours. Flights departing at 2:00 AM IST arrive in New York at around 7:30 AM EST on the same day due to timezone rollback." },
  { q: "How does our IST to EST converter handle leap years and dates?", a: "Our tool utilizes native ECMAScript Intl DateTimeFormat APIs and the official IANA database, automatically resolving leap days and seasonal transitions." },
  { q: "What is the offset difference between Bengaluru and Boston?", a: "Bengaluru operates on IST (UTC+5:30) and Boston operates on EST (UTC-5). In winter, Bengaluru is 10.5 hours ahead of Boston; in summer (EDT), it is 9.5 hours ahead." },
  { q: "What is the offset difference between Mumbai and Miami?", a: "Mumbai operates on IST (UTC+5:30) and Miami operates on EST (UTC-5). In winter, Mumbai is 10.5 hours ahead of Miami; in summer (EDT), it is 9.5 hours ahead." },
  { q: "Does Sri Lanka use the exact same timezone as India?", a: "Yes, Sri Lanka has officially observed UTC+5:30 since 2006, matching India Standard Time perfectly." },
  { q: "What is the time difference between New Delhi and Washington D.C.?", a: "New Delhi is on IST (UTC+5:30) and Washington D.C. is on EST (UTC-5). In winter, New Delhi is 10 hours 30 minutes ahead; in summer (EDT), it is 9 hours 30 minutes ahead." },
  { q: "How do call centers in Gurugram and Noida manage North American shifts?", a: "Call centers operate night shifts matching US business hours. A shift starting at 6:30 PM IST corresponds to 8:00 AM EST on the US East Coast." },
  { q: "Why did India choose a single national time zone instead of multiple zones?", a: "To maintain administrative simplicity and unified transport schedules across railways, India adopted a single timezone (IST) centered on 82.5°E longitude, despite spanning nearly 30 degrees of longitude." },
  { q: "What is the difference between IST (India Standard Time) and IST (Irish Standard Time)?", a: "While both use the abbreviation IST, India Standard Time is fixed at UTC+5:30 year-round, whereas Irish Standard Time is Ireland's summer daylight saving offset (UTC+1)." },
  { q: "What is the offset difference between Chennai and Charlotte (North Carolina)?", a: "Chennai runs on IST (UTC+5:30) and Charlotte runs on EST (UTC-5). During winter, Chennai is 10.5 hours ahead of Charlotte; during summer (EDT), Chennai is 9.5 hours ahead." },
  { q: "How do aviation long-haul routes from Delhi to JFK calculate flight durations?", a: "Non-stop flights cross Europe and the Atlantic over 15–16 hours. Departing Delhi at 2:30 AM IST arrives in New York at 7:30 AM EST on the same calendar day." },
  { q: "What is the offset difference between Kolkata and Toronto?", a: "Kolkata operates on IST (UTC+5:30) and Toronto operates on EST (UTC-5). In winter, Kolkata is 10.5 hours ahead of Toronto; in summer (EDT), it is 9.5 hours ahead." },
  { q: "How do international legal contracts specify timestamps between US and Indian entities?", a: "Contracts typically reference both UTC (e.g. 14:00 UTC) and specify the equivalent local clock times in both IST and EST to eliminate legal ambiguity." },
  { q: "What is the capital of India and what timezone does it use?", a: "New Delhi is the capital of India, and it uses India Standard Time (IST, UTC+5:30) permanently." },
  { q: "What is the largest city in Sri Lanka and what timezone does it use?", a: "Colombo is the commercial capital of Sri Lanka, operating on Sri Lanka Standard Time (UTC+5:30), which matches IST." },
];

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "IST to EST, IST to EST Converter, India Standard Time to Eastern Standard Time, Convert IST to EST, Bengaluru to New York time, Delhi to EST, Mumbai to New York time difference, 10.5 hour timezone converter",
  image: "/assets/ist-to-est-og.svg",
  imageAlt: "IST to EST Converter – Convert India Standard Time to Eastern Standard Time",
  faqs,
  appDescription: "Free online IST to EST converter featuring live clocks, half-hour offset calculations, 24-hour schedules, and transatlantic IT meeting planners.",
  applicationCategory: "UtilityApplication",
  operatingSystem: "Any",
  howToName: "How to Convert IST to EST",
  howToDescription: "Simple steps to convert India Standard Time to US Eastern Standard Time.",
  howToSteps: [
    { name: "Input IST Time", text: "Select your desired India Standard Time in the converter tool." },
    { name: "Subtract 10 Hours 30 Minutes", text: "The calculator automatically subtracts 10.5 hours to determine Eastern Standard Time (EST)." },
    { name: "Check Date Shift", text: "For IST morning times (before 10:30 AM), the calculated EST time falls on the previous calendar day." },
    { name: "Account for US Summer Time", text: "From March to November, when North America observes Eastern Daylight Time (EDT, UTC-4), the offset shrinks to 9 hours 30 minutes." }
  ],
};
