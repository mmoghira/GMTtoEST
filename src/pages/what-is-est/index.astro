const lang = "en";
const dir = "ltr";
const slug = "what-is-est";
const seoTitle = "What is EST? Eastern Standard Time Meaning & Offset (2026)";
const pageDescription = "Learn the history and meaning of Eastern Standard Time (EST). Explore the UTC-5 offset, geographic boundaries, and daylight saving shifts.";

const pubDate = "2026-07-15T13:35:11+05:00";
const updatedDate = "2026-07-15T13:35:11+05:00";

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "What is EST, EST meaning, Eastern Standard Time, EST explained, EST definition, EST time, EST timezone, EST UTC offset, UTC-5, Eastern Time, EST countries, EST states, EST vs EDT, EST vs UTC, GMT vs EST",
