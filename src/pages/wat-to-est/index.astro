          <text x="0" y="15" font-family="'Manrope', sans-serif" font-size="12" fill="#8fd7ff" text-anchor="middle">UTC+1</text>
          <text x="0" y="32" font-family="'Manrope', sans-serif" font-size="11" fill="#bdd2dc" text-anchor="middle">Lagos / Luanda</text>
        </g>
        <!-- Arrow + Offset -->
        <g transform="translate(300, 120)">
          <line x1="-50" y1="0" x2="50" y2="0" stroke="#36c7b5" stroke-width="3" stroke-dasharray="6,4"/>
          <polygon points="45,-6 55,0 45,6" fill="#36c7b5"/>
          <rect x="-45" y="-22" width="90" height="24" fill="#1b536e" rx="4"/>
          <text x="0" y="-6" font-family="'Space Grotesk', sans-serif" font-weight="bold" font-size="12" fill="#36c7b5" text-anchor="middle">-6 Hours Behind</text>
