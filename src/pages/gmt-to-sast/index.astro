        <td>No</td>
        <td>Greenwich, Accra, Reykjavik</td>
      </tr>
      <tr>
        <td><strong>BST</strong></td>
        <td>British Summer Time</td>
        <td>UTC+1</td>
        <td>Yes (Summer)</td>
        <td>London, Edinburgh, Belfast</td>
      </tr>
      <tr>
        <td><strong>SAST</strong></td>
        <td>South Africa Standard Time</td>
        <td>UTC+2</td>
        <td>No</td>
        <td>Johannesburg, Cape Town, Pretoria</td>
      </tr>
      <tr>
        <td><strong>CAT</strong></td>
        <td>Central Africa Time</td>
