import { siteUrl } from "theme/i18n/config";

const lang = "en";
const dir = "ltr";
const slug = "usa-time-zones";
const seoTitle = "USA Time Zones Guide: US Time Zone Map & Offsets (2026)";
const pageDescription = "Learn about USA time zones and UTC offsets. Explore our US timezone map, state-by-state offsets, and Daylight Saving Time rules.";

const pubDate = "2026-07-15T14:39:52+05:00";
const updatedDate = "2026-07-15T14:39:52+05:00";

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "USA Time Zones, US Time Zones, Eastern Time, Central Time, Mountain Time, Pacific Time, Alaska Time, Hawaii Time, UTC Offsets, Daylight Saving Time",
  image: "/assets/usa-time-zones-map.svg", // Represented via inline SVGs
  imageAlt: "United States Time Zone Map Graphic",
  pubDate,
  updatedDate,
  author: "Jackie Bruce",
  faqs: [
    {
      q: "How many time zones does the United States have?",
      a: "The United States and its territories have nine officially recognized standard time zones. When counting the uninhabited island territories (like Wake Island and Howland Island), the U.S. spans a total of eleven time zones."
    },
    {
      q: "What are the six primary U.S. time zones?",
      a: "The six primary time zones observed in the 50 states are: Eastern Time (ET), Central Time (CT), Mountain Time (MT), Pacific Time (PT), Alaska Time (AKT), and Hawaii–Aleutian Time (HAT)."
    },
    {
      q: "Which states span multiple time zones?",
      a: "Thirteen states span multiple time zones: Florida, Indiana, Kentucky, Tennessee, Michigan, Nebraska, South Dakota, North Dakota, Kansas, Idaho, Oregon, Texas, and Alaska."
    },
    {
      q: "Does Arizona observe Daylight Saving Time?",
      a: "No. The state of Arizona (except for the Navajo Nation) does not observe Daylight Saving Time. It remains on Mountain Standard Time (MST, UTC-7) year-round."
    },
    {
      q: "Does Hawaii observe Daylight Saving Time?",
      a: "No. Hawaii does not observe Daylight Saving Time. It remains on Hawaii Standard Time (HST, UTC-10) year-round due to its tropical latitude, which experiences minimal daylight variations."
    },
    {
      q: "What is the difference between Eastern Standard Time (EST) and Eastern Daylight Time (EDT)?",
      a: "EST stands for Eastern Standard Time (UTC-5), which is observed during the winter months. EDT stands for Eastern Daylight Time (UTC-4), observed during the spring and summer when Daylight Saving Time is active."
    },
    {
      q: "Which U.S. territories have their own time zones?",
      a: "Five major U.S. territories use separate time zones: Puerto Rico and the U.S. Virgin Islands (Atlantic Time, UTC-4), Guam and the Northern Mariana Islands (Chamorro Time, UTC+10), and American Samoa (Samoa Time, UTC-11)."
    },
    {
      q: "Who regulates time zones in the United States?",
      a: "The U.S. Department of Transportation (DOT) has federal authority over timezone boundaries and Daylight Saving Time regulation. This dates back to the Standard Time Act of 1918 and the Uniform Time Act of 1966."
    },
    {
      q: "What are the start and end dates for U.S. Daylight Saving Time?",
      a: "U.S. Daylight Saving Time begins on the second Sunday of March (spring forward one hour) and ends on the first Sunday of November (fall back one hour)."
    },
    {
      q: "Why is Indiana divided into multiple time zones?",
      a: "Indiana's position on the border of the Eastern and Central zones historically created local division. Today, 80 counties observe Eastern Time, while 12 counties (situated near Chicago or Evansville) observe Central Time."
    },
    {
      q: "What timezone does Puerto Rico use?",
      a: "Puerto Rico uses Atlantic Standard Time (AST, UTC-4) year-round. It does not observe Daylight Saving Time, keeping its clocks aligned with the Caribbean region."
    },
    {
      q: "What timezone is Chamorro Time?",
      a: "Chamorro Standard Time (ChST) is UTC+10, observed in Guam and the Northern Mariana Islands. It is the furthest U.S. timezone ahead of UTC, earning Guam the slogan 'Where America's Day Begins.'"
    },
    {
      q: "Does Alaska observe Daylight Saving Time?",
      a: "Yes. Most of Alaska observes Alaska Daylight Time (AKDT, UTC-8) in the summer and Alaska Standard Time (AKST, UTC-9) in the winter. The western Aleutian Islands observe Hawaii-Aleutian Daylight Time (HADT, UTC-9) and Standard Time (HAST, UTC-10)."
    },
    {
      q: "What is the Sunshine Protection Act?",
      a: "The Sunshine Protection Act is a proposed U.S. federal bill that would make Daylight Saving Time permanent nationwide, eliminating the twice-yearly clock changes. As of 2026, it has not been signed into law."
    },
    {
      q: "Which timezone is UTC-8 in the United States?",
      a: "UTC-8 is Pacific Standard Time (PST), observed in states like California and Washington during winter. In summer, Pacific Daylight Time (PDT) is UTC-7, and Alaska Standard Time (AKST) is UTC-9."
    },
    {
      q: "How does the Navajo Nation handle Daylight Saving Time in Arizona?",
      a: "The Navajo Nation observes Daylight Saving Time (switching to MDT, UTC-6 in summer), while the rest of Arizona remains on MST (UTC-7). The Hopi Reservation, which lies entirely within the Navajo Nation, does not observe DST."
    },
    {
      q: "What timezone does Wake Island use?",
      a: "Wake Island, an uninhabited U.S. territory, observes Wake Island Time (WAKT, UTC+12), which is the earliest timezone under U.S. jurisdiction."
    },
    {
      q: "How do U.S. financial markets handle timezone differences?",
      a: "Major financial markets (like the New York Stock Exchange) operate from 9:30 AM to 4:00 PM Eastern Time. West Coast brokers must begin work at 6:30 AM Pacific Time to align with market hours."
    },
    {
      q: "What is the standard formatting for U.S. date-times in databases?",
      a: "Databases store time in Coordinated Universal Time (UTC) using ISO 8601 formatting: `YYYY-MM-DDTHH:MM:SSZ`. Local application layers translate this to U.S. timezones (e.g. `America/New_York`) for rendering."
    },
    {
      q: "How does the Department of Transportation evaluate timezone boundary changes?",
      a: "The DOT evaluates requests from state or local governments based on 'convenience of commerce.' This includes looking at transportation patterns, television signals, and regional business integration."
    },
    {
      q: "What timezone does El Paso, Texas observe?",
      a: "El Paso observations are on Mountain Standard Time (MST, UTC-7) and Mountain Daylight Time (MDT, UTC-6) because of its geographical proximity and economic ties to New Mexico and Ciudad Juárez, Mexico. The rest of Texas observes Central Time."
    },
    {
      q: "Which timezone is observed in the Florida Panhandle?",
      a: "The Florida Panhandle (west of the Apalachicola River) observes Central Standard Time (CST, UTC-6) and Central Daylight Time (CDT, UTC-5). The rest of Florida (east of the river) uses Eastern Time."
    },
    {
      q: "What U.S. states do not adjust their clocks for Daylight Saving Time?",
      a: "Hawaii and Arizona (except for the Navajo Nation) do not adjust their clocks. They remain on Hawaii Standard Time (HST, UTC-10) and Mountain Standard Time (MST, UTC-7) year-round."
    },
    {
      q: "What timezone is observed in the U.S. Virgin Islands?",
      a: "The U.S. Virgin Islands observe Atlantic Standard Time (AST, UTC-4) year-round. They do not participate in Daylight Saving Time clock shifts."
    },
    {
      q: "How many time zones does Canada share with the United States?",
      a: "Canada and the United States share six major time zones: Atlantic Time, Eastern Time, Central Time, Mountain Time, Pacific Time, and Alaska Time (referred to as Yukon Standard Time in parts of northern Canada)."
    },
    {
      q: "Why does the western part of South Dakota use Mountain Time?",
      a: "Western South Dakota uses Mountain Time because of its historical mining connections, geographic barriers (divided by the Missouri River), and ties to Colorado and Wyoming. The eastern part uses Central Time."
    },
    {
      q: "What timezone is observed in Guam?",
      a: "Guam observes Chamorro Standard Time (ChST, UTC+10) year-round. It is the easternmost timezone under U.S. flag jurisdiction, situated 15 hours ahead of Eastern Standard Time."
    },
    {
      q: "What timezone does Samoa Standard Time represent?",
      a: "Samoa Standard Time (SST) represents UTC-11. It is observed year-round in American Samoa and is one of the furthest time zones behind Coordinated Universal Time."
    },
    {
      q: "How does daylight saving time affect business scheduling in Arizona?",
      a: "During the winter, Arizona shares the same time as Mountain Standard Time (MST) states (like Colorado). In the summer, Arizona matches Pacific Daylight Time (PDT) clocks (like California) because it does not advance its clocks, which changes meeting alignments."
    }
  ]
