---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import { siteUrl } from "theme/i18n/config";

const lang = "en";
const dir = "ltr";
const slug = "brazil-time-zones";
const seoTitle = "Brazil Time Zones Guide: Map, BRT Offset & Rules (2026)";
const pageDescription = "Explore Brazil time zones map, state offsets, Brasília Time (BRT, UTC-3), Amazon Time, Acre Time, and why Brazil abolished Daylight Saving Time.";

const pubDate = "2026-07-30T15:00:00+05:00";
const updatedDate = "2026-07-30T15:00:00+05:00";

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "Brazil Time Zones, Brasilia Time, BRT, Brazil Time Zone Map, UTC-3, UTC-4, UTC-2, UTC-5, Brazil Time, Sao Paulo Time, Rio de Janeiro Time, Brazil Daylight Saving Time",
  image: "/assets/brazil-time-zone-map.webp",
  imageAlt: "Brazil Time Zones Map Graphic showing 4 timezone boundaries",
  pubDate,
  updatedDate,
  author: "Jackie Bruce",
  faqs: [
    {
      q: "How many time zones does Brazil have?",
      a: "Brazil has four official time zones on its territory, ranging from UTC-2 in the Atlantic offshore islands to UTC-5 in the far western state of Acre."
    },
    {
      q: "What is Brasília Time (BRT)?",
      a: "Brasília Time (BRT) is the primary official time zone of Brazil, calculated at UTC-3. It covers the capital city of Brasília, as well as the populous South, Southeast, and Northeast regions, including São Paulo and Rio de Janeiro."
    },
    {
      q: "Does Brazil observe Daylight Saving Time?",
      a: "No. Brazil abolished Daylight Saving Time (DST) nationwide in April 2019 under Decree No. 9,772. All four Brazilian time zones maintain year-round fixed standard offsets."
    },
    {
      q: "What are the four time zones of Brazil?",
      a: "The four time zones are: 1) Fernando de Noronha Time (FNT, UTC-2), 2) Brasília Time (BRT, UTC-3), 3) Amazon Time (AMT, UTC-4), and 4) Acre Time (ACT, UTC-5)."
    },
    {
      q: "What states are in Amazon Time (AMT, UTC-4)?",
      a: "Amazon Time covers the states of Amazonas (eastern portion), Mato Grosso, Mato Grosso do Sul, Rondônia, and Roraima."
    },
    {
      q: "What region is in Acre Time (ACT, UTC-5)?",
      a: "Acre Time covers the state of Acre and 13 municipalities in the extreme western part of Amazonas state (including Eirunepé and Envira)."
    },
    {
      q: "What islands are in Fernando de Noronha Time (FNT, UTC-2)?",
      a: "Fernando de Noronha Time covers the Atlantic oceanic archipelagos: Fernando de Noronha, Trindade, Martim Vaz, Rocas Atoll, and Saint Peter and Saint Paul Archipelago."
    },
    {
      q: "Why did Brazil abolish Daylight Saving Time?",
      a: "Brazil abolished DST because government studies showed that modern electricity consumption patterns (driven by air conditioning and electronic devices rather than evening lighting) meant DST no longer produced significant energy savings, while causing disruption to body sleep cycles."
    },
    {
      q: "What is the time difference between São Paulo and New York?",
      a: "During US winter (EST, UTC-5), São Paulo (BRT, UTC-3) is 2 hours ahead of New York. During US summer (EDT, UTC-4), São Paulo is 1 hour ahead of New York."
    },
    {
      q: "What is the time difference between Brasília and London?",
      a: "During UK winter (GMT, UTC+0), Brasília (BRT, UTC-3) is 3 hours behind London. During UK summer (BST, UTC+1), Brasília is 4 hours behind London."
    },
    {
      q: "What is the IANA time zone identifier for São Paulo and Brasília?",
      a: "The primary IANA time zone identifier for official Brazilian time is `America/Sao_Paulo`."
    },
    {
      q: "Did Acre Time ever change its offset?",
      a: "Yes. In 2008, Law No. 11,662 abolished UTC-5 and moved Acre to UTC-4. However, following strong local dissatisfaction and a referendum in 2010, the National Congress passed Law No. 12,872, restoring Acre Time to UTC-5 in November 2013."
    },
    {
      q: "What are the stock trading hours of B3 in São Paulo?",
      a: "B3 (Brasil, Bolsa, Balcão) in São Paulo operates stock trading from 10:00 to 17:00 BRT, with adjusted closing auctions aligning seasonally with Wall Street."
    },
    {
      q: "What is the solar time difference across Brazil?",
      a: "The natural solar time difference between Ponta do Seixas in Paraíba (34°47' W) and the Serra do Divisor in Acre (73°59' W) is approximately 2.6 hours."
    },
    {
      q: "What percentage of Brazil's population lives in Brasília Time (BRT)?",
      a: "Approximately 93% of Brazil's population resides within the Brasília Time (UTC-3) zone, including major urban metropolitan areas like São Paulo, Rio de Janeiro, Belo Horizonte, Salvador, Recife, and Porto Alegre."
    },
    {
      q: "Does Manaus observe Amazon Time?",
      a: "Yes. Manaus, the capital of Amazonas state, observes Amazon Time (AMT, UTC-4) year-round."
    },
    {
      q: "What is the time difference between Brazil (BRT) and Tokyo?",
      a: "Tokyo (JST, UTC+9) is 12 hours ahead of Brasília Time (BRT, UTC-3) year-round."
    },
    {
      q: "What is the best time for business calls between São Paulo and New York?",
      a: "Because São Paulo and New York are separated by only 1 to 2 hours, business schedules overlap virtually all day from 09:00 to 17:00."
    },
    {
      q: "How do Brazilian TV networks broadcast live events across time zones?",
      a: "National television networks (like TV Globo) broadcast live news and sporting events simultaneously. Regional affiliates in Manaus (UTC-4) and Rio Branco (UTC-5) tape-delay non-live entertainment programming to match local evening prime time."
    },
    {
      q: "How should software developers configure timezone rules for Brazil?",
      a: "Developers should specify exact regional IANA identifiers such as `America/Sao_Paulo`, `America/Manaus`, `America/Rio_Branco`, and `America/Noronha` rather than hardcoding static offsets."
    }
  ]
};

const pageUrlPath = `${siteUrl}/brazil-time-zones/`;

const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    "@id": `${pageUrlPath}#article`,
    "mainEntityOfPage": pageUrlPath,
    "headline": seoTitle,
    "description": pageDescription,
    "datePublished": pubDate,
    "dateModified": updatedDate,
    "inLanguage": "en",
    "author": {
      "@type": "Person",
      "name": "Jackie Bruce",
      "jobTitle": "Senior Time Zone Analyst",
      "url": `${siteUrl}/author/jackie-bruce/`
    },
    "publisher": {
      "@type": "Organization",
      "name": "GMT to EST Converter",
      "logo": {
        "@type": "ImageObject",
        "url": `${siteUrl}/logo.svg`
      }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "SpeakableSpecification",
    "cssSelector": [".speakable-headline", ".speakable-summary"]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": `${siteUrl}/`
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Brazil Time Zones Guide",
        "item": pageUrlPath
      }
    ]
  },
  ...["FNT", "BRT", "AMT", "ACT"].map((zone, idx) => ({
    "@context": "https://schema.org",
    "@type": "DefinedTerm",
    "@id": `${siteUrl}/#zone-br-${idx}`,
    "name": `${zone} Zone`,
    "description": `One of four official time zones observed across Brazil.`
  }))
];
---

<BaseLayout
  lang={lang}
  dir={dir}
  title={seoTitle}
  description={pageDescription}
  slug={slug}
  meta={meta}
  mode="gmt-est"
  enableFaqSchema={true}
  enableArticleSchema={true}
  allowAds={true}
  breadcrumbHomeLabel="Home"
  breadcrumbLabel="Brazil Time Zones Guide"
  hreflangCodes={["en"]}
>
  <script type="application/ld+json" set:html={JSON.stringify(schemas)} slot="head" />

  <!-- HERO & SUMMARY SECTION -->
  <section class="hero-banner" aria-labelledby="hero-title">
    <h1 id="hero-title" class="hero-banner-title speakable-headline">
      Brazil Time Zones Guide: <span class="gradient-text">BRT, Map &amp; State Offsets</span>
    </h1>
  </section>

  <div class="editorial-meta-bar" aria-label="Editorial metadata">
    <span>Last Updated: <strong>July 30, 2026</strong></span>
    <span class="separator" aria-hidden="true">•</span>
    <span>Editorially Reviewed by <a href="/author/jackie-bruce/"><strong>Jackie Bruce</strong></a></span>
    <span class="separator" aria-hidden="true">•</span>
    <span>Data Source: <a href="https://www.on.br" target="_blank" rel="noopener noreferrer"><strong>Observatório Nacional (Brazil)</strong></a></span>
  </div>

  <section class="acdt-intro content-section" aria-label="Quick Guide Summary">
    <div class="info-callout speakable-summary" style="background: var(--panel); border-left: 4px solid var(--accent); padding: 1.5rem; margin-bottom: 2rem; border-radius: 6px;">
      <h3 style="margin-top: 0;">Quick Summary: How Many Time Zones Does Brazil Have?</h3>
      <p>
        <strong>Brazil is divided into four official time zones:</strong>
      </p>
      <ol style="margin-bottom: 0;">
        <li><strong>Fernando de Noronha Time (FNT, UTC-2):</strong> Atlantic islands.</li>
        <li><strong>Brasília Time (BRT, UTC-3):</strong> Capital, São Paulo, Rio de Janeiro, Northeast, South &amp; Southeast (~93% of population).</li>
        <li><strong>Amazon Time (AMT, UTC-4):</strong> Amazonas, Mato Grosso, Mato Grosso do Sul, Rondônia, Roraima.</li>
        <li><strong>Acre Time (ACT, UTC-5):</strong> Acre state and extreme western Amazonas.</li>
      </ol>
      <p style="margin-top: 0.8rem;">
        Brazil <strong>does not observe Daylight Saving Time (DST)</strong> anywhere in the country, having abolished seasonal clock changes in 2019.
      </p>
    </div>

    <div class="reading-meta" style="margin-top: 1rem; color: var(--muted); font-size: 0.9rem;">
      <span>⏱️ Estimated Reading Time: <strong>23 minutes</strong></span>
    </div>
  </section>

  <!-- TABLE OF CONTENTS -->
  <section class="table-of-contents reveal" aria-label="Table of Contents" style="background: var(--panel); padding: 1.5rem; border-radius: 8px; margin: 2rem 0;">
    <span class="toc-kicker" style="font-weight: bold; color: var(--accent); text-transform: uppercase; font-size: 0.85rem;">Detailed Navigation</span>
    <h2 style="margin-top: 0.5rem;">Guide Contents</h2>
    <ol style="line-height: 1.8;">
      <li><a href="#overview-brazil-time-zones">1. Overview of Brazil's Four Time Zones</a></li>
      <li><a href="#brasilia-time-brt">2. Brasília Time (BRT, UTC-3) — The National Standard</a></li>
      <li><a href="#amazon-acre-noronha-zones">3. Amazon, Acre &amp; Fernando de Noronha Time Zones</a></li>
      <li><a href="#abolition-of-dst-brazil">4. Abolition of Daylight Saving Time in 2019</a></li>
      <li><a href="#state-by-state-breakdown">5. State-by-State Time Zone Reference Table</a></li>
      <li><a href="#brazil-vs-world-table">6. Brazil vs World Time Zones Comparison Table</a></li>
      <li><a href="#business-b3-stock">7. Business Overlap &amp; Trading Hours (B3 São Paulo)</a></li>
      <li><a href="#developer-guide-brazil">8. Developer Guide: Handling Brazilian IANA Keys</a></li>
      <li><a href="#frequently-asked-questions">9. Frequently Asked Questions (20 FAQs)</a></li>
    </ol>
  </section>

  <!-- SVG DIAGRAM -->
  <section class="content-section" aria-label="Brazil Time Zone Map Diagram">
    <h2>Brazil's 4 Time Zone Boundaries</h2>
    <p>
      The diagram below illustrates the geographic distribution of Brazil's 4 time zones across its oceanic islands, coastal cities, Amazon basin, and western border.
    </p>

    <div class="svg-container" style="width: 100%; overflow-x: auto; text-align: center; margin: 2rem 0;">
      <svg viewBox="0 0 800 300" width="100%" height="auto" xmlns="http://www.w3.org/2000/svg" style="background: var(--panel); border-radius: 8px; padding: 1rem; border: 1px solid var(--line, #333);">
        <text x="400" y="30" fill="currentColor" text-anchor="middle" font-size="18" font-weight="bold">Brazil's 4 Official Time Zones (East to West)</text>
        
        <g transform="translate(50, 70)">
          <!-- FNT UTC-2 -->
          <rect x="0" y="0" width="140" height="50" fill="#f59e0b" rx="4" />
          <text x="70" y="22" fill="#000" text-anchor="middle" font-size="12" font-weight="bold">FNT (UTC-2)</text>
          <text x="70" y="38" fill="#000" text-anchor="middle" font-size="11">Noronha Islands</text>
          
          <!-- BRT UTC-3 -->
          <rect x="150" y="0" width="220" height="50" fill="#10b981" rx="4" />
          <text x="260" y="22" fill="#fff" text-anchor="middle" font-size="13" font-weight="bold">BRT (UTC-3) — Capital Standard</text>
          <text x="260" y="38" fill="#fff" text-anchor="middle" font-size="11">São Paulo, Rio, Brasília (~93% Pop)</text>
          
          <!-- AMT UTC-4 -->
          <rect x="380" y="0" width="190" height="50" fill="#3b82f6" rx="4" />
          <text x="475" y="22" fill="#fff" text-anchor="middle" font-size="12" font-weight="bold">AMT (UTC-4)</text>
          <text x="475" y="38" fill="#fff" text-anchor="middle" font-size="11">Amazonas, Manaus, MT, MS</text>
          
          <!-- ACT UTC-5 -->
          <rect x="580" y="0" width="120" height="50" fill="#8b5cf6" rx="4" />
          <text x="640" y="22" fill="#fff" text-anchor="middle" font-size="12" font-weight="bold">ACT (UTC-5)</text>
          <text x="640" y="38" fill="#fff" text-anchor="middle" font-size="11">Acre &amp; West AM</text>
        </g>

        <rect x="50" y="160" width="700" height="90" fill="var(--panel)" stroke="var(--line, #444)" rx="6" />
        <text x="70" y="185" fill="currentColor" font-size="13" font-weight="bold">Key Status:</text>
        <text x="70" y="210" fill="currentColor" font-size="12">• Presidential Decree No. 9,772 abolished Daylight Saving Time in 2019</text>
        <text x="70" y="230" fill="currentColor" font-size="12">• All four zones maintain fixed year-round standard time</text>
      </svg>
    </div>
  </section>

  <!-- SECTION 1 -->
  <section id="overview-brazil-time-zones" class="content-section">
    <h2>1. Overview of Brazil's Four Time Zones</h2>
    <p>
      Brazil spans over 4,300 kilometers from east to west, across South America's central and eastern regions. Because of this vast longitudinal width, the nation is divided into four standard time zones regulated by the national observatory, <em>Observatório Nacional</em>.
    </p>
    <p>
      To check exact conversions between Brazil and North America, see our converters for <a href="/gmt-to-est/">GMT to EST</a>, <a href="/est-to-gmt/">EST to GMT</a>, and <a href="/gmt-vs-est/">GMT vs EST</a>.
    </p>
  </section>

  <!-- SECTION 2 -->
  <section id="brasilia-time-brt" class="content-section">
    <h2>2. Brasília Time (BRT, UTC-3) — The National Standard</h2>
    <p>
      Brasília Time (BRT) is set at <strong>UTC-3</strong> and serves as the official national standard time for federal legislation, financial markets, government broadcasts, and air traffic control.
    </p>
    <p>
      It encompasses the capital district of Brasília, along with the heavily populated South (Rio Grande do Sul, Santa Catarina, Paraná), Southeast (São Paulo, Rio de Janeiro, Minas Gerais, Espírito Santo), and Northeast regions.
    </p>
  </section>

  <!-- SECTION 3 -->
  <section id="amazon-acre-noronha-zones" class="content-section">
    <h2>3. Amazon, Acre &amp; Fernando de Noronha Time Zones</h2>
    <p>
      The remaining three time zones cover specialized regional geographies:
    </p>
    <ul>
      <li><strong>Fernando de Noronha Time (FNT, UTC-2):</strong> Covers Brazil's Atlantic islands, located 354 km off the northeastern coast.</li>
      <li><strong>Amazon Time (AMT, UTC-4):</strong> Covers the vast Amazon rainforest interior, including the capital city of Manaus.</li>
      <li><strong>Acre Time (ACT, UTC-5):</strong> Covers Acre state on the Peruvian border and westernmost municipalities of Amazonas state.</li>
    </ul>
  </section>

  <!-- SECTION 4 -->
  <section id="abolition-of-dst-brazil" class="content-section">
    <h2>4. Abolition of Daylight Saving Time in 2019</h2>
    <p>
      Between 1931 and 2019, Brazil used seasonal Daylight Saving Time in its southern and central states. However, in April 2019, President Jair Bolsonaro signed Decree No. 9,772, ending DST permanently.
    </p>
    <p>
      Technical analyses from the Ministry of Mines and Energy demonstrated that changing clocks provided less than 0.5% energy savings due to widespread air conditioning adoption, while creating sleep disruption.
    </p>
  </section>

  <!-- SECTION 5 -->
  <section id="state-by-state-breakdown" class="content-section">
    <h2>5. State-by-State Time Zone Reference Table</h2>
    <table class="data-table" style="width: 100%; border-collapse: collapse; margin: 1.5rem 0;">
      <thead>
        <tr style="background: var(--panel); border-bottom: 2px solid var(--line);">
          <th style="padding: 10px; text-align: left;">Time Zone Name</th>
          <th style="padding: 10px; text-align: left;">Standard Offset</th>
          <th style="padding: 10px; text-align: left;">States / Regions Included</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Fernando de Noronha (FNT)</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">UTC-2</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Fernando de Noronha, Trindade, Martim Vaz</td>
        </tr>
        <tr>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Brasília Time (BRT)</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">UTC-3</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">DF, SP, RJ, MG, ES, PR, SC, RS, GO, TO, BA, SE, AL, PE, PB, RN, CE, PI, MA, PA, AP</td>
        </tr>
        <tr>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Amazon Time (AMT)</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">UTC-4</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">AM (eastern), MT, MS, RO, RR</td>
        </tr>
        <tr>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Acre Time (ACT)</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">UTC-5</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">AC, AM (western municipalities)</td>
        </tr>
      </tbody>
    </table>
  </section>

  <!-- SECTION 6 -->
  <section id="brazil-vs-world-table" class="content-section">
    <h2>6. Brazil vs World Time Zones Comparison Table</h2>
    <p>
      Compare Brasília Time (BRT, UTC-3) with major financial centers worldwide:
    </p>
    <table class="data-table" style="width: 100%; border-collapse: collapse; margin: 1.5rem 0;">
      <thead>
        <tr style="background: var(--panel); border-bottom: 2px solid var(--line);">
          <th style="padding: 10px; text-align: left;">City / Country</th>
          <th style="padding: 10px; text-align: left;">US/UK Winter Difference vs BRT</th>
          <th style="padding: 10px; text-align: left;">US/UK Summer Difference vs BRT</th>
          <th style="padding: 10px; text-align: left;">Tool / Guide</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">New York (US East)</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">São Paulo is 2 hours ahead</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">São Paulo is 1 hour ahead</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);"><a href="/gmt-to-est/">GMT to EST Converter</a></td>
        </tr>
        <tr>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">London (UK)</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">São Paulo is 3 hours behind</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">São Paulo is 4 hours behind</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);"><a href="/united-kingdom-time-zone/">UK Time Zone Guide</a></td>
        </tr>
        <tr>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Tokyo (Japan)</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Tokyo is 12 hours ahead</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Tokyo is 12 hours ahead</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);"><a href="/japan-time-zone/">Japan Time Zone Guide</a></td>
        </tr>
      </tbody>
    </table>
  </section>

  <!-- SECTION 7 -->
  <section id="business-b3-stock" class="content-section">
    <h2>7. Business Overlap &amp; Trading Hours (B3 São Paulo)</h2>
    <p>
      The B3 stock exchange in São Paulo is the largest equity market in Latin America. Operating trading sessions from 10:00 to 17:00 BRT, B3 shares almost complete business day alignment with New York financial institutions.
    </p>
  </section>

  <!-- SECTION 8 -->
  <section id="developer-guide-brazil" class="content-section">
    <h2>8. Developer Guide: Handling Brazilian IANA Keys</h2>
    <p>
      Software systems targeting Brazilian users should utilize exact IANA timezone keys:
    </p>
    <ul>
      <li><code>America/Sao_Paulo</code> (BRT, UTC-3)</li>
      <li><code>America/Manaus</code> (AMT, UTC-4)</li>
      <li><code>America/Rio_Branco</code> (ACT, UTC-5)</li>
      <li><code>America/Noronha</code> (FNT, UTC-2)</li>
    </ul>
  </section>

  <!-- SECTION 9: FAQS -->
  <section id="frequently-asked-questions" class="content-section">
    <h2>9. Frequently Asked Questions</h2>
    <div class="faq-accordion">
      {meta.faqs.map((faq) => (
        <details class="faq-item" style="margin-bottom: 1rem; padding: 1rem; background: var(--panel); border-radius: 6px;">
          <summary style="font-weight: bold; cursor: pointer; font-size: 1.1rem; color: var(--accent);">
            {faq.q}
          </summary>
          <p style="margin-top: 0.8rem; line-height: 1.6;">
            {faq.a}
          </p>
        </details>
      ))}
    </div>
  </section>
</BaseLayout>
