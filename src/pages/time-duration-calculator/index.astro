---
import BaseLayout from "theme/layouts/BaseLayout.astro";

const lang = "en";
const dir = "ltr";
const slug = "time-duration-calculator";
const seoTitle = "Time Duration Calculator – Hours, Minutes & Seconds";
const pageDescription = "Calculate duration between two dates and times in days, hours, minutes, and seconds. View decimal hours, time breakdowns, and multi-day shift intervals.";

const pubDate = "2026-10-25T13:00:00+05:00";
const updatedDate = "2026-10-25T14:20:00+05:00";

const meta = {
  seoTitle,
  exactTitle: true,
  description: pageDescription,
  keywords: "time duration calculator, calculate time duration, hours between two times, elapsed time calculator, decimal hours calculator, time difference calculator",
  pubDate,
  updatedDate,
  author: "Time Intelligence Team",
  faqs: [
    {
      q: "How do I calculate hours between two times?",
      a: "Subtract the start time from the end time on the same day by converting both to minutes from midnight. If the range spans multiple days or crosses midnight, include the start and end dates as well."
    },
    {
      q: "What if the end time is past midnight?",
      a: "Set the end date to the following day. An overnight span from 22:00 to 06:00 is 8 hours only when the end date is the next calendar day. On the same date, 06:00 is earlier than 22:00 and triggers a validation error."
    },
    {
      q: "Does daylight saving time change the result?",
      a: "This calculator uses your browser's local time zone and date arithmetic. A span that crosses a clock change (such as springing forward in spring or falling back in autumn) reflects local wall-clock difference, while physical elapsed time may differ by one hour on that specific night."
    },
    {
      q: "How do I convert minutes into decimal hours for payroll?",
      a: "Divide the minutes by 60 and add the result to the full hours. For example, 45 minutes equals 45 ÷ 60 = 0.75 decimal hours. Therefore, 8 hours and 45 minutes is 8.75 decimal hours."
    },
    {
      q: "What is the difference between 7.5 hours and 7 hours 50 minutes?",
      a: "7.5 hours means 7 hours and half an hour (30 minutes). In contrast, 7 hours 50 minutes equals 7 + (50 ÷ 60) ≈ 7.83 decimal hours. Confusing 7.5 hours with 7 hours 50 minutes is a common timesheet error."
    },
    {
      q: "What happens if the start and end dates and times are identical?",
      a: "If start and end timestamps are identical, the duration is zero. The calculator validates that the end time must be strictly after the start time, prompting you to enter a valid forward interval."
    },
    {
      q: "Can this calculator calculate time differences across different time zones?",
      a: "This tool calculates duration based on the dates and times you provide in a single timeline (your browser's local environment). For converting hours between two distinct international cities or time zones (such as London to New York), use our GMT to EST Converter."
    }
  ]
};
---

<BaseLayout
  lang={lang}
  dir={dir}
  title={seoTitle}
  description={pageDescription}
  slug={slug}
  meta={meta}
  enableFaqSchema={true}
  allowAds={true}
>
  <!-- WebApplication Schema -->
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Time Duration Calculator",
    "url": "https://gmttoestconverter.com/time-duration-calculator/",
    "applicationCategory": "UtilitiesApplication",
    "operatingSystem": "All",
    "description": pageDescription,
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
    "browserRequirements": "Requires JavaScript for live date-time recalculation"
  })}></script>

  <!-- Hero Header -->
  <div class="hero-banner">
    <h1 class="hero-banner-title">Time Duration Calculator</h1>
    <p style="color: #bdd2dc; font-size: clamp(1rem, 2.2vw, 1.25rem); max-width: 680px; margin: 12px auto 0;">
      Calculate the exact duration between two dates and times in days, hours, minutes, seconds, and decimal hours.
    </p>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════════════
       INTERACTIVE TOOL (PROMINENT ABOVE THE FOLD)
       ═══════════════════════════════════════════════════════════════════════ -->
  <section id="duration-calculator" style="max-width: 780px; margin: 0 auto; padding-top: 28px;">
    <div style="background: var(--panel); border: 1px solid var(--line); border-radius: 14px; padding: clamp(18px, 4vw, 28px); box-shadow: var(--shadow);">
      
      <!-- Input Grid: Start Date/Time & End Date/Time -->
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;" class="input-grid">
        <!-- Start Column -->
        <div style="display: flex; flex-direction: column; gap: 14px;">
          <div>
            <label for="tdc-start-date" style="display: block; font-weight: 700; color: var(--muted); margin-bottom: 6px; font-size: 0.95rem;">Start date</label>
            <input
              type="date"
              id="tdc-start-date"
              value="2026-10-25"
              aria-label="Start date"
              style="width: 100%; padding: 12px 14px; border-radius: 8px; border: 1px solid var(--line); background: var(--bg); color: var(--text); font-size: 1.05rem;"
            />
          </div>
          <div>
            <label for="tdc-start-time" style="display: block; font-weight: 700; color: var(--muted); margin-bottom: 6px; font-size: 0.95rem;">Start time</label>
            <input
              type="time"
              id="tdc-start-time"
              value="09:00"
              aria-label="Start time"
              style="width: 100%; padding: 12px 14px; border-radius: 8px; border: 1px solid var(--line); background: var(--bg); color: var(--text); font-size: 1.05rem;"
            />
          </div>
        </div>

        <!-- End Column -->
        <div style="display: flex; flex-direction: column; gap: 14px;">
          <div>
            <label for="tdc-end-date" style="display: block; font-weight: 700; color: var(--muted); margin-bottom: 6px; font-size: 0.95rem;">End date</label>
            <input
              type="date"
              id="tdc-end-date"
              value="2026-10-25"
              aria-label="End date"
              style="width: 100%; padding: 12px 14px; border-radius: 8px; border: 1px solid var(--line); background: var(--bg); color: var(--text); font-size: 1.05rem;"
            />
          </div>
          <div>
            <label for="tdc-end-time" style="display: block; font-weight: 700; color: var(--muted); margin-bottom: 6px; font-size: 0.95rem;">End time</label>
            <input
              type="time"
              id="tdc-end-time"
              value="17:30"
              aria-label="End time"
              style="width: 100%; padding: 12px 14px; border-radius: 8px; border: 1px solid var(--line); background: var(--bg); color: var(--text); font-size: 1.05rem;"
            />
          </div>
        </div>
      </div>

      <!-- Calculate Button -->
      <button
        type="button"
        id="tdc-calculate"
        style="width: 100%; padding: 14px; border-radius: 8px; border: none; background: var(--accent); color: #fff; font-weight: 800; font-size: 1.05rem; cursor: pointer; transition: background 0.2s; margin-bottom: 16px;"
      >
        Calculate
      </button>

      <!-- Error Message -->
      <p id="tdc-error" role="alert" style="display: none; color: #f87171; background: rgba(239, 68, 68, 0.15); border: 1px solid #ef4444; border-radius: 8px; padding: 10px 14px; font-weight: 700; text-align: center; margin: 0 0 14px;"></p>

      <!-- Result Block -->
      <div id="tdc-results" style="display: none;">
        <!-- 4-Pillar Metric Grid: Days, Hours, Minutes, Seconds -->
        <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-bottom: 16px;" class="result-grid">
          <div style="background: var(--bg); border: 1px solid var(--line); border-radius: 10px; padding: 14px 8px; text-align: center;">
            <span style="display: block; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); font-weight: 800; margin-bottom: 4px;">Days</span>
            <strong id="tdc-days" style="font-size: clamp(1.6rem, 3.5vw, 2.2rem); color: var(--accent); font-weight: 900; line-height: 1.1;">0</strong>
          </div>
          <div style="background: var(--bg); border: 1px solid var(--line); border-radius: 10px; padding: 14px 8px; text-align: center;">
            <span style="display: block; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); font-weight: 800; margin-bottom: 4px;">Hours</span>
            <strong id="tdc-hours" style="font-size: clamp(1.6rem, 3.5vw, 2.2rem); color: var(--text); font-weight: 900; line-height: 1.1;">0</strong>
          </div>
          <div style="background: var(--bg); border: 1px solid var(--line); border-radius: 10px; padding: 14px 8px; text-align: center;">
            <span style="display: block; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); font-weight: 800; margin-bottom: 4px;">Minutes</span>
            <strong id="tdc-minutes" style="font-size: clamp(1.6rem, 3.5vw, 2.2rem); color: var(--accent-2); font-weight: 900; line-height: 1.1;">0</strong>
          </div>
          <div style="background: var(--bg); border: 1px solid var(--line); border-radius: 10px; padding: 14px 8px; text-align: center;">
            <span style="display: block; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); font-weight: 800; margin-bottom: 4px;">Seconds</span>
            <strong id="tdc-seconds" style="font-size: clamp(1.6rem, 3.5vw, 2.2rem); color: var(--warn); font-weight: 900; line-height: 1.1;">0</strong>
          </div>
        </div>

        <!-- Breakdown Summary & Decimal Hours -->
        <div style="background: var(--bg); border: 1px solid var(--line); border-radius: 10px; padding: 16px 20px; text-align: center; margin-bottom: 12px;">
          <p id="tdc-breakdown-text" style="font-size: clamp(1.15rem, 2.8vw, 1.35rem); font-weight: 800; color: var(--accent-2); margin: 0 0 6px;">
            0 hours, 0 minutes
          </p>
          <p style="margin: 0; font-size: 0.95rem; color: var(--muted);">
            Total decimal hours: <strong id="tdc-decimal-hours" style="color: var(--text); font-size: 1.15rem; font-weight: 800;">0.00</strong> hours
          </p>
        </div>
      </div>

      <!-- Mandatory Plain Text Note Directly Under Result -->
      <p style="margin: 14px 0 0; font-size: 0.85rem; color: var(--muted); line-height: 1.6; text-align: center;">
        This calculator uses wall-clock time in your browser's time zone. A range that crosses a daylight saving change can gain or lose an hour in real elapsed time.
      </p>
    </div>
  </section>

  <!-- Hero Overview Image -->
  <div class="infographic-wrapper" style="margin-top: 36px;">
    <img
      src="/assets/time-duration-calculator-hero.webp"
      alt="Time duration calculator showing days, hours, minutes and seconds between two times"
      class="infographic-image"
      width="960"
      height="540"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <!-- ═══════════════════════════════════════════════════════════════════════
       SEMANTIC EDUCATIONAL CONTENT
       ═══════════════════════════════════════════════════════════════════════ -->
  <div style="max-width: 820px; margin: 0 auto; padding: 36px 0 0;">

    <!-- H2: How to calculate time duration -->
    <section>
      <h2 style="font-size: clamp(1.5rem, 3.5vw, 2.1rem); border-bottom: 1px solid var(--line); padding-bottom: 12px; margin-bottom: 18px;">
        How to calculate time duration
      </h2>
      <p style="color: var(--muted); line-height: 1.75; font-size: 1.05rem;">
        Calculating the elapsed time duration between a start date/time and an end date/time requires converting both timestamps into a single continuous scale, subtracting the start moment from the end moment, and decomposing the resulting duration into days, hours, minutes, and seconds.
      </p>
      
      <div style="background: var(--panel); border-left: 4px solid var(--accent); border-radius: 0 10px 10px 0; padding: 18px 20px; margin: 20px 0;">
        <h3 style="margin: 0 0 10px; font-size: 1.1rem; color: var(--accent);">The 4-Step Duration Algorithm:</h3>
        <ol style="margin: 0; padding-left: 20px; color: var(--text); line-height: 1.7; font-size: 0.95rem;">
          <li><strong>Convert to Common Units:</strong> Convert both timestamps into total minutes or milliseconds from midnight (or Unix epoch).</li>
          <li><strong>Subtract:</strong> Compute <code>Duration = End Timestamp − Start Timestamp</code>.</li>
          <li><strong>Extract Whole Units:</strong> Divide total minutes by 60 to determine full hours; the remainder gives leftover minutes.</li>
          <li><strong>Format:</strong> Express as a clock breakdown (e.g. 8h 30m) or convert to decimal hours for billing (8.50 hours).</li>
        </ol>
      </div>

      <p style="color: var(--muted); line-height: 1.75; font-size: 1.05rem;">
        Walk through our default worked example from <strong style="color: var(--text);">09:00</strong> to <strong style="color: var(--text);">17:30</strong> on the same calendar day:
      </p>
      <ul style="color: var(--muted); line-height: 1.75; padding-left: 24px; margin: 12px 0;">
        <li>Convert 09:00 to minutes: (9 hours × 60) + 0 = <strong style="color: var(--text);">540 minutes</strong>.</li>
        <li>Convert 17:30 to minutes: (17 hours × 60) + 30 = <strong style="color: var(--text);">1,050 minutes</strong>.</li>
        <li>Subtract start from end: 1,050 − 540 = <strong style="color: var(--accent);">510 elapsed minutes</strong>.</li>
        <li>Divide by 60: 510 ÷ 60 = 8 with a remainder of 30 → <strong style="color: var(--accent);">8 hours 30 minutes</strong>.</li>
      </ul>
    </section>

    <!-- Diagram 1: Calculation Breakdown -->
    <div class="infographic-wrapper">
      <figure style="margin: 0; text-align: center; width: 100%;">
        <img
          src="/assets/time-duration-calculation-example.webp"
          alt="Diagram breaking 8 hours 30 minutes into hours and minutes"
          class="infographic-image"
          width="800"
          height="450"
          loading="lazy"
          decoding="async"
        />
        <figcaption class="infographic-caption">09:00 to 17:30 is 8 hours 30 minutes (8.50 decimal hours).</figcaption>
      </figure>
    </div>

    <!-- H2: Understanding time breakdowns -->
    <section>
      <h2 style="font-size: clamp(1.5rem, 3.5vw, 2.1rem); border-bottom: 1px solid var(--line); padding-bottom: 12px; margin-bottom: 18px;">
        Understanding time breakdowns: Hours, minutes, seconds, and decimal hours
      </h2>
      <p style="color: var(--muted); line-height: 1.75; font-size: 1.05rem;">
        Duration is expressed in two primary formats depending on your planning needs:
      </p>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin: 20px 0;" class="format-grid">
        <div style="background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 18px;">
          <h3 style="margin-top: 0; color: var(--accent-2); font-size: 1.15rem;">Clock Format (Hours &amp; Minutes)</h3>
          <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6;">
            Used on digital clocks, flight itineraries, and sports events in base-60 increments:
          </p>
          <ul style="color: var(--muted); font-size: 0.9rem; line-height: 1.6; padding-left: 20px; margin: 8px 0 0;">
            <li>60 seconds = 1 minute</li>
            <li>60 minutes = 1 hour</li>
            <li>24 hours = 1 full day</li>
            <li>Example: <strong>8 hours 30 minutes 00 seconds</strong></li>
          </ul>
        </div>

        <div style="background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 18px;">
          <h3 style="margin-top: 0; color: var(--warn); font-size: 1.15rem;">Decimal Format (Base-10 Hours)</h3>
          <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6;">
            Used in payroll and billable hours where wage rates multiply against hours:
          </p>
          <ul style="color: var(--muted); font-size: 0.9rem; line-height: 1.6; padding-left: 20px; margin: 8px 0 0;">
            <li>Formula: <code>Hours + (Minutes / 60)</code></li>
            <li>30 minutes = 30 ÷ 60 = <strong>0.50 hours</strong></li>
            <li>Wage calc: 8.50 hrs × $40/hr = $340.00</li>
            <li>Example: <strong>8.50 decimal hours</strong></li>
          </ul>
        </div>
      </div>
    </section>

    <!-- H2: Decimal hours vs. clock time -->
    <section>
      <h2 style="font-size: clamp(1.5rem, 3.5vw, 2.1rem); border-bottom: 1px solid var(--line); padding-bottom: 12px; margin-bottom: 18px;">
        Decimal hours vs. clock time: 7.5 hours versus 7 hours 50 minutes
      </h2>
      <p style="color: var(--muted); line-height: 1.75; font-size: 1.05rem;">
        One of the most widespread accounting errors in timesheet submissions is confusing decimal portions of an hour with clock minutes. Specifically, <strong style="color: var(--text);">7.5 hours is NOT 7 hours and 50 minutes</strong>:
      </p>

      <ul style="color: var(--muted); line-height: 1.75; padding-left: 24px; margin: 12px 0;">
        <li><strong style="color: var(--accent);">7.50 decimal hours</strong> represents 7 hours plus 0.50 of an hour (half an hour), which equals <strong style="color: var(--accent);">7 hours 30 minutes</strong>.</li>
        <li><strong style="color: var(--warn);">7 hours 50 minutes</strong> represents 7 hours plus 50/60 of an hour (0.833), which equals <strong style="color: var(--warn);">7.83 decimal hours</strong>.</li>
      </ul>

      <p style="color: var(--muted); line-height: 1.75; font-size: 1.05rem;">
        Mistakenly logging 7 hours 50 minutes as 7.50 hours costs an employee 20 minutes (0.33 hours) of unpaid work! The reference chart below clarifies standard conversions:
      </p>

      <div class="table-wrap" style="margin: 18px 0;">
        <table>
          <thead>
            <tr>
              <th scope="col">Clock Minutes</th>
              <th scope="col">Decimal Fraction</th>
              <th scope="col">Worked Example (7 Hours)</th>
              <th scope="col">Payroll Representation</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>15 minutes</td>
              <td>15 ÷ 60 = <strong>0.25</strong></td>
              <td>7 hours 15 minutes</td>
              <td><strong>7.25 hours</strong></td>
            </tr>
            <tr>
              <td>30 minutes</td>
              <td>30 ÷ 60 = <strong>0.50</strong></td>
              <td>7 hours 30 minutes</td>
              <td><strong>7.50 hours</strong></td>
            </tr>
            <tr>
              <td>45 minutes</td>
              <td>45 ÷ 60 = <strong>0.75</strong></td>
              <td>7 hours 45 minutes</td>
              <td><strong>7.75 hours</strong></td>
            </tr>
            <tr>
              <td>10 minutes</td>
              <td>10 ÷ 60 = <strong>0.17</strong></td>
              <td>7 hours 10 minutes</td>
              <td><strong>7.17 hours</strong></td>
            </tr>
            <tr>
              <td>20 minutes</td>
              <td>20 ÷ 60 = <strong>0.33</strong></td>
              <td>7 hours 20 minutes</td>
              <td><strong>7.33 hours</strong></td>
            </tr>
            <tr>
              <td>40 minutes</td>
              <td>40 ÷ 60 = <strong>0.67</strong></td>
              <td>7 hours 40 minutes</td>
              <td><strong>7.67 hours</strong></td>
            </tr>
            <tr>
              <td>50 minutes</td>
              <td>50 ÷ 60 = <strong>0.83</strong></td>
              <td>7 hours 50 minutes</td>
              <td><strong>7.83 hours</strong></td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- H2: Overnight shifts and cross-midnight intervals -->
    <section>
      <h2 style="font-size: clamp(1.5rem, 3.5vw, 2.1rem); border-bottom: 1px solid var(--line); padding-bottom: 12px; margin-bottom: 18px;">
        Overnight shifts and intervals spanning multiple dates
      </h2>
      <p style="color: var(--muted); line-height: 1.75; font-size: 1.05rem;">
        Calculating durations that cross midnight (such as night shifts, red-eye flights, or server maintenance windows) requires accounting for the calendar day boundary.
      </p>
      <p style="color: var(--muted); line-height: 1.75; font-size: 1.05rem; margin-top: 12px;">
        For example, a hospital nurse beginning an overnight shift at <strong style="color: var(--text);">22:00 (10:00 PM)</strong> and ending at <strong style="color: var(--text);">06:00 (6:00 AM)</strong> works an 8-hour shift. However, clock time 06:00 is numerically smaller than 22:00. If both inputs share the same calendar date, the calculator evaluates 06:00 as having occurred 16 hours <em>prior</em> to 22:00, correctly triggering the validation error: <strong style="color: #f87171;">"End must be after start."</strong>
      </p>
      <p style="color: var(--muted); line-height: 1.75; font-size: 1.05rem; margin-top: 12px;">
        To calculate overnight shifts accurately, <strong style="color: var(--text);">set the End Date to the following calendar day</strong> (e.g., Start: October 25 at 22:00, End: October 26 at 06:00). The tool will output exactly <strong style="color: var(--accent);">8 hours 00 minutes (8.00 decimal hours)</strong>.
      </p>
    </section>

    <!-- Diagram 2: Shift Comparison -->
    <div class="infographic-wrapper">
      <figure style="margin: 0; text-align: center; width: 100%;">
        <img
          src="/assets/time-duration-shift-example.webp"
          alt="Same-Day vs. Overnight Work Shifts comparison"
          class="infographic-image"
          width="800"
          height="450"
          loading="lazy"
          decoding="async"
        />
        <figcaption class="infographic-caption">Overnight shifts cross midnight and require incrementing the end date.</figcaption>
      </figure>
    </div>

    <!-- H2: Time duration examples -->
    <section>
      <h2 style="font-size: clamp(1.5rem, 3.5vw, 2.1rem); border-bottom: 1px solid var(--line); padding-bottom: 12px; margin-bottom: 18px;">
        Time duration examples
      </h2>
      <p style="color: var(--muted); line-height: 1.75; font-size: 1.05rem; margin-bottom: 16px;">
        The verified reference table below demonstrates accurate time intervals across everyday work shifts, overnight intervals, and multi-week projects:
      </p>
      
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">Start Date &amp; Time</th>
              <th scope="col">End Date &amp; Time</th>
              <th scope="col">Duration Breakdown</th>
              <th scope="col">Total Decimal Hours</th>
              <th scope="col">Practical Scenario</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>25 October 2026, 09:00</td>
              <td>25 October 2026, 17:30</td>
              <td><strong>8 hours 30 minutes</strong></td>
              <td><strong>8.50 hours</strong></td>
              <td>Standard corporate workday</td>
            </tr>
            <tr>
              <td>25 October 2026, 22:00</td>
              <td>26 October 2026, 06:00</td>
              <td><strong>8 hours 00 minutes</strong></td>
              <td><strong>8.00 hours</strong></td>
              <td>Overnight medical/security shift</td>
            </tr>
            <tr>
              <td>25 October 2026, 09:00</td>
              <td>27 November 2026, 09:00</td>
              <td><strong>33 days</strong></td>
              <td><strong>792.00 hours</strong></td>
              <td>Multi-week contractual milestone</td>
            </tr>
            <tr>
              <td>26 October 2026, 08:30</td>
              <td>30 October 2026, 17:00</td>
              <td><strong>4 days, 8 hours, 30 min</strong></td>
              <td><strong>104.50 hours</strong></td>
              <td>Full 5-day on-call deployment</td>
            </tr>
            <tr>
              <td>15 November 2026, 14:15</td>
              <td>15 November 2026, 23:45</td>
              <td><strong>9 hours 30 minutes</strong></td>
              <td><strong>9.50 hours</strong></td>
              <td>Transcontinental flight + layover</td>
            </tr>
            <tr>
              <td>10 December 2026, 10:15</td>
              <td>10 December 2026, 11:45</td>
              <td><strong>1 hour 30 minutes</strong></td>
              <td><strong>1.50 hours</strong></td>
              <td>Quarterly board meeting block</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- H2: Practical applications -->
    <section>
