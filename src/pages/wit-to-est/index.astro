          <circle cx="0" cy="0" r="7" fill="#36c7b5" />
          <text x="0" y="-18" font-family="'Space Grotesk', sans-serif" font-size="10" font-weight="bold" fill="#bdd2dc" text-anchor="middle">8 AM WIT</text>
          <text x="0" y="26" font-family="'Manrope', sans-serif" font-size="10" fill="#8fd7ff" text-anchor="middle">6 PM EST (-1)</text>
        </g>
        <g transform="translate(280, 48)">
          <circle cx="0" cy="0" r="7" fill="#36c7b5" />
          <text x="0" y="-18" font-family="'Space Grotesk', sans-serif" font-size="10" font-weight="bold" fill="#bdd2dc" text-anchor="middle">2 PM WIT</text>
          <text x="0" y="26" font-family="'Manrope', sans-serif" font-size="10" fill="#8fd7ff" text-anchor="middle">12 AM EST</text>
        </g>
        <g transform="translate(500, 48)">
          <circle cx="0" cy="0" r="7" fill="#36c7b5" />
          <text x="0" y="-18" font-family="'Space Grotesk', sans-serif" font-size="10" font-weight="bold" fill="#bdd2dc" text-anchor="middle">7 PM WIT</text>
          <text x="0" y="26" font-family="'Manrope', sans-serif" font-size="10" fill="#8fd7ff" text-anchor="middle">5 AM EST</text>
        </g>
        <g transform="translate(720, 48)">
