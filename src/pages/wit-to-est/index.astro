---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import Converter from "theme/components/Converter.astro";
import { getTranslation, pageUrl, siteUrl } from "theme/i18n/config";

const lang = "en";
const dir = "ltr";
const slug = "wit-to-est";
const t = getTranslation(lang);

const pageTitle = "WIT to EST Converter";
const seoTitle = "WIT to EST Converter – Eastern Indonesia Time to Eastern Standard Time";
const pageDescription = "Convert WIT to EST instantly. Calculate the exact 14-hour time difference between Eastern Indonesia Time (Waktu Indonesia Timur, UTC+9) and Eastern Standard Time (UTC-5) with live clocks and charts.";

const context = {
  from: "WIT",
  to: "EST",
  fromZone: "Asia/Jayapura",
  toZone: "America/New_York"
};

const canonical = `${siteUrl}/wit-to-est/`;

// 24-hour conversion table data (WIT → EST = WIT - 14 hours)
function formatHour12(hour: number) {
  const normalized = ((hour % 24) + 24) % 24;
  const period = normalized < 12 ? "AM" : "PM";
  const displayHour = normalized % 12 || 12;
  return `${displayHour}:00 ${period}`;
}

const conversionRows = Array.from({ length: 24 }, (_, hour) => {
  const estHour = hour - 14;
  const estNormalized = ((estHour % 24) + 24) % 24;
  const prevDay = estHour < 0;
  const period = estNormalized < 12 ? "AM" : "PM";
  const displayHour = estNormalized % 12 || 12;
  return {
    wit: formatHour12(hour),
    est: `${displayHour}:00 ${period}${prevDay ? " (-1 day)" : ""}`,
    dayNote: prevDay ? "Previous day" : "Same day"
  };
});

// Popular conversions
const popularConversions = [
  { wit: "8:00 AM WIT", est: "6:00 PM EST (-1 day)", note: "Morning in Jayapura/Ambon aligns with early evening in New York on the prior calendar date" },
  { wit: "10:00 AM WIT", est: "8:00 PM EST (-1 day)", note: "Mid-morning focus in Eastern Indonesia corresponds to late evening on US East Coast" },
  { wit: "12:00 PM (Noon) WIT", est: "10:00 PM EST (-1 day)", note: "Lunch hour in Papua matches bedtime hours across New York and Toronto" },
  { wit: "2:00 PM WIT", est: "12:00 AM Midnight EST", note: "Early afternoon in WIT lands at midnight transitioning to the next day in Eastern US" },
  { wit: "5:00 PM WIT", est: "3:00 AM EST", note: "End of WIT workday corresponds to overnight pre-dawn hours in North America" },
  { wit: "7:00 PM WIT", est: "5:00 AM EST", note: "Evening in Eastern Indonesia aligns with early morning wake-ups in Miami/NYC" },
  { wit: "9:00 PM WIT", est: "7:00 AM EST", note: "Prime overlap window: Evening in WIT matches US East Coast office opening" },
  { wit: "10:00 PM WIT", est: "8:00 AM EST", note: "Late evening in Jayapura/Sorong aligns with active 8 AM work start in Eastern US" },
  { wit: "11:00 PM WIT", est: "9:00 AM EST", note: "Bedtime in Eastern Indonesia matches core 9 AM business opening across Eastern North America" },
  { wit: "12:00 AM Midnight WIT", est: "10:00 AM EST", note: "Midnight in Jayapura coincides with mid-morning business productivity in New York" }
];

// Comprehensive FAQ dataset (25 entries)
const faqs = [
  { q: "What does WIT stand for?", a: "WIT stands for Waktu Indonesia Timur (Eastern Indonesia Time). It is the official time zone governing Eastern Indonesia, including Papua, West Papua, Maluku, and North Maluku, operating at UTC+9." },
  { q: "What does EST stand for?", a: "EST stands for Eastern Standard Time. It is standard winter time in eastern North America (including New York, Washington D.C., Toronto, and Miami), operating at UTC-5." },
  { q: "How many hours is EST behind WIT?", a: "Eastern Standard Time (EST, UTC-5) is exactly 14 hours behind Eastern Indonesia Time (WIT, UTC+9). When it is 9:00 PM WIT in Jayapura, it is 7:00 AM EST in New York on the same calendar day." },
  { q: "Does Eastern Indonesia observe Daylight Saving Time?", a: "No. Indonesia does not observe Daylight Saving Time in any of its provinces. WIT remains fixed at UTC+9 throughout the entire calendar year." },
  { q: "Which major Indonesian cities and provinces observe WIT?", a: "WIT covers Jayapura, Sorong, Ambon, Ternate, Manokwari, Merauke, and Biak across the provinces of Papua, Central Papua, Highland Papua, South Papua, Southwest Papua, West Papua, Maluku, and North Maluku." },
  { q: "How many time zones does Indonesia have?", a: "Indonesia is divided into three time zones: WIB (Western Indonesia Time, UTC+7), WITA (Central Indonesia Time, UTC+8), and WIT (Eastern Indonesia Time, UTC+9)." },
  { q: "How do I calculate WIT to EST manually?", a: "To convert WIT to EST, subtract 14 hours from the WIT timestamp. For example, 10:00 PM WIT minus 14 hours equals 8:00 AM EST." },
  { q: "What is the optimal time for a business call between Jayapura and New York during WIT/EST?", a: "The best overlap window occurs between 9:00 PM and 11:00 PM WIT, which corresponds to 7:00 AM to 9:00 AM EST in Eastern North America." },
  { q: "When New York switches to Eastern Daylight Time (EDT, UTC-4), what is the difference?", a: "When New York is in EDT (UTC-4) and Jayapura is in WIT (UTC+9), the time difference decreases from 14 hours to 13 hours." },
  { q: "What is 12:00 PM (Noon) WIT in EST?", a: "12:00 PM (Noon) WIT is equal to 10:00 PM EST on the <em>previous calendar day</em> (-1 day)." },
  { q: "What is 9:00 AM EST in WIT?", a: "9:00 AM EST is equal to 11:00 PM WIT on the exact same calendar day." },
  { q: "What is the primary IANA database key for WIT?", a: "The primary standardized IANA database key for Eastern Indonesia Time is 'Asia/Jayapura'." },
  { q: "How does WIT compare to Japan Standard Time (JST) and Korea Standard Time (KST)?", a: "WIT (UTC+9), JST (UTC+9), and KST (UTC+9) operate at the exact same clock offset with zero time difference." },
  { q: "How does WIT compare to Jakarta time (WIB)?", a: "WIT (UTC+9) is 2 hours ahead of WIB (Western Indonesia Time, UTC+7, used in Jakarta and Sumatra)." },
  { q: "Does the 14-hour difference cause significant calendar date shifts?", a: "Yes. Any WIT time between 12:00 AM Midnight WIT and 1:59 PM WIT corresponds to the <em>previous calendar day</em> in Eastern Standard Time." },
  { q: "Why is Eastern Indonesia strategically important for international trade?", a: "Eastern Indonesia holds vast nickel reserves, agricultural resources, marine biodiversity, and expanding maritime shipping corridors connecting Asia to global markets." },
  { q: "How should software applications handle WIT to EST data logging?", a: "Applications should store all timestamps in UTC (`2026-07-30T12:00:00Z`) and apply `Asia/Jayapura` or `America/New_York` keys dynamically." },
  { q: "What is 8:00 AM WIT in EST?", a: "8:00 AM WIT is equal to 6:00 PM EST on the previous calendar day (-1 day)." },
  { q: "What is 5:00 PM WIT in EST?", a: "5:00 PM WIT is equal to 3:00 AM EST on the exact same calendar day." },
  { q: "What is 9:00 PM WIT in EST?", a: "9:00 PM WIT is equal to 7:00 AM EST on the exact same calendar day." },
  { q: "What is 10:00 PM WIT in EST?", a: "10:00 PM WIT is equal to 8:00 AM EST on the exact same calendar day." },
  { q: "Why is an automated WIT to EST converter recommended over mental math?", a: "Subtracting 14 hours crosses both 12-hour clock rotations and calendar date boundaries simultaneously. An automated converter guarantees accuracy." },
  { q: "What is 6:00 AM WIT in EST?", a: "6:00 AM WIT is equal to 4:00 PM EST on the previous calendar day (-1 day)." },
  { q: "What is 11:00 PM WIT in EST?", a: "11:00 PM WIT is equal to 9:00 AM EST on the exact same calendar day." },
  { q: "What flight routing connects Eastern Indonesia and the US East Coast?", a: "Flights route from Jayapura (DJJ) or Ambon (AMQ) via Jakarta (CGK) or Singapore (SIN) to North America, taking 26 to 30 total travel hours." }
];

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "WIT to EST, Eastern Indonesia Time to Eastern Standard Time, Jayapura to New York time, convert WIT to EST, Indonesia time converter, 14 hour time difference",
  image: "/assets/wit-to-est-og.svg",
  imageAlt: "WIT to EST Time Zone Converter illustration featuring Jayapura and New York clocks",
  faqs,
  appDescription: "Free online WIT to EST converter. Convert Eastern Indonesia Time (UTC+9) to Eastern Standard Time (UTC-5) with live clocks and scheduling tools.",
  applicationCategory: "UtilityApplication",
  operatingSystem: "Any",
  howToName: "How to Convert WIT to EST",
  howToDescription: "Simple steps for calculating Eastern Standard Time from Eastern Indonesia Time.",
  howToSteps: [
    { name: "Input WIT Time", text: "Select your desired hour and minute in Eastern Indonesia Time (Waktu Indonesia Timur)." },
    { name: "Subtract 14 Hours", text: "Account for the 14-hour time gap across global hemispheres." },
    { name: "Verify Calendar Date", text: "Check whether morning WIT hours land on the prior calendar date in EST." },
    { name: "Plan Meetings", text: "Use the built-in overlap matrix to align Jayapura evening hours with New York morning hours." }
  ]
};
---

<BaseLayout
  lang={lang}
  dir={dir}
  title={seoTitle}
  description={pageDescription}
  slug={slug}
  meta={meta}
  mode="gmt-est"
  enableFaqSchema={true}
  allowAds={true}
  breadcrumbHomeLabel="Home"
  breadcrumbLabel="WIT to EST"
  hreflangCodes={["en"]}
>

<!-- HERO BANNER -->
<section class="hero-banner">
  <h1 class="hero-banner-title">
    WIT to EST <span class="gradient-text">Converter</span>
  </h1>
</section>

<!-- PRIMARY CONVERTER & LIVE CLOCKS (Above the Fold) -->
<div style="max-width: 900px; margin: 0 auto; padding: 0 16px 24px;">
  <Converter intent="dynamic" t={t} context={context} />
  
  <!-- LIVE CLOCKS -->
  <section class="clock-grid" aria-label="Live Clocks" style="margin-top: 24px;">
    <h2>Live Clocks</h2>
    <div class="clock-card">
      <span class="eyebrow">Source Time Zone</span>
      <strong id="gmtClock">--:--:--</strong>
    </div>
    <div class="clock-card">
      <span class="eyebrow">Target Time Zone</span>
      <strong id="estClock">--:--:--</strong>
      <p style="margin-top: 4px; font-size: 0.85rem; color: var(--muted);">Active Zone: <em id="estZone">ET</em></p>
    </div>
  </section>
</div>


</div>
</div>


<!-- FEATURE STRIP -->
<section class="feature-strip" aria-label="Tool Features">
  <div class="feature-item">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="feature-icon" aria-hidden="true">
      <circle cx="12" cy="12" r="10"></circle>
      <polyline points="12 6 12 12 16 14"></polyline>
    </svg>
    <span>14-Hour Time Difference</span>
  </div>
  <div class="feature-item">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="feature-icon" aria-hidden="true">
      <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
      <circle cx="12" cy="10" r="3"></circle>
    </svg>
    <span>Jayapura to New York</span>
  </div>
  <div class="feature-item">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="feature-icon" aria-hidden="true">
      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
      <line x1="16" y1="2" x2="16" y2="6"></line>
      <line x1="8" y1="2" x2="8" y2="6"></line>
      <line x1="3" y1="10" x2="21" y2="10"></line>
    </svg>
    <span>No DST in Indonesia</span>
  </div>
  <div class="feature-item">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="feature-icon" aria-hidden="true">
      <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
      <circle cx="9" cy="7" r="4"></circle>
      <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
      <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
    </svg>
    <span>Transpacific Commerce</span>
  </div>
</section>

<!-- INTRO SECTION -->
<section class="acdt-intro content-section" aria-labelledby="wit-est-intro-heading">
  <h2 id="wit-est-intro-heading" class="sr-only">About Eastern Indonesia Time to Eastern Standard Time Conversion</h2>
  <p>
    Welcome to our official <strong>WIT to EST Time Zone Converter</strong>. Converting time between Eastern Indonesia Time (WIT / Waktu Indonesia Timur, UTC+9) and Eastern Standard Time (EST, UTC-5) involves spanning a major <strong>14-hour time difference across global hemispheres</strong>. WIT is the official time zone governing Eastern Indonesia, including Papua, West Papua, Maluku, North Maluku, Jayapura, Sorong, Ambon, and Ternate. Meanwhile, EST governs the eastern seaboard of North America during standard winter months, including New York City, Washington D.C., Toronto, Boston, and Miami.
  </p>
  <p>
    Spanning 14 hours means that when it is morning or afternoon in Jayapura or Ambon, Eastern North America is in the evening or overnight hours of the <em>previous calendar date</em>. For instance, 12:00 PM (Noon) WIT on Tuesday in Papua corresponds to 10:00 PM EST on Monday night in New York.
  </p>
  <p>
    The primary operational window for live communication between Eastern Indonesia and the US East Coast occurs during the late evening in WIT (9:00 PM to 11:00 PM WIT), which aligns with the opening of the business day in New York (7:00 AM to 9:00 AM EST).
  </p>
  <p>
    Our online conversion utility handles these hemispheric calculations automatically, preventing calendar date errors. Whether you are managing nickel mining investments in Maluku, marine conservation projects in Raja Ampat, logistics lines, or remote software partnerships, this page provides complete precision.
  </p>
</section>

<!-- INTERACTIVE CONVERTER & SVG HERO -->
