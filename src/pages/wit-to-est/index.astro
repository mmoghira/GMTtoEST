    <circle cx="650" cy="45" r="1.5" fill="#8fd7ff" opacity="0.6" />

    <!-- Jayapura Youtefa Bridge / Coastal Hill Motif -->
    <path d="M 50 185 Q 180 100 300 185 Z" fill="#164d68" opacity="0.8" />
    <path d="M 120 140 Q 200 80 280 140" fill="none" stroke="#36c7b5" stroke-width="3" />

    <!-- New York Skyline Motif -->
    <g transform="translate(620, 40)">
      <rect x="20" y="30" width="30" height="120" fill="#1b536e" />
