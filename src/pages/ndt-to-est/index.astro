---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import Converter from "theme/components/Converter.astro";
import { getTranslation } from "theme/i18n/config";

const lang = "en";
const dir = "ltr";
const slug = "ndt-to-est";
const t = getTranslation(lang);

const pageTitle = "NDT to EST Converter";
const seoTitle = "NDT to EST Converter – Convert Newfoundland Daylight Time to EST";
const pageDescription = "Convert NDT to EST instantly with our free timezone converter. Newfoundland Daylight Time (NDT) is UTC-2:30, making it 2.5 hours ahead of Eastern Standard Time (EST, UTC-5). Includes half-hour 24-hour conversion tables, date rollover guides, EST vs EDT comparisons, and FAQs.";

const context = {
  from: "NDT",
  to: "EST",
  fromZone: "America/St_Johns",
  toZone: "Etc/GMT+5"
};

function formatTime24To12(hour: number, minute: number) {
  const ampm = hour >= 12 ? "PM" : "AM";
  const h = hour % 12 || 12;
  const m = minute < 10 ? `0${minute}` : `${minute}`;
  return `${h}:${m} ${ampm}`;
}

// 24-hour table: NDT (UTC-2:30) → EST (UTC-5:00) = subtract 2 hours 30 minutes
const conversionRows = Array.from({ length: 24 }, (_, hour) => {
  let estTotalMinutes = hour * 60 - 150; // subtract 2h 30m = 150 mins
  const prevDay = estTotalMinutes < 0;
  if (prevDay) estTotalMinutes += 1440;
  
  const estHour = Math.floor(estTotalMinutes / 60);
  const estMin = estTotalMinutes % 60;

  return {
    ndt: formatTime24To12(hour, 0),
    est: `${formatTime24To12(estHour, estMin)}${prevDay ? " (-1 day)" : ""}`,
    dayNote: prevDay ? "Previous day" : "Same day"
  };
});

const faqs = [
  {
    q: "What does NDT stand for?",
    a: "NDT stands for Newfoundland Daylight Time. It is the daylight saving time zone observed in the province of Newfoundland and Labrador, Canada, operating at UTC-2:30."
  },
  {
    q: "What is the UTC offset of NDT?",
    a: "NDT operates at UTC-2:30 (Coordinated Universal Time minus 2 hours and 30 minutes). It is one of the rare half-hour time zones in North America."
  },
  {
    q: "How many hours is NDT ahead of EST?",
    a: "Newfoundland Daylight Time (NDT, UTC-2:30) is exactly 2 hours and 30 minutes (2.5 hours) ahead of Eastern Standard Time (EST, UTC-5:00). When it is 12:00 PM (noon) NDT in St. John's, it is 9:30 AM EST in New York."
  },
  {
    q: "How do I convert NDT to EST?",
    a: "To convert NDT to EST, subtract 2 hours and 30 minutes from your NDT time. For NDT times between 00:00 (midnight) and 02:29 AM, subtracting 2 hours 30 minutes moves the EST time to the previous calendar day."
  },
  {
    q: "What is the standard-time equivalent of NDT?",
    a: "The standard-time equivalent of NDT is NST (Newfoundland Standard Time), which operates at UTC-3:30 during winter months."
  },
  {
    q: "What is 12:00 NDT in EST?",
    a: "12:00 PM (noon) NDT is 9:30 AM EST on the same calendar day."
  },
  {
    q: "What is midnight NDT in EST?",
    a: "Midnight (00:00) NDT is 9:30 PM EST on the previous calendar day."
  },
  {
    q: "Why does Newfoundland have a half-hour timezone offset?",
    a: "Newfoundland adopted its half-hour offset in 1935 because the island lies geometrically halfway between the Atlantic (UTC-4) and Greenland (UTC-3) meridian lines."
  },
  {
    q: "What is EST in UTC?",
    a: "EST (Eastern Standard Time) operates at UTC-5:00 (Coordinated Universal Time minus 5 hours)."
  },
  {
    q: "What is the difference between EST and EDT?",
    a: "EST (Eastern Standard Time, UTC-5) is observed during winter months. EDT (Eastern Daylight Time, UTC-4) is observed during summer months under daylight saving time. Note that during summer when NDT (UTC-2:30) and EDT (UTC-4) are both in effect, NDT is 1 hour and 30 minutes ahead of EDT."
  },
  {
    q: "Can NDT to EST conversion change the calendar date?",
    a: "Yes. NDT times between 00:00 (midnight) and 02:29 AM roll back to the previous calendar day in EST. For example, 1:00 AM NDT on June 15 equals 10:30 PM EST on June 14."
  },
  {
    q: "Which Canadian cities use NDT in summer?",
    a: "NDT is observed across the island of Newfoundland, including St. John's, Mount Pearl, Corner Brook, Grand Falls-Windsor, and Gander."
  }
];

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "ndt to est, NDT to EST converter, convert NDT to EST, NDT time to EST, NDT EST conversion, Newfoundland Daylight Time to EST, NDT to Eastern Standard Time, NDT vs EST, NDT EST time difference, Newfoundland time to EST, NDT timezone, NDT UTC-2:30, EST UTC-5",
  image: "/assets/ndt-to-est-time-difference.webp",
  imageAlt: "NDT to EST converter comparing Newfoundland Daylight Time and Eastern Standard Time",
  faqs,
  appDescription: "Free online NDT to EST converter featuring live clocks, half-hour 24-hour schedules, previous-day date rollover calculations, and Newfoundland timezone guides for NDT and EST.",
  applicationCategory: "UtilityApplication",
  operatingSystem: "Any",
  howToName: "How to Convert NDT to EST",
  howToDescription: "Convert Newfoundland Daylight Time (NDT, UTC-2:30) to Eastern Standard Time (EST, UTC-5:00) by subtracting 2 hours and 30 minutes.",
  howToSteps: [
    { name: "Start with NDT time", text: "Identify the current time in Newfoundland Daylight Time (NDT / UTC-2:30)." },
    { name: "Subtract 2 hours 30 minutes", text: "Subtract 2 hours and 30 minutes from the NDT time value." },
    { name: "Check for date rollover", text: "If the NDT time is between 00:00 and 02:29 AM, set the calendar date back by one day." },
    { name: "Read the EST result", text: "The resulting figure reflects Eastern Standard Time (EST, UTC-5:00)." }
  ]
};
---

<BaseLayout
  lang={lang}
  dir={dir}
  title={seoTitle}
  description={pageDescription}
  slug={slug}
  meta={meta}
  mode="gmt-est"
  enableFaqSchema={true}
>

  <!-- Breadcrumb -->
  <nav aria-label="Breadcrumb" style="max-width: 1000px; margin: 1.5rem auto 0; padding: 0 16px;">
    <ol style="display: flex; align-items: center; gap: 0.5rem; list-style: none; padding: 0; margin: 0; font-size: 0.92rem; color: var(--text-muted);">
      <li><a href="/" style="color: var(--accent); text-decoration: none;">Home</a></li>
      <li style="color: var(--text-muted);">›</li>
      <li style="color: var(--text-primary);">NDT to EST Converter</li>
    </ol>
  </nav>

  <!-- Hero Section -->
  <header class="hero-banner" style="text-align: center; padding: 2.5rem 16px 2rem;">
    <div class="hero-content" style="max-width: 800px; margin: 0 auto;">
      <span class="eyebrow">Time Zone Converter</span>
      <h1 class="hero-banner-title">NDT to <span class="gradient-text">EST</span> Converter</h1>
      <p class="hero-subtitle" style="font-size: 1.15rem; max-width: 700px; margin: 0.75rem auto 0;">
        Convert Newfoundland Daylight Time (NDT) to Eastern Standard Time (EST) instantly. NDT is <strong>UTC-2:30</strong> and EST is <strong>UTC-5:00</strong>, making NDT <strong>2 hours and 30 minutes ahead</strong> of EST. Our tool handles half-hour offsets and previous-day date rollbacks automatically.
      </p>
    </div>
  </header>

  <!-- Hero Image -->
  <div style="max-width: 750px; margin: 0 auto 2rem; padding: 0 16px;">
    <img
      src="/assets/ndt-to-est-time-difference.webp"
      alt="NDT to EST converter showing Newfoundland Daylight Time and Eastern Standard Time comparison"
      width="1200" height="800"
      loading="eager"
      style="width: 100%; height: auto; border-radius: 12px; border: 1px solid var(--line);"
    />
  </div>

  <!-- Converter Tool -->
  <section style="max-width: 700px; margin: 0 auto 3rem; padding: 0 16px;" aria-label="NDT to EST time converter">
    <Converter
      from={context.from}
      to={context.to}
      fromZone={context.fromZone}
      toZone={context.toZone}
      t={t}
      lang={lang}
    />
  </section>

  <!-- Main Content -->
  <article style="max-width: 800px; margin: 0 auto; padding: 0 16px 3rem;">

    <!-- NDT to EST Time Difference -->
    <section class="content-section" style="margin-bottom: 2.5rem;">
      <h2>NDT to EST Time Difference</h2>
      <p>
        The time difference between Newfoundland Daylight Time (NDT) and Eastern Standard Time (EST) is <strong>2 hours and 30 minutes (2.5 hours)</strong>. NDT operates at the UTC-2:30 offset, while EST operates at UTC-5:00. Subtracting UTC-5:00 from UTC-2:30 yields 2 hours and 30 minutes, placing local time in Newfoundland 2.5 hours ahead of EST.
      </p>
      <div style="background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 1.5rem; text-align: center; margin: 1.5rem 0;">
        <p style="font-size: 1.3rem; font-weight: 700; margin: 0; color: var(--accent);">NDT − 2 hours 30 minutes = EST</p>
        <p style="font-size: 0.95rem; margin: 0.5rem 0 0; color: var(--text-muted);">UTC-2:30 → UTC-5:00 • Newfoundland Daylight Time is 2.5 hours ahead of EST</p>
      </div>
      <p>
        Unlike standard 1-hour time zone steps, Newfoundland uses a 30-minute fractional offset. Converting NDT to EST requires adjusting both the hour and minute values by subtracting 2 hours and 30 minutes.
      </p>
      <p>
        Because NDT is 2.5 hours ahead, NDT times between <strong>00:00 (midnight) and 02:29 AM</strong> fall on the <strong>previous calendar day</strong> in EST. For instance, 1:00 AM NDT on Thursday corresponds to 10:30 PM EST on Wednesday evening.
      </p>
    </section>

    <!-- Date Rollover Image -->
    <div style="margin: 0 auto 2.5rem;">
      <img
        src="/assets/ndt-to-est-date-rollover.webp"
        alt="Infographic illustrating NDT to EST date rollover across midnight"
        width="1200" height="800"
        loading="lazy"
        style="width: 100%; height: auto; border-radius: 12px; border: 1px solid var(--line);"
      />
    </div>

    <!-- How to Convert -->
    <section class="content-section" style="margin-bottom: 2.5rem;">
      <h2>How to Convert NDT to EST</h2>
      <p>
        Converting Newfoundland Daylight Time to Eastern Standard Time requires subtracting 2 hours and 30 minutes from your NDT time. Follow these steps:
      </p>
      <ol style="padding-left: 1.2rem; line-height: 1.8;">
        <li><strong>Start with your NDT time.</strong> Note the hour and minute in Newfoundland Daylight Time (NDT / UTC-2:30).</li>
        <li><strong>Subtract 2 hours and 30 minutes.</strong> Subtract 2 hours from the hour value and 30 minutes from the minute value.</li>
        <li><strong>Check for date rollover.</strong> If the NDT time is between 00:00 and 02:29 AM, set the calendar date back by one day.</li>
        <li><strong>Read the final EST result.</strong> The resulting figure reflects Eastern Standard Time (EST, UTC-5:00).</li>
      </ol>
      <h3>Quick Standard Conversion Examples</h3>
      <ul style="padding-left: 1.2rem; line-height: 1.9;">
        <li><strong>00:00 (Midnight) NDT</strong> → 0:00 − 2h 30m = <strong>9:30 PM EST previous day</strong></li>
        <li><strong>01:00 AM NDT</strong> → 1:00 − 2h 30m = <strong>10:30 PM EST previous day</strong></li>
        <li><strong>02:30 AM NDT</strong> → 2:30 − 2h 30m = <strong>12:00 AM (Midnight) EST same day</strong></li>
        <li><strong>06:00 AM NDT</strong> → 6:00 − 2h 30m = <strong>3:30 AM EST same day</strong></li>
        <li><strong>12:00 PM (Noon) NDT</strong> → 12:00 − 2h 30m = <strong>9:30 AM EST same day</strong></li>
        <li><strong>6:00 PM (18:00) NDT</strong> → 18:00 − 2h 30m = <strong>3:30 PM EST same day</strong></li>
      </ul>
      <p>
        For instant half-hour date-aware conversions without manual math, use our <strong>interactive converter tool above</strong>.
      </p>
    </section>

    <!-- 24-Hour Conversion Table -->
    <section class="content-section" style="margin-bottom: 2.5rem;">
      <h2>NDT to EST Conversion Table (24 Hours)</h2>
      <p>
        The table below shows every hour of the day converted from Newfoundland Daylight Time (NDT) to Eastern Standard Time (EST). Rows highlighted in accent color indicate times where EST falls on the previous calendar day.
      </p>
      <div style="overflow-x: auto; border-radius: 12px; border: 1px solid var(--line);">
        <table style="width: 100%; border-collapse: collapse; font-size: 0.95rem;">
          <thead>
            <tr style="background: var(--panel);">
              <th style="padding: 12px 16px; text-align: left; border-bottom: 2px solid var(--line); white-space: nowrap;">NDT (UTC-2:30)</th>
              <th style="padding: 12px 16px; text-align: left; border-bottom: 2px solid var(--line); white-space: nowrap;">EST (UTC-5:00)</th>
              <th style="padding: 12px 16px; text-align: left; border-bottom: 2px solid var(--line); white-space: nowrap;">Date</th>
            </tr>
          </thead>
          <tbody>
            {conversionRows.map((row, i) => (
              <tr style={`background: ${row.dayNote === "Previous day" ? "rgba(var(--accent-rgb, 99, 102, 241), 0.08)" : i % 2 === 0 ? "transparent" : "var(--panel)"}`}>
                <td style="padding: 10px 16px; border-bottom: 1px solid var(--line);">{row.ndt}</td>
                <td style="padding: 10px 16px; border-bottom: 1px solid var(--line); font-weight: 600;">{row.est}</td>
                <td style="padding: 10px 16px; border-bottom: 1px solid var(--line); font-size: 0.88rem; color: var(--text-muted);">{row.dayNote}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p style="font-size: 0.88rem; color: var(--text-muted); margin-top: 0.75rem;">
        Note: NDT times from 00:00 (midnight) to 02:00 AM produce EST times on the previous calendar day.
      </p>
    </section>

    <!-- Practical Examples -->
    <section class="content-section" style="margin-bottom: 2.5rem;">
      <h2>NDT to EST Practical Conversion Examples</h2>
      <p>Here are practical real-world scenarios illustrating how NDT times map to Eastern Standard Time:</p>

      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1rem; margin: 1.25rem 0;">
        <div style="background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 1.25rem;">
          <h3 style="margin: 0 0 0.5rem; font-size: 1rem;">Morning St. John's Stand-Up</h3>
          <p style="margin: 0; font-size: 0.93rem;"><strong>8:30 AM NDT</strong> → <strong>6:00 AM EST</strong><br/>An 8:30 AM NDT morning briefing in St. John's matches 6:00 AM EST on the U.S. East Coast.</p>
        </div>
        <div style="background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 1.25rem;">
          <h3 style="margin: 0 0 0.5rem; font-size: 1rem;">Midday Lunch Sync</h3>
          <p style="margin: 0; font-size: 0.93rem;"><strong>12:00 PM NDT</strong> → <strong>9:30 AM EST</strong><br/>Noon NDT in Newfoundland aligns with 9:30 AM EST as morning business hours get underway in New York.</p>
        </div>
        <div style="background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 1.25rem;">
          <h3 style="margin: 0 0 0.5rem; font-size: 1rem;">Afternoon Handoff</h3>
          <p style="margin: 0; font-size: 0.93rem;"><strong>4:30 PM (16:30) NDT</strong> → <strong>2:00 PM EST</strong><br/>A 4:30 PM NDT afternoon handoff reaches 2:00 PM EST in Eastern Canada and the U.S.</p>
        </div>
        <div style="background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 1.25rem;">
          <h3 style="margin: 0 0 0.5rem; font-size: 1rem;">Close of Business in St. John's</h3>
          <p style="margin: 0; font-size: 0.93rem;"><strong>5:00 PM (17:00) NDT</strong> → <strong>2:30 PM EST</strong><br/>When offices close in St. John's at 5:00 PM NDT, Eastern U.S. offices still have 2.5 hours remaining in their workday (2:30 PM EST).</p>
        </div>
        <div style="background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 1.25rem;">
          <h3 style="margin: 0 0 0.5rem; font-size: 1rem;">Late Night Transition</h3>
          <p style="margin: 0; font-size: 0.93rem;"><strong>1:30 AM NDT, July 10</strong> → <strong>11:00 PM EST, July 9</strong><br/>Late-night 1:30 AM NDT in St. John's rolls back to 11:00 PM EST on the previous evening.</p>
        </div>
        <div style="background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 1.25rem;">
          <h3 style="margin: 0 0 0.5rem; font-size: 1rem;">New Year's Midnight</h3>
          <p style="margin: 0; font-size: 0.93rem;"><strong>00:00 NDT, Jan 1</strong> → <strong>9:30 PM EST, Dec 31</strong><br/>When Newfoundland celebrates New Year's midnight, New York is at 9:30 PM on New Year's Eve — 2.5 hours before Eastern midnight!</p>
        </div>
      </div>
    </section>

    <!-- What Is NDT? -->
    <section class="content-section" style="margin-bottom: 2.5rem;">
      <h2>What Is NDT?</h2>
      <p>
        <strong>Newfoundland Daylight Time (NDT)</strong> is the daylight saving time zone for the Canadian province of Newfoundland and Labrador, operating at <strong>UTC-2:30</strong>. In the IANA timezone database, it is identified by <code>America/St_Johns</code>.
      </p>
      <p>
        NDT is observed from the second Sunday in March to the first Sunday in November. During winter standard time, the region switches to <strong>Newfoundland Standard Time (NST, UTC-3:30)</strong>.
      </p>
    </section>

    <!-- NDT Time Zone Image -->
    <div style="margin: 0 auto 2.5rem;">
      <img
        src="/assets/ndt-time-zone-map.webp"
        alt="Map showing Newfoundland and Labrador daylight saving time zone (NDT UTC-2:30)"
        width="1200" height="800"
        loading="lazy"
        style="width: 100%; height: auto; border-radius: 12px; border: 1px solid var(--line);"
      />
    </div>

    <!-- Why Newfoundland Uses a Half-Hour Offset -->
    <section class="content-section" style="margin-bottom: 2.5rem;">
      <h2>Why Newfoundland Uses a Half-Hour Offset</h2>
      <p>
        Newfoundland was an independent Dominion before joining Canada in 1949. In 1935, the government adopted its own unique half-hour offset because the island lies geometrically midway between the Atlantic meridian (UTC-4, 60°W) and Greenland (UTC-3, 45°W).
      </p>
      <p>
        Setting local time to UTC-3:30 (and UTC-2:30 in summer) aligned local clocks almost perfectly with mean solar noon in St. John's.
      </p>
    </section>

    <!-- What Is EST? -->
    <section class="content-section" style="margin-bottom: 2.5rem;">
      <h2>What Is EST?</h2>
      <p>
        <strong>Eastern Standard Time (EST)</strong> is the standard time zone designation for eastern North America, defined as <strong>UTC-5:00</strong>.
      </p>
      <p>
        EST applies to major cities including New York City, Toronto, Washington D.C., Miami, Boston, Philadelphia, Atlanta, and Montreal during winter standard-time months (November to March). For more GMT-based conversions, visit our <a href="/" style="color: var(--accent);">GMT to EST Converter</a> homepage.
      </p>
    </section>

    <!-- EST vs EDT Image -->
    <div style="margin: 0 auto 2.5rem;">
      <img
        src="/assets/est-vs-edt-comparison.webp"
        alt="Infographic comparing EST (UTC-5, Standard Time) and EDT (UTC-4, Daylight Saving Time)"
        width="1200" height="800"
        loading="lazy"
        style="width: 100%; height: auto; border-radius: 12px; border: 1px solid var(--line);"
      />
    </div>

    <!-- EST vs EDT -->
    <section class="content-section" style="margin-bottom: 2.5rem;">
      <h2>EST vs EDT</h2>
      <p>
        It is essential to distinguish between <strong>EST</strong> and <strong>EDT</strong> when converting to North American Eastern Time:
      </p>
      <div style="overflow-x: auto; border-radius: 12px; border: 1px solid var(--line); margin: 1.25rem 0;">
        <table style="width: 100%; border-collapse: collapse; font-size: 0.95rem;">
          <thead>
            <tr style="background: var(--panel);">
              <th style="padding: 12px 16px; text-align: left; border-bottom: 2px solid var(--line);">Time Zone</th>
              <th style="padding: 12px 16px; text-align: left; border-bottom: 2px solid var(--line);">Full Name</th>
              <th style="padding: 12px 16px; text-align: left; border-bottom: 2px solid var(--line);">UTC Offset</th>
              <th style="padding: 12px 16px; text-align: left; border-bottom: 2px solid var(--line);">Observance Period</th>
            </tr>
          </thead>
          <tbody>
            <tr style="background: rgba(var(--accent-rgb, 99, 102, 241), 0.08);">
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line); font-weight: 700;">EST</td>
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line); font-weight: 600;">Eastern Standard Time</td>
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line); font-weight: 600;">UTC-5</td>
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line);">Winter (Nov to Mar)</td>
            </tr>
            <tr>
              <td style="padding: 10px 16px;">EDT</td>
              <td style="padding: 10px 16px;">Eastern Daylight Time</td>
              <td style="padding: 10px 16px;">UTC-4</td>
              <td style="padding: 10px 16px;">Summer (Mar to Nov)</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p>
        Note: When NDT (UTC-2:30) and EDT (UTC-4:00) are both active during summer months, NDT is exactly <strong>1 hour and 30 minutes (1.5 hours)</strong> ahead of EDT. Our converter calculates the standard <strong>NDT (UTC-2:30) to EST (UTC-5:00)</strong> 2.5-hour difference.
      </p>
    </section>

    <!-- NDT vs EST Comparison -->
    <section class="content-section" style="margin-bottom: 2.5rem;">
      <h2>NDT vs EST</h2>
      <p>A direct comparison of key attributes between Newfoundland Daylight Time and Eastern Standard Time:</p>
      <div style="overflow-x: auto; border-radius: 12px; border: 1px solid var(--line);">
        <table style="width: 100%; border-collapse: collapse; font-size: 0.95rem;">
          <thead>
            <tr style="background: var(--panel);">
              <th style="padding: 12px 16px; text-align: left; border-bottom: 2px solid var(--line);">Feature</th>
              <th style="padding: 12px 16px; text-align: left; border-bottom: 2px solid var(--line);">NDT</th>
              <th style="padding: 12px 16px; text-align: left; border-bottom: 2px solid var(--line);">EST</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line); font-weight: 600;">Full Name</td>
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line);">Newfoundland Daylight Time</td>
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line);">Eastern Standard Time</td>
            </tr>
            <tr style="background: var(--panel);">
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line); font-weight: 600;">UTC Offset</td>
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line);">UTC-2:30</td>
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line);">UTC-5:00</td>
            </tr>
            <tr>
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line); font-weight: 600;">Difference</td>
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line);">2.5 hours ahead of EST</td>
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line);">2.5 hours behind NDT</td>
            </tr>
            <tr style="background: var(--panel);">
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line); font-weight: 600;">Primary Region</td>
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line);">Newfoundland, Canada</td>
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line);">Eastern US & Canada</td>
            </tr>
            <tr>
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line); font-weight: 600;">Daylight Saving</td>
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line);">Daylight saving offset (NST is winter standard)</td>
