---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import { siteUrl } from "theme/i18n/config";

const lang = "en";
const dir = "ltr";
const slug = "russia-time-zones";
const seoTitle = "Russia Time Zones Guide: Map, 11 Zones & Moscow Time (2026)";
const pageDescription = "Comprehensive guide to Russia's 11 contiguous time zones. Explore Moscow Time (MSK, UTC+3), regional offsets from Kaliningrad (UTC+2) to Kamchatka (UTC+12).";

const pubDate = "2026-07-30T15:00:00+05:00";
const updatedDate = "2026-07-30T15:00:00+05:00";

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "Russia Time Zones, Russia Time Zone Map, Moscow Time, MSK, UTC+3, Russian Time Zones, Kaliningrad Time, Yekaterinburg Time, Vladivostok Time, Russia Daylight Saving Time, Russia Time Guide",
  image: "/assets/russia-time-zone-map.webp",
  imageAlt: "Russia Time Zones Map Graphic showing 11 contiguous timezone bands",
  pubDate,
  updatedDate,
  author: "Jackie Bruce",
  faqs: [
    {
      q: "How many time zones does Russia have?",
      a: "Russia has 11 contiguous time zones spanning across Eastern Europe and Northern Asia, ranging from Kaliningrad Time (UTC+2) in the west to Kamchatka Time (UTC+12) in the far east."
    },
    {
      q: "What is Moscow Time (MSK)?",
      a: "Moscow Time (MSK) is set at UTC+3. It serves as the primary administrative time zone of Russia and the reference standard for national flight schedules, train timetables, space operations, and federal broadcasts."
    },
    {
      q: "Does Russia observe Daylight Saving Time?",
      a: "No. Russia does not observe Daylight Saving Time (DST). All 11 time zones maintain permanent year-round standard time offsets."
    },
    {
      q: "Why did Russia abolish Daylight Saving Time?",
      a: "In 2011, President Dmitry Medvedev instituted permanent summer time. However, due to public dissatisfaction with dark winter mornings in northern latitudes, Russia passed Federal Law No. 107-FZ in July 2014, shifting the country back to permanent standard (winter) time."
    },
    {
      q: "What are the 11 time zones of Russia?",
      a: "The 11 time zones are: 1) Kaliningrad (UTC+2), 2) Moscow (UTC+3), 3) Samara (UTC+4), 4) Yekaterinburg (UTC+5), 5) Omsk (UTC+6), 6) Krasnoyarsk (UTC+7), 7) Irkutsk (UTC+8), 8) Yakutsk (UTC+9), 9) Vladivostok (UTC+10), 10) Magadan/Srednekolymsk (UTC+11), and 11) Kamchatka (UTC+12)."
    },
    {
      q: "How do Russian Railways display station timetables?",
      a: "Historically, all train stations across Russia displayed Moscow Time (MSK) on station clocks regardless of local geography. In August 2018, Russian Railways updated station displays to show local time alongside Moscow Time."
    },
    {
      q: "What is the time difference between Moscow and New York?",
      a: "During US winter (EST, UTC-5), Moscow (MSK, UTC+3) is 8 hours ahead of New York. During US summer (EDT, UTC-4), Moscow is 7 hours ahead of New York."
    },
    {
      q: "What is the time difference between Moscow and London?",
      a: "During UK winter (GMT, UTC+0), Moscow is 3 hours ahead of London. During UK summer (BST, UTC+1), Moscow is 2 hours ahead of London."
    },
    {
      q: "What is the IANA time zone identifier for Moscow?",
      a: "The primary IANA time zone database identifier for Moscow and western European Russia is `Europe/Moscow`."
    },
    {
      q: "What is the time difference between Kaliningrad and Moscow?",
      a: "Kaliningrad (UTC+2) is 1 hour behind Moscow Time (MSK, UTC+3)."
    },
    {
      q: "What is the time difference between Vladivostok and Moscow?",
      a: "Vladivostok (UTC+10) is 7 hours ahead of Moscow Time (MSK, UTC+3)."
    },
    {
      q: "What is the time difference between Kamchatka and Moscow?",
      a: "Kamchatka (UTC+12) is 9 hours ahead of Moscow Time (MSK, UTC+3)."
    },
    {
      q: "How does Vladivostok Time compare with Tokyo Time?",
      a: "Vladivostok Time (UTC+10) is 1 hour ahead of Tokyo, Japan (JST, UTC+9) year-round."
    },
    {
      q: "How does Irkutsk Time compare with Beijing Time?",
      a: "Irkutsk Time (UTC+8) shares the exact same UTC+8 offset as China Standard Time (Beijing Time) year-round."
    },
    {
      q: "What is the solar time span across Russia?",
      a: "Russia stretches approximately 9,000 kilometers from the Baltic Sea to the Bering Strait, encompassing over 170 degrees of longitude and a solar time variance exceeding 10 hours."
    },
    {
      q: "What are the trading hours of the Moscow Exchange (MOEX)?",
      a: "The Moscow Exchange (MOEX) operates equity trading sessions from 09:50 to 18:50 MSK."
    },
    {
      q: "How many time zones did Russia have between 2010 and 2014?",
      a: "In 2010, the Russian government temporarily reduced the number of time zones from 11 to 9 by merging several eastern regions. However, following regional dissatisfaction, the 11 time zone structure was restored in 2014."
    },
    {
      q: "What is the best time for business calls between Moscow and New York?",
      a: "The optimal business overlap between Moscow (UTC+3) and New York (UTC-4/UTC-5) occurs between 15:00 and 18:00 MSK, matching 08:00 to 11:00 EDT."
    },
    {
      q: "Which time zone covers Yekaterinburg and the Ural region?",
      a: "Yekaterinburg, Chelyabinsk, Perm, and Tyumen are in Yekaterinburg Time (YEKT, UTC+5), which is 2 hours ahead of Moscow."
    },
    {
      q: "How should software developers configure server timezone settings for Russia?",
      a: "Developers should use specific IANA keys for each Russian region, such as `Europe/Moscow`, `Asia/Yekaterinburg`, `Asia/Novosibirsk`, `Asia/Irkutsk`, `Asia/Vladivostok`, or `Asia/Kamchatka`."
    }
  ]
};

const pageUrlPath = `${siteUrl}/russia-time-zones/`;

const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    "@id": `${pageUrlPath}#article`,
    "mainEntityOfPage": pageUrlPath,
    "headline": seoTitle,
    "description": pageDescription,
    "datePublished": pubDate,
    "dateModified": updatedDate,
    "inLanguage": "en",
    "author": {
      "@type": "Person",
      "name": "Jackie Bruce",
      "jobTitle": "Senior Time Zone Analyst",
      "url": `${siteUrl}/author/jackie-bruce/`
    },
    "publisher": {
      "@type": "Organization",
      "name": "GMT to EST Converter",
      "logo": {
        "@type": "ImageObject",
        "url": `${siteUrl}/logo.svg`
      }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "SpeakableSpecification",
    "cssSelector": [".speakable-headline", ".speakable-summary"]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": `${siteUrl}/`
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Russia Time Zones Guide",
        "item": pageUrlPath
      }
    ]
  },
  ...["Kaliningrad", "Moscow", "Samara", "Yekaterinburg", "Omsk", "Krasnoyarsk", "Irkutsk", "Yakutsk", "Vladivostok", "Magadan", "Kamchatka"].map((zone, idx) => ({
    "@context": "https://schema.org",
    "@type": "DefinedTerm",
    "@id": `${siteUrl}/#zone-ru-${idx}`,
    "name": `${zone} Time Zone`,
    "description": `One of 11 contiguous time zones observed across the Russian Federation.`
  }))
];
---

<BaseLayout
  lang={lang}
  dir={dir}
  title={seoTitle}
  description={pageDescription}
  slug={slug}
  meta={meta}
  mode="gmt-est"
  enableFaqSchema={true}
  enableArticleSchema={true}
  allowAds={true}
  breadcrumbHomeLabel="Home"
  breadcrumbLabel="Russia Time Zones Guide"
  hreflangCodes={["en"]}
>
  <script type="application/ld+json" set:html={JSON.stringify(schemas)} slot="head" />

  <!-- HERO & SUMMARY SECTION -->
  <section class="hero-banner" aria-labelledby="hero-title">
    <h1 id="hero-title" class="hero-banner-title speakable-headline">
      Russia Time Zones Guide: <span class="gradient-text">11 Contiguous Zones &amp; Moscow Time</span>
    </h1>
  </section>

  <div class="editorial-meta-bar" aria-label="Editorial metadata">
    <span>Last Updated: <strong>July 30, 2026</strong></span>
    <span class="separator" aria-hidden="true">•</span>
    <span>Editorially Reviewed by <a href="/author/jackie-bruce/"><strong>Jackie Bruce</strong></a></span>
    <span class="separator" aria-hidden="true">•</span>
    <span>Data Source: <a href="http://www.vniiftri.ru" target="_blank" rel="noopener noreferrer"><strong>VNIIFTRI Time Metrology Institute</strong></a></span>
  </div>

  <section class="acdt-intro content-section" aria-label="Quick Guide Summary">
    <div class="info-callout speakable-summary" style="background: var(--panel); border-left: 4px solid var(--accent); padding: 1.5rem; margin-bottom: 2rem; border-radius: 6px;">
      <h3 style="margin-top: 0;">Quick Summary: How Many Time Zones Does Russia Have?</h3>
      <p>
        <strong>The Russian Federation is divided into 11 contiguous time zones:</strong>
      </p>
      <p>
        Ranging from <strong>Kaliningrad Time (UTC+2)</strong> in the west to <strong>Kamchatka Time (UTC+12)</strong> in the far east. The central anchor for national administration, airline scheduling, and railway timetables is <strong>Moscow Time (MSK, UTC+3)</strong>.
      </p>
      <p style="margin-top: 0.8rem;">
        Russia <strong>does not observe Daylight Saving Time (DST)</strong>. Under Federal Law No. 107-FZ passed in 2014, all 11 time zones remain permanently set to standard winter offsets year-round.
      </p>
    </div>

    <div class="reading-meta" style="margin-top: 1rem; color: var(--muted); font-size: 0.9rem;">
      <span>⏱️ Estimated Reading Time: <strong>25 minutes</strong></span>
    </div>
  </section>

  <!-- TABLE OF CONTENTS -->
  <section class="table-of-contents reveal" aria-label="Table of Contents" style="background: var(--panel); padding: 1.5rem; border-radius: 8px; margin: 2rem 0;">
    <span class="toc-kicker" style="font-weight: bold; color: var(--accent); text-transform: uppercase; font-size: 0.85rem;">Detailed Navigation</span>
    <h2 style="margin-top: 0.5rem;">Guide Contents</h2>
    <ol style="line-height: 1.8;">
      <li><a href="#overview-russia-zones">1. Overview of Russia's 11 Contiguous Time Zones</a></li>
      <li><a href="#moscow-time-msk">2. Moscow Time (MSK, UTC+3) — The Administrative Baseline</a></li>
      <li><a href="#complete-11-zone-breakdown">3. Complete Breakdown of Russia's 11 Time Zones</a></li>
      <li><a href="#russia-dst-history">4. History of Russian Time Reforms (2011 &amp; 2014 Laws)</a></li>
      <li><a href="#railway-scheduling-msk">5. Russian Railways &amp; Trans-Siberian Timekeeping</a></li>
      <li><a href="#russia-vs-world-table">6. Russia vs World Time Zones Comparison Table</a></li>
      <li><a href="#business-moex-exchange">7. Financial Markets &amp; Moscow Business Overlap</a></li>
      <li><a href="#developer-guide-russia">8. Developer Guide: Handling Russian IANA Timezone Keys</a></li>
      <li><a href="#frequently-asked-questions">9. Frequently Asked Questions (20 FAQs)</a></li>
    </ol>
  </section>

  <!-- SVG DIAGRAM -->
  <section class="content-section" aria-label="Russia 11 Time Zones Diagram">
    <h2>Russia's 11 Time Zone Span (UTC+2 to UTC+12)</h2>
    <p>
      The diagram below illustrates the geographic progression of Russia's 11 contiguous time zones relative to Moscow Time (MSK, UTC+3).
    </p>

    <div class="svg-container" style="width: 100%; overflow-x: auto; text-align: center; margin: 2rem 0;">
      <svg viewBox="0 0 800 320" width="100%" height="auto" xmlns="http://www.w3.org/2000/svg" style="background: var(--panel); border-radius: 8px; padding: 1rem; border: 1px solid var(--line, #333);">
        <text x="400" y="30" fill="currentColor" text-anchor="middle" font-size="18" font-weight="bold">Russia's 11 Contiguous Time Zones (West to East)</text>
        
        <g transform="translate(30, 70)">
          <!-- Zone Blocks -->
          <rect x="0" y="0" width="60" height="45" fill="#3b82f6" />
          <text x="30" y="27" fill="#fff" text-anchor="middle" font-size="10" font-weight="bold">+2 (Kaliningrad)</text>

          <rect x="65" y="0" width="75" height="45" fill="#10b981" stroke="#fff" stroke-width="2" />
          <text x="102" y="27" fill="#fff" text-anchor="middle" font-size="11" font-weight="bold">+3 (MSK)</text>

          <rect x="145" y="0" width="60" height="45" fill="#3b82f6" />
          <text x="175" y="27" fill="#fff" text-anchor="middle" font-size="10" font-weight="bold">+4 (Samara)</text>

          <rect x="210" y="0" width="65" height="45" fill="#2563eb" />
          <text x="242" y="27" fill="#fff" text-anchor="middle" font-size="10" font-weight="bold">+5 (Yekaterinburg)</text>

          <rect x="280" y="0" width="60" height="45" fill="#3b82f6" />
          <text x="310" y="27" fill="#fff" text-anchor="middle" font-size="10" font-weight="bold">+6 (Omsk)</text>

          <rect x="345" y="0" width="70" height="45" fill="#2563eb" />
          <text x="380" y="27" fill="#fff" text-anchor="middle" font-size="10" font-weight="bold">+7 (Krasnoyarsk)</text>

          <rect x="420" y="0" width="65" height="45" fill="#1d4ed8" />
          <text x="452" y="27" fill="#fff" text-anchor="middle" font-size="10" font-weight="bold">+8 (Irkutsk)</text>

          <rect x="490" y="0" width="65" height="45" fill="#2563eb" />
          <text x="522" y="27" fill="#fff" text-anchor="middle" font-size="10" font-weight="bold">+9 (Yakutsk)</text>

          <rect x="560" y="0" width="70" height="45" fill="#1d4ed8" />
          <text x="595" y="27" fill="#fff" text-anchor="middle" font-size="10" font-weight="bold">+10 (Vladivostok)</text>

          <rect x="635" y="0" width="55" height="45" fill="#1e40af" />
          <text x="662" y="27" fill="#fff" text-anchor="middle" font-size="10" font-weight="bold">+11 (Magadan)</text>

          <rect x="695" y="0" width="50" height="45" fill="#1e3a8a" />
          <text x="720" y="27" fill="#fff" text-anchor="middle" font-size="10" font-weight="bold">+12 (Kamchatka)</text>
        </g>

        <rect x="30" y="160" width="740" height="90" fill="var(--panel)" stroke="var(--line, #444)" rx="6" />
        <text x="50" y="185" fill="currentColor" font-size="13" font-weight="bold">Key Status:</text>
        <text x="50" y="210" fill="currentColor" font-size="12">• Federal Law No. 107-FZ (2014) established permanent winter standard time across all 11 zones</text>
        <text x="50" y="230" fill="currentColor" font-size="12">• Russian Railways train stations display local time alongside Moscow Time (MSK)</text>
      </svg>
    </div>
  </section>

  <!-- SECTION 1 -->
  <section id="overview-russia-zones" class="content-section">
    <h2>1. Overview of Russia's 11 Contiguous Time Zones</h2>
    <p>
      Spanning over 17 million square kilometers across Eastern Europe and Northern Asia, Russia is the largest nation on Earth. Its contiguous territory stretches across 11 time zones, from the Baltic exclave of Kaliningrad to the Bering Strait near Alaska.
    </p>
    <p>
      For international logistics and scheduling, check converters like <a href="/gmt-to-est/">GMT to EST</a> and <a href="/gmt-to-utc/">GMT to UTC</a>.
    </p>
  </section>

  <!-- SECTION 2 -->
  <section id="moscow-time-msk" class="content-section">
    <h2>2. Moscow Time (MSK, UTC+3) — The Administrative Baseline</h2>
    <p>
      Moscow Time (MSK) operates at a fixed offset of <strong>UTC+3</strong>. It serves as the baseline reference for all national timing, administrative decrees, flight connections, space launches from Baikonur and Vostochny, and television broadcasting.
    </p>
  </section>

  <!-- SECTION 3 -->
  <section id="complete-11-zone-breakdown" class="content-section">
    <h2>3. Complete Breakdown of Russia's 11 Time Zones</h2>
    <table class="data-table" style="width: 100%; border-collapse: collapse; margin: 1.5rem 0;">
      <thead>
        <tr style="background: var(--panel); border-bottom: 2px solid var(--line);">
          <th style="padding: 10px; text-align: left;">Time Zone Name</th>
          <th style="padding: 10px; text-align: left;">UTC Offset</th>
          <th style="padding: 10px; text-align: left;">MSK Offset</th>
          <th style="padding: 10px; text-align: left;">Major Cities / Regions Included</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Kaliningrad Time (USZ1)</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">UTC+2</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">MSK - 1h</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Kaliningrad Oblast</td>
        </tr>
        <tr>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Moscow Time (MSK)</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">UTC+3</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">MSK baseline</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Moscow, St. Petersburg, Kazan, Nizhny Novgorod, Sochi</td>
        </tr>
        <tr>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Samara Time (SAMT)</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">UTC+4</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">MSK + 1h</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Samara, Izhevsk, Saratov, Ulyanovsk</td>
        </tr>
        <tr>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Yekaterinburg Time (YEKT)</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">UTC+5</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">MSK + 2h</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Yekaterinburg, Chelyabinsk, Perm, Tyumen, Ufa</td>
        </tr>
        <tr>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Omsk Time (OMST)</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">UTC+6</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">MSK + 3h</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Omsk</td>
        </tr>
        <tr>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Krasnoyarsk Time (KRAT)</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">UTC+7</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">MSK + 4h</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Novosibirsk, Krasnoyarsk, Kemerovo, Barnaul, Tomsk</td>
        </tr>
        <tr>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Irkutsk Time (IRKT)</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">UTC+8</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">MSK + 5h</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Irkutsk, Ulan-Ude (Lake Baikal region)</td>
        </tr>
        <tr>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Yakutsk Time (YAKT)</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">UTC+9</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">MSK + 6h</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Yakutsk, Chita, Blagoveshchensk</td>
        </tr>
        <tr>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Vladivostok Time (VLAT)</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">UTC+10</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">MSK + 7h</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Vladivostok, Khabarovsk, Birobidzhan</td>
        </tr>
        <tr>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Magadan Time (SRET)</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">UTC+11</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">MSK + 8h</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Magadan, Yuzhno-Sakhalinsk, Srednekolymsk</td>
        </tr>
        <tr>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Kamchatka Time (PETT)</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">UTC+12</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">MSK + 9h</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Petropavlovsk-Kamchatsky, Anadyr (Chukotka)</td>
        </tr>
      </tbody>
    </table>
  </section>

  <!-- SECTION 4 -->
  <section id="russia-dst-history" class="content-section">
    <h2>4. History of Russian Time Reforms (2011 &amp; 2014 Laws)</h2>
    <p>
      In 2011, President Dmitry Medvedev simplified Russia's time zones and put the entire nation on permanent summer time. However, this resulted in severe winter darkness, with sunrise in northern cities occurring as late as 10:00 a.m.
    </p>
    <p>
      In October 2014, Federal Law No. 107-FZ moved Russia back by one hour to permanent standard (winter) time and restored the 11 time zone system, ending seasonal DST permanently.
    </p>
  </section>

  <!-- SECTION 5 -->
  <section id="railway-scheduling-msk" class="content-section">
    <h2>5. Russian Railways &amp; Trans-Siberian Timekeeping</h2>
    <p>
      The Trans-Siberian Railway travels over 9,289 kilometers between Moscow and Vladivostok, crossing 8 time zones. For over a century, all train tickets, timetables, and station clocks across Russia operated exclusively on Moscow Time (MSK).
    </p>
    <p>
      In August 2018, Russian Railways modernized its operations, updating physical clocks and electronic tickets to display local station time alongside Moscow Time.
    </p>
  </section>

  <!-- SECTION 6 -->
  <section id="russia-vs-world-table" class="content-section">
    <h2>6. Russia vs World Time Zones Comparison Table</h2>
    <p>
      Compare Moscow Time (MSK, UTC+3) with major global cities:
    </p>
    <table class="data-table" style="width: 100%; border-collapse: collapse; margin: 1.5rem 0;">
      <thead>
        <tr style="background: var(--panel); border-bottom: 2px solid var(--line);">
          <th style="padding: 10px; text-align: left;">City</th>
          <th style="padding: 10px; text-align: left;">US/UK Winter Difference vs Moscow</th>
          <th style="padding: 10px; text-align: left;">US/UK Summer Difference vs Moscow</th>
          <th style="padding: 10px; text-align: left;">Tool / Guide</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">New York (US East)</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Moscow is 8 hours ahead</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Moscow is 7 hours ahead</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);"><a href="/gmt-to-est/">GMT to EST Converter</a></td>
        </tr>
        <tr>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">London (UK)</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Moscow is 3 hours ahead</td>
