---
import BaseLayout from "theme/layouts/BaseLayout.astro";

const lang = "en";
const dir = "ltr";
const slug = "holidays-2027";
const seoTitle = "Holidays in 2027 | Full Calendar of Holidays by Month";
const pageDescription = "See every major holiday in 2027 by month, with dates for Diwali, Easter, Ramadan, Thanksgiving, Labor Day and more.";

const pubDate = "2026-10-25T15:00:00+05:00";
const updatedDate = "2026-10-25T15:30:00+05:00";

const meta = {
  seoTitle,
  exactTitle: true,
  description: pageDescription,
  keywords: "holidays in 2027, 2027 calendar holidays, major holidays 2027, diwali 2027 date, thanksgiving 2027 date, easter 2027 date, ramadan 2027",
  pubDate,
  updatedDate,
  author: "Time Intelligence Team",
  faqs: [
    {
      q: "What holidays are in 2027?",
      a: "The table on this page lists major holidays in 2027 by month, including Easter on 28 March, Labor Day on 6 September, Diwali on 29 October in India, Thanksgiving on 25 November, and Christmas Day on 25 December."
    },
    {
      q: "When is Diwali in 2027?",
      a: "In India the main Diwali night is Friday 29 October 2027. In Singapore the public holiday is Thursday 28 October 2027. See the Diwali 2027 page for the 5-day festival dates."
    },
    {
      q: "When is Ramadan in 2027?",
      a: "Ramadan is expected to start on Monday 8 February 2027, with Eid al-Fitr expected on 9–10 March, subject to moon sighting and varying by country."
    },
    {
      q: "Is Singles Day a public holiday?",
      a: "No. Singles Day on 11 November is a shopping day, not a public holiday."
    }
  ]
};

// 2027 Chronological Holidays Data
const HOLIDAYS_2027 = [
  // January
  { month: "January", date: "Friday 1 January", name: "New Year's Day", note: "" },
  { month: "January", date: "Monday 18 January", name: "Birthday of Martin Luther King, Jr.", note: "" },
  // February
  { month: "February", date: "Monday 8 February", name: "Ramadan start", note: "Expected; subject to moon sighting.", href: "/ramadan-2027-dates/" },
  { month: "February", date: "Monday 15 February", name: "Washington's Birthday / Presidents Day", note: "" },
  // March
  { month: "March", date: "9–10 March", name: "Eid al-Fitr", note: "Expected; subject to moon sighting; date varies by country.", href: "/ramadan-2027-dates/" },
  { month: "March", date: "Wednesday 17 March", name: "St Patrick's Day", note: "" },
  { month: "March", date: "Friday 26 March", name: "Good Friday", note: "" },
  { month: "March", date: "Sunday 28 March", name: "Easter Sunday", note: "", href: "/easter-2027-date/" },
  { month: "March", date: "Monday 29 March", name: "Easter Monday", note: "Observed in the UK and some other countries; not a US federal holiday." },
  // May
  { month: "May", date: "Monday 31 May", name: "Memorial Day", note: "" },
  // June
  { month: "June", date: "Saturday 19 June", name: "Juneteenth National Independence Day", note: "Observed Friday 18 June for most federal Monday–Friday schedules." },
  { month: "June", date: "Sunday 20 June", name: "Father's Day", note: "" },
  // July
  { month: "July", date: "Sunday 4 July", name: "Independence Day", note: "Observed Monday 5 July for most federal Monday–Friday schedules." },
  // August
  { month: "August", date: "Thursday 26 August", name: "International Dog Day", note: "" },
  // September
  { month: "September", date: "Monday 6 September", name: "Labor Day", note: "" },
  // October
  { month: "October", date: "Saturday 2 October", name: "Rosh Hashanah", note: "Jewish calendar; exact observance dates vary by community." },
  { month: "October", date: "Monday 11 October", name: "Yom Kippur", note: "Jewish calendar; exact observance dates vary by community." },
  { month: "October", date: "Friday 29 October", name: "Diwali / Deepavali", note: "Friday 29 October in India. Note: Thursday 28 October is the public holiday in Singapore; regional difference, see the Diwali page.", href: "/diwali-2027-date/" },
  { month: "October", date: "Sunday 31 October", name: "Halloween", note: "", href: "/halloween-2027-date/" },
  // November
  { month: "November", date: "Thursday 11 November", name: "Veterans Day", note: "" },
  { month: "November", date: "Thursday 11 November", name: "Singles Day", note: "Shopping day, not a public holiday." },
  { month: "November", date: "Thursday 25 November", name: "Thanksgiving Day", note: "", href: "/thanksgiving-2027-date/" },
  // December
  { month: "December", date: "Saturday 25 December", name: "Christmas Day", note: "Observed Friday 24 December for most federal Monday–Friday schedules." }
];
---

<BaseLayout
  lang={lang}
  dir={dir}
  title={seoTitle}
  description={pageDescription}
  slug={slug}
  meta={meta}
  enableArticleSchema={true}
  enableFaqSchema={true}
  allowAds={true}
>
  <!-- Hero Banner -->
  <div class="hero-banner">
    <h1 class="hero-banner-title">Holidays in 2027</h1>
    <p style="color: #bdd2dc; font-size: clamp(1rem, 2.2vw, 1.25rem); max-width: 680px; margin: 12px auto 0;">
      A comprehensive month-by-month guide to major national, cultural, and religious holidays across the 2027 calendar year.
    </p>
  </div>

  <div style="max-width: 860px; margin: 0 auto; padding-top: 24px;">

    <!-- ═══════════════════════════════════════════════════════════════════════
         QUICK ANSWER (SERVER-RENDERED DIRECTLY BELOW H1)
         ═══════════════════════════════════════════════════════════════════════ -->
    <section class="quick-answer-card" style="background: var(--panel); border: 2px solid var(--accent); border-radius: 14px; padding: 22px 26px; box-shadow: var(--shadow); margin-bottom: 32px;">
      <h2 style="margin: 0 0 10px; font-size: 1.2rem; font-weight: 800; color: var(--accent); font-family: 'Space Grotesk', system-ui, sans-serif;">
        Quick Answer
      </h2>
      <p style="margin: 0; font-size: 1.05rem; line-height: 1.65; color: #ffffff; font-weight: 500;">
        Major holidays in 2027 include Easter Sunday on 28 March, Labor Day on 6 September, Diwali on 29 October in India, Thanksgiving on 25 November, and Christmas Day on 25 December. Ramadan is expected to start on 8 February, with Eid al-Fitr expected on 9–10 March, subject to moon sighting.
      </p>
    </section>

    <!-- Hero Image Banner -->
    <div style="margin: 0 0 36px; text-align: center;">
      <img
        src="/assets/holidays-2027-hero.webp"
        alt="Calendar for 2027 marking major holidays by month"
        width="960"
        height="540"
        loading="eager"
        decoding="async"
        style="width: 100%; height: auto; border-radius: 12px; border: 1px solid var(--line); box-shadow: var(--shadow);"
      />
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════════
         MAIN CONTENT (STRICT ORDER)
         1. H2: Holidays in 2027 by month
         2. H2: Holidays in September, October, November and December 2027
         3. H2: Holidays in late 2026 — a short look-back
         4. H2: Public holidays vs observances
         5. H2: Frequently Asked Questions About Holidays in 2027
         ═══════════════════════════════════════════════════════════════════════ -->
    <article class="article-content">

      <!-- Section 1: Table -->
      <h2>Holidays in 2027 by month</h2>
      <p>
        The following month-by-month calendar presents the major statutory holidays, cultural celebrations, and religious observances scheduled throughout 2027. Dates are organized chronologically from January to December:
      </p>

      <div class="table-wrapper" style="overflow-x: auto; margin: 24px 0 20px; border: 1px solid var(--line); border-radius: 12px; background: var(--panel);">
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.95rem;">
          <thead>
            <tr style="background: #082030; border-bottom: 2px solid var(--line);">
              <th style="padding: 14px 16px; color: var(--accent); font-weight: 800; font-family: 'Space Grotesk', sans-serif; white-space: nowrap;">Month</th>
              <th style="padding: 14px 16px; color: #38bdf8; font-weight: 800; font-family: 'Space Grotesk', sans-serif; white-space: nowrap;">Date</th>
              <th style="padding: 14px 16px; color: #ffffff; font-weight: 800; font-family: 'Space Grotesk', sans-serif;">Holiday</th>
              <th style="padding: 14px 16px; color: var(--muted); font-weight: 700; font-family: 'Space Grotesk', sans-serif;">Notes</th>
            </tr>
          </thead>
          <tbody>
            {HOLIDAYS_2027.map((h, idx) => (
              <tr style={`border-bottom: 1px solid rgba(255, 255, 255, 0.06); ${idx % 2 === 1 ? 'background: rgba(255, 255, 255, 0.02);' : ''}`}>
                <td style="padding: 12px 16px; font-weight: 800; color: #ffffff; white-space: nowrap;">{h.month}</td>
                <td style="padding: 12px 16px; color: #bdd2dc; white-space: nowrap; font-family: 'Space Grotesk', monospace;">{h.date}</td>
                <td style="padding: 12px 16px; font-weight: 700; color: #ffffff;">{h.href ? <a href={h.href} style="color: var(--accent); text-decoration: underline; text-underline-offset: 2px;">{h.name}</a> : h.name}</td>
                <td style="padding: 12px 16px; color: #94a3b8; font-size: 0.88rem; line-height: 1.45;">{h.note || "—"}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p style="margin-top: 16px; font-style: italic; color: #bdd2dc;">
        Milad un Nabi and Navratri fall in 2027, with exact dates varying by moon sighting and regional calendar — check the official calendar for your country closer to the date.
      </p>

      <!-- Month-by-Month Visual Diagram -->
      <figure style="margin: 32px 0 36px; text-align: center;">
        <img
          src="/assets/holidays-2027-by-month.webp"
          alt="Month-by-month calendar diagram for holidays in 2027"
          width="800"
          height="450"
          loading="lazy"
          decoding="async"
          style="width: 100%; height: auto; border-radius: 12px; border: 1px solid var(--line); box-shadow: var(--shadow);"
        />
        <figcaption style="font-size: 0.88rem; color: var(--muted); margin-top: 10px; font-style: italic;">
          Major holidays in 2027, by month.
        </figcaption>
      </figure>

      <!-- Section 2: Autumn and Year-End Sequence -->
      <h2>Holidays in September, October, November and December 2027</h2>
      <p>
        The final third of 2027 features a dense succession of major commercial, cultural, and family holidays. The season commences with Labor Day in September, followed by the luminous celebrations of <a href="/diwali-2027-date/">Diwali</a> and the festivities of <a href="/halloween-2027-date/">Halloween</a> in October. November brings Veterans Day, the global retail event of Singles Day, and <a href="/thanksgiving-2027-date/">Thanksgiving</a>, culminating with Christmas in December. If you need to plan travel windows, business deadlines, or time off between these seasonal milestones, you can calculate the exact days remaining using our <a href="/days-between-dates-calculator/">Days Between Dates Calculator</a> or coordinate cross-border family calls with our <a href="/">GMT to EST Converter</a>.
      </p>

      <!-- Section 3: Late 2026 Look-back -->
      <h2>Holidays in late 2026 — a short look-back</h2>
      <p style="margin-bottom: 6px;">Veterans Day was Wednesday 11 November 2026.</p>
      <p style="margin-bottom: 6px;">Thanksgiving was Thursday 26 November 2026.</p>
      <p style="margin-bottom: 24px;">Christmas Day was Friday 25 December 2026.</p>

      <!-- Section 4: Public Holidays vs Observances -->
      <h2>Public holidays vs observances</h2>
      <p>
        A public or <a href="/us-federal-holidays-2027/">US federal holiday</a> usually means government offices and many businesses close. An observance or shopping day, such as Singles Day or International Dog Day, does not necessarily mean people have a day off. Readers should check their employer or local calendar for closures; this hub does not claim every listed date is a day off everywhere.
      </p>

      <!-- Section 5: FAQs -->
      <h2>Frequently Asked Questions About Holidays in 2027</h2>
      <div class="faq-container" style="display: flex; flex-direction: column; gap: 14px; margin-top: 20px;">
        {meta.faqs.map((faq) => (
          <details style="background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 16px 20px;">
            <summary style="font-weight: 800; font-size: 1.05rem; cursor: pointer; color: var(--text);">
              {faq.q}
            </summary>
            <p style="margin: 12px 0 0; color: #bdd2dc; font-size: 0.95rem; line-height: 1.6;">
              {faq.a}
            </p>
          </details>
        ))}
      </div>

    </article>

  </div>

  <style>
    .article-content {
      line-height: 1.75;
      color: #bdd2dc;
    }
    .article-content h2 {
      color: #ffffff;
      font-size: clamp(1.35rem, 2.5vw, 1.75rem);
      margin: 36px 0 16px;
      padding-bottom: 8px;
      border-bottom: 1px solid var(--line);
      font-family: "Space Grotesk", system-ui, sans-serif;
    }
    .article-content p {
      margin-bottom: 16px;
    }
    .article-content a {
      color: var(--accent);
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    .article-content a:hover {
      color: #ffffff;
    }
  </style>
</BaseLayout>
