---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import HomePage from "theme/components/HomePage.astro";
import { getLang, getPageMeta, getTranslation, pages } from "theme/i18n/config";

export function getStaticPaths() {
  const standalonePages = new Set([
    "gmt-to-est", "est-to-gmt", "gmt-vs-est", "gmt-to-aedt", "aedt-to-est", "nzdt-to-est", "eat-to-est", "nst-to-est", "jst-to-est",
    "gmt-to-pst", "gmt-to-aest", "aest-to-est", "gmt-to-nzst", "nzst-to-est",
    "gmt-to-acdt", "acdt-to-est", "gmt-to-acst", "acst-to-est", "gmt-to-akdt", "gmt-to-akst", "akdt-to-est",
    "gmt-to-ast", "ast-to-est", "gmt-to-awst", "awst-to-est", "gmt-to-bst", "bst-to-est",
    "gmt-to-cdt", "cdt-to-est", "gmt-to-cest", "cest-to-est", "cet-to-est", "gmt-to-chst", "chst-to-est",
    "gmt-to-cst", "cst-to-est", "cat-to-est", "gmt-to-eat", "gmt-to-eest", "eest-to-est",
    "gmt-to-eet", "eet-to-est", "edt-to-est", "gmt-to-edt", "hst-to-est", "hdt-to-est", "gmt-to-idt", "idt-to-est",
    "gmt-to-ist", "ist-to-est", "gmt-to-kst", "kst-to-est", "gmt-to-mdt", "mdt-to-est",
    "mest-to-est", "gmt-to-met", "gmt-to-mest", "msk-to-est", "gmt-to-ndt", "gmt-to-pdt", "pdt-to-est", "pst-to-est",
    "pkt-to-est", "gmt-to-sast", "gmt-to-sst", "gmt-to-utc", "wat-to-est", "gmt-to-west",
    "west-to-est", "gmt-to-wet", "wet-to-est", "gmt-to-wit", "gmt-to-wita", "wit-to-est", "wita-to-est"
  ]);

  return pages
    .filter((page) => page.slug && !standalonePages.has(page.slug))
    .map((page) => ({
      params: { slug: page.slug },
      props: { page }
    }));
}

const lang = getLang("en");
const { page } = Astro.props;
const t = getTranslation(lang.code);
const meta = getPageMeta(lang.code, page.labelKey, page.context);
const title = meta.title;
const description = meta.description;
const mode = page.kind === "reverse" ? "est-gmt" : "gmt-est";
---

<BaseLayout lang={lang.code} dir={lang.dir} title={title} description={description} slug={page.slug} meta={meta} mode={mode} enableFaqSchema={true}>
  <HomePage labelKey={page.labelKey} title={title} description={description} kind={page.kind} t={t} context={page.context} lang={lang.code} primaryKeyword={meta.title} meta={meta} />
</BaseLayout>
