---
import BaseLayout from "theme/layouts/BaseLayout.astro";

const lang = "en";
const dir = "ltr";
const slug = "us-federal-holidays-2027";
const seoTitle = "US Federal Holidays 2027 | Dates & Observed Days";
const pageDescription = "All 11 US federal holidays in 2027, with legal dates and observed days for weekends, including Thanksgiving and Labor Day.";

const pubDate = "2026-10-25T15:30:00+05:00";
const updatedDate = "2026-10-25T15:45:00+05:00";

const meta = {
  seoTitle,
  exactTitle: true,
  description: pageDescription,
  keywords: "us federal holidays 2027, federal holidays 2027, 2027 federal holiday calendar, observed holidays 2027, legal dates federal holidays",
  pubDate,
  updatedDate,
  author: "Time Intelligence Team",
  faqs: [
    {
      q: "How many US federal holidays are there in 2027?",
      a: "11, from New Year's Day on 1 January to Christmas Day on 25 December 2027."
    },
    {
      q: "When is Labor Day 2027?",
      a: "Monday 6 September 2027, the first Monday in September."
    },
    {
      q: "When is Thanksgiving 2027?",
      a: "Thursday 25 November 2027, the fourth Thursday in November."
    },
    {
      q: "Why is Christmas Day observed on 24 December 2027?",
      a: "Because Christmas Day itself falls on Saturday 25 December 2027, so most federal Monday–Friday employees observe it on Friday 24 December."
    }
  ]
};

// Exactly 11 Federal Holidays defined under 5 U.S.C. 6103
const FEDERAL_HOLIDAYS_2027 = [
  {
    name: "New Year's Day",
    legalDate: "Friday 1 January 2027",
    observedDate: "Friday 1 January 2027",
    isShifted: false
  },
  {
    name: "Birthday of Martin Luther King, Jr.",
    legalDate: "Monday 18 January 2027",
    observedDate: "Monday 18 January 2027",
    isShifted: false
  },
  {
    name: "Washington's Birthday (Presidents Day)",
    legalDate: "Monday 15 February 2027",
    observedDate: "Monday 15 February 2027",
    isShifted: false
  },
  {
    name: "Memorial Day",
    legalDate: "Monday 31 May 2027",
    observedDate: "Monday 31 May 2027",
    isShifted: false
  },
  {
    name: "Juneteenth National Independence Day",
    legalDate: "Saturday 19 June 2027",
    observedDate: "Friday 18 June 2027",
    isShifted: true
  },
  {
    name: "Independence Day",
    legalDate: "Sunday 4 July 2027",
    observedDate: "Monday 5 July 2027",
    isShifted: true
  },
  {
    name: "Labor Day",
    legalDate: "Monday 6 September 2027",
    observedDate: "Monday 6 September 2027",
    isShifted: false
  },
  {
    name: "Columbus Day",
    legalDate: "Monday 11 October 2027",
    observedDate: "Monday 11 October 2027",
    isShifted: false
  },
  {
    name: "Veterans Day",
    legalDate: "Thursday 11 November 2027",
    observedDate: "Thursday 11 November 2027",
    isShifted: false
  },
  {
    name: "Thanksgiving Day",
    legalDate: "Thursday 25 November 2027",
    observedDate: "Thursday 25 November 2027",
    isShifted: false
  },
  {
    name: "Christmas Day",
    legalDate: "Saturday 25 December 2027",
    observedDate: "Friday 24 December 2027",
    isShifted: true
  }
];
---

<BaseLayout
  lang={lang}
  dir={dir}
  title={seoTitle}
  description={pageDescription}
  slug={slug}
  meta={meta}
  enableArticleSchema={true}
  enableFaqSchema={true}
  allowAds={true}
>
  <!-- Hero Banner -->
  <div class="hero-banner">
    <h1 class="hero-banner-title">US Federal Holidays 2027</h1>
    <p style="color: #bdd2dc; font-size: clamp(1rem, 2.2vw, 1.25rem); max-width: 680px; margin: 12px auto 0;">
      Official schedule of all 11 statutory federal holidays, statutory legal dates, and Monday–Friday observed days.
    </p>
  </div>

  <div style="max-width: 860px; margin: 0 auto; padding-top: 24px;">

    <!-- ═══════════════════════════════════════════════════════════════════════
         QUICK ANSWER (SERVER-RENDERED IMMEDIATELY BELOW H1)
         ═══════════════════════════════════════════════════════════════════════ -->
    <section class="quick-answer-card" style="background: var(--panel); border: 2px solid var(--accent); border-radius: 14px; padding: 22px 26px; box-shadow: var(--shadow); margin-bottom: 32px;">
      <h2 style="margin: 0 0 10px; font-size: 1.2rem; font-weight: 800; color: var(--accent); font-family: 'Space Grotesk', system-ui, sans-serif;">
        Quick Answer
      </h2>
      <p style="margin: 0; font-size: 1.05rem; line-height: 1.65; color: #ffffff; font-weight: 500;">
        There are 11 US federal holidays in 2027. They are New Year's Day on 1 January, Martin Luther King, Jr. Day on 18 January, Washington's Birthday on 15 February, Memorial Day on 31 May, Juneteenth on 19 June, Independence Day on 4 July, Labor Day on 6 September, Columbus Day on 11 October, Veterans Day on 11 November, Thanksgiving Day on 25 November, and Christmas Day on 25 December.
      </p>
    </section>

    <!-- Hero Image Banner -->
    <div style="margin: 0 0 36px; text-align: center;">
      <img
        src="/assets/us-federal-holidays-2027-hero.webp"
        alt="Calendar marking the 11 US federal holidays in 2027"
        width="960"
        height="540"
        loading="eager"
        decoding="async"
        style="width: 100%; height: auto; border-radius: 12px; border: 1px solid var(--line); box-shadow: var(--shadow);"
      />
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════════
         MAIN CONTENT (STRICT ORDER)
         1. H2: US federal holidays 2027 — full table
         2. H2: How the observed date rule works
         3. H2: What is closed on a federal holiday?
         4. H2: US federal holidays vs state and school holidays
         5. H2: Frequently Asked Questions About US Federal Holidays in 2027
         ═══════════════════════════════════════════════════════════════════════ -->
    <article class="article-content">

      <!-- Section 1: Full Table -->
      <h2>US federal holidays 2027 — full table</h2>
      <p>
        The table below lists all 11 statutory US federal holidays recognized under Title 5 of the United States Code (5 U.S.C. 6103) for the calendar year 2027. It provides the statutory legal date alongside the observed date for federal employees working standard Monday through Friday schedules:
      </p>

      <div class="table-wrapper" style="overflow-x: auto; margin: 24px 0 16px; border: 1px solid var(--line); border-radius: 12px; background: var(--panel);">
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.95rem;">
          <thead>
            <tr style="background: #082030; border-bottom: 2px solid var(--line);">
              <th scope="col" style="padding: 14px 16px; color: var(--accent); font-weight: 800; font-family: 'Space Grotesk', sans-serif;">Holiday</th>
              <th scope="col" style="padding: 14px 16px; color: #ffffff; font-weight: 800; font-family: 'Space Grotesk', sans-serif; white-space: nowrap;">Legal date</th>
              <th scope="col" style="padding: 14px 16px; color: #38bdf8; font-weight: 800; font-family: 'Space Grotesk', sans-serif; white-space: nowrap;">Observed date for most Monday–Friday federal employees</th>
            </tr>
          </thead>
          <tbody>
            {FEDERAL_HOLIDAYS_2027.map((h, idx) => (
              <tr style={`border-bottom: 1px solid rgba(255, 255, 255, 0.06); ${idx % 2 === 1 ? 'background: rgba(255, 255, 255, 0.02);' : ''}`}>
                <td style="padding: 14px 16px; font-weight: 700; color: #ffffff;">{h.name}</td>
                <td style="padding: 14px 16px; color: #bdd2dc; white-space: nowrap; font-family: 'Space Grotesk', monospace;">{h.legalDate}</td>
                <td style="padding: 14px 16px; white-space: nowrap; font-family: 'Space Grotesk', monospace; color: h.isShifted ? '#fb923c' : '#38bdf8'; font-weight: h.isShifted ? '700' : '500';">
                  {h.observedDate}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Mandatory Boundary Note Immediately After Table -->
      <p style="margin: 16px 0 32px; font-style: italic; color: #bdd2dc; line-height: 1.6; padding: 12px 16px; background: rgba(56, 189, 248, 0.05); border-left: 3px solid #38bdf8; border-radius: 4px;">
        New Year's Day 2028 falls on Saturday 1 January 2028, observed Friday 31 December 2027 for most federal Monday–Friday schedules. That is a boundary observance, not a twelfth 2027 holiday.
      </p>

      <!-- Section 2: How the observed date rule works -->
      <h2>How the observed date rule works</h2>
      <p>
        Under federal law (5 U.S.C. 6103) and guidelines issued by the US Office of Personnel Management (OPM), when a public holiday falls on a non-workday for full-time employees, an alternate "in lieu of" holiday is designated:
      </p>
      <ul style="padding-left: 24px; margin-bottom: 20px; line-height: 1.7;">
        <li style="margin-bottom: 8px;">
          <strong>Saturday holidays:</strong> When a federal holiday falls on a Saturday, most federal employees with a regular Monday through Friday workweek observe the holiday on the immediately preceding Friday.
        </li>
        <li style="margin-bottom: 8px;">
          <strong>Sunday holidays:</strong> When a federal holiday falls on a Sunday, most federal employees with a regular Monday through Friday workweek observe the holiday on the following Monday.
        </li>
      </ul>
      <p>
        In 2027, this statutory mechanism explains the difference between the legal calendar dates and observed dates for three holidays:
      </p>
      <ul style="padding-left: 24px; margin-bottom: 24px; line-height: 1.7;">
        <li style="margin-bottom: 8px;">
          <strong>Juneteenth National Independence Day:</strong> The legal date is Saturday 19 June 2027; the observed federal holiday is Friday 18 June 2027.
        </li>
        <li style="margin-bottom: 8px;">
          <strong>Independence Day:</strong> The legal date is Sunday 4 July 2027; the observed federal holiday is Monday 5 July 2027.
        </li>
        <li style="margin-bottom: 8px;">
          <strong>Christmas Day:</strong> The legal date is Saturday 25 December 2027; the observed federal holiday is Friday 24 December 2027.
        </li>
      </ul>
      <p>
        This observance framework applies specifically as the general federal employee rule. Individual work schedules, compressed work schedules, and collective bargaining or private employment agreements may specify alternate arrangements. The designation of an observed day off does not alter or relocate the holiday's underlying statutory legal date.
      </p>

      <!-- Table Diagram Visual Image -->
      <figure style="margin: 32px 0 36px; text-align: center;">
        <img
          src="/assets/us-federal-holidays-2027-table.webp"
          alt="Table of US federal holidays in 2027 with legal and observed dates"
          width="800"
          height="450"
          loading="lazy"
          decoding="async"
          style="width: 100%; height: auto; border-radius: 12px; border: 1px solid var(--line); box-shadow: var(--shadow);"
        />
        <figcaption style="font-size: 0.88rem; color: var(--muted); margin-top: 10px; font-style: italic;">
          Legal date and observed date differ when a holiday falls on a weekend.
        </figcaption>
      </figure>

      <!-- Section 3: What is closed on a federal holiday? -->
      <h2>What is closed on a federal holiday?</h2>
      <p>
        On designated US federal holidays, non-essential federal government offices are closed, and federal civil service employees receive paid holiday leave. Regular United States Postal Service (USPS) mail delivery is suspended, subject to each holiday's published operating and priority delivery arrangements.
      </p>
      <p>
        However, closures beyond the federal civil service depend on separate jurisdictions:
      </p>
      <ul style="padding-left: 24px; margin-bottom: 20px; line-height: 1.7;">
        <li style="margin-bottom: 8px;">
          <strong>Banks and financial markets:</strong> Most commercial banks follow the Federal Reserve holiday schedule and close, while major stock exchanges (such as the NYSE and Nasdaq) typically observe federal holidays, though operating hours may vary.
        </li>
        <li style="margin-bottom: 8px;">
          <strong>Schools and state offices:</strong> Public school districts, state agencies, and municipal offices operate on state-determined calendars and are not legally bound by federal designations.
        </li>
        <li style="margin-bottom: 8px;">
          <strong>Private employers:</strong> Private companies and retail businesses establish their own holiday policies; many remain open on holidays like Columbus Day or Washington's Birthday.
        </li>
        <li style="margin-bottom: 8px;">
          <strong>Day after Thanksgiving:</strong> The Friday after Thanksgiving (commonly known as Black Friday) is not a US federal holiday, although many state governments and corporate employers grant it as a discretionary paid day off.
        </li>
      </ul>

      <!-- Section 4: US federal holidays vs state and school holidays -->
      <h2>US federal holidays vs state and school holidays</h2>
      <p>
        United States federal law does not establish national holidays that automatically bind state governments, local school boards, or private enterprises. Individual states retain the sovereign authority to create distinct state holidays, choose whether to adopt federal closures, or designate alternative cultural observances.
      </p>
      <p>
        For instance, while federal agencies observe Columbus Day on Monday 11 October 2027, numerous states and cities designate the day as Indigenous Peoples' Day, either celebrating it concurrently or replacing Columbus Day on their official calendars. Similarly, states like Texas observe Juneteenth under state statute alongside separate state holidays like Texas Independence Day, while Massachusetts and Maine observe Patriots' Day in April.
      </p>
      <p>
        To coordinate schedules, project deadlines, and vacations across multiple states or international teams, you can consult our overarching <a href="/holidays-2027/">Holidays in 2027</a> calendar hub, compute exact business day intervals with our <a href="/days-between-dates-calculator/">Days Between Dates Calculator</a>, or convert meeting times across US and global time zones using the <a href="/">GMT to EST Converter</a>. We recommend checking your specific state, school district, or employer personnel calendar for localized closures around major milestones such as Labor Day 2027 and <a href="/thanksgiving-2027-date/">Thanksgiving 2027</a>.
      </p>

      <!-- Section 5: FAQs -->
      <h2>Frequently Asked Questions About US Federal Holidays in 2027</h2>
      <div class="faq-container" style="display: flex; flex-direction: column; gap: 14px; margin-top: 20px;">
        {meta.faqs.map((faq) => (
          <details style="background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 16px 20px;">
            <summary style="font-weight: 800; font-size: 1.05rem; cursor: pointer; color: var(--text);">
              {faq.q}
            </summary>
            <p style="margin: 12px 0 0; color: #bdd2dc; font-size: 0.95rem; line-height: 1.6;">
              {faq.a}
            </p>
          </details>
        ))}
      </div>

    </article>

  </div>

  <style>
    .article-content {
      line-height: 1.75;
      color: #bdd2dc;
    }
    .article-content h2 {
      color: #ffffff;
      font-size: clamp(1.35rem, 2.5vw, 1.75rem);
      margin: 36px 0 16px;
      padding-bottom: 8px;
      border-bottom: 1px solid var(--line);
      font-family: "Space Grotesk", system-ui, sans-serif;
    }
    .article-content p {
      margin-bottom: 16px;
    }
    .article-content a {
      color: var(--accent);
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    .article-content a:hover {
      color: #ffffff;
    }
  </style>
</BaseLayout>
