          height="720"
          loading="lazy" 
          decoding="async" 
        />
      </picture>
      <figcaption class="infographic-caption">{imagesMeta[8].caption}</figcaption>
    </figure>

    <p>
      Always represent London events using ISO 8601 formatting and reference the IANA location name <code>Europe/London</code>:
    </p>
    <ul>
      <li><strong>Standard (Winter/GMT):</strong> <code>2026-12-15T10:00:00Z</code> or <code>2026-12-15T10:00:00+00:00</code></li>
      <li><strong>Summer (Daylight/BST):</strong> <code>2026-06-15T10:00:00+01:00</code></li>
    </ul>

    <!-- Visual 10: Annual DST Calendar -->
