      {
        "@type": "Question",
        "name": "Which states use PDT?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "States using PDT seasonally include California, Washington, Oregon, Nevada, and the Canadian province of British Columbia."
        }
