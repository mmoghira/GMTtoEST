---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import Converter from "theme/components/Converter.astro";
import { getLang, getTranslation, getPageMeta } from "theme/i18n/config";

const lang = "en";
const dir = "ltr";
const slug = "gmt-to-pdt";
const t = getTranslation(lang);
const meta = getPageMeta(lang, "gmtToPdt");

const seoTitle = "GMT to PDT Converter – Convert Greenwich Time to Pacific Daylight Time";
const pageDescription = "Convert GMT to PDT instantly. View the 24-hour conversion chart, check Pacific Daylight Time rules, and plan meetings with our calculator.";

const context = {
  from: "GMT",
  to: "PDT",
  fromZone: "UTC",
  toZone: "America/Los_Angeles"
};

const canonical = "https://gmttoestconverter.com/gmt-to-pdt/";

// Helper to format 12-hour values
function formatHour12(hour: number, minute: number = 0) {
  const normalized = ((hour % 24) + 24) % 24;
  const period = normalized < 12 ? "AM" : "PM";
  const displayHour = normalized % 12 || 12;
  return `${displayHour}:${String(minute).padStart(2, "0")} ${period}`;
}

// Generate the 24-hour comparative table rows (PDT = GMT - 7, PST = GMT - 8)
const conversionRows = Array.from({ length: 24 }, (_, hour) => {
  const pdtHour = (hour - 7 + 24) % 24;
  const pdtDayDiff = (hour - 7) < 0 ? "Previous day" : "Same day";

  const pstHour = (hour - 8 + 24) % 24;
  const pstDayDiff = (hour - 8) < 0 ? "Previous day" : "Same day";

  return {
    gmt: formatHour12(hour),
    pdt: `${formatHour12(pdtHour)} PDT (${pdtDayDiff})`,
    pst: `${formatHour12(pstHour)} PST (${pstDayDiff})`,
    offset: "GMT is UTC+0 | PDT is UTC-7 / PST is UTC-8",
    notes: `Winter gap: 8h (PST). Summer gap: 7h (PDT relative to GMT baseline).`
  };
});

// JSON-LD Schema definitions
const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "GMT to PDT Converter",
    "applicationCategory": "UtilitiesApplication",
    "operatingSystem": "Any",
    "url": canonical,
    "description": "Free online GMT to PDT converter with real-time clocks, DST-aware calculations, and Pacific Daylight Time guidelines."
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is PDT?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "PDT stands for Pacific Daylight Time, which is the timezone offset used along the North American Pacific Coast (UTC-7) during the summer months."
        }
