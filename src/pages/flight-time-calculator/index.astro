---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import { siteUrl } from "theme/i18n/config";

const lang = "en";
const dir = "ltr";
const slug = "flight-time-calculator";

const pageTitle = "International Flight Time & Jet Lag Calculator";
const seoTitle = "Flight Time Calculator & Travel Time Zone Guide – Jet Lag Mitigation";
const pageDescription = "Calculate local arrival times for international flights crossing time zones between GMT, EST, PST, and CET. Flight duration math, date line shifts, and jet lag adaptation.";

const canonical = `${siteUrl}/flight-time-calculator/`;

const faqs = [
  {
    q: "How do time zone changes affect flight arrival times?",
    a: "Flight arrival times are always displayed in the local time zone of the destination airport. Subtracting origin time from destination arrival time requires factoring in both flight duration and net time zone offset."
  },
  {
    q: "What is the formula for calculating international flight arrival time?",
    a: "Local Arrival Time = Departure Local Time + Flight Duration + Net Time Zone Offset (Destination Zone Offset minus Origin Zone Offset)."
  }
];

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "Flight time calculator, international travel time zone, jet lag calculator, departure arrival timezone, GMT EST flight time",
  image: "/assets/gmt-to-est-timeflow-hero.png",
  imageAlt: "Flight Time Calculator Travel Guide",
  faqs
};
---

<BaseLayout
  lang={lang}
  dir={dir}
  title={seoTitle}
  description={pageDescription}
  slug={slug}
  meta={meta}
  mode="gmt-est"
  enableFaqSchema={true}
  allowAds={true}
  breadcrumbHomeLabel="Home"
  breadcrumbLabel="Flight Calculator"
  hreflangCodes={["en"]}
>
  <header class="hero-banner">
    <div class="hero-content">
      <span class="eyebrow">International Travel &amp; Aviation</span>
      <h1 class="hero-banner-title">Flight Time <span class="gradient-text">Calculator</span></h1>
      <p class="hero-subtitle">
        Understand transcontinental flight durations, local airport arrival shifts, and circadian rhythm adaptation for flights crossing global meridians.
      </p>
    </div>
  </header>

  <div style="max-width: 900px; margin: 0 auto; padding: 2rem 16px;">
    <section class="content-section">
      <h2>Flight Time Conversion Mathematics</h2>
      <p>
        When flying west-to-east (e.g., New York JFK to London LHR), your destination is 5 hours ahead. A 7-hour flight departing New York at 8:00 PM EST lands at 3:00 AM EST, which corresponds to <strong>8:00 AM GMT (local London time)</strong> the next morning.
      </p>
    </section>

    <!-- CONTEXTUAL INTERNAL LINKS -->
    <section class="content-section" style="margin-top: 3rem;">
      <h2>Travel &amp; Time Resources</h2>
      <ul style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px; list-style: none; padding: 0;">
        <li><a href="/travel-planner/" style="display: block; padding: 10px; background: var(--panel); border: 1px solid var(--line); border-radius: 8px; text-decoration: none; text-align: center;">Travel Time Planner</a></li>
        <li><a href="/time-zone-map/" style="display: block; padding: 10px; background: var(--panel); border: 1px solid var(--line); border-radius: 8px; text-decoration: none; text-align: center;">Interactive Time Zone Map</a></li>
        <li><a href="/world-clock/" style="display: block; padding: 10px; background: var(--panel); border: 1px solid var(--line); border-radius: 8px; text-decoration: none; text-align: center;">Global World Clock</a></li>
        <li><a href="/gmt-to-est/" style="display: block; padding: 10px; background: var(--panel); border: 1px solid var(--line); border-radius: 8px; text-decoration: none; text-align: center;">GMT to EST Converter</a></li>
      </ul>
    </section>

    <!-- FAQ SECTION -->
    <section class="faq-section content-section" id="faq" aria-labelledby="faq-heading">
      <h2 id="faq-heading">Frequently Asked Questions</h2>
      <div class="faq-grid">
        {faqs.map((item) => (
          <details class="faq-item">
            <summary class="faq-question"><strong>{item.q}</strong></summary>
            <div class="faq-answer"><p>{item.a}</p></div>
          </details>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
