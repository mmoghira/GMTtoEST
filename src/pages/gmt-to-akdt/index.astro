---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import Converter from "theme/components/Converter.astro";
import { getLang, getTranslation, getPageMeta } from "theme/i18n/config";

const lang = "en";
const dir = "ltr";
const slug = "gmt-to-akdt";
const t = getTranslation(lang);
const meta = getPageMeta(lang, "gmtToAkdt");

const pageTitle = "GMT to AKDT Converter";
const seoTitle = "GMT to AKDT Converter – Convert GMT to Alaska Time";
const pageDescription = "Convert GMT to AKDT instantly. View the live 24-hour conversion chart, check DST changes between GMT and Alaska, and plan meetings with our time calculator.";

const context = {
  from: "GMT",
  to: "AKDT",
  fromZone: "UTC",
  toZone: "America/Anchorage"
};

const canonical = "https://gmttoestconverter.com/gmt-to-akdt/";

// Helper to format 12-hour values
function formatHour12(hour: number, minute: number = 0) {
  const normalized = ((hour % 24) + 24) % 24;
  const period = normalized < 12 ? "AM" : "PM";
  const displayHour = normalized % 12 || 12;
  return `${displayHour}:${String(minute).padStart(2, "0")} ${period}`;
}

// Generate the 24-hour comparative table rows (AKDT = GMT - 8, AKST = GMT - 9)
const conversionRows = Array.from({ length: 24 }, (_, hour) => {
  const akdtHour = hour - 8;
  const akdtHourNormalized = ((akdtHour % 24) + 24) % 24;
  const akdtDayNote = akdtHour < 0 ? "Previous day" : "Same day";

  const akstHour = hour - 9;
  const akstHourNormalized = ((akstHour % 24) + 24) % 24;
  const akstDayNote = akstHour < 0 ? "Previous day" : "Same day";

  return {
    gmt: formatHour12(hour),
    akdt: `${formatHour12(akdtHourNormalized)} AKDT (${akdtDayNote})`,
    akst: `${formatHour12(akstHourNormalized)} AKST (${akstDayNote})`,
    offsetAkdt: "UTC-8",
    offsetAkst: "UTC-9"
  };
});

// JSON-LD Schema definitions
const schemaData = [
