---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import { siteUrl } from "theme/i18n/config";
import RelatedConvertersWidget from "theme/components/RelatedConvertersWidget.astro";

const lang = "en";
const dir = "ltr";
const slug = "tools";
const seoTitle = "Time Zone Tools — Free Online Converters, Planners & Calculators";
const pageDescription = "Explore our complete hub of time zone tools, including world clocks, meeting planners, event converters, developer toolkits, and DST calendars.";

const pubDate = "2026-07-30T15:00:00+05:00";
const updatedDate = "2026-07-30T15:00:00+05:00";

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "time zone tools, timezone converters, world clock, meeting planner, jet lag calculator",
  image: "/assets/tools-hub-og.png",
  imageAlt: "Time Zone Tools Hub",
  pubDate,
  updatedDate
};

const pageUrlPath = `${siteUrl}/${slug}/`;

const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Time Zone Tools Hub",
    "description": pageDescription,
    "url": pageUrlPath
  }
];

const categories = [
  {
    title: "Clocks & Converters",
    icon: "⏰",
    tools: [
      { name: "World Clock", desc: "Live time in 200+ cities globally.", path: "/world-clock/", icon: "🌍" },
      { name: "Event Time Converter", desc: "Convert event times across multiple zones simultaneously.", path: "/event-time-converter/", icon: "🎯" },
      { name: "GMT to EST Converter", desc: "Convert GMT to Eastern Time instantly.", path: "/", icon: "⏱️" },
      { name: "Time Difference Calculator", desc: "Calculate exact difference between any two cities.", path: "/time-difference-calculator/", icon: "⚖️" }
    ]
  },
  {
    title: "Planners & Schedulers",
    icon: "📅",
    tools: [
      { name: "Meeting Planner", desc: "Schedule global meetings by finding optimal times.", path: "/meeting-planner/", icon: "🤝" },
      { name: "Business Hours Overlap", desc: "Find working overlap windows across remote teams.", path: "/business-hours-overlap/", icon: "💼" },
      { name: "Travel Planner", desc: "Plan travel schedules and estimate jet lag severity.", path: "/travel-planner/", icon: "✈️" }
    ]
  },
  {
    title: "Calendars & Data",
    icon: "📆",
    tools: [
      { name: "DST Calendar", desc: "Daylight Saving Time transition dates 2026–2030.", path: "/dst-calendar/", icon: "🔄" },
      { name: "Holiday Calendar", desc: "Public holidays for 40+ countries.", path: "/holiday-calendar/", icon: "🎉" }
    ]
  },
  {
    title: "For Developers",
    icon: "👨‍💻",
    tools: [
      { name: "Developer Toolkit", desc: "Unix timestamp, ISO 8601, and IANA timezone references.", path: "/developer-tools/", icon: "🛠️" }
    ]
  }
];

---
<BaseLayout
  lang={lang}
  dir={dir}
  title={seoTitle}
  description={pageDescription}
  slug={slug}
  meta={meta}
  mode="gmt-est"
  enableFaqSchema={false}
  enableArticleSchema={true}
  allowAds={true}
  breadcrumbHomeLabel="Home"
  breadcrumbLabel="All Tools"
>
  <script type="application/ld+json" set:html={JSON.stringify(schemas)} slot="head" />
  
  <section class="hero-banner">
    <h1 class="hero-banner-title">
      Time Zone <span class="gradient-text">Tools Platform</span>
    </h1>
    <p style="color: var(--muted); margin-top: 1rem; font-size: 1.2rem; max-width: 800px; margin-left: auto; margin-right: auto;">
      A comprehensive suite of free, highly accurate time zone utilities. Whether you're scheduling an international meeting, building software, or planning a trip, we have the right tool.
    </p>
  </section>

  <div class="tools-layout">
    <div class="main-content">
      {categories.map(cat => (
        <section class="category-section">
          <h2><span class="cat-icon">{cat.icon}</span> {cat.title}</h2>
          <div class="tools-grid">
            {cat.tools.map(tool => (
              <a href={tool.path} class="tool-card">
                <div class="tool-icon">{tool.icon}</div>
                <div class="tool-info">
                  <h3>{tool.name}</h3>
                  <p>{tool.desc}</p>
                </div>
              </a>
            ))}
          </div>
        </section>
      ))}

      <section class="educational-content content-section">
        <h2>Why Use Our Time Zone Tools?</h2>
        <p>
          Managing time across borders is notoriously complex. Between disparate Daylight Saving Time rules, the International Date Line, and historical political changes to timekeeping, manual calculations are prone to error. Our platform automates the heavy lifting.
        </p>
        
        <h3>Accurate & Up-to-Date</h3>
        <p>
          All of our tools are powered by the authoritative IANA Time Zone Database (tzdb). This means that when a country suddenly announces a change to their Daylight Saving Time laws—which happens more often than you might think—our tools reflect those changes immediately, ensuring your global meetings and travel plans are never derailed by unexpected clock shifts.
        </p>

        <h3>Designed for Every Workflow</h3>
        <p>
          We've built specialized interfaces for different use cases. A developer debugging a server log needs completely different information (like Unix timestamps and UTC offsets) than a project manager trying to schedule a standup across Tokyo, London, and San Francisco. By segmenting our platform into distinct, focused tools, we provide the cleanest, most efficient user experience possible.
        </p>

        <h3>Privacy First & Client-Side Processing</h3>
        <p>
          Whenever possible, our tools run directly in your browser. This means your data—whether it's travel itineraries or meeting schedules—doesn't need to be sent to our servers for processing. It's fast, secure, and respectful of your privacy.
        </p>
      </section>

    </div>
    
    <aside class="sidebar">
      <div class="quick-links-card">
        <h3>⚡ Popular Converters</h3>
        <ul class="quick-list">
          <li><a href="/">GMT to EST</a></li>
          <li><a href="/est-to-gmt/">EST to GMT</a></li>
          <li><a href="/cst-to-est/">CST to EST</a></li>
          <li><a href="/pst-to-est/">PST to EST</a></li>
          <li><a href="/ist-to-est/">IST to EST</a></li>
          <li><a href="/bst-to-est/">BST to EST</a></li>
        </ul>
      </div>

      <div class="quick-links-card">
        <h3>📚 Helpful Guides</h3>
        <ul class="quick-list">
          <li><a href="/time-zone-guide/">Global Time Zone Guide</a></li>
          <li><a href="/blog/what-is-gmt/">What is GMT?</a></li>
          <li><a href="/blog/what-is-est/">What is EST?</a></li>
          <li><a href="/daylight-saving-time-explained/">DST Explained</a></li>
          <li><a href="/gmt-vs-est/">GMT vs EST Difference</a></li>
        </ul>
      </div>
    </aside>
  </div>

</BaseLayout>

<style>
  .tools-layout {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 3rem;
    margin: 3rem 0;
  }
  @media (max-width: 900px) {
    .tools-layout {
      grid-template-columns: 1fr;
    }
  }
  .category-section {
    margin-bottom: 4rem;
  }
  .category-section h2 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 2rem;
    color: var(--text);
    border-bottom: 1px solid var(--line);
    padding-bottom: 1rem;
    margin-bottom: 2rem;
  }
  .cat-icon {
    font-size: 2.2rem;
  }
  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  .tool-card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    background: var(--panel);
    border: 1px solid var(--line);
    padding: 1.5rem;
    border-radius: 12px;
    text-decoration: none;
    transition: all 0.2s ease;
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
  }
  .tool-card:hover {
    transform: translateY(-5px);
    border-color: var(--accent);
    box-shadow: 0 10px 25px rgba(0,0,0,0.2);
  }
  .tool-icon {
    font-size: 2.5rem;
    line-height: 1;
    background: var(--bg);
    padding: 1rem;
    border-radius: 12px;
    border: 1px solid var(--line);
  }
  .tool-card:hover .tool-icon {
    border-color: var(--accent);
  }
  .tool-info h3 {
    margin: 0 0 0.5rem;
    color: var(--accent-2);
    font-size: 1.2rem;
  }
  .tool-info p {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.4;
  }
  .quick-links-card {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .quick-links-card h3 {
    margin: 0 0 1rem;
    color: var(--accent);
    font-size: 1.2rem;
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.5rem;
  }
  .quick-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .quick-list li {
    margin-bottom: 0.8rem;
  }
  .quick-list a {
    color: var(--text);
    text-decoration: none;
    font-weight: bold;
    display: flex;
    align-items: center;
    transition: color 0.2s;
  }
  .quick-list a::before {
    content: "→";
    margin-right: 8px;
    color: var(--accent-2);
  }
  .quick-list a:hover {
    color: var(--accent);
  }
</style>
