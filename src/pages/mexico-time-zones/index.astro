---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import { siteUrl } from "theme/i18n/config";

const lang = "en";
const dir = "ltr";
const slug = "mexico-time-zones";
const seoTitle = "Mexico Time Zones Guide: Map, 2022 DST Law & Offsets (2026)";
const pageDescription = "Complete guide to Mexico time zones. Learn about Mexico City time (CST, UTC-6), Cancún time (EST, UTC-5), Baja California rules, and the 2022 DST law repeal.";

const pubDate = "2026-07-30T15:00:00+05:00";
const updatedDate = "2026-07-30T15:00:00+05:00";

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "Mexico Time Zones, Mexico Time Zone Map, Mexico City Time, Cancun Time Zone, UTC-6, UTC-5, UTC-7, UTC-8, Mexico Daylight Saving Time 2022 Law, Tijuana Time, Mexico Time Guide",
  image: "/assets/mexico-time-zone-map.webp",
  imageAlt: "Mexico Time Zones Map Graphic showing 4 main zones and border rules",
  pubDate,
  updatedDate,
  author: "Jackie Bruce",
  faqs: [
    {
      q: "How many time zones does Mexico have?",
      a: "Mexico officially operates four primary time zones: Zona Sureste (UTC-5), Zona Centro (UTC-6), Zona Pacífico (UTC-7), and Zona Noroeste (UTC-8)."
    },
    {
      q: "Does Mexico observe Daylight Saving Time?",
      a: "Most of Mexico abolished Daylight Saving Time (DST) in October 2022 under the Ley de los Husos Horarios. However, the state of Baja California and municipalities along the US northern border strip continue to observe DST in alignment with North American DST rules."
    },
    {
      q: "What time zone is Mexico City in?",
      a: "Mexico City is in the Central Time Zone (Zona Centro). Since October 2022, Mexico City remains permanently on Central Standard Time (CST, UTC-6) year-round and no longer shifts to CDT."
    },
    {
      q: "What time zone is Cancún in?",
      a: "Cancún and the state of Quintana Roo are in the Southeast Zone (Zona Sureste), operating on Eastern Standard Time (EST, UTC-5) year-round without Daylight Saving Time."
    },
    {
      q: "Why is Cancún in a different time zone than Mexico City?",
      a: "In 2015, Quintana Roo created the Southeast Time Zone (UTC-5) so Cancún and the Riviera Maya would share the same time zone as US Eastern airports (like Miami and New York), providing an extra hour of evening daylight for tourists."
    },
    {
      q: "What time zone is Tijuana in?",
      a: "Tijuana and the entire state of Baja California operate on Pacific Time (PST, UTC-8 in winter / PDT, UTC-7 in summer). Baja California continues to observe US Daylight Saving Time to synchronize with San Diego, California."
    },
    {
      q: "What time zone is Sonora in?",
      a: "Sonora operates on Mountain Standard Time (MST, UTC-7) year-round and does not observe Daylight Saving Time, keeping its clock synchronized with neighboring Arizona in the United States."
    },
    {
      q: "What is the Northern Border Strip exception in Mexico?",
      a: "Under Mexico's 2022 time zone law, municipalities located within 20 kilometers of the US border (in states like Coahuila, Tamaulipas, Chihuahua, and Nuevo León) are permitted to observe US Daylight Saving Time to prevent economic disruption for cross-border commuter workers and trade."
    },
    {
      q: "What is the time difference between Mexico City and New York?",
      a: "During US winter (EST, UTC-5), Mexico City (CST, UTC-6) is 1 hour behind New York. During US summer (EDT, UTC-4), Mexico City is 2 hours behind New York because Mexico City no longer advances to CDT."
    },
    {
      q: "What is the time difference between Mexico City and London?",
      a: "During UK winter (GMT, UTC+0), Mexico City is 6 hours behind London. During UK summer (BST, UTC+1), Mexico City is 7 hours behind London."
    },
    {
      q: "What is the IANA time zone identifier for Mexico City?",
      a: "The primary IANA time zone identifier for central Mexico is `America/Mexico_City`."
    },
    {
      q: "What is the IANA time zone identifier for Cancún?",
      a: "The IANA time zone identifier for Cancún and Quintana Roo is `America/Cancun`."
    },
    {
      q: "What is the IANA time zone identifier for Tijuana?",
      a: "The IANA time zone identifier for Tijuana and Baja California is `America/Tijuana`."
    },
    {
      q: "What are the stock trading hours of the Bolsa Mexicana de Valores (BMV)?",
      a: "The Mexican Stock Exchange (BMV) in Mexico City operates trading from 08:30 to 15:00 CST year-round, aligning its market hours with the New York Stock Exchange."
    },
    {
      q: "What is the solar time span across Mexico?",
      a: "Mexico's geographical longitude extends from 86°42' W in Isla Mujeres to 118°22' W in Guadalupe Island, creating a natural solar difference of over 2 hours."
    },
    {
      q: "What time zone is Guadalajara in?",
      a: "Guadalajara is located in Jalisco state and operates on Central Standard Time (CST, UTC-6) year-round."
    },
    {
      q: "What time zone is Monterrey in?",
      a: "Monterrey, capital of Nuevo León, operates on Central Standard Time (CST, UTC-6) year-round. Note that border towns in northern Nuevo León follow US DST rules."
    },
    {
      q: "What is the best time for business calls between Mexico City and US East Coast?",
      a: "Because Mexico City (UTC-6) is only 1 to 2 hours behind US Eastern Time, business teams enjoy extensive overlap from 09:00 to 17:00."
    },
    {
      q: "Did Ciudad Juárez change time zones recently?",
      a: "Yes. In November 2022, following local congress petitions, Ciudad Juárez (across from El Paso, Texas) officially aligned its time zone with Mountain Time (MST/MDT), synchronizing with El Paso."
    },
    {
      q: "How should software developers configure timezone rules for Mexico?",
      a: "Developers must ensure server libraries reflect the 2022 DST repeal law by updating to IANA time zone database version 2022e or later, using exact keys like `America/Mexico_City`, `America/Cancun`, `America/Tijuana`, and `America/Hermosillo`."
    }
  ]
};

const pageUrlPath = `${siteUrl}/mexico-time-zones/`;

const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    "@id": `${pageUrlPath}#article`,
    "mainEntityOfPage": pageUrlPath,
    "headline": seoTitle,
    "description": pageDescription,
    "datePublished": pubDate,
    "dateModified": updatedDate,
    "inLanguage": "en",
    "author": {
      "@type": "Person",
      "name": "Jackie Bruce",
      "jobTitle": "Senior Time Zone Analyst",
      "url": `${siteUrl}/author/jackie-bruce/`
    },
    "publisher": {
      "@type": "Organization",
      "name": "GMT to EST Converter",
      "logo": {
        "@type": "ImageObject",
        "url": `${siteUrl}/logo.svg`
      }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "SpeakableSpecification",
    "cssSelector": [".speakable-headline", ".speakable-summary"]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": `${siteUrl}/`
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Mexico Time Zones Guide",
        "item": pageUrlPath
      }
    ]
  },
  ...["Zona Sureste", "Zona Centro", "Zona Pacifico", "Zona Noroeste"].map((zone, idx) => ({
    "@context": "https://schema.org",
    "@type": "DefinedTerm",
    "@id": `${siteUrl}/#zone-mx-${idx}`,
    "name": `${zone} Mexico`,
    "description": `Official time zone region established under Mexican federal time laws.`
  }))
];
---

<BaseLayout
  lang={lang}
  dir={dir}
  title={seoTitle}
  description={pageDescription}
  slug={slug}
  meta={meta}
  mode="gmt-est"
  enableFaqSchema={true}
  enableArticleSchema={true}
  allowAds={true}
  breadcrumbHomeLabel="Home"
  breadcrumbLabel="Mexico Time Zones Guide"
  hreflangCodes={["en"]}
>
  <script type="application/ld+json" set:html={JSON.stringify(schemas)} slot="head" />

  <!-- HERO & SUMMARY SECTION -->
  <section class="hero-banner" aria-labelledby="hero-title">
    <h1 id="hero-title" class="hero-banner-title speakable-headline">
      Mexico Time Zones Guide: <span class="gradient-text">Map, 2022 DST Law &amp; Offsets</span>
    </h1>
  </section>

  <div class="editorial-meta-bar" aria-label="Editorial metadata">
    <span>Last Updated: <strong>July 30, 2026</strong></span>
    <span class="separator" aria-hidden="true">•</span>
    <span>Editorially Reviewed by <a href="/author/jackie-bruce/"><strong>Jackie Bruce</strong></a></span>
    <span class="separator" aria-hidden="true">•</span>
    <span>Data Source: <a href="https://www.gob.mx/se" target="_blank" rel="noopener noreferrer"><strong>Secretaría de Economía (Mexico)</strong></a></span>
  </div>

  <section class="acdt-intro content-section" aria-label="Quick Guide Summary">
    <div class="info-callout speakable-summary" style="background: var(--panel); border-left: 4px solid var(--accent); padding: 1.5rem; margin-bottom: 2rem; border-radius: 6px;">
      <h3 style="margin-top: 0;">Quick Summary: What Time Zone is Mexico In?</h3>
      <p>
        <strong>Mexico operates four primary time zones:</strong>
      </p>
      <ol style="margin-bottom: 0;">
        <li><strong>Zona Sureste (EST, UTC-5):</strong> Quintana Roo (Cancún, Cozumel, Riviera Maya) — Fixed UTC-5 year-round.</li>
        <li><strong>Zona Centro (CST, UTC-6):</strong> Mexico City, Guadalajara, Monterrey, Puebla — Fixed UTC-6 year-round.</li>
        <li><strong>Zona Pacífico (MST, UTC-7):</strong> Sonora (UTC-7 year-round), Sinaloa, Nayarit, Baja California Sur.</li>
        <li><strong>Zona Noroeste (PST/PDT, UTC-8/UTC-7):</strong> Baja California (Tijuana, Mexicali) — Observes US Daylight Saving Time.</li>
      </ol>
      <p style="margin-top: 0.8rem;">
        Under the <em>Ley de los Husos Horarios</em> enacted in October 2022, <strong>Daylight Saving Time was abolished across most of Mexico</strong>, except in Baja California and designated northern border municipalities aligned with US trade.
      </p>
    </div>

    <div class="reading-meta" style="margin-top: 1rem; color: var(--muted); font-size: 0.9rem;">
      <span>⏱️ Estimated Reading Time: <strong>23 minutes</strong></span>
    </div>
  </section>

  <!-- TABLE OF CONTENTS -->
  <section class="table-of-contents reveal" aria-label="Table of Contents" style="background: var(--panel); padding: 1.5rem; border-radius: 8px; margin: 2rem 0;">
    <span class="toc-kicker" style="font-weight: bold; color: var(--accent); text-transform: uppercase; font-size: 0.85rem;">Detailed Navigation</span>
    <h2 style="margin-top: 0.5rem;">Guide Contents</h2>
    <ol style="line-height: 1.8;">
      <li><a href="#overview-mexico-zones">1. Overview of Mexico's Four Time Zones</a></li>
      <li><a href="#the-2022-dst-law">2. The 2022 Law Reform: Abolition of DST in Central Mexico</a></li>
      <li><a href="#cancun-southeast-zone">3. Zona Sureste (Cancún &amp; Quintana Roo EST UTC-5)</a></li>
      <li><a href="#border-strip-exceptions">4. Northern Border Strip (*Franja Fronteriza*) &amp; Tijuana Rules</a></li>
      <li><a href="#state-by-state-mexico-table">5. State-by-State Time Zone Breakdown Table</a></li>
      <li><a href="#mexico-vs-world-table">6. Mexico vs World Time Zones Comparison Table</a></li>
      <li><a href="#business-bmv-stock">7. Business Overlap &amp; Financial Markets (BMV Mexico City)</a></li>
      <li><a href="#developer-guide-mexico">8. Developer Guide: Updating Software for Mexican Time Law</a></li>
      <li><a href="#frequently-asked-questions">9. Frequently Asked Questions (20 FAQs)</a></li>
    </ol>
  </section>

  <!-- SVG DIAGRAM -->
  <section class="content-section" aria-label="Mexico Time Zone Map Diagram">
    <h2>Mexico's 4 Official Time Zones</h2>
    <p>
      The diagram below illustrates the geographic distribution of Mexico's 4 time zones from east (Cancún) to west (Tijuana).
    </p>

    <div class="svg-container" style="width: 100%; overflow-x: auto; text-align: center; margin: 2rem 0;">
      <svg viewBox="0 0 800 300" width="100%" height="auto" xmlns="http://www.w3.org/2000/svg" style="background: var(--panel); border-radius: 8px; padding: 1rem; border: 1px solid var(--line, #333);">
        <text x="400" y="30" fill="currentColor" text-anchor="middle" font-size="18" font-weight="bold">Mexico Time Zones (East to West)</text>
        
        <g transform="translate(50, 70)">
          <!-- Zona Sureste UTC-5 -->
          <rect x="0" y="0" width="140" height="50" fill="#f59e0b" rx="4" />
          <text x="70" y="22" fill="#000" text-anchor="middle" font-size="12" font-weight="bold">Sureste (UTC-5)</text>
          <text x="70" y="38" fill="#000" text-anchor="middle" font-size="11">Cancún (EST No DST)</text>
          
          <!-- Zona Centro UTC-6 -->
          <rect x="150" y="0" width="220" height="50" fill="#10b981" rx="4" />
          <text x="260" y="22" fill="#fff" text-anchor="middle" font-size="13" font-weight="bold">Centro (UTC-6)</text>
          <text x="260" y="38" fill="#fff" text-anchor="middle" font-size="11">Mexico City, GDL, MTY (CST No DST)</text>
          
          <!-- Zona Pacifico UTC-7 -->
          <rect x="380" y="0" width="170" height="50" fill="#3b82f6" rx="4" />
          <text x="465" y="22" fill="#fff" text-anchor="middle" font-size="12" font-weight="bold">Pacífico (UTC-7)</text>
          <text x="465" y="38" fill="#fff" text-anchor="middle" font-size="11">Sonora, Sinaloa, BCS (MST)</text>
          
          <!-- Zona Noroeste UTC-8 -->
          <rect x="560" y="0" width="140" height="50" fill="#8b5cf6" rx="4" />
          <text x="630" y="22" fill="#fff" text-anchor="middle" font-size="12" font-weight="bold">Noroeste (UTC-8)</text>
          <text x="630" y="38" fill="#fff" text-anchor="middle" font-size="11">Tijuana (PST + US DST)</text>
        </g>

        <rect x="50" y="160" width="700" height="90" fill="var(--panel)" stroke="var(--line, #444)" rx="6" />
        <text x="70" y="185" fill="currentColor" font-size="13" font-weight="bold">Key Status:</text>
        <text x="70" y="210" fill="currentColor" font-size="12">• Ley de los Husos Horarios (Oct 2022) abolished DST across Central Mexico</text>
        <text x="70" y="230" fill="currentColor" font-size="12">• Baja California and US Northern Border Strip municipalities retain US DST alignment</text>
      </svg>
    </div>
  </section>

  <!-- SECTION 1 -->
  <section id="overview-mexico-zones" class="content-section">
    <h2>1. Overview of Mexico's Four Time Zones</h2>
    <p>
      The United Mexican States spans over 3,000 kilometers from the Yucatán Peninsula in the east to the Pacific coast of Baja California in the northwest. To account for this geographic width, Mexico regulates four official time zones.
    </p>
    <p>
      For cross-border travelers and business schedulers, evaluating converters like <a href="/gmt-to-est/">GMT to EST</a>, <a href="/gmt-to-cst/">GMT to CST</a>, and <a href="/gmt-to-pst/">GMT to PST</a> ensures accurate planning.
    </p>
  </section>

  <!-- SECTION 2 -->
  <section id="the-2022-dst-law" class="content-section">
    <h2>2. The 2022 Law Reform: Abolition of DST in Central Mexico</h2>
    <p>
      On October 26, 2022, the Senate of Mexico passed the new <em>Ley de los Husos Horarios en los Estados Unidos Mexicanos</em>, officially repealing the 1996 national daylight saving time law.
    </p>
    <p>
      As a result, major economic hubs including Mexico City, Guadalajara, Monterrey, Puebla, and Querétaro remain permanently on Central Standard Time (CST, UTC-6) year-round.
    </p>
    <p>
      Learn more about seasonal clock shifts in our <a href="/daylight-saving-time-explained/">Daylight Saving Time guide</a> and <a href="/usa-time-zones/">USA Time Zones guide</a>.
    </p>
  </section>

  <!-- SECTION 3 -->
  <section id="cancun-southeast-zone" class="content-section">
    <h2>3. Zona Sureste (Cancún &amp; Quintana Roo EST UTC-5)</h2>
    <p>
      In 2015, the state of Quintana Roo established the <em>Zona Sureste</em>, fixing local time to Eastern Standard Time (EST, UTC-5) without DST adjustments.
    </p>
    <p>
      This change allows popular resort destinations—such as Cancún, Cozumel, Playa del Carmen, and Tulum—to maintain identical clock time with Eastern US gateways (like Miami and New York) during the winter, while providing extra evening sunlight for beach activities.
    </p>
  </section>

  <!-- SECTION 4 -->
  <section id="border-strip-exceptions" class="content-section">
    <h2>4. Northern Border Strip (*Franja Fronteriza*) &amp; Tijuana Rules</h2>
    <p>
      To prevent economic disruption along the US-Mexico manufacturing corridor, Mexico's time law contains explicit exemptions for border municipalities:
    </p>
    <ul>
      <li><strong>Baja California (Tijuana, Mexicali):</strong> Follows US Pacific Time (PST/PDT), observing US DST rules.</li>
      <li><strong>Northern Border Municipalities (Chihuahua, Coahuila, Tamaulipas, Nuevo León):</strong> Municipalities within 20 km of the US border (such as Ciudad Juárez, Piedras Negras, and Nuevo Laredo) adjust clocks in synchronization with their US sister cities (like El Paso, Eagle Pass, and Laredo).</li>
    </ul>
  </section>

  <!-- SECTION 5 -->
  <section id="state-by-state-mexico-table" class="content-section">
    <h2>5. State-by-State Time Zone Breakdown Table</h2>
    <table class="data-table" style="width: 100%; border-collapse: collapse; margin: 1.5rem 0;">
      <thead>
        <tr style="background: var(--panel); border-bottom: 2px solid var(--line);">
          <th style="padding: 10px; text-align: left;">Zone Name</th>
          <th style="padding: 10px; text-align: left;">Standard Offset</th>
          <th style="padding: 10px; text-align: left;">States / Regions</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Zona Sureste</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">UTC-5 (EST)</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Quintana Roo (Cancún, Cozumel)</td>
        </tr>
        <tr>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Zona Centro</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">UTC-6 (CST)</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Mexico City, Jalisco, Nuevo León, Puebla, Veracruz, Guanajuato, Yucatán, etc.</td>
        </tr>
        <tr>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Zona Pacífico</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">UTC-7 (MST)</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Sonora, Sinaloa, Nayarit, Baja California Sur, Chihuahua (interior)</td>
        </tr>
        <tr>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Zona Noroeste</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">UTC-8 (PST)</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Baja California (Tijuana, Mexicali) — Observes US DST</td>
        </tr>
      </tbody>
    </table>
  </section>

  <!-- SECTION 6 -->
  <section id="mexico-vs-world-table" class="content-section">
    <h2>6. Mexico vs World Time Zones Comparison Table</h2>
    <p>
      Compare Mexico City (CST, UTC-6) with major financial hubs globally:
    </p>
    <table class="data-table" style="width: 100%; border-collapse: collapse; margin: 1.5rem 0;">
      <thead>
        <tr style="background: var(--panel); border-bottom: 2px solid var(--line);">
          <th style="padding: 10px; text-align: left;">City</th>
          <th style="padding: 10px; text-align: left;">US/UK Winter Difference vs Mexico City</th>
          <th style="padding: 10px; text-align: left;">US/UK Summer Difference vs Mexico City</th>
          <th style="padding: 10px; text-align: left;">Tool / Guide</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">New York (US East)</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">New York is 1 hour ahead</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">New York is 2 hours ahead</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);"><a href="/gmt-to-est/">GMT to EST Converter</a></td>
        </tr>
        <tr>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">London (UK)</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">London is 6 hours ahead</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">London is 7 hours ahead</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);"><a href="/united-kingdom-time-zone/">UK Time Zone Guide</a></td>
        </tr>
        <tr>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Tokyo (Japan)</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Tokyo is 15 hours ahead</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Tokyo is 15 hours ahead</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);"><a href="/japan-time-zone/">Japan Time Zone Guide</a></td>
        </tr>
      </tbody>
    </table>
  </section>

  <!-- SECTION 7 -->
  <section id="business-bmv-stock" class="content-section">
    <h2>7. Business Overlap &amp; Financial Markets (BMV Mexico City)</h2>
    <p>
      The Mexican Stock Exchange (Bolsa Mexicana de Valores - BMV) in Mexico City trades from 08:30 to 15:00 CST year-round, ensuring seamless synchronization with trading desks in New York and Chicago.
    </p>
  </section>

  <!-- SECTION 8 -->
  <section id="developer-guide-mexico" class="content-section">
    <h2>8. Developer Guide: Updating Software for Mexican Time Law</h2>
    <p>
      System administrators must ensure their servers run timezone database version 2022e or newer to correctly parse Mexican dates:
    </p>
    <ul>
      <li>Use <code>America/Mexico_City</code> for central Mexico (fixed UTC-6).</li>
      <li>Use <code>America/Cancun</code> for Quintana Roo (fixed UTC-5).</li>
      <li>Use <code>America/Tijuana</code> for Baja California (observes PST/PDT DST).</li>
    </ul>
  </section>

  <!-- SECTION 9: FAQS -->
  <section id="frequently-asked-questions" class="content-section">
    <h2>9. Frequently Asked Questions</h2>
    <div class="faq-accordion">
      {meta.faqs.map((faq) => (
        <details class="faq-item" style="margin-bottom: 1rem; padding: 1rem; background: var(--panel); border-radius: 6px;">
          <summary style="font-weight: bold; cursor: pointer; font-size: 1.1rem; color: var(--accent);">
            {faq.q}
          </summary>
          <p style="margin-top: 0.8rem; line-height: 1.6;">
            {faq.a}
          </p>
        </details>
      ))}
    </div>
  </section>
</BaseLayout>
