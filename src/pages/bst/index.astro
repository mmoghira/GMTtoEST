---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import RelatedConvertersWidget from "theme/components/RelatedConvertersWidget.astro";
import UsersAlsoVisitWidget from "theme/components/UsersAlsoVisitWidget.astro";
import LearnMoreWidget from "theme/components/LearnMoreWidget.astro";
import CountryCityWidget from "theme/components/CountryCityWidget.astro";
import { siteUrl } from "theme/i18n/config";

const lang = "en";
const dir = "ltr";
const slug = "bst";
const seoTitle = "British Summer Time (BST) – UTC+1 Offset, Rules & Guide";
const pageDescription = "Comprehensive guide to British Summer Time (BST). Learn UTC+1 offset, UK daylight saving transition dates (last Sunday of March to October), BST vs GMT, London time, and conversion tables.";

const pubDate = "2026-07-30T10:00:00+05:00";
const updatedDate = "2026-07-30T10:00:00+05:00";

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "BST, British Summer Time, UTC+1, BST offset, BST time zone, BST vs GMT, London daylight time, UK daylight saving, BST to EST, BST to EDT, BST to PST",
  image: "/assets/bst-timezone-guide.webp",
  imageAlt: "British Summer Time (BST) UTC+1 Offset Guide",
  pubDate,
  updatedDate,
  author: "Jackie Bruce",
  faqs: [
    {
      q: "What does BST stand for?",
      a: "BST stands for British Summer Time. It is the daylight saving time offset (UTC+1) observed in the United Kingdom during the spring, summer, and early autumn months."
    },
    {
      q: "What is the UTC offset for BST?",
      a: "The UTC offset for British Summer Time (BST) is UTC+1. During summer, local time in the UK is exactly 1 hour ahead of Greenwich Mean Time (GMT) and Coordinated Universal Time (UTC)."
    },
    {
      q: "When is BST active in the United Kingdom?",
      a: "BST begins on the last Sunday of March (when clocks 'spring forward' from 1:00 AM GMT to 2:00 AM BST) and ends on the last Sunday of October (when clocks 'fall back' from 2:00 AM BST to 1:00 AM GMT)."
    },
    {
      q: "Which major cities observe British Summer Time?",
      a: "Major UK cities observing BST during summer include London, Edinburgh, Glasgow, Manchester, Birmingham, Belfast, Cardiff, Liverpool, and Leeds."
    },
    {
      q: "What is the difference between BST and GMT?",
      a: "GMT (Greenwich Mean Time) is UTC+0, used in the UK during winter standard time months. BST (British Summer Time) is UTC+1, used in the UK during summer daylight saving months."
    },
    {
      q: "How far ahead of US Eastern Time is BST?",
      a: "During the summer, when London is on BST (UTC+1) and New York is on EDT (UTC-4), BST is 5 hours ahead of Eastern Daylight Time. When it is 5:00 PM BST in London, it is 12:00 PM (noon) EDT in New York."
    },
    {
      q: "Who invented British Summer Time?",
      a: "The concept of British Summer Time was campaigned for by British builder William Willett in 1907. Although Willett died before its passage, the UK government officially enacted BST under the Summer Time Act of 1916 during World War I to conserve coal."
    },
    {
      q: "Does the UK change clocks on the same day as the US?",
      a: "No. The UK transitions to BST on the last Sunday of March and returns to GMT on the last Sunday of October. The US transitions to EDT on the second Sunday of March and returns to EST on the first Sunday of November. This creates a 2- to 3-week window in spring and autumn where the time difference between London and New York narrows to 4 hours."
    },
    {
      q: "How do I convert BST to US Pacific Daylight Time (PDT)?",
      a: "British Summer Time (BST, UTC+1) is 8 hours ahead of Pacific Daylight Time (PDT, UTC-7). To convert BST to PDT, subtract 8 hours (e.g., 5:00 PM BST equals 9:00 AM PDT)."
    },
    {
      q: "How do I convert BST to Central European Summer Time (CEST)?",
      a: "Central European Summer Time (CEST, UTC+2) is 1 hour ahead of British Summer Time (BST, UTC+1). When it is 12:00 PM (noon) BST in London, it is 1:00 PM CEST in Paris and Berlin."
    },
    {
      q: "Does Ireland use BST?",
      a: "The Republic of Ireland observes Irish Standard Time (IST, UTC+1) during the summer, which matches the exact same clock time as British Summer Time (BST)."
    },
    {
      q: "What is the time difference between BST and India Standard Time (IST)?",
      a: "India Standard Time (IST, UTC+5:30) is 4 hours and 30 minutes ahead of British Summer Time (BST, UTC+1). When it is 12:00 PM BST in London, it is 4:30 PM IST in New Delhi and Mumbai."
    },
    {
      q: "Does Gibraltar observe BST?",
      a: "Gibraltar follows Central European Time (CET/CEST), which is UTC+1 in winter and UTC+2 in summer. Therefore, Gibraltar is 1 hour ahead of London during BST."
    },
    {
      q: "What are the trading hours of the London Stock Exchange during BST?",
      a: "The London Stock Exchange (LSE) operates from 08:00 to 16:30 local time. During BST, trading runs from 08:00 BST (07:00 UTC) to 16:30 BST (15:30 UTC)."
    },
    {
      q: "What is the time difference between BST and Australian Eastern Standard Time (AEST)?",
      a: "Australian Eastern Standard Time (AEST, UTC+10) is 9 hours ahead of British Summer Time (BST, UTC+1). When it is 9:00 AM BST in London, it is 6:00 PM AEST in Sydney and Melbourne."
    },
    {
      q: "Was British Summer Time ever made permanent?",
      a: "Between 1968 and 1971, the UK executed an experimental trial called British Standard Time, remaining on UTC+1 year-round. Although it reduced evening road accidents, the experiment was abandoned due to complaints from northern Scotland about dark morning commutes."
    },
    {
      q: "What is the best meeting time between London (BST) and New York (EDT)?",
      a: "With a 5-hour time difference during summer, the optimal overlapping business call window is 2:00 PM – 5:00 PM BST (9:00 AM – 12:00 PM EDT)."
    },
    {
      q: "What happens to Big Ben during the BST clock shift?",
      a: "The Great Clock of Westminster (Big Ben) is manually adjusted by a team of specialist horologists during the night of the transition to ensure precise timekeeping across the UK."
    },
    {
      q: "Is BST the same as Western European Summer Time (WEST)?",
      a: "Yes. Western European Summer Time (WEST, UTC+1) used in Portugal and the Faroe Islands operates on the exact same UTC+1 offset as British Summer Time."
    },
    {
      q: "How do server logs handle the transition back to GMT in October?",
      a: "Systems recording logs in local UK time encounter duplicate timestamps between 1:00 AM and 2:00 AM on the last Sunday of October. Infrastructure engineers avoid this by standardizing server clocks to UTC."
    }
  ]
};

const pageUrlPath = `${siteUrl}/${slug}/`;
---

<BaseLayout
  lang={lang}
  dir={dir}
  title={seoTitle}
  description={pageDescription}
  slug={slug}
  meta={meta}
  enableFaqSchema={true}
  enableArticleSchema={true}
  breadcrumbHomeLabel="Home"
  breadcrumbLabel="BST"
>
  <!-- Hero Section -->
  <section class="hero-banner" aria-labelledby="hero-title">
    <h1 id="hero-title" class="hero-banner-title speakable-headline">
      British Summer Time (BST): <span class="gradient-text">UTC+1 Offset & UK DST Guide</span>
    </h1>
  </section>

  <!-- Editorial Info Bar -->
  <div class="editorial-meta-bar" aria-label="Editorial metadata">
    <span>Last Updated: <strong>July 30, 2026</strong></span>
    <span class="separator" aria-hidden="true">•</span>
    <span>Editorially Reviewed by <a href="/author/jackie-bruce/"><strong>Jackie Bruce</strong></a></span>
    <span class="separator" aria-hidden="true">•</span>
    <span>Data Source: <a href="https://www.iana.org/time-zones" target="_blank" rel="noopener noreferrer"><strong>IANA Time Zone Database</strong></a></span>
  </div>

  <div class="article-wrapper">
    <!-- Top Answer Summary Box -->
    <div class="summary-box speakable-summary">
      <div class="summary-header">
        <span class="summary-badge">DAYLIGHT TIME PROFILE</span>
        <h2>British Summer Time (BST) Summary</h2>
      </div>
      <div class="summary-grid">
        <div class="summary-item">
          <span class="label">UTC Offset:</span>
          <span class="val highlight">UTC+1 (1 hour ahead of GMT)</span>
        </div>
        <div class="summary-item">
          <span class="label">Active Window:</span>
          <span class="val">Last Sunday March to Last Sunday October</span>
        </div>
        <div class="summary-item">
          <span class="label">Standard Counterpart:</span>
          <span class="val"><a href="/gmt/">GMT (Greenwich Mean Time, UTC+0)</a></span>
        </div>
        <div class="summary-item">
          <span class="label">Major Cities:</span>
          <span class="val"><a href="/london-time/">London</a>, Edinburgh, Manchester, Belfast, Cardiff</span>
        </div>
        <div class="summary-item">
          <span class="label">Transatlantic Diff:</span>
          <span class="val">5 hours ahead of <a href="/edt/">EDT (New York)</a></span>
        </div>
        <div class="summary-item">
          <span class="label">Spring Shift:</span>
          <span class="val">Clocks spring forward 1 hour (1:00 AM → 2:00 AM)</span>
        </div>
      </div>
      <p class="summary-text">
        <strong>British Summer Time (BST)</strong> is the daylight saving time offset observed throughout the United Kingdom from late March to late October. Operating at <strong>UTC+1</strong>, BST advances local clocks one hour ahead of <a href="/gmt/">Greenwich Mean Time (GMT UTC+0)</a>. It governs business, financial markets on the London Stock Exchange, and broadcast media across England, Scotland, Wales, and Northern Ireland during the summer.
      </p>
    </div>

    <!-- Table of Contents -->
    <nav class="about-toc" aria-label="Table of Contents">
      <h2>Table of Contents</h2>
      <ul>
        <li><a href="#what-is-bst">1. What is British Summer Time (BST)?</a></li>
        <li><a href="#bst-vs-gmt">2. BST vs. GMT: Offset & History</a></li>
        <li><a href="#transition-calendar">3. UK Transition Calendar & Clock Shift Mechanics</a></li>
        <li><a href="#transatlantic-gap">4. The 2-Week Transatlantic Shift Discrepancy</a></li>
        <li><a href="#conversion-tables">5. Global BST Time Conversion Tables</a></li>
        <li><a href="#financial-markets">6. London Stock Exchange & Global Commerce</a></li>
        <li><a href="#faqs">7. Frequently Asked Questions (20 Detailed Answers)</a></li>
      </ul>
    </nav>

    <!-- Content Sections -->
    <section id="what-is-bst" class="content-section">
      <h2>1. What is British Summer Time (BST)?</h2>
      <p>
        <strong>British Summer Time (BST)</strong> is the legal summer daylight saving phase of the United Kingdom. Operating at <strong>UTC+1</strong> (1 hour ahead of <a href="/utc/">Coordinated Universal Time</a> and <a href="/gmt/">Greenwich Mean Time</a>), BST extends evening daylight hours across Great Britain and Northern Ireland.
      </p>
      <p>
        Enacted under the Summer Time Act of 1916 following a nationwide campaign by William Willett, BST was introduced during World War I to conserve coal energy used for artificial lighting.
      </p>
    </section>

    <!-- SVG Diagram 1: UK Annual GMT/BST Shift -->
    <section class="diagram-section">
      <div class="diagram-card">
        <h3>Figure 1: United Kingdom Seasonal Cycle (GMT ⇄ BST)</h3>
        <div class="svg-wrapper">
          <svg viewBox="0 0 800 240" width="100%" height="auto" xmlns="http://www.w3.org/2000/svg" aria-label="UK Seasonal GMT to BST Transition">
            <rect width="800" height="240" fill="var(--panel)" rx="12" stroke="var(--line)" stroke-width="1"/>
            
            <rect x="50" y="50" width="310" height="130" rx="8" fill="rgba(255,255,255,0.03)" stroke="var(--line)" stroke-width="1.5"/>
            <text x="205" y="85" text-anchor="middle" fill="var(--text)" font-family="Space Grotesk, sans-serif" font-weight="bold" font-size="16">WINTER (Oct Last Sun – Mar Last Sun)</text>
            <text x="205" y="120" text-anchor="middle" fill="var(--accent)" font-weight="bold" font-size="22">GMT (UTC+0)</text>
            <text x="205" y="150" text-anchor="middle" fill="var(--muted)" font-size="12">Standard Greenwich Time</text>

            <path d="M 375 90 Q 400 70 425 90" fill="none" stroke="var(--accent)" stroke-width="2.5" marker-end="url(#arrow)"/>
            <text x="400" y="60" text-anchor="middle" fill="var(--accent)" font-size="11" font-weight="bold">Spring (+1h) March</text>

            <path d="M 425 140 Q 400 160 375 140" fill="none" stroke="var(--muted)" stroke-width="2.5"/>
            <text x="400" y="180" text-anchor="middle" fill="var(--muted)" font-size="11">Fall (-1h) October</text>

            <rect x="440" y="50" width="310" height="130" rx="8" fill="rgba(255,255,255,0.03)" stroke="var(--accent)" stroke-width="1.5"/>
            <text x="595" y="85" text-anchor="middle" fill="var(--text)" font-family="Space Grotesk, sans-serif" font-weight="bold" font-size="16">SUMMER (Mar Last Sun – Oct Last Sun)</text>
            <text x="595" y="120" text-anchor="middle" fill="var(--accent)" font-weight="bold" font-size="22">BST (UTC+1)</text>
            <text x="595" y="150" text-anchor="middle" fill="var(--muted)" font-size="12">British Summer Time</text>
          </svg>
        </div>
        <p class="diagram-caption">
          Figure 1: Illustration showing the UK's annual clock shift moving from winter GMT (UTC+0) to summer BST (UTC+1).
        </p>
      </div>
    </section>

    <section id="bst-vs-gmt" class="content-section">
      <h2>2. BST vs. GMT: Offset & History</h2>
      <p>
        The key distinctions between GMT and BST include:
      </p>
      <ul>
        <li><strong>GMT (Greenwich Mean Time, UTC+0):</strong> The historical zero-meridian baseline used in the UK during winter (late October to late March). See <a href="/gmt/">GMT Guide</a>.</li>
        <li><strong>BST (British Summer Time, UTC+1):</strong> The daylight saving offset used in the UK during summer (late March to late October).</li>
      </ul>
      <p>
        For a broad overview of UK timezone regulations, read our guide on <a href="/united-kingdom-time-zone/">United Kingdom Time Zone</a>.
      </p>
    </section>

    <section id="transition-calendar" class="content-section">
      <h2>3. UK Transition Calendar & Clock Shift Mechanics</h2>
      <p>
        In contrast to North America, the UK and Europe adjust clocks on the final Sundays of March and October:
      </p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Transition Event</th>
              <th>Date & Clock Rule</th>
              <th>Clock Adjustment</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Spring Shift (GMT → BST)</strong></td>
              <td>Last Sunday of March at 1:00 AM GMT</td>
              <td>Clocks jump from 1:00 AM GMT to 2:00 AM BST (+1 hour)</td>
            </tr>
            <tr>
              <td><strong>Autumn Shift (BST → GMT)</strong></td>
              <td>Last Sunday of October at 2:00 AM BST</td>
              <td>Clocks fall back from 2:00 AM BST to 1:00 AM GMT (-1 hour)</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section id="transatlantic-gap" class="content-section">
      <h2>4. The 2-Week Transatlantic Shift Discrepancy</h2>
      <p>
        Because the United States advances clocks on the second Sunday of March while the UK shifts on the last Sunday of March, a 2- to 3-week transitional discrepancy occurs in spring and autumn:
      </p>
      <ul>
        <li><strong>Standard Summer Difference:</strong> London (BST UTC+1) is 5 hours ahead of New York (<a href="/edt/">EDT UTC-4</a>).</li>
        <li><strong>Transitional Window Difference:</strong> For two weeks in March and one week in October, the difference narrows to 4 hours.</li>
      </ul>
      <p>
        Financial trading desks and scheduling assistants must account for this temporary 4-hour offset. For strategies, see <a href="/best-time-us-europe-meetings/">Best Time for US–Europe Meetings</a>.
      </p>
    </section>

    <section id="conversion-tables" class="content-section">
      <h2>5. Global BST Time Conversion Tables</h2>
      <p>
        Convert British Summer Time (BST, UTC+1) to major world time zones during summer:
      </p>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>BST (UTC+1)</th>
              <th>EDT (UTC-4)<br/><a href="/bst-to-est/">BST to EDT</a></th>
              <th>PDT (UTC-7)<br/><a href="/gmt-to-pdt/">BST to PDT</a></th>
              <th>CEST (UTC+2)<br/><a href="/cet-to-est/">BST to CEST</a></th>
              <th>IST (UTC+5:30)<br/><a href="/ist-to-est/">BST to IST</a></th>
              <th>AEST (UTC+10)<br/><a href="/aest-to-est/">BST to AEST</a></th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>00:00 BST (Midnight)</td>
              <td>19:00 EDT (Prev Day)</td>
              <td>16:00 PDT (Prev Day)</td>
              <td>01:00 CEST</td>
              <td>04:30 IST</td>
              <td>09:00 AEST</td>
            </tr>
            <tr>
              <td>06:00 BST</td>
              <td>01:00 EDT</td>
              <td>22:00 PDT (Prev Day)</td>
              <td>07:00 CEST</td>
              <td>10:30 IST</td>
              <td>15:00 AEST</td>
            </tr>
            <tr>
              <td>09:00 BST</td>
              <td>04:00 EDT</td>
              <td>01:00 PDT</td>
              <td>10:00 CEST</td>
              <td>13:30 IST</td>
              <td>18:00 AEST</td>
            </tr>
            <tr>
              <td>12:00 BST (Noon)</td>
              <td>07:00 EDT</td>
              <td>04:00 PDT</td>
              <td>13:00 CEST</td>
              <td>16:30 IST</td>
              <td>21:00 AEST</td>
            </tr>
            <tr>
              <td>15:00 BST</td>
              <td>10:00 EDT</td>
              <td>07:00 PDT</td>
              <td>16:00 CEST</td>
              <td>19:30 IST</td>
              <td>00:00 AEST (Next Day)</td>
            </tr>
            <tr>
              <td>18:00 BST</td>
              <td>13:00 EDT</td>
              <td>10:00 PDT</td>
              <td>19:00 CEST</td>
              <td>22:30 IST</td>
              <td>03:00 AEST (Next Day)</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p>
        For live, interactive conversion calculation, use our <a href="/bst-to-est/">BST to EST Converter</a>.
      </p>
    </section>

    <!-- SVG Diagram 2: Summer Transatlantic Offsets -->
    <section class="diagram-section">
      <div class="diagram-card">
        <h3>Figure 2: Transatlantic Summer Timezone Spread</h3>
        <div class="svg-wrapper">
          <svg viewBox="0 0 800 220" width="100%" height="auto" xmlns="http://www.w3.org/2000/svg" aria-label="Transatlantic Summer Offsets">
            <rect width="800" height="220" fill="var(--panel)" rx="12" stroke="var(--line)" stroke-width="1"/>
            
            <circle cx="160" cy="110" r="30" fill="var(--panel)" stroke="var(--line)" stroke-width="2"/>
            <text x="160" y="114" text-anchor="middle" fill="var(--text)" font-weight="bold" font-size="13">EDT</text>
            <text x="160" y="160" text-anchor="middle" fill="var(--muted)" font-size="11">UTC-4 (New York)</text>

            <circle cx="380" cy="110" r="38" fill="var(--accent)" stroke="#ffffff" stroke-width="2.5"/>
            <text x="380" y="115" text-anchor="middle" fill="#ffffff" font-family="Space Grotesk, sans-serif" font-weight="bold" font-size="16">BST</text>
            <text x="380" y="165" text-anchor="middle" fill="var(--accent)" font-weight="bold" font-size="12">UTC+1 (London)</text>

            <circle cx="560" cy="110" r="30" fill="var(--panel)" stroke="var(--line)" stroke-width="2"/>
            <text x="560" y="114" text-anchor="middle" fill="var(--text)" font-weight="bold" font-size="13">CEST</text>
            <text x="560" y="160" text-anchor="middle" fill="var(--muted)" font-size="11">UTC+2 (Paris/Berlin)</text>

            <line x1="190" y1="110" x2="342" y2="110" stroke="var(--line)" stroke-width="2"/>
            <line x1="418" y1="110" x2="530" y2="110" stroke="var(--line)" stroke-width="2"/>
          </svg>
        </div>
        <p class="diagram-caption">
          Figure 2: Relative time spread showing BST (UTC+1) centered between New York (EDT UTC-4) and Continental Europe (CEST UTC+2).
        </p>
      </div>
    </section>

    <section id="financial-markets" class="content-section">
      <h2>6. London Stock Exchange & Global Commerce</h2>
      <p>
        The London Stock Exchange (LSE) opens at 08:00 BST and closes at 16:30 BST. London serves as the central hub for foreign exchange (Forex) liquidity, bridging Asian market closes and Wall Street opening bells.
      </p>
    </section>

    <!-- Contextual Widgets Integration -->
    <RelatedConvertersWidget slug={slug} />
    <UsersAlsoVisitWidget slug={slug} />
    <LearnMoreWidget slug={slug} />
    <CountryCityWidget slug={slug} />

    <!-- FAQ Section -->
    <section id="faqs" class="content-section faqs-section">
      <h2>7. Frequently Asked Questions (BST)</h2>
      <div class="faq-list">
        {meta.faqs.map((faq, index) => (
          <details class="faq-item" open={index === 0}>
            <summary class="faq-question">
              <h3>{faq.q}</h3>
            </summary>
            <div class="faq-answer">
              <p>{faq.a}</p>
            </div>
          </details>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .article-wrapper {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 1rem 3rem;
  }
  .hero-banner {
    text-align: center;
    padding: 3rem 1rem 1.5rem;
  }
  .hero-banner-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--text);
  }
  .gradient-text {
    background: linear-gradient(135deg, var(--accent) 0%, #38bdf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .editorial-meta-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--muted);
    margin-bottom: 2rem;
    padding: 0.75rem 1rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
  }
  .editorial-meta-bar a {
    color: var(--accent);
    text-decoration: none;
  }
  .separator {
    opacity: 0.5;
  }
  .summary-box {
    background: var(--panel);
    border: 1px solid var(--accent);
    border-radius: 12px;
    padding: 1.75rem;
    margin-bottom: 2.5rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.15);
  }
  .summary-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }
  .summary-badge {
    background: var(--accent);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    letter-spacing: 0.05em;
  }
  .summary-header h2 {
    font-size: 1.35rem;
    margin: 0;
    color: var(--text);
  }
  .summary-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
    margin-bottom: 1.25rem;
  }
  .summary-item {
    background: rgba(255,255,255,0.03);
    padding: 0.75rem 1rem;
    border-radius: 6px;
    border: 1px solid var(--line);
  }
  .summary-item .label {
    display: block;
    font-size: 0.8rem;
    color: var(--muted);
    margin-bottom: 0.25rem;
  }
  .summary-item .val {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text);
  }
  .summary-item .highlight {
    color: var(--accent);
  }
  .summary-text {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text);
    margin: 0;
  }
