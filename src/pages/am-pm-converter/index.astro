---
import BaseLayout from "theme/layouts/BaseLayout.astro";

const lang = "en";
const dir = "ltr";
const slug = "am-pm-converter";
const seoTitle = "AM PM Converter | Convert 24-Hour Time to 12-Hour Time";
const pageDescription = "Convert 24-hour time to AM and PM instantly, and back again. See what 15:30, 00:00 and 12:00 mean in 12-hour time.";

const pubDate = "2026-10-25T15:00:00+05:00";
const updatedDate = "2026-10-25T15:30:00+05:00";

const meta = {
  seoTitle,
  exactTitle: true,
  description: pageDescription,
  keywords: "am pm converter, 24-hour to 12-hour, 12-hour to 24-hour, convert 15:30 to 12-hour time, military time to standard time, what is 00:00 in am pm",
  pubDate,
  updatedDate,
  author: "Time Intelligence Team",
  faqs: [
    {
      q: "What is 15:30 in 12-hour time?",
      a: "3:30 PM."
    },
    {
      q: "What is 00:00 in AM and PM?",
      a: "12:00 AM, midnight at the start of the day."
    },
    {
      q: "Is 12:00 AM noon or midnight?",
      a: "12:00 AM is midnight. 12:00 PM is noon."
    },
    {
      q: "How do I convert PM time back to 24-hour time?",
      a: "Add 12 to PM hours from 1:00 PM to 11:00 PM. 12:00 PM stays 12:00, and 12:00 AM becomes 00:00."
    }
  ]
};

// Verified Worked Examples
const VERIFIED_EXAMPLES = [
  { t24: "00:00", t12: "12:00 AM", note: "Midnight (start of day)" },
  { t24: "00:30", t12: "12:30 AM", note: "Half past midnight" },
  { t24: "06:00", t12: "6:00 AM", note: "Morning" },
  { t24: "12:00", t12: "12:00 PM", note: "Noon (midday)" },
  { t24: "12:30", t12: "12:30 PM", note: "Half past noon" },
  { t24: "13:00", t12: "1:00 PM", note: "Early afternoon" },
  { t24: "15:30", t12: "3:30 PM", note: "Mid-afternoon" },
  { t24: "18:00", t12: "6:00 PM", note: "Early evening" },
  { t24: "23:59", t12: "11:59 PM", note: "End of day" }
];
---

<BaseLayout
  lang={lang}
  dir={dir}
  title={seoTitle}
  description={pageDescription}
  slug={slug}
  meta={meta}
  enableFaqSchema={true}
  allowAds={true}
>
  <!-- Schema: WebApplication Structured Data -->
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "AM PM Converter",
    "url": "https://gmttoestconverter.com/am-pm-converter/",
    "applicationCategory": "UtilitiesApplication",
    "operatingSystem": "All",
    "description": pageDescription,
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    }
  })}></script>

  <!-- Schema: BreadcrumbList Structured Data -->
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://gmttoestconverter.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "AM PM Converter",
        "item": "https://gmttoestconverter.com/am-pm-converter/"
      }
    ]
  })}></script>

  <!-- Hero Header -->
  <div class="hero-banner">
    <h1 class="hero-banner-title">AM PM Converter</h1>
    <p style="color: #bdd2dc; font-size: clamp(1rem, 2.2vw, 1.25rem); max-width: 680px; margin: 12px auto 0;">
      Convert 24-hour time to 12-hour AM/PM format instantly, or convert 12-hour standard time back to 24-hour notation.
    </p>
  </div>

  <div style="max-width: 820px; margin: 0 auto; padding-top: 24px;">

    <!-- Interactive Two-Way AM/PM Converter (Strictly Above The Fold) -->
    <section id="ampm-converter-card" style="background: var(--panel); border: 2px solid var(--line); border-radius: 16px; padding: clamp(20px, 4vw, 36px); box-shadow: var(--shadow); position: relative;">
      
      <!-- Mode Switcher Buttons -->
      <div style="display: flex; gap: 8px; border-bottom: 1px solid var(--line); padding-bottom: 16px; margin-bottom: 24px;">
        <button
          type="button"
          id="mode-tab-24to12"
          role="tab"
          aria-selected="true"
          aria-controls="panel-24to12"
          style="flex: 1; padding: 12px 16px; border-radius: 8px; border: none; background: var(--accent); color: #0c354a; font-weight: 800; font-size: 0.95rem; cursor: pointer; transition: background 0.2s;"
        >
          24-Hour → 12-Hour (AM/PM)
        </button>
        <button
          type="button"
          id="mode-tab-12to24"
          role="tab"
          aria-selected="false"
          aria-controls="panel-12to24"
          style="flex: 1; padding: 12px 16px; border-radius: 8px; border: 1px solid var(--line); background: var(--bg); color: var(--text); font-weight: 800; font-size: 0.95rem; cursor: pointer; transition: background 0.2s;"
        >
          12-Hour (AM/PM) → 24-Hour
        </button>
      </div>

      <!-- Mode A: 24-Hour to 12-Hour Panel -->
      <div id="panel-24to12" role="tabpanel" aria-labelledby="mode-tab-24to12">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; align-items: start;">
          
          <!-- Input Side -->
          <div>
            <label for="input-24" style="display: block; font-size: 0.85rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; color: var(--accent); margin-bottom: 6px;">
              Enter 24-Hour Time (HH:mm)
            </label>
            <input
              type="text"
              id="input-24"
              value="15:30"
              placeholder="e.g. 15:30, 00:00"
              aria-describedby="val-msg-24"
              style="width: 100%; padding: 12px 16px; background: var(--bg); border: 2px solid var(--line); border-radius: 8px; color: #ffffff; font-family: 'Space Grotesk', monospace; font-size: 1.5rem; font-weight: 800; box-sizing: border-box;"
            />
            <div id="val-msg-24" role="alert" style="display: none; color: #f87171; font-size: 0.85rem; font-weight: 700; margin-top: 8px;">
              Enter a valid time.
            </div>
            <p style="font-size: 0.82rem; color: var(--muted); margin: 6px 0 0;">
              Valid range: 00:00 through 23:59.
            </p>
          </div>

          <!-- Result Side -->
          <div style="background: var(--bg); border: 1px solid var(--line); border-radius: 12px; padding: 20px; text-align: center;">
            <span style="display: block; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); font-weight: 700; margin-bottom: 6px;">
              12-Hour Result
            </span>
            <div id="result-12" style="font-family: 'Space Grotesk', monospace; font-size: clamp(2.2rem, 6vw, 3rem); font-weight: 900; color: var(--accent); line-height: 1.1; font-variant-numeric: tabular-nums;">
              3:30 PM
            </div>
            <span id="result-desc-12" style="display: block; font-size: 0.85rem; color: var(--accent-2); font-weight: 600; margin-top: 8px;">
              3:30 in the afternoon
            </span>
          </div>

        </div>
      </div>

      <!-- Mode B: 12-Hour to 24-Hour Panel (Hidden by default) -->
      <div id="panel-12to24" role="tabpanel" aria-labelledby="mode-tab-12to24" style="display: none;">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; align-items: start;">
          
          <!-- Input Side -->
          <div>
            <label for="input-12-time" style="display: block; font-size: 0.85rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; color: var(--accent-2); margin-bottom: 6px;">
              Enter 12-Hour Time &amp; Meridiem
            </label>
            <div style="display: flex; gap: 8px;">
              <input
                type="text"
                id="input-12-time"
                value="3:30"
                placeholder="e.g. 3:30, 12:00"
                aria-describedby="val-msg-12"
                style="flex: 2; padding: 12px 16px; background: var(--bg); border: 2px solid var(--line); border-radius: 8px; color: #ffffff; font-family: 'Space Grotesk', monospace; font-size: 1.5rem; font-weight: 800; box-sizing: border-box;"
              />
              <select
                id="select-meridiem"
                aria-label="Select AM or PM"
                style="flex: 1; padding: 12px 14px; background: var(--bg); border: 2px solid var(--line); border-radius: 8px; color: var(--accent); font-family: 'Space Grotesk', sans-serif; font-size: 1.25rem; font-weight: 800; cursor: pointer;"
              >
                <option value="AM">AM</option>
                <option value="PM" selected>PM</option>
              </select>
            </div>
            <div id="val-msg-12" role="alert" style="display: none; color: #f87171; font-size: 0.85rem; font-weight: 700; margin-top: 8px;">
              Enter a valid time.
            </div>
            <p style="font-size: 0.82rem; color: var(--muted); margin: 6px 0 0;">
              Valid range: 1:00 AM through 12:59 PM.
            </p>
          </div>

          <!-- Result Side -->
          <div style="background: var(--bg); border: 1px solid var(--line); border-radius: 12px; padding: 20px; text-align: center;">
            <span style="display: block; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); font-weight: 700; margin-bottom: 6px;">
              24-Hour Result
            </span>
            <div id="result-24" style="font-family: 'Space Grotesk', monospace; font-size: clamp(2.2rem, 6vw, 3rem); font-weight: 900; color: #ffffff; line-height: 1.1; font-variant-numeric: tabular-nums;">
              15:30
            </div>
            <span id="result-desc-24" style="display: block; font-size: 0.85rem; color: var(--accent); font-weight: 600; margin-top: 8px;">
              Standard 24-hour notation
            </span>
          </div>

        </div>
      </div>

      <!-- Quick Interactive Worked Example Pills -->
      <div style="margin-top: 24px; padding-top: 18px; border-top: 1px solid var(--line);">
        <span style="display: block; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); font-weight: 700; margin-bottom: 10px;">
          Try Common Times (Click to Convert):
        </span>
        <div style="display: flex; flex-wrap: wrap; gap: 8px;">
          {VERIFIED_EXAMPLES.map(ex => (
            <button
              type="button"
              class="example-pill-btn"
              data-t24={ex.t24}
              data-t12={ex.t12}
              style="padding: 6px 12px; background: var(--bg); border: 1px solid var(--line); border-radius: 6px; color: var(--text); font-family: 'Space Grotesk', monospace; font-size: 0.85rem; font-weight: 700; cursor: pointer; transition: border-color 0.15s, background 0.15s;"
            >
              {ex.t24} ↔ {ex.t12}
            </button>
          ))}
        </div>
      </div>

    </section>

    <!-- Hero Editorial Image (Below the tool to protect immediate converter access) -->
    <div class="infographic-wrapper" style="margin-top: 36px;">
      <figure style="margin: 0; text-align: center;">
        <img
          src="/assets/am-pm-converter-hero.webp"
          alt="Clock face and digital display converting 15:30 to 3:30 PM"
          class="infographic-image"
          width="960"
          height="540"
          loading="lazy"
        />
        <figcaption class="infographic-caption">Visual conversion comparing a 24-hour digital clock to a 12-hour analog and digital dial.</figcaption>
      </figure>
    </div>

    <!-- Content Sections in Exact Required Order -->
    <div style="padding-top: 24px;">

      <!-- H2: How to convert 24-hour time to AM and PM -->
      <section>
        <h2 style="font-size: clamp(1.5rem, 3.5vw, 2rem); border-bottom: 1px solid var(--line); padding-bottom: 12px; margin-bottom: 16px;">How to convert 24-hour time to AM and PM</h2>
        <p style="color: var(--muted); line-height: 1.7; max-width: 72ch;">
          The 24-hour time system (frequently called military time in North America) runs consecutively from <code>00:00</code> at midnight through <code>23:59</code> at the final minute of the day. In contrast, the 12-hour civilian system divides the day into two 12-hour blocks: <em>ante meridiem</em> (AM, before noon) and <em>post meridiem</em> (PM, after noon).
        </p>
        <p style="color: var(--muted); line-height: 1.7; max-width: 72ch; margin-top: 12px;">
          To convert 24-hour time to 12-hour AM and PM notation, follow these simple mathematical rules:
        </p>
        <ul style="color: var(--muted); line-height: 1.7; padding-left: 20px; margin: 14px 0;">
          <li><strong>Midnight (Hour 00):</strong> Change <code>00</code> to <code>12</code> and attach <strong>AM</strong> (e.g., <code>00:00</code> → <code>12:00 AM</code>, <code>00:30</code> → <code>12:30 AM</code>).</li>
          <li><strong>Morning (Hours 01 through 11):</strong> Retain the hour number exactly as written and append <strong>AM</strong> (e.g., <code>07:15</code> → <code>7:15 AM</code>, <code>11:59</code> → <code>11:59 AM</code>).</li>
          <li><strong>Noon (Hour 12):</strong> Keep the hour <code>12</code> and attach <strong>PM</strong> (e.g., <code>12:00</code> → <code>12:00 PM</code>, <code>12:45</code> → <code>12:45 PM</code>).</li>
          <li><strong>Afternoon &amp; Evening (Hours 13 through 23):</strong> Subtract <strong>12</strong> from the hour and append <strong>PM</strong> (e.g., <code>15:30</code> → <code>3:30 PM</code>, <code>18:20</code> → <code>6:20 PM</code>, <code>21:05</code> → <code>9:05 PM</code>).</li>
          <li><strong>Minutes:</strong> The minute value never changes in either conversion direction.</li>
        </ul>
        <p style="color: var(--muted); line-height: 1.7; max-width: 72ch;">
          To convert in the opposite direction from 12-hour back to 24-hour time:
        </p>
        <ul style="color: var(--muted); line-height: 1.7; padding-left: 20px; margin: 14px 0;">
          <li><strong>12:xx AM</strong> becomes <code>00:xx</code> (e.g., <code>12:00 AM</code> → <code>00:00</code>).</li>
          <li><strong>1:xx AM through 11:xx AM</strong> keeps the hour with a leading zero if under 10 (e.g., <code>6:00 AM</code> → <code>06:00</code>).</li>
          <li><strong>12:xx PM</strong> remains <code>12:xx</code> (e.g., <code>12:30 PM</code> → <code>12:30</code>).</li>
          <li><strong>1:xx PM through 11:xx PM</strong> adds 12 to the hour (e.g., <code>3:30 PM</code> → <code>15:30</code>, <code>11:59 PM</code> → <code>23:59</code>).</li>
        </ul>
      </section>

      <!-- H2: The two times people get wrong -->
      <section style="margin-top: 36px;">
        <h2 style="font-size: clamp(1.5rem, 3.5vw, 2rem); border-bottom: 1px solid var(--line); padding-bottom: 12px; margin-bottom: 16px;">The two times people get wrong</h2>
        <p style="color: var(--muted); line-height: 1.7; max-width: 72ch;">
          The single most frequent point of confusion when navigating between 12-hour and 24-hour systems occurs at <strong>midnight</strong> and <strong>noon</strong>:
        </p>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; margin: 20px 0;">
          
          <!-- Midnight Box -->
          <div style="background: var(--panel); border: 2px solid #3b82f6; border-radius: 10px; padding: 20px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
              <h3 style="font-size: 1.2rem; color: #93c5fd; margin: 0;">Midnight</h3>
              <span style="background: rgba(59, 130, 246, 0.2); color: #93c5fd; padding: 2px 8px; border-radius: 4px; font-weight: 800; font-size: 0.8rem;">START OF DAY</span>
            </div>
            <p style="color: var(--text); font-family: 'Space Grotesk', monospace; font-size: 1.3rem; font-weight: 800; margin: 6px 0;">
              00:00 = 12:00 AM
            </p>
            <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 8px 0 0;">
              Midnight marks the precise inception of a new calendar date. In 24-hour notation, hours begin at zero (<code>00:00</code>). In 12-hour notation, it is <strong>12:00 AM</strong>, and <code>00:30</code> is <strong>12:30 AM</strong>. Remember: <strong>12:00 AM is midnight, never noon</strong>.
            </p>
          </div>

          <!-- Noon Box -->
          <div style="background: var(--panel); border: 2px solid #fbbf24; border-radius: 10px; padding: 20px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
              <h3 style="font-size: 1.2rem; color: #fde68a; margin: 0;">Noon</h3>
              <span style="background: rgba(245, 158, 11, 0.2); color: #fde68a; padding: 2px 8px; border-radius: 4px; font-weight: 800; font-size: 0.8rem;">MIDDAY</span>
            </div>
            <p style="color: var(--text); font-family: 'Space Grotesk', monospace; font-size: 1.3rem; font-weight: 800; margin: 6px 0;">
              12:00 = 12:00 PM
            </p>
            <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 8px 0 0;">
              Noon is the midpoint of the day when the sun reaches its zenith. In 24-hour notation, it is <code>12:00</code>. In 12-hour notation, it is <strong>12:00 PM</strong>, and <code>12:30</code> is <strong>12:30 PM</strong>. Remember: <strong>12:00 PM is noon, never midnight</strong>.
            </p>
          </div>

        </div>
        <p style="color: var(--muted); line-height: 1.7; max-width: 72ch;">
          A common mistake when converting PM times is blindly adding 12 to every PM hour. While <code>1:00 PM</code> becomes <code>13:00</code>, <code>12:00 PM</code> is already hour 12—adding 12 would result in an invalid hour 24.
        </p>
      </section>

      <!-- Explanatory Diagram 2: Table Graphic -->
      <div class="infographic-wrapper" style="margin-top: 36px;">
        <figure style="margin: 0; text-align: center;">
          <img
            src="/assets/am-pm-conversion-table.webp"
            alt="Table converting 24-hour times to AM and PM times"
            class="infographic-image"
            width="800"
            height="450"
            loading="lazy"
          />
          <figcaption class="infographic-caption">00:00 is 12:00 AM, 12:00 is 12:00 PM, and 15:30 is 3:30 PM.</figcaption>
        </figure>
      </div>

      <!-- H2: 24-hour to 12-hour conversion table -->
      <section style="margin-top: 36px;">
        <h2 style="font-size: clamp(1.5rem, 3.5vw, 2rem); border-bottom: 1px solid var(--line); padding-bottom: 12px; margin-bottom: 16px;">24-hour to 12-hour conversion table</h2>
        <p style="color: var(--muted); line-height: 1.7; max-width: 72ch;">
          Use this reference table to verify common times across both systems:
        </p>
        <div style="background: var(--panel); border: 1px solid var(--line); border-radius: 8px; overflow-x: auto; margin: 18px 0;">
          <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.95rem; min-width: 480px;">
            <thead>
              <tr style="border-bottom: 1px solid var(--line); background: var(--bg);">
                <th style="padding: 12px 14px; color: var(--accent);">24-Hour Time</th>
                <th style="padding: 12px 14px; color: var(--accent-2);">12-Hour Time</th>
                <th style="padding: 12px 14px; color: var(--muted);">Description / Rule</th>
              </tr>
            </thead>
            <tbody style="color: var(--muted);">
              {VERIFIED_EXAMPLES.map((ex, idx) => (
                <tr style={`border-bottom: 1px solid var(--line); ${idx % 2 === 1 ? 'background: rgba(255,255,255,0.02);' : ''}`}>
                  <td style="padding: 11px 14px; font-family: 'Space Grotesk', monospace; font-weight: 800; color: #ffffff;">{ex.t24}</td>
                  <td style="padding: 11px 14px; font-family: 'Space Grotesk', monospace; font-weight: 800; color: var(--accent);">{ex.t12}</td>
                  <td style="padding: 11px 14px; color: var(--muted);">{ex.note}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- Contextual Internal Links Card -->
      <section style="margin-top: 36px;">
        <div class="info-callout" style="background: var(--panel); border-left: 4px solid var(--accent); padding: 20px; border-radius: 8px;">
          <h3 style="font-size: 1.15rem; color: #ffffff; margin-top: 0; margin-bottom: 8px;">Explore Related Time Tools</h3>
          <p style="color: var(--muted); line-height: 1.6; margin: 0;">
            Want to see your current local time enlarged on a secondary screen? View the <a href="/full-screen-clock/" style="color: var(--accent); font-weight: 700; text-decoration: underline; text-underline-offset: 3px;">Full-Screen Clock</a> with 12/24-hour switching. Need to find duration or working shift spans? Calculate the days between two dates with our <a href="/days-between-dates-calculator/" style="color: var(--accent); font-weight: 700; text-decoration: underline; text-underline-offset: 3px;">Days Between Dates Calculator</a>, or explore the <a href="/" style="color: var(--accent); font-weight: 700; text-decoration: underline; text-underline-offset: 3px;">GMT to EST Converter</a> homepage.
          </p>
        </div>
      </section>

    </div>
  </div>

  <!-- Frequently Asked Questions -->
  <section style="max-width: 820px; margin: 0 auto; padding: 48px 0 24px;">
    <h2 style="font-size: clamp(1.5rem, 3.5vw, 2rem); text-align: center; margin-bottom: 20px;">Frequently Asked Questions</h2>
    <div class="faq">
      {meta.faqs.map(faq => (
        <details style="padding: 16px; background: var(--panel); border: 1px solid var(--line); border-radius: 8px; margin-bottom: 12px;">
          <summary style="font-weight: 800; cursor: pointer; color: var(--text);">{faq.q}</summary>
          <p style="margin: 12px 0 0; color: var(--muted); line-height: 1.65;">{faq.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- Interactive JavaScript Engine -->
  <script is:inline>
    (function () {
      // Elements
      var tab24to12 = document.getElementById('mode-tab-24to12');
      var tab12to24 = document.getElementById('mode-tab-12to24');
      var panel24to12 = document.getElementById('panel-24to12');
      var panel12to24 = document.getElementById('panel-12to24');

      var input24 = document.getElementById('input-24');
      var valMsg24 = document.getElementById('val-msg-24');
      var result12 = document.getElementById('result-12');
      var resultDesc12 = document.getElementById('result-desc-12');

      var input12Time = document.getElementById('input-12-time');
      var selectMeridiem = document.getElementById('select-meridiem');
      var valMsg12 = document.getElementById('val-msg-12');
      var result24 = document.getElementById('result-24');
      var resultDesc24 = document.getElementById('result-desc-24');

      var pillButtons = document.querySelectorAll('.example-pill-btn');

      // Conversion logic: 24 to 12
      function convert24to12(timeStr) {
        if (!timeStr || typeof timeStr !== 'string') return null;
        var match = timeStr.trim().match(/^(\d{1,2}):(\d{2})$/);
        if (!match) return null;

        var h = parseInt(match[1], 10);
        var m = parseInt(match[2], 10);

        if (h < 0 || h > 23 || m < 0 || m > 59) return null;

        var period = 'AM';
        var hour12 = h;

        if (h === 0) {
          hour12 = 12;
          period = 'AM';
        } else if (h >= 1 && h <= 11) {
          hour12 = h;
          period = 'AM';
        } else if (h === 12) {
          hour12 = 12;
          period = 'PM';
        } else {
          hour12 = h - 12;
          period = 'PM';
        }

        var mStr = m < 10 ? '0' + m : '' + m;
        return {
          formatted: hour12 + ':' + mStr + ' ' + period,
          hour12: hour12,
          minute: m,
          period: period
        };
      }

      // Conversion logic: 12 to 24
      function convert12to24(timeStr, period) {
        if (!timeStr || typeof timeStr !== 'string') return null;
        var match = timeStr.trim().match(/^(\d{1,2}):(\d{2})$/);
        if (!match) return null;

        var h = parseInt(match[1], 10);
        var m = parseInt(match[2], 10);
        var p = (period || '').trim().toUpperCase();

        if (h < 1 || h > 12 || m < 0 || m > 59) return null;
        if (p !== 'AM' && p !== 'PM') return null;

        var hour24 = h;
        if (p === 'AM') {
          if (h === 12) hour24 = 0;
          else hour24 = h;
        } else { // PM
          if (h === 12) hour24 = 12;
          else hour24 = h + 12;
        }

        var hStr = hour24 < 10 ? '0' + hour24 : '' + hour24;
        var mStr = m < 10 ? '0' + m : '' + m;
        return {
          formatted: hStr + ':' + mStr,
          hour24: hour24,
          minute: m
        };
      }

      // Handler for 24 to 12
      function handle24to12() {
        var rawVal = input24.value;
        var res = convert24to12(rawVal);

        if (!res) {
          valMsg24.style.display = 'block';
          result12.textContent = '--:--';
          resultDesc12.textContent = 'Awaiting valid time...';
          return;
        }

        valMsg24.style.display = 'none';
        result12.textContent = res.formatted;

        if (res.hour12 === 12 && res.minute === 0 && res.period === 'AM') {
          resultDesc12.textContent = 'Midnight (Start of new calendar day)';
        } else if (res.hour12 === 12 && res.minute === 0 && res.period === 'PM') {
          resultDesc12.textContent = 'Noon (Midday transition)';
        } else if (res.period === 'AM') {
          resultDesc12.textContent = res.hour12 + ':' + (res.minute < 10 ? '0' + res.minute : res.minute) + ' in the morning';
        } else {
          resultDesc12.textContent = res.hour12 + ':' + (res.minute < 10 ? '0' + res.minute : res.minute) + ' in the afternoon/evening';
        }
      }

      // Handler for 12 to 24
      function handle12to24() {
        var rawTime = input12Time.value;
        var rawPeriod = selectMeridiem.value;
        var res = convert12to24(rawTime, rawPeriod);

        if (!res) {
          valMsg12.style.display = 'block';
          result24.textContent = '--:--';
          resultDesc24.textContent = 'Awaiting valid time...';
          return;
        }

        valMsg12.style.display = 'none';
        result24.textContent = res.formatted;

        if (res.hour24 === 0 && res.minute === 0) {
          resultDesc24.textContent = 'Midnight (00:00 in 24-hour time)';
        } else if (res.hour24 === 12 && res.minute === 0) {
          resultDesc24.textContent = 'Noon (12:00 in 24-hour time)';
        } else {
          resultDesc24.textContent = 'Standard 24-hour notation';
        }
      }

      // Tab Switching
      function switchTab(mode) {
        if (mode === '24to12') {
          tab24to12.setAttribute('aria-selected', 'true');
          tab12to24.setAttribute('aria-selected', 'false');
          tab24to12.style.background = 'var(--accent)';
          tab24to12.style.color = '#0c354a';
          tab24to12.style.border = 'none';

          tab12to24.style.background = 'var(--bg)';
          tab12to24.style.color = 'var(--text)';
          tab12to24.style.border = '1px solid var(--line)';

          panel24to12.style.display = 'block';
          panel12to24.style.display = 'none';
          handle24to12();
        } else {
          tab12to24.setAttribute('aria-selected', 'true');
          tab24to12.setAttribute('aria-selected', 'false');
          tab12to24.style.background = 'var(--accent-2)';
          tab12to24.style.color = '#0c354a';
          tab12to24.style.border = 'none';

          tab24to12.style.background = 'var(--bg)';
          tab24to12.style.color = 'var(--text)';
          tab24to12.style.border = '1px solid var(--line)';

          panel12to24.style.display = 'block';
          panel24to12.style.display = 'none';
          handle12to24();
        }
      }

      // Event Listeners
      tab24to12.addEventListener('click', function () { switchTab('24to12'); });
      tab12to24.addEventListener('click', function () { switchTab('12to24'); });

      input24.addEventListener('input', handle24to12);
      input12Time.addEventListener('input', handle12to24);
      selectMeridiem.addEventListener('change', handle12to24);

      // Example Pill buttons
      for (var i = 0; i < pillButtons.length; i++) {
        pillButtons[i].addEventListener('click', function () {
          var t24 = this.getAttribute('data-t24');
          var t12 = this.getAttribute('data-t12');

          // Populate Mode A
          input24.value = t24;

          // Populate Mode B
          var parts = t12.split(' ');
          input12Time.value = parts[0];
          selectMeridiem.value = parts[1];

          // Refresh both
          handle24to12();
          handle12to24();
        });
      }

      // Initialize
      handle24to12();
      handle12to24();
    })();
  </script>
</BaseLayout>
