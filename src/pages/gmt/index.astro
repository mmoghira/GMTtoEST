const pageDescription = "Track GMT time with live UTC+0 clocks, Royal Observatory history, and seasonal BST shifts. Check current Greenwich Mean Time now with no signup required.";

const pubDate = "2026-07-30T10:00:00+05:00";
const updatedDate = "2026-07-30T10:00:00+05:00";

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "GMT, Greenwich Mean Time, UTC+0, GMT offset, GMT time zone, Greenwich Meridian, GMT vs UTC, GMT to EST, London time zone, Zulu time, GMT countries",
  image: "/assets/gmt-timezone-guide.webp",
