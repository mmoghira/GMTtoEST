            <text x="200" y="115" text-anchor="middle" fill="var(--accent)" font-weight="bold" font-size="20">GMT (UTC+0)</text>
            <text x="200" y="145" text-anchor="middle" fill="var(--muted)" font-size="12">Standard Greenwich Time</text>

            <!-- Transition Arrows -->
            <path d="M 360 85 Q 400 65 440 85" fill="none" stroke="var(--accent)" stroke-width="2.5" marker-end="url(#arrow)"/>
            <text x="400" y="60" text-anchor="middle" fill="var(--accent)" font-size="11" font-weight="bold">Spring Forward (+1h) - Mar</text>

