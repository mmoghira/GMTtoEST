  <p>Compare how Mountain Daylight Time aligns with neighboring North American and European time standards.</p>
  <table>
    <thead>
      <tr>
        <th>Timezone Acronym</th>
        <th>Full Name</th>
        <th>UTC Offset</th>
        <th>Season Active</th>
        <th>Primary Cities</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><strong>GMT</strong></td>
        <td>Greenwich Mean Time</td>
        <td>UTC+0</td>
        <td>Year-Round Baseline</td>
        <td>Greenwich, Accra, Reykjavik</td>
      </tr>
      <tr>
        <td><strong>MDT</strong></td>
        <td>Mountain Daylight Time</td>
        <td>UTC-6</td>
        <td>Summer (Mar–Nov)</td>
        <td>Denver, Salt Lake City, Calgary</td>
      </tr>
      <tr>
        <td><strong>MST</strong></td>
        <td>Mountain Standard Time</td>
        <td>UTC-7</td>
        <td>Winter (Nov–Mar)</td>
        <td>Phoenix (year-round), Denver (winter)</td>
      </tr>
      <tr>
        <td><strong>EDT</strong></td>
        <td>Eastern Daylight Time</td>
        <td>UTC-4</td>
        <td>Summer (Mar–Nov)</td>
        <td>New York, Toronto, Miami</td>
      </tr>
      <tr>
