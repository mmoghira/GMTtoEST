---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import Converter from "theme/components/Converter.astro";
import { getTranslation, pageUrl, siteUrl } from "theme/i18n/config";

const lang = "en";
const dir = "ltr";
const slug = "gmt-to-mdt";
const t = getTranslation(lang);

const pageTitle = "GMT to MDT Converter";
const seoTitle = "GMT to MDT Converter – Greenwich Mean Time to Mountain Daylight Time";
const pageDescription = "Convert GMT to MDT instantly. Find the exact time difference between Greenwich Mean Time (UTC+0) and Mountain Daylight Time (UTC-6) with live clocks, conversion table, and meeting planner.";

const context = {
  from: "GMT",
  to: "MDT",
  fromZone: "UTC",
  toZone: "America/Denver"
};

const canonical = `${siteUrl}/gmt-to-mdt/`;

// 24-hour conversion table data (GMT → MDT = GMT - 6)
function formatHour12(hour: number) {
  const normalized = ((hour % 24) + 24) % 24;
  const period = normalized < 12 ? "AM" : "PM";
  const displayHour = normalized % 12 || 12;
  return `${displayHour}:00 ${period}`;
}

const conversionRows = Array.from({ length: 24 }, (_, hour) => {
  const mdtHour = hour - 6;
  const mdtNormalized = ((mdtHour % 24) + 24) % 24;
  const prevDay = mdtHour < 0;
  const period = mdtNormalized < 12 ? "AM" : "PM";
  const displayHour = mdtNormalized % 12 || 12;
  return {
    gmt: formatHour12(hour),
    mdt: `${displayHour}:00 ${period}${prevDay ? " (-1 day)" : ""}`,
    dayNote: prevDay ? "Previous calendar day" : "Same calendar day",
    status: (mdtNormalized >= 8 && mdtNormalized < 17) ? "Business Hours" : (mdtNormalized >= 17 && mdtNormalized < 22) ? "Evening Hours" : "Night Hours"
  };
});

// Popular conversions
const popularConversions = [
  { gmt: "12:00 AM (Midnight)", mdt: "6:00 PM MDT (Prev Day)", note: "Evening in Denver, midnight transition in Greenwich" },
  { gmt: "1:00 AM GMT", mdt: "7:00 PM MDT (Prev Day)", note: "Prime-time evening hours across Rocky Mountain states" },
  { gmt: "2:00 AM GMT", mdt: "8:00 PM MDT (Prev Day)", note: "Late evening entertainment in Salt Lake City and Calgary" },
  { gmt: "3:00 AM GMT", mdt: "9:00 PM MDT (Prev Day)", note: "Nighttime hours across North American Mountain Region" },
  { gmt: "4:00 AM GMT", mdt: "10:00 PM MDT (Prev Day)", note: "Winding down before rest in Mountain Daylight Time" },
  { gmt: "5:00 AM GMT", mdt: "11:00 PM MDT (Prev Day)", note: "Late night in Denver and Edmonton" },
  { gmt: "6:00 AM GMT", mdt: "12:00 AM (Midnight) MDT", note: "Midnight transition in Mountain Daylight Time" },
  { gmt: "7:00 AM GMT", mdt: "1:00 AM MDT", note: "Deep night sleeping hours across Mountain zone" },
  { gmt: "8:00 AM GMT", mdt: "2:00 AM MDT", note: "Quiet early hours in Denver and Salt Lake City" },
  { gmt: "9:00 AM GMT", mdt: "3:00 AM MDT", note: "Early pre-dawn in North America" },
  { gmt: "10:00 AM GMT", mdt: "4:00 AM MDT", note: "Pre-dawn hours in Mountain time zone" },
  { gmt: "11:00 AM GMT", mdt: "5:00 AM MDT", note: "Dawn breaking in Denver, early risers starting" },
  { gmt: "12:00 PM (Noon)", mdt: "6:00 AM MDT", note: "Early morning start in Alberta and Colorado" },
  { gmt: "1:00 PM GMT", mdt: "7:00 AM MDT", note: "Morning commute window in Salt Lake City" },
  { gmt: "2:00 PM GMT", mdt: "8:00 AM MDT", note: "Denver and Calgary offices opening for business" },
  { gmt: "3:00 PM GMT", mdt: "9:00 AM MDT", note: "Morning focus hours in Silicon Slopes, mid-afternoon in UK" },
  { gmt: "4:00 PM GMT", mdt: "10:00 AM MDT", note: "Prime transatlantic collaboration window" },
  { gmt: "5:00 PM GMT", mdt: "11:00 AM MDT", note: "Mid-morning focus in Mountain Time, end of GMT workday" },
  { gmt: "6:00 PM GMT", mdt: "12:00 PM (Noon) MDT", note: "Lunch break in Denver, early evening in Greenwich" },
  { gmt: "7:00 PM GMT", mdt: "1:00 PM MDT", note: "Afternoon work session across Rocky Mountain tech companies" },
  { gmt: "8:00 PM GMT", mdt: "2:00 PM MDT", note: "Mid-afternoon engineering work in Salt Lake City" },
  { gmt: "9:00 PM GMT", mdt: "3:00 PM MDT", note: "Late afternoon project syncs in Denver and Calgary" },
  { gmt: "10:00 PM GMT", mdt: "4:00 PM MDT", note: "Mountain zone offices wrapping up standard business day" },
  { gmt: "11:00 PM GMT", mdt: "5:00 PM MDT", note: "End of official workday in Mountain Daylight Time" }
];

// FAQ data
const faqs = [
  {
    q: "What is MDT?",
    a: "MDT stands for Mountain Daylight Time. It is the daylight saving time zone observed in the Mountain Region of North America (including parts of the US and Canada) during summer months, operating at UTC-6 (6 hours behind Coordinated Universal Time)."
  },
  {
    q: "What is the time difference between GMT and MDT?",
    a: "Mountain Daylight Time (MDT) is exactly 6 hours behind Greenwich Mean Time (GMT). When it is 4:00 PM GMT in Greenwich, it is 10:00 AM MDT in Denver."
  },
  {
    q: "When is MDT active during the year?",
    a: "In the United States and Canada, Mountain Daylight Time (MDT) starts on the second Sunday of March (when clocks jump forward 1 hour from MST) and ends on the first Sunday of November (when clocks fall back to MST)."
  },
  {
    q: "Is GMT the same as UTC?",
    a: "For practical scheduling, GMT (Greenwich Mean Time) and UTC (Coordinated Universal Time) represent the same solar time reference offset (+0)."
  },
  {
    q: "Which major North American cities observe MDT?",
    a: "Major cities observing MDT during summer include Denver (Colorado), Salt Lake City (Utah), Albuquerque (New Mexico), Boise (Idaho), Cheyenne (Wyoming), Calgary (Alberta), and Edmonton (Alberta)."
  },
  {
    q: "Does Arizona observe Mountain Daylight Time (MDT)?",
    a: "Most of Arizona does NOT observe daylight saving time and stays on Mountain Standard Time (MST, UTC-7) year-round. However, the Navajo Nation in northeastern Arizona does observe MDT (UTC-6)."
  },
  {
    q: "How do I convert GMT to MDT manually?",
    a: "To convert GMT to MDT, subtract 6 hours from the GMT timestamp. For example: 3:00 PM GMT minus 6 hours = 9:00 AM MDT. If the result is negative, subtract from 24 to find the time on the previous calendar day."
  },
  {
    q: "What is 8:00 PM GMT in MDT?",
    a: "8:00 PM GMT converts to 2:00 PM MDT on the exact same calendar day."
  },
  {
    q: "What is the difference between MST and MDT?",
    a: "MST is Mountain Standard Time (UTC-7), used during winter. MDT is Mountain Daylight Time (UTC-6), used during summer daylight saving months."
  },
  {
    q: "What is the primary IANA time zone identifier for MDT?",
    a: "The primary canonical IANA time zone identifier for US Mountain Time is America/Denver. In Canada, America/Edmonton and America/Calgary are also widely used."
  },
  {
    q: "What is the overlap window for meetings between London (GMT) and Denver (MDT)?",
    a: "Because MDT is 6 hours behind GMT, the viable business overlap window occurs between 2:00 PM and 5:00 PM GMT, which corresponds to 8:00 AM to 11:00 AM MDT."
  },
  {
    q: "Why do the US and UK change clocks on different dates?",
    a: "The US begins daylight saving on the second Sunday of March and ends on the first Sunday of November. The UK begins BST on the last Sunday of March and ends on the last Sunday of October. During the brief gap weeks, relative offsets shift."
  },
  {
    q: "How does Calgary and Edmonton handle GMT conversions?",
    a: "Alberta, Canada observes MDT (UTC-6) during summer, synchronizing identically with Denver, Colorado."
  },
  {
    q: "What is 12:00 AM Midnight GMT in MDT?",
    a: "12:00 AM GMT corresponds to 6:00 PM MDT on the previous calendar evening."
  },
  {
    q: "How do tech companies in Silicon Slopes (Utah) coordinate with European teams?",
    a: "Technology firms in Salt Lake City and Provo schedule daily standups between 8:30 AM and 10:00 AM MDT (2:30 PM to 4:00 PM GMT) to catch European colleagues before their workday ends."
  },
  {
    q: "Does Denver's elevation affect time zone rules?",
    a: "No. Denver's nickname as the 'Mile High City' refers to its atmospheric elevation, but its time zone rules follow standard US federal daylight saving schedules under the America/Denver zone."
  },
  {
    q: "What is the military time designation for UTC-6?",
    a: "In military and maritime time zone indexing, UTC-6 is designated as Foxtrot Time Zone (F)."
  },
  {
    q: "How do cloud datacenters in the Mountain region handle time logging?",
    a: "Datacenters located in Cheyenne or Salt Lake City log system telemetry in UTC (GMT) and translate timestamps to America/Denver for administrative analytics."
  },
  {
    q: "What is 10:00 AM GMT in MDT?",
    a: "10:00 AM GMT minus 6 hours equals 4:00 AM MDT on the same morning."
  },
  {
    q: "Is MDT used in Mexico?",
    a: "Parts of northern Mexico along the US border (such as Ciudad Juárez, Chihuahua) synchronize with US Mountain Daylight Time (UTC-6) for cross-border trade."
  },
  {
    q: "What happens to aviation flight times between London and Denver?",
    a: "Nonstop flights between London Heathrow (LHR) and Denver International Airport (DEN) take roughly 9 to 10 hours. Due to the 6-hour backward time shift, a flight departing London at 12:00 PM GMT lands in Denver around 3:30 PM MDT."
  },
  {
    q: "Can this converter tool handle historical date calculations?",
    a: "Yes. Our converter uses native browser Intl API rules, automatically applying historical daylight saving rules for any requested date."
  },
  {
    q: "What is 5:00 PM MDT in GMT?",
    a: "5:00 PM MDT plus 6 hours equals 11:00 PM GMT on the same evening."
  },
  {
    q: "How does solar noon in Greenwich compare to solar noon in Denver?",
    a: "Solar noon in Greenwich occurs around 12:00 PM GMT. Solar noon in Denver occurs around 1:00 PM MDT (which corresponds to 7:00 PM GMT)."
  }
];

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "GMT to MDT, Greenwich Mean Time to Mountain Daylight Time, Convert GMT to MDT, MDT Time Zone, Denver Time, Salt Lake City Time, UTC+0 to UTC-6, GMT MDT Difference",
  image: "/assets/gmt-to-mdt-og.svg",
  imageAlt: "GMT to MDT Time Converter – Greenwich Mean Time to Mountain Daylight Time",
  faqs,
  appDescription: "Free online GMT to MDT converter with live clocks, 24-hour schedules, meeting planner, and US Mountain Daylight Time details.",
  applicationCategory: "UtilityApplication",
  operatingSystem: "Any",
  howToName: "How to Convert GMT to MDT",
  howToDescription: "Step-by-step instructions for converting Greenwich Mean Time to Mountain Daylight Time.",
  howToSteps: [
    { name: "Enter GMT Time", text: "Select your desired GMT timestamp using the interactive time picker." },
    { name: "Subtract Six Hours", text: "Subtract 6 hours to convert from UTC+0 (GMT) to UTC-6 (MDT)." },
    { name: "Verify Date Rollover", text: "Check if the 6-hour subtraction crosses midnight into the previous calendar day." },
    { name: "Copy and Share", text: "Copy the converted MDT result for your team schedule or flight itinerary." }
  ],
};
---

<BaseLayout
  lang={lang}
  dir={dir}
  title={seoTitle}
  description={pageDescription}
  slug={slug}
  meta={meta}
  mode="gmt-est"
  enableFaqSchema={true}
  allowAds={true}
  breadcrumbHomeLabel="Home"
  breadcrumbLabel="GMT to MDT"
  hreflangCodes={["en"]}
>

<!-- ═══════════════════════════════════════════════════════════════════════════
     H1 & HERO BANNER
     ═══════════════════════════════════════════════════════════════════════ -->
<section class="hero-banner">
  <h1 class="hero-banner-title">
    GMT to MDT <span class="gradient-text">Converter</span>
  </h1>
</section>

<!-- PRIMARY CONVERTER & LIVE CLOCKS (Above the Fold) -->
<div style="max-width: 900px; margin: 0 auto; padding: 0 16px 24px;">
  <Converter intent="dynamic" t={t} context={context} />
  
  <!-- LIVE CLOCKS -->
  <section class="clock-grid" aria-label="Live Clocks" style="margin-top: 24px;">
    <h2>Live Clocks</h2>
    <div class="clock-card">
      <span class="eyebrow">Source Time Zone</span>
      <strong id="gmtClock">--:--:--</strong>
    </div>
    <div class="clock-card">
      <span class="eyebrow">Target Time Zone</span>
      <strong id="estClock">--:--:--</strong>
      <p style="margin-top: 4px; font-size: 0.85rem; color: var(--muted);">Active Zone: <em id="estZone">ET</em></p>
    </div>
  </section>
</div>


</div>
</div>


<!-- FEATURE STRIP -->
<section class="feature-strip" aria-label="Tool Features">
  <div class="feature-item">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feature-icon" aria-hidden="true">
      <circle cx="12" cy="12" r="10"></circle>
      <polyline points="12 6 12 12 16 14"></polyline>
    </svg>
    <span>Real-Time Clocks</span>
  </div>
  <div class="feature-item">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feature-icon" aria-hidden="true">
      <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
    </svg>
