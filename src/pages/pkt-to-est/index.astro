      <!-- Minaret Spire -->
      <rect x="55" y="30" width="16" height="120" fill="#1b536e" />
      <polygon points="63,0 45,30 81,30" fill="#36c7b5" opacity="0.8" />
      <rect x="20" y="100" width="86" height="50" fill="#164d68" />
      <text x="63" y="165" font-family="'Space Grotesk', sans-serif" font-size="12" font-weight="bold" fill="#8fd7ff" text-anchor="middle">Lahore / PKT</text>
    </g>

    <!-- Transcontinental Bridge Wave -->
    <path d="M 210 140 Q 400 60 590 140" fill="none" stroke="#36c7b5" stroke-width="2" stroke-dasharray="4 4" />

    <!-- NYC Skyline Silhouette (Right Side) -->
    <g transform="translate(600, 40)">
      <rect x="20" y="70" width="40" height="90" fill="#1b536e" />
      <rect x="70" y="40" width="35" height="120" fill="#164d68" />
      <line x1="87.5" y1="40" x2="87.5" y2="15" stroke="#36c7b5" stroke-width="3" />
      <text x="55" y="155" font-family="'Space Grotesk', sans-serif" font-size="12" font-weight="bold" fill="#8fd7ff" text-anchor="middle">New York / EST</text>
