        <rect width="600" height="250" fill="#0c354a" rx="8" />
        <path d="M40 160 C 170 70, 250 230, 390 100 C 470 40, 520 170, 560 80" fill="none" stroke="#36c7b5" stroke-width="3" opacity="0.8" />
        
        <!-- Left Clock: Pakistan (Karachi / Lahore - UTC+5) -->
        <g transform="translate(140, 115)">
