  </div>
  <Converter intent="dynamic" t={t} context={context} />
</section>

<!-- LIVE CLOCKS SECTION -->
<section class="clock-grid" aria-labelledby="live-clocks-heading">
  <h2 id="live-clocks-heading">Live Clocks: Pakistan vs US East Coast</h2>
  <div class="clock-card"><span>Current PKT (UTC+5)</span><strong id="gmtClock">--:--</strong></div>
  <div class="clock-card"><span>Current EST (UTC-5)</span><strong id="estClock">--:--</strong><em id="estZone">EST</em></div>
</section>

<!-- REGIONAL SKYLINE ILLUSTRATION (MINAR-E-PAKISTAN & NYC SKYLINE) -->
<section class="skyline-container content-section" style="text-align: center; margin: 3rem 0;">
  <h3 class="sr-only">Minar-e-Pakistan & New York Skyline Graphics</h3>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 200" width="100%" height="auto" style="display: block; max-width: 800px; margin: 0 auto; background: linear-gradient(180deg, #0c354a 0%, #12455d 100%); border-radius: 12px; border: 1px solid var(--line);">
    <!-- Crescent Moon & Stars -->
    <path d="M 160 30 A 15 15 0 1 1 145 55 A 18 18 0 1 0 160 30 Z" fill="#36c7b5" opacity="0.8" />
    <circle cx="300" cy="25" r="1.5" fill="#f4fbff" opacity="0.4" />
    <circle cx="540" cy="35" r="2" fill="#36c7b5" opacity="0.7" />

    <!-- Minar-e-Pakistan / Faisal Mosque Silhouette (Left Side) -->
