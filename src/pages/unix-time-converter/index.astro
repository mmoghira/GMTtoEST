      const unitMillisBtn = document.getElementById("unit-millis-btn");
      const currentTimeBtn = document.getElementById("current-time-btn");
      const epochError = document.getElementById("epoch-error");
      const resUtc = document.getElementById("res-utc");
      const resLocal = document.getElementById("res-local");
      const resLocalTzNote = document.getElementById("res-local-tz-note");
      const resEt = document.getElementById("res-et");
      const resEtNote = document.getElementById("res-et-note");
      const examplePills = document.querySelectorAll(".example-pill-btn");

      // Mode B Elements
      const revDtInput = document.getElementById("reverse-datetime-input");
      const revUnitSecsBtn = document.getElementById("rev-unit-seconds-btn");
      const revUnitMillisBtn = document.getElementById("rev-unit-millis-btn");
      const convertRevBtn = document.getElementById("convert-reverse-btn");
      const revError = document.getElementById("reverse-error");
      const revResValue = document.getElementById("rev-res-value");
      const revResLabel = document.getElementById("rev-res-label");
      const copyEpochBtn = document.getElementById("copy-epoch-btn");

      // State variables
      let epochUnit = "seconds"; // "seconds" | "milliseconds"
      let revEpochUnit = "seconds"; // "seconds" | "milliseconds"

      const MONTH_NAMES = [
        "January", "February", "March", "April", "May", "June",
        "July", "August", "September", "October", "November", "December"
      ];

      // Format UTC date explicitly: "1 January 2026, 00:00:00 UTC"
      function formatUtc(d) {
        const day = d.getUTCDate();
        const month = MONTH_NAMES[d.getUTCMonth()];
        const year = d.getUTCFullYear();
        const hh = String(d.getUTCHours()).padStart(2, "0");
        const mm = String(d.getUTCMinutes()).padStart(2, "0");
        const ss = String(d.getUTCSeconds()).padStart(2, "0");
        return `${day} ${month} ${year}, ${hh}:${mm}:${ss} UTC`;
      }

      // Format Visitor's Local Date & Time
      function formatLocal(d) {
        try {
          const localFmt = new Intl.DateTimeFormat("en-US", {
            day: "numeric",
            month: "long",
            year: "numeric",
            hour: "2-digit",
            minute: "2-digit",
            second: "2-digit",
            hour12: false,
            timeZoneName: "short"
          });
          const parts = localFmt.formatToParts(d);
          const get = (t) => parts.find((p) => p.type === t)?.value || "";
          const day = get("day");
          const month = get("month");
          const year = get("year");
          const hour = get("hour");
          const minute = get("minute");
          const second = get("second");
          const tz = get("timeZoneName");
          return `${day} ${month} ${year}, ${hour}:${minute}:${second}${tz ? " " + tz : ""}`;
        } catch (e) {
          return d.toString();
        }
      }

      // Format Eastern Time with dynamic EST/EDT abbreviation
      function formatEastern(d) {
        try {
          const etFmt = new Intl.DateTimeFormat("en-US", {
            timeZone: "America/New_York",
            day: "numeric",
            month: "long",
            year: "numeric",
            hour: "2-digit",
            minute: "2-digit",
            second: "2-digit",
            hour12: false,
            timeZoneName: "short"
          });
          const parts = etFmt.formatToParts(d);
          const get = (t) => parts.find((p) => p.type === t)?.value || "";
          const day = get("day");
          const month = get("month");
          const year = get("year");
          const hour = get("hour");
          const minute = get("minute");
          const second = get("second");
          const tz = get("timeZoneName");
          return {
            formatted: `${day} ${month} ${year}, ${hour}:${minute}:${second} ${tz || "ET"}`,
            tzName: tz || "ET"
          };
        } catch (e) {
          return {
            formatted: d.toISOString(),
            tzName: "ET"
          };
        }
      }

      // ── MODE A: CALCULATE EPOCH TO DATE ─────────────────────────────────
      function updateEpochConversion() {
        const valStr = epochInput.value ? epochInput.value.trim() : "";

        // Validate: non-empty, integer numeric format (allowing negative numbers for pre-1970)
        if (!valStr || !/^-?\d+$/.test(valStr)) {
          showEpochError();
          return;
        }

        const rawNum = Number(valStr);
        if (!Number.isFinite(rawNum)) {
          showEpochError();
          return;
        }

        let ms = 0;
        if (epochUnit === "seconds") {
          ms = rawNum * 1000;
        } else {
          ms = rawNum;
        }

        // Check supported JavaScript Date range: +/- 8.64e15 ms
        if (Math.abs(ms) > 8.64e15) {
          showEpochError();
          return;
        }

        const d = new Date(ms);
        if (isNaN(d.getTime())) {
          showEpochError();
          return;
        }

        // Valid timestamp
        epochError.style.display = "none";

        // 1. UTC Date and Time
        resUtc.textContent = formatUtc(d);

        // 2. Visitor's Local Date and Time
        resLocal.textContent = formatLocal(d);
        try {
          const localTz = Intl.DateTimeFormat().resolvedOptions().timeZone || "Local Time";
          resLocalTzNote.textContent = `Configured browser time zone: ${localTz}`;
        } catch (e) {
          resLocalTzNote.textContent = "Rendered in your browser's local time zone";
        }

        // 3. Eastern Time
        const etResult = formatEastern(d);
        resEt.textContent = etResult.formatted;
        resEtNote.textContent = `Dynamically determined Eastern Time zone abbreviation: ${etResult.tzName}`;
      }

      function showEpochError() {
        epochError.style.display = "block";
        resUtc.textContent = "--";
        resLocal.textContent = "--";
        resEt.textContent = "--";
        resEtNote.textContent = "--";
        resLocalTzNote.textContent = "--";
      }

      // Unit switchers for Mode A
      unitSecsBtn.addEventListener("click", function () {
        if (epochUnit === "seconds") return;
        epochUnit = "seconds";
        unitSecsBtn.style.background = "var(--accent)";
        unitSecsBtn.style.color = "#0c354a";
        unitSecsBtn.setAttribute("aria-pressed", "true");

        unitMillisBtn.style.background = "var(--bg)";
        unitMillisBtn.style.color = "var(--text)";
        unitMillisBtn.setAttribute("aria-pressed", "false");

        // If switching from ms with a 13-digit number, convert to seconds
        const val = epochInput.value.trim();
        if (/^\d{12,14}$/.test(val)) {
          epochInput.value = Math.floor(Number(val) / 1000).toString();
        }
        updateEpochConversion();
      });

      unitMillisBtn.addEventListener("click", function () {
        if (epochUnit === "milliseconds") return;
        epochUnit = "milliseconds";
        unitMillisBtn.style.background = "var(--accent)";
        unitMillisBtn.style.color = "#0c354a";
        unitMillisBtn.setAttribute("aria-pressed", "true");

        unitSecsBtn.style.background = "var(--bg)";
        unitSecsBtn.style.color = "var(--text)";
        unitSecsBtn.setAttribute("aria-pressed", "false");

        // If switching from seconds with a 9-11 digit number, convert to ms
        const val = epochInput.value.trim();
        if (/^\d{9,11}$/.test(val)) {
          epochInput.value = (Number(val) * 1000).toString();
        }
        updateEpochConversion();
      });

      // Use Current Time button
      currentTimeBtn.addEventListener("click", function () {
        const nowMs = Date.now();
        if (epochUnit === "seconds") {
          epochInput.value = Math.floor(nowMs / 1000).toString();
        } else {
          epochInput.value = nowMs.toString();
        }
        updateEpochConversion();
        epochInput.focus();
      });

      // Example pills
      examplePills.forEach((pill) => {
        pill.addEventListener("click", function () {
          const ts = this.getAttribute("data-ts");
          // Switch to seconds mode for verified examples
          if (epochUnit !== "seconds") {
            unitSecsBtn.click();
          }
          epochInput.value = ts;
          updateEpochConversion();
          epochInput.focus();
        });
      });

      epochInput.addEventListener("input", updateEpochConversion);

      // ── MODE B: CALCULATE DATE TO EPOCH ─────────────────────────────────
      function updateReverseConversion() {
        const dtVal = revDtInput.value;
        if (!dtVal) {
          revError.style.display = "block";
          revResValue.textContent = "--";
          return;
        }

        // Native datetime-local string parsed as local time: YYYY-MM-DDTHH:mm:ss
        const d = new Date(dtVal);
        if (isNaN(d.getTime())) {
          revError.style.display = "block";
          revResValue.textContent = "--";
          return;
        }

        revError.style.display = "none";
        const ms = d.getTime();

        if (revEpochUnit === "seconds") {
          const secs = Math.floor(ms / 1000);
          revResValue.textContent = secs.toString();
          revResLabel.textContent = "Unix Timestamp (Seconds):";
        } else {
          revResValue.textContent = ms.toString();
          revResLabel.textContent = "Unix Timestamp (Milliseconds):";
        }
      }

      revUnitSecsBtn.addEventListener("click", function () {
        revEpochUnit = "seconds";
        revUnitSecsBtn.style.background = "var(--accent)";
        revUnitSecsBtn.style.color = "#0c354a";
        revUnitSecsBtn.setAttribute("aria-pressed", "true");

        revUnitMillisBtn.style.background = "var(--bg)";
        revUnitMillisBtn.style.color = "var(--text)";
        revUnitMillisBtn.setAttribute("aria-pressed", "false");

        updateReverseConversion();
      });

      revUnitMillisBtn.addEventListener("click", function () {
        revEpochUnit = "milliseconds";
        revUnitMillisBtn.style.background = "var(--accent)";
        revUnitMillisBtn.style.color = "#0c354a";
        revUnitMillisBtn.setAttribute("aria-pressed", "true");

        revUnitSecsBtn.style.background = "var(--bg)";
        revUnitSecsBtn.style.color = "var(--text)";
        revUnitSecsBtn.setAttribute("aria-pressed", "false");

        updateReverseConversion();
      });

      revDtInput.addEventListener("input", updateReverseConversion);
      revDtInput.addEventListener("change", updateReverseConversion);
      convertRevBtn.addEventListener("click", updateReverseConversion);

      // Copy Epoch Button
      copyEpochBtn.addEventListener("click", function () {
        const text = revResValue.textContent;
        if (!text || text === "--") return;
        navigator.clipboard.writeText(text).then(() => {
          const originalText = copyEpochBtn.textContent;
          copyEpochBtn.textContent = "✓ Copied!";
          setTimeout(() => {
            copyEpochBtn.textContent = originalText;
          }, 2000);
        }).catch(() => {});
      });

      // ── TAB SWITCHING LOGIC ──────────────────────────────────────────────
      tabEpochToDate.addEventListener("click", function () {
        tabEpochToDate.style.background = "var(--accent)";
        tabEpochToDate.style.color = "#0c354a";
        tabEpochToDate.setAttribute("aria-selected", "true");

        tabDateToEpoch.style.background = "var(--bg)";
        tabDateToEpoch.style.color = "var(--text)";
        tabDateToEpoch.setAttribute("aria-selected", "false");

        panelEpochToDate.style.display = "block";
        panelDateToEpoch.style.display = "none";
      });

      tabDateToEpoch.addEventListener("click", function () {
        tabDateToEpoch.style.background = "var(--accent)";
        tabDateToEpoch.style.color = "#0c354a";
        tabDateToEpoch.setAttribute("aria-selected", "true");

        tabEpochToDate.style.background = "var(--bg)";
        tabEpochToDate.style.color = "var(--text)";
        tabEpochToDate.setAttribute("aria-selected", "false");

        panelEpochToDate.style.display = "none";
        panelDateToEpoch.style.display = "block";

        // Set default reverse datetime if empty
        if (!revDtInput.value) {
          const now = new Date();
          const pad = (n) => String(n).padStart(2, "0");
          const localIso = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}T${pad(now.getHours())}:${pad(now.getMinutes())}:${pad(now.getSeconds())}`;
          revDtInput.value = localIso;
          updateReverseConversion();
        }
      });

      // Initialize on load with verified default example: 1767225600
      updateEpochConversion();
    })();
  </script>

  <style>
    @media (max-width: 680px) {
      .epoch-input-grid {
        grid-template-columns: 1fr !important;
      }
      .epoch-input-grid button {
        width: 100%;
      }
    }
    .article-content {
      line-height: 1.75;
      color: #bdd2dc;
    }
    .article-content h2 {
      color: #ffffff;
      font-size: clamp(1.35rem, 2.5vw, 1.75rem);
      margin: 36px 0 16px;
      padding-bottom: 8px;
      border-bottom: 1px solid var(--line);
      font-family: "Space Grotesk", system-ui, sans-serif;
    }
    .article-content p {
      margin-bottom: 16px;
    }
    .article-content ul {
      margin: 0 0 20px 24px;
      padding: 0;
    }
    .article-content li {
      margin-bottom: 8px;
    }
    .article-content a {
      color: var(--accent);
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    .article-content a:hover {
      color: #ffffff;
    }
  </style>
</BaseLayout>
