const lang = "en";
const dir = "ltr";
const slug = "unix-time-converter";
const seoTitle = "Unix Time Converter | Epoch Time to Date & Time";
const pageDescription = "Convert Unix epoch time to a readable date and time, and convert a date back to epoch seconds, in UTC and local time.";

const pubDate = "2026-10-25T15:00:00+05:00";
const updatedDate = "2026-10-25T15:30:00+05:00";

const meta = {
  seoTitle,
  exactTitle: true,
  description: pageDescription,
  keywords: "unix time converter, epoch time converter, unix timestamp to date, convert epoch to utc, epoch to est, date to unix timestamp",
  pubDate,
  updatedDate,
  author: "Time Intelligence Team",
  faqs: [
    {
      q: "What is epoch time?",
      a: "Epoch time, or Unix time, is the number of seconds since 00:00:00 UTC on 1 January 1970."
    },
    {
      q: "How do I convert epoch time to a date?",
      a: "Enter the epoch seconds in the tool above. It shows the same instant in UTC, in your local time, and in Eastern Time."
    },
    {
      q: "Is epoch time the same in every time zone?",
      a: "Yes. The epoch value is one instant worldwide. Only the readable date and time change when you switch time zones."
    },
    {
      q: "Is a GPS timestamp the same as Unix time?",
      a: "Not necessarily. GPS time handles leap seconds differently from UTC, so check whether your device outputs GPS time or UTC before converting."
    }
  ]
};

const VERIFIED_EXAMPLES = [
  {
    seconds: "1767225600",
    utc: "1 January 2026, 00:00:00 UTC",
    et: "31 December 2025, 19:00:00 EST",
    note: "New Year 2026 (Winter / EST)"
  },
  {
    seconds: "1792918800",
    utc: "25 October 2026, 09:00:00 UTC",
    et: "25 October 2026, 05:00:00 EDT",
    note: "Autumn 2026 (Daylight / EDT)"
  }
];
