  <!-- Client-Side Vanilla JavaScript: Two-Way Converter Engine -->
  <script is:inline>
    (function initUnixConverter() {
      // Tab Elements
      const tabEpochToDate = document.getElementById("tab-epoch-to-date");
      const tabDateToEpoch = document.getElementById("tab-date-to-epoch");
      const panelEpochToDate = document.getElementById("panel-epoch-to-date");
