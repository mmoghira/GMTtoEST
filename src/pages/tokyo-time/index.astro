    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>City</th>
            <th>Northern Summer Difference (vs. Tokyo)</th>
            <th>Northern Winter Difference (vs. Tokyo)</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>London</strong></td>
            <td>London is 8 hours behind (BST)</td>
            <td>London is 9 hours behind (GMT)</td>
          </tr>
          <tr>
            <td><strong>New York</strong></td>
            <td>New York is 13 hours behind (EDT)</td>
            <td>New York is 14 hours behind (EST)</td>
          </tr>
          <tr>
            <td><strong>Los Angeles</strong></td>
            <td>Los Angeles is 16 hours behind (PDT)</td>
            <td>Los Angeles is 17 hours behind (PST)</td>
          </tr>
          <tr>
            <td><strong>Sydney</strong></td>
