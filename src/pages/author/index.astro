---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import { siteUrl } from "theme/i18n/config";

const title = "Editorial Team & Authors";
const description = "Meet the author and editorial team behind GMT to EST Converter timezone guides and conversion content.";
const pageUrl = `${siteUrl}/author/`;
const meta = {
  title,
  seoTitle: "Timezone Editorial Team & Authors – GMT to EST Converter",
  description,
  keywords: "GMT to EST author, timezone author, GMT to EST editorial team, Jackie Bruce",
  image: "/images/og/default.png",
  imageAlt: "Meet the Author and Editorial Team - GMT to EST Converter"
};

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${pageUrl}#webpage`,
  url: pageUrl,
  name: title,
  description,
  inLanguage: "en",
  mainEntity: {
    "@type": "ItemList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        url: `${siteUrl}/author/jackie-bruce/`,
        item: {
          "@type": "Person",
          name: "Jackie Bruce",
          jobTitle: "Timezone Content Specialist"
        }
      }
    ]
  },
  breadcrumb: {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: siteUrl },
      { "@type": "ListItem", position: 2, name: "Authors", item: pageUrl }
    ]
  }
};
---

<BaseLayout lang="en" dir="ltr" title={title} description={description} slug="author" meta={meta}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} slot="head" />

  <section class="content author-hub" aria-labelledby="author-hub-title">
    <h1 id="author-hub-title">Timezone Editorial Team &amp; Authors</h1>
    <p>
      GMT to EST Converter content is written and reviewed by a focused editorial team that specializes in timezone
      conversion accuracy, daylight saving transitions, and practical scheduling guidance. Read our
      <a href="/editorial-policy/">Editorial Policy</a> for the standards behind that work.
    </p>

    <article class="author-card" aria-labelledby="jackie-bruce">
      <h2 id="jackie-bruce">
        <a href="/author/jackie-bruce/" rel="author">Jackie Bruce</a>
      </h2>
      <p class="role">Timezone Content Specialist</p>
      <p>
        Jackie covers GMT, EST, EDT, and date-aware conversion scenarios for remote teams, events, and international
        scheduling.
      </p>
      <p><a class="profile-link" href="/author/jackie-bruce/">View full author profile</a></p>
    </article>

    <section class="author-process" aria-labelledby="author-process-title">
      <h2 id="author-process-title">How Our Timezone Content Is Prepared</h2>
      <p>
        Every guide starts with the exact scheduling question a reader needs to answer. The author checks the named
        time zones, their UTC offsets, and the dates when daylight saving time may change the result. Conversion
        examples are then tested against date-aware IANA timezone data so an EST or EDT label is not applied blindly
        throughout the year.
      </p>
      <p>
        Articles covering live events also separate confirmed schedule information from estimates. When an organizer,
        governing body, or broadcaster changes a time, the affected article can be reviewed and updated without
        rewriting unrelated conversion guidance. Sources are linked where they help readers verify an important date,
        kickoff, session, or clock-change rule.
      </p>

      <h2>Review and Correction Standards</h2>
      <p>
        Clear language matters as much as correct arithmetic. Drafts are reviewed for ambiguous abbreviations,
        overnight date changes, seasonal offset mistakes, and examples that could confuse readers outside North
        America. We also check headings, tables, image descriptions, and links so the material remains usable on
        mobile devices and with assistive technology.
      </p>
      <p>
        Readers can report a questionable conversion or outdated schedule through the
        <a href="/contact-us/">contact form</a>. Include the page URL, date, source time, and expected result so the
        team can reproduce the issue. For more detail on sourcing, updates, and corrections, see the
        <a href="/editorial-policy/">Editorial Policy</a>.
      </p>
    </section>
  </section>
</BaseLayout>

<style>
  .author-hub {
    display: block;
    max-width: 900px;
  }

  .author-hub > p {
    color: var(--muted);
    max-width: 72ch;
  }

  .author-card {
    margin-top: 1.5rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 1.25rem;
    background: var(--panel);
  }

  .author-card h2 {
    margin: 0 0 0.25rem;
    font-size: 1.4rem;
  }

  .author-card h2 a {
    color: var(--accent);
  }

  .author-card .role {
    margin: 0 0 0.75rem;
    color: var(--muted);
    font-weight: 700;
  }

  .author-card p {
    margin: 0.6rem 0;
  }

  .author-card .profile-link {
    color: var(--accent);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .author-process {
    margin-top: 2.5rem;
    max-width: 72ch;
  }

  .author-process h2 {
    margin-top: 2rem;
  }

  .author-process p {
    color: var(--muted);
    line-height: 1.7;
  }
</style>
