        <text x="270" y="100" fill="#fff" text-anchor="middle" font-size="10" font-weight="bold">-3</text>
        <text x="270" y="140" fill="currentColor" text-anchor="middle" font-size="11">Fr. Guiana</text>
        
        <circle cx="410" cy="95" r="18" fill="#10b981" stroke="#fff" stroke-width="2" />
        <text x="410" y="100" fill="#fff" text-anchor="middle" font-size="11" font-weight="bold">+1/+2</text>
        <text x="410" y="140" fill="#10b981" text-anchor="middle" font-size="11" font-weight="bold">Paris (Metro)</text>
        
        <circle cx="510" cy="95" r="14" fill="#f59e0b" />
        <text x="510" y="100" fill="#fff" text-anchor="middle" font-size="10" font-weight="bold">+4</text>
