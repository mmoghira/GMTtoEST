---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import { siteUrl } from "theme/i18n/config";

const lang = "en";
const dir = "ltr";
const slug = "france-time-zone";
const seoTitle = "France Time Zone Guide: CET, CEST & 12 World Zones (2026)";
const pageDescription = "Comprehensive guide to France Time Zone. Explore Metropolitan France (CET/CEST) and learn why France holds the world record with 12 time zones.";

const pubDate = "2026-07-30T15:00:00+05:00";
const updatedDate = "2026-07-30T15:00:00+05:00";

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "France Time Zone, Paris Time, Central European Time, CET, CEST, France UTC Offset, UTC+1, UTC+2, French Overseas Territories Time Zones, France Daylight Saving Time, France Time Guide",
  image: "/assets/france-time-zone-map.webp",
  imageAlt: "France Time Zone Map Graphic showing Metropolitan and Overseas Territories time zones",
  pubDate,
  updatedDate,
  author: "Jackie Bruce",
  faqs: [
    {
      q: "What time zone does Metropolitan France use?",
      a: "Metropolitan France (the European territory including Paris) uses Central European Time (CET, UTC+1) in winter and Central European Summer Time (CEST, UTC+2) during the summer."
    },
    {
      q: "How many time zones does France have in total?",
      a: "Including all of its overseas departments, collectivities, and territories across the globe, France spans 12 distinct time zones (13 if including its claim in Antarctica), which is the most of any country in the world."
    },
    {
      q: "Why does France hold the record for the most time zones?",
      a: "France holds the global record because of its scattered overseas territories located across the Atlantic, Indian, and Pacific Oceans, as well as South America and the Caribbean."
    },
    {
      q: "Does Metropolitan France observe Daylight Saving Time?",
      a: "Yes. Metropolitan France observes Daylight Saving Time, moving clocks forward 1 hour on the last Sunday of March (from 02:00 CET to 03:00 CEST) and back 1 hour on the last Sunday of October (from 03:00 CEST to 02:00 CET)."
    },
    {
      q: "Do French overseas territories observe Daylight Saving Time?",
      a: "With the exception of Saint Pierre and Miquelon (which follows North American DST rules), none of France's overseas departments or territories observe Daylight Saving Time. They remain on fixed year-round standard offsets."
    },
    {
      q: "What time zone is French Guiana in?",
      a: "French Guiana, located in South America, uses French Guiana Time (GFET, UTC-3) year-round."
    },
    {
      q: "What time zone are Guadeloupe and Martinique in?",
      a: "Guadeloupe, Martinique, Saint Martin, and Saint Barthélemy in the Caribbean operate on Atlantic Standard Time (AST, UTC-4) year-round."
    },
    {
      q: "What time zone is French Polynesia in?",
      a: "French Polynesia spans three distinct time zones: Tahiti & Society Islands (UTC-10), Marquesas Islands (UTC-9:30), and Gambier Islands (UTC-9)."
    },
    {
      q: "What time zone is New Caledonia in?",
      a: "New Caledonia, located in the South Pacific, uses New Caledonia Time (NCT, UTC+11) year-round."
    },
    {
      q: "What time zone is Reunion Island in?",
      a: "Réunion Island in the Indian Ocean uses Réunion Time (RET, UTC+4) year-round."
    },
    {
      q: "What time zone is Mayotte in?",
      a: "Mayotte, an island department in the Indian Ocean off the coast of East Africa, operates on East Africa Time (EAT, UTC+3) year-round."
    },
    {
      q: "Why is Metropolitan France in UTC+1 instead of UTC+0?",
      a: "Geographically, most of Metropolitan France lies in the Greenwich (UTC+0) meridian band. However, during World War II in 1940, German occupation forces aligned French clocks with Berlin Time (UTC+1). After the war, France chose to maintain UTC+1 to harmonize trade with neighboring Central European nations."
    },
    {
      q: "What was the Paris Meridian?",
      a: "Before Greenwich Mean Time was internationally adopted in 1884, France calculated its longitude and national time based on the Paris Meridian, which passes through the Paris Observatory (2°20' E)."
    },
    {
      q: "What is the time difference between Paris and New York?",
      a: "During winter (CET), Paris is 6 hours ahead of New York (EST). During summer (CEST), Paris is 6 hours ahead of New York (EDT). During brief 2-3 week transition periods in March and October, the difference shifts to 5 hours."
    },
    {
      q: "What is the time difference between Paris and London?",
      a: "Paris (CET/CEST) is always 1 hour ahead of London (GMT/BST) year-round."
    },
    {
      q: "What is the IANA time zone identifier for Paris?",
      a: "The primary IANA time zone identifier for Metropolitan France is `Europe/Paris`."
    },
    {
      q: "What is the time difference between Paris and Tokyo?",
      a: "During winter (CET, UTC+1), Tokyo (JST, UTC+9) is 8 hours ahead of Paris. During summer (CEST, UTC+2), Tokyo is 7 hours ahead of Paris."
    },
    {
      q: "What is the time difference between Paris and French Guiana?",
      a: "During winter (CET), Paris is 4 hours ahead of French Guiana (UTC-3). During summer (CEST), Paris is 5 hours ahead of French Guiana."
    },
    {
      q: "What are the stock trading hours in Paris?",
      a: "Euronext Paris operates stock trading sessions from 09:00 to 17:30 CET/CEST, Monday through Friday."
    },
    {
      q: "How should software developers handle timezone data for France?",
      a: "Developers working with users across France and its overseas territories must avoid applying `Europe/Paris` universally. They should map individual territories to their respective IANA identifiers, such as `America/Cayenne`, `Indian/Reunion`, or `Pacific/Tahiti`."
    }
  ]
};

const pageUrlPath = `${siteUrl}/france-time-zone/`;

const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    "@id": `${pageUrlPath}#article`,
    "mainEntityOfPage": pageUrlPath,
    "headline": seoTitle,
    "description": pageDescription,
    "datePublished": pubDate,
    "dateModified": updatedDate,
    "inLanguage": "en",
    "author": {
      "@type": "Person",
      "name": "Jackie Bruce",
      "jobTitle": "Senior Time Zone Analyst",
      "url": `${siteUrl}/author/jackie-bruce/`
    },
    "publisher": {
      "@type": "Organization",
      "name": "GMT to EST Converter",
      "logo": {
        "@type": "ImageObject",
        "url": `${siteUrl}/logo.svg`
      }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "SpeakableSpecification",
    "cssSelector": [".speakable-headline", ".speakable-summary"]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": `${siteUrl}/`
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "France Time Zone Guide",
        "item": pageUrlPath
      }
    ]
  },
  ...["CET", "CEST"].map((zone, idx) => ({
    "@context": "https://schema.org",
    "@type": "DefinedTerm",
    "@id": `${siteUrl}/#zone-fr-${idx}`,
    "name": `${zone} Zone`,
    "description": `Time zone observed in Metropolitan France relative to UTC.`
  }))
];
---

<BaseLayout
  lang={lang}
  dir={dir}
  title={seoTitle}
  description={pageDescription}
  slug={slug}
  meta={meta}
  mode="gmt-est"
  enableFaqSchema={true}
  enableArticleSchema={true}
  allowAds={true}
  breadcrumbHomeLabel="Home"
  breadcrumbLabel="France Time Zone Guide"
  hreflangCodes={["en"]}
>
  <script type="application/ld+json" set:html={JSON.stringify(schemas)} slot="head" />

  <!-- HERO & SUMMARY SECTION -->
  <section class="hero-banner" aria-labelledby="hero-title">
    <h1 id="hero-title" class="hero-banner-title speakable-headline">
      France Time Zone Guide: <span class="gradient-text">CET, CEST &amp; 12 World Zones</span>
    </h1>
  </section>

  <div class="editorial-meta-bar" aria-label="Editorial metadata">
    <span>Last Updated: <strong>July 30, 2026</strong></span>
    <span class="separator" aria-hidden="true">•</span>
    <span>Editorially Reviewed by <a href="/author/jackie-bruce/"><strong>Jackie Bruce</strong></a></span>
    <span class="separator" aria-hidden="true">•</span>
    <span>Data Source: <a href="https://www.obspm.fr" target="_blank" rel="noopener noreferrer"><strong>Observatoire de Paris</strong></a></span>
  </div>

  <section class="acdt-intro content-section" aria-label="Quick Guide Summary">
    <div class="info-callout speakable-summary" style="background: var(--panel); border-left: 4px solid var(--accent); padding: 1.5rem; margin-bottom: 2rem; border-radius: 6px;">
      <h3 style="margin-top: 0;">Quick Summary: What Time Zone is France In?</h3>
      <p>
        <strong>Metropolitan France (including Paris) operates on Central European Time (CET, UTC+1) in winter and Central European Summer Time (CEST, UTC+2) in summer.</strong>
      </p>
      <p>
        However, when counting its overseas departments, collectivities, and territories across the globe, France spans <strong>12 distinct time zones</strong> (ranging from UTC-10 in Tahiti to UTC+12 in Wallis and Futuna). This gives France the world record for the most time zones of any sovereign nation, surpassing Russia and the United States.
      </p>
    </div>

    <div class="reading-meta" style="margin-top: 1rem; color: var(--muted); font-size: 0.9rem;">
      <span>⏱️ Estimated Reading Time: <strong>24 minutes</strong></span>
    </div>
  </section>

  <!-- TABLE OF CONTENTS -->
  <section class="table-of-contents reveal" aria-label="Table of Contents" style="background: var(--panel); padding: 1.5rem; border-radius: 8px; margin: 2rem 0;">
    <span class="toc-kicker" style="font-weight: bold; color: var(--accent); text-transform: uppercase; font-size: 0.85rem;">Detailed Navigation</span>
    <h2 style="margin-top: 0.5rem;">Guide Contents</h2>
    <ol style="line-height: 1.8;">
      <li><a href="#overview-france-metropolitan">1. Overview of Metropolitan France Time Zones</a></li>
      <li><a href="#world-record-12-zones">2. The 12 Time Zones of France (Global Breakdown)</a></li>
      <li><a href="#history-paris-meridian">3. History of Time in France &amp; The Paris Meridian</a></li>
      <li><a href="#daylight-saving-france">4. Daylight Saving Time (CEST) Rules</a></li>
      <li><a href="#overseas-departments-details">5. Overseas Departments &amp; Territories Time Guide</a></li>
      <li><a href="#france-vs-world-table">6. France vs World Time Zones Comparison Table</a></li>
      <li><a href="#business-euronext-paris">7. Scheduling &amp; Financial Markets (Euronext Paris)</a></li>
      <li><a href="#developer-guide-france">8. Developer Guide: Handling French Overseas IANA Codes</a></li>
      <li><a href="#frequently-asked-questions">9. Frequently Asked Questions (20 FAQs)</a></li>
    </ol>
  </section>

