          <td style="padding: 10px; border-bottom: 1px solid var(--line);"><code>Pacific/Tahiti</code></td>
        </tr>
        <tr>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">French Polynesia (Marquesas)</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">UTC-9:30</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);"><code>Pacific/Marquesas</code></td>
        </tr>
        <tr>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">French Polynesia (Gambier)</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">UTC-9</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);"><code>Pacific/Gambier</code></td>
        </tr>
        <tr>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Guadeloupe, Martinique, St Martin</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">UTC-4</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);"><code>America/Guadeloupe</code></td>
        </tr>
        <tr>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">French Guiana, St Pierre &amp; Miquelon</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">UTC-3 (St Pierre observes DST: UTC-2)</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);"><code>America/Cayenne</code></td>
        </tr>
        <tr>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Metropolitan France (Paris)</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">UTC+1 (CEST: UTC+2)</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);"><code>Europe/Paris</code></td>
        </tr>
        <tr>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Mayotte</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">UTC+3</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);"><code>Indian/Mayotte</code></td>
        </tr>
        <tr>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Réunion, Crozet Islands</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">UTC+4</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);"><code>Indian/Reunion</code></td>
