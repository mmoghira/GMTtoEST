          <td style="padding: 10px; border-bottom: 1px solid var(--line);">UTC+11</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);"><code>Pacific/Noumea</code></td>
        </tr>
        <tr>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Wallis and Futuna</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">UTC+12</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);"><code>Pacific/Wallis</code></td>
        </tr>
