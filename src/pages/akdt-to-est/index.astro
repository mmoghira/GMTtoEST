---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import Converter from "theme/components/Converter.astro";
import { getTranslation, pageUrl, siteUrl } from "theme/i18n/config";

const lang = "en";
const dir = "ltr";
const slug = "akdt-to-est";
const t = getTranslation(lang);

const pageTitle = "AKDT to EST Converter";
const seoTitle = "AKDT to EST Converter – Alaska Daylight Time to US Eastern Standard Time";
const pageDescription = "Convert AKDT to EST instantly. Calculate exact time difference between Alaska Daylight Time (UTC-8) and Eastern Standard Time (UTC-5) with live clocks, conversion table, and meeting planner.";

const context = {
  from: "AKDT",
  to: "EST",
  fromZone: "America/Anchorage",
  toZone: "America/New_York"
};

const canonical = `${siteUrl}/akdt-to-est/`;

// 24-hour conversion table data (AKDT → EST = AKDT + 3)
function formatHour12(hour: number) {
  const normalized = ((hour % 24) + 24) % 24;
  const period = normalized < 12 ? "AM" : "PM";
  const displayHour = normalized % 12 || 12;
  return `${displayHour}:00 ${period}`;
}

const conversionRows = Array.from({ length: 24 }, (_, hour) => {
  const estHour = hour + 3;
  const estNormalized = ((estHour % 24) + 24) % 24;
  const nextDay = estHour >= 24;
  const period = estNormalized < 12 ? "AM" : "PM";
  const displayHour = estNormalized % 12 || 12;
  return {
    akdt: formatHour12(hour),
    est: `${displayHour}:00 ${period}${nextDay ? " (+1 day)" : ""}`,
    dayNote: nextDay ? "Next calendar day" : "Same calendar day",
    status: (estNormalized >= 8 && estNormalized < 17) ? "Business Hours" : (estNormalized >= 17 && estNormalized < 22) ? "Evening Hours" : "Night Hours"
  };
});

// Popular conversions
const popularConversions = [
  { akdt: "12:00 AM (Midnight)", est: "3:00 AM EST", note: "Late night in Anchorage and Fairbanks, quiet hours in New York" },
  { akdt: "1:00 AM AKDT", est: "4:00 AM EST", note: "Quiet night across Alaska, pre-dawn in Eastern US" },
  { akdt: "2:00 AM AKDT", est: "5:00 AM EST", note: "Deep night sleeping hours in Alaska, early risers in New York" },
  { akdt: "3:00 AM AKDT", est: "6:00 AM EST", note: "Pre-dawn in Anchorage, morning commute starting in EST" },
  { akdt: "4:00 AM AKDT", est: "7:00 AM EST", note: "Early aviation operations in Alaska, morning in New York" },
  { akdt: "5:00 AM AKDT", est: "8:00 AM EST", note: "Dawn breaking in Juneau, US East Coast offices opening" },
  { akdt: "6:00 AM AKDT", est: "9:00 AM EST", note: "Early risers starting in Anchorage, Wall Street opening bell" },
  { akdt: "7:00 AM AKDT", est: "10:00 AM EST", note: "Alaskan commute window, mid-morning focus on US East Coast" },
  { akdt: "8:00 AM AKDT", est: "11:00 AM EST", note: "Anchorage commercial offices opening, peak US overlap begins" },
  { akdt: "9:00 AM AKDT", est: "12:00 PM (Noon) EST", note: "Morning focus in Alaska, lunchtime in New York and Toronto" },
  { akdt: "10:00 AM AKDT", est: "1:00 PM EST", note: "Mid-morning focus in Juneau, early afternoon session in US" },
  { akdt: "11:00 AM AKDT", est: "2:00 PM EST", note: "Late morning in Anchorage, mid-afternoon in Miami and Boston" },
  { akdt: "12:00 PM (Noon)", est: "3:00 PM EST", note: "Midday lunch break in Alaska, late afternoon in New York" },
  { akdt: "1:00 PM AKDT", est: "4:00 PM EST", note: "Afternoon work session in Fairbanks, US East Coast wrapping up" },
  { akdt: "2:00 PM AKDT", est: "5:00 PM EST", note: "End of standard business day on US East Coast" },
  { akdt: "3:00 PM AKDT", est: "6:00 PM EST", note: "Mid-afternoon focus in Anchorage, evening rush hour in EST" },
  { akdt: "4:00 PM AKDT", est: "7:00 PM EST", note: "Alaskan offices preparing handovers, dinner time in New York" },
  { akdt: "5:00 PM AKDT", est: "8:00 PM EST", note: "End of standard AKDT workday, prime-time television in US" },
  { akdt: "6:00 PM AKDT", est: "9:00 PM EST", note: "Evening relaxation in Anchorage and Juneau" },
  { akdt: "7:00 PM AKDT", est: "10:00 PM EST", note: "Prime-time broadcasting in Alaska, late evening in EST" },
  { akdt: "8:00 PM AKDT", est: "11:00 PM EST", note: "Late evening in Alaska, bedtime in Eastern North America" },
  { akdt: "9:00 PM AKDT", est: "12:00 AM (Midnight) EST", note: "Midnight transition on US East Coast" },
  { akdt: "10:00 PM AKDT", est: "1:00 AM EST (+1 day)", note: "Late night in Anchorage, early hours of next day in EST" },
  { akdt: "11:00 PM AKDT", est: "2:00 AM EST (+1 day)", note: "Midnight in Alaska, quiet night in Eastern US" }
];

// FAQ data
const faqs = [
  {
    q: "What is AKDT?",
    a: "AKDT stands for Alaska Daylight Time. It is the daylight saving time zone observed throughout most of the State of Alaska during summer months, operating at UTC-8 (8 hours behind Coordinated Universal Time)."
