        <td>UTC+0</td>
        <td>Year-Round Baseline</td>
        <td>Greenwich, Accra, Reykjavik</td>
      </tr>
      <tr>
        <td><strong>AKST</strong></td>
        <td>Alaska Standard Time</td>
        <td>UTC-9</td>
        <td>Winter (Nov–Mar)</td>
        <td>Anchorage, Juneau (winter)</td>
      </tr>
    </tbody>
  </table>
