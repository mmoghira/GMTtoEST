      <text x="350" y="87" font-family="'Manrope', sans-serif" font-size="12" fill="#f4fbff">12:00 PM (Noon)</text>
      <text x="600" y="87" font-family="'Manrope', sans-serif" font-size="12" fill="#f4fbff">04:00 PM</text>
      <!-- EST Bar -->
      <rect x="50" y="125" width="600" height="34" fill="#1b536e" rx="4"/>
      <text x="70" y="147" font-family="'Manrope', sans-serif" font-size="12" fill="#36c7b5">EST: 11:00 AM</text>
