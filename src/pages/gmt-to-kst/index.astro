---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import Converter from "theme/components/Converter.astro";
import { getTranslation, pageUrl, siteUrl } from "theme/i18n/config";

const lang = "en";
const dir = "ltr";
const slug = "gmt-to-kst";
const t = getTranslation(lang);

const pageTitle = "GMT to KST Converter";
const seoTitle = "GMT to KST Converter – Greenwich Mean Time to Korea Standard Time";
const pageDescription = "Convert GMT to KST instantly. Calculate the exact time difference between Greenwich Mean Time and Korea Standard Time with live clocks, meeting schedules, and 24-hour conversion charts.";

const context = {
  from: "GMT",
  to: "KST",
  fromZone: "UTC",
  toZone: "Asia/Seoul"
};

const canonical = `${siteUrl}/gmt-to-kst/`;

// 24-hour conversion table data (GMT → KST = GMT + 9 hours)
function formatHour12(hour: number) {
  const normalized = ((hour % 24) + 24) % 24;
  const period = normalized < 12 ? "AM" : "PM";
  const displayHour = normalized % 12 || 12;
  return `${displayHour}:00 ${period}`;
}

const conversionRows = Array.from({ length: 24 }, (_, hour) => {
  const kstHour = hour + 9;
  const kstNormalized = ((kstHour % 24) + 24) % 24;
  const nextDay = kstHour >= 24;
  const period = kstNormalized < 12 ? "AM" : "PM";
  const displayHour = kstNormalized % 12 || 12;
  return {
    gmt: formatHour12(hour),
    kst: `${displayHour}:00 ${period}${nextDay ? " (+1 day)" : ""}`,
    dayNote: nextDay ? "Next day" : "Same day"
  };
});

// Popular conversions
const popularConversions = [
  { gmt: "12:00 AM Midnight GMT", kst: "9:00 AM KST", note: "Midnight in London/UTC coincides with morning office start in Seoul" },
  { gmt: "2:00 AM GMT", kst: "11:00 AM KST", note: "Overnight in the UK/UTC, active mid-morning in South Korea" },
  { gmt: "5:00 AM GMT", kst: "2:00 PM KST", note: "Early morning in GMT, early afternoon business hours across Korea" },
  { gmt: "8:00 AM GMT", kst: "5:00 PM KST", note: "Golden overlap window: European morning coincides with Seoul end of workday" },
  { gmt: "9:00 AM GMT", kst: "6:00 PM KST", note: "GMT business morning aligns with end-of-day handoffs in Korea" },
  { gmt: "10:00 AM GMT", kst: "7:00 PM KST", note: "Mid-morning GMT coincides with early evening in Seoul and Busan" },
  { gmt: "12:00 PM (Noon) GMT", kst: "9:00 PM KST", note: "Lunchtime in GMT zone coincides with prime-time evening in Korea" },
  { gmt: "3:00 PM GMT", kst: "12:00 AM Midnight KST (+1 day)", note: "Mid-afternoon GMT corresponds to midnight transitioning into next day in Korea" },
  { gmt: "6:00 PM GMT", kst: "3:00 AM KST (+1 day)", note: "Evening in GMT corresponds to late-night overnight hours in Seoul" },
  { gmt: "9:00 PM GMT", kst: "6:00 AM KST (+1 day)", note: "Night in GMT coincides with dawn and early wake-ups in South Korea" },
  { gmt: "11:00 PM GMT", kst: "8:00 AM KST (+1 day)", note: "Late evening GMT aligns with morning commute in South Korea on the next day" }
];

// Comprehensive FAQ dataset (25 entries)
const faqs = [
  { q: "What is GMT?", a: "GMT stands for Greenwich Mean Time. It is the solar time reference centered at the Royal Observatory in Greenwich, London, operating at UTC+0 baseline." },
  { q: "What is KST?", a: "KST stands for Korea Standard Time. It is the standard time zone observed throughout the Republic of Korea (South Korea), operating at a constant UTC+9." },
  { q: "How many hours is KST ahead of GMT?", a: "Korea Standard Time (KST, UTC+9) is exactly 9 hours ahead of Greenwich Mean Time (GMT, UTC+0). When it is 12:00 PM GMT, it is 9:00 PM KST." },
  { q: "Does South Korea observe Daylight Saving Time?", a: "No. South Korea does not observe Daylight Saving Time. KST remains fixed at UTC+9 throughout the entire calendar year." },
  { q: "Does GMT change for Daylight Saving Time?", a: "GMT as a pure astronomical standard does not shift. However, countries like the UK move from GMT (UTC+0) to BST (UTC+1) in summer. Pure GMT stays at UTC+0." },
  { q: "Which major Korean cities use Korea Standard Time?", a: "All regions of South Korea operate on KST, including Seoul, Busan, Incheon, Daegu, Daejeon, Gwangju, Ulsan, and Jeju Island." },
  { q: "What is North Korea's time zone relative to KST?", a: "North Korea currently uses Pyongyang Time, which is set to UTC+9, identical to Korea Standard Time." },
  { q: "How do I calculate GMT to KST manually?", a: "To convert GMT to KST, add 9 hours to the GMT time. For instance, 10:00 AM GMT plus 9 hours equals 7:00 PM KST." },
  { q: "What is the best time for a call between London and Seoul?", a: "The best overlap window occurs between 8:00 AM and 10:00 AM GMT, which translates to 5:00 PM to 7:00 PM KST in South Korea." },
  { q: "Does a 9-hour offset cross calendar day boundaries?", a: "Yes. Any GMT time from 3:00 PM GMT (15:00) onwards crosses into the next calendar day in South Korea." },
  { q: "What is 9:00 AM KST in GMT?", a: "9:00 AM KST is equal to 12:00 AM (Midnight) GMT on the exact same calendar day." },
  { q: "What is 3:00 PM GMT in KST?", a: "3:00 PM GMT is equal to 12:00 AM (Midnight) KST on the following calendar day." },
  { q: "What is the IANA database identifier for Korea Standard Time?", a: "The standardized IANA database key for South Korea is 'Asia/Seoul'." },
  { q: "How does KST compare to Japan Standard Time (JST)?", a: "Korea Standard Time (KST, UTC+9) and Japan Standard Time (JST, UTC+9) operate at the exact same offset with zero time difference." },
  { q: "How does KST compare to China Standard Time (CST)?", a: "KST (UTC+9) is exactly 1 hour ahead of China Standard Time (CST, UTC+8). When it is 9:00 PM KST in Seoul, it is 8:00 PM CST in Beijing." },
  { q: "Why did South Korea stop observing Daylight Saving Time?", a: "South Korea briefly observed DST during the 1988 Seoul Olympics to accommodate international broadcasting schedules, but discontinued it shortly after due to public preference and workplace efficiency." },
  { q: "How does K-Pop and gaming event scheduling work for GMT audiences?", a: "Live broadcasts originating in Seoul at 8:00 PM KST air at 11:00 AM GMT, making weekend Korean esports and concert streams convenient for European viewers." },
  { q: "How do financial markets align between London and Seoul?", a: "The Korea Exchange (KRX) operates from 9:00 AM to 3:30 PM KST (12:00 AM to 6:30 AM GMT). London markets open at 8:00 AM GMT (5:00 PM KST), right after KRX closes." },
  { q: "Is KST ever written as UTC+9?", a: "Yes. In technical documentation, API specifications, and international ISO standards, KST is frequently designated as UTC+09:00." },
  { q: "How does flight travel between London and Seoul calculate local time?", a: "A direct flight from London Heathrow (LHR) to Incheon International Airport (ICN) takes around 11 to 12 hours. Departing at 1:00 PM GMT lands around 9:00 AM KST the next day." },
  { q: "How should software databases store GMT to KST timestamps?", a: "All timestamps should be persisted in UTC standard format (`YYYY-MM-DDTHH:mm:ssZ`) and converted to `Asia/Seoul` when rendering for Korean users." },
  { q: "Does Jeju Island use a different time zone than Seoul?", a: "No. The entire territory of South Korea, including Jeju Island and Ulleungdo, observes Korea Standard Time (UTC+9)." },
  { q: "What is the time difference between GMT and Seoul during British summer time?", a: "When the UK moves to British Summer Time (BST, UTC+1), the gap narrows to 8 hours (BST to KST) instead of 9 hours (GMT to KST)." },
  { q: "Can I use this tool to calculate historical dates in Korea?", a: "Yes. Our tool utilizes browser-native IANA engine rules, automatically handling historical calendar adjustments for `Asia/Seoul`." },
  { q: "Why is an automated GMT to KST converter recommended?", a: "An automated converter prevents day-boundary miscalculations when working across a large 9-hour shift where afternoon times in GMT land on tomorrow's date in Seoul." }
];

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "GMT to KST, Greenwich Mean Time to Korea Standard Time, London to Seoul time, convert GMT to KST, South Korea time zone, KST clock, Seoul time converter",
  image: "/assets/gmt-to-kst-og.svg",
  imageAlt: "GMT to KST Time Zone Converter illustration featuring Greenwich and Seoul clocks",
  faqs,
  appDescription: "Free online GMT to KST converter. Convert Greenwich Mean Time (UTC+0) to Korea Standard Time (UTC+9) with real-time clocks and meeting planners.",
  applicationCategory: "UtilityApplication",
  operatingSystem: "Any",
  howToName: "How to Convert GMT to KST",
  howToDescription: "Simple steps for calculating Korea Standard Time from Greenwich Mean Time.",
  howToSteps: [
    { name: "Input GMT Time", text: "Select your desired hour and minute in Greenwich Mean Time." },
    { name: "Add 9 Hours", text: "Recognize that KST operates at UTC+9 year-round with zero DST shift." },
    { name: "Verify Day Boundary", text: "Check if the resulting time advances into the following calendar date (+1 day)." },
    { name: "Schedule Meetings", text: "Utilize the overlap planner to connect European and Korean teams effortlessly." }
  ]
};
---

<BaseLayout
  lang={lang}
  dir={dir}
  title={seoTitle}
  description={pageDescription}
  slug={slug}
  meta={meta}
  mode="gmt-est"
  enableFaqSchema={true}
  allowAds={true}
  breadcrumbHomeLabel="Home"
  breadcrumbLabel="GMT to KST"
  hreflangCodes={["en"]}
>

<!-- HERO BANNER -->
<section class="hero-banner">
  <h1 class="hero-banner-title">
    GMT to KST <span class="gradient-text">Converter</span>
  </h1>
</section>

<!-- FEATURE STRIP -->
<section class="feature-strip" aria-label="Tool Highlights">
  <div class="feature-item">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="feature-icon" aria-hidden="true">
      <circle cx="12" cy="12" r="10"></circle>
      <polyline points="12 6 12 12 16 14"></polyline>
    </svg>
    <span>+9 Hour Offset</span>
  </div>
  <div class="feature-item">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="feature-icon" aria-hidden="true">
      <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
      <circle cx="12" cy="10" r="3"></circle>
