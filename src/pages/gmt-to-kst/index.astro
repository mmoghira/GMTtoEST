        <g transform="translate(60, 48)">
          <circle cx="0" cy="0" r="7" fill="#36c7b5" />
          <text x="0" y="-18" font-family="'Space Grotesk', sans-serif" font-size="10" font-weight="bold" fill="#bdd2dc" text-anchor="middle">12 AM GMT</text>
          <text x="0" y="26" font-family="'Manrope', sans-serif" font-size="10" fill="#8fd7ff" text-anchor="middle">9 AM KST</text>
        </g>
        <g transform="translate(280, 48)">
          <circle cx="0" cy="0" r="7" fill="#36c7b5" />
          <text x="0" y="-18" font-family="'Space Grotesk', sans-serif" font-size="10" font-weight="bold" fill="#bdd2dc" text-anchor="middle">6 AM GMT</text>
          <text x="0" y="26" font-family="'Manrope', sans-serif" font-size="10" fill="#8fd7ff" text-anchor="middle">3 PM KST</text>
        </g>
        <g transform="translate(500, 48)">
          <circle cx="0" cy="0" r="7" fill="#36c7b5" />
          <text x="0" y="-18" font-family="'Space Grotesk', sans-serif" font-size="10" font-weight="bold" fill="#bdd2dc" text-anchor="middle">12 PM GMT</text>
          <text x="0" y="26" font-family="'Manrope', sans-serif" font-size="10" fill="#8fd7ff" text-anchor="middle">9 PM KST</text>
        </g>
