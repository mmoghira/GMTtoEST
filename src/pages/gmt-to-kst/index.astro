  <h2 id="live-clocks-heading">Live Clocks: GMT vs KST</h2>
  <div class="clock-card"><span>Current Greenwich / GMT (UTC+0)</span><strong id="gmtClock">--:--</strong></div>
  <div class="clock-card"><span>Current Seoul / KST (UTC+9)</span><strong id="estClock">--:--</strong><em id="estZone">KST</em></div>
</section>

