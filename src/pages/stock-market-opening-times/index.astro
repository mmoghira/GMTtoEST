---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import { siteUrl } from "theme/i18n/config";
import RelatedConvertersWidget from "theme/components/RelatedConvertersWidget.astro";
import UsersAlsoVisitWidget from "theme/components/UsersAlsoVisitWidget.astro";
import LearnMoreWidget from "theme/components/LearnMoreWidget.astro";
import CountryCityWidget from "theme/components/CountryCityWidget.astro";

const lang = "en";
const dir = "ltr";
const slug = "stock-market-opening-times";
const seoTitle = "Global Stock Market Opening Times: Complete Trading Hours Guide (2026)";
const pageDescription = "Comprehensive guide to global stock market opening and closing times. Compare trading hours for NYSE, NASDAQ, LSE, Euronext, Tokyo, Hong Kong, India, and Sydney in UTC and EST.";

const pubDate = "2026-07-30T10:00:00+05:00";
const updatedDate = "2026-07-30T10:00:00+05:00";

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "Stock Market Opening Times, Global Trading Hours, NYSE Hours EST, LSE Opening Time, Tokyo Stock Exchange Hours, Market Overlap Schedule, Stock Exchange Timezone Chart",
  pubDate,
  updatedDate,
  author: "Jackie Bruce",
  faqs: [
    {
      q: "What are the core trading hours for the New York Stock Exchange (NYSE) and NASDAQ?",
      a: "The NYSE and NASDAQ operate regular equity trading hours from 9:30 AM to 4:00 PM US Eastern Time (EDT/EST), Monday through Friday. Pre-market trading runs from 4:00 AM to 9:30 AM EST, and after-hours trading extends from 4:00 PM to 8:00 PM EST."
    },
    {
      q: "What are the trading hours for the London Stock Exchange (LSE)?",
      a: "The London Stock Exchange opens regular trading at 8:00 AM and closes at 4:30 PM local London time (GMT/BST). In US Eastern Time (EDT), this corresponds to 3:00 AM to 11:30 AM."
    },
    {
      q: "What are the trading hours for the Tokyo Stock Exchange (TSE)?",
      a: "The Tokyo Stock Exchange operates two daily sessions: a Morning Session from 9:00 AM to 11:30 AM JST, and an Afternoon Session from 12:30 PM to 3:00 PM JST. In US Eastern Time (EDT), this corresponds to 8:00 PM to 2:00 AM (the previous evening)."
    },
    {
      q: "What are the trading hours for Euronext Paris, Amsterdam, and Frankfurt (Xetra)?",
      a: "Major European exchanges operate from 9:00 AM to 5:30 PM Central European Time (CET/CEST). In US Eastern Time (EDT), this corresponds to 3:00 AM to 11:30 AM."
    },
    {
      q: "What are the trading hours for the Hong Kong Stock Exchange (HKEX)?",
      a: "The HKEX operates a Morning Session from 9:30 AM to 12:00 PM HKT and an Afternoon Session from 1:00 PM to 4:00 PM HKT (9:30 PM to 4:00 AM EDT)."
    },
    {
      q: "What are the trading hours for India's BSE and NSE exchanges in Mumbai?",
      a: "The Bombay Stock Exchange (BSE) and National Stock Exchange of India (NSE) operate from 9:15 AM to 3:30 PM IST (11:45 PM to 6:00 AM EDT)."
    },
    {
      q: "What are the trading hours for the Australian Securities Exchange (ASX)?",
      a: "The ASX in Sydney operates from 10:00 AM to 4:00 PM AEST/AEDT (8:00 PM to 2:00 AM EDT previous day during AEDT)."
    },
    {
      q: "Which major stock markets overlap during the global trading day?",
      a: "The London Stock Exchange (LSE) overlaps with the NYSE and NASDAQ between 9:30 AM and 11:30 AM US Eastern Time (2:30 PM to 4:30 PM BST). Asian markets (Tokyo, Hong Kong, Singapore) overlap extensively with each other between 9:30 AM and 3:00 PM JST/SST."
    },
    {
      q: "How does Daylight Saving Time affect global stock market alignment?",
      a: "Because North America and Europe switch to and from DST on different dates in March and October, market overlap windows contract or expand by 1 hour during the 2-week gap."
    },
    {
      q: "Is any stock market open 24 hours a day?",
      a: "Traditional equity exchanges close on weekends and overnight. However, cryptocurrency markets run 24/7/365, and foreign exchange (Forex) markets trade continuously from Sunday 5:00 PM EST to Friday 5:00 PM EST."
    },
    {
      q: "What is the 'Lunch Break' trading pause in Asian stock exchanges?",
      a: "Exchanges in Japan (TSE), Hong Kong (HKEX), and Mainland China (SSE/SZSE) pause trading for 1 to 1.5 hours around midday for lunch settlement, unlike US and European exchanges which trade continuously through lunch."
    },
    {
      q: "What are the trading hours for the Singapore Exchange (SGX)?",
      a: "The SGX operates continuous equity trading from 9:00 AM to 5:00 PM SST (9:00 PM to 5:00 AM EDT)."
    },
    {
      q: "What is the Chicago Mercantile Exchange (CME Group) futures trading schedule?",
      a: "CME Globex electronic futures trade virtually 24 hours a day, from Sunday 6:00 PM EST to Friday 5:00 PM EST, with a brief daily 45-minute maintenance pause at 5:00 PM EST."
    },
    {
      q: "What are the trading hours for the Dubai Financial Market (DFM)?",
      a: "The DFM and Nasdaq Dubai trade from 10:00 AM to 3:00 PM GST (2:00 AM to 7:00 AM EDT)."
    },
    {
      q: "How do algorithmic traders handle timezone data across global exchanges?",
      a: "Algorithmic execution systems ingest exchange feeds in UTC nanosecond timestamps, converting to local market exchange codes (e.g. XNYS, XLON, XTKO) using IANA zone definitions."
    },
    {
      q: "What is the impact of market opening bell volatility?",
      a: "The first 30 minutes after an exchange opens (e.g. 9:30 AM – 10:00 AM EST on NYSE) experiences peak liquidity and price volatility as overnight news is priced in."
    },
    {
      q: "How do bank holidays affect cross-market correlation?",
      a: "When US markets are closed for holidays (e.g. Thanksgiving or Independence Day), trading volume on European exchanges drops significantly during late afternoon sessions due to absent US institutional liquidity."
    },
    {
      q: "What are the trading hours for the Toronto Stock Exchange (TSX)?",
      a: "The TSX operates on identical hours as the NYSE: 9:30 AM to 4:00 PM Eastern Time."
    },
    {
      q: "What is the best reference tool for verifying global market opening times?",
      a: "Dedicated timezone conversion utilities like <a href='/gmt-to-est/'>GMT to EST Converter</a> and exchange schedule portals provide real-time status."
    },
    {
      q: "How do global investors trade foreign equities outside local market hours?",
      a: "Investors trade American Depositary Receipts (ADRs) on US exchanges or utilize cross-listed dual shares on international exchanges during local market hours."
    }
  ]
};

const pageUrlPath = `${siteUrl}/stock-market-opening-times/`;

const pageSchema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${pageUrlPath}#webpage`,
    "url": pageUrlPath,
    "name": seoTitle,
    "description": pageDescription,
    "inLanguage": lang,
    "isPartOf": { "@id": `${siteUrl}/#website` }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${pageUrlPath}#breadcrumb`,
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteUrl}/` },
      { "@type": "ListItem", "position": 2, "name": "Stock Market Opening Times", "item": pageUrlPath }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "@id": `${pageUrlPath}#article`,
    "headline": seoTitle,
    "description": pageDescription,
    "datePublished": pubDate,
    "dateModified": updatedDate,
    "author": { "@type": "Person", "name": meta.author },
    "publisher": { "@type": "Organization", "name": "GMT to EST Converter", "url": siteUrl },
    "mainEntityOfPage": pageUrlPath
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${pageUrlPath}#faq`,
    "mainEntity": meta.faqs.map(faq => ({
      "@type": "Question",
      "name": faq.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.a
      }
    }))
  }
];
---

<BaseLayout lang={lang} dir={dir} title={seoTitle} description={pageDescription} slug={slug} meta={meta} enableFaqSchema={true}>
  <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} slot="head" />

  <div class="container content-wrapper">
    <header class="page-header">
      <h1>Global Stock Market Opening Times: Complete Trading Hours Guide (2026)</h1>
      <div class="reading-meta">
        <span><strong>Author:</strong> {meta.author}</span> | 
        <span><strong>Last Updated:</strong> July 30, 2026</span> | 
        <span><strong>Reading Time:</strong> 17 mins</span>
      </div>
    </header>

    <!-- Top Answer Summary Box -->
    <div class="summary-box">
      <h2>Quick Summary: Global Exchange Opening Hours Grid</h2>
      <div class="summary-grid">
        <div class="summary-item">
          <strong>NYSE / NASDAQ (New York):</strong> 9:30 AM – 4:00 PM EDT (13:30 – 20:00 UTC)
        </div>
        <div class="summary-item">
          <strong>LSE (London):</strong> 8:00 AM – 4:30 PM BST (07:00 – 15:30 UTC / 3:00 AM – 11:30 AM EDT)
        </div>
        <div class="summary-item">
          <strong>Euronext (Paris/Frankfurt):</strong> 9:00 AM – 5:30 PM CEST (07:00 – 15:30 UTC / 3:00 AM – 11:30 AM EDT)
        </div>
        <div class="summary-item">
          <strong>TSE (Tokyo):</strong> 9:00 AM – 3:00 PM JST (00:00 – 06:00 UTC / 8:00 PM – 2:00 AM EDT Prev. Day)
        </div>
        <div class="summary-item">
          <strong>HKEX (Hong Kong):</strong> 9:30 AM – 4:00 PM HKT (01:30 – 08:00 UTC / 9:30 PM – 4:00 AM EDT Prev. Day)
        </div>
        <div class="summary-item">
          <strong>Peak Transatlantic Overlap:</strong> 9:30 AM – 11:30 AM EDT (NYSE & LSE open simultaneously)
        </div>
      </div>
    </div>

    <section class="content-section">
      <h2>Understanding Global Financial Trading Schedules</h2>
      <p>
        In global finance, capital flows continuously across time zones. As equity exchanges close in Asia, European bourses open their trading desks, followed by North American financial markets in <a href="/new-york-time/">New York</a> and <a href="/chicago-time/">Chicago</a>.
      </p>
      <p>
        For equity investors, quantitative traders, derivative hedge funds, and portfolio managers, tracking stock market opening times in local time, <a href="/what-is-utc/">UTC</a>, and US Eastern Time (<a href="/blog/what-is-est/">EDT/EST</a>) is essential for executing orders, hedging positions, and managing cross-market volatility.
      </p>
      <p>
        This master guide details regular trading hours, lunch pauses, pre-market/after-hours sessions, and overlap windows for the world's top financial exchanges.
      </p>

      <div class="info-callout">
        <h3>Key Concept: Peak Transatlantic Overlap</h3>
        <p>
          The most liquid 2-hour window in global equity markets occurs between <strong>9:30 AM and 11:30 AM US Eastern Time</strong>. During this window, the New York Stock Exchange, NASDAQ, London Stock Exchange, and Euronext Paris are all open concurrently.
        </p>
      </div>
    </section>

    <!-- Visual SVG Diagram 1 -->
    <section class="content-section">
      <h2>Global Financial Market Overlap Visual Diagram</h2>
      <div class="svg-diagram-container">
        <svg viewBox="0 0 800 360" width="100%" height="auto" xmlns="http://www.w3.org/2000/svg" aria-label="Global Financial Market Overlap Diagram">
          <rect width="800" height="360" fill="var(--panel)" rx="12" stroke="var(--line)" stroke-width="2"/>
          <text x="400" y="38" fill="var(--accent)" font-family="Space Grotesk, sans-serif" font-size="20" font-weight="bold" text-anchor="middle">24-Hour Global Equity Market Sequence (UTC Baseline)</text>

          <!-- Tokyo Row -->
          <text x="120" y="90" fill="var(--text)" font-size="13" font-weight="bold">Tokyo (TSE)</text>
          <rect x="100" y="75" width="200" height="22" fill="#36c7b5" rx="4"/>
          <text x="200" y="91" fill="#0c354a" font-size="11" font-weight="bold" text-anchor="middle">00:00 - 06:00 UTC</text>

          <!-- Hong Kong Row -->
          <text x="120" y="140" fill="var(--text)" font-size="13" font-weight="bold">Hong Kong (HKEX)</text>
          <rect x="140" y="125" width="220" height="22" fill="#36c7b5" rx="4"/>
          <text x="250" y="141" fill="#0c354a" font-size="11" font-weight="bold" text-anchor="middle">01:30 - 08:00 UTC</text>

          <!-- London Row -->
          <text x="120" y="190" fill="var(--text)" font-size="13" font-weight="bold">London (LSE)</text>
          <rect x="320" y="175" width="260" height="22" fill="#8fd7ff" rx="4"/>
          <text x="450" y="191" fill="#0c354a" font-size="11" font-weight="bold" text-anchor="middle">07:00 - 15:30 UTC</text>

          <!-- New York Row -->
          <text x="120" y="240" fill="var(--text)" font-size="13" font-weight="bold">New York (NYSE)</text>
          <rect x="520" y="225" width="220" height="22" fill="#ffd166" rx="4"/>
          <text x="630" y="241" fill="#0c354a" font-size="11" font-weight="bold" text-anchor="middle">13:30 - 20:00 UTC</text>

          <!-- Highlight Line -->
          <line x1="520" y1="60" x2="520" y2="280" stroke="var(--accent)" stroke-width="2" stroke-dasharray="4 4"/>
          <text x="520" y="305" fill="var(--accent)" font-size="12" font-weight="bold" text-anchor="middle">13:30 UTC: NYSE Opens / LSE Active</text>
        </svg>
      </div>
    </section>

    <section class="content-section">
      <h2>Master Table: Major Global Stock Exchange Hours</h2>
      <div class="table-responsive">
        <table class="comparison-table">
          <thead>
            <tr>
              <th>Exchange & Location</th>
              <th>Local Trading Hours</th>
              <th>UTC Equivalent Hours</th>
              <th>US Eastern Time (EDT) Equivalent</th>
              <th>Lunch Break?</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>NYSE / NASDAQ</strong> (New York)</td>
              <td>9:30 AM – 4:00 PM EDT</td>
              <td>13:30 – 20:00 UTC</td>
              <td>9:30 AM – 4:00 PM EDT</td>
              <td>None</td>
            </tr>
            <tr>
              <td><strong>London Stock Exchange</strong> (London)</td>
              <td>8:00 AM – 4:30 PM BST</td>
              <td>07:00 – 15:30 UTC</td>
              <td>3:00 AM – 11:30 AM EDT</td>
              <td>None</td>
            </tr>
            <tr>
              <td><strong>Euronext Paris / Frankfurt</strong> (EU)</td>
              <td>9:00 AM – 5:30 PM CEST</td>
              <td>07:00 – 15:30 UTC</td>
              <td>3:00 AM – 11:30 AM EDT</td>
              <td>None</td>
            </tr>
            <tr>
              <td><strong>Tokyo Stock Exchange</strong> (Tokyo)</td>
              <td>9:00 AM – 3:00 PM JST</td>
              <td>00:00 – 06:00 UTC</td>
              <td>8:00 PM – 2:00 AM EDT (Prev. Day)</td>
              <td>11:30 AM – 12:30 PM JST</td>
            </tr>
            <tr>
              <td><strong>Hong Kong Exchange</strong> (Hong Kong)</td>
              <td>9:30 AM – 4:00 PM HKT</td>
              <td>01:30 – 08:00 UTC</td>
              <td>9:30 PM – 4:00 AM EDT (Prev. Day)</td>
              <td>12:00 PM – 1:00 PM HKT</td>
            </tr>
            <tr>
              <td><strong>BSE / NSE</strong> (Mumbai, India)</td>
              <td>9:15 AM – 3:30 PM IST</td>
              <td>03:45 – 10:00 UTC</td>
              <td>11:45 PM – 6:00 AM EDT (Prev. Day)</td>
              <td>None</td>
            </tr>
            <tr>
              <td><strong>Singapore Exchange</strong> (Singapore)</td>
              <td>9:00 AM – 5:00 PM SST</td>
              <td>01:00 – 09:00 UTC</td>
              <td>9:00 PM – 5:00 AM EDT (Prev. Day)</td>
              <td>None</td>
            </tr>
            <tr>
              <td><strong>Australian Securities Exchange</strong> (Sydney)</td>
              <td>10:00 AM – 4:00 PM AEDT</td>
              <td>23:00 – 05:00 UTC</td>
              <td>7:00 PM – 1:00 AM EDT (Prev. Day)</td>
              <td>None</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="content-section">
      <h2>Extended Trading Sessions: Pre-Market & After-Hours</h2>
      <p>
        US equity markets offer extended electronic trading outside of standard 9:30 AM – 4:00 PM EDT hours:
      </p>
      <ul>
        <li><strong>Pre-Market Trading:</strong> Runs from 4:00 AM to 9:30 AM EDT. Institutional investors and retail brokers trade corporate earnings announcements released before the opening bell.</li>
        <li><strong>Regular Trading Session:</strong> Runs from 9:30 AM to 4:00 PM EDT with peak liquidity and narrow bid-ask spreads.</li>
        <li><strong>After-Hours Trading:</strong> Runs from 4:00 PM to 8:00 PM EDT. Handles major earnings reports released immediately after the closing bell (e.g. Apple, Microsoft, Amazon earnings).</li>
      </ul>

      <div class="tip-box">
        <h3>Pro Trader Scheduling Insight</h3>
        <p>
          Pre-market trading in New York (starting at 4:00 AM EDT) overlaps directly with the European morning session in London (9:00 AM BST), providing a catalyst for early cross-border price discovery.
        </p>
      </div>
    </section>

    <!-- Visual SVG Diagram 2 -->
    <section class="content-section">
      <h2>US Extended Trading Session Breakdown</h2>
      <div class="svg-diagram-container">
        <svg viewBox="0 0 800 240" width="100%" height="auto" xmlns="http://www.w3.org/2000/svg" aria-label="US Extended Trading Sessions Diagram">
          <rect width="800" height="240" fill="var(--panel)" rx="12" stroke="var(--line)" stroke-width="2"/>
          <text x="400" y="35" fill="var(--accent)" font-family="Space Grotesk, sans-serif" font-size="18" font-weight="bold" text-anchor="middle">US Equity Market 16-Hour Daily Trading Session Structure (EDT)</text>

          <!-- Pre-Market -->
          <rect x="60" y="75" width="220" height="110" fill="var(--bg)" rx="8" stroke="var(--line)"/>
          <text x="170" y="105" fill="#8fd7ff" font-weight="bold" font-size="14" text-anchor="middle">Pre-Market Session</text>
          <text x="170" y="130" fill="var(--text)" font-size="12" text-anchor="middle">4:00 AM – 9:30 AM EDT</text>
          <text x="170" y="155" fill="var(--muted)" font-size="11" text-anchor="middle">Earnings Releases & EU Overlap</text>

          <!-- Regular Session -->
          <rect x="290" y="75" width="220" height="110" fill="var(--bg)" rx="8" stroke="var(--accent)" stroke-width="2"/>
          <text x="400" y="105" fill="#36c7b5" font-weight="bold" font-size="14" text-anchor="middle">Regular Market Hours</text>
          <text x="400" y="130" fill="var(--text)" font-size="12" font-weight="bold" text-anchor="middle">9:30 AM – 4:00 PM EDT</text>
          <text x="400" y="155" fill="var(--muted)" font-size="11" text-anchor="middle">Peak Liquidity & High Volume</text>

          <!-- After Hours -->
          <rect x="520" y="75" width="220" height="110" fill="var(--bg)" rx="8" stroke="var(--line)"/>
          <text x="630" y="105" fill="#ffd166" font-weight="bold" font-size="14" text-anchor="middle">After-Hours Session</text>
          <text x="630" y="130" fill="var(--text)" font-size="12" text-anchor="middle">4:00 PM – 8:00 PM EDT</text>
          <text x="630" y="155" fill="var(--muted)" font-size="11" text-anchor="middle">Post-Bell Earnings Reactions</text>
        </svg>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="content-section faq-section">
      <h2>Frequently Asked Questions About Global Stock Market Hours</h2>
      <div class="faq-list">
        {meta.faqs.map((faq) => (
          <details class="faq-item">
            <summary class="faq-question">{faq.q}</summary>
            <div class="faq-answer">
              <p>{faq.a}</p>
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- Widgets Section -->
    <RelatedConvertersWidget slug={slug} />
    <UsersAlsoVisitWidget slug={slug} />
    <LearnMoreWidget slug={slug} />
    <CountryCityWidget slug={slug} />
  </div>
</BaseLayout>

<style>
  .content-wrapper {
    padding-top: 2rem;
    padding-bottom: 4rem;
    max-width: 1100px;
    margin: 0 auto;
  }
  .page-header h1 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 2.3rem;
    color: var(--text);
    margin-bottom: 0.5rem;
  }
  .reading-meta {
    font-size: 0.9rem;
    color: var(--muted);
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }
  .summary-box {
    background: var(--panel);
    border: 2px solid var(--accent);
    border-radius: 12px;
    padding: 1.8rem;
    margin-bottom: 2.5rem;
  }
  .summary-box h2 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.4rem;
    color: var(--accent);
    margin-top: 0;
    margin-bottom: 1.2rem;
  }
  .summary-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }
  .summary-item {
    background: var(--bg);
    padding: 0.9rem 1.1rem;
    border-radius: 8px;
    border: 1px solid var(--line);
    font-size: 0.95rem;
  }
  .summary-item strong {
    display: block;
    color: var(--accent-2);
    margin-bottom: 0.25rem;
  }
  .content-section {
    margin-bottom: 3rem;
  }
  .content-section h2 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.7rem;
    color: var(--text);
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.4rem;
  }
  .content-section p {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--muted);
    margin-bottom: 1.2rem;
  }
  .info-callout, .tip-box {
    background: var(--panel);
    border-left: 4px solid var(--accent);
    padding: 1.3rem 1.6rem;
    border-radius: 6px;
    margin: 1.8rem 0;
  }
  .info-callout h3, .tip-box h3 {
    margin-top: 0;
    font-family: 'Space Grotesk', sans-serif;
    color: var(--accent);
    font-size: 1.2rem;
  }
  .svg-diagram-container {
    margin: 2rem 0;
    background: var(--bg);
    padding: 1rem;
    border-radius: 12px;
    border: 1px solid var(--line);
  }
  .table-responsive {
    overflow-x: auto;
    margin: 1.8rem 0;
  }
  .comparison-table {
    width: 100%;
    border-collapse: collapse;
    background: var(--panel);
    border-radius: 8px;
    overflow: hidden;
  }
  .comparison-table th, .comparison-table td {
    padding: 1rem;
    text-align: left;
    border-bottom: 1px solid var(--line);
    font-size: 0.95rem;
  }
  .comparison-table th {
    background: var(--bg);
    color: var(--accent-2);
    font-family: 'Space Grotesk', sans-serif;
  }
  .styled-list {
    margin: 1.5rem 0;
    padding-left: 1.5rem;
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.8;
  }
  .faq-section details {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
    margin-bottom: 1rem;
    padding: 1rem 1.2rem;
  }
  .faq-section summary {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--text);
    cursor: pointer;
  }
  .faq-answer {
    padding-top: 0.8rem;
    border-top: 1px solid var(--line);
    margin-top: 0.8rem;
  }
</style>
