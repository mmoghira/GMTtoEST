---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import Converter from "theme/components/Converter.astro";
import { getLang, getTranslation, getPageMeta } from "theme/i18n/config";

const lang = "en";
const dir = "ltr";
const slug = "gmt-to-met";
const t = getTranslation(lang);
const meta = getPageMeta(lang, "gmtToMet");

const seoTitle = "GMT to MET Converter – Convert GMT to Middle European Time";
const pageDescription = "Convert GMT to MET instantly. Access the 24-hour conversion chart, check DST changes between GMT and Europe, and plan meetings with our calculator.";

const context = {
  from: "GMT",
  to: "MET",
  fromZone: "UTC",
  toZone: "Europe/Berlin"
};

const canonical = "https://gmttoestconverter.com/gmt-to-met/";

// Helper to format 12-hour values
function formatHour12(hour: number, minute: number = 0) {
  const normalized = ((hour % 24) + 24) % 24;
  const period = normalized < 12 ? "AM" : "PM";
  const displayHour = normalized % 12 || 12;
  return `${displayHour}:${String(minute).padStart(2, "0")} ${period}`;
}

// Generate the 24-hour comparative table rows (MET = GMT + 1, MEST = GMT + 2)
const conversionRows = Array.from({ length: 24 }, (_, hour) => {
  const metHour = (hour + 1) % 24;
  const metDayDiff = (hour + 1) >= 24 ? "Next day" : "Same day";

  const mestHour = (hour + 2) % 24;
  const mestDayDiff = (hour + 2) >= 24 ? "Next day" : "Same day";

  return {
    gmt: formatHour12(hour),
    met: `${formatHour12(metHour)} MET (${metDayDiff})`,
    mest: `${formatHour12(mestHour)} MEST (${mestDayDiff})`,
    offset: "GMT is UTC+0 | MET is UTC+1 / MEST is UTC+2",
    notes: `Winter gap: 1h (MET). Summer gap: 2h (MEST relative to GMT baseline).`
  };
});

// JSON-LD Schema definitions
const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "GMT to MET Converter",
    "applicationCategory": "UtilitiesApplication",
    "operatingSystem": "Any",
    "url": canonical,
    "description": "Free online GMT to MET converter with real-time clocks, DST-aware calculations, and Europe timezone guidelines."
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is MET?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "MET stands for Middle European Time. It operates at a UTC+1 offset during the winter months, serving as the standard timezone for Central European countries."
        }
      },
      {
        "@type": "Question",
        "name": "What does MET stand for?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "MET stands for Middle European Time, the designation for the timezone equivalent to Central European Time (CET, UTC+1) used in winter."
        }
      },
      {
        "@type": "Question",
        "name": "Is MET the same as CET?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Middle European Time (MET) and Central European Time (CET) both refer to the same timezone offset of UTC+1 used during the standard winter period."
        }
      },
      {
        "@type": "Question",
        "name": "Does MET observe daylight saving time?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. During the summer, standard MET regions switch to Middle European Summer Time (MEST) or Central European Summer Time (CEST), shifting from UTC+1 to UTC+2."
        }
      },
      {
        "@type": "Question",
        "name": "What is the difference between MET and CEST?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "MET is standard winter time (UTC+1), while CEST (Central European Summer Time) is summer daylight saving time (UTC+2). Clocks shift forward one hour in spring."
        }
      },
      {
        "@type": "Question",
        "name": "How many hours ahead is MET?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "MET (standard winter time) is exactly 1 hour ahead of Greenwich Mean Time (GMT). In summer, when Europe switches to CEST (UTC+2), the difference relative to GMT (UTC+0) becomes 2 hours."
        }
      },
      {
        "@type": "Question",
        "name": "Which countries use MET?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Countries observing MET standard or equivalent include Germany, France, Italy, Spain, Poland, Austria, Switzerland, Belgium, Netherlands, and Luxembourg."
        }
      },
      {
        "@type": "Question",
        "name": "Which cities use MET?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Major cities observing MET in winter include Berlin, Vienna, Zurich, Amsterdam, Brussels, Paris, Rome, Madrid, Warsaw, and Luxembourg City."
        }
      },
      {
        "@type": "Question",
        "name": "Can I convert future dates?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Our converter is date-aware, meaning it checks the selected date to automatically apply the 1-hour winter gap (MET) or the 2-hour summer gap (MEST) depending on active transitions."
        }
      },
      {
        "@type": "Question",
        "name": "Does this converter account for DST?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. The tool automatically detects daylight saving transitions in both the source and target regions, maintaining accurate real-world coordination."
        }
      },
      {
        "@type": "Question",
        "name": "Can I use this converter for business meetings?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, it is designed to help corporate coordinators, remote workers, and software teams align business schedules across European regions."
        }
      },
      {
        "@type": "Question",
        "name": "Is this converter accurate?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, our converter is synchronized with the IANA Time Zone Database, providing offsets that account for regional clock adjustments."
        }
      },
      {
        "@type": "Question",
        "name": "Can I use it for travel?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, it is helpful for planning travel itineraries, flight schedules, and train transfers throughout continental Europe."
        }
      },
      {
        "@type": "Question",
        "name": "Can I bookmark this page?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, you can bookmark this page (/gmt-to-met/) for quick access to live clocks, comparative charts, meeting planners, and seasonal offset rules."
        }
      },
      {
        "@type": "Question",
        "name": "Is this converter free?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, our GMT to MET converter is completely free to use with no registrations, limits, or subscriptions required."
        }
      },
      {
        "@type": "Question",
        "name": "What is the difference between GMT and UTC?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "GMT is a solar-based astronomical timezone, while UTC is an atomic-based scientific standard. For civil timekeeping, they share the same base offset (+0)."
        }
      },
      {
        "@type": "Question",
        "name": "What is MET vs CET?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Middle European Time (MET) and Central European Time (CET) refer to the same winter timezone offset of UTC+1."
        }
      },
      {
        "@type": "Question",
        "name": "What is MET vs CEST?",
        "acceptedAnswer": {
          "@type": "Answer",
