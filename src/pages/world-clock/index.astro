---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import RelatedConvertersWidget from "theme/components/RelatedConvertersWidget.astro";
import LearnMoreWidget from "theme/components/LearnMoreWidget.astro";

const lang = "en";
const dir = "ltr";
const slug = "world-clock";
const seoTitle = "Global World Clock — Real-Time Live Clocks for 50+ Cities";
const pageDescription = "Track current live local times across 50+ global cities with our interactive World Clock tool. Search, filter by continent, save favorite time zones, and inspect UTC offsets.";

const pubDate = "2026-07-31T00:00:00+05:00";
const updatedDate = "2026-07-31T00:00:00+05:00";

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "world clock, live world clock, current time around the world, global time zones, city clocks, local time finder, UTC offset clock, day night status",
  pubDate,
  updatedDate,
  author: "Time Intelligence Team",
  faqs: [
    {
      q: "What is a World Clock and how does it work?",
      a: "A World Clock is an interactive digital utility that displays live local times for multiple cities across global time zones simultaneously. It uses standard UTC offsets and local timezone rules to calculate real-time hours, minutes, and seconds."
    },
    {
      q: "How does the live world clock account for Daylight Saving Time (DST)?",
      a: "The tool leverages native browser time zone APIs (`Intl.DateTimeFormat`) configured with standard IANA time zone identifiers (such as `America/New_York` or `Europe/London`). This ensures DST adjustments occur automatically based on official local transition rules."
    },
    {
      q: "Can I filter cities by continent?",
      a: "Yes. You can toggle between continent categories including North America, South America, Europe, Asia, Africa, and Oceania, or view all cities in a single unified view."
    },
    {
      q: "How do I save my favorite cities?",
      a: "Click the star icon on any city card to add it to your Favorites. Saved cities are automatically pinned to the top of your dashboard and persisted in your browser's `localStorage`."
    },
    {
      q: "Does the world clock support 24-hour military time?",
      a: "Yes! Use the 12h / 24h toggle switch at the top of the interface to instantly convert all displayed city clocks between standard AM/PM format and 24-hour military time."
    },
    {
      q: "What is Coordinated Universal Time (UTC)?",
      a: "Coordinated Universal Time (UTC) is the primary time standard by which the world regulates clocks and time. Time zones are defined as positive or negative offsets from UTC (e.g., UTC-5 for Eastern Standard Time)."
    },
    {
      q: "Why is Greenwich Mean Time (GMT) sometimes used interchangeably with UTC?",
      a: "GMT is a time zone based on solar time at the Royal Observatory in Greenwich, London. UTC is an atomic clock time standard. While they share the same zero-offset time during winter in the UK, UTC is the modern scientific standard."
    },
    {
      q: "How many time zones exist worldwide?",
      a: "There are 24 primary nautical time zones spaced at 15-degree longitude intervals. However, due to political boundaries, fractional offsets (such as India's UTC+5:30), and seasonal DST shifts, over 38 time zones are in active global use."
    },
    {
      q: "What is the day/night badge indicator on each clock?",
      a: "The day/night indicator displays a sun icon for local daytime (06:00 AM to 05:59 PM) and a moon icon for local nighttime (06:00 PM to 05:59 AM) based on each city's live local time."
    },
    {
      q: "How can I search for a specific city or country?",
      a: "Type the name of the city, country, or timezone abbreviation (e.g., 'Tokyo', 'Japan', or 'JST') into the live search bar to instantly filter the displayed clocks."
    },
    {
      q: "Why do some countries have half-hour or 45-minute offsets?",
      a: "Certain nations, such as India (UTC+5:30), Iran (UTC+3:30), and Nepal (UTC+5:45), established fractional offsets to better align solar noon with human activity across their geographic terrain."
    },
    {
      q: "Does the tool run accurately on mobile devices?",
      a: "Yes. The tool is fully responsive and optimized for mobile, tablet, and desktop screens with real-time ticking rendered efficiently via JavaScript request animation loops."
    },
    {
      q: "How do aviation and maritime industries use world clocks?",
      a: "Aviation and shipping operators rely on UTC (often referred to as Zebra time or Z-time) to coordinate flight paths, sea routes, and radio schedules across international boundaries without local time confusion."
    },
    {
      q: "What happens when I cross the International Date Line?",
      a: "Crossing the International Date Line (180° longitude) shifts the calendar date forward by 24 hours when traveling west, or backward by 24 hours when traveling east, while the clock time minutes remain synchronized."
    },
    {
      q: "Can I use the world clock to plan international meetings?",
      a: "Yes! The world clock lets you quickly compare current times across team locations. For visual matrix planning, you can also use our dedicated <a href=\"/meeting-planner\">Meeting Planner</a> tool."
    },
    {
      q: "How does daylight saving time affect global time differences?",
      a: "Because northern and southern hemispheres observe DST in opposite months—and many tropical nations do not observe DST at all—the hour gap between two cities can shift twice a year."
    },
    {
      q: "How can developers programmatically fetch live time zone data in JavaScript?",
      a: "Developers can utilize the standard JavaScript `Intl.DateTimeFormat` API with `timeZone` parameters or standard date formatting libraries to calculate offset differences."
    },
    {
      q: "Is there any cost or registration required to use this tool?",
      a: "No. The Global World Clock tool is 100% free with no registration, subscription, or software installation required."
    }
  ]
};
