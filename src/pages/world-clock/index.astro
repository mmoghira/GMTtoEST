    const favoritesGrid = document.getElementById("favorites-grid");
    const favoritesContainer = document.getElementById("favorites-container");
    const filterBtns = document.querySelectorAll(".btn-filter");

    formatToggleBtn.addEventListener("click", () => {
      is24Hour = !is24Hour;
      formatToggleBtn.textContent = is24Hour ? "24H" : "12H";
      renderClocks();
    });

    searchInput.addEventListener("input", (e) => {
      searchQuery = e.target.value.toLowerCase();
      renderClocks();
    });

    filterBtns.forEach(btn => {
      btn.addEventListener("click", () => {
        filterBtns.forEach(b => b.classList.remove("active"));
        btn.classList.add("active");
        currentContinent = btn.getAttribute("data-continent") || "all";
        renderClocks();
      });
    });

    function toggleFavorite(cityName) {
      if (favorites.includes(cityName)) {
        favorites = favorites.filter(f => f !== cityName);
      } else {
        favorites.push(cityName);
      }
      localStorage.setItem("gmt_fav_clocks", JSON.stringify(favorites));
      renderClocks();
    }

    function getFormattedTime(zone) {
      const now = new Date();
      try {
        const timeFormatter = new Intl.DateTimeFormat("en-US", {
          timeZone: zone,
          hour: "2-digit",
          minute: "2-digit",
          second: "2-digit",
          hour12: !is24Hour
        });
        const dateFormatter = new Intl.DateTimeFormat("en-US", {
          timeZone: zone,
          weekday: "short",
          month: "short",
          day: "numeric"
        });
        const hourFormatter = new Intl.DateTimeFormat("en-US", {
          timeZone: zone,
          hour: "numeric",
          hour12: false
        });

        // Calculate UTC Offset reliably using Intl timeZoneName shortOffset
        const offsetFormatter = new Intl.DateTimeFormat("en-US", {
          timeZone: zone,
          timeZoneName: "shortOffset"
        });
        const parts = offsetFormatter.formatToParts(now);
        const tzPart = parts.find(p => p.type === "timeZoneName");
        let offsetStr = tzPart ? tzPart.value.replace("GMT", "UTC") : "UTC+00:00";
        if (offsetStr === "UTC") offsetStr = "UTC+00:00";

        const hour24 = parseInt(hourFormatter.format(now), 10);
        const isDay = hour24 >= 6 && hour24 < 18;

        return {
          timeStr: timeFormatter.format(now),
          dateStr: dateFormatter.format(now),
          offsetStr,
          isDay
        };
      } catch (err) {
        return { timeStr: "--:--:--", dateStr: "", offsetStr: "UTC+00:00", isDay: true };
      }
    }

    function createClockCard(city, isFav) {
      const { timeStr, dateStr, offsetStr, isDay } = getFormattedTime(city.zone);
      const card = document.createElement("div");
      card.className = "clock-card";
      card.innerHTML = `
        <div class="card-header">
          <div>
            <h3 class="city-name">${city.name}</h3>
            <div class="country-name">${city.country}</div>
          </div>
          <button class="fav-star ${isFav ? 'active' : ''}" data-city="${city.name}" title="Toggle Favorite">★</button>
        </div>
        <div class="time-display">${timeStr}</div>
        <div class="date-display">${dateStr}</div>
        <div class="card-footer">
          <span class="badge ${isDay ? 'badge-day' : 'badge-night'}">
            ${isDay ? '☀️ Day' : '🌙 Night'}
          </span>
          <span class="badge badge-utc">${offsetStr}</span>
        </div>
      `;

      const starBtn = card.querySelector(".fav-star");
      starBtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        toggleFavorite(city.name);
      });

      return card;
    }

    function renderClocks() {
      const filtered = CITIES.filter(city => {
        const matchesContinent = currentContinent === "all" || city.continent === currentContinent;
        const matchesSearch = city.name.toLowerCase().includes(searchQuery) ||
                              city.country.toLowerCase().includes(searchQuery) ||
                              city.continent.toLowerCase().includes(searchQuery);
        return matchesContinent && matchesSearch;
      });

      const favCities = CITIES.filter(c => favorites.includes(c.name));

      if (favCities.length > 0 && searchQuery === "" && currentContinent === "all") {
        favoritesContainer.style.display = "block";
        favoritesGrid.innerHTML = "";
        favCities.forEach(c => favoritesGrid.appendChild(createClockCard(c, true)));
      } else {
        favoritesContainer.style.display = "none";
      }

      clocksGrid.innerHTML = "";
      filtered.forEach(c => {
        const isFav = favorites.includes(c.name);
        clocksGrid.appendChild(createClockCard(c, isFav));
      });
    }

    // Ticking loop
    setInterval(() => {
      renderClocks();
    }, 1000);

    renderClocks();
  </script>
</BaseLayout>
