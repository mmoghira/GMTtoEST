---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import RelatedConvertersWidget from "theme/components/RelatedConvertersWidget.astro";
import UsersAlsoVisitWidget from "theme/components/UsersAlsoVisitWidget.astro";
import LearnMoreWidget from "theme/components/LearnMoreWidget.astro";
import CountryCityWidget from "theme/components/CountryCityWidget.astro";
import { siteUrl } from "theme/i18n/config";

const lang = "en";
const dir = "ltr";
const slug = "edt";
const seoTitle = "Eastern Daylight Time (EDT) – UTC-4 Offset, Dates & Guide";
const pageDescription = "Comprehensive guide to Eastern Daylight Time (EDT). Learn UTC-4 offset, daylight saving transition dates (spring forward/fall back), affected cities, and global conversion tables.";

const pubDate = "2026-07-30T10:00:00+05:00";
const updatedDate = "2026-07-30T10:00:00+05:00";

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "EDT, Eastern Daylight Time, UTC-4, EDT offset, EDT time zone, EDT vs EST, New York daylight time, spring forward, fall back, EDT to GMT, EDT to PST",
  image: "/assets/edt-timezone-guide.webp",
  imageAlt: "Eastern Daylight Time (EDT) UTC-4 Offset Guide",
  pubDate,
  updatedDate,
  author: "Jackie Bruce",
  faqs: [
    {
      q: "What does EDT stand for?",
      a: "EDT stands for Eastern Daylight Time. It is the daylight saving time offset (UTC-4) used in the Eastern Time zone of North America during the spring, summer, and early autumn months."
    },
    {
      q: "What is the UTC offset for EDT?",
      a: "The UTC offset for Eastern Daylight Time (EDT) is UTC-4. Local time in the EDT zone is exactly 4 hours behind Coordinated Universal Time (UTC) and Greenwich Mean Time (GMT)."
    },
    {
      q: "When is EDT active during the year?",
      a: "EDT is active from the second Sunday of March (when clocks 'spring forward' from 2:00 AM to 3:00 AM) until the first Sunday of November (when clocks 'fall back' from 2:00 AM to 1:00 AM standard time)."
    },
    {
      q: "Which major cities observe Eastern Daylight Time?",
      a: "Major North American metropolitan areas observing EDT during summer months include New York City, Toronto, Washington D.C., Montreal, Miami, Atlanta, Boston, Philadelphia, and Detroit."
    },
    {
      q: "What is the difference between EDT and EST?",
      a: "EDT (Eastern Daylight Time) is UTC-4, observed during the summer months when daylight saving time is active. EST (Eastern Standard Time) is UTC-5, observed during the winter months when standard time is in effect."
    },
    {
      q: "How far behind GMT is EDT?",
      a: "EDT is 4 hours behind Greenwich Mean Time (GMT/UTC+0). When it is 12:00 PM (noon) GMT in London, it is 8:00 AM EDT in New York or Toronto. Note that if London is observing British Summer Time (BST, UTC+1), London is 5 hours ahead of EDT."
    },
    {
      q: "Why do we switch from EST to EDT?",
      a: "The transition from EST to EDT advances local clocks by one hour during warmer months to extend evening daylight hours, reducing energy consumption for residential lighting and encouraging evening commerce and outdoor activity."
    },
    {
      q: "How do I convert EDT to Pacific Daylight Time (PDT)?",
      a: "Eastern Daylight Time (EDT, UTC-4) is 3 hours ahead of Pacific Daylight Time (PDT, UTC-7). To convert EDT to PDT, subtract 3 hours (e.g., 2:00 PM EDT equals 11:00 AM PDT)."
    },
    {
      q: "How do I convert EDT to Central Daylight Time (CDT)?",
      a: "Eastern Daylight Time (EDT, UTC-4) is 1 hour ahead of Central Daylight Time (CDT, UTC-5). To convert EDT to CDT, subtract 1 hour (e.g., 10:00 AM EDT equals 9:00 AM CDT)."
    },
    {
      q: "Do all regions in the Eastern Time Zone switch to EDT?",
      a: "Most US states and Canadian provinces in the Eastern Time Zone switch to EDT. However, tropical regions within the Eastern zone—such as Jamaica, Panama, and the Cayman Islands—do not observe DST and remain on UTC-5 (EST) year-round."
    },
    {
      q: "Does the stock market change trading hours during EDT?",
      a: "No. The New York Stock Exchange (NYSE) and NASDAQ maintain fixed local operating hours from 9:30 AM to 4:00 PM Eastern Time. When local time shifts to EDT (UTC-4), the exchanges shift along with it, altering their absolute offset to London and Tokyo."
    },
    {
      q: "What is the time difference between EDT and Central European Summer Time (CEST)?",
      a: "Central European Summer Time (CEST, UTC+2) is 6 hours ahead of Eastern Daylight Time (EDT, UTC-4). When it is 10:00 AM EDT in New York, it is 4:00 PM CEST in Paris and Berlin."
    },
    {
      q: "What is the time difference between EDT and India Standard Time (IST)?",
      a: "India Standard Time (IST, UTC+5:30) is 9 hours and 30 minutes ahead of Eastern Daylight Time (EDT, UTC-4). When it is 8:00 AM EDT in New York, it is 5:30 PM IST in New Delhi and Mumbai."
    },
    {
      q: "What is the time difference between EDT and Australian Eastern Standard Time (AEST)?",
      a: "Australian Eastern Standard Time (AEST, UTC+10) is 14 hours ahead of Eastern Daylight Time (EDT, UTC-4). When it is 8:00 AM EDT in New York, it is 10:00 PM AEST in Brisbane."
    },
    {
      q: "What happens to the missing hour during the spring transition to EDT?",
      a: "On the second Sunday of March at 2:00 AM, clocks jump directly to 3:00 AM EDT. The 2:00 AM to 2:59 AM hour is skipped entirely, resulting in a 23-hour calendar day."
    },
    {
      q: "How does EDT impact flight schedules and airline tickets?",
      a: "Flight itineraries display local departure and arrival clock times. Because flight planning software calculates flight durations using UTC UTC-4 offsets during EDT, published flight durations remain accurate across DST transitions."
    },
    {
      q: "What is the Sunshine Protection Act and how would it affect EDT?",
      a: "The Sunshine Protection Act is proposed US federal legislation that would make Daylight Saving Time (EDT, UTC-4) permanent year-round, eliminating the annual fall transition back to standard time (EST, UTC-5)."
    },
    {
      q: "How do software systems handle the EDT clock change?",
      a: "Modern software applications store timestamps in UTC (which never changes for DST) and rely on timezone libraries (such as IANA `America/New_York`) to automatically calculate EDT offset shifts on client devices."
    },
    {
      q: "Is EDT the same as Eastern Time?",
      a: "EDT is the specific summer phase (UTC-4) of Eastern Time. Eastern Time (ET) is the generic geographic umbrella term that covers both EST (winter) and EDT (summer)."
    },
    {
      q: "What is the best time for a conference call between London and New York during EDT?",
      a: "During the summer when London observes BST (UTC+1) and New York observes EDT (UTC-4), there is a 5-hour time difference. The optimal meeting window is between 9:00 AM – 12:00 PM EDT (2:00 PM – 5:00 PM BST)."
    }
  ]
};

const pageUrlPath = `${siteUrl}/${slug}/`;
---

<BaseLayout
  lang={lang}
  dir={dir}
  title={seoTitle}
  description={pageDescription}
  slug={slug}
  meta={meta}
  enableFaqSchema={true}
  enableArticleSchema={true}
  breadcrumbHomeLabel="Home"
  breadcrumbLabel="EDT"
>
  <!-- Hero Section -->
  <section class="hero-banner" aria-labelledby="hero-title">
    <h1 id="hero-title" class="hero-banner-title speakable-headline">
      Eastern Daylight Time (EDT): <span class="gradient-text">UTC-4 Offset & DST Rules</span>
    </h1>
  </section>

  <!-- Editorial Info Bar -->
  <div class="editorial-meta-bar" aria-label="Editorial metadata">
    <span>Last Updated: <strong>July 30, 2026</strong></span>
    <span class="separator" aria-hidden="true">•</span>
    <span>Editorially Reviewed by <a href="/author/jackie-bruce/"><strong>Jackie Bruce</strong></a></span>
    <span class="separator" aria-hidden="true">•</span>
    <span>Data Source: <a href="https://www.iana.org/time-zones" target="_blank" rel="noopener noreferrer"><strong>IANA Time Zone Database</strong></a></span>
  </div>

  <div class="article-wrapper">
    <!-- Top Answer Summary Box -->
    <div class="summary-box speakable-summary">
      <div class="summary-header">
        <span class="summary-badge">DAYLIGHT TIME PROFILE</span>
        <h2>Eastern Daylight Time (EDT) Summary</h2>
      </div>
      <div class="summary-grid">
        <div class="summary-item">
          <span class="label">UTC Offset:</span>
          <span class="val highlight">UTC-4 (4 hours behind GMT)</span>
        </div>
        <div class="summary-item">
          <span class="label">Active Window:</span>
          <span class="val">2nd Sunday March to 1st Sunday November</span>
        </div>
        <div class="summary-item">
          <span class="label">Standard Counterpart:</span>
          <span class="val"><a href="/est/">EST (Eastern Standard Time, UTC-5)</a></span>
        </div>
        <div class="summary-item">
          <span class="label">Primary Cities:</span>
          <span class="val"><a href="/new-york-time/">New York</a>, <a href="/toronto-time/">Toronto</a>, Miami, D.C., Boston</span>
        </div>
        <div class="summary-item">
          <span class="label">Spring Transition:</span>
          <span class="val">Spring forward 1 hour (2:00 AM → 3:00 AM)</span>
        </div>
        <div class="summary-item">
          <span class="label">Fall Transition:</span>
          <span class="val">Fall back 1 hour (2:00 AM → 1:00 AM)</span>
        </div>
      </div>
      <p class="summary-text">
        <strong>Eastern Daylight Time (EDT)</strong> is the daylight saving time offset observed across eastern North America from March through November. Operating at <strong>UTC-4</strong>, EDT advances local clocks by one hour relative to winter standard time (<a href="/est/">EST UTC-5</a>). It governs major financial, business, and broadcasting schedules in New York City, Toronto, Washington D.C., and Atlanta during the spring and summer.
      </p>
    </div>

    <!-- Table of Contents -->
    <nav class="about-toc" aria-label="Table of Contents">
      <h2>Table of Contents</h2>
      <ul>
        <li><a href="#what-is-edt">1. What is Eastern Daylight Time (EDT)?</a></li>
        <li><a href="#edt-vs-est">2. EDT vs. EST: Offset & Seasonal Shift Comparison</a></li>
        <li><a href="#transition-calendar">3. Daylight Saving Transition Calendar & Rules</a></li>
        <li><a href="#geographic-coverage">4. Geographic Coverage & Non-DST Exceptions</a></li>
        <li><a href="#conversion-tables">5. Global EDT Time Conversion Tables</a></li>
        <li><a href="#financial-and-tech">6. Stock Exchange Hours, Server Infrastructure & Broadcasting</a></li>
        <li><a href="#faqs">7. Frequently Asked Questions (20 Detailed Answers)</a></li>
      </ul>
    </nav>

    <!-- Content Sections -->
    <section id="what-is-edt" class="content-section">
      <h2>1. What is Eastern Daylight Time (EDT)?</h2>
      <p>
        <strong>Eastern Daylight Time (EDT)</strong> is the summer daylight saving phase of the Eastern Time Zone in North America. When active, EDT maintains an offset of <strong>UTC-4</strong>, placing local time 4 hours behind <a href="/utc/">Coordinated Universal Time (UTC)</a> and <a href="/gmt/">Greenwich Mean Time (GMT)</a>.
      </p>
      <p>
        Daylight Saving Time in the US was first enacted under the Standard Time Act of 1918 to conserve fuel during World War I. The modern schedule was standardized under the Uniform Time Act of 1966 and modified by the Energy Policy Act of 2005, which extended daylight saving time to cover approximately 65% of the calendar year.
      </p>
    </section>

    <!-- SVG Diagram 1: Spring Forward Clock Mechanics -->
    <section class="diagram-section">
      <div class="diagram-card">
        <h3>Figure 1: Spring Forward Transition Mechanics (EST to EDT)</h3>
        <div class="svg-wrapper">
          <svg viewBox="0 0 800 240" width="100%" height="auto" xmlns="http://www.w3.org/2000/svg" aria-label="EDT Spring Forward Transition">
            <rect width="800" height="240" fill="var(--panel)" rx="12" stroke="var(--line)" stroke-width="1"/>
            
            <!-- Standard Time Box -->
            <rect x="60" y="60" width="260" height="110" rx="8" fill="rgba(255,255,255,0.03)" stroke="var(--line)" stroke-width="1.5"/>
            <text x="190" y="95" text-anchor="middle" fill="var(--muted)" font-size="12">1:59:59 AM EST (UTC-5)</text>
            <text x="190" y="125" text-anchor="middle" fill="var(--text)" font-family="Space Grotesk, sans-serif" font-weight="bold" font-size="20">02:00 AM Standard</text>
            <text x="190" y="150" text-anchor="middle" fill="var(--muted)" font-size="11">Clocks arrive at transition threshold</text>

            <!-- Jump Arrow -->
            <path d="M 330 115 L 470 115" fill="none" stroke="var(--accent)" stroke-width="3" marker-end="url(#arrow)"/>
            <text x="400" y="95" text-anchor="middle" fill="var(--accent)" font-weight="bold" font-size="12">SPRING FORWARD (+1h)</text>
            <text x="400" y="140" text-anchor="middle" fill="var(--accent)" font-size="11">Hour Skipped</text>

            <!-- Daylight Time Box -->
            <rect x="480" y="60" width="260" height="110" rx="8" fill="rgba(255,255,255,0.03)" stroke="var(--accent)" stroke-width="1.5"/>
            <text x="610" y="95" text-anchor="middle" fill="var(--accent)" font-size="12">Instant Shift to UTC-4</text>
            <text x="610" y="125" text-anchor="middle" fill="var(--text)" font-family="Space Grotesk, sans-serif" font-weight="bold" font-size="20">03:00 AM EDT</text>
            <text x="610" y="150" text-anchor="middle" fill="var(--muted)" font-size="11">Daylight Saving Active</text>
          </svg>
        </div>
        <p class="diagram-caption">
          Figure 1: Visual timeline showing the spring forward clock jump at 2:00 AM on the second Sunday of March, shifting local clocks directly to 3:00 AM EDT.
        </p>
      </div>
    </section>

    <section id="edt-vs-est" class="content-section">
      <h2>2. EDT vs. EST: Offset & Seasonal Shift Comparison</h2>
      <p>
        Understanding the exact difference between EST and EDT prevents scheduling errors across North American business trips and virtual meetings. For an in-depth guide, visit <a href="/est-vs-edt/">EST vs EDT Explained</a>.
      </p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Property</th>
              <th>Eastern Standard Time (EST)</th>
              <th>Eastern Daylight Time (EDT)</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>UTC Offset</strong></td>
              <td><a href="/utc/">UTC-5</a> (5 hours behind GMT)</td>
              <td><a href="/utc/">UTC-4</a> (4 hours behind GMT)</td>
            </tr>
            <tr>
              <td><strong>Season</strong></td>
              <td>Winter (November – March)</td>
              <td>Summer (March – November)</td>
            </tr>
            <tr>
              <td><strong>Sunlight Focus</strong></td>
              <td>Standard morning sunrise synchronization</td>
              <td>Extended evening daylight hours</td>
            </tr>
            <tr>
              <td><strong>Time Difference to London</strong></td>
              <td>5 hours behind GMT (London winter)</td>
              <td>5 hours behind BST (London summer) / 4 hours behind GMT</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section id="transition-calendar" class="content-section">
      <h2>3. Daylight Saving Transition Calendar & Rules</h2>
      <p>
        In accordance with US federal law, the annual transition dates follow strict calendar rules:
      </p>
      <ul>
        <li>
          <strong>Spring Transition (EST to EDT):</strong> Second Sunday of March at 2:00 AM. Clocks are set forward 1 hour to 3:00 AM EDT (losing 1 hour of sleep).
        </li>
        <li>
          <strong>Autumn Transition (EDT to EST):</strong> First Sunday of November at 2:00 AM. Clocks are set back 1 hour to 1:00 AM EST (gaining 1 hour of sleep).
        </li>
      </ul>
      <p>
        For international transition schedules, refer to our comprehensive guide on <a href="/daylight-saving-time-explained/">Daylight Saving Time Explained</a>.
      </p>
    </section>

    <section id="geographic-coverage" class="content-section">
      <h2>4. Geographic Coverage & Non-DST Exceptions</h2>
      <p>
        Eastern Daylight Time covers major commercial regions across North America:
      </p>
      <ul>
        <li><strong>United States:</strong> New York, Massachusetts, Pennsylvania, Florida (majority), Georgia, Ohio, North Carolina, Virginia, Michigan (majority). See <a href="/usa-time-zones/">USA Time Zones</a>.</li>
        <li><strong>Canada:</strong> Ontario (<a href="/toronto-time/">Toronto</a>, Ottawa), Quebec (Montreal), Nunavut. See <a href="/canada-time-zones/">Canada Time Zones</a>.</li>
        <li><strong>Exceptions (No DST):</strong> Panama, Jamaica, and the Cayman Islands remain on UTC-5 year-round, matching EST in winter but running 1 hour behind EDT during summer.</li>
      </ul>
    </section>

    <section id="conversion-tables" class="content-section">
      <h2>5. Global EDT Time Conversion Tables</h2>
      <p>
        Below is a reference conversion table for Eastern Daylight Time (EDT, UTC-4) during summer months:
      </p>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>EDT (UTC-4)</th>
              <th>GMT (UTC+0)<br/><a href="/gmt-to-est/">EDT to GMT</a></th>
              <th>BST (UTC+1)<br/><a href="/bst-to-est/">EDT to BST</a></th>
              <th>PDT (UTC-7)<br/><a href="/gmt-to-pdt/">EDT to PDT</a></th>
              <th>CEST (UTC+2)<br/><a href="/cet-to-est/">EDT to CEST</a></th>
              <th>IST (UTC+5:30)<br/><a href="/ist-to-est/">EDT to IST</a></th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>00:00 EDT (Midnight)</td>
              <td>04:00 GMT</td>
              <td>05:00 BST</td>
              <td>21:00 PDT (Prev Day)</td>
              <td>06:00 CEST</td>
              <td>09:30 IST</td>
            </tr>
            <tr>
              <td>06:00 EDT</td>
              <td>10:00 GMT</td>
              <td>11:00 BST</td>
              <td>03:00 PDT</td>
              <td>12:00 CEST</td>
              <td>15:30 IST</td>
            </tr>
            <tr>
              <td>09:00 EDT</td>
              <td>13:00 GMT</td>
              <td>14:00 BST</td>
              <td>06:00 PDT</td>
              <td>15:00 CEST</td>
              <td>18:30 IST</td>
            </tr>
            <tr>
              <td>12:00 EDT (Noon)</td>
              <td>16:00 GMT</td>
              <td>17:00 BST</td>
              <td>09:00 PDT</td>
              <td>18:00 CEST</td>
              <td>21:30 IST</td>
            </tr>
            <tr>
              <td>15:00 EDT</td>
              <td>19:00 GMT</td>
              <td>20:00 BST</td>
              <td>12:00 PDT</td>
              <td>21:00 CEST</td>
              <td>00:30 IST (Next Day)</td>
            </tr>
            <tr>
              <td>18:00 EDT</td>
              <td>22:00 GMT</td>
              <td>23:00 BST</td>
              <td>15:00 PDT</td>
              <td>00:00 CEST (Next Day)</td>
              <td>03:30 IST (Next Day)</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p>
        For live conversions, use our interactive <a href="/gmt-to-est/">GMT to EST/EDT Time Calculator</a>.
      </p>
    </section>

    <!-- SVG Diagram 2: Northern Hemisphere Summer Offset Spread -->
    <section class="diagram-section">
      <div class="diagram-card">
        <h3>Figure 2: Global Offsets During Northern Hemisphere Summer</h3>
        <div class="svg-wrapper">
          <svg viewBox="0 0 800 220" width="100%" height="auto" xmlns="http://www.w3.org/2000/svg" aria-label="Northern Hemisphere Summer Offsets">
            <rect width="800" height="220" fill="var(--panel)" rx="12" stroke="var(--line)" stroke-width="1"/>
            
            <circle cx="150" cy="110" r="30" fill="var(--panel)" stroke="var(--line)" stroke-width="2"/>
            <text x="150" y="114" text-anchor="middle" fill="var(--text)" font-weight="bold" font-size="13">PDT</text>
            <text x="150" y="160" text-anchor="middle" fill="var(--muted)" font-size="11">UTC-7 (Pacific)</text>

            <circle cx="320" cy="110" r="38" fill="var(--accent)" stroke="#ffffff" stroke-width="2.5"/>
            <text x="320" y="115" text-anchor="middle" fill="#ffffff" font-family="Space Grotesk, sans-serif" font-weight="bold" font-size="16">EDT</text>
            <text x="320" y="165" text-anchor="middle" fill="var(--accent)" font-weight="bold" font-size="12">UTC-4 (Eastern)</text>

            <circle cx="490" cy="110" r="30" fill="var(--panel)" stroke="var(--line)" stroke-width="2"/>
            <text x="490" y="114" text-anchor="middle" fill="var(--text)" font-weight="bold" font-size="13">BST</text>
            <text x="490" y="160" text-anchor="middle" fill="var(--muted)" font-size="11">UTC+1 (London)</text>

            <circle cx="660" cy="110" r="30" fill="var(--panel)" stroke="var(--line)" stroke-width="2"/>
            <text x="660" y="114" text-anchor="middle" fill="var(--text)" font-weight="bold" font-size="13">CEST</text>
            <text x="660" y="160" text-anchor="middle" fill="var(--muted)" font-size="11">UTC+2 (Europe)</text>

            <line x1="180" y1="110" x2="282" y2="110" stroke="var(--line)" stroke-width="2"/>
            <line x1="358" y1="110" x2="460" y2="110" stroke="var(--line)" stroke-width="2"/>
            <line x1="520" y1="110" x2="630" y2="110" stroke="var(--line)" stroke-width="2"/>
          </svg>
        </div>
        <p class="diagram-caption">
          Figure 2: Relative time offset comparison showing EDT (UTC-4) alongside PDT (UTC-7), BST (UTC+1), and CEST (UTC+2) during summer months.
        </p>
      </div>
    </section>

    <section id="financial-and-tech" class="content-section">
      <h2>6. Stock Exchange Hours, Server Infrastructure & Broadcasting</h2>
      <p>
        During EDT, trading on the NYSE and NASDAQ operates from 9:30 AM to 4:00 PM EDT. Because European stock exchanges (LSE in London, Euronext in Paris) are on BST (UTC+1) and CEST (UTC+2), European traders monitor Wall Street opening bells at 2:30 PM London time / 3:30 PM Paris time.
      </p>
      <p>
        For cloud software engineers, handling the transition into EDT requires ensuring servers log timestamps in UTC to avoid duplicating scheduled jobs during clock shifts. Read our developer guide on <a href="/handling-time-zones-javascript/">JavaScript Time Zone Handling</a> for code examples.
      </p>
    </section>

    <!-- Contextual Widgets Integration -->
    <RelatedConvertersWidget slug={slug} />
    <UsersAlsoVisitWidget slug={slug} />
    <LearnMoreWidget slug={slug} />
    <CountryCityWidget slug={slug} />

    <!-- FAQ Section -->
    <section id="faqs" class="content-section faqs-section">
      <h2>7. Frequently Asked Questions (EDT)</h2>
      <div class="faq-list">
        {meta.faqs.map((faq, index) => (
          <details class="faq-item" open={index === 0}>
            <summary class="faq-question">
              <h3>{faq.q}</h3>
            </summary>
            <div class="faq-answer">
              <p>{faq.a}</p>
            </div>
          </details>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .article-wrapper {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 1rem 3rem;
  }
  .hero-banner {
    text-align: center;
    padding: 3rem 1rem 1.5rem;
  }
  .hero-banner-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--text);
  }
  .gradient-text {
    background: linear-gradient(135deg, var(--accent) 0%, #38bdf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .editorial-meta-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--muted);
    margin-bottom: 2rem;
    padding: 0.75rem 1rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
  }
  .editorial-meta-bar a {
    color: var(--accent);
    text-decoration: none;
  }
  .separator {
    opacity: 0.5;
  }
  .summary-box {
    background: var(--panel);
    border: 1px solid var(--accent);
    border-radius: 12px;
