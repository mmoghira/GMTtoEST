---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import Converter from "theme/components/Converter.astro";
import { getTranslation, pageUrl, siteUrl } from "theme/i18n/config";

const lang = "en";
const dir = "ltr";
const slug = "acdt-to-est";
const t = getTranslation(lang);

const pageTitle = "ACDT to EST Converter";
const seoTitle = "ACDT to EST Converter – Australian Central Daylight Time to Eastern Standard Time";
const pageDescription = "Convert ACDT to EST quickly and accurately. Calculate the 15.5-hour time difference between South Australia (Adelaide) and North America Eastern Standard Time with live clocks, conversion table, and meeting scheduling tools.";

const context = {
  from: "ACDT",
  to: "EST",
  fromZone: "Australia/Adelaide",
  toZone: "America/New_York"
};

const canonical = `${siteUrl}/acdt-to-est/`;

// 24-hour conversion table data (ACDT → EST = ACDT - 15.5 hours)
function formatHour12(hour: number) {
  const normalized = ((hour % 24) + 24) % 24;
  const period = normalized < 12 ? "AM" : "PM";
  const displayHour = normalized % 12 || 12;
  return `${displayHour}:00 ${period}`;
}

function getEstFromAcdt(acdtHour: number) {
  const totalMinutes = acdtHour * 60 - (15 * 60 + 30);
  const normalizedMinutes = ((totalMinutes % 1440) + 1440) % 1440;
  const estH = Math.floor(normalizedMinutes / 60);
  const estM = normalizedMinutes % 60;
  const period = estH < 12 ? "AM" : "PM";
  const displayH = estH % 12 || 12;
  const minStr = estM === 0 ? "00" : estM < 10 ? `0${estM}` : `${estM}`;
  const dayNote = totalMinutes < 0 ? " (-1 day)" : "";
  return {
    timeStr: `${displayH}:${minStr} ${period}${dayNote}`,
    dayTag: totalMinutes < 0 ? "Previous day" : "Same day"
  };
}

const conversionRows = Array.from({ length: 24 }, (_, hour) => {
  const estData = getEstFromAcdt(hour);
  return {
    acdt: formatHour12(hour),
    est: estData.timeStr,
    dayNote: estData.dayTag
  };
});

// Popular conversions array
const popularConversions = [
  { acdt: "8:00 AM ACDT", est: "4:30 PM EST (Prev Day)", note: "Early morning in Adelaide aligns with end of East Coast US workday" },
  { acdt: "9:30 AM ACDT", est: "6:00 PM EST (Prev Day)", note: "Adelaide workday opens as New York office hours close" },
  { acdt: "11:00 AM ACDT", est: "7:30 PM EST (Prev Day)", note: "Mid-morning South Australia syncs with US East Coast evening" },
  { acdt: "1:00 PM ACDT", est: "9:30 PM EST (Prev Day)", note: "Adelaide afternoon matches North American late evening" },
  { acdt: "3:30 PM ACDT", est: "12:00 AM EST (Midnight)", note: "Late afternoon in South Australia meets midnight in New York" },
  { acdt: "5:00 PM ACDT", est: "1:30 AM EST", note: "End of Adelaide office hours corresponds to early hours in EST" },
  { acdt: "7:00 PM ACDT", est: "3:30 AM EST", note: "Adelaide evening aligns with mid-night in North America" },
  { acdt: "9:30 PM ACDT", est: "6:00 AM EST", note: "Adelaide late evening coincides with East Coast US early dawn" },
  { acdt: "11:30 PM ACDT", est: "8:00 AM EST", note: "Adelaide bedtime syncs with morning start in New York & Toronto" },
  { acdt: "1:30 AM ACDT (+1)", est: "10:00 AM EST", note: "Overnight in South Australia aligns with mid-morning US business" },
  { acdt: "3:30 AM ACDT (+1)", est: "12:00 PM EST (Noon)", note: "Early morning hours in Adelaide match midday EST lunch hour" },
  { acdt: "5:30 AM ACDT (+1)", est: "2:00 PM EST", note: "Dawn in Adelaide corresponds to early afternoon on US East Coast" }
];

// 12 COMPLETELY UNIQUE FAQs
const faqs = [
  {
    q: "What is the exact time difference between ACDT and EST?",
    a: "Eastern Standard Time (EST) is 15.5 hours behind Australian Central Daylight Time (ACDT). When it is 3:30 PM ACDT in Adelaide, it is exactly 12:00 AM (Midnight) EST in New York."
  },
  {
    q: "Why is there a half-hour fractional offset between ACDT and EST?",
    a: "South Australia adopted a half-hour standard offset (UTC+9:30 in winter, UTC+10:30 in summer during ACDT) in 1899 to sit precisely halfway between Eastern Australia (UTC+10) and Western Australia (UTC+8). Comparing UTC+10:30 to EST (UTC-5) results in a 15.5-hour gap."
  },
  {
    q: "Does South Australia observe Daylight Saving Time?",
    a: "Yes. South Australia, including Adelaide and Broken Hill, switches from ACST (UTC+9:30) to ACDT (UTC+10:30) on the first Sunday of October and returns to standard time on the first Sunday of April."
  },
  {
    q: "Does EST observe Daylight Saving Time?",
    a: "EST (Eastern Standard Time, UTC-5) is the fixed standard time offset used during North American winter. In summer, the US East Coast moves to EDT (Eastern Daylight Time, UTC-4), altering the time difference with Adelaide to 14.5 hours."
  },
  {
    q: "What regions use ACDT?",
    a: "ACDT is observed in the state of South Australia, the border town of Broken Hill in New South Wales, and Lord Howe Island (which has its own half-hour rules). The Northern Territory remains on ACST (UTC+9:30) year-round without DST."
  },
  {
    q: "What is the best time for a business call between Adelaide and New York?",
    a: "The most practical overlap window occurs between 8:00 AM and 10:00 AM ACDT in South Australia, which matches 4:30 PM to 6:30 PM EST of the previous day in New York and Toronto."
  },
  {
    q: "How does the date change when converting ACDT to EST?",
    a: "Because EST is 15.5 hours behind ACDT, any time in Adelaide between 12:00 AM (Midnight) and 3:29 PM ACDT falls into the previous calendar day in North American Eastern Standard Time."
  },
  {
    q: "Is ACDT ahead of or behind EST?",
    a: "ACDT is 15.5 hours ahead of EST. South Australia experiences daylight and calendar dates long before the East Coast of North America."
  },
  {
    q: "What is the IANA time zone identifier for Adelaide and New York?",
    a: "Adelaide uses 'Australia/Adelaide' in computer systems and software libraries, while New York and the US East Coast use 'America/New_York'."
  },
  {
    q: "Can I schedule recurring meetings across ACDT and EST without errors?",
    a: "Because both regions shift clocks for Daylight Saving Time on different calendars (South Australia in October/April, North America in March/November), automated scheduling tools should always reference IANA identifiers rather than static 15.5-hour formulas."
  },
  {
    q: "How do financial markets align between South Australia and New York?",
    a: "When Adelaide businesses open at 9:00 AM ACDT on Tuesday morning, Wall Street in New York is wrapping up its trading session at 5:30 PM EST on Monday afternoon."
  },
  {
    q: "Why do calendar apps fail on half-hour timezone conversions?",
    a: "Legacy scheduling software occasionally assumes whole-hour offsets. Systems converting ACDT (UTC+10:30) must properly parse 30-minute increments to avoid shifting appointments by 30 minutes."
  },
  {
    q: "What is the difference between ACDT and Australian Eastern Daylight Time (AEDT)?",
    a: "ACDT (UTC+10:30) is used in South Australia and Broken Hill, whereas AEDT (UTC+11:00) is used in Sydney, Melbourne, and Canberra. ACDT is exactly 30 minutes behind AEDT during the southern hemisphere summer."
  },
  {
    q: "How does aviation flight scheduling account for ACDT to EST transitions?",
    a: "Airlines log all international flight manifests in UTC (GMT) to maintain standard operations. Passenger itineraries convert these baseline UTC timestamps into local ACDT and EST departure and arrival times."
  },
  {
    q: "Is Lord Howe Island on ACDT?",
    a: "No. Lord Howe Island uses Lord Howe Daylight Time (LHDT, UTC+11:00) during summer, which is 30 minutes ahead of ACDT and 16 hours ahead of Eastern Standard Time."
  },
  {
    q: "What is the historical reason behind South Australia's 30-minute offset?",
    a: "In 1898, South Australia adopted UTC+9:30 after legislative debates to position the state standard time centrally between Melbourne/Sydney (UTC+10) and Perth (UTC+8) for railway and telegraph convenience."
  }
];

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "ACDT to EST, Australian Central Daylight Time to Eastern Standard Time, Adelaide to New York time, ACDT EST converter, Australia South Australia time to US East Coast, 15.5 hour time difference, Adelaide time converter",
  image: "/assets/acdt-to-est-og.svg",
  imageAlt: "ACDT to EST Time Zone Converter",
  faqs,
  appDescription: "Convert Australian Central Daylight Time (ACDT) to Eastern Standard Time (EST) with real-time accuracy, interactive conversion matrix, half-hour offset calculations, and meeting coordination tools.",
  applicationCategory: "UtilityApplication",
  operatingSystem: "Any",
  howToName: "How to Convert ACDT to EST",
  howToDescription: "Simple guide to calculating Eastern Standard Time from Australian Central Daylight Time.",
  howToSteps: [
    { name: "Identify the ACDT time", text: "Select your target hour in South Australia (ACDT, UTC+10:30)." },
    { name: "Subtract 15 hours and 30 minutes", text: "Deduct 15.5 hours to find the corresponding Eastern Standard Time." },
    { name: "Check the date shift", text: "Times in Adelaide before 3:30 PM ACDT fall on the previous calendar day in EST." }
  ]
};
---

<BaseLayout
  lang={lang}
  dir={dir}
  title={seoTitle}
  description={pageDescription}
  slug={slug}
  meta={meta}
  mode="gmt-est"
  enableFaqSchema={true}
  allowAds={true}
  breadcrumbHomeLabel="Home"
  breadcrumbLabel="ACDT to EST"
  hreflangCodes={["en"]}
>
  <!-- Hero Section -->
  <header class="hero-banner">
    <div class="hero-content">
      <span class="eyebrow">Cross-Pacific Fractional Offset Calculator</span>
      <h1 class="hero-banner-title">ACDT to EST Converter</h1>
      <p class="hero-subtitle">
        Accurately translate Australian Central Daylight Time (UTC+10:30) to Eastern Standard Time (UTC-5) with instant half-hour precise calculations.
      </p>
    </div>
  </header>

<!-- PRIMARY CONVERTER & LIVE CLOCKS (Above the Fold) -->
<div style="max-width: 720px; margin: 0 auto; padding: 0 16px 24px;">
  <Converter intent="dynamic" t={t} context={context} />
  
  <div class="live-clock-strip" style="margin-top: 16px; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px;">
    <div class="clock-card" style="text-align: center; padding: 12px 16px; background: var(--panel); border: 1px solid var(--line); border-radius: 10px;">
      <span class="eyebrow" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); display: block; margin-bottom: 4px;">Live Source Time</span>
      <strong class="top-gmt-clock" style="font-size: 1.25rem; font-family: 'Space Grotesk', sans-serif; color: var(--accent); font-weight: 700;">--:--:--</strong>
    </div>
    <div class="clock-card" style="text-align: center; padding: 12px 16px; background: var(--panel); border: 1px solid var(--line); border-radius: 10px;">
      <span class="eyebrow" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); display: block; margin-bottom: 4px;">Live Target Time</span>
      <strong class="top-est-clock" style="font-size: 1.25rem; font-family: 'Space Grotesk', sans-serif; color: var(--accent); font-weight: 700;">--:--:--</strong>
      <em class="top-est-zone" style="font-size: 0.8rem; color: var(--muted); font-style: normal; margin-left: 4px;">ET</em>
    </div>
  </div>
</div>


  <!-- Feature Strip -->
  <div class="feature-strip">
    <div class="feature-item">
      <svg class="feature-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      <span>15.5-Hour Precise Gap</span>
    </div>
    <div class="feature-item">
      <svg class="feature-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
      <span>Adelaide & New York</span>
    </div>
    <div class="feature-item">
      <svg class="feature-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
      <span>30-Min Fractional Alignment</span>
    </div>
    <div class="feature-item">
      <svg class="feature-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>

      <span>DST Rule Validation</span>
    </div>
  </div>

  <!-- Introduction Section -->
  <section class="acdt-intro content-section">
    <p>
      Managing time differences across the Pacific Ocean presents unique logistical challenges, particularly when converting between <strong>Australian Central Daylight Time (ACDT)</strong> and North America's <strong>Eastern Standard Time (EST)</strong>. Operating at UTC+10:30, ACDT is one of the world's prominent half-hour fractional time zones. Centered around Adelaide and the state of South Australia, it runs 15.5 hours ahead of Eastern Standard Time (UTC-5), creating a substantial temporal separation that spans calendar dates and business cycles.
    </p>
    <p>
      When it is 9:00 AM on Tuesday morning in Adelaide, professionals in New York, Toronto, and Atlanta are experiencing 5:30 PM on Monday afternoon. Navigating this 15.5-hour delta requires paying strict attention to both the 30-minute fractional variance and the date rollover. Whether you are managing transatlantic financial operations, scheduling executive teleconferences, coordinating defense logistics, or staying connected with family in Australia, our converter provides error-free calculations.
    </p>
    <p>
      This guide outlines the mathematical foundation of the 15.5-hour offset, provides an interactive live converter, features a comprehensive 24-hour lookup table, and offers practical strategies for overlapping work hours between South Australia and Eastern North America.
    </p>
  </section>

  <!-- Interactive Converter Section -->
  <section class="converter-section" id="interactive-converter">
    <div class="converter-header">
      <h2>Interactive ACDT to EST Time Converter</h2>
      <p>Select any hour in ACDT to determine the exact corresponding time in EST instantly.</p>
    </div>
    <Converter intent="dynamic" t={t} context={context} />
  </section>

  <!-- Live Clocks Section -->
  <section class="clock-grid" aria-labelledby="live-clocks-heading">
    <h2 id="live-clocks-heading" class="sr-only">Live Clocks: ACDT vs EST</h2>
    <div class="clock-card">
      <div class="clock-header">
        <span class="clock-flag">🇦🇺</span>
        <span>Current ACDT (Adelaide)</span>
      </div>
      <strong id="acdtClock">10:30 AM</strong>
      <em id="acdtZone">UTC+10:30 • South Australia</em>
    </div>
    <div class="clock-card accent-card">
      <div class="clock-header">
        <span class="clock-flag">🇺🇸 / 🇨🇦</span>
        <span>Current EST (New York / Toronto)</span>
      </div>
      <strong id="estClock">7:00 PM</strong>
      <em id="estZone">UTC-5 • Eastern Standard Time</em>
    </div>
  </section>

  <!-- Custom Regional SVG Illustration -->
  <div class="svg-container banner-svg">
    <svg viewBox="0 0 800 200" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="ACDT to EST geographic visual timeline map">
      <rect width="800" height="200" fill="#0c354a" rx="12"/>
      <!-- South Australia Node -->
      <g transform="translate(100, 60)">
        <circle cx="50" cy="40" r="34" fill="#1b536e" stroke="#36c7b5" stroke-width="3"/>
        <text x="50" y="45" fill="#f4fbff" font-family="Space Grotesk, sans-serif" font-weight="700" font-size="14" text-anchor="middle">ACDT</text>
        <text x="50" y="95" fill="#8fd7ff" font-family="Manrope, sans-serif" font-size="12" text-anchor="middle">Adelaide (UTC+10:30)</text>
      </g>
      <!-- Trans-Pacific Connection Path -->
      <path d="M 200 100 Q 400 20 600 100" fill="none" stroke="#36c7b5" stroke-width="3" stroke-dasharray="8 4"/>
      <g transform="translate(370, 35)">
        <rect x="0" y="0" width="110" height="28" fill="#12455d" rx="14" stroke="#2f6278" stroke-width="1"/>
        <text x="55" y="18" fill="#36c7b5" font-family="Space Grotesk, sans-serif" font-weight="700" font-size="12" text-anchor="middle">15.5 HR GAP</text>
      </g>
      <!-- US East Coast Node -->
      <g transform="translate(550, 60)">
        <circle cx="50" cy="40" r="34" fill="#1b536e" stroke="#8fd7ff" stroke-width="3"/>
        <text x="50" y="45" fill="#f4fbff" font-family="Space Grotesk, sans-serif" font-weight="700" font-size="14" text-anchor="middle">EST</text>
        <text x="50" y="95" fill="#8fd7ff" font-family="Manrope, sans-serif" font-size="12" text-anchor="middle">New York (UTC-5)</text>
      </g>
    </svg>
  </div>

  <!-- Time Difference Breakdown -->
  <section class="method-section content-section">
    <h2>Understanding the 15.5-Hour Time Difference</h2>
    <p class="method-intro">
      Converting Australian Central Daylight Time to Eastern Standard Time involves accounting for both a multi-hour offset and a 30-minute fractional shift.
    </p>

    <div class="method-grid">
      <div class="method-card">
        <div class="card-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/></svg>
        </div>
        <h3>Mathematical Formula</h3>
        <p class="formula-box">EST = ACDT - 15 hours - 30 minutes</p>
        <p>To convert any local ACDT timestamp to EST, subtract 15 full hours and an additional 30 minutes. If the result goes below zero, adjust to the previous calendar day.</p>
      </div>

      <div class="method-card">
        <div class="card-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><line x1="2" y1="12" x2="22" y2="12"/></svg>
        </div>
        <h3>UTC Base Offsets</h3>
        <p>ACDT operates at <strong>UTC+10:30</strong> (Coordinated Universal Time plus 10 hours 30 minutes). EST operates at <strong>UTC-5</strong>. The mathematical difference is (+10.5) - (-5) = 15.5 hours.</p>
      </div>

      <div class="method-card">
        <div class="card-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"/></svg>
        </div>
        <h3>Date Shift Rules</h3>
        <p>Because EST is 15.5 hours behind ACDT, times in Adelaide between <strong>12:00 AM and 3:29 PM ACDT</strong> correspond to the <strong>previous day</strong> in EST. Times after 3:30 PM ACDT fall on the same day.</p>
      </div>

      <div class="method-card">
        <div class="card-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        </div>
        <h3>Quick Mental Calculation</h3>
        <p>Subtract 16 hours from ACDT time and then add 30 minutes back. For example: 10:00 AM ACDT minus 16 hours = 6:00 PM (prev day) + 30 mins = <strong>6:30 PM EST</strong> (prev day).</p>
      </div>
    </div>
  </section>

  <!-- 24-Hour Conversion Table -->
  <section class="table-section content-section">
    <h2>24-Hour ACDT to EST Conversion Chart</h2>
    <p>Use this reference table to convert any hour of the day from South Australia time to Eastern Standard Time.</p>

    <!-- Timeline Graphic SVG -->
    <div class="svg-container timeline-svg">
      <svg viewBox="0 0 800 80" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
        <rect width="800" height="80" fill="#0c354a" rx="8"/>
        <line x1="50" y1="40" x2="750" y2="40" stroke="#2f6278" stroke-width="4"/>
        <!-- Nodes -->
        <circle cx="100" cy="40" r="10" fill="#36c7b5"/>
        <text x="100" y="65" fill="#f4fbff" font-size="11" text-anchor="middle">8:00 AM ACDT</text>
        <text x="100" y="25" fill="#8fd7ff" font-size="11" text-anchor="middle">4:30 PM EST (-1d)</text>

        <circle cx="400" cy="40" r="10" fill="#36c7b5"/>
        <text x="400" y="65" fill="#f4fbff" font-size="11" text-anchor="middle">3:30 PM ACDT</text>
        <text x="400" y="25" fill="#8fd7ff" font-size="11" text-anchor="middle">12:00 AM EST (Midnight)</text>

        <circle cx="700" cy="40" r="10" fill="#36c7b5"/>
        <text x="700" y="65" fill="#f4fbff" font-size="11" text-anchor="middle">11:30 PM ACDT</text>
        <text x="700" y="25" fill="#8fd7ff" font-size="11" text-anchor="middle">8:00 AM EST (Same day)</text>
      </svg>
    </div>

    <div class="table-wrap">
      <table class="conversion-table">
        <thead>
          <tr>
            <th>ACDT Time (Adelaide)</th>
            <th>EST Time (New York / Toronto)</th>
            <th>Calendar Day Difference</th>
          </tr>
        </thead>
        <tbody>
          {conversionRows.map((row) => (
            <tr>
              <td><strong>{row.acdt}</strong></td>
              <td><span class="converted-time">{row.est}</span></td>
              <td><span class={`day-badge ${row.dayNote === "Previous day" ? "prev-day" : "same-day"}`}>{row.dayNote}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- Popular Conversions Table -->
  <section class="examples-section content-section">
    <h2>Key Business & Travel Time Alignments</h2>
    <p>Commonly referenced time pairs for cross-Pacific communication between South Australia and Eastern North America.</p>
    <div class="table-wrap">
      <table class="conversion-table">
        <thead>
          <tr>
            <th>ACDT Benchmark</th>
            <th>EST Equivalent</th>
            <th>Operational Context</th>
          </tr>
        </thead>
        <tbody>
          {popularConversions.map((item) => (
            <tr>
              <td><strong>{item.acdt}</strong></td>
              <td><span class="converted-time">{item.est}</span></td>
              <td>{item.note}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- Daylight Saving Time Infographic SVG -->
  <section class="dst-section content-section">
    <h2>Daylight Saving Time Dynamics: South Australia vs EST</h2>
    <p>
      ACDT is active from October through April in South Australia. Meanwhile, Eastern Standard Time (EST, UTC-5) is observed during North American winter (November to March). Understanding these seasonal transitions is essential to avoiding scheduling mismatches.
    </p>
    <div class="svg-container dst-svg">
      <svg viewBox="0 0 800 180" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
        <rect width="800" height="180" fill="#0c354a" rx="10"/>
        <!-- Australian Summer / US Winter -->
        <rect x="40" y="30" width="340" height="120" fill="#12455d" rx="8" stroke="#2f6278" stroke-width="1"/>
        <text x="210" y="55" fill="#36c7b5" font-family="Space Grotesk, sans-serif" font-weight="700" font-size="14" text-anchor="middle">OCTOBER – MARCH</text>
        <text x="210" y="85" fill="#f4fbff" font-size="13" text-anchor="middle">South Australia: ACDT (UTC+10:30)</text>
        <text x="210" y="105" fill="#f4fbff" font-size="13" text-anchor="middle">US East Coast: EST (UTC-5)</text>
        <text x="210" y="135" fill="#8fd7ff" font-weight="700" font-size="13" text-anchor="middle">Difference: 15.5 Hours</text>

        <!-- Australian Winter / US Summer -->
        <rect x="420" y="30" width="340" height="120" fill="#12455d" rx="8" stroke="#2f6278" stroke-width="1"/>
