---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import Converter from "theme/components/Converter.astro";
import { getLang, getPageMeta, getTranslation, siteUrl } from "theme/i18n/config";

const lang = getLang("en");
const t = getTranslation(lang.code);

const meta = {
  title: "CDT to EST Converter | Central Time to Eastern Time Tool",
  description: "Convert CDT to EST instantly with our free Central Time to Eastern Time converter. Includes live clocks, DST support, conversion tables, meeting planner, and FAQs.",
  keywords: "CDT to EST, Central Time to Eastern Time, convert CDT to EST, CDT vs EST, time zone converter, Chicago to New York time",
  image: "/assets/gmt-to-est-converter-featured-image-960.avif",
  imageAlt: "CDT to EST converter showing Central Time to Eastern Time conversion chart and 1 hour difference",
  ogType: "website"
};

const pageUrl = `${siteUrl}/cdt-to-est/`;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
      "url": pageUrl,
      "name": meta.title,
      "description": meta.description,
      "isPartOf": { 
        "@type": "WebSite",
        "@id": `${siteUrl}/#website`,
        "url": siteUrl,
        "name": "GMT to EST Converter"
      },
      "inLanguage": "en"
    },
    {
      "@type": "WebApplication",
      "@id": `${pageUrl}#app`,
      "name": "CDT to EST Converter",
      "url": pageUrl,
      "description": "Interactive timezone calculator to convert Central Daylight Time (CDT) to Eastern Standard Time (EST).",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "Any",
      "offers": {
        "@type": "Offer",
        "price": "0.00",
        "priceCurrency": "USD"
      },
      "featureList": [
        "CDT to EST live conversion",
        "DST-aware offset handling",
        "Live reference clocks",
        "24-hour conversion chart"
      ]
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${pageUrl}#breadcrumb`,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": siteUrl
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "CDT to EST",
          "item": pageUrl
        }
      ]
    },
    {
      "@type": "HowTo",
      "@id": `${pageUrl}#howto`,
      "name": "How to Convert Central Time to Eastern Time",
      "description": "Step-by-step instructions to convert Central Daylight Time (CDT) to Eastern Time (EDT/EST) correctly.",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Check DST Status",
          "text": "Identify if Central and Eastern regions are currently observing Daylight Saving Time (CDT/EDT) or Standard Time (CST/EST)."
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Calculate the Offset",
          "text": "Add 1 hour to your Central Time to find the corresponding Eastern Time value."
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Use the Online Converter",
          "text": "Enter your time in our live calculator at the top of this page to verify the conversion instantly."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": `${pageUrl}#faq`,
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Is CDT the same as EST?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. While both use a UTC-5 offset, they are observed during different seasons. In practice, Central and Eastern Time are always 1 hour apart. When Central is on CDT (summer), Eastern is on EDT (UTC-4). Therefore, 1:00 PM Central is equal to 2:00 PM Eastern."
          }
        },
        {
          "@type": "Question",
          "name": "What is the time difference between Central and Eastern Time?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Eastern Time is always 1 hour ahead of Central Time. When Central Time is on CDT (daylight saving time), Eastern Time is on EDT, maintaining the 1-hour difference."
          }
        },
        {
          "@type": "Question",
          "name": "What is 5 PM CDT in EST?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "5:00 PM CDT (Central Daylight Time) converts to 5:00 PM EST (Eastern Standard Time) literally. However, during the summer when CDT is active, Eastern Time observes EDT, making 5:00 PM Central Time equal to 6:00 PM Eastern Time (EDT)."
          }
        },
        {
          "@type": "Question",
          "name": "What is 8 PM CDT in EST?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "8:00 PM CDT is 8:00 PM EST literally. In real-world business terms during daylight saving months, 8:00 PM Central Time (CDT) is 9:00 PM Eastern Time (EDT)."
          }
        },
        {
          "@type": "Question",
          "name": "What is 11 AM CDT in EST?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "11:00 AM CDT converts to 11:00 AM EST literally. In practical scheduling during summer, 11:00 AM Central Time (CDT) corresponds to 12:00 PM Eastern Time (EDT)."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout lang={lang.code} dir={lang.dir} title={meta.title} description={meta.description} slug="cdt-to-est" meta={meta} enableFaqSchema={true}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} slot="head" />

  <section class="hero-banner">
    <h1 class="hero-banner-title">
      CDT to EST <span class="gradient-text">Converter</span>
    </h1>
  </section>

  <p class="seo-keyword-intro">
    <strong>CDT to EST Converter</strong> gives instant, date-aware Central Time (CDT/CST) to Eastern Time (EDT/EST) conversions. Eastern Time is 1 hour ahead of Central Time. Use this live, DST-aware converter to calculate accurate time differences for meetings, remote work, travel, broadcasts, and international scheduling.
  </p>

  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Instant timezone calculator</p>
      <p>Convert Central Time to Eastern Time instantly. The calculator handles daylight saving changes dynamically so you always get the right EDT or EST offset based on your selected date.</p>
      <figure class="hero-visual reveal">
        <picture>
          <source type="image/avif" srcset="/assets/gmt-to-est-converter-featured-image-480.avif 480w, /assets/gmt-to-est-converter-featured-image-960.avif 960w" sizes="(max-width: 720px) 92vw, 960px" />
          <source type="image/webp" srcset="/assets/gmt-to-est-converter-featured-image-480.webp 480w, /assets/gmt-to-est-converter-featured-image-960.webp 960w" sizes="(max-width: 720px) 92vw, 960px" />
          <img width="960" height="420" src="/assets/gmt-to-est-converter-featured-image.svg" alt={meta.imageAlt} fetchpriority="high" loading="eager" decoding="async" />
        </picture>
        <figcaption>Convert Central Time to Eastern Time instantly using our CDT to EST converter chart.</figcaption>
      </figure>
    </div>
    <Converter intent="dynamic" t={t} context={{ from: "CDT", to: "EST", fromZone: "America/Chicago", toZone: "America/New_York" }} />
  </section>

  <section class="clock-grid" aria-labelledby="live-clocks">
    <h2 id="live-clocks">Live Central and Eastern Clocks</h2>
    <div class="clock-card"><span>Current Central Time (CDT/CST)</span><strong id="gmtClock">--:--</strong></div>
    <div class="clock-card"><span>Current Eastern Time (EDT/EST)</span><strong id="estClock">--:--</strong><em id="estZone">EDT</em></div>
  </section>

  <section class="examples-section" aria-labelledby="time-diff-title">
    <h2 id="time-diff-title">Current Time Difference</h2>
    <p>The standard offset difference between Central Time and Eastern Time is 1 hour:</p>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Time Zone</th><th>Standard UTC Offset</th><th>DST Offset</th></tr>
        </thead>
        <tbody>
          <tr><td>Central Time (CDT/CST)</td><td>UTC-6</td><td>UTC-5</td></tr>
          <tr><td>Eastern Time (EDT/EST)</td><td>UTC-5</td><td>UTC-4</td></tr>
        </tbody>
      </table>
    </div>
    <p>Eastern Time is 1 hour ahead of Central Time. When it is 12:00 PM in the Central zone, it is 1:00 PM in the Eastern zone.</p>
  </section>

  <section class="examples-section" aria-labelledby="presets-title">
    <h2 id="presets-title">Quick Central Time to Eastern Time Examples</h2>
    <p>Scan this hourly preset table to find your matching timezone values at a glance:</p>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Central Time (CDT)</th><th>Eastern Time (EDT)</th></tr>
        </thead>
        <tbody>
          <tr><td>7:00 AM</td><td>8:00 AM</td></tr>
          <tr><td>8:00 AM</td><td>9:00 AM</td></tr>
          <tr><td>9:00 AM</td><td>10:00 AM</td></tr>
          <tr><td>10:00 AM</td><td>11:00 AM</td></tr>
          <tr><td>11:00 AM</td><td>12:00 PM</td></tr>
          <tr><td>12:00 PM</td><td>1:00 PM</td></tr>
          <tr><td>1:00 PM</td><td>2:00 PM</td></tr>
          <tr><td>2:00 PM</td><td>3:00 PM</td></tr>
          <tr><td>3:00 PM</td><td>4:00 PM</td></tr>
          <tr><td>4:00 PM</td><td>5:00 PM</td></tr>
          <tr><td>5:00 PM</td><td>6:00 PM</td></tr>
          <tr><td>6:00 PM</td><td>7:00 PM</td></tr>
          <tr><td>7:00 PM</td><td>8:00 PM</td></tr>
          <tr><td>8:00 PM</td><td>9:00 PM</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="method-section" aria-labelledby="how-to-convert-title">
    <h2 id="how-to-convert-title">How to Convert CDT to EST</h2>
    <p>Converting Central Time to Eastern Time is simple. Use the formula below to make adjustments:</p>
    <div class="method-grid">
      <article class="method-card">
        <h3>The Simple Formula</h3>
        <p><strong>Eastern Time = Central Time + 1 Hour</strong></p>
      </article>
      <article class="method-card">
        <h3>Examples</h3>
        <ul>
          <li>9:00 AM CDT = 10:00 AM EDT</li>
          <li>11:00 AM CDT = 12:00 PM EDT</li>
          <li>2:00 PM CDT = 3:00 PM EDT</li>
          <li>5:00 PM CDT = 6:00 PM EDT</li>
          <li>8:00 PM CDT = 9:00 PM EDT</li>
        </ul>
      </article>
    </div>
  </section>

  <section class="content" aria-labelledby="real-world-examples-title">
    <h2 id="real-world-examples-title">Real-World CDT to EST Examples</h2>
    <p>Below are common schedule sync examples between Central and Eastern municipalities demonstrating the practical 1-hour difference:</p>
    <ul>
      <li><strong>Chicago to New York</strong>: If a Zoom meeting starts at 9:00 AM in Chicago (CDT), participants in New York (EDT) should join at 10:00 AM Eastern Time.</li>
      <li><strong>Dallas to Atlanta</strong>: A football game beginning at 7:00 PM in Dallas (CDT) airs at 8:00 PM in Atlanta (EDT).</li>
      <li><strong>Houston to Miami</strong>: A business webinar scheduled for 11:00 AM Houston time (CDT) begins at 12:00 PM Miami time (EDT).</li>
    </ul>
  </section>

  <section class="examples-section" aria-labelledby="cdt-vs-est-title">
    <h2 id="cdt-vs-est-title">CDT vs EST: What's the Difference?</h2>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Feature</th><th>CDT</th><th>EST</th></tr>
        </thead>
        <tbody>
          <tr><td>Full Name</td><td>Central Daylight Time</td><td>Eastern Standard Time</td></tr>
          <tr><td>UTC Offset</td><td>UTC-5</td><td>UTC-5</td></tr>
          <tr><td>Region</td><td>Central Time Zone</td><td>Eastern Time Zone</td></tr>
          <tr><td>Typical Cities</td><td>Chicago, Dallas, Houston</td><td>New York, Miami, Atlanta</td></tr>
          <tr><td>DST Status</td><td>Summer Time</td><td>Winter Standard Time</td></tr>
        </tbody>
      </table>
    </div>
    <p><strong>Important Note:</strong> Many people search for CDT to EST, but during summer months the practical comparison is usually <strong>CDT to EDT</strong> because Eastern locations observe Eastern Daylight Time (EDT) while Central locations observe Central Daylight Time (CDT). For daily scheduling, Eastern Time remains 1 hour ahead of Central Time.</p>
  </section>

  <section class="examples-section" aria-labelledby="meeting-planner-title">
    <h2 id="meeting-planner-title">Central Time to Eastern Time Meeting Planner</h2>
    <p>These overlap hours are ideal for remote teams, client meetings, virtual conferences, webinars, and customer support operations:</p>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Central Time</th><th>Eastern Time</th><th>Status</th></tr>
        </thead>
        <tbody>
          <tr><td>8:00 AM</td><td>9:00 AM</td><td>Good overlap</td></tr>
          <tr><td>9:00 AM</td><td>10:00 AM</td><td>Best overlap hours</td></tr>
          <tr><td>10:00 AM</td><td>11:00 AM</td><td>Best overlap hours</td></tr>
          <tr><td>11:00 AM</td><td>12:00 PM</td><td>Best overlap hours</td></tr>
          <tr><td>12:00 PM</td><td>1:00 PM</td><td>Lunch hour overlap</td></tr>
          <tr><td>1:00 PM</td><td>2:00 PM</td><td>Best overlap hours</td></tr>
          <tr><td>2:00 PM</td><td>3:00 PM</td><td>Best overlap hours</td></tr>
          <tr><td>3:00 PM</td><td>4:00 PM</td><td>Best overlap hours</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="content" aria-labelledby="dst-rules-title">
    <h2 id="dst-rules-title">Daylight Saving Time Rules</h2>
    <p>Daylight saving transitions happen at the same time in both time zones:</p>
    <ul>
      <li><strong>Central Time:</strong> CDT (Daylight Saving) is UTC-5, CST (Standard Time) is UTC-6.</li>
      <li><strong>Eastern Time:</strong> EDT (Daylight Saving) is UTC-4, EST (Standard Time) is UTC-5.</li>
      <li><strong>DST Change Dates:</strong> Daylight saving begins on the second Sunday in March and ends on the first Sunday in November.</li>
    </ul>
    <p>The 1-hour difference between Central and Eastern Time remains consistent throughout the year.</p>
  </section>

  <section class="content" aria-labelledby="popular-searches-title">
    <h2 id="popular-searches-title">Popular CDT to EST Searches</h2>
    <ul>
      <li><strong>What is 5 PM CDT in EST?</strong> 5:00 PM Central Time converts to 6:00 PM Eastern Time.</li>
      <li><strong>What is 8 PM CDT in EST?</strong> 8:00 PM Central Time converts to 9:00 PM Eastern Time.</li>
      <li><strong>What is 11 AM CDT in EST?</strong> 11:00 AM Central Time converts to 12:00 PM Eastern Time.</li>
      <li><strong>What is 12 PM CDT in EST?</strong> 12:00 PM Central Time converts to 1:00 PM Eastern Time.</li>
      <li><strong>What is 1 PM CDT in EST?</strong> 1:00 PM Central Time converts to 2:00 PM Eastern Time.</li>
    </ul>
  </section>

  <section class="faq" aria-labelledby="faq-title">
    <h2 id="faq-title">Frequently Asked Questions</h2>
    <details>
      <summary>Is CDT the same as EST?</summary>
      <p>No. Although both can share a UTC-5 offset under specific circumstances, Central Time and Eastern Time are treated as separate time zones. Eastern Time is typically 1 hour ahead of Central Time.</p>
    </details>
    <details>
      <summary>What is the time difference between Central and Eastern Time?</summary>
      <p>Eastern Time is 1 hour ahead of Central Time.</p>
    </details>
    <details>
      <summary>How many hours is CDT behind EST?</summary>
      <p>For practical scheduling, CDT is 1 hour behind Eastern Time.</p>
    </details>
    <details>
      <summary>Why does Google show CDT and EST with the same UTC offset?</summary>
      <p>CDT uses UTC-5 while EST also uses UTC-5. However, EST is generally used during winter while CDT is used during summer, so they are not normally observed simultaneously in major US cities.</p>
    </details>
    <details>
      <summary>Is New York in CDT or EST?</summary>
      <p>New York uses Eastern Time: EDT (summer) and EST (winter).</p>
    </details>
    <details>
      <summary>Is Chicago in CDT or EST?</summary>
      <p>Chicago uses Central Time: CDT (summer) and CST (winter).</p>
    </details>
  </section>

  <section class="other-tools" aria-labelledby="related-converters-title">
    <h2 id="related-converters-title">Related Time Zone Converters</h2>
    <div class="related-grid">
      <article class="related-card">
        <h3><a href="/">GMT to EST Converter</a></h3>
        <p>Convert Greenwich Mean Time (GMT) to Eastern Standard Time (EST) using our primary converter.</p>
      </article>
      <article class="related-card">
        <h3><a href="/est-to-gmt/">EST to GMT Converter</a></h3>
        <p>Convert Eastern Standard Time (EST) back to Greenwich Mean Time (GMT) instantly.</p>
      </article>
      <article class="related-card">
        <h3><a href="/gmt-vs-est/">GMT vs EST Difference</a></h3>
        <p>Compare offsets, DST rules, and transition calendars for GMT and EST.</p>
      </article>
      <article class="related-card">
        <h3><a href="/time-zone-guide/">Time Zone Guide</a></h3>
        <p>A complete reference to offsets, abbreviations, and global scheduling standards.</p>
      </article>
    </div>
  </section>
</BaseLayout>
