const seoTitle = "International Date Line Explained: 180° Meridian & Date Shifts";
const pageDescription = "Complete guide to the International Date Line (IDL). Learn why crossing the 180° meridian changes calendar dates, Kiribati zigzag deviations, and travel math.";

const pubDate = "2026-07-30T10:00:00+05:00";
const updatedDate = "2026-07-30T10:00:00+05:00";

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "International Date Line, IDL explained, 180 meridian time zone, cross date line day gain loss, Kiribati time zone, Samoa date line jump, time travel aviation date line, UTC+14 to UTC-12",
  image: "/assets/international-date-line-diagram.svg",
  imageAlt: "International Date Line Map and Directional Date Shift Mechanics",
  pubDate,
  updatedDate,
  author: "Jackie Bruce",
  faqs: [
    {
      q: "What is the International Date Line (IDL)?",
      a: "The International Date Line (IDL) is an internationally recognized imaginary line located roughly along the 180° meridian in the Pacific Ocean that marks the boundary between one calendar day and the next."
    },
    {
      q: "What happens when you cross the International Date Line travelling West?",
      a: "When travelling WEST across the International Date Line (from North America toward Asia/Australia), you ADD one calendar day (+1 day), skipping ahead to tomorrow."
    },
    {
      q: "What happens when you cross the International Date Line travelling East?",
      a: "When travelling EAST across the International Date Line (from Asia/Australia toward North America), you SUBTRACT one calendar day (-1 day), repeating yesterday."
    },
    {
      q: "Why is the International Date Line not a straight line?",
      a: "The Date Line zigzags around island nations and political territories so that entire island groups (like Kiribati, Samoa, and the Aleutian Islands) share the same calendar date as their main trading partners."
    },
    {
      q: "Where is the International Date Line located?",
      a: "The Date Line is located opposite the Prime Meridian (0° longitude) in Greenwich, London, running through the mid-Pacific Ocean at roughly 180° longitude."
    },
    {
      q: "Why did Samoa jump across the International Date Line in 2011?",
      a: "Samoa jumped across the Date Line in December 2011 (shifting from UTC-11 to UTC+13) to align its calendar workdays with Australia and New Zealand, its primary trading partners."
    },
    {
      q: "Why does Kiribati have a UTC+14 time zone?",
      a: "In 1994, Kiribati moved the Date Line 3,000 kilometers eastward around its easternmost Line Islands so that the entire nation operated on the same calendar date, creating the world's furthest forward timezone: UTC+14."
    },
    {
      q: "What was Magellan's crew date discrepancy?",
      a: "When Ferdinand Magellan's surviving crew returned to Spain in 1522 after circumnavigating the globe westward, their ship log showed July 9, while land clocks showed July 10, proving the physical necessity of an international date boundary."
    },
    {
      q: "Can you celebrate New Year's Eve twice by crossing the Date Line?",
      a: "Yes. By celebrating midnight on January 1 in Samoa or Auckland, and then taking a short flight across the Date Line to American Samoa or Honolulu, travelers can ring in the New Year twice!"
    },
    {
      q: "What is the time difference across the Bering Strait?",
      a: "Big Diomede Island (Russia) and Little Diomede Island (US) are separated by just 2.4 miles (3.8 km) in the Bering Strait, but because the Date Line passes between them, they are separated by 21 hours!"
    },
    {
      q: "Is the International Date Line governed by international law?",
      a: "No. Unlike territorial waters, the International Date Line is governed by international convention and local national decrees rather than a binding UN treaty."
    },
    {
      q: "How does flying across the Date Line affect flight durations?",
      a: "While physical flight duration remains the same (e.g. 10 hours from Sydney to Los Angeles), local arrival clock time can land on the exact same hour—or even an earlier hour—than departure!"
    },
    {
      q: "What is the difference between the Prime Meridian and the International Date Line?",
      a: "The Prime Meridian (0° longitude) in Greenwich defines the start of global UTC time measurement. The International Date Line (180° longitude) defines the start and end of calendar dates."
    },
    {
      q: "What happens if a baby is born on a ship crossing the International Date Line?",
      a: "Maritime birth certificates record the official calendar date and UTC timestamp of the ship's local position at the moment of birth."
    },
    {
      q: "What is UTC-12:00?",
      a: "UTC-12:00 is the timezone immediately west of the International Date Line, covering uninhabited US territories like Baker Island and Howland Island."
    },
    {
      q: "What is UTC+14:00?",
      a: "UTC+14:00 is the earliest timezone on Earth, located immediately east of the Date Line in Kiritimati (Line Islands, Kiribati)."
    },
    {
      q: "How do computer databases calculate date shifts across the 180th meridian?",
      a: "Databases convert all input timestamps into standard <a href=\"/what-is-utc/\">UTC</a>, performing date arithmetic on atomic UTC millisecond values before rendering local date strings."
    },
    {
      q: "How do I convert time zones near the Date Line?",
      a: "Use our <a href=\"/how-to-convert-time-zones/\">3-step conversion algorithm</a>: convert local time to UTC, then apply the target offset."
    },
    {
      q: "Why is Greenwich Mean Time (GMT) 12 hours away from the Date Line?",
      a: "Because the Date Line sits at 180° longitude—exactly halfway around the 360° globe from the 0° Greenwich meridian (180° / 15° = 12 hours)."
    },
    {
      q: "Where can I calculate global conversions across the Date Line?",
      a: "Use our free <a href=\"/\">GMT to EST Converter</a> and <a href=\"/world-time-zones-guide/\">World Time Zones Guide</a>."
    }
  ]
};

