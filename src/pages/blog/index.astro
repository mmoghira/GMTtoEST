---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import { getPageMeta, siteUrl } from "theme/i18n/config";
import { getCollection } from "astro:content";
import { ensureKeywordInAlt, getConciseDisplayTitle, getPrimaryKeyword } from "theme/utils/seo";

const metaBase = getPageMeta("en", "home"); // fallback
const meta = {
  title: "Blog - GMT to EST",
  seoTitle: "GMT to EST Blog – Timezone Guides, DST Updates & Conversion Tips",
  description: "Read the latest updates and articles about GMT and EST timezone conversions, daylight saving time changes, and scheduling across time zones.",
  keywords: "GMT to EST blog, EST to GMT guides, timezone conversion articles, daylight saving time",
  image: "/assets/gmt-to-est-converter-featured-image-960.avif",
  imageAlt: "GMT to EST Converter blog – timezone guides and conversion tips",
  ogType: "website",
  twitterCard: "summary_large_image",
  robots: "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"
};

const pageUrl = `${siteUrl}/blog/`;

const allPosts = await getCollection("blog");
const posts = allPosts
  .filter(post => post.id.startsWith("en/"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout lang="en" dir="ltr" title={meta.title} description={meta.description} slug="blog" meta={meta}>
  <section class="content blog-index" aria-labelledby="blog-title">
    <h1 id="blog-title">Blog</h1>
    <p>Read the latest updates, guides, and articles about GMT and EST timezones.</p>
    
    <div class="blog-grid">
      {posts.length === 0 ? (
        <p>No articles published yet. Check back soon!</p>
      ) : (
        posts.map(post => {
          const slug = post.id.split('/').slice(1).join('/');
          const primaryKeyword = getPrimaryKeyword(post.data.keywords, post.data.title);
          const imageAlt = ensureKeywordInAlt(post.data.imageAlt, primaryKeyword, `${primaryKeyword} featured image`);
          const responsiveImageBase = post.data.image?.endsWith("-1200.webp") ? post.data.image.replace("-1200.webp", "") : "";
          return (
            <article class="blog-card">
              {post.data.image && (
                <a class="blog-card-image" href={`/blog/${slug}/`} aria-label={post.data.title}>
                  <span class="sr-only">{post.data.title}</span>
                  <picture>
                    {responsiveImageBase && <source type="image/avif" srcset={`${responsiveImageBase}-600.avif 600w, ${responsiveImageBase}-1200.avif 1200w`} sizes="(max-width: 760px) 100vw, 360px" />}
                    {responsiveImageBase && <source type="image/webp" srcset={`${responsiveImageBase}-600.webp 600w, ${responsiveImageBase}-1200.webp 1200w`} sizes="(max-width: 760px) 100vw, 360px" />}
                    <img src={post.data.image} alt={imageAlt} width="1200" height="630" loading="lazy" decoding="async" />
                  </picture>
                </a>
              )}
              <div class="blog-card-body">
                <h2><a href={`/blog/${slug}/`}>{getConciseDisplayTitle(slug, post.data.title)}</a></h2>
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
                </time>
                <p>{post.data.description}</p>
                <a class="read-more" href={`/blog/${slug}/`}>Read {post.data.title} &rarr;</a>
              </div>
            </article>
          );
        })
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .blog-index {
    display: block;
    max-width: 1080px;
  }

  .blog-index > p {
    max-width: 66ch;
    color: var(--muted);
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
    margin-top: 28px;
  }

  .blog-card {
    display: grid;
    overflow: hidden;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
    box-shadow: 0 14px 32px rgba(15, 23, 42, .07);
  }

  .blog-card-image {
    display: block;
    aspect-ratio: 1200 / 630;
    overflow: hidden;
    background: color-mix(in srgb, var(--accent) 8%, var(--bg));
  }

  .blog-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .blog-card-body {
    display: grid;
    gap: 10px;
    padding: 18px;
  }

  .blog-card h2 {
    margin: 0;
    font-size: clamp(1.18rem, 2vw, 1.45rem);
    line-height: 1.18;
  }

  .blog-card h2 a {
    color: var(--accent);
  }

  .blog-card time {
    color: var(--muted);
    font-size: .9rem;
  }

  .blog-card p {
    margin: 0;
    color: var(--muted);
  }

  .read-more {
    width: fit-content;
    color: var(--accent);
    font-weight: 800;
  }
</style>
