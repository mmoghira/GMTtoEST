---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import Converter from "theme/components/Converter.astro";
import { getTranslation, siteUrl } from "theme/i18n/config";

const lang = "en";
const dir = "ltr";
const slug = "gmt-to-ist";
const t = getTranslation(lang);

const pageTitle = "GMT to IST Converter";
const seoTitle = "GMT to IST Converter: Live 2026 Clocks & IST Offset";
const pageDescription = "Convert GMT to IST instantly with live Mumbai and Delhi clocks. View the 5.5-hour time difference and 24-hour table. Check your exact meeting time now.";

const context = {
  from: "GMT",
  to: "IST",
  fromZone: "UTC",
  toZone: "Asia/Kolkata"
};

const canonical = `${siteUrl}/gmt-to-ist/`;

// 24-hour conversion table data (GMT → IST = GMT + 5.5 hours)
function formatHour12(hour: number, minute: number = 0) {
  const normalized = ((hour % 24) + 24) % 24;
  const period = normalized < 12 ? "AM" : "PM";
  const displayHour = normalized % 12 || 12;
  return `${displayHour}:${String(minute).padStart(2, "0")} ${period}`;
}

const conversionRows = Array.from({ length: 24 }, (_, hour) => {
  const totalMinutes = hour * 60 + 330; // Add 5 hours 30 minutes
  const istHour = Math.floor(totalMinutes / 60);
  const istMinute = totalMinutes % 60;
  const istHourNormalized = istHour % 24;
  const nextDay = istHour >= 24;
  const period = istHourNormalized < 12 ? "AM" : "PM";
  const displayHour = istHourNormalized % 12 || 12;
  return {
    gmt: formatHour12(hour),
    ist: `${displayHour}:${String(istMinute).padStart(2, "0")} ${period}${nextDay ? " (+1 day)" : ""}`,
    dayNote: nextDay ? "Next day" : "Same day"
  };
});

// Popular conversions
const popularConversions = [
  { gmt: "12:00 AM (Midnight)", ist: "5:30 AM IST", note: "Dawn in India, midnight in Greenwich" },
  { gmt: "2:00 AM", ist: "7:30 AM IST", note: "Morning routines in Mumbai, night in London" },
  { gmt: "4:00 AM", ist: "9:30 AM IST", note: "Workday beginning in New Delhi, early morning in London" },
  { gmt: "6:00 AM", ist: "11:30 AM IST", note: "Mid-morning focus in Bengaluru, morning in Greenwich" },
  { gmt: "8:00 AM", ist: "1:30 PM IST", note: "Lunch break in Hyderabad, workday starting in London" },
  { gmt: "10:00 AM", ist: "3:30 PM IST", note: "Mid-afternoon in Chennai, morning in Greenwich" },
  { gmt: "12:00 PM (Noon)", ist: "5:30 PM IST", note: "Evening winding down in Kolkata, noon in Greenwich" },
  { gmt: "2:00 PM", ist: "7:30 PM IST", note: "Dinner hours in India, afternoon in London" },
  { gmt: "4:00 PM", ist: "9:30 PM IST", note: "Late evening in Pune, end of standard office hours in London" },
  { gmt: "6:00 PM", ist: "11:30 PM IST", note: "Night in Ahmedabad, evening in Greenwich" },
  { gmt: "8:00 PM", ist: "1:30 AM IST (+1 day)", note: "After midnight in India, night in London" },
  { gmt: "10:00 PM", ist: "3:30 AM IST (+1 day)", note: "Late night in Jaipur, late night in Greenwich" }
];

// FAQ data
const faqs = [
  {
    q: "What is the time difference between GMT and IST?",
    a: "IST (India Standard Time) is 5 hours and 30 minutes ahead of GMT. The difference never changes, because India does not observe daylight saving time."
  },
  {
    q: "What is 12 PM GMT in IST?",
    a: "12 PM GMT is 5:30 PM IST on the same day."
  },
  {
    q: "Does the GMT to IST time difference change in summer?",
    a: "No. Neither GMT nor IST observes daylight saving, so the gap stays 5 hours 30 minutes all year — unlike GMT to EST, which changes between 5 and 4 hours."
  }
];

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "GMT to IST, GMT to Indian Standard Time, Greenwich Mean Time to IST, GMT IST Converter, Convert GMT to IST, Current IST Time, GMT UTC to IST, India Time Converter, GMT to India Time, GMT to New Delhi Time, GMT to Mumbai Time, GMT to Bangalore Time, GMT to Hyderabad Time, GMT to Chennai Time, Time Difference GMT and IST",
  image: "/assets/gmt-to-ist-og.svg",
  imageAlt: "GMT to IST Converter – Convert Greenwich Mean Time to Indian Standard Time",
  faqs,
  appDescription: "Free online GMT to IST converter with real-time clocks, DST-aware calculation, 24-hour conversion chart, and meeting planner for scheduling between Greenwich Mean Time and Indian Standard Time.",
  applicationCategory: "UtilityApplication",
  operatingSystem: "Any",
  howToName: "How to Convert GMT to IST",
  howToDescription: "Step-by-step guide to converting Greenwich Mean Time to Indian Standard Time using our free online tool.",
  howToSteps: [
    { name: "Confirm Indian Standard Time offset", text: "IST is always UTC+5:30. India does not observe daylight saving, meaning the offset remains constant year-round." },
    { name: "Input your GMT time", text: "Select your desired GMT time using our interactive date-time picker. The tool defaults to the current time." },
    { name: "Observe the calculated result", text: "Our calculator checks the date and displays the result in IST (+5:30 offset) automatically." },
    { name: "Copy or swap the result", text: "Read the converted Indian Standard Time and click the copy button to save the result." }
  ],
};
