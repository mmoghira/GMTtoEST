---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import Converter from "theme/components/Converter.astro";
import { getTranslation, pageUrl, siteUrl } from "theme/i18n/config";

const lang = "en";
const dir = "ltr";
const slug = "gmt-to-ast";
const t = getTranslation(lang);

const pageTitle = "GMT to AST Converter";
const seoTitle = "GMT to AST Converter – Greenwich Mean Time to Atlantic Standard Time";
const pageDescription = "Convert GMT to AST instantly. Calculate the exact 4-hour time difference between Greenwich Mean Time and Atlantic Standard Time with live clocks, meeting planners, and conversion tables.";

const context = {
  from: "GMT",
  to: "AST",
  fromZone: "UTC",
  toZone: "America/Halifax"
};

const canonical = `${siteUrl}/gmt-to-ast/`;

// 24-hour conversion table data (GMT → AST = GMT - 4 hours)
function formatHour12(hour: number) {
  const normalized = ((hour % 24) + 24) % 24;
  const period = normalized < 12 ? "AM" : "PM";
  const displayHour = normalized % 12 || 12;
  return `${displayHour}:00 ${period}`;
}

const conversionRows = Array.from({ length: 24 }, (_, hour) => {
  const astHour = hour - 4;
  const astNormalized = ((astHour % 24) + 24) % 24;
  const prevDay = astHour < 0;
  const period = astNormalized < 12 ? "AM" : "PM";
  const displayHour = astNormalized % 12 || 12;
  return {
    gmt: formatHour12(hour),
    ast: `${displayHour}:00 ${period}${prevDay ? " (-1 day)" : ""}`,
    dayNote: prevDay ? "Previous day" : "Same day"
  };
});

// Popular conversions
const popularConversions = [
  { gmt: "12:00 AM (Midnight)", ast: "8:00 PM (Prev Day)", note: "Late evening in Halifax/Puerto Rico, midnight in London" },
  { gmt: "4:00 AM", ast: "12:00 AM (Midnight)", note: "Night in Greenwich, midnight in Atlantic Canada" },
  { gmt: "8:00 AM", ast: "4:00 AM", note: "London office day kick-off, pre-dawn in Nova Scotia" },
  { gmt: "10:00 AM", ast: "6:00 AM", note: "Mid-morning focus in UK, early sunrise in San Juan" },
  { gmt: "12:00 PM (Noon)", ast: "8:00 AM", note: "Lunch break in London, Atlantic Canada workday opening" },
  { gmt: "1:00 PM", ast: "9:00 AM", note: "Early afternoon in UK, active morning in Halifax & Bermuda" },
  { gmt: "3:00 PM", ast: "11:00 AM", note: "Mid-afternoon in London, late morning in Puerto Rico" },
  { gmt: "5:00 PM", ast: "1:00 PM", note: "End of European office hours, lunch hour in Atlantic Time" },
  { gmt: "7:00 PM", ast: "3:00 PM", note: "Evening relaxation in UK, mid-afternoon in Halifax" },
  { gmt: "9:00 PM", ast: "5:00 PM", note: "Night in London, end of workday in Atlantic Canada" },
  { gmt: "11:00 PM", ast: "7:00 PM", note: "Bedtime in London, dinner time in San Juan" },
  { gmt: "11:59 PM", ast: "7:59 PM", note: "End of GMT calendar day, evening in Atlantic zone" }
];

// FAQ data
const faqs = [
  { q: "What is the time difference between GMT and AST?", a: "Atlantic Standard Time (AST, UTC-4) is exactly 4 hours behind Greenwich Mean Time (GMT, UTC+0). When it is 5:00 PM GMT in London, it is 1:00 PM AST in Halifax or San Juan." },
  { q: "What does AST stand for?", a: "AST stands for Atlantic Standard Time. It represents the standard time zone covering Atlantic Canada, Puerto Rico, the US Virgin Islands, and several Caribbean nations, operating at UTC-4." },
  { q: "What does GMT stand for?", a: "GMT stands for Greenwich Mean Time. It is the universal time standard baseline centered at the Royal Observatory in Greenwich, London, operating at UTC+0." },
  { q: "Does the 4-hour gap between GMT and AST change during daylight saving time?", a: "In Atlantic Canada (Nova Scotia, New Brunswick, PEI), clocks advance by 1 hour to Atlantic Daylight Time (ADT, UTC-3) in summer. When the UK enters British Summer Time (BST, UTC+1), the gap between local UK time and local Atlantic Canadian time remains 4 hours. However, in non-DST regions like Puerto Rico, the gap between local UK summer time (BST, UTC+1) and AST (UTC-4) widens to 5 hours." },
  { q: "Which major Canadian cities use Atlantic Standard Time (AST)?", a: "Canadian cities observing AST (UTC-4) in winter include Halifax (Nova Scotia), Moncton and Saint John (New Brunswick), and Charlottetown (Prince Edward Island)." },
  { q: "Which Caribbean islands and territories use AST year-round without DST?", a: "Puerto Rico, the US Virgin Islands, Bermuda, Barbados, Trinidad & Tobago, Grenada, Saint Lucia, and the Dominican Republic observe AST (UTC-4) year-round without daylight saving adjustments." },
  { q: "Which European cities observe Greenwich Mean Time (GMT)?", a: "Cities observing GMT (UTC+0) during winter include London, Dublin, Lisbon, Reykjavik, and Accra." },
  { q: "How do I convert GMT to AST manually?", a: "To convert GMT to AST manually, subtract 4 hours from the GMT time. For example, 3:00 PM GMT (15:00) minus 4 hours equals 11:00 AM AST. If the result goes below zero, subtract from 24 to find the previous day's time." },
  { q: "What is the best time for a meeting between London (GMT) and Halifax (AST)?", a: "The best overlap window is between 1:00 PM and 5:00 PM GMT, which aligns with 9:00 AM to 1:00 PM AST. This allows Atlantic Canadian teams to collaborate comfortably during their morning hours." },
  { q: "Why is GMT to AST coordination important for transatlantic shipping?", a: "Port operations in Halifax, St. John's, and Caribbean ports manage transatlantic container vessels and cruise liners arriving from Europe. Aligning port schedules across GMT and AST is essential for maritime logistics." },
  { q: "Is Newfoundland in the AST time zone?", a: "No. The island of Newfoundland observes Newfoundland Standard Time (NST, UTC-3:30), which is 30 minutes ahead of Atlantic Standard Time." },
  { q: "What is the IANA identifier for GMT?", a: "In computer systems, GMT is represented by the IANA database identifier 'UTC' or 'Etc/GMT'." },
  { q: "What is the IANA identifier for Atlantic Standard Time?", a: "The primary IANA database identifier for Atlantic Standard Time is 'America/Halifax' for Canada or 'America/Puerto_Rico' for the Caribbean." },
  { q: "What time is 12 PM GMT in AST?", a: "12:00 PM (Noon) GMT equals 8:00 AM AST on the same day." },
  { q: "What time is 5 PM GMT in AST?", a: "5:00 PM GMT equals 1:00 PM AST on the same day." },
  { q: "What time is 8 PM GMT in AST?", a: "8:00 PM GMT equals 4:00 PM AST on the same day." },
  { q: "What time is 10 PM GMT in AST?", a: "10:00 PM GMT equals 6:00 PM AST on the same day." },
