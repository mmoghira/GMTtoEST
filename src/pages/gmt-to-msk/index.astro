---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import Converter from "theme/components/Converter.astro";
import { getTranslation } from "theme/i18n/config";

const lang = "en";
const dir = "ltr";
const slug = "gmt-to-msk";
const t = getTranslation(lang);

const pageTitle = "GMT to MSK Converter";
const seoTitle = "GMT to MSK Converter – Convert GMT to Moscow Standard Time";
const pageDescription = "Convert GMT to MSK instantly with our free timezone converter. Moscow Standard Time (MSK) is UTC+3, which is 3 hours ahead of Greenwich Mean Time (GMT). Includes conversion tables, practical examples, date-change handling, and Russian timezone details.";

const context = {
  from: "GMT",
  to: "MSK",
  fromZone: "UTC",
  toZone: "Europe/Moscow"
};

function formatHour12(hour: number) {
  const ampm = hour >= 12 ? "PM" : "AM";
  const h = hour % 12 || 12;
  return `${h}:00 ${ampm}`;
}

// 24-hour table: GMT (UTC+0) → MSK (UTC+3) = add 3 hours
const conversionRows = Array.from({ length: 24 }, (_, hour) => {
  let mskHour = hour + 3;
  const nextDay = mskHour >= 24;
  if (nextDay) mskHour -= 24;
  return {
    gmt: formatHour12(hour),
    msk: `${formatHour12(mskHour)}${nextDay ? " (+1 day)" : ""}`,
    dayNote: nextDay ? "Next day" : "Same day"
  };
});

const faqs = [
  {
    q: "What is the difference between GMT and MSK?",
    a: "GMT (Greenwich Mean Time) is the zero-offset baseline at UTC+0. MSK (Moscow Standard Time) operates at UTC+3, making MSK exactly 3 hours ahead of GMT year-round. When it is 12:00 PM (noon) GMT in London, it is 3:00 PM MSK in Moscow."
  },
  {
    q: "Is MSK 3 hours ahead of GMT?",
    a: "Yes. Moscow Standard Time (MSK, UTC+3) is permanently 3 hours ahead of Greenwich Mean Time (GMT, UTC+0). To convert GMT to MSK, simply add 3 hours."
  },
  {
    q: "What does MSK stand for?",
    a: "MSK stands for Moscow Standard Time (Московское время). It is the official time zone designation for Moscow and the surrounding regions in western Russia."
  },
  {
    q: "What is MSK in UTC?",
    a: "MSK operates at UTC+3 (Coordinated Universal Time plus 3 hours). It remains at UTC+3 year-round without seasonal adjustments."
  },
  {
    q: "How do I convert GMT to MSK?",
    a: "Add 3 hours to the GMT time. For example, 9:00 AM GMT plus 3 hours equals 12:00 PM (noon) MSK. If adding 3 hours crosses midnight (e.g., 10:00 PM GMT + 3 hours = 1:00 AM MSK), advance the date by one day."
  },
  {
    q: "What time is 12 PM GMT in MSK?",
    a: "12:00 PM (noon) GMT is 3:00 PM MSK on the same calendar day."
  },
  {
    q: "What time is midnight GMT in MSK?",
    a: "Midnight (00:00) GMT is 3:00 AM MSK on the same calendar day."
  },
  {
    q: "Does Moscow use daylight saving time?",
    a: "No. Russia abolished seasonal daylight saving time changes in 2014, fixing Moscow Standard Time at permanent UTC+3 year-round. The 3-hour difference between GMT and MSK remains constant every month of the year."
  },
  {
    q: "Is MSK used throughout all of Russia?",
    a: "No. Russia spans 11 distinct time zones, ranging from UTC+2 (Kaliningrad) to UTC+12 (Kamchatka). MSK (UTC+3) applies to Moscow, Saint Petersburg, Nizhny Novgorod, Kazan, Sochi, and most of European Russia. MSK also serves as the reference time zone for Russian railway timetables and flight schedules nation-wide."
  },
  {
    q: "Can GMT and MSK have different calendar dates?",
    a: "Yes. Because MSK is 3 hours ahead of GMT, any GMT time between 9:00 PM (21:00) and 11:59 PM (23:59) corresponds to the following calendar day in MSK. For example, 10:00 PM GMT on May 15 is 1:00 AM MSK on May 16."
  },
  {
    q: "What time is 18:00 GMT in Moscow?",
    a: "18:00 (6:00 PM) GMT is 21:00 (9:00 PM) MSK in Moscow on the same day."
  },
  {
    q: "Is Moscow Time always UTC+3?",
    a: "Yes. Under current Russian federal law enacted in October 2014, Moscow Standard Time is permanently fixed at UTC+3 without seasonal daylight saving transitions."
  }
];

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "gmt to msk, GMT to MSK converter, convert GMT to MSK, GMT MSK conversion, GMT time to MSK, GMT to Moscow Time, GMT to Moscow Standard Time, GMT and MSK difference, GMT vs MSK, MSK UTC+3, Moscow Time converter, what is MSK time",
  image: "/assets/gmt-to-msk-converter.webp",
  imageAlt: "GMT to MSK converter comparing Greenwich Mean Time and Moscow Standard Time",
  faqs,
  appDescription: "Free online GMT to MSK converter featuring live clocks, 24-hour schedules, instant time calculations, and date-change tracking between Greenwich Mean Time and Moscow Standard Time.",
  applicationCategory: "UtilityApplication",
  operatingSystem: "Any",
  howToName: "How to Convert GMT to MSK",
  howToDescription: "Convert Greenwich Mean Time (GMT, UTC+0) to Moscow Standard Time (MSK, UTC+3) by adding 3 hours.",
  howToSteps: [
    { name: "Start with GMT time", text: "Identify the current Greenwich Mean Time (GMT / UTC+0)." },
    { name: "Add 3 hours", text: "Add exactly 3 hours to the GMT time value." },
    { name: "Check for date change", text: "If the result crosses midnight (00:00), advance the calendar date by one day." },
    { name: "Read the MSK result", text: "The resulting value is Moscow Standard Time (MSK, UTC+3)." }
  ]
};
---

<BaseLayout
  lang={lang}
  dir={dir}
  title={seoTitle}
  description={pageDescription}
  slug={slug}
  meta={meta}
  mode="gmt-est"
  enableFaqSchema={true}
>

  <!-- Breadcrumb -->
  <nav aria-label="Breadcrumb" style="max-width: 1000px; margin: 1.5rem auto 0; padding: 0 16px;">
    <ol style="display: flex; align-items: center; gap: 0.5rem; list-style: none; padding: 0; margin: 0; font-size: 0.92rem; color: var(--text-muted);">
      <li><a href="/" style="color: var(--accent); text-decoration: none;">Home</a></li>
      <li style="color: var(--text-muted);">›</li>
      <li style="color: var(--text-primary);">GMT to MSK Converter</li>
    </ol>
  </nav>

  <!-- Hero Section -->
  <header class="hero-banner" style="text-align: center; padding: 2.5rem 16px 2rem;">
    <div class="hero-content" style="max-width: 800px; margin: 0 auto;">
      <span class="eyebrow">Time Zone Converter</span>
      <h1 class="hero-banner-title">GMT to <span class="gradient-text">MSK</span> Converter</h1>
      <p class="hero-subtitle" style="font-size: 1.15rem; max-width: 700px; margin: 0.75rem auto 0;">
        Convert Greenwich Mean Time (GMT) to Moscow Standard Time (MSK) instantly. MSK is <strong>UTC+3</strong>, which is <strong>3 hours ahead</strong> of GMT. Our converter calculates precise times and handles date changes automatically.
      </p>
    </div>
  </header>

  <!-- Hero Image -->
  <div style="max-width: 750px; margin: 0 auto 2rem; padding: 0 16px;">
    <img
      src="/assets/gmt-to-msk-converter.webp"
      alt="GMT to MSK converter comparing Greenwich Mean Time and Moscow Standard Time"
      width="1200" height="800"
      loading="eager"
      style="width: 100%; height: auto; border-radius: 12px; border: 1px solid var(--line);"
    />
  </div>

  <!-- Converter Tool -->
  <section style="max-width: 700px; margin: 0 auto 3rem; padding: 0 16px;" aria-label="GMT to MSK time converter">
    <Converter
      from={context.from}
      to={context.to}
      fromZone={context.fromZone}
      toZone={context.toZone}
      t={t}
      lang={lang}
    />
  </section>

  <!-- Main Content -->
  <article style="max-width: 800px; margin: 0 auto; padding: 0 16px 3rem;">

    <!-- GMT to MSK Time Difference -->
    <section class="content-section" style="margin-bottom: 2.5rem;">
      <h2>GMT to MSK Time Difference</h2>
      <p>
        The mathematical relationship between GMT and MSK is simple and permanent: <strong>MSK is always 3 hours ahead of GMT</strong>. Greenwich Mean Time (GMT) operates at the UTC+0 baseline reference, while Moscow Standard Time (MSK) operates at UTC+3. This creates a constant 3-hour difference that applies 365 days a year.
      </p>
      <p>
        Because Russia abolished seasonal daylight saving time transitions in October 2014, Moscow Standard Time remains fixed at UTC+3 throughout all 12 months. Unlike time zone pairs involving countries with bi-annual clock shifts, the GMT-to-MSK offset does not fluctuate between summer and winter.
      </p>
      <div style="background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 1.5rem; text-align: center; margin: 1.5rem 0;">
        <p style="font-size: 1.3rem; font-weight: 700; margin: 0; color: var(--accent);">GMT + 3 hours = MSK</p>
        <p style="font-size: 0.95rem; margin: 0.5rem 0 0; color: var(--text-muted);">UTC+0 → UTC+3 • Moscow Standard Time is permanently 3 hours ahead</p>
      </div>
      <p>
        The 3-hour positive offset means that local time in Moscow is always later in the day than GMT. For late-evening GMT hours (from 9:00 PM onward), adding 3 hours crosses midnight, advancing the local MSK time into the next calendar day.
      </p>
    </section>

    <!-- Time Difference Image -->
    <div style="margin: 0 auto 2.5rem;">
      <img
        src="/assets/gmt-to-msk-time-difference.webp"
        alt="Timezone graphic showing the 3-hour difference between GMT (UTC+0) and MSK (UTC+3)"
        width="1200" height="800"
        loading="lazy"
        style="width: 100%; height: auto; border-radius: 12px; border: 1px solid var(--line);"
      />
    </div>

    <!-- How to Convert -->
    <section class="content-section" style="margin-bottom: 2.5rem;">
      <h2>How to Convert GMT to MSK</h2>
      <p>
        Converting Greenwich Mean Time to Moscow Standard Time requires a single addition: add 3 hours to the GMT time. Follow these steps:
      </p>
      <ol style="padding-left: 1.2rem; line-height: 1.8;">
        <li><strong>Start with the GMT time.</strong> Note the exact hour and minute in Greenwich Mean Time (UTC+0).</li>
        <li><strong>Add 3 hours.</strong> Shift the time forward by 3 hours to align with the UTC+3 offset.</li>
        <li><strong>Check the date boundary.</strong> If the addition pushes the hour to 24:00 or beyond (i.e., 12:00 AM midnight or later), advance the calendar date by one day.</li>
        <li><strong>Read the final MSK result.</strong> The calculated value is the time in Moscow Standard Time (UTC+3).</li>
      </ol>
      <h3>Quick Standard Conversion Examples</h3>
      <ul style="padding-left: 1.2rem; line-height: 1.9;">
        <li><strong>6:00 AM GMT</strong> → 6 + 3 = <strong>9:00 AM MSK</strong> (same day)</li>
        <li><strong>12:00 PM GMT</strong> → 12 + 3 = <strong>3:00 PM MSK</strong> (same day)</li>
        <li><strong>6:00 PM GMT</strong> → 18 + 3 = <strong>9:00 PM MSK</strong> (same day)</li>
        <li><strong>9:00 PM GMT</strong> → 21 + 3 = <strong>12:00 AM MSK</strong> (next day)</li>
        <li><strong>10:00 PM GMT</strong> → 22 + 3 = <strong>1:00 AM MSK</strong> (next day)</li>
      </ul>
      <p>
        For instant date-aware conversions without manual math, use our <strong>interactive converter tool above</strong>.
      </p>
    </section>

    <!-- 24-Hour Conversion Table -->
    <section class="content-section" style="margin-bottom: 2.5rem;">
      <h2>GMT to MSK Conversion Table (24 Hours)</h2>
      <p>
        The table below shows every hour of the day converted from Greenwich Mean Time (GMT) to Moscow Standard Time (MSK). The final three rows highlight date changes where MSK shifts to the following calendar day.
      </p>
      <div style="overflow-x: auto; border-radius: 12px; border: 1px solid var(--line);">
        <table style="width: 100%; border-collapse: collapse; font-size: 0.95rem;">
          <thead>
            <tr style="background: var(--panel);">
              <th style="padding: 12px 16px; text-align: left; border-bottom: 2px solid var(--line); white-space: nowrap;">GMT (UTC+0)</th>
              <th style="padding: 12px 16px; text-align: left; border-bottom: 2px solid var(--line); white-space: nowrap;">MSK (UTC+3)</th>
              <th style="padding: 12px 16px; text-align: left; border-bottom: 2px solid var(--line); white-space: nowrap;">Date</th>
            </tr>
          </thead>
          <tbody>
            {conversionRows.map((row, i) => (
              <tr style={`background: ${row.dayNote === "Next day" ? "rgba(var(--accent-rgb, 99, 102, 241), 0.08)" : i % 2 === 0 ? "transparent" : "var(--panel)"}`}>
                <td style="padding: 10px 16px; border-bottom: 1px solid var(--line);">{row.gmt}</td>
                <td style="padding: 10px 16px; border-bottom: 1px solid var(--line); font-weight: 600;">{row.msk}</td>
                <td style="padding: 10px 16px; border-bottom: 1px solid var(--line); font-size: 0.88rem; color: var(--text-muted);">{row.dayNote}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p style="font-size: 0.88rem; color: var(--text-muted); margin-top: 0.75rem;">
        Note: GMT times from 9:00 PM to 11:00 PM produce MSK times on the next calendar day.
      </p>
    </section>

    <!-- Practical Examples -->
    <section class="content-section" style="margin-bottom: 2.5rem;">
      <h2>GMT to MSK Practical Conversion Examples</h2>
      <p>Here are practical scenarios illustrating how GMT times map to Moscow Standard Time:</p>

      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1rem; margin: 1.25rem 0;">
        <div style="background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 1.25rem;">
          <h3 style="margin: 0 0 0.5rem; font-size: 1rem;">Early Morning Briefing</h3>
          <p style="margin: 0; font-size: 0.93rem;"><strong>6:00 AM GMT</strong> → <strong>9:00 AM MSK</strong><br/>A 6:00 AM GMT briefing aligns with the start of the business day in Moscow (9:00 AM MSK).</p>
        </div>
        <div style="background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 1.25rem;">
          <h3 style="margin: 0 0 0.5rem; font-size: 1rem;">Midday Conference Call</h3>
          <p style="margin: 0; font-size: 0.93rem;"><strong>12:00 PM GMT</strong> → <strong>3:00 PM MSK</strong><br/>A noon GMT conference call falls in the mid-afternoon in Moscow — a prime time for team syncs.</p>
        </div>
        <div style="background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 1.25rem;">
          <h3 style="margin: 0 0 0.5rem; font-size: 1rem;">Late Afternoon Handoff</h3>
          <p style="margin: 0; font-size: 0.93rem;"><strong>3:00 PM GMT</strong> → <strong>6:00 PM MSK</strong><br/>A 3:00 PM GMT handoff lands right at the close of the standard Moscow workday.</p>
        </div>
        <div style="background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 1.25rem;">
          <h3 style="margin: 0 0 0.5rem; font-size: 1rem;">Evening Broadcast</h3>
          <p style="margin: 0; font-size: 0.93rem;"><strong>6:00 PM GMT</strong> → <strong>9:00 PM MSK</strong><br/>An 18:00 GMT live stream broadcasts during prime-time evening hours (21:00 MSK) in Moscow.</p>
        </div>
        <div style="background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 1.25rem;">
          <h3 style="margin: 0 0 0.5rem; font-size: 1rem;">Date Transition Example 1</h3>
          <p style="margin: 0; font-size: 0.93rem;"><strong>9:00 PM GMT, Jun 10</strong> → <strong>12:00 AM MSK, Jun 11</strong><br/>Adding 3 hours reaches midnight exact, marking the start of the next calendar day in MSK.</p>
        </div>
        <div style="background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 1.25rem;">
          <h3 style="margin: 0 0 0.5rem; font-size: 1rem;">Date Transition Example 2</h3>
          <p style="margin: 0; font-size: 0.93rem;"><strong>11:30 PM GMT, Dec 31</strong> → <strong>2:30 AM MSK, Jan 1</strong><br/>Adding 3 hours crosses midnight into New Year's Day in MSK while GMT is still in the old year!</p>
        </div>
      </div>

      <h3>Half-Hour and Minute Conversions</h3>
      <ul style="padding-left: 1.2rem; line-height: 1.9;">
        <li><strong>8:15 AM GMT</strong> → <strong>11:15 AM MSK</strong></li>
        <li><strong>1:45 PM GMT</strong> → <strong>4:45 PM MSK</strong></li>
        <li><strong>7:30 PM GMT</strong> → <strong>10:30 PM MSK</strong></li>
        <li><strong>10:15 PM GMT</strong> → <strong>1:15 AM MSK (next day)</strong></li>
      </ul>
    </section>

    <!-- What Is GMT? -->
    <section class="content-section" style="margin-bottom: 2.5rem;">
      <h2>What Is GMT?</h2>
      <p>
        <strong>Greenwich Mean Time (GMT)</strong> is the historic time standard measured at the Royal Observatory in Greenwich, London, located on the Prime Meridian (0° longitude). GMT operates at UTC+0 offset, serving as the international benchmark against which all global time zone offsets are calculated.
      </p>
      <p>
        While Coordinated Universal Time (UTC) has superseded GMT for official scientific and atomic timekeeping, GMT remains widely used in civil context across the United Kingdom, West Africa, aviation, maritime navigation, and international scheduling. When converting to eastern time zones like MSK (UTC+3), GMT serves as the baseline zero-point. Learn more on our <a href="/" style="color: var(--accent);">GMT to EST Converter</a> home page.
      </p>
    </section>

    <!-- What Is MSK? -->
    <section class="content-section" style="margin-bottom: 2.5rem;">
      <h2>What Is MSK?</h2>
      <p>
        <strong>MSK (Moscow Standard Time / Московское время)</strong> is the time zone designation for UTC+3, used in Moscow, Saint Petersburg, and most of western (European) Russia. The IANA timezone database identifier for MSK is <code>Europe/Moscow</code>.
      </p>
      <p>
        MSK is the single most influential time zone in Russia. In addition to serving the major urban populations of western Russia, MSK is used as the official reference time for train schedules across Russia's entire railway network (spanning thousands of miles), flight departures, telecommunications logs, and national space operations from Baikonur and Vostochny cosmodromes.
      </p>
      <p>
        Unlike European or North American time zones, MSK does not observe seasonal daylight saving time changes. It remains at UTC+3 year-round.
      </p>
    </section>

    <!-- Moscow Time Visual -->
    <div style="margin: 0 auto 2.5rem;">
      <img
        src="/assets/moscow-standard-time-msk.webp"
        alt="Moscow Standard Time (MSK) illustration showing UTC+3 offset and Kremlin skyline"
        width="1200" height="800"
        loading="lazy"
        style="width: 100%; height: auto; border-radius: 12px; border: 1px solid var(--line);"
      />
    </div>

    <!-- Moscow Time and Russia's Time Zones -->
    <section class="content-section" style="margin-bottom: 2.5rem;">
      <h2>Moscow Time and Russia's Time Zones</h2>
      <p>
        Russia is the largest country by landmass in the world and spans <strong>11 contiguous time zones</strong> from UTC+2 to UTC+12. Moscow Standard Time (MSK) serves as the central anchor for this vast system:
      </p>
      <div style="overflow-x: auto; border-radius: 12px; border: 1px solid var(--line); margin: 1.25rem 0;">
        <table style="width: 100%; border-collapse: collapse; font-size: 0.95rem;">
          <thead>
            <tr style="background: var(--panel);">
              <th style="padding: 12px 16px; text-align: left; border-bottom: 2px solid var(--line);">Zone Name</th>
              <th style="padding: 12px 16px; text-align: left; border-bottom: 2px solid var(--line);">Abbreviation</th>
              <th style="padding: 12px 16px; text-align: left; border-bottom: 2px solid var(--line);">UTC Offset</th>
              <th style="padding: 12px 16px; text-align: left; border-bottom: 2px solid var(--line);">MSK Offset</th>
              <th style="padding: 12px 16px; text-align: left; border-bottom: 2px solid var(--line);">Key Cities</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line);">Kaliningrad Time</td>
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line);">KALT</td>
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line);">UTC+2</td>
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line);">MSK−1</td>
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line);">Kaliningrad</td>
            </tr>
            <tr style="background: rgba(var(--accent-rgb, 99, 102, 241), 0.08);">
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line); font-weight: 700;">Moscow Time</td>
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line); font-weight: 700;">MSK</td>
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line); font-weight: 700;">UTC+3</td>
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line); font-weight: 700;">MSK+0</td>
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line); font-weight: 700;">Moscow, St. Petersburg, Kazan, Sochi</td>
            </tr>
            <tr>
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line);">Samara Time</td>
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line);">SAMT</td>
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line);">UTC+4</td>
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line);">MSK+1</td>
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line);">Samara, Izhevsk</td>
            </tr>
            <tr style="background: var(--panel);">
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line);">Yekaterinburg Time</td>
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line);">YEKT</td>
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line);">UTC+5</td>
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line);">MSK+2</td>
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line);">Yekaterinburg, Chelyabinsk, Ufa</td>
            </tr>
            <tr>
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line);">Omsk Time</td>
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line);">OMST</td>
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line);">UTC+6</td>
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line);">MSK+3</td>
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line);">Omsk</td>
            </tr>
            <tr style="background: var(--panel);">
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line);">Krasnoyarsk Time</td>
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line);">KRAT</td>
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line);">UTC+7</td>
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line);">MSK+4</td>
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line);">Krasnoyarsk, Novosibirsk</td>
            </tr>
            <tr>
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line);">Irkutsk Time</td>
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line);">IRKT</td>
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line);">UTC+8</td>
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line);">MSK+5</td>
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line);">Irkutsk</td>
            </tr>
            <tr style="background: var(--panel);">
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line);">Yakutsk Time</td>
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line);">YAKT</td>
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line);">UTC+9</td>
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line);">MSK+6</td>
              <td style="padding: 10px 16px; border-bottom: 1px solid var(--line);">Yakutsk, Chita</td>
            </tr>
            <tr>
