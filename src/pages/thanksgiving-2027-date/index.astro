---
import BaseLayout from "theme/layouts/BaseLayout.astro";

const lang = "en";
const dir = "ltr";
const slug = "thanksgiving-2027-date";
const seoTitle = "Thanksgiving 2027 Date | When Is Thanksgiving in 2027?";
const pageDescription = "Thanksgiving 2027 is on Thursday, 25 November, the fourth Thursday in November. See the date rule and the long weekend.";

const pubDate = "2026-10-25T16:10:00+05:00";
const updatedDate = "2026-10-25T16:20:00+05:00";

const meta = {
  seoTitle,
  exactTitle: true,
  description: pageDescription,
  keywords: "thanksgiving 2027 date, when is thanksgiving in 2027, thanksgiving day 2027, thanksgiving weekend 2027, black friday 2027, fourth thursday in november, us federal holidays 2027",
  pubDate,
  updatedDate,
  author: "Time Intelligence Team",
  faqs: [
    {
      q: "When is Thanksgiving 2027?",
      a: "Thanksgiving Day 2027 is on Thursday, 25 November 2027."
    },
    {
      q: "Why is Thanksgiving not on the same date every year?",
      a: "Because it is always the fourth Thursday in November, so it falls between 22 and 28 November depending on the year."
    },
    {
      q: "Is the Friday after Thanksgiving a federal holiday?",
      a: "No. Many workplaces close that Friday, but it is not itself a US federal holiday."
    },
    {
      q: "When is Black Friday 2027?",
      a: "Black Friday 2027 is on Friday, 26 November 2027, the day after Thanksgiving."
    }
  ]
};

// Exactly 3 rows for the Thanksgiving 2027 table
const THANKSGIVING_EVENTS_2027 = [
  {
    event: "Thanksgiving Day",
    date: "Thursday, 25 November 2027",
    details: "US Thanksgiving holiday"
  },
  {
    event: "Black Friday",
    date: "Friday, 26 November 2027",
    details: "Shopping day after Thanksgiving; not a federal holiday"
  },
  {
    event: "Thanksgiving weekend",
    date: "Thursday, 25 November to Sunday, 28 November 2027",
    details: "Four calendar days, including Thanksgiving Day"
  }
];

const thanksgivingEventSchema = {
  "@context": "https://schema.org",
  "@type": "Event",
  "name": "Thanksgiving Day 2027",
  "startDate": "2027-11-25"
};
---

<BaseLayout
  lang={lang}
  dir={dir}
  title={seoTitle}
  description={pageDescription}
  slug={slug}
  meta={meta}
  enableArticleSchema={true}
  enableFaqSchema={true}
  allowAds={true}
>
  <!-- Schema: Dedicated Event for Thanksgiving Day 2027 Only -->
  <script type="application/ld+json" set:html={JSON.stringify(thanksgivingEventSchema)} />

  <!-- Hero Banner -->
  <div class="hero-banner">
    <h1 class="hero-banner-title">Thanksgiving 2027 Date</h1>
    <p style="color: #bdd2dc; font-size: clamp(1rem, 2.2vw, 1.25rem); max-width: 680px; margin: 12px auto 0;">
      Official date, the fourth-Thursday statutory rule, long weekend schedule, and federal holiday distinctions.
    </p>
  </div>

  <div style="max-width: 860px; margin: 0 auto; padding-top: 24px;">

    <!-- ═══════════════════════════════════════════════════════════════════════
         QUICK ANSWER (SERVER-RENDERED DIRECTLY BELOW H1)
         ═══════════════════════════════════════════════════════════════════════ -->
    <section class="quick-answer-card" style="background: var(--panel); border: 2px solid var(--accent); border-radius: 14px; padding: 22px 26px; box-shadow: var(--shadow); margin-bottom: 32px;">
      <h2 style="margin: 0 0 10px; font-size: 1.2rem; font-weight: 800; color: var(--accent); font-family: 'Space Grotesk', system-ui, sans-serif;">
        Quick Answer
      </h2>
      <p style="margin: 0; font-size: 1.05rem; line-height: 1.65; color: #ffffff; font-weight: 500;">
        Thanksgiving Day 2027 is on Thursday, 25 November 2027, the fourth Thursday in November. The Thanksgiving weekend runs from Thursday 25 November to Sunday 28 November 2027, with Black Friday on Friday 26 November 2027.
      </p>
    </section>

    <!-- Hero Image Banner -->
    <div style="margin: 0 0 36px; text-align: center;">
      <img
        src="/assets/thanksgiving-2027-date-hero.webp"
        alt="Calendar marking Thanksgiving Day on Thursday 25 November 2027"
        width="960"
        height="540"
        loading="eager"
        decoding="async"
        style="width: 100%; height: auto; border-radius: 12px; border: 1px solid var(--line); box-shadow: var(--shadow);"
      />
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════════
         MAIN ARTICLE CONTENT (STRICT ORDER)
         1. H2: When is Thanksgiving in 2027?
         2. H2: How the Thanksgiving date is set
         3. H2: Is Thanksgiving a federal holiday?
         4. H2: Thanksgiving vs Black Friday
         5. H2: Frequently Asked Questions
         ═══════════════════════════════════════════════════════════════════════ -->
    <article class="article-content">

      <!-- Section 1: When is Thanksgiving in 2027? -->
      <h2>When is Thanksgiving in 2027?</h2>
      <p>
        Thanksgiving Day 2027 falls on <strong>Thursday, 25 November 2027</strong>. It marks the commencement of the traditional four-day holiday weekend across the United States. Black Friday immediately follows on <strong>Friday, 26 November 2027</strong>, with the broader Thanksgiving holiday weekend extending through <strong>Sunday, 28 November 2027</strong>.
      </p>

      <div class="table-wrapper" style="overflow-x: auto; margin: 24px 0 16px; border: 1px solid var(--line); border-radius: 12px; background: var(--panel);">
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.95rem;">
          <thead>
            <tr style="background: #082030; border-bottom: 2px solid var(--line);">
              <th scope="col" style="padding: 14px 16px; color: var(--accent); font-weight: 800; font-family: 'Space Grotesk', sans-serif;">Event</th>
              <th scope="col" style="padding: 14px 16px; color: #38bdf8; font-weight: 800; font-family: 'Space Grotesk', sans-serif; white-space: nowrap;">Date</th>
              <th scope="col" style="padding: 14px 16px; color: #cbd5e1; font-weight: 800; font-family: 'Space Grotesk', sans-serif;">Details</th>
            </tr>
          </thead>
          <tbody>
            {THANKSGIVING_EVENTS_2027.map((row, idx) => (
              <tr style={`border-bottom: 1px solid rgba(255, 255, 255, 0.06); ${idx % 2 === 1 ? 'background: rgba(255, 255, 255, 0.02);' : ''}`}>
                <td style="padding: 14px 16px; font-weight: 700; color: #ffffff; white-space: nowrap;">{row.event}</td>
                <td style="padding: 14px 16px; white-space: nowrap; font-family: 'Space Grotesk', monospace; color: row.event === 'Thanksgiving Day' ? '#f59e0b' : '#38bdf8'; font-weight: row.event === 'Thanksgiving Day' ? '800' : '600';">
                  {row.date}
                </td>
                <td style="padding: 14px 16px; color: #94a3b8; font-size: 0.9rem; line-height: 1.5;">{row.details}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Mandatory Clarification Immediately After Table -->
      <p style="margin: 16px 0 32px; font-style: italic; color: #bdd2dc; line-height: 1.6; padding: 12px 16px; background: rgba(245, 158, 11, 0.05); border-left: 3px solid #f59e0b; border-radius: 4px;">
        Do not confuse Thanksgiving 2027 with Thanksgiving 2026, which fell on Thursday, 26 November 2026. Thanksgiving is set by the fourth-Thursday rule, not by a fixed calendar date.
      </p>

      <!-- Weekend Diagram Visual Image -->
      <figure style="margin: 32px 0 36px; text-align: center;">
        <img
          src="/assets/thanksgiving-2027-weekend.webp"
          alt="Timeline for the Thanksgiving weekend 2027 from Thursday to Sunday"
          width="800"
          height="450"
          loading="lazy"
          decoding="async"
          style="width: 100%; height: auto; border-radius: 12px; border: 1px solid var(--line); box-shadow: var(--shadow);"
        />
        <figcaption style="font-size: 0.88rem; color: var(--muted); margin-top: 10px; font-style: italic;">
          Thanksgiving 25 November, Black Friday 26 November, weekend to 28 November 2027.
        </figcaption>
      </figure>

      <!-- Section 2: How the Thanksgiving date is set -->
      <h2>How the Thanksgiving date is set</h2>
      <p>
        In the United States, Thanksgiving does not occur on a static day of the month. Since federal legislation was signed by President Franklin D. Roosevelt in 1941 (Public Law 77-372, codified at 5 U.S.C. 6103), federal law has permanently established Thanksgiving Day as the <strong>fourth Thursday in November</strong>.
      </p>
      <p>
        Because November always begins on a day between Sunday and Saturday, the fourth Thursday mathematically always falls within a 7-day calendar window: between <strong>22 November and 28 November</strong>. The Gregorian calendar determines which exact date is the fourth Thursday in any particular year. In 2027, November begins on a Monday, which positions the first four Thursdays on 4 November, 11 November, 18 November, and finally <strong>25 November 2027</strong>.
      </p>

      <!-- Section 3: Is Thanksgiving a federal holiday? -->
      <h2>Is Thanksgiving a federal holiday?</h2>
      <p>
        Yes, Thanksgiving Day is an official US statutory federal holiday recognized nationwide under Title 5 of the United States Code.
      </p>
      <p>
        On Thanksgiving Day:
      </p>
      <ul style="padding-left: 24px; margin-bottom: 20px; line-height: 1.7;">
        <li style="margin-bottom: 8px;">
          <strong>Federal civil offices:</strong> Non-essential federal government agencies and facilities are closed, and federal employees receive paid holiday leave.
        </li>
        <li style="margin-bottom: 8px;">
          <strong>Postal services:</strong> Regular United States Postal Service (USPS) mail delivery is suspended on Thanksgiving Day, though priority express shipments and critical operations may maintain distinct arrangements.
        </li>
        <li style="margin-bottom: 8px;">
          <strong>Schools and workplaces:</strong> Most public school districts, colleges, state administrative departments, and private employers remain closed for Thanksgiving. Furthermore, many educational institutions and corporate employers also grant the day after Thanksgiving (Friday, 26 November 2027) as an additional paid day off to provide employees with a four-day weekend.
        </li>
        <li style="margin-bottom: 8px;">
          <strong>Friday after Thanksgiving:</strong> Friday, 26 November 2027, is <em>not</em> itself an official US federal holiday, even though it is widely observed by state governments and private businesses.
        </li>
      </ul>
      <p>
        Because private employers, financial institutions, and local school districts establish their own holiday calendars, readers should consult their specific employer or local municipal calendar for exact closure schedules. For a full breakdown of all eleven statutory holidays throughout the year, see our guide to <a href="/us-federal-holidays-2027/">US Federal Holidays in 2027</a>.
      </p>

      <!-- Section 4: Thanksgiving vs Black Friday -->
      <h2>Thanksgiving vs Black Friday</h2>
      <p>
        While closely linked in American popular culture and commercial traditions, Thanksgiving Day and Black Friday represent distinctly separate occasions:
      </p>
      <ul style="padding-left: 24px; margin-bottom: 20px; line-height: 1.7;">
        <li style="margin-bottom: 8px;">
          <strong>Thanksgiving Day:</strong> Celebrated on Thursday, 25 November 2027, as a designated national holiday centered on gratitude, family reunions, and festive meals.
        </li>
        <li style="margin-bottom: 8px;">
          <strong>Black Friday:</strong> Occurs the following morning on Friday, 26 November 2027. It is primarily recognized as a major commercial retail event that kicks off the holiday shopping season.
        </li>
        <li style="margin-bottom: 8px;">
          <strong>Statutory status:</strong> Thanksgiving is a legal federal holiday; Black Friday is not a US federal holiday.
        </li>
      </ul>
      <p style="padding: 14px 18px; background: rgba(251, 146, 60, 0.06); border-left: 3px solid #fb923c; border-radius: 6px; color: #ffffff; font-weight: 500;">
        This page covers Thanksgiving 2027. A Black Friday page for 2026 refers to a different year and date; do not present it as the 2027 Black Friday resource.
      </p>
      <p style="margin-top: 16px;">
        If you are planning autumn travel, coordinating holiday operations between Labor Day 2027 and Thanksgiving, or managing cross-border family calls, you can view the complete yearly schedule on our <a href="/holidays-2027/">Holidays in 2027</a> hub, calculate working day counts with the <a href="/days-between-dates-calculator/">Days Between Dates Calculator</a>, or convert event times across US time zones with our <a href="/">GMT to EST Converter</a>.
      </p>

      <!-- Section 5: Frequently Asked Questions -->
      <h2>Frequently Asked Questions</h2>
      <div class="faq-container" style="display: flex; flex-direction: column; gap: 14px; margin-top: 20px;">
        {meta.faqs.map((faq) => (
          <details style="background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 16px 20px;">
            <summary style="font-weight: 800; font-size: 1.05rem; cursor: pointer; color: var(--text);">
              {faq.q}
            </summary>
            <p style="margin: 12px 0 0; color: #bdd2dc; font-size: 0.95rem; line-height: 1.6;">
              {faq.a}
            </p>
          </details>
        ))}
      </div>

    </article>

  </div>

  <style>
    .article-content {
      line-height: 1.75;
      color: #bdd2dc;
    }
    .article-content h2 {
      color: #ffffff;
      font-size: clamp(1.35rem, 2.5vw, 1.75rem);
      margin: 36px 0 16px;
      padding-bottom: 8px;
      border-bottom: 1px solid var(--line);
      font-family: "Space Grotesk", system-ui, sans-serif;
    }
    .article-content p {
      margin-bottom: 16px;
    }
    .article-content a {
      color: var(--accent);
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    .article-content a:hover {
      color: #ffffff;
    }
  </style>
</BaseLayout>
