    margin-top: 0;
    font-family: 'Space Grotesk', sans-serif;
    color: var(--text);
  }
  .reading-meta {
    font-family: 'Manrope', sans-serif;
  }
  .infographic-wrapper {
    margin: 2.5rem 0;
    text-align: center;
    border: 1px solid var(--line);
    padding: 1.5rem;
    border-radius: 12px;
    background: var(--panel);
  }
  .infographic-caption {
    font-size: 0.9rem;
    color: var(--accent);
    margin-top: 1rem;
    font-weight: 700;
  }
  .table-wrap {
    overflow-x: auto;
    margin: 2rem 0;
    border: 1px solid var(--line);
    border-radius: 8px;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }
  th, td {
    padding: 1rem;
    border-bottom: 1px solid var(--line);
  }
  th {
    background: var(--panel);
    font-family: 'Space Grotesk', sans-serif;
    color: var(--text);
  }
  tr:last-child td {
    border-bottom: none;
  }
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }
  .faq-item {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 1.5rem;
  }
