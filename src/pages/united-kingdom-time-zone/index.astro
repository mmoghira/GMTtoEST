          <td style="padding: 10px; border-bottom: 1px solid var(--line);">No DST</td>
        </tr>
        <tr>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Gibraltar</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Central European Time (UTC+1)</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Yes (CEST, UTC+2)</td>
        </tr>
        <tr>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Falkland Islands</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Falkland Islands Time (UTC-3)</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">No DST (UTC-3 year-round)</td>
