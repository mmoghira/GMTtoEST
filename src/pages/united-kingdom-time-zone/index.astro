          <th style="padding: 10px; text-align: left;">Standard Time Offset</th>
          <th style="padding: 10px; text-align: left;">Daylight Saving Time (DST)?</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Bermuda</td>
