        <text x="215" y="150" fill="currentColor" text-anchor="middle" font-size="12">Last Sun of March</text>
        <text x="215" y="165" fill="#f59e0b" text-anchor="middle" font-size="11" font-weight="bold">+1 Hour (01:00 UTC)</text>
        
        <line x1="625" y1="60" x2="625" y2="130" stroke="#f59e0b" stroke-width="3" stroke-dasharray="4" />
