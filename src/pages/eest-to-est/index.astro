          <text x="0" y="30" font-family="'Manrope', sans-serif" font-size="11" fill="#8fd7ff" text-anchor="middle">10 PM EST (prev day)</text>
        </g>

        <!-- 12 PM EEST -->
        <g transform="translate(520, 55)">
