---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import Converter from "theme/components/Converter.astro";
import { getTranslation, pageUrl, siteUrl } from "theme/i18n/config";

const lang = "en";
const dir = "ltr";
const slug = "eest-to-est";
const t = getTranslation(lang);

const pageTitle = "EEST to EST Converter";
const seoTitle = "EEST to EST Converter – Eastern European Summer to US Eastern Time";
const pageDescription = "Convert EEST to EST instantly. Find the current time difference between Eastern European Summer Time (UTC+3) and Eastern Standard Time (UTC-5), with tables and New York and Athens clocks.";

const context = {
  from: "EEST",
  to: "EST",
  fromZone: "Europe/Athens",
  toZone: "America/New_York"
};

const canonical = `${siteUrl}/eest-to-est/`;

// 24-hour conversion table data (EEST → EST = EEST - 8)
function formatHour12(hour: number) {
  const normalized = ((hour % 24) + 24) % 24;
  const period = normalized < 12 ? "AM" : "PM";
  const displayHour = normalized % 12 || 12;
  return `${displayHour}:00 ${period}`;
}

const conversionRows = Array.from({ length: 24 }, (_, hour) => {
  const estHour = hour - 8;
  const estNormalized = ((estHour % 24) + 24) % 24;
  const prevDay = estHour < 0;
  const period = estNormalized < 12 ? "AM" : "PM";
  const displayHour = estNormalized % 12 || 12;
  return {
    eest: formatHour12(hour),
    est: `${displayHour}:00 ${period}${prevDay ? " (prev day)" : ""}`,
    dayNote: prevDay ? "Previous day" : "Same day"
  };
});

// Popular conversions
const popularConversions = [
  { eest: "12:00 AM (Midnight)", est: "4:00 PM EST", note: "End of the standard workday in New York and Toronto" },
  { eest: "2:00 AM", est: "6:00 PM EST", note: "Late evening in Eastern North America, middle of the night in Greece" },
  { eest: "4:00 AM", est: "8:00 PM EST", note: "Prime-time TV in the US, early morning hours in Kyiv" },
  { eest: "6:00 AM", est: "10:00 PM EST", note: "Bedtime in New York, dawn in Eastern Europe" },
  { eest: "8:00 AM", eestStandard: "9:00 AM", est: "12:00 AM (Midnight) EST", note: "Midnight in EST, start of the morning in Helsinki" },
  { eest: "10:00 AM", est: "2:00 AM EST", note: "Quiet hours in America, mid-morning collaboration in Kyiv" },
  { eest: "12:00 PM (Noon)", est: "4:00 AM EST", note: "Pre-dawn in New York, midday in Romania" },
  { eest: "2:00 PM", est: "6:00 AM EST", note: "US East Coast waking up, afternoon in Eastern Europe" },
  { eest: "4:00 PM", est: "8:00 AM EST", note: "US offices preparing to open, late afternoon in Athens" },
  { eest: "6:00 PM", est: "10:00 AM EST", note: "Mid-morning focus in New York, evening in Eastern Europe" },
  { eest: "8:00 PM", est: "12:00 PM (Noon) EST", note: "Lunch break in Toronto, night in Helsinki" },
  { eest: "10:00 PM", est: "2:00 PM EST", note: "Mid-afternoon collaboration window across the Atlantic" }
];

// FAQ data
const faqs = [
  { q: "What is EEST?", a: "EEST stands for Eastern European Summer Time. It is the daylight saving time zone used in parts of Eastern Europe, the Middle East, and North Africa during the summer months. It is UTC+3 (3 hours ahead of Coordinated Universal Time)." },
  { q: "What is EST?", a: "EST stands for Eastern Standard Time. It is the winter time zone observed in eastern parts of North America (including New York, Toronto, and Miami), running exactly 5 hours behind Coordinated Universal Time (UTC-5)." },
  { q: "How many hours behind EEST is EST?", a: "EST is exactly 8 hours behind EEST. For example, when it is 4:00 PM EEST in Athens, it is 8:00 AM EST in New York." },
  { q: "Is EST always UTC-5?", a: "Yes. Eastern Standard Time is defined as UTC-5. During the summer, North America shifts to Eastern Daylight Time (EDT), which is UTC-4." },
  { q: "What is the difference between EST and EDT?", a: "EST is Eastern Standard Time (UTC-5), used in winter. EDT is Eastern Daylight Time (UTC-4), used during the summer daylight saving months." },
  { q: "Which cities use Eastern European Summer Time?", a: "Major cities observing EEST include Athens (Greece), Helsinki (Finland), Kyiv (Ukraine), Bucharest (Romania), Sofia (Bulgaria), Riga (Latvia), and Tallinn (Estonia)." },
  { q: "Which North American cities follow EST?", a: "Cities observing EST in winter include New York City, Boston, Washington D.C., Atlanta, Miami, Detroit, Toronto, Montreal, and Ottawa." },
  { q: "How accurate is this EEST to EST converter?", a: "Our converter utilizes the latest IANA Time Zone Database (specifically the Europe/Athens and America/New_York rulesets), ensuring complete accuracy across all calendar dates." },
  { q: "How do I manually convert EEST to EST?", a: "To convert EEST to EST manually, subtract 8 hours from the EEST time. For example, 10:00 PM EEST minus 8 hours equals 2:00 PM EST." },
  { q: "What is 8 PM EEST in EST?", a: "8:00 PM EEST converts to 12:00 PM (Noon) EST on the same day." },
  { q: "Is GMT the same as UTC?", a: "Yes, for daily scheduling, GMT (Greenwich Mean Time) and UTC (Coordinated Universal Time) represent the same offset (+0). UTC is the modern atomic standard, while GMT is the astronomical solar standard." },
  { q: "What is the time gap between Athens and New York in summer?", a: "During summer, Athens is on EEST (UTC+3) and New York is on EDT (UTC-4), making Athens exactly 7 hours ahead of New York. In winter, Athens is on EET (UTC+2) and New York is on EST (UTC-5), which maintains a 7-hour difference. The gap only shifts to 8 hours during the brief weeks when one region has transitioned but the other has not." },
  { q: "Does Greece observe EEST?", a: "Yes. Greece observes EEST (UTC+3) from the last Sunday in March to the last Sunday in October." },
  { q: "Does Finland follow EEST?", a: "Yes. Finland observes EEST (UTC+3) during the summer and EET (UTC+2) during the winter months." },
  { q: "Does Ukraine follow EEST?", a: "Yes. Ukraine observes EEST (UTC+3) during summer and EET (UTC+2) during winter." },
  { q: "Does Romania follow EEST?", a: "Yes. Romania observes EEST (UTC+3) in summer and EET (UTC+2) in winter." },
  { q: "Does Bulgaria follow EEST?", a: "Yes. Bulgaria observes EEST (UTC+3) in summer and EET (UTC+2) in winter." },
  { q: "What is the IANA identifier for Eastern Europe?", a: "Common IANA identifiers for EEST include Europe/Athens, Europe/Helsinki, Europe/Kyiv, and Europe/Bucharest." },
  { q: "What is the IANA identifier for US Eastern Time?", a: "The canonical IANA time zone identifier for US Eastern Time is America/New_York." },
  { q: "Does Toronto follow the same time rules as New York?", a: "Yes. Toronto, Ontario, follows the America/Toronto ruleset, which is synchronized with New York's EST/EDT transitions." },
  { q: "Do computer networks use EEST or EST?", a: "Servers typically log events in UTC (GMT) to maintain database consistency. User applications then translate these timestamps to local EEST or EST offsets for display." },
  { q: "What is 12 AM EEST in New York local time?", a: "12:00 AM (Midnight) EEST is equal to 4:00 PM EST on the previous calendar day in New York." },
  { q: "Why do the US and Europe change clocks on different days?", a: "The US transitions to DST on the second Sunday of March and returns to standard time on the first Sunday of November. Europe transitions on the last Sunday of March and returns on the last Sunday of October." },
  { q: "Can this converter help with remote team planning?", a: "Yes. The meeting planner helps identify viable crossover business hours between Eastern Europe and the North American Eastern Seaboard." },
  { q: "What offset is GMT+3?", a: "GMT+3 represents an offset 3 hours ahead of Greenwich Mean Time. This matches the offset of EEST during the daylight saving months." }
];

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "EEST to EST, Eastern European Summer Time to Eastern Standard Time, Convert EEST to EST, EEST EST Converter, EEST to Eastern Time, Eastern European Summer Time Converter, EST Time Converter, Current EST Time, Time Difference EEST and EST, EEST UTC+3 to EST UTC-5, GMT+3 to EST",
  image: "/assets/eest-to-est-og.svg",
  imageAlt: "EEST to EST Converter – Convert Eastern European Summer Time to Eastern Standard Time",
  faqs,
  appDescription: "Free online EEST to EST converter with real-time clocks, DST-aware calculation, 24-hour conversion chart, and meeting planner for scheduling between Eastern European Summer Time and Eastern Standard Time.",
  applicationCategory: "UtilityApplication",
  operatingSystem: "Any",
  howToName: "How to Convert EEST to EST",
  howToDescription: "Step-by-step guide to converting Eastern European Summer Time to Eastern Standard Time using our free online tool.",
  howToSteps: [
    { name: "Check local offsets", text: "Identify if Eastern Europe is in EEST (UTC+3) and if North America is in EST (UTC-5) or EDT (UTC-4) on your target date." },
    { name: "Input your EEST time", text: "Select your desired EEST time using the interactive date and time picker. The tool defaults to the current time." },
    { name: "Check the calendar date", text: "Our calculator evaluates the chosen date against the European and US DST calendars to determine the correct relative offset." },
    { name: "Read and copy the EST result", text: "View the converted time, along with day status (same/previous day) and active offsets, and click copy to save the result." }
  ],
};
---

<BaseLayout
  lang={lang}
  dir={dir}
  title={seoTitle}
  description={pageDescription}
  slug={slug}
  meta={meta}
  mode="gmt-est"
  enableFaqSchema={true}
  allowAds={true}
  breadcrumbHomeLabel="Home"
  breadcrumbLabel="EEST to EST"
  hreflangCodes={["en"]}
>

<!-- ═══════════════════════════════════════════════════════════════════════════
     H1 & INTRODUCTION
     ═══════════════════════════════════════════════════════════════════════ -->
<section class="hero-banner">
  <h1 class="hero-banner-title">
    EEST to EST <span class="gradient-text">Converter</span>
  </h1>
</section>

<!-- PRIMARY CONVERTER & LIVE CLOCKS (Above the Fold) -->
<div style="max-width: 900px; margin: 0 auto; padding: 0 16px 24px;">
  <Converter intent="dynamic" t={t} context={context} />
  
  <!-- LIVE CLOCKS -->
  <section class="clock-grid" aria-label="Live Clocks" style="margin-top: 24px;">
    <h2>Live Clocks</h2>
    <div class="clock-card">
      <span class="eyebrow">Source Time Zone</span>
      <strong id="gmtClock">--:--:--</strong>
