---
import BaseLayout from "theme/layouts/BaseLayout.astro";

const lang = "en";
const dir = "ltr";
const slug = "days-between-dates-calculator";
const seoTitle = "Days Between Dates Calculator – Count Days & Weeks";
const pageDescription = "Calculate days, weeks, weekdays, and weekend days between two dates instantly. Toggle inclusive or exclusive counting with accurate calendar math.";

const pubDate = "2026-10-25T13:00:00+05:00";
const updatedDate = "2026-10-25T14:15:00+05:00";

const meta = {
  seoTitle,
  exactTitle: true,
  description: pageDescription,
  keywords: "days between dates calculator, count days between dates, date difference calculator, weeks between two dates, calendar days calculator, weekdays between dates",
  pubDate,
  updatedDate,
  author: "Time Intelligence Team",
  faqs: [
    {
      q: "How many days are between two dates?",
      a: "Subtract the start date from the end date. That calculates the elapsed days between them, excluding the end date. Add 1 to count both the start and end dates inclusively."
    },
    {
      q: "Do you count the start date or the end date?",
      a: "By default, this calculator uses exclusive counting (End Date minus Start Date), measuring the elapsed interval. Toggle 'Include end date' on to count both bounding dates inclusively."
    },
    {
      q: "How do leap years affect the date count?",
      a: "Leap years contain 366 days instead of 365 because they include February 29. Any date span that crosses February 29 (such as in 2028) is one day longer than the same span in a non-leap year (such as 2026)."
    },
    {
      q: "How are weeks and remaining days calculated?",
      a: "Total days are divided by 7 using integer division. The quotient is the number of full weeks, and the remainder represents additional days (Total Days = [Weeks × 7] + Remainder Days)."
    },
    {
      q: "Does this calculator exclude public holidays?",
      a: "No. This tool isolates standard Monday-to-Friday weekdays from Saturday-and-Sunday weekend days, but it does not subtract public holidays. For holiday-adjusted business days, use our Workday Calculator."
    },
    {
      q: "What happens if I enter the same date for start and end?",
      a: "With exclusive counting, the result is 0 days because zero time has elapsed. With 'Include end date' enabled, the result is 1 day because that single calendar date is counted."
    },
    {
      q: "How do I calculate hours and minutes between two dates?",
      a: "For calculations that require clock time down to hours, minutes, and seconds, use our dedicated Time Duration Calculator."
    }
  ]
};
---

<BaseLayout
  lang={lang}
  dir={dir}
  title={seoTitle}
  description={pageDescription}
  slug={slug}
  meta={meta}
  enableFaqSchema={true}
  allowAds={true}
>
  <!-- WebApplication Schema -->
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Days Between Dates Calculator",
    "url": "https://gmttoestconverter.com/days-between-dates-calculator/",
    "applicationCategory": "UtilitiesApplication",
    "operatingSystem": "All",
    "description": pageDescription,
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
    "browserRequirements": "Requires JavaScript for live date recalculation"
  })}></script>

  <!-- Hero Banner -->
  <div class="hero-banner">
    <h1 class="hero-banner-title">Days Between Dates Calculator</h1>
    <p style="color: #bdd2dc; font-size: clamp(1rem, 2.2vw, 1.25rem); max-width: 680px; margin: 12px auto 0;">
      Calculate the exact number of days, full weeks, weekdays, and weekend days between any two calendar dates.
    </p>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════════════
       INTERACTIVE TOOL (PROMINENT ABOVE THE FOLD)
       ═══════════════════════════════════════════════════════════════════════ -->
  <section id="days-calculator" style="max-width: 760px; margin: 0 auto; padding-top: 28px;">
    <div style="background: var(--panel); border: 1px solid var(--line); border-radius: 14px; padding: clamp(18px, 4vw, 28px); box-shadow: var(--shadow);">

      <!-- Date Inputs Grid -->
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;" class="date-input-grid">
        <div>
          <label for="dbd-start" style="display: block; font-weight: 700; color: var(--muted); margin-bottom: 6px; font-size: 0.95rem;">Start date</label>
          <input
            type="date"
            id="dbd-start"
            value="2026-09-22"
            aria-label="Start date"
            style="width: 100%; padding: 12px 14px; border-radius: 8px; border: 1px solid var(--line); background: var(--bg); color: var(--text); font-size: 1.05rem;"
          />
        </div>
        <div>
          <label for="dbd-end" style="display: block; font-weight: 700; color: var(--muted); margin-bottom: 6px; font-size: 0.95rem;">End date</label>
          <input
            type="date"
            id="dbd-end"
            value="2026-11-27"
            aria-label="End date"
            style="width: 100%; padding: 12px 14px; border-radius: 8px; border: 1px solid var(--line); background: var(--bg); color: var(--text); font-size: 1.05rem;"
          />
        </div>
      </div>

      <!-- Include End Date Toggle -->
      <div style="display: flex; align-items: center; gap: 12px; margin: 18px 0;">
        <button
          type="button"
          id="dbd-toggle"
          role="switch"
          aria-checked="false"
          aria-label="Include end date"
          style="position: relative; width: 50px; height: 28px; border-radius: 999px; border: 1px solid var(--line); background: var(--bg); cursor: pointer; padding: 0; transition: background 0.2s, border-color 0.2s;"
        >
          <span id="dbd-toggle-thumb" style="position: absolute; top: 3px; left: 3px; width: 20px; height: 20px; border-radius: 50%; background: var(--muted); transition: transform 0.2s, background 0.2s;"></span>
        </button>
        <label for="dbd-toggle" id="dbd-toggle-label" style="font-weight: 700; color: var(--text); font-size: 0.95rem; cursor: pointer;">
          Include end date <span style="font-weight: 400; color: var(--muted); font-size: 0.85rem;">(adds 1 day to count both boundary dates)</span>
        </label>
      </div>

      <!-- Calculate Button -->
      <button
        type="button"
        id="dbd-calculate"
        style="width: 100%; padding: 14px; border-radius: 8px; border: none; background: var(--accent); color: #fff; font-weight: 800; font-size: 1.05rem; cursor: pointer; transition: background 0.2s; margin-bottom: 16px;"
      >
        Calculate
      </button>

      <!-- Validation Error -->
      <p id="dbd-error" role="alert" style="display: none; color: #f87171; background: rgba(239, 68, 68, 0.15); border: 1px solid #ef4444; border-radius: 8px; padding: 10px 14px; font-weight: 700; text-align: center; margin: 0 0 14px;"></p>

      <!-- Result Block -->
      <div id="dbd-results" style="display: none;">
        <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px;" class="results-grid">
          <div style="background: var(--bg); border: 1px solid var(--line); border-radius: 10px; padding: 18px 12px; text-align: center;">
            <span style="display: block; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); font-weight: 800; margin-bottom: 4px;">Total Days</span>
            <strong id="dbd-total-days" style="font-size: clamp(1.8rem, 4vw, 2.4rem); color: var(--accent); font-weight: 900; line-height: 1.1;">0</strong>
            <span style="display: block; font-size: 0.8rem; color: var(--muted); margin-top: 4px;" id="dbd-counting-mode-label">Excluding end date</span>
          </div>
          <div style="background: var(--bg); border: 1px solid var(--line); border-radius: 10px; padding: 18px 12px; text-align: center;">
            <span style="display: block; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); font-weight: 800; margin-bottom: 4px;">Total Weeks</span>
            <strong id="dbd-weeks" style="font-size: clamp(1.4rem, 3.2vw, 1.8rem); color: var(--text); font-weight: 900; line-height: 1.2;">0</strong>
            <span style="display: block; font-size: 0.8rem; color: var(--muted); margin-top: 4px;">Weeks + remainder days</span>
          </div>
          <div style="background: var(--bg); border: 1px solid var(--line); border-radius: 10px; padding: 18px 12px; text-align: center;">
            <span style="display: block; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); font-weight: 800; margin-bottom: 4px;">Weekdays</span>
            <strong id="dbd-weekdays" style="font-size: clamp(1.8rem, 4vw, 2.4rem); color: var(--accent-2); font-weight: 900; line-height: 1.1;">0</strong>
            <span style="display: block; font-size: 0.8rem; color: var(--muted); margin-top: 4px;">Monday through Friday</span>
          </div>
          <div style="background: var(--bg); border: 1px solid var(--line); border-radius: 10px; padding: 18px 12px; text-align: center;">
            <span style="display: block; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); font-weight: 800; margin-bottom: 4px;">Weekend Days</span>
            <strong id="dbd-weekends" style="font-size: clamp(1.8rem, 4vw, 2.4rem); color: var(--warn); font-weight: 900; line-height: 1.1;">0</strong>
            <span style="display: block; font-size: 0.8rem; color: var(--muted); margin-top: 4px;">Saturday and Sunday</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Visual Hero / Overview Infographic -->
  <div class="infographic-wrapper" style="margin-top: 36px;">
    <img
      src="/assets/days-between-dates-calculator-hero.webp"
      alt="Days between dates calculator showing a calendar with a start date and an end date"
      class="infographic-image"
      width="960"
      height="540"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <!-- ═══════════════════════════════════════════════════════════════════════
       SEMANTIC EDUCATIONAL CONTENT
       ═══════════════════════════════════════════════════════════════════════ -->
  <div style="max-width: 820px; margin: 0 auto; padding: 36px 0 0;">

    <!-- H2: How to calculate days between dates -->
    <section>
      <h2 style="font-size: clamp(1.5rem, 3.5vw, 2.1rem); border-bottom: 1px solid var(--line); padding-bottom: 12px; margin-bottom: 18px;">
        How to calculate days between dates
      </h2>
      <p style="color: var(--muted); line-height: 1.75; font-size: 1.05rem;">
        To calculate the number of days between two calendar dates, subtract the start date from the end date. The mathematical result represents the elapsed time interval—the total number of complete 24-hour periods between the two moments—<strong style="color: var(--text);">excluding the end date</strong>.
      </p>
      <p style="color: var(--muted); line-height: 1.75; font-size: 1.05rem; margin-top: 12px;">
        If your intention is to count every calendar date touched by an event or schedule, you must <strong style="color: var(--text);">add 1</strong> to include both the start and end days.
      </p>
      
      <div style="background: var(--panel); border-left: 4px solid var(--accent); border-radius: 0 10px 10px 0; padding: 18px 20px; margin: 20px 0;">
        <h3 style="margin: 0 0 8px; font-size: 1.1rem; color: var(--accent);">Mathematical Formulas:</h3>
        <p style="margin: 0 0 6px; font-family: monospace; font-size: 1rem; color: var(--text);">
          <strong>Exclusive Days</strong> = End Date − Start Date
        </p>
        <p style="margin: 0; font-family: monospace; font-size: 1rem; color: var(--text);">
          <strong>Inclusive Days</strong> = (End Date − Start Date) + 1
        </p>
      </div>

      <p style="color: var(--muted); line-height: 1.75; font-size: 1.05rem;">
        Consider our pre-filled worked example from <strong style="color: var(--text);">22 September 2026</strong> to <strong style="color: var(--text);">27 November 2026</strong>:
      </p>
      <ul style="color: var(--muted); line-height: 1.75; padding-left: 24px; margin: 12px 0;">
        <li><strong style="color: var(--text);">Excluding the end date:</strong> The difference is exactly <strong style="color: var(--accent);">66 days</strong> (from September 23 up to and including November 27).</li>
        <li><strong style="color: var(--text);">Including the end date:</strong> When counting both September 22 and November 27, the result becomes <strong style="color: var(--accent);">67 days</strong>.</li>
      </ul>
    </section>

    <!-- Diagram 1: Inclusive vs Exclusive Explanation -->
    <div class="infographic-wrapper">
      <figure style="margin: 0; text-align: center; width: 100%;">
        <img
          src="/assets/days-between-dates-calculation-example.webp"
          alt="Diagram showing how days are counted between 22 September 2026 and 27 November 2026"
          class="infographic-image"
          width="800"
          height="450"
          loading="lazy"
          decoding="async"
        />
        <figcaption class="infographic-caption">66 days excluding the end date, 67 days including it.</figcaption>
      </figure>
    </div>

    <!-- H2: Inclusive vs. exclusive date counting -->
    <section>
      <h2 style="font-size: clamp(1.5rem, 3.5vw, 2.1rem); border-bottom: 1px solid var(--line); padding-bottom: 12px; margin-bottom: 18px;">
        Inclusive vs. exclusive date counting
      </h2>
      <p style="color: var(--muted); line-height: 1.75; font-size: 1.05rem;">
        Choosing between inclusive and exclusive date counting depends entirely on whether your scenario measures an <em>elapsed duration</em> or an <em>active calendar span</em>:
      </p>
      
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin: 20px 0;" class="comparison-grid">
        <div style="background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 18px;">
          <h3 style="margin-top: 0; color: var(--accent-2); font-size: 1.15rem;">When to Use Exclusive Counting</h3>
          <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6;">
            Exclusive counting calculates the elapsed difference. Use it when:
          </p>
          <ul style="color: var(--muted); font-size: 0.9rem; line-height: 1.6; padding-left: 20px; margin: 8px 0 0;">
            <li><strong>Hotel Stays:</strong> Checking in on Friday and checking out on Sunday equals 2 nights, not 3.</li>
            <li><strong>Car Rentals:</strong> Renting a vehicle from 10:00 AM Monday to 10:00 AM Tuesday is billed as 1 elapsed day.</li>
            <li><strong>Age & Milestones:</strong> A child born on January 1 is not one full day old until January 2.</li>
            <li><strong>Time Countdowns:</strong> Days remaining until a future scheduled launch or event.</li>
          </ul>
        </div>
        
        <div style="background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 18px;">
          <h3 style="margin-top: 0; color: var(--warn); font-size: 1.15rem;">When to Use Inclusive Counting</h3>
          <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6;">
            Inclusive counting counts every calendar date touched. Use it when:
          </p>
          <ul style="color: var(--muted); font-size: 0.9rem; line-height: 1.6; padding-left: 20px; margin: 8px 0 0;">
            <li><strong>Vacation Leave (PTO):</strong> Taking annual leave from Monday through Friday consumes 5 business days.</li>
            <li><strong>Conference & Event Attendance:</strong> A workshop running from Thursday through Saturday is a 3-day event.</li>
            <li><strong>Medication Courses:</strong> A 7-day antibiotic prescription started Monday completes on Sunday evening.</li>
            <li><strong>Rental Tenancy Agreements:</strong> Lease periods spanning from the 1st through the 31st of a month.</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- H2: How weeks and remaining days are calculated -->
    <section>
      <h2 style="font-size: clamp(1.5rem, 3.5vw, 2.1rem); border-bottom: 1px solid var(--line); padding-bottom: 12px; margin-bottom: 18px;">
        How weeks and remaining days are calculated
      </h2>
      <p style="color: var(--muted); line-height: 1.75; font-size: 1.05rem;">
        A standard calendar week consists of exactly 7 days. Because real-world projects and personal deadlines are frequently organized into weekly cycles, our calculator converts the total day count into full weeks and remaining days using integer division and the modulus operator:
      </p>
      <ul style="color: var(--muted); line-height: 1.75; padding-left: 24px; margin: 12px 0;">
        <li><strong style="color: var(--text);">Full Weeks:</strong> <code>Math.floor(Total Days / 7)</code></li>
        <li><strong style="color: var(--text);">Remaining Days:</strong> <code>Total Days % 7</code></li>
      </ul>
      <p style="color: var(--muted); line-height: 1.75; font-size: 1.05rem;">
        In the worked example of 66 days:
      </p>
      <p style="background: var(--bg); border: 1px solid var(--line); border-radius: 8px; padding: 12px 16px; font-family: monospace; font-size: 1.05rem; color: var(--text);">
        66 ÷ 7 = 9 full weeks (63 days) with 3 remainder days → <strong>9 weeks + 3 days</strong>
      </p>
      <p style="color: var(--muted); line-height: 1.75; font-size: 1.05rem;">
        When toggled to inclusive counting (67 days), the calculation updates to <strong>9 weeks + 4 days</strong>.
      </p>
    </section>

    <!-- H2: Calendar days vs. weekdays and weekend days -->
    <section>
      <h2 style="font-size: clamp(1.5rem, 3.5vw, 2.1rem); border-bottom: 1px solid var(--line); padding-bottom: 12px; margin-bottom: 18px;">
        Calendar days versus weekdays and weekend days
      </h2>
      <p style="color: var(--muted); line-height: 1.75; font-size: 1.05rem;">
        Calendar days count every tick of the calendar regardless of commercial operations. However, professional planning requires distinguishing between operational workdays and rest periods:
      </p>
      <ul style="color: var(--muted); line-height: 1.75; padding-left: 24px; margin: 12px 0;">
        <li><strong style="color: var(--text);">Weekdays:</strong> Monday, Tuesday, Wednesday, Thursday, and Friday.</li>
        <li><strong style="color: var(--text);">Weekend Days:</strong> Saturday and Sunday.</li>
      </ul>
      <p style="color: var(--muted); line-height: 1.75; font-size: 1.05rem;">
        For our 66-day span (September 22 to November 27, 2026), the tool breaks down the interval into:
      </p>
      <ul style="color: var(--muted); line-height: 1.75; padding-left: 24px; margin: 12px 0;">
        <li><strong style="color: var(--accent-2);">48 Weekdays:</strong> Accounting for approximately 72.7% of the total time span.</li>
        <li><strong style="color: var(--warn);">18 Weekend Days:</strong> Encompassing 9 full Saturdays and 9 full Sundays (27.3% of the span).</li>
      </ul>

      <!-- Limitation Callout -->
      <div style="background: color-mix(in srgb, var(--warn) 10%, var(--panel)); border-left: 4px solid var(--warn); border-radius: 0 10px 10px 0; padding: 18px 20px; margin: 24px 0;">
        <h3 style="margin: 0 0 8px; font-size: 1.1rem; color: var(--warn);">Important Limitation: Weekdays vs. Official Business Days</h3>
        <p style="margin: 0; color: var(--text); font-size: 0.95rem; line-height: 1.65;">
          This calculator isolates Monday-through-Friday weekdays from Saturday and Sunday weekends. It does <strong>not</strong> subtract public holidays (such as Thanksgiving, Christmas, or national bank holidays). If your contract, financial settlement, or project requires excluding statutory holidays, please consult our specialized <a href="/workday-calculator/" style="color: var(--accent); font-weight: 700; text-decoration: underline; text-underline-offset: 3px;">Workday Calculator</a>, which includes dedicated international holiday presets.
        </p>
      </div>
    </section>

    <!-- Diagram 2: Calendar Breakdown -->
    <div class="infographic-wrapper">
      <figure style="margin: 0; text-align: center; width: 100%;">
        <img
          src="/assets/days-between-dates-calendar-breakdown.webp"
          alt="Decomposing a Date Range: Days, Weeks & Weekdays"
          class="infographic-image"
          width="800"
          height="450"
          loading="lazy"
          decoding="async"
        />
        <figcaption class="infographic-caption">Visual breakdown of a 66-day span: 48 weekdays and 18 weekend days across 9 weeks.</figcaption>
      </figure>
    </div>

    <!-- H2: Date boundary edge cases -->
    <section>
      <h2 style="font-size: clamp(1.5rem, 3.5vw, 2.1rem); border-bottom: 1px solid var(--line); padding-bottom: 12px; margin-bottom: 18px;">
        Date boundary edge cases: Leap years, month lengths, and same-day ranges
      </h2>
      <p style="color: var(--muted); line-height: 1.75; font-size: 1.05rem;">
        Accurate date arithmetic must accommodate calendar irregularities that derail simple mental estimates:
      </p>

      <h3 style="font-size: 1.3rem; color: var(--text); margin: 20px 0 10px;">1. Leap Years and February 29</h3>
      <p style="color: var(--muted); line-height: 1.75; font-size: 1.05rem;">
        Under the Gregorian calendar, a year is a leap year if it is evenly divisible by 4, except for end-of-century years which must be divisible by 400. In leap years, February gains a 29th day.
      </p>
      <ul style="color: var(--muted); line-height: 1.75; padding-left: 24px; margin: 12px 0;">
        <li>In a standard year such as <strong style="color: var(--text);">2026</strong>, February has 28 days. The span from <strong style="color: var(--text);">February 28 to March 1</strong> is <strong style="color: var(--accent);">1 day</strong>.</li>
        <li>In a leap year such as <strong style="color: var(--text);">2028</strong>, February has 29 days. The span from <strong style="color: var(--text);">February 28 to March 1</strong> is <strong style="color: var(--accent);">2 days</strong> (because February 29 intervenes).</li>
      </ul>

      <h3 style="font-size: 1.3rem; color: var(--text); margin: 20px 0 10px;">2. Irregular Month Boundaries (28, 30, and 31 Days)</h3>
      <p style="color: var(--muted); line-height: 1.75; font-size: 1.05rem;">
        Because months vary in length between 28 and 31 days, attempting to calculate date differences by multiplying months by 30 produces cumulative discrepancies. For example, July and August have 31 days each (62 consecutive days), whereas February and March in 2026 combine for only 59 days. This calculator uses exact astronomical calendar day math.
      </p>

      <h3 style="font-size: 1.3rem; color: var(--text); margin: 20px 0 10px;">3. Same-Day Ranges</h3>
      <p style="color: var(--muted); line-height: 1.75; font-size: 1.05rem;">
        When the start date and end date are identical (e.g., October 25, 2026 to October 25, 2026):
      </p>
      <ul style="color: var(--muted); line-height: 1.75; padding-left: 24px; margin: 12px 0;">
        <li><strong style="color: var(--text);">Exclusive mode:</strong> Evaluates to <strong style="color: var(--accent);">0 days</strong>. No 24-hour elapsed interval exists between a date and itself.</li>
        <li><strong style="color: var(--text);">Inclusive mode:</strong> Evaluates to <strong style="color: var(--accent);">1 day</strong>. That specific calendar date is active and counted.</li>
      </ul>
    </section>

    <!-- H2: Days between dates examples -->
    <section>
      <h2 style="font-size: clamp(1.5rem, 3.5vw, 2.1rem); border-bottom: 1px solid var(--line); padding-bottom: 12px; margin-bottom: 18px;">
        Days between dates examples
      </h2>
      <p style="color: var(--muted); line-height: 1.75; font-size: 1.05rem; margin-bottom: 16px;">
        The table below provides verified date difference calculations across common calendar spans, seasons, and leap-year boundaries:
      </p>
      
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">Start date</th>
              <th scope="col">End date</th>
              <th scope="col">Days (excl. end)</th>
              <th scope="col">Days (incl. end)</th>
              <th scope="col">Weeks breakdown</th>
              <th scope="col">Key Context</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>1 January 2026</td>
              <td>31 December 2026</td>
              <td><strong>364</strong></td>
              <td><strong>365</strong></td>
              <td>52 weeks + 0 / 1 day</td>
              <td>Full standard calendar year</td>
            </tr>
            <tr>
              <td>25 October 2026</td>
              <td>27 November 2026</td>
              <td><strong>33</strong></td>
              <td><strong>34</strong></td>
              <td>4 weeks + 5 / 6 days</td>
              <td>Autumn stretch to Black Friday</td>
            </tr>
            <tr>
              <td>22 September 2026</td>
              <td>27 November 2026</td>
              <td><strong>66</strong></td>
              <td><strong>67</strong></td>
              <td>9 weeks + 3 / 4 days</td>
              <td>September Equinox to Thanksgiving weekend</td>
            </tr>
            <tr>
              <td>28 February 2028</td>
              <td>1 March 2028</td>
              <td><strong>2</strong></td>
              <td><strong>3</strong></td>
              <td>0 weeks + 2 / 3 days</td>
              <td>Leap year crossing February 29</td>
