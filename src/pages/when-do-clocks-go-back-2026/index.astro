---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import { siteUrl } from "theme/i18n/config";

const lang = "en";
const dir = "ltr";
const slug = "when-do-clocks-go-back-2026";
const seoTitle = "When Do Clocks Go Back in 2026? US Fall Back Date, Time & What Changes";
const pageDescription = "When is daylight savings 2026? Clocks go back Sunday, Nov 1, 2026 at 2:00 AM in the US — Europe changes Oct 25. See what happens to EST, GMT and your conversions.";

const pubDate = "2026-10-22T12:00:00+05:00";
const updatedDate = "2026-10-22T12:00:00+05:00";

const faqs = [
  {
    q: "When is daylight savings 2026 over?",
    a: "Daylight saving time ends in the US on Sunday, November 1, 2026, when clocks fall back one hour at 2:00 AM and standard time (EST) returns."
  },
  {
    q: "Do clocks go back in October or November 2026?",
    a: "Both — the UK and Europe fall back on October 25, 2026; the US and Canada fall back on November 1, 2026."
  },
  {
    q: "Does GMT change when clocks go back?",
    a: "No. GMT never changes. Only the local zones move — Eastern goes from EDT (UTC-4) to EST (UTC-5), so GMT becomes 5 hours ahead of Eastern instead of 4."
  }
];

const meta = {
  seoTitle,
  exactTitle: true,
  exactDescription: true,
  description: pageDescription,
  keywords: "when do clocks go back 2026, daylight savings 2026, fall back 2026 date, clocks change november 2026, EDT to EST 2026, when does daylight savings end 2026, clocks go back 2026 us",
  image: "/images/og/default.png",
  imageAlt: "When Do Clocks Go Back in 2026 Infographic",
  pubDate,
  updatedDate,
  author: "Jackie Bruce",
  faqs
};

const pageUrlPath = `${siteUrl}/when-do-clocks-go-back-2026/`;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "@id": `${pageUrlPath}#article`,
  "mainEntityOfPage": pageUrlPath,
  "headline": seoTitle,
  "description": pageDescription,
  "datePublished": pubDate,
  "dateModified": updatedDate,
  "inLanguage": "en",
  "author": {
    "@type": "Person",
    "name": "Jackie Bruce",
    "jobTitle": "Senior Time Zone Analyst",
    "url": `${siteUrl}/author/jackie-bruce/`
  },
  "publisher": {
    "@type": "Organization",
    "name": "GMT to EST Converter",
    "url": siteUrl,
    "logo": {
      "@type": "ImageObject",
      "url": `${siteUrl}/logo.svg`
    }
  }
};
---

<BaseLayout
  lang={lang}
  dir={dir}
  title={seoTitle}
  description={pageDescription}
  slug={slug}
  meta={meta}
  enableFaqSchema={true}
  enableArticleSchema={false}
  hreflangCodes={["en"]}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} slot="head" />

  <!-- Hero Banner -->
  <section class="hero-banner" aria-labelledby="hero-title">
    <h1 id="hero-title" class="hero-banner-title">
      When Do Clocks Go Back in 2026?
    </h1>
  </section>

  <!-- Editorial Info Bar -->
  <div class="editorial-meta-bar" aria-label="Editorial metadata">
    <span>Last Updated: <strong>October 22, 2026</strong></span>
    <span class="separator" aria-hidden="true">•</span>
    <span>Editorially Reviewed by <a href="/author/jackie-bruce/"><strong>Jackie Bruce</strong></a></span>
    <span class="separator" aria-hidden="true">•</span>
    <span>Data Source: <a href="https://www.iana.org/time-zones" target="_blank" rel="noopener noreferrer"><strong>IANA Time Zone Database</strong></a></span>
  </div>

  <div class="guide-content-wrapper">
    <!-- 1. Quick Answer Box -->
    <aside class="quick-answer-card" aria-label="Quick Answer: When Do Clocks Go Back in 2026?">
      <div class="quick-answer-badge">
        <span class="quick-answer-badge-icon" aria-hidden="true">⚡</span>
        <span>Quick Answer</span>
      </div>
      <p class="quick-answer-definition">
        In the US, clocks go back one hour on Sunday, November 1, 2026 at 2:00 AM local time — 2:00 AM becomes 1:00 AM. Eastern Time switches from EDT (UTC-4) back to EST (UTC-5). In the UK and Europe, clocks go back one week earlier, on Sunday, October 25, 2026.
      </p>
    </aside>

    <!-- Table of Contents -->
    <nav class="table-of-contents" aria-label="Table of Contents">
      <span class="toc-kicker">Navigation</span>
      <h2>Guide Contents</h2>
      <ol>
        <li><a href="#what-changes">What changes on November 1</a></li>
        <li><a href="#conversions-table">Key conversions before vs after Nov 1</a></li>
        <li><a href="#gap-week">The gap week: October 25 - November 1</a></li>
        <li><a href="#who-does-not-change">Who does not change</a></li>
        <li><a href="#when-clocks-go-forward">When do clocks go forward again?</a></li>
        <li><a href="#frequently-asked-questions">Frequently Asked Questions (FAQ)</a></li>
      </ol>
    </nav>

    <!-- 2. What Changes on November 1 -->
    <section id="what-changes" class="content-section">
      <h2>What changes on November 1</h2>
      <p>
        On Sunday, November 1, 2026, Daylight Saving Time ends in the United States and Canada. Eastern Daylight Time (EDT, UTC-4) concludes, and Eastern Standard Time (EST, UTC-5) returns, remaining in effect through March 14, 2027.
      </p>
      <p>
        At 2:00 AM local time, clocks shift backward sixty minutes to 1:00 AM. Because of this regression, the day is 25 hours long and the hour from 1:00 AM to 2:00 AM happens twice. This transition grants an extra hour of sleep overnight, shifts sunrise an hour earlier, and causes dusk to fall earlier each evening.
      </p>
      <p>
        Greenwich Mean Time (GMT) itself never changes. GMT is an unvarying astronomical standard anchored at zero degrees longitude (UTC+0). Because GMT never adjusts for seasonal daylight hours, the time difference between GMT and Eastern Time widens from 4 hours back to 5 hours. You can review the underlying offset details in our <a href="/est-vs-edt/">EST vs EDT guide</a> or check real-time clocks on our <a href="/">homepage converter</a>.
      </p>
    </section>

    <!-- 3. Key Conversions Before vs After Nov 1 -->
    <section id="conversions-table" class="content-section">
      <h2>Key conversions before vs after Nov 1</h2>
      <p>
        When clocks fall back to EST, all conversion formulas between GMT and North America gain an additional hour. The table below outlines key benchmark conversions across the transatlantic business day:
      </p>

      <div class="table-wrap">
        <table aria-label="Key conversions before and after November 1, 2026">
          <caption class="table-caption">
            Transatlantic time conversion benchmarks before versus after November 1, 2026.
          </caption>
          <thead>
            <tr>
              <th scope="col">GMT Time</th>
              <th scope="col">Before Nov 1 (EDT / UTC-4)</th>
              <th scope="col">After Nov 1 (EST / UTC-5)</th>
              <th scope="col">Transatlantic Schedule Impact</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>12:00 PM GMT</strong></td>
              <td>8:00 AM EDT</td>
              <td>7:00 AM EST</td>
              <td>London midday corresponds to early US morning</td>
            </tr>
            <tr>
              <td><strong>1:00 PM GMT</strong></td>
              <td>9:00 AM EDT</td>
              <td>8:00 AM EST</td>
              <td>Pre-market trading hours on the East Coast</td>
            </tr>
            <tr>
              <td><strong>5:00 PM GMT</strong></td>
              <td>1:00 PM EDT</td>
              <td>12:00 PM EST</td>
              <td>London markets close during US lunch hour</td>
            </tr>
            <tr>
              <td><strong>9:00 PM GMT</strong></td>
              <td>5:00 PM EDT</td>
              <td>4:00 PM EST</td>
              <td>European late evening aligns with US market close</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p>
        Notice that 12 PM GMT equals 8 AM EDT before November 1, but becomes 7 AM EST after the change. Likewise, 5 PM GMT equals 1 PM EDT before the transition, and shifts to 12 PM EST afterward.
      </p>
    </section>

    <!-- 4. The Gap Week: October 25 - November 1 -->
    <section id="gap-week" class="content-section">
      <h2>The gap week: October 25 - November 1</h2>
      <p>
        The United Kingdom and the European Union do not change clocks on the same date as North America. In Europe, clocks fall back on the last Sunday of October (October 25, 2026), whereas the United States and Canada do not fall back until the first Sunday of November (November 1, 2026).
      </p>
      <p>
        During this seven-day gap week, Europe has already fallen back to standard time while North America remains on daylight saving time. As a result, time differences between the continents shrink by one hour:
      </p>
      <ul>
        <li>
          <strong>London to New York</strong>: Shrinks from the winter 5-hour gap down to only 4 hours.
        </li>
        <li>
          <strong>Paris / Berlin to New York</strong>: Shrinks from the typical 6-hour gap down to only 5 hours.
        </li>
      </ul>
      <p>
        Transatlantic professionals must double-check meeting calendars during this week. Recurring calls scheduled by local clock time will shift by one hour relative to foreign participants until the US catches up on November 1.
      </p>
    </section>

    <!-- 5. Who Does Not Change -->
    <section id="who-does-not-change" class="content-section">
      <h2>Who does not change</h2>
      <p>
        Under the Uniform Time Act of 1966, several states and territories opt out of seasonal clock adjustments entirely:
      </p>
      <ul>
        <li>
          <strong>Hawaii</strong>: Stays on Hawaii Standard Time (HST, UTC-10) all year.
        </li>
        <li>
          <strong>Arizona</strong>: Most of the state remains on Mountain Standard Time (MST, UTC-7) year-round. The exception is the Navajo Nation, which does observe daylight saving time and falls back on November 1.
        </li>
        <li>
          <strong>U.S. Territories</strong>: Puerto Rico, the U.S. Virgin Islands, Guam, American Samoa, and the Northern Mariana Islands remain on standard time permanently.
        </li>
      </ul>
      <p>
        Because these regions stay put, their offset relative to Eastern Time changes instead. For example, Puerto Rico operates on Atlantic Standard Time (AST, UTC-4) year-round. In summer, Puerto Rico shares the exact same clock time as New York (EDT, UTC-4). When Eastern falls back to EST (UTC-5) on November 1, Puerto Rico remains on UTC-4, moving one hour ahead of New York.
      </p>
    </section>

    <!-- 6. When Do Clocks Go Forward Again? -->
    <section id="when-clocks-go-forward" class="content-section">
      <h2>When do clocks go forward again?</h2>
      <p>
        Standard time remains active for four and a half months. Clocks will spring forward again on Sunday, March 14, 2027 at 2:00 AM local time, jumping forward to 3:00 AM. Eastern Time will return to EDT (UTC-4), creating a 23-hour day and restoring the 4-hour difference to GMT.
      </p>
    </section>

    <!-- 7. Frequently Asked Questions -->
    <section id="frequently-asked-questions" class="content-section">
      <h2>Frequently Asked Questions (FAQ)</h2>
      <div class="faq">
        {faqs.map((faq) => (
          <details>
            <summary><strong>{faq.q}</strong></summary>
            <p style="margin-top: 0.75rem; color: var(--muted); line-height: 1.6;">
              {faq.a}
            </p>
          </details>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

