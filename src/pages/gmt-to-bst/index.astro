---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import Converter from "theme/components/Converter.astro";
import { getTranslation, pageUrl, siteUrl } from "theme/i18n/config";

const lang = "en";
const dir = "ltr";
const slug = "gmt-to-bst";
const t = getTranslation(lang);

const pageTitle = "GMT to BST Converter";
const seoTitle = "GMT to BST Converter – Greenwich Mean Time to British Summer Time";
const pageDescription = "Convert GMT to BST instantly. Our free, DST-aware UK converter calculates the exact time difference between Greenwich Mean Time and British Summer Time, featuring a live clock, meeting planner, and conversion tables.";

const context = {
  from: "GMT",
  to: "BST",
  fromZone: "UTC",
  toZone: "Europe/London"
};

const canonical = `${siteUrl}/gmt-to-bst/`;

// 24-hour conversion table data (GMT → BST = GMT + 1)
function formatHour12(hour: number) {
  const normalized = ((hour % 24) + 24) % 24;
  const period = normalized < 12 ? "AM" : "PM";
  const displayHour = normalized % 12 || 12;
  return `${displayHour}:00 ${period}`;
}

const conversionRows = Array.from({ length: 24 }, (_, hour) => {
  const bstHour = hour + 1;
  const bstNormalized = ((bstHour % 24) + 24) % 24;
  const nextDay = bstHour >= 24;
  const period = bstNormalized < 12 ? "AM" : "PM";
  const displayHour = bstNormalized % 12 || 12;
  return {
    gmt: formatHour12(hour),
    bst: `${displayHour}:00 ${period}${nextDay ? " (+1 day)" : ""}`,
    dayNote: nextDay ? "Next day" : "Same day"
  };
});

// Popular conversions
const popularConversions = [
  { gmt: "12:00 AM (Midnight)", bst: "1:00 AM BST", note: "Middle of the night in the UK" },
  { gmt: "2:00 AM", bst: "3:00 AM BST", note: "Late night/early hours in London" },
  { gmt: "5:00 AM", bst: "6:00 AM BST", note: "Dawn in the UK, early start" },
  { gmt: "8:00 AM", bst: "9:00 AM BST", note: "London offices opening and starting the workday" },
  { gmt: "10:00 AM", bst: "11:00 AM BST", note: "Mid-morning focus hours across British companies" },
  { gmt: "12:00 PM (Noon)", bst: "1:00 PM BST", note: "Lunch break hours in the UK" },
  { gmt: "2:00 PM", bst: "3:00 PM BST", note: "Mid-afternoon collaboration window" },
  { gmt: "4:00 PM", bst: "5:00 PM BST", note: "UK offices wrapping up tasks before evening" },
  { gmt: "6:00 PM", bst: "7:00 PM BST", note: "Evening relaxation and leisure time in the UK" },
  { gmt: "8:00 PM", bst: "9:00 PM BST", note: "Prime-time broadcasting and evening hours" },
  { gmt: "10:00 PM", bst: "11:00 PM BST", note: "Late evening, preparing for sleep in Britain" },
];

// FAQ data
const faqs = [
  { q: "What is BST?", a: "BST stands for British Summer Time. It represents the daylight saving time zone observed in the United Kingdom (England, Scotland, Wales, and Northern Ireland) during the summer months. It is equal to Coordinated Universal Time plus one hour (UTC+1)." },
  { q: "Is BST the same as Bangladesh Standard Time?", a: "No. On this page, BST refers strictly to British Summer Time (UTC+1). Bangladesh Standard Time is also abbreviated as BST but runs at UTC+6, which is five hours ahead of British Summer Time. We do not cover or support Bangladesh Standard Time on this converter page to avoid scheduling errors." },
  { q: "Is GMT the same as UTC?", a: "For civil timekeeping, GMT (Greenwich Mean Time) and UTC (Coordinated Universal Time) are identical. However, UTC is the modern atomic-standard reference used by computer servers and satellites, while GMT is the historical solar-based time reference centered around the Royal Observatory in Greenwich, London." },
  { q: "How many hours is BST ahead of GMT?", a: "British Summer Time (BST) is exactly one hour ahead of Greenwich Mean Time (GMT). During summer, when the UK switches to BST, you add one hour to the GMT clock (e.g., 10:00 AM GMT becomes 11:00 AM BST)." },
  { q: "Is London always on BST?", a: "No. London only uses BST during the summer. During the winter months, London reverts to GMT (UTC+0). The transition happens on the last Sunday of March (when clocks forward to BST) and the last Sunday of October (when clocks fall back to GMT)." },
  { q: "When does BST start in the United Kingdom?", a: "British Summer Time starts on the last Sunday of March. At 1:00 AM GMT, clocks are advanced by one hour to 2:00 AM BST. This transition is commonly known as 'springing forward' and gives the UK longer evening daylight." },
  { q: "When does BST end in the United Kingdom?", a: "British Summer Time ends on the last Sunday of October. At 2:00 AM BST, clocks are set back by one hour to 1:00 AM GMT. This transition is known as 'falling back' and signals the return to winter standard time." },
  { q: "Does the UK observe Daylight Saving Time?", a: "Yes. The UK observes Daylight Saving Time by switching from its standard winter time (GMT, UTC+0) to summer time (BST, UTC+1). The primary goal is to shift daylight hours from the early morning to the evening during summer months." },
  { q: "Why did the UK introduce British Summer Time?", a: "BST was introduced following a campaign by William Willett in the early 20th century to prevent daylight from being wasted in the early morning while people slept. The Daylight Saving Act was officially passed in 1916 during World War I to conserve coal and electricity." },
  { q: "What is the UTC offset for GMT and BST?", a: "GMT is at UTC+0 (zero offset from Coordinated Universal Time). BST is at UTC+1 (one hour ahead of Coordinated Universal Time). This means that during the BST period, the UK clock runs 60 minutes ahead of the global baseline." },
  { q: "How do I manually convert GMT to BST?", a: "To convert GMT to BST manually, simply add 1 hour to the GMT time. For example, if it is 3:30 PM GMT, it is 4:30 PM BST. Ensure you only perform this addition during the UK daylight saving period (March through October)." },
  { q: "What happens to international flight schedules during the clock change?", a: "Airlines operate on UTC/GMT, but local departure and arrival times in the UK shift by one hour when the transition occurs. This means flights landing in London will show a different local time, though the actual travel duration remains identical." },
  { q: "Which countries or regions use British Summer Time?", a: "British Summer Time is used across England, Scotland, Wales, Northern Ireland, the Isle of Man, and the Channel Islands. The Republic of Ireland uses Irish Standard Time (IST, UTC+1) during the same period, which is identical in time but has a different legal name." },
  { q: "Is BST used all year round?", a: "No. BST is only active during the warmer spring, summer, and early autumn months. It lasts approximately 7 months of the year, while GMT is used for the remaining 5 winter months." },
  { q: "Does London time shift relative to New York?", a: "Yes. Because the US and the UK transition to and from daylight saving time on different dates, the time gap between London and New York fluctuates. Typically, it is 5 hours (BST to EDT) or 5 hours (GMT to EST), but for a brief 2-3 week period in March and October, it becomes 4 hours." },
  { q: "How accurate is this GMT to BST converter?", a: "Our converter uses the official IANA Time Zone Database (specifically the Europe/London ruleset) loaded through the browser's native API. This ensures 100% accuracy, automatic calendar logic, and correct handling of historical data." },
  { q: "What was 'British Double Summer Time'?", a: "During World War II, the UK temporarily adopted British Double Summer Time (BDST), which was two hours ahead of GMT (UTC+2) in summer and one hour ahead (UTC+1) in winter, to maximize industrial output and save fuel." },
  { q: "Is GMT the same as BST?", a: "No. GMT (Greenwich Mean Time) is UTC+0, while BST (British Summer Time) is UTC+1. They are distinct time offsets used by the same region (the United Kingdom) during different parts of the calendar year." },
  { q: "How does BST compare to CET?", a: "CET (Central European Time) is UTC+1 during winter. In summer, Europe switches to CEST (Central European Summer Time, UTC+2). Therefore, the UK (on BST, UTC+1) remains exactly 1 hour behind Central Europe (on CEST, UTC+2) during the summer months." },
  { q: "What is Europe/London in software code?", a: "Europe/London is the standardized database key in the IANA Time Zone Database (tzdb). It encapsulates all historical clock transitions for Great Britain, automatically selecting GMT or BST based on the timestamp queried." },
  { q: "Do computer servers run on GMT or BST?", a: "Most internet servers and cloud databases are configured to use UTC (which matches GMT) to prevent data inconsistencies when clocks change. Local user interfaces then translate this UTC timestamp into BST or other local offsets." },
  { q: "What time is 8 PM GMT in BST?", a: "8:00 PM GMT is equal to 9:00 PM BST on the same day. Since BST is 1 hour ahead of GMT, we simply advance the clock by 60 minutes." },
];

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "GMT to BST, GMT to British Summer Time, British Summer Time Converter, GMT BST Converter, Convert GMT to BST, GMT to UK Time, GMT to London Time, GMT to England Time, Greenwich Mean Time to BST, GMT BST Time Difference, Current BST Time, British Summer Time Clock, GMT UTC to BST",
  image: "/assets/gmt-to-bst-og.svg",
  imageAlt: "GMT to BST Converter – Convert Greenwich Mean Time to British Summer Time",
  faqs,
  appDescription: "Free online GMT to BST converter with real-time clocks, DST-aware calculation, 24-hour conversion chart, and meeting planner for scheduling between Greenwich Mean Time and British Summer Time.",
  applicationCategory: "UtilityApplication",
  operatingSystem: "Any",
  howToName: "How to Convert GMT to BST",
  howToDescription: "Step-by-step guide to converting Greenwich Mean Time to British Summer Time using our free online tool.",
  howToSteps: [
    { name: "Check the date on the calendar", text: "Look at the target date. BST is active from the last Sunday of March to the last Sunday of October. If your date falls outside this window, the UK is on GMT." },
    { name: "Input your GMT time", text: "Use the picker to select your GMT time. The tool defaults to the current time but lets you adjust the hours, minutes, and calendar date." },
    { name: "Read the converted BST time", text: "The converter immediately displays the equivalent British Summer Time, indicating the +1 hour offset and whether the date shifts." },
    { name: "Copy or swap the directions", text: "Click the copy button to save the result. Use the swap button to calculate in the reverse direction (BST to GMT) as needed." }
  ],
};
---

<BaseLayout
