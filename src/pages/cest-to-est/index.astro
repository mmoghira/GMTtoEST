---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import Converter from "theme/components/Converter.astro";
import { getTranslation, pageUrl, siteUrl } from "theme/i18n/config";

const lang = "en";
const dir = "ltr";
const slug = "cest-to-est";
const t = getTranslation(lang);

const pageTitle = "CEST to EST Converter";
const seoTitle = "CEST to EST Converter – Central European Summer Time to Eastern Standard Time";
const pageDescription = "Convert CEST to EST effortlessly. Calculate the 7-hour time difference between Central Europe (Paris, Berlin, Rome) and North America Eastern Standard Time with live clocks, conversion table, and meeting scheduling tools.";

const context = {
  from: "CEST",
  to: "EST",
  fromZone: "Europe/Paris",
  toZone: "America/New_York"
};

const canonical = `${siteUrl}/cest-to-est/`;

// 24-hour conversion table data (CEST → EST = CEST - 7 hours)
function formatHour12(hour: number) {
  const normalized = ((hour % 24) + 24) % 24;
  const period = normalized < 12 ? "AM" : "PM";
  const displayHour = normalized % 12 || 12;
  return `${displayHour}:00 ${period}`;
}

const conversionRows = Array.from({ length: 24 }, (_, hour) => {
  const estHour = hour - 7;
  const normalizedEst = ((estHour % 24) + 24) % 24;
  const prevDay = estHour < 0;
  const period = normalizedEst < 12 ? "AM" : "PM";
  const displayHour = normalizedEst % 12 || 12;
  return {
    cest: formatHour12(hour),
    est: `${displayHour}:00 ${period}${prevDay ? " (-1 day)" : ""}`,
    dayNote: prevDay ? "Previous day" : "Same day"
  };
});

// Popular conversions array
const popularConversions = [
  { cest: "7:00 AM CEST", est: "12:00 AM EST (Midnight)", note: "Early morning in Europe aligns with midnight on US East Coast" },
  { cest: "9:00 AM CEST", est: "2:00 AM EST", note: "European offices open while North America is sleeping" },
  { cest: "11:00 AM CEST", est: "4:00 AM EST", note: "Mid-morning in Paris/Berlin matches early hours in New York" },
  { cest: "1:00 PM CEST", est: "6:00 AM EST", note: "European lunch hour coincides with US East Coast dawn" },
  { cest: "3:00 PM CEST", est: "8:00 AM EST", note: "Afternoon collaboration window as US office hours open" },
  { cest: "4:30 PM CEST", est: "9:30 AM EST", note: "Prime transatlantic meeting window (NYSE opening bell)" },
  { cest: "6:00 PM CEST", est: "11:00 AM EST", note: "End of European workday aligns with mid-morning in Toronto & New York" },
  { cest: "7:00 PM CEST", est: "12:00 PM EST (Noon)", note: "European evening coincides with North American midday lunch" },
  { cest: "9:00 PM CEST", est: "2:00 PM EST", note: "Late evening in Western Europe matches early afternoon EST" },
  { cest: "11:00 PM CEST", est: "4:00 PM EST", note: "European bedtime aligns with end of North American business day" },
  { cest: "1:00 AM CEST (+1)", est: "6:00 PM EST", note: "Overnight in Central Europe matches US East Coast evening wrap-up" },
  { cest: "3:00 AM CEST (+1)", est: "8:00 PM EST", note: "Early morning overnight in Europe coincides with US prime-time hours" }
];

// 14 COMPLETELY UNIQUE FAQs
const faqs = [
  {
    q: "What is the exact time difference between CEST and EST?",
    a: "Eastern Standard Time (EST) is exactly 7 hours behind Central European Summer Time (CEST). When it is 3:00 PM CEST in Paris or Berlin, it is 8:00 AM EST in New York."
  },
  {
    q: "What does CEST stand for?",
    a: "CEST stands for Central European Summer Time. It is the daylight saving time zone used across most of Western and Central Europe (UTC+2) during spring, summer, and early autumn."
  },
  {
    q: "What cities use CEST?",
    a: "CEST is used in major European hubs including Paris, Berlin, Rome, Madrid, Amsterdam, Brussels, Vienna, Zurich, Stockholm, Oslo, Copenhagen, Warsaw, and Prague."
  },
  {
    q: "Is CEST standard time or Daylight Saving Time?",
    a: "CEST is daylight saving time (UTC+2). Central European Standard Time (CET, UTC+1) is used during the winter months from late October to late March."
  },
  {
    q: "What is the difference between CEST and EST during North American summer?",
    a: "During North American summer, the US East Coast switches from EST (UTC-5) to EDT (UTC-4). When Europe is on CEST (UTC+2) and North America is on EDT (UTC-4), the time difference reduces from 7 hours to 6 hours."
  },
  {
    q: "When does Central Europe switch to CEST?",
    a: "Central Europe transitions to CEST on the last Sunday of March at 2:00 AM local time, advancing clocks forward by 1 hour to 3:00 AM CEST."
  },
  {
    q: "When does CEST end in Central Europe?",
    a: "CEST ends on the last Sunday of October at 3:00 AM local time, when clocks are turned back 1 hour to 2:00 AM CET."
  },
  {
    q: "What is the best overlap window for meetings between Paris and New York?",
    a: "The optimal meeting window is between 3:00 PM and 6:00 PM CEST, which translates to 8:00 AM to 11:00 AM EST in North America."
  },
  {
    q: "How does stock trading align between Euronext/Frankfurt and Wall Street?",
    a: "European stock exchanges (like Euronext Paris and the Frankfurt Stock Exchange) close at 5:30 PM CEST, which corresponds to 10:30 AM EST in New York—just one hour after Wall Street opens."
  },
  {
    q: "How do I manually subtract hours from CEST to get EST?",
    a: "To convert CEST to EST manually, subtract 7 hours from the European time. For example, 5:00 PM CEST minus 7 hours equals 10:00 AM EST."
  },
  {
    q: "What happens during the spring and autumn daylight saving transition gap?",
    a: "Europe and North America change clocks on different weekends in March and October/November. During these 2-3 transition weeks, the gap between Paris and New York shifts temporarily between 6 hours and 7 hours."
  },
  {
    q: "What is the IANA time zone identifier for Paris and New York?",
    a: "Paris uses 'Europe/Paris' or 'Europe/Berlin', while New York uses 'America/New_York'."
  },
  {
    q: "Why is transatlantic corporate scheduling often prone to errors?",
    a: "Misinterpreting the 7-hour CEST-to-EST gap versus the 6-hour CEST-to-EDT gap frequently causes double-booking or missed calls during seasonal DST transitions."
  },
  {
    q: "Does Switzerland observe CEST?",
    a: "Yes. Switzerland observes CEST (UTC+2) during summer and CET (UTC+1) during winter, keeping identical timing with neighboring France, Germany, and Italy."
  },
  {
    q: "How does live international broadcast streaming sync between Paris and New York?",
    a: "Broadcasters in Europe schedule evening prime-time coverage at 8:00 PM CEST, which airs live at 1:00 PM EST in North America, requiring real-time signal conversions."
  },
  {
    q: "What is the historical origin of Central European Time zones?",
    a: "Unified Central European Time was established in the late 19th century to harmonize railway timetables across Germany, Austria-Hungary, and neighboring European states."
  },
  {
    q: "Does the European Union plan to abolish seasonal time shifts?",
    a: "The European Parliament voted to back a proposal ending seasonal clock switches, though member states have not yet reached final consensus on adopting permanent CEST or CET."
  }
];

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "CEST to EST, Central European Summer Time to Eastern Standard Time, Paris to New York time, CEST EST converter, Europe to US East Coast time difference, 7 hour time gap, Berlin to Toronto converter",
  image: "/assets/cest-to-est-og.svg",
  imageAlt: "CEST to EST Time Zone Converter",
  faqs,
  appDescription: "Convert Central European Summer Time (CEST) to Eastern Standard Time (EST) with real-time accuracy, 24-hour conversion chart, live clocks, and transatlantic meeting planner.",
  applicationCategory: "UtilityApplication",
  operatingSystem: "Any",
  howToName: "How to Convert CEST to EST",
  howToDescription: "Quick guide to converting Central European Summer Time to Eastern Standard Time.",
  howToSteps: [
    { name: "Determine the CEST time", text: "Select your local hour in Central Europe (CEST, UTC+2)." },
    { name: "Subtract 7 hours", text: "Deduct 7 hours from the CEST time to find the corresponding EST hour." },
    { name: "Verify calendar day", text: "Hours between 12:00 AM and 6:59 AM CEST correspond to the previous day in EST." }
  ]
};
---

<BaseLayout
  lang={lang}
  dir={dir}
  title={seoTitle}
  description={pageDescription}
  slug={slug}
  meta={meta}
  mode="gmt-est"
  enableFaqSchema={true}
  allowAds={true}
  breadcrumbHomeLabel="Home"
  breadcrumbLabel="CEST to EST"
  hreflangCodes={["en"]}
>
  <!-- Hero Section -->
  <header class="hero-banner">
    <div class="hero-content">
      <span class="eyebrow">Transatlantic European-American Bridge</span>
      <h1 class="hero-banner-title">CEST to EST Converter</h1>
      <p class="hero-subtitle">
        Seamlessly convert Central European Summer Time (UTC+2) to Eastern Standard Time (UTC-5) with precision tools and live timezone charts.
      </p>
    </div>
  </header>

<!-- PRIMARY CONVERTER & LIVE CLOCKS (Above the Fold) -->
<div style="max-width: 720px; margin: 0 auto; padding: 0 16px 24px;">
  <Converter intent="dynamic" t={t} context={context} />
  
  <div class="live-clock-strip" style="margin-top: 16px; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px;">
    <div class="clock-card" style="text-align: center; padding: 12px 16px; background: var(--panel); border: 1px solid var(--line); border-radius: 10px;">
      <span class="eyebrow top-source-label" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); display: block; margin-bottom: 4px;">Live Source Time</span>
      <strong class="top-gmt-clock" style="font-size: 1.25rem; font-family: 'Space Grotesk', sans-serif; color: var(--accent); font-weight: 700;">--:--:--</strong>
    </div>
    <div class="clock-card" style="text-align: center; padding: 12px 16px; background: var(--panel); border: 1px solid var(--line); border-radius: 10px;">
      <span class="eyebrow top-target-label" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); display: block; margin-bottom: 4px;">Live Target Time</span>
      <strong class="top-est-clock" style="font-size: 1.25rem; font-family: 'Space Grotesk', sans-serif; color: var(--accent); font-weight: 700;">--:--:--</strong>
      <em class="top-est-zone" style="font-size: 0.8rem; color: var(--muted); font-style: normal; margin-left: 4px;">ET</em>
    </div>
  </div>
</div>
</div>


  <!-- Feature Strip -->
  <div class="feature-strip">
    <div class="feature-item">
      <svg class="feature-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      <span>7-Hour Difference</span>
    </div>
    <div class="feature-item">
      <svg class="feature-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
      <span>Paris & New York</span>
    </div>
    <div class="feature-item">
      <svg class="feature-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
      <span>Transatlantic Overlap</span>
    </div>
    <div class="feature-item">
      <svg class="feature-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
      <span>European Summer Rules</span>
    </div>
  </div>

  <!-- Introduction Section -->
  <section class="cest-intro content-section">
    <p>
      The relationship between <strong>Central European Summer Time (CEST)</strong> and North America's <strong>Eastern Standard Time (EST)</strong> represents one of the world's most active corporate corridors. Connecting industrial and financial powerhouses across Western and Central Europe—such as Paris, Frankfurt, Milan, Amsterdam, and Madrid—with Wall Street, Washington D.C., Toronto, and Atlanta, this timezone pair drives daily international trade and digital communication.
    </p>
    <p>
      Operating at <strong>UTC+2</strong>, CEST sits exactly <strong>7 hours ahead of EST (UTC-5)</strong>. When office workers in Berlin or Rome are returning from lunch at 2:00 PM CEST, their counterparts in New York and Boston are just starting their day at 7:00 AM EST. Coordinating international product launches, financial reporting, aviation routes, and global software releases requires clear accounting of this 7-hour temporal gap.
    </p>
    <p>
      Our comprehensive conversion hub provides dynamic live clocks, step-by-step conversion formulas, an interactive matrix, a 24-hour reference chart, and actionable guidance for navigating transatlantic daylight saving shifts cleanly.
    </p>
  </section>

  <!-- Interactive Converter Section -->
  <section class="converter-section" id="interactive-converter">
    <div class="converter-header">
      <h2>Interactive CEST to EST Time Converter</h2>
      <p>Select any European CEST timestamp to calculate the exact EST equivalent instantly.</p>
    </div>
    <Converter intent="dynamic" t={t} context={context} />
  </section>

  <!-- Live Clocks Section -->
  <section class="clock-grid" aria-labelledby="live-clocks-heading">
    <h2 id="live-clocks-heading" class="sr-only">Live Clocks: CEST vs EST</h2>
    <div class="clock-card">
      <div class="clock-header">
        <span class="clock-flag">🇪🇺 / 🇫🇷 / 🇩🇪</span>
        <span>Current CEST (Paris / Berlin)</span>
      </div>
      <strong id="cestClock">3:00 PM</strong>
      <em id="cestZone">UTC+2 • Central European Summer Time</em>
    </div>
    <div class="clock-card accent-card">
      <div class="clock-header">
        <span class="clock-flag">🇺🇸 / 🇨🇦</span>
        <span>Current EST (New York / Toronto)</span>
      </div>
      <strong id="estClock">8:00 AM</strong>
      <em id="estZone">UTC-5 • Eastern Standard Time</em>
    </div>
  </section>

  <!-- Custom Regional SVG Illustration -->
  <div class="svg-container banner-svg">
    <svg viewBox="0 0 800 200" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="CEST to EST transatlantic map visual">
      <rect width="800" height="200" fill="#0c354a" rx="12"/>
      <!-- Continental Europe Node -->
      <g transform="translate(120, 60)">
        <circle cx="50" cy="40" r="34" fill="#1b536e" stroke="#36c7b5" stroke-width="3"/>
        <text x="50" y="45" fill="#f4fbff" font-family="Space Grotesk, sans-serif" font-weight="700" font-size="14" text-anchor="middle">CEST</text>
        <text x="50" y="95" fill="#8fd7ff" font-family="Manrope, sans-serif" font-size="12" text-anchor="middle">Paris / Berlin (UTC+2)</text>
      </g>
      <!-- Transatlantic Connection Path -->
      <path d="M 220 100 Q 400 30 580 100" fill="none" stroke="#36c7b5" stroke-width="3" stroke-dasharray="6 4"/>
      <g transform="translate(355, 40)">
        <rect x="0" y="0" width="90" height="28" fill="#12455d" rx="14" stroke="#2f6278" stroke-width="1"/>
        <text x="45" y="18" fill="#36c7b5" font-family="Space Grotesk, sans-serif" font-weight="700" font-size="12" text-anchor="middle">7 HOURS</text>
      </g>
      <!-- US East Coast Node -->
      <g transform="translate(530, 60)">
        <circle cx="50" cy="40" r="34" fill="#1b536e" stroke="#8fd7ff" stroke-width="3"/>
        <text x="50" y="45" fill="#f4fbff" font-family="Space Grotesk, sans-serif" font-weight="700" font-size="14" text-anchor="middle">EST</text>
        <text x="50" y="95" fill="#8fd7ff" font-family="Manrope, sans-serif" font-size="12" text-anchor="middle">New York (UTC-5)</text>
      </g>
    </svg>
  </div>

  <!-- Time Difference Breakdown -->
  <section class="method-section content-section">
    <h2>Understanding the 7-Hour Time Gap</h2>
    <p class="method-intro">
      Converting Central European Summer Time to Eastern Standard Time requires subtracting 7 hours from any local European clock.
    </p>

    <div class="method-grid">
      <div class="method-card">
        <div class="card-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/></svg>
        </div>
        <h3>Mathematical Formula</h3>
        <p class="formula-box">EST = CEST - 7 hours</p>
        <p>Subtracting 7 hours from CEST gives the exact Eastern Standard Time. For instance, 4:00 PM CEST minus 7 hours equals 9:00 AM EST.</p>
      </div>

      <div class="method-card">
        <div class="card-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><line x1="2" y1="12" x2="22" y2="12"/></svg>
        </div>
        <h3>UTC Offset Standards</h3>
        <p>CEST operates at <strong>UTC+2</strong> during European summer. EST operates at <strong>UTC-5</strong> during North American winter. The offset difference is (+2) - (-5) = 7 hours.</p>
      </div>

      <div class="method-card">
        <div class="card-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"/></svg>
        </div>
        <h3>Calendar Date Boundary</h3>
        <p>Because EST is 7 hours behind CEST, European early morning hours between <strong>12:00 AM and 6:59 AM CEST</strong> correspond to the <strong>previous evening</strong> in North American Eastern Standard Time.</p>
      </div>

      <div class="method-card">
        <div class="card-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        </div>
        <h3>Workday Alignment</h3>
        <p>The standard European afternoon (3:00 PM – 6:00 PM CEST) coincides perfectly with the morning start on the US East Coast (8:00 AM – 11:00 AM EST), creating a reliable 3-hour daily collaboration window.</p>
      </div>
    </div>
  </section>

  <!-- 24-Hour Conversion Table -->
  <section class="table-section content-section">
    <h2>24-Hour CEST to EST Conversion Chart</h2>
    <p>Use this reference table to map every hour of the day in Central Europe to Eastern Standard Time.</p>

    <!-- Timeline Graphic SVG -->
    <div class="svg-container timeline-svg">
      <svg viewBox="0 0 800 80" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
        <rect width="800" height="80" fill="#0c354a" rx="8"/>
        <line x1="50" y1="40" x2="750" y2="40" stroke="#2f6278" stroke-width="4"/>
        <circle cx="120" cy="40" r="10" fill="#36c7b5"/>
        <text x="120" y="65" fill="#f4fbff" font-size="11" text-anchor="middle">7:00 AM CEST</text>
        <text x="120" y="25" fill="#8fd7ff" font-size="11" text-anchor="middle">12:00 AM EST (-1d)</text>

        <circle cx="400" cy="40" r="10" fill="#36c7b5"/>
        <text x="400" y="65" fill="#f4fbff" font-size="11" text-anchor="middle">3:00 PM CEST</text>
        <text x="400" y="25" fill="#8fd7ff" font-size="11" text-anchor="middle">8:00 AM EST (Same day)</text>

        <circle cx="680" cy="40" r="10" fill="#36c7b5"/>
        <text x="680" y="65" fill="#f4fbff" font-size="11" text-anchor="middle">10:00 PM CEST</text>
        <text x="680" y="25" fill="#8fd7ff" font-size="11" text-anchor="middle">3:00 PM EST (Same day)</text>
      </svg>
    </div>

    <div class="table-wrap">
      <table class="conversion-table">
        <thead>
          <tr>
            <th>CEST Time (Paris / Berlin)</th>
            <th>EST Time (New York / Toronto)</th>
            <th>Calendar Day Status</th>
          </tr>
        </thead>
        <tbody>
          {conversionRows.map((row) => (
            <tr>
              <td><strong>{row.cest}</strong></td>
              <td><span class="converted-time">{row.est}</span></td>
              <td><span class={`day-badge ${row.dayNote === "Previous day" ? "prev-day" : "same-day"}`}>{row.dayNote}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- Popular Conversions Table -->
  <section class="examples-section content-section">
    <h2>Transatlantic Business & Travel Benchmarks</h2>
    <p>Frequently cited time pairs for business operations, financial markets, and travel scheduling.</p>
    <div class="table-wrap">
      <table class="conversion-table">
        <thead>
          <tr>
            <th>CEST Benchmark</th>
            <th>EST Equivalent</th>
            <th>Operational Context</th>
          </tr>
        </thead>
        <tbody>
          {popularConversions.map((item) => (
            <tr>
              <td><strong>{item.cest}</strong></td>
              <td><span class="converted-time">{item.est}</span></td>
              <td>{item.note}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- Daylight Saving Time Infographic SVG -->
  <section class="dst-section content-section">
    <h2>Daylight Saving Transitions: Europe vs North America</h2>
    <p>
      Central Europe uses CEST (UTC+2) from late March to late October. North America observes EST (UTC-5) during winter and EDT (UTC-4) during summer. Differences in changeover dates temporarily alter the time gap.
    </p>
    <div class="svg-container dst-svg">
      <svg viewBox="0 0 800 180" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
        <rect width="800" height="180" fill="#0c354a" rx="10"/>
        <rect x="40" y="30" width="340" height="120" fill="#12455d" rx="8" stroke="#2f6278" stroke-width="1"/>
        <text x="210" y="55" fill="#36c7b5" font-family="Space Grotesk, sans-serif" font-weight="700" font-size="14" text-anchor="middle">CEST vs EST (Winter US / Summer EU)</text>
        <text x="210" y="85" fill="#f4fbff" font-size="13" text-anchor="middle">Europe: CEST (UTC+2)</text>
        <text x="210" y="105" fill="#f4fbff" font-size="13" text-anchor="middle">US East Coast: EST (UTC-5)</text>
        <text x="210" y="135" fill="#8fd7ff" font-weight="700" font-size="13" text-anchor="middle">Difference: 7 Hours</text>

        <rect x="420" y="30" width="340" height="120" fill="#12455d" rx="8" stroke="#2f6278" stroke-width="1"/>
        <text x="590" y="55" fill="#36c7b5" font-family="Space Grotesk, sans-serif" font-weight="700" font-size="14" text-anchor="middle">CEST vs EDT (Summer EU & US)</text>
        <text x="590" y="85" fill="#f4fbff" font-size="13" text-anchor="middle">Europe: CEST (UTC+2)</text>
        <text x="590" y="105" fill="#f4fbff" font-size="13" text-anchor="middle">US East Coast: EDT (UTC-4)</text>
        <text x="590" y="135" fill="#8fd7ff" font-weight="700" font-size="13" text-anchor="middle">Difference: 6 Hours</text>
      </svg>
    </div>
  </section>

  <!-- Meeting Planner Section -->
  <section class="planner-section content-section">
    <h2>Optimal Transatlantic Meeting Windows</h2>
    <p>Schedule seamless teleconferences between European headquarters and North American offices without disrupting personal routines.</p>

    <!-- Multi-Region Clock SVG -->
    <div class="svg-container planner-svg">
      <svg viewBox="0 0 800 140" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
        <rect width="800" height="140" fill="#0c354a" rx="10"/>
        <g transform="translate(60, 20)">
          <rect width="200" height="100" fill="#1b536e" rx="8"/>
