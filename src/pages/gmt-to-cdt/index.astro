---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import Converter from "theme/components/Converter.astro";
import { getTranslation, siteUrl } from "theme/i18n/config";

const lang = "en";
const dir = "ltr";
const slug = "gmt-to-cdt";
const t = getTranslation(lang);

const pageTitle = "GMT vs CDT: Time Difference & Conversion";
const seoTitle = "GMT vs CDT: Time Difference & Conversion";
const pageDescription = "Compare GMT vs CDT: GMT is 5 hours ahead of Central Daylight Time (UTC-5, summer DST). Convert times accurately with our 24-hour chart and live clocks.";

const context = {
  from: "GMT",
  to: "CDT",
  fromZone: "UTC",
  toZone: "America/Chicago"
};

const canonical = `${siteUrl}/gmt-to-cdt/`;

// 24-hour conversion table data (GMT → CDT = GMT - 5)
function formatHour12(hour: number) {
  const normalized = ((hour % 24) + 24) % 24;
  const period = normalized < 12 ? "AM" : "PM";
  const displayHour = normalized % 12 || 12;
  return `${displayHour}:00 ${period}`;
}

const conversionRows = Array.from({ length: 24 }, (_, hour) => {
  const cdtHour = hour - 5;
  const cdtNormalized = ((cdtHour % 24) + 24) % 24;
  const prevDay = cdtHour < 0;
  const period = cdtNormalized < 12 ? "AM" : "PM";
  const displayHour = cdtNormalized % 12 || 12;
  return {
    gmt: formatHour12(hour),
    cdt: `${displayHour}:00 ${period}${prevDay ? " (-1 day)" : ""}`,
    dayNote: prevDay ? "Previous day" : "Same day"
  };
});

// GMT to CDT Conversion Examples (GMT - 5 hours)
const gmtToCdtExamples = [
  { gmt: "00:00 GMT (12:00 AM Midnight)", cdt: "19:00 CDT (7:00 PM)", dayNote: "Previous day (-1 day)", note: "Late evening in Chicago/Dallas, start of day in London" },
  { gmt: "06:00 GMT (6:00 AM)", cdt: "01:00 CDT (1:00 AM)", dayNote: "Same day", note: "After midnight in Central US, early morning in Greenwich" },
  { gmt: "12:00 GMT (12:00 PM Noon)", cdt: "07:00 CDT (7:00 AM)", dayNote: "Same day", note: "Start of Central workday, midday in London" },
  { gmt: "18:00 GMT (6:00 PM)", cdt: "13:00 CDT (1:00 PM)", dayNote: "Same day", note: "Early afternoon in Central US, evening in London" },
  { gmt: "24:00 GMT (12:00 AM Midnight)", cdt: "19:00 CDT (7:00 PM)", dayNote: "Same day", note: "Evening in Chicago/Dallas, end of day in Greenwich" }
];

// CDT to GMT Conversion Examples (CDT + 5 hours)
const cdtToGmtExamples = [
  { cdt: "00:00 CDT (12:00 AM Midnight)", gmt: "05:00 GMT (5:00 AM)", dayNote: "Same day", note: "Middle of the night in Central US, dawn in Greenwich" },
  { cdt: "06:00 CDT (6:00 AM)", gmt: "11:00 GMT (11:00 AM)", dayNote: "Same day", note: "Early morning in Central US, late morning in London" },
  { cdt: "12:00 CDT (12:00 PM Noon)", gmt: "17:00 GMT (5:00 PM)", dayNote: "Same day", note: "Lunchtime in Chicago/Dallas, close of business in London" },
  { cdt: "18:00 CDT (6:00 PM)", gmt: "23:00 GMT (11:00 PM)", dayNote: "Same day", note: "End of workday in Central US, late night in Greenwich" },
  { cdt: "20:00 CDT (8:00 PM)", gmt: "01:00 GMT (1:00 AM)", dayNote: "Next day (+1 day)", note: "Evening in Central US, early hours of next day in London" }
];

// FAQ data optimized for GMT vs CDT search intent
const faqs = [
  {
    q: "What is the time difference between GMT and CDT?",
    a: "Greenwich Mean Time (GMT) is 5 hours ahead of Central Daylight Time (CDT). GMT operates on UTC+0, while CDT operates on UTC−5. For example, when it is 12:00 PM (Noon) GMT, it is 7:00 AM CDT in Chicago, Dallas, and Houston."
  },
  {
    q: "Is GMT ahead of or behind CDT?",
    a: "GMT is 5 hours ahead of CDT. Conversely, CDT is 5 hours behind Greenwich Mean Time."
  },
  {
    q: "What is 12 PM GMT in CDT?",
    a: "12:00 PM (Noon) GMT corresponds to 7:00 AM CDT on the same calendar day."
  },
  {
    q: "What is 12 PM CDT in GMT?",
    a: "12:00 PM (Noon) CDT corresponds to 5:00 PM (17:00) GMT on the same calendar day."
  },
  {
    q: "Is CDT the same as CST?",
    a: "No. CDT stands for Central Daylight Time (UTC−5), which is used during daylight saving time from March to November. CST stands for Central Standard Time (UTC−6), which is used during winter. GMT is 5 hours ahead of CDT, but 6 hours ahead of CST."
  },
  {
    q: "Does the GMT to CDT difference change during daylight saving time?",
    a: "The standard difference between GMT (UTC+0) and CDT (UTC−5) is always 5 hours. However, Central North America only observes CDT from mid-March to early November. When the region shifts to CST (UTC−6) in winter, the difference becomes 6 hours. Additionally, if you are comparing local UK civil time (British Summer Time, BST, UTC+1) to CDT (UTC−5), the local civil time difference is 6 hours."
  },
  {
    q: "Does GMT observe daylight saving time?",
    a: "No. Greenwich Mean Time (GMT) is a fixed astronomical time standard running at UTC+0 all year round. In the United Kingdom, civil clocks shift to British Summer Time (BST, UTC+1) between March and October, but GMT itself strictly stays at UTC+0."
  },
  {
    q: "What is 8 PM GMT in CDT?",
    a: "8:00 PM (20:00) GMT converts to 3:00 PM (15:00) CDT on the same calendar day, as CDT runs 5 hours behind GMT."
  },
  {
    q: "What is 12 AM GMT in Central Time?",
    a: "12:00 AM (Midnight) GMT is equal to 7:00 PM CDT of the previous calendar day during daylight saving time, or 6:00 PM CST of the previous day during winter standard time."
  },
  {
    q: "How do I manually convert GMT to CDT?",
    a: "To manually convert GMT to CDT, subtract 5 hours from the GMT time. For example, 17:00 (5:00 PM) GMT minus 5 hours equals 12:00 PM (Noon) CDT. If the resulting hour is negative, add 24 hours and roll back to the previous calendar day."
  },
  {
    q: "What happens when converting GMT to CDT across midnight (date rollover)?",
    a: "Any GMT time between 00:00 and 04:59 falls on the previous calendar day in CDT (between 19:00 and 23:59 CDT). For instance, Tuesday at 02:00 GMT is Monday at 21:00 (9:00 PM) CDT."
  },
  {
    q: "When does Central Daylight Time begin and end?",
    a: "In the United States and Canada, CDT begins on the second Sunday of March (clocks advance from 2:00 AM CST to 3:00 AM CDT) and ends on the first Sunday of November (clocks fall back from 2:00 AM CDT to 1:00 AM CST)."
  },
  {
    q: "Does Chicago use CDT?",
    a: "Yes. Chicago observes Central Daylight Time (CDT, UTC−5) from the second Sunday in March to the first Sunday in November, and CST (UTC−6) during winter standard time."
  },
  {
    q: "Does Dallas use CDT?",
    a: "Yes. Dallas, Texas, observes Central Daylight Time (UTC−5) throughout the summer daylight saving period, transitioning back to CST in winter."
  },
  {
    q: "Does Texas follow Central Daylight Time?",
    a: "The majority of Texas (including Houston, Dallas-Fort Worth, San Antonio, and Austin) follows CDT (UTC−5) in summer and CST (UTC−6) in winter. West Texas cities such as El Paso observe Mountain Time (MDT/MST) instead."
  },
  {
    q: "Does Houston observe CDT?",
    a: "Yes. Houston, Texas, observes Central Daylight Time (UTC−5) from March to November each year."
  },
  {
    q: "Which Canadian provinces use Central Daylight Time?",
    a: "Manitoba observes CDT throughout the summer months. Northwestern Ontario also observes Central Time. Most of Saskatchewan maintains CST (UTC−6) year-round without daylight saving shifts, which matches CDT business hours in summer."
  },
  {
    q: "Does Mexico City use Central Daylight Time?",
    a: "No. In October 2022, Mexico abolished daylight saving time across the vast majority of the country. Mexico City observes Central Standard Time (CST, UTC−6) year-round and does not transition to CDT. Only specific northern border municipalities (such as Ciudad Juárez and Reynosa) continue to observe CDT in alignment with the US schedule."
  },
  {
    q: "Is CDT the same as EST?",
    a: "No. CDT (Central Daylight Time) and EST (Eastern Standard Time) both share the UTC−5 offset, but they are observed in different regions and seasons. When Central North America is on CDT during summer, Eastern North America is on EDT (UTC−4), keeping Eastern Time 1 hour ahead of Central Time."
  },
  {
    q: "What is the IANA identifier for Central Time?",
    a: "The canonical IANA time zone identifier for the Central Time zone is America/Chicago. Other regional identifiers include America/Winnipeg, America/Menominee, America/Indiana/Knox, and America/Matamoros."
  },
  {
    q: "Can I use this tool to schedule a meeting between London and Chicago?",
    a: "Yes. The optimal meeting crossover window between London (GMT/BST) and Chicago (CDT) is between 13:00 and 17:00 GMT, corresponding to 08:00 AM to 12:00 PM CDT, which provides 4 hours of standard business overlap."
  },
  {
    q: "How accurate is this GMT to CDT converter?",
    a: "Our converter uses the official IANA Time Zone Database loaded via the modern browser Intl API, guaranteeing exact calendar-aware and daylight-saving calculations for any date selected."
  }
];

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "GMT vs CDT, GMT and CDT difference, difference between GMT and CDT, GMT to CDT, CDT to GMT, how many hours ahead is GMT from CDT, GMT CDT time difference, GMT vs Central Daylight Time, Central Daylight Time, Greenwich Mean Time, CDT vs CST, UTC+0 to UTC-5",
  image: "/assets/gmt-to-cdt-og.svg",
  imageAlt: "GMT vs CDT – Greenwich Mean Time vs Central Daylight Time Difference and Converter",
  faqs,
  appDescription: "Free online GMT vs CDT converter with real-time clocks, DST-aware calculation, 24-hour conversion chart, and side-by-side time difference comparison.",
  applicationCategory: "UtilityApplication",
  operatingSystem: "Any",
  howToName: "How to Compare and Convert GMT and CDT",
  howToDescription: "Step-by-step guide to comparing and converting Greenwich Mean Time (GMT) and Central Daylight Time (CDT).",
  howToSteps: [
    { name: "Understand the 5-hour offset", text: "CDT (UTC-5) is 5 hours behind GMT (UTC+0) when daylight saving time is active in Central North America." },
    { name: "Verify seasonal DST status", text: "CDT is active from the second Sunday of March to the first Sunday of November. Outside this period, Central North America observes CST (UTC-6), making GMT 6 hours ahead." },
    { name: "Input your GMT or CDT time", text: "Select your desired time using our interactive date-time picker. The tool defaults to the current live time." },
    { name: "Check date rollover", text: "Notice whether your converted time falls into the same day, the previous day, or the next day when converting across midnight." }
  ],
};
