---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import Converter from "theme/components/Converter.astro";
import { getTranslation, siteUrl } from "theme/i18n/config";

const lang = "en";
const dir = "ltr";
const slug = "gmt-to-cdt";
const t = getTranslation(lang);

const pageTitle = "GMT to CDT Converter";
const seoTitle = "GMT to CDT Converter – Greenwich Mean Time to Central Daylight Time";
const pageDescription = "Convert GMT to CDT instantly with our free, DST-aware converter. See the current time difference between Greenwich Mean Time and Central Daylight Time, plus Chicago and Dallas clock guides.";

const context = {
  from: "GMT",
  to: "CDT",
  fromZone: "UTC",
  toZone: "America/Chicago"
};

const canonical = `${siteUrl}/gmt-to-cdt/`;

// 24-hour conversion table data (GMT → CDT = GMT - 5)
function formatHour12(hour: number) {
  const normalized = ((hour % 24) + 24) % 24;
  const period = normalized < 12 ? "AM" : "PM";
  const displayHour = normalized % 12 || 12;
  return `${displayHour}:00 ${period}`;
}

const conversionRows = Array.from({ length: 24 }, (_, hour) => {
  const cdtHour = hour - 5;
  const cdtNormalized = ((cdtHour % 24) + 24) % 24;
  const prevDay = cdtHour < 0;
  const period = cdtNormalized < 12 ? "AM" : "PM";
  const displayHour = cdtNormalized % 12 || 12;
  return {
    gmt: formatHour12(hour),
    cdt: `${displayHour}:00 ${period}${prevDay ? " (-1 day)" : ""}`,
    dayNote: prevDay ? "Previous day" : "Same day"
  };
});

// Popular conversions
const popularConversions = [
  { gmt: "12:00 AM (Midnight)", cdt: "7:00 PM CDT (-1 day)", note: "Late evening in Chicago, start of day in London" },
  { gmt: "2:00 AM", cdt: "9:00 PM CDT (-1 day)", note: "Bedtime in Dallas, middle of night in Greenwich" },
  { gmt: "4:00 AM", cdt: "11:00 PM CDT (-1 day)", note: "Late night in Winnipeg, early morning in Greenwich" },
  { gmt: "6:00 AM", cdt: "1:00 AM CDT", note: "After midnight in Houston, morning in London" },
  { gmt: "8:00 AM", cdt: "3:00 AM CDT", note: "Pre-dawn in Chicago, start of workday in Greenwich" },
  { gmt: "10:00 AM", cdt: "5:00 AM CDT", note: "Early morning in Winnipeg, mid-morning in London" },
  { gmt: "12:00 PM (Noon)", cdt: "7:00 AM CDT", note: "Start of workday in Chicago, midday in Greenwich" },
  { gmt: "2:00 PM", cdt: "9:00 AM CDT", note: "Morning meetings in Dallas, afternoon in London" },
  { gmt: "4:00 PM", cdt: "11:00 AM CDT", note: "Late morning in Houston, end of office hours in London" },
  { gmt: "6:00 PM", cdt: "1:00 PM CDT", note: "Lunchtime in Winnipeg, evening in Greenwich" },
  { gmt: "8:00 PM", cdt: "3:00 PM CDT", note: "Mid-afternoon in Chicago, night in London" },
  { gmt: "10:00 PM", cdt: "5:00 PM CDT", note: "Winding down in Dallas, late night in Greenwich" }
];

// FAQ data
const faqs = [
  { q: "What is CDT?", a: "CDT stands for Central Daylight Time. It is the daylight saving time zone observed in the Central Time zone of North America during the summer months. It is exactly 5 hours behind Coordinated Universal Time (UTC-5) and Greenwich Mean Time (GMT-5)." },
  { q: "What is the difference between CDT and CST?", a: "CDT is Central Daylight Time (UTC-5), used during summer daylight saving hours. CST is Central Standard Time (UTC-6), used during the winter standard months. Clocks shift by 1 hour between these seasons." },
  { q: "How many hours behind GMT is CDT?", a: "CDT is exactly 5 hours behind Greenwich Mean Time (GMT). For example, when it is 12:00 PM (Noon) GMT, it is 7:00 AM CDT in Chicago, Dallas, and Houston." },
  { q: "Does Chicago use CDT?", a: "Yes. Chicago observes CDT (UTC-5) from the second Sunday in March to the first Sunday in November, and CST (UTC-6) during the rest of the year." },
  { q: "Does Dallas use CDT?", a: "Yes. Dallas, Texas, observes Central Daylight Time (UTC-5) during the summer daylight saving period, transitioning back to CST in winter." },
  { q: "What is 8 PM GMT in CDT?", a: "8:00 PM GMT converts to 3:00 PM CDT on the same calendar day, as CDT runs 5 hours behind GMT." },
  { q: "Does Texas follow Central Daylight Time?", a: "The majority of Texas, including Houston, Dallas, San Antonio, and Austin, follows CDT (UTC-5) in summer and CST (UTC-6) in winter. West Texas cities like El Paso observe Mountain Time (MDT/MST) instead." },
  { q: "Does Winnipeg observe CDT?", a: "Yes. Winnipeg, Manitoba, in Canada, observes Central Daylight Time (UTC-5) during summer, matching the US Central Time schedule." },
  { q: "Does Mexico City use Central Daylight Time?", a: "Historically, Mexico City observed Central Time. However, in October 2022, Mexico abolished daylight saving time for most of the country. Mexico City now observes Central Standard Time (CST, UTC-6) year-round and does not transition to CDT. Only certain northern border municipalities in Mexico continue to observe CDT in alignment with the US schedule." },
  { q: "When does Central Daylight Time begin and end?", a: "In the United States and Canada, CDT begins on the second Sunday of March (clocks spring forward at 2:00 AM CST to 3:00 AM CDT) and ends on the first Sunday of November (clocks fall back at 2:00 AM CDT to 1:00 AM CST)." },
  { q: "Is CDT the same as EST?", a: "No. CDT is Central Daylight Time (UTC-5). EST is Eastern Standard Time (UTC-5). While they share the same offset (-5 hours relative to UTC), they are used in different regions and seasons. When CDT is active in summer, the Eastern Time zone is on EDT (UTC-4)." },
  { q: "How do I manually convert GMT to CDT?", a: "To convert GMT to CDT, subtract 5 hours from the GMT time. For example, if it is 5:00 PM GMT, subtract 5 hours to get 12:00 PM (Noon) CDT. If the date is in winter, subtract 6 hours for CST." },
  { q: "Is GMT always 5 hours ahead of CDT?", a: "GMT is 5 hours ahead of Central Time only when Central Daylight Time (CDT) is active in summer. In winter, when Central Standard Time (CST) is active, GMT is 6 hours ahead of Central Time." },
  { q: "What is the IANA identifier for Central Time?", a: "The primary canonical IANA time zone identifier for the Central Time zone is America/Chicago. Other identifiers include America/Winnipeg and America/Menominee." },
  { q: "How accurate is this GMT to CDT converter?", a: "Our converter uses the official IANA Time Zone Database loaded via the modern browser Intl API, ensuring absolute accuracy for any calendar date selected." },
  { q: "What is 12 AM GMT in Central Time?", a: "12:00 AM (Midnight) GMT is equal to 7:00 PM CDT of the previous day, or 6:00 PM CST of the previous day in winter." },
  { q: "Do database logs use GMT or CDT?", a: "Systems and database logs almost always store timestamps in UTC (GMT) to maintain chronological consistency. They are then dynamically formatted to local CDT for Central Time users." },
  { q: "Which Canadian provinces use Central Daylight Time?", a: "Manitoba, parts of Ontario (western region), and parts of Saskatchewan (which mostly observes CST year-round but some border areas match CDT) follow the Central Time schedule." },
  { q: "Does Houston observe CDT?", a: "Yes. Houston, Texas, observes Central Daylight Time (UTC-5) from March to November." },
  { q: "Why was daylight saving time introduced in the Central Zone?", a: "Daylight saving was introduced during World War I to conserve energy by extending evening daylight hours, reducing the need for artificial lighting." },
  { q: "Is GMT the same as UTC?", a: "For civil scheduling, GMT and UTC are identical. UTC is the high-precision atomic baseline, while GMT is the astronomical time standard based on Earth's rotation." },
  { q: "What happens to flights during the transition to CDT?", a: "Flight durations remain unchanged, but local departure and arrival times in Central Time airports shift by 1 hour on transition Sundays in March and November." },
  { q: "Can I use this tool to schedule a meeting between London and Chicago?", a: "Yes. The meeting planner and 24-hour table help you identify overlapping business hours, accounting for the 5-hour summer gap." },
  { q: "Does Alabama observe CDT?", a: "No. Alabama is in the Eastern Time Zone (EDT/EST) in its eastern border communities, but the majority of the state observes Central Time (CDT/CST)." },
  { q: "What is the standard offset of CDT?", a: "The offset of Central Daylight Time is UTC-5, meaning it is 5 hours behind Greenwich Mean Time." }
];

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "GMT to CDT, GMT to Central Daylight Time, Greenwich Mean Time to Central Daylight Time, GMT CDT Converter, Convert GMT to CDT, GMT to Central Time, Current CDT Time, GMT UTC to CDT, Central Daylight Time Converter, GMT to Chicago Time, GMT to Dallas Time, GMT to Houston Time, GMT to Winnipeg Time, GMT to Mexico City Time, Time Difference GMT and CDT",
  image: "/assets/gmt-to-cdt-og.svg",
  imageAlt: "GMT to CDT Converter – Convert Greenwich Mean Time to Central Daylight Time",
  faqs,
  appDescription: "Free online GMT to CDT converter with real-time clocks, DST-aware calculation, 24-hour conversion chart, and meeting planner for scheduling between Greenwich Mean Time and Central Daylight Time.",
  applicationCategory: "UtilityApplication",
  operatingSystem: "Any",
  howToName: "How to Convert GMT to CDT",
  howToDescription: "Step-by-step guide to converting Greenwich Mean Time to Central Daylight Time using our free online tool.",
  howToSteps: [
    { name: "Verify the season in Central North America", text: "CDT (UTC-5) is active from the second Sunday of March to the first Sunday of November. Outside this window, the zone observes CST (UTC-6)." },
    { name: "Input your GMT time", text: "Select your desired GMT time using our interactive date-time picker. The tool defaults to the current time." },
    { name: "Observe the calculated result", text: "Our calculator automatically detects the selected date and displays the equivalent time in Central Daylight Time (CDT) or Central Standard Time (CST)." },
    { name: "Copy or swap the result", text: "Read the converted Central Time and click the copy button to save the text to your clipboard." }
  ],
};
