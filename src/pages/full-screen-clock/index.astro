---
import BaseLayout from "theme/layouts/BaseLayout.astro";

const lang = "en";
const dir = "ltr";
const slug = "full-screen-clock";
const seoTitle = "Full Screen Clock – Live Time, GMT & Eastern Time";
const pageDescription = "View the current time in full screen with today's date, live GMT (UTC), and Eastern Time (EST/EDT). Features 12/24-hour mode, seconds toggle, and zero clutter.";

const pubDate = "2026-10-25T13:00:00+05:00";
const updatedDate = "2026-10-25T14:30:00+05:00";

const meta = {
  seoTitle,
  exactTitle: true,
  description: pageDescription,
  keywords: "full screen clock, online clock, big digital clock, current time full screen, gmt clock, eastern time clock, est clock, 24-hour clock",
  pubDate,
  updatedDate,
  author: "Time Intelligence Team",
  faqs: [
    {
      q: "How do I enter and exit full-screen clock mode?",
      a: "Click the 'Full screen' button directly below the clock to expand it across your entire display. To exit, press the Esc key on your keyboard or tap the 'Exit full screen' button in the upper-right corner."
    },
    {
      q: "Why does the clock show local time instead of EST by default?",
      a: "The primary clock reads your device's operating system clock to show your local time. For quick reference across time zones, live GMT (UTC) and Eastern Time (EST/EDT) are displayed immediately underneath."
    },
    {
      q: "Does Eastern Time show EST or EDT?",
      a: "Our clock dynamically detects whether Eastern Standard Time (UTC−5) or Eastern Daylight Time (UTC−4) is active on the current calendar date, displaying the exact civil abbreviation and accurate hour automatically."
    },
    {
      q: "Will the full-screen clock prevent my computer or phone from sleeping?",
      a: "Browsers enforce strict operating system power-saving policies. The clock will run continuously as long as your device remains awake, but standard system sleep, lock screens, and screensavers will take effect unless power settings are adjusted."
    },
    {
      q: "Can I use this full-screen clock offline?",
      a: "Once this page is loaded in your browser, the clock runs entirely with client-side JavaScript reading your system clock. However, an active internet connection is needed to initially open the page or refresh it."
    },
    {
      q: "What is the difference between GMT and UTC?",
      a: "GMT is a historical civil time zone based on solar observations at the Royal Observatory in Greenwich, while UTC is the scientific standard governed by high-precision atomic clocks. For general civil timekeeping, GMT and UTC share the exact same offset (UTC+0)."
    }
  ]
};
---

<BaseLayout
  lang={lang}
  dir={dir}
  title={seoTitle}
  description={pageDescription}
  slug={slug}
  meta={meta}
  enableFaqSchema={true}
  allowAds={false}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Full Screen Clock",
    "url": "https://gmttoestconverter.com/full-screen-clock/",
    "applicationCategory": "UtilitiesApplication",
    "operatingSystem": "All",
    "description": pageDescription,
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  })}></script>

  <!-- Hero Header -->
  <div class="hero-banner">
    <h1 class="hero-banner-title">Full Screen Clock – Live Time and Date</h1>
    <p style="color: #bdd2dc; font-size: clamp(1rem, 2.2vw, 1.25rem); max-width: 680px; margin: 12px auto 0;">
      A large, high-contrast digital clock displaying your local time, today's full date, live GMT (UTC), and Eastern Time.
    </p>
  </div>

  <!-- Interactive Clock Component Area (Strictly Above The Fold) -->
  <section id="clock-container-wrapper" style="max-width: 900px; margin: 0 auto; padding-top: 24px;">
    <div id="fs-clock-card" style="background: var(--panel); border: 2px solid var(--line); border-radius: 16px; padding: clamp(24px, 5vw, 48px); box-shadow: var(--shadow); text-align: center; position: relative;">
      
      <!-- Fallback message for JS-disabled browsers -->
      <noscript>
        <div style="background: rgba(239, 68, 68, 0.2); border: 1px solid #ef4444; border-radius: 8px; padding: 12px; margin-bottom: 20px; color: #fca5a5;">
          The live interactive digital clock requires JavaScript. Please enable JavaScript in your browser settings to see real-time updates.
        </div>
      </noscript>

      <!-- Main Live Time Display -->
      <div id="fs-main-time" aria-live="polite" style="font-family: 'Space Grotesk', monospace, sans-serif; font-size: clamp(3rem, 12vw, 7.5rem); font-weight: 800; letter-spacing: -0.02em; color: #ffffff; line-height: 1; font-variant-numeric: tabular-nums;">
        --:--:--
      </div>

      <!-- Main Live Date Display -->
      <div id="fs-main-date" style="font-size: clamp(1.1rem, 2.8vw, 1.8rem); font-weight: 600; color: var(--accent-2); margin-top: 14px;">
        Loading local date...
      </div>

      <!-- Secondary Dual Zones: GMT & Eastern Time -->
      <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 16px clamp(16px, 4vw, 40px); margin-top: 28px; padding-top: 20px; border-top: 1px solid var(--line);">
        <div style="background: var(--bg); border: 1px solid var(--line); border-radius: 10px; padding: 10px 20px; min-width: 180px;">
          <span style="display: block; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); font-weight: 700;">GMT (UTC)</span>
          <strong id="fs-gmt-time" style="font-size: 1.35rem; color: var(--text); font-variant-numeric: tabular-nums;">--:--:--</strong>
        </div>
        <div style="background: var(--bg); border: 1px solid var(--line); border-radius: 10px; padding: 10px 20px; min-width: 180px;">
          <span id="fs-et-label" style="display: block; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); font-weight: 700;">Eastern Time (ET)</span>
          <strong id="fs-et-time" style="font-size: 1.35rem; color: var(--accent); font-variant-numeric: tabular-nums;">--:--:--</strong>
        </div>
      </div>

      <!-- Controls Row -->
      <div style="display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 12px; margin-top: 28px;">
        <button
          type="button"
          id="toggle-hours-btn"
          aria-label="Toggle 12 or 24 hour display"
          style="padding: 10px 18px; border-radius: 8px; border: 1px solid var(--line); background: var(--bg); color: var(--text); font-weight: 700; cursor: pointer; transition: background 0.2s;"
        >
          24-Hour Mode
        </button>

        <button
          type="button"
          id="toggle-seconds-btn"
          aria-label="Toggle show or hide seconds"
          style="padding: 10px 18px; border-radius: 8px; border: 1px solid var(--line); background: var(--bg); color: var(--text); font-weight: 700; cursor: pointer; transition: background 0.2s;"
        >
          Hide Seconds
        </button>

        <button
          type="button"
          id="fullscreen-btn"
          aria-label="Enter full screen mode"
          style="padding: 10px 22px; border-radius: 8px; border: none; background: var(--accent); color: #fff; font-weight: 800; cursor: pointer; transition: background 0.2s;"
        >
          Full screen
        </button>
      </div>

      <!-- Exit Full Screen overlay button inside full screen mode -->
      <button
        type="button"
        id="exit-fullscreen-btn"
        aria-label="Exit full screen display"
        style="display: none; position: absolute; top: 20px; right: 20px; padding: 8px 16px; border-radius: 8px; border: 1px solid var(--line); background: rgba(18, 69, 93, 0.85); color: #ffffff; font-weight: 700; font-size: 0.9rem; cursor: pointer; backdrop-filter: blur(8px); z-index: 9999;"
      >
        ✕ Exit full screen
      </button>
    </div>
  </section>

  <!-- Visual Illustration Below The Fold -->
  <div class="infographic-wrapper" style="margin-top: 36px;">
    <figure style="margin: 0; text-align: center;">
      <img
        src="/assets/full-screen-digital-clock.webp"
        alt="Full screen digital clock interface showing hours, minutes, seconds, date, and time controls"
        class="infographic-image"
        width="800"
        height="450"
        loading="lazy"
      />
      <figcaption class="infographic-caption">Clean, high-contrast full-screen digital clock layout designed for readability at a distance.</figcaption>
    </figure>
  </div>

  <!-- Content Below the Tool (Server-Rendered Semantic Content) -->
  <div style="max-width: 780px; margin: 0 auto; padding: 36px 0 0;">

    <!-- H2: How to use the full-screen digital clock -->
    <section>
      <h2 style="font-size: clamp(1.5rem, 3.5vw, 2rem); border-bottom: 1px solid var(--line); padding-bottom: 12px; margin-bottom: 16px;">How to use the full-screen digital clock</h2>
      <p style="color: var(--muted); line-height: 1.7; max-width: 72ch;">
        This full-screen digital clock provides a distraction-free, large-format time display directly inside your web browser. Operating entirely on client-side technology, it reads your local operating system time and continuously updates every single second with zero server requests.
      </p>
      <p style="color: var(--muted); line-height: 1.7; max-width: 72ch; margin-top: 12px;">
        To tailor the display to your environment, use the interactive controls positioned directly below the clock face:
      </p>
      <ul style="color: var(--muted); line-height: 1.7; padding-left: 20px; margin: 14px 0;">
        <li><strong>Toggle 12-Hour / 24-Hour Display:</strong> Click <em>24-Hour Mode</em> to switch between standard civilian AM/PM format (e.g., <code>02:30:15 PM</code>) and 24-hour military notation (e.g., <code>14:30:15</code>).</li>
        <li><strong>Show or Hide Seconds:</strong> Click <em>Hide Seconds</em> if you prefer a calmer, static minute-by-minute clock suitable for ambient background desks or meditation sessions.</li>
        <li><strong>Full Screen Mode:</strong> Click the <em>Full screen</em> button to expand the clock panel across your entire monitor or television display. To exit, simply press the <kbd style="background: var(--bg); border: 1px solid var(--line); padding: 2px 6px; border-radius: 4px; font-family: monospace;">Esc</kbd> key or tap the <em>✕ Exit full screen</em> button in the top-right corner.</li>
      </ul>
    </section>

    <!-- H2: 12-hour vs. 24-hour time formats -->
    <section style="margin-top: 36px;">
      <h2 style="font-size: clamp(1.5rem, 3.5vw, 2rem); border-bottom: 1px solid var(--line); padding-bottom: 12px; margin-bottom: 16px;">12-hour vs. 24-hour time formats</h2>
      <p style="color: var(--muted); line-height: 1.7; max-width: 72ch;">
        Choosing between a 12-hour clock and a 24-hour clock depends largely on geographic convention, professional workflow, and personal preference:
      </p>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; margin: 20px 0;">
        <div style="background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 20px;">
          <h3 style="font-size: 1.15rem; color: var(--accent-2); margin-top: 0; margin-bottom: 8px;">12-Hour Format (Civil Time)</h3>
          <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0;">
            Widely used in the United States, Canada, the United Kingdom, Australia, and the Philippines. Time is divided into two 12-hour blocks: <em>ante meridiem</em> (AM, before noon) and <em>post meridiem</em> (PM, after noon). Midnight is represented as 12:00 AM, and noon as 12:00 PM.
          </p>
        </div>
        <div style="background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 20px;">
          <h3 style="font-size: 1.15rem; color: var(--accent); margin-top: 0; margin-bottom: 8px;">24-Hour Format (ISO 8601 & Military)</h3>
          <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0;">
            The international standard (ISO 8601) common across Europe, Latin America, aviation, military, healthcare, and software operations. Hours run consecutively from 00:00 to 23:59, eliminating any risk of confusing morning and evening events.
          </p>
        </div>
      </div>
      <p style="color: var(--muted); line-height: 1.7; max-width: 72ch;">
        Our full-screen clock dynamically synchronizes your format choice across both the main local clock and the dual GMT/Eastern Time indicators below it.
      </p>
    </section>

    <!-- Diagram / Infographic 2: GMT vs Eastern Time -->
    <div class="infographic-wrapper" style="margin-top: 36px;">
      <figure style="margin: 0; text-align: center;">
        <img
          src="/assets/gmt-vs-eastern-time-clock.webp"
          alt="Comparison chart between GMT UTC baseline and Eastern Time with EST and EDT seasonal shifts"
          class="infographic-image"
          width="800"
          height="450"
          loading="lazy"
        />
        <figcaption class="infographic-caption">How Greenwich Mean Time (UTC±0) aligns with North American Eastern Standard Time (UTC−5) and Eastern Daylight Time (UTC−4).</figcaption>
      </figure>
    </div>

    <!-- H2: Understanding GMT and UTC -->
    <section style="margin-top: 36px;">
      <h2 style="font-size: clamp(1.5rem, 3.5vw, 2rem); border-bottom: 1px solid var(--line); padding-bottom: 12px; margin-bottom: 16px;">Understanding GMT and UTC</h2>
      <p style="color: var(--muted); line-height: 1.7; max-width: 72ch;">
        The terms <strong>GMT (Greenwich Mean Time)</strong> and <strong>UTC (Coordinated Universal Time)</strong> are frequently used interchangeably in casual communication, but they stem from fundamentally distinct timing standards:
      </p>
      <ul style="color: var(--muted); line-height: 1.7; padding-left: 20px; margin: 14px 0;">
        <li><strong>GMT</strong> is an astronomical time standard historically measured by the Sun's transit across the Prime Meridian at the Royal Observatory in Greenwich, London. Today, it operates as a recognized civil time zone utilized in the United Kingdom, Ireland, and Western Africa during winter months.</li>
        <li><strong>UTC</strong> is the high-precision atomic time standard maintained by the Bureau International des Poids et Mesures (BIPM). Regulated by hundreds of ultra-stable cesium atomic clocks, UTC is the planetary anchor against which all global time zones and computer networks synchronize.</li>
      </ul>
      <p style="color: var(--muted); line-height: 1.7; max-width: 72ch;">
        Because UTC and GMT maintain the exact same zero-hour offset (UTC+0) without any seasonal daylight saving adjustments, the GMT indicator on this clock acts as an unshifting global anchor for international time conversion.
      </p>
    </section>

    <!-- H2: Eastern Time: EST vs. EDT and seasonal daylight saving -->
    <section style="margin-top: 36px;">
      <h2 style="font-size: clamp(1.5rem, 3.5vw, 2rem); border-bottom: 1px solid var(--line); padding-bottom: 12px; margin-bottom: 16px;">Eastern Time: EST vs. EDT and seasonal daylight saving</h2>
      <p style="color: var(--muted); line-height: 1.7; max-width: 72ch;">
        Eastern Time (ET) is the prevailing civil time standard across the eastern regions of the United States and Canada, encompassing major global financial and commercial centers such as New York, Toronto, Miami, and Washington, D.C.
      </p>
      <p style="color: var(--muted); line-height: 1.7; max-width: 72ch; margin-top: 12px;">
        Unlike GMT, Eastern Time observes seasonal daylight saving time (DST), shifting its offset twice each calendar year:
      </p>
      <div style="background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 20px; margin: 16px 0;">
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.95rem;">
          <thead>
            <tr style="border-bottom: 1px solid var(--line);">
              <th style="padding: 10px 8px; color: var(--accent-2);">Time Zone</th>
              <th style="padding: 10px 8px; color: var(--accent-2);">Abbreviation</th>
              <th style="padding: 10px 8px; color: var(--accent-2);">UTC / GMT Offset</th>
              <th style="padding: 10px 8px; color: var(--accent-2);">Active Season</th>
            </tr>
          </thead>
          <tbody style="color: var(--muted);">
            <tr style="border-bottom: 1px solid var(--line);">
              <td style="padding: 10px 8px; font-weight: 700; color: var(--text);">Eastern Standard Time</td>
              <td style="padding: 10px 8px; font-family: monospace;">EST</td>
              <td style="padding: 10px 8px;">UTC−5 (GMT−5)</td>
              <td style="padding: 10px 8px;">Early November to Early March</td>
            </tr>
            <tr>
              <td style="padding: 10px 8px; font-weight: 700; color: var(--text);">Eastern Daylight Time</td>
              <td style="padding: 10px 8px; font-family: monospace;">EDT</td>
              <td style="padding: 10px 8px;">UTC−4 (GMT−4)</td>
              <td style="padding: 10px 8px;">Early March to Early November</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p style="color: var(--muted); line-height: 1.7; max-width: 72ch;">
        Our live Eastern Time badge automatically resolves whether EST or EDT is currently active on your device's date, avoiding the widespread pitfall of labeling summer New York time as EST. To learn more about upcoming seasonal shifts, explore our guide on <a href="/when-do-clocks-go-back-2026/" style="color: var(--accent); font-weight: 700; text-decoration: underline; text-underline-offset: 3px;">When Do Clocks Go Back 2026</a>.
      </p>
    </section>

    <!-- H2: Practical use cases for a full-screen clock -->
    <section style="margin-top: 36px;">
      <h2 style="font-size: clamp(1.5rem, 3.5vw, 2rem); border-bottom: 1px solid var(--line); padding-bottom: 12px; margin-bottom: 16px;">Practical use cases for a full-screen clock</h2>
      <p style="color: var(--muted); line-height: 1.7; max-width: 72ch;">
        A high-visibility, full-screen digital clock serves a wide variety of domestic, professional, and educational environments:
      </p>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; margin: 20px 0;">
        <div style="background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 16px;">
          <h3 style="font-size: 1.05rem; color: #ffffff; margin-top: 0;">Classrooms & Exams</h3>
          <p style="color: var(--muted); font-size: 0.9rem; line-height: 1.6; margin: 6px 0 0;">
            Project the clock onto a smartboard or projector screen during lectures, timed assignments, or standardized testing so students always have clear visibility without looking at smartphones.
          </p>
        </div>
        <div style="background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 16px;">
          <h3 style="font-size: 1.05rem; color: #ffffff; margin-top: 0;">Business Presentations</h3>
          <p style="color: var(--muted); font-size: 0.9rem; line-height: 1.6; margin: 6px 0 0;">
            Keep conference speakers, webinar panellists, and workshop leaders strictly on schedule by displaying large-format elapsed wall-clock time on a confidence monitor.
          </p>
        </div>
        <div style="background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 16px;">
          <h3 style="font-size: 1.05rem; color: #ffffff; margin-top: 0;">Workplace & Remote Teams</h3>
          <p style="color: var(--muted); font-size: 0.9rem; line-height: 1.6; margin: 6px 0 0;">
            Distributed engineering and customer support teams can keep track of London handoffs and New York stock market opening bells using the integrated GMT and Eastern Time counters.
          </p>
        </div>
        <div style="background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 16px;">
          <h3 style="font-size: 1.05rem; color: #ffffff; margin-top: 0;">Study & Ambient Desk Use</h3>
          <p style="color: var(--muted); font-size: 0.9rem; line-height: 1.6; margin: 6px 0 0;">
            Transform an idle secondary monitor or wall-mounted tablet into an aesthetic, low-power desktop clock during deep work sessions. Pair with our <a href="/time-duration-calculator/" style="color: var(--accent); font-weight: 700; text-decoration: underline; text-underline-offset: 3px;">Time Duration Calculator</a> to measure study blocks.
          </p>
        </div>
      </div>
    </section>

    <!-- H2: Browser full-screen behavior and mobile tips -->
    <section style="margin-top: 36px;">
      <h2 style="font-size: clamp(1.5rem, 3.5vw, 2rem); border-bottom: 1px solid var(--line); padding-bottom: 12px; margin-bottom: 16px;">Browser full-screen behavior and mobile tips</h2>
      <p style="color: var(--muted); line-height: 1.7; max-width: 72ch;">
        Our full-screen feature harnesses the modern W3C Fullscreen API. When you tap <em>Full screen</em>, the browser grants fullscreen rights specifically to the clock container, hiding URL toolbars, browser tabs, and desktop taskbars.
      </p>
      <p style="color: var(--muted); line-height: 1.7; max-width: 72ch; margin-top: 12px;">
        Keep the following technical considerations in mind across different operating systems:
      </p>
      <ul style="color: var(--muted); line-height: 1.7; padding-left: 20px; margin: 14px 0;">
        <li><strong>F11 vs. Element Fullscreen:</strong> On Windows and Linux desktop browsers, pressing <kbd style="background: var(--bg); border: 1px solid var(--line); padding: 2px 6px; border-radius: 4px; font-family: monospace;">F11</kbd> maximizes the entire browser window, whereas clicking our button focuses solely on the clock element against an immersive deep slate background.</li>
        <li><strong>Mobile Safari (iOS) Restrictions:</strong> Apple's iOS Safari restricts programmatic element-level fullscreen on iPhones. On iPhone devices, the clock gracefully expands to maximize viewport space. For an immersive experience on iOS, you can tap the Safari share icon and select <em>Add to Home Screen</em>.</li>
        <li><strong>Device Sleep and Screen Timeouts:</strong> Web browsers cannot permanently override your operating system's hardware power-saving settings. If you plan to run the clock continuously on an office wall or presentation monitor, adjust your computer or tablet display settings to prevent sleep.</li>
      </ul>
    </section>

    <!-- H2: High contrast, readability, and accessibility -->
    <section style="margin-top: 36px;">
      <h2 style="font-size: clamp(1.5rem, 3.5vw, 2rem); border-bottom: 1px solid var(--line); padding-bottom: 12px; margin-bottom: 16px;">High contrast, readability, and accessibility</h2>
      <p style="color: var(--muted); line-height: 1.7; max-width: 72ch;">
        The display has been carefully engineered for maximum legibility across varied lighting conditions and viewing distances:
      </p>
      <ul style="color: var(--muted); line-height: 1.7; padding-left: 20px; margin: 14px 0;">
        <li><strong>Tabular Numeric Figures:</strong> Numbers are rendered using fixed-width tabular figures (<code>font-variant-numeric: tabular-nums</code>). This prevents jitter or horizontal layout shifts as digits change from narrow ones (such as <code>1</code>) to wider digits (such as <code>8</code> or <code>0</code>).</li>
        <li><strong>WCAG AAA Contrast:</strong> Bright white text (<code>#ffffff</code>) against deep marine panels (<code>#0c354a</code> and <code>#06151f</code>) exceeds WCAG AAA contrast ratios (greater than 12:1), preventing eye fatigue in low-light environments while remaining legible under harsh fluorescent classroom lighting.</li>
        <li><strong>ARIA Live Regions:</strong> Time containers feature appropriate ARIA attributes for screen reader accessibility, while buttons maintain descriptive labels and keyboard focus states.</li>
      </ul>
    </section>

    <!-- Related Navigation & Calculators -->
    <section style="margin-top: 36px;">
      <div class="info-callout" style="background: var(--panel); border-left: 4px solid var(--accent); padding: 20px; border-radius: 8px;">
        <h3 style="font-size: 1.15rem; color: #ffffff; margin-top: 0; margin-bottom: 8px;">Explore Related Time & Date Tools</h3>
        <p style="color: var(--muted); line-height: 1.6; margin: 0;">
          Calculate precise elapsed intervals between two timestamps with our <a href="/time-duration-calculator/" style="color: var(--accent); font-weight: 700; text-decoration: underline; text-underline-offset: 3px;">Time Duration Calculator</a>, count exact calendar spans using the <a href="/days-between-dates-calculator/" style="color: var(--accent); font-weight: 700; text-decoration: underline; text-underline-offset: 3px;">Days Between Dates Calculator</a>, or convert across global offsets instantly on the <a href="/" style="color: var(--accent); font-weight: 700; text-decoration: underline; text-underline-offset: 3px;">GMT to EST Converter</a> homepage.
        </p>
      </div>
    </section>
  </div>

  <!-- FAQ Section -->
  <section style="max-width: 780px; margin: 0 auto; padding: 48px 0 24px;">
    <h2 style="font-size: clamp(1.5rem, 3.5vw, 2rem); text-align: center; margin-bottom: 20px;">Frequently Asked Questions</h2>
    <div class="faq">
      {meta.faqs.map(faq => (
        <details style="padding: 16px; background: var(--panel); border: 1px solid var(--line); border-radius: 8px; margin-bottom: 12px;">
          <summary style="font-weight: 800; cursor: pointer; color: var(--text);">{faq.q}</summary>
          <p style="margin: 12px 0 0; color: var(--muted); line-height: 1.65;">{faq.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- Interactive JavaScript Engine -->
  <script is:inline>
    (function () {
      var timeEl = document.getElementById('fs-main-time');
      var dateEl = document.getElementById('fs-main-date');
      var gmtEl = document.getElementById('fs-gmt-time');
      var etEl = document.getElementById('fs-et-time');
      var etLabelEl = document.getElementById('fs-et-label');

      var toggleHoursBtn = document.getElementById('toggle-hours-btn');
      var toggleSecondsBtn = document.getElementById('toggle-seconds-btn');
      var fullscreenBtn = document.getElementById('fullscreen-btn');
      var exitFullscreenBtn = document.getElementById('exit-fullscreen-btn');
      var clockCard = document.getElementById('fs-clock-card');

      var is24Hour = false;
      var showSeconds = true;

      function updateClock() {
        var now = new Date();

        // 1. Local Time formatting
        var hours = now.getHours();
        var minutes = now.getMinutes();
        var seconds = now.getSeconds();
        var ampm = '';

        if (!is24Hour) {
          ampm = hours >= 12 ? ' PM' : ' AM';
          hours = hours % 12;
          if (hours === 0) hours = 12;
        }

        var hStr = hours < 10 && is24Hour ? '0' + hours : '' + hours;
        var mStr = minutes < 10 ? '0' + minutes : '' + minutes;
        var sStr = seconds < 10 ? '0' + seconds : '' + seconds;

        var timeString = hStr + ':' + mStr;
        if (showSeconds) {
          timeString += ':' + sStr;
        }
        if (!is24Hour) {
          timeString += ampm;
        }

        if (timeEl) {
          timeEl.textContent = timeString;
        }

        // 2. Full Date formatting (e.g. "Sunday, October 25, 2026")
        if (dateEl) {
          var dateOptions = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
          dateEl.textContent = now.toLocaleDateString('en-US', dateOptions);
        }

        // 3. GMT (UTC) Time
        var gmtHours = now.getUTCHours();
        var gmtMinutes = now.getUTCMinutes();
        var gmtSeconds = now.getUTCSeconds();
        var gmtAmpm = '';

        if (!is24Hour) {
          gmtAmpm = gmtHours >= 12 ? ' PM' : ' AM';
          gmtHours = gmtHours % 12;
          if (gmtHours === 0) gmtHours = 12;
        }

        var ghStr = gmtHours < 10 && is24Hour ? '0' + gmtHours : '' + gmtHours;
        var gmStr = gmtMinutes < 10 ? '0' + gmtMinutes : '' + gmtMinutes;
        var gsStr = gmtSeconds < 10 ? '0' + gmtSeconds : '' + gmtSeconds;

        var gmtString = ghStr + ':' + gmStr;
        if (showSeconds) gmtString += ':' + gsStr;
        if (!is24Hour) gmtString += gmtAmpm;
        if (gmtEl) {
          gmtEl.textContent = gmtString;
        }

        // 4. Eastern Time (US/Eastern) using Intl to accurately capture EDT vs EST
        try {
          var etParts = new Intl.DateTimeFormat('en-US', {
            timeZone: 'America/New_York',
            hour: 'numeric',
            minute: '2-digit',
            second: '2-digit',
            hour12: !is24Hour,
            timeZoneName: 'short'
          }).formatToParts(now);

          var eth = '', etm = '', ets = '', etDayPeriod = '', etTz = 'ET';
          for (var i = 0; i < etParts.length; i++) {
            if (etParts[i].type === 'hour') eth = etParts[i].value;
            if (etParts[i].type === 'minute') etm = etParts[i].value;
            if (etParts[i].type === 'second') ets = etParts[i].value;
            if (etParts[i].type === 'dayPeriod') etDayPeriod = ' ' + etParts[i].value;
            if (etParts[i].type === 'timeZoneName') etTz = etParts[i].value;
          }

          var etString = eth + ':' + etm;
          if (showSeconds) etString += ':' + ets;
          if (!is24Hour) etString += etDayPeriod;
          if (etEl) {
            etEl.textContent = etString;
          }
          if (etLabelEl) {
            etLabelEl.textContent = 'Eastern Time (' + etTz + ')';
          }
        } catch (e) {
          if (etEl) etEl.textContent = '--:--';
        }
      }

      // Toggle 12/24 hour
      if (toggleHoursBtn) {
        toggleHoursBtn.addEventListener('click', function () {
          is24Hour = !is24Hour;
          toggleHoursBtn.textContent = is24Hour ? '12-Hour Mode' : '24-Hour Mode';
          updateClock();
        });
      }

      // Toggle seconds
      if (toggleSecondsBtn) {
        toggleSecondsBtn.addEventListener('click', function () {
          showSeconds = !showSeconds;
          toggleSecondsBtn.textContent = showSeconds ? 'Hide Seconds' : 'Show Seconds';
          updateClock();
        });
      }

      // Fullscreen handling on clock card
      function enterFullscreen() {
        if (!clockCard) return;
        if (clockCard.requestFullscreen) {
          clockCard.requestFullscreen();
        } else if (clockCard.webkitRequestFullscreen) {
          clockCard.webkitRequestFullscreen();
        } else if (clockCard.msRequestFullscreen) {
          clockCard.msRequestFullscreen();
        }
      }

      function exitFullscreen() {
        if (document.exitFullscreen) {
          document.exitFullscreen();
        } else if (document.webkitExitFullscreen) {
          document.webkitExitFullscreen();
        } else if (document.msExitFullscreen) {
          document.msExitFullscreen();
        }
      }

      if (fullscreenBtn) {
        fullscreenBtn.addEventListener('click', enterFullscreen);
      }
      if (exitFullscreenBtn) {
        exitFullscreenBtn.addEventListener('click', exitFullscreen);
      }

      function handleFullscreenChange() {
        var isFs = document.fullscreenElement || document.webkitFullscreenElement || document.msFullscreenElement;
        if (clockCard && exitFullscreenBtn) {
          if (isFs) {
            clockCard.classList.add('is-fullscreen');
            exitFullscreenBtn.style.display = 'block';
          } else {
            clockCard.classList.remove('is-fullscreen');
            exitFullscreenBtn.style.display = 'none';
          }
        }
      }

      document.addEventListener('fullscreenchange', handleFullscreenChange);
      document.addEventListener('webkitfullscreenchange', handleFullscreenChange);
      document.addEventListener('msfullscreenchange', handleFullscreenChange);

      updateClock();
      setInterval(updateClock, 1000);
    })();
  </script>

  <style>
    /* Fullscreen styling for standalone clock display */
    #fs-clock-card.is-fullscreen {
      width: 100vw !important;
      height: 100vh !important;
      display: flex !important;
      flex-direction: column !important;
      justify-content: center !important;
      align-items: center !important;
      border-radius: 0 !important;
      border: none !important;
      background: #06151f !important;
      padding: 2rem !important;
      box-sizing: border-box !important;
    }

    #fs-clock-card.is-fullscreen #fs-main-time {
      font-size: clamp(4.5rem, 18vw, 14rem) !important;
    }

    #fs-clock-card.is-fullscreen #fs-main-date {
      font-size: clamp(1.4rem, 4vw, 2.5rem) !important;
    }

    #toggle-hours-btn:hover,
    #toggle-seconds-btn:hover {
      background: var(--panel) !important;
      border-color: var(--accent) !important;
    }

    #fullscreen-btn:hover {
      filter: brightness(1.1);
    }
  </style>
</BaseLayout>
