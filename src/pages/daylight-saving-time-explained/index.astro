          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>US East Coast</strong>:</td>
            <td>EST (Eastern Standard Time, UTC-5)</td>
            <td>EDT (Eastern Daylight Time, UTC-4)</td>
          </tr>
          <tr>
            <td><strong>United Kingdom</strong>:</td>
            <td>GMT (Greenwich Mean Time, UTC+0)</td>
            <td>BST (British Summer Time, UTC+1)</td>
          </tr>
          <tr>
            <td><strong>Central Europe</strong>:</td>
            <td>CET (Central European Time, UTC+1)</td>
            <td>CEST (Central European Summer Time, UTC+2)</td>
          </tr>
          <tr>
            <td><strong>US West Coast</strong>:</td>
            <td>PST (Pacific Standard Time, UTC-8)</td>
            <td>PDT (Pacific Daylight Time, UTC-7)</td>
          </tr>
        </tbody>
      </table>
    </div>

