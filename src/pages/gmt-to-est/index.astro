  { gmt: "8:00 PM GMT", est: "3:00 PM EST", edt: "4:00 PM EDT", desc: "Wall Street enters its final hour of trading; European retail software monitors evening user traffic." },
  { gmt: "9:00 PM GMT", est: "4:00 PM EST", edt: "5:00 PM EDT", desc: "US stock markets close at 4:00 PM EST; corporate desks conclude standard business hours." },
  { gmt: "10:00 PM GMT", est: "5:00 PM EST", edt: "6:00 PM EDT", desc: "Post-market trading wraps up in New York; European cloud systems run automated nightly telemetry." },
