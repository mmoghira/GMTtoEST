---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import { siteUrl } from "theme/i18n/config";

const lang = "en";
const dir = "ltr";
const slug = "glossary";

const pageTitle = "Time Zone Glossary & Entity Dictionary";
const seoTitle = "Time Zone Glossary – Complete Dictionary of GMT, UTC, EST, DST & Terminology";
const pageDescription = "Comprehensive dictionary of time zone terminology. Clear definitions for GMT, UTC, EST, EDT, CST, PDT, MST, IANA database, Daylight Saving Time, ISO 8601, and Unix timestamps.";

const canonical = `${siteUrl}/glossary/`;

const terms = [
  { term: "Coordinated Universal Time (UTC)", def: "The primary time standard by which the world regulates clocks and time. UTC is maintained by atomic clocks and does not observe Daylight Saving Time." },
  { term: "Greenwich Mean Time (GMT)", def: "Solar time at the Royal Observatory in Greenwich, London. GMT operates at UTC+0 and serves as the historical baseline for global timekeeping." },
  { term: "Eastern Standard Time (EST)", def: "Standard time zone observing UTC-5 across eastern North America during winter months (New York, Toronto, Miami)." },
  { term: "Eastern Daylight Time (EDT)", def: "Daylight saving time zone observing UTC-4 across eastern North America from mid-March to early November." },
  { term: "Central Standard Time (CST)", def: "Standard time zone observing UTC-6 across central North America (Chicago, Dallas, Winnipeg)." },
  { term: "Central Daylight Time (CDT)", def: "Daylight saving time zone observing UTC-5 across central North America in summer." },
  { term: "Pacific Standard Time (PST)", def: "Standard time zone observing UTC-8 across western North America (Los Angeles, Seattle, Vancouver)." },
  { term: "Pacific Daylight Time (PDT)", def: "Daylight saving time zone observing UTC-7 across western North America in summer." },
  { term: "Mountain Standard Time (MST)", def: "Standard time zone observing UTC-7 across the Rocky Mountain region (Denver, Phoenix, Salt Lake City)." },
  { term: "Mountain Daylight Time (MDT)", def: "Daylight saving time zone observing UTC-6 across mountain states in summer." },
  { term: "IANA Time Zone Database", def: "The official international software database (Olson DB) cataloging historical and present time zone rules, daylight saving shifts, and boundary polygons worldwide." },
  { term: "Daylight Saving Time (DST)", def: "The practice of advancing clocks forward by 1 hour during warmer months to extend evening daylight." },
  { term: "Prime Meridian", def: "The 0° longitudinal line passing through Greenwich, England, dividing Earth into Eastern and Western Hemispheres." },
  { term: "ISO 8601", def: "The international standard format for representing dates and times (e.g., 2026-08-06T12:00:00-05:00)." },
  { term: "Unix Timestamp", def: "The number of non-leap seconds elapsed since January 1, 1970 00:00:00 UTC, used universally in computer science." }
];

const faqs = [
  {
    q: "What is the difference between UTC and GMT?",
    a: "UTC is a precise atomic time standard, while GMT is a solar time zone. In practice, both share the UTC+0 offset, but UTC is used in technical computing while GMT is used in geography and law."
  },
  {
    q: "Why is the IANA database important?",
    a: "Operating systems, web servers, and modern browsers rely on the IANA Time Zone Database (America/New_York, America/Chicago) to ensure automatic adjustments for daylight saving transitions."
  }
];

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "Time zone glossary, GMT definition, UTC definition, EST definition, IANA time zone database, Daylight Saving Time terms, time zone dictionary",
  image: "/assets/gmt-to-est-timeflow-hero.png",
  imageAlt: "Time Zone Glossary Dictionary",
  faqs
};
---

<BaseLayout
  lang={lang}
  dir={dir}
  title={seoTitle}
  description={pageDescription}
  slug={slug}
  meta={meta}
  mode="gmt-est"
  enableFaqSchema={true}
  allowAds={true}
  breadcrumbHomeLabel="Home"
  breadcrumbLabel="Glossary"
  hreflangCodes={["en"]}
>
  <header class="hero-banner">
    <div class="hero-content">
      <span class="eyebrow">Time Zone Terminology &amp; Definitions</span>
      <h1 class="hero-banner-title">Time Zone <span class="gradient-text">Glossary</span></h1>
      <p class="hero-subtitle">
        An authoritative dictionary defining essential global time standards, time zone abbreviations, longitudinal meridians, and software database protocols.
      </p>
    </div>
  </header>

  <div style="max-width: 900px; margin: 0 auto; padding: 2rem 16px;">
    <section class="content-section">
      <h2>Complete Time Zone Terms Dictionary</h2>
      <div style="display: grid; gap: 1.5rem; margin-top: 1.5rem;">
        {terms.map((item) => (
          <article style="background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 1.25rem;">
            <h3 style="margin-top: 0; color: var(--accent); font-size: 1.2rem;">{item.term}</h3>
            <p style="margin-bottom: 0; color: var(--text); line-height: 1.6;">{item.def}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- CONTEXTUAL INTERNAL LINKS -->
    <section class="content-section" style="margin-top: 3rem;">
      <h2>Explore Time Zone Resources</h2>
      <ul style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px; list-style: none; padding: 0;">
        <li><a href="/" style="display: block; padding: 10px; background: var(--panel); border: 1px solid var(--line); border-radius: 8px; text-decoration: none; text-align: center;">Homepage (GMT to EST)</a></li>
        <li><a href="/time-zone-guide/" style="display: block; padding: 10px; background: var(--panel); border: 1px solid var(--line); border-radius: 8px; text-decoration: none; text-align: center;">Time Zone Guide</a></li>
        <li><a href="/what-is-utc/" style="display: block; padding: 10px; background: var(--panel); border: 1px solid var(--line); border-radius: 8px; text-decoration: none; text-align: center;">What is UTC?</a></li>
        <li><a href="/sitemap/" style="display: block; padding: 10px; background: var(--panel); border: 1px solid var(--line); border-radius: 8px; text-decoration: none; text-align: center;">HTML Sitemap</a></li>
      </ul>
    </section>

    <!-- FAQ SECTION -->
    <section class="faq-section content-section" id="faq" aria-labelledby="faq-heading">
      <h2 id="faq-heading">Frequently Asked Questions</h2>
      <div class="faq-grid">
        {faqs.map((item) => (
          <details class="faq-item">
            <summary class="faq-question"><strong>{item.q}</strong></summary>
            <div class="faq-answer"><p>{item.a}</p></div>
          </details>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
