---
import BaseLayout from "theme/layouts/BaseLayout.astro";

const lang = "en";
const dir = "ltr";
const slug = "widgets";
const seoTitle = "Embeddable Time Widgets — Free Live World Clock & Converter iFrames";
const pageDescription = "Embed free live world clocks, GMT/EST converters, and meeting planners on your website. Customizable themes, responsive iFrames, and lightweight script embeds.";

const pubDate = "2026-07-30T15:00:00+05:00";
const updatedDate = "2026-07-30T15:00:00+05:00";

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "embeddable time widget, world clock iframe, timezone converter widget, website time widget, embed clock html, responsive timezone widget",
  pubDate,
  updatedDate,
  author: "Time Intelligence Team",
  faqs: [
    {
      q: "What are GMTtoEST Embeddable Widgets?",
      a: "GMTtoEST Embeddable Widgets are free, lightweight visual components (clocks, timezone converters, meeting planners) that you can easily copy and paste onto your website or blog using responsive `<iframe>` or `<script>` tags."
    },
    {
      q: "Are the time widgets free to use on commercial websites?",
      a: "Yes! All widgets in our generator are 100% free to embed on personal blogs, commercial portals, enterprise intranets, and SaaS applications with no licensing fees."
    },
    {
      q: "How do I embed a live clock widget into WordPress or Notion?",
      a: "For WordPress, insert a Custom HTML block and paste the generated `<iframe>` embed snippet. In Notion, paste the widget URL and click 'Create Embed'."
    },
    {
      q: "Do the embedded widgets update automatically for Daylight Saving Time?",
      a: "Yes. All our widgets run on real-time browser APIs and cloud sync, automatically adjusting for Daylight Saving Time (DST) changes without requiring code updates."
    },
    {
      q: "Can I customize the color theme and size of the widget?",
      a: "Absolutely. Our generator allows you to choose between Dark, Light, and Compact themes, as well as adjust custom width and height parameters."
    },
    {
      q: "What is the difference between an `<iframe>` embed and a `<script>` embed?",
      a: "An `<iframe>` embeds an isolated HTML frame, providing sandboxed security and zero styling conflicts. A `<script>` embed injects a native DOM element directly into your page for tighter CSS integration."
    },
    {
      q: "Are the widgets mobile-responsive?",
      a: "Yes, all widgets are built with fluid CSS container queries and flexbox layouts, ensuring seamless rendering across desktop displays, tablets, and smartphones."
    },
    {
      q: "Will embedding a widget slow down my website performance?",
      a: "No. Our widget code is ultra-compressed (< 12KB) and served via global CDN edges with browser caching, ensuring minimal impact on Google Lighthouse scores."
    },
    {
      q: "Can I embed a GMT to EST converter widget specifically?",
      a: "Yes! Choose the 'Time Zone Converter' widget option in the configurator, set the default pair to GMT/EST, and copy your custom embed snippet."
    },
    {
      q: "How do I ensure iframe security on HTTPS sites?",
      a: "Our widget URLs are served over encrypted HTTPS with valid SSL certificates, guaranteeing full compliance with modern browser mixed-content security rules."
    },
    {
      q: "What iframe attributes are included in the embed code?",
      a: "Our generated iframe snippet includes `loading=\"lazy\"` for fast page loads, `frameborder=\"0\"`, `scrolling=\"no\"`, and `title=\"GMTtoEST Time Widget\"` for screen reader accessibility."
    },
    {
      q: "Can I pre-select specific cities for the World Clock widget?",
      a: "Yes, you can configure default city pairs (such as New York, London, Tokyo, and Sydney) in the generator before copying your code snippet."
    },
    {
      q: "Do the widgets require jQuery or external frameworks?",
      a: "No, all widgets are built with zero external framework dependencies using pure vanilla JavaScript and CSS."
    },
    {
      q: "Can I use postMessage to communicate with the embedded widget?",
      a: "Yes! Modern versions of our widgets emit window `postMessage` events when timezone selections change, allowing parent web pages to listen and respond."
    },
    {
      q: "Is there a limit on how many pageviews my embedded widget can receive?",
      a: "No, our CDN infrastructure supports unlimited high-volume web traffic without rate limiting."
    },
    {
      q: "How do I remove the widget border?",
      a: "The generated iframe code includes inline style `border: none; overflow: hidden;` to ensure seamless borderless integration with your website layout."
    }
  ]
};
---

<BaseLayout
  lang={lang}
  dir={dir}
  title={seoTitle}
  description={pageDescription}
  slug={slug}
  meta={meta}
  enableFaqSchema={true}
  allowAds={true}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "Embeddable Time Widgets",
    "operatingSystem": "All",
    "applicationCategory": "UtilitiesApplication",
    "offers": { "@type": "Offer", "price": "0" }
  })} />

  <div class="hero-header text-center py-8 bg-gradient-to-r from-blue-900 via-cyan-950 to-slate-900 text-white rounded-2xl mb-8 shadow-xl">
    <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight mb-3">Embeddable Time Widgets</h1>
    <p class="text-lg sm:text-xl text-cyan-200 max-w-3xl mx-auto px-4">
      Add free, live ticking world clocks, timezone converters, and meeting planners directly to your website.
    </p>
  </div>

  <!-- Interactive Widget Generator & Live Preview -->
  <section class="max-w-5xl mx-auto bg-white dark:bg-slate-800 rounded-2xl p-6 sm:p-8 shadow-2xl border border-slate-200 dark:border-slate-700 mb-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      <!-- Configurator Panel -->
      <div class="lg:col-span-5 bg-slate-50 dark:bg-slate-900 p-5 rounded-xl border border-slate-200 dark:border-slate-700 space-y-4">
        <h3 class="text-lg font-bold text-slate-800 dark:text-slate-100 border-b border-slate-200 dark:border-slate-700 pb-2">
          ⚙️ Widget Customizer
        </h3>

        <div>
          <label for="cfg-type" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Widget Type:</label>
          <select id="cfg-type" class="w-full p-2.5 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100 text-sm">
            <option value="clock" selected>Live World Clock</option>
            <option value="converter">GMT to EST Converter</option>
            <option value="planner">Meeting Overlap Strip</option>
          </select>
        </div>

        <div>
          <label for="cfg-theme" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Color Theme:</label>
          <select id="cfg-theme" class="w-full p-2.5 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100 text-sm">
            <option value="dark" selected>Dark Navy</option>
            <option value="light">Clean Light</option>
            <option value="compact">Minimal Slate</option>
          </select>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="cfg-width" class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Width (px/%):</label>
            <input type="text" id="cfg-width" value="100%" class="w-full p-2 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100 text-sm" />
          </div>
          <div>
            <label for="cfg-height" class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Height (px):</label>
            <input type="number" id="cfg-height" value="220" class="w-full p-2 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100 text-sm" />
          </div>
        </div>

        <div class="pt-2">
          <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Embed Mode:</label>
          <div class="flex gap-4 text-xs">
            <label class="inline-flex items-center cursor-pointer">
              <input type="radio" name="embed-mode" value="iframe" checked class="form-radio text-cyan-600" />
              <span class="ml-1.5 text-slate-700 dark:text-slate-300">iFrame</span>
            </label>
            <label class="inline-flex items-center cursor-pointer">
              <input type="radio" name="embed-mode" value="script" class="form-radio text-cyan-600" />
              <span class="ml-1.5 text-slate-700 dark:text-slate-300">Script Tag</span>
            </label>
          </div>
        </div>
      </div>

      <!-- Live Preview & Code Panel -->
      <div class="lg:col-span-7 space-y-6">
        <div>
          <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-2">Live Preview:</h3>
          <div id="preview-box" class="w-full rounded-xl border border-slate-300 dark:border-slate-700 p-4 transition-all duration-300 min-h-[220px] flex items-center justify-center bg-slate-900 text-white">
            <!-- Simulated Widget Element -->
            <div id="simulated-widget" class="w-full p-4 rounded-lg bg-slate-950 border border-slate-800 text-center">
              <div class="text-xs uppercase text-cyan-400 font-bold mb-1" id="widget-preview-title">Live World Clock</div>
              <div class="text-3xl font-mono font-bold text-white my-2" id="widget-preview-time">12:00:00 PM EST</div>
              <div class="text-xs text-slate-400" id="widget-preview-sub">New York (UTC-5) | London (UTC+0)</div>
            </div>
          </div>
        </div>

        <div>
          <div class="flex items-center justify-between mb-2">
            <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Embed Snippet:</h3>
            <button id="copy-snippet-btn" class="px-3 py-1 bg-cyan-600 hover:bg-cyan-700 text-white font-medium text-xs rounded transition-colors shadow">
              Copy Snippet
            </button>
          </div>
          <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 text-xs font-mono text-cyan-300 overflow-x-auto">
            <pre><code id="code-snippet-out">{`<iframe src="https://gmttoest.com/widget?type=clock&theme=dark" width="100%" height="220" frameborder="0" loading="lazy" style="border:none; overflow:hidden;" title="GMTtoEST Live Clock"></iframe>`}</code></pre>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Educational Article -->
  <section class="max-w-4xl mx-auto article-container text-slate-800 dark:text-slate-200 space-y-6 leading-relaxed">
    <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white border-b border-slate-200 dark:border-slate-700 pb-3">
      The Ultimate Guide to Embedding Web Time Widgets
    </h2>
    <p>
      In an era of remote work forces, international e-commerce, and global virtual conferences, providing real-time local timezone context to your website visitors significantly improves user experience. Whether you manage a global customer support portal, a remote team dashboard, or an international event landing page, embeddable time widgets eliminate user confusion regarding time zone offsets.
    </p>

    <h3 class="text-xl font-semibold text-slate-900 dark:text-white mt-6 mb-3">
      Architectural Choices: iFrames vs. Native JavaScript Embeds
    </h3>
    <p>
      When selecting an embed implementation for your website, consider the technical tradeoffs between sandboxed iFrames and native script tags:
    </p>
    <ul class="list-disc pl-6 space-y-2">
      <li><strong>iFrame Integration (Recommended):</strong> Encapsulates the widget in an isolated browsing context. Prevents CSS collisions between your site's styles and the widget, isolates JavaScript scope, and provides high security. Modern browsers lazy-load iFrames via <code>loading="lazy"</code>, preserving core web vitals.</li>
      <li><strong>Native JavaScript Embeds:</strong> Injects DOM elements directly into your web page. Offers seamless integration for custom CSS overrides and instant parent-child event communication.</li>
    </ul>

    <h3 class="text-xl font-semibold text-slate-900 dark:text-white mt-6 mb-3">
      Web Performance & Security Best Practices
    </h3>
    <p>
      High-performing third-party web embeds should adhere to modern browser standards:
    </p>

    <div class="my-6 p-4 bg-slate-100 dark:bg-slate-800/80 rounded-xl border-l-4 border-cyan-500 font-mono text-sm">
      &lt;iframe src="..." loading="lazy" sandbox="allow-scripts allow-same-origin" title="Live Clock"&gt;&lt;/iframe&gt;
    </div>

    <ul class="list-disc pl-6 space-y-2">
      <li><strong>Lazy Loading:</strong> Defer loading offscreen iFrames using <code>loading="lazy"</code> to conserve user bandwidth until the element scrolls into view.</li>
      <li><strong>Accessibility (a11y):</strong> Always supply a descriptive <code>title</code> attribute on the <code>&lt;iframe&gt;</code> element to satisfy WCAG requirements for screen reader users.</li>
      <li><strong>HTTPS Encryption:</strong> All widget assets must be served over secure HTTPS to prevent browser mixed-content warnings.</li>
    </ul>

    <p>
      Combine our widget suite with our web tools like <a href="/gmt-to-est/" class="text-cyan-600 dark:text-cyan-400 underline font-medium">GMT to EST Converter</a>, <a href="/world-clock/" class="text-cyan-600 dark:text-cyan-400 underline font-medium">World Clock</a>, and <a href="/meeting-planner/" class="text-cyan-600 dark:text-cyan-400 underline font-medium">Meeting Planner</a>.
    </p>

    <h3 class="text-xl font-semibold text-slate-900 dark:text-white mt-6 mb-3">
      Use Cases Across Modern Industries
    </h3>
    <ol class="list-decimal pl-6 space-y-2">
      <li><strong>Global E-Commerce Cutoffs:</strong> Embed countdown or clock widgets to inform buyers of daily shipping cutoff times across EST, PST, or GMT zones.</li>
      <li><strong>Virtual Webinar & Event Landing Pages:</strong> Display live event starting times auto-localized to the visitor's detected time zone.</li>
      <li><strong>Remote Work Team Portals:</strong> Feature custom team clocks showing active working hours for colleagues in London, New York, Tokyo, and Sydney. Refer to our <a href="/time-difference-calculator/" class="text-cyan-600 dark:text-cyan-400 underline font-medium">Time Difference Calculator</a> and <a href="/developer-tools/" class="text-cyan-600 dark:text-cyan-400 underline font-medium">Developer Tools</a>.</li>
    </ol>
  </section>

  <!-- FAQ Section -->
  <section class="max-w-4xl mx-auto my-12 pt-8 border-t border-slate-200 dark:border-slate-700">
    <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white mb-6 text-center">Frequently Asked Questions</h2>
    <div class="space-y-4">
      {meta.faqs.map(faq => (
        <details class="group bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-4 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex items-center justify-between cursor-pointer font-semibold text-slate-800 dark:text-slate-100">
            <span>{faq.q}</span>
            <span class="ml-2 transition transform group-open:rotate-180 text-cyan-600 dark:text-cyan-400">▼</span>
          </summary>
          <div class="mt-3 text-slate-600 dark:text-slate-300 text-sm leading-relaxed border-t border-slate-100 dark:border-slate-700/60 pt-3">
            <p>{faq.a}</p>
          </div>
        </details>
      ))}
    </div>
  </section>

  <!-- Script for Configurator -->
  <script is:inline>
    (function() {
      const cfgType = document.getElementById("cfg-type");
      const cfgTheme = document.getElementById("cfg-theme");
      const cfgWidth = document.getElementById("cfg-width");
      const cfgHeight = document.getElementById("cfg-height");
      const embedModes = document.querySelectorAll("input[name='embed-mode']");

      const previewTitle = document.getElementById("widget-preview-title");
      const previewTime = document.getElementById("widget-preview-time");
      const previewSub = document.getElementById("widget-preview-sub");
      const codeOut = document.getElementById("code-snippet-out");
      const copyBtn = document.getElementById("copy-snippet-btn");

      function updatePreview() {
        const type = cfgType.value;
        const theme = cfgTheme.value;
        const width = cfgWidth.value || "100%";
        const height = cfgHeight.value || "220";
        let mode = "iframe";
        embedModes.forEach(r => { if (r.checked) mode = r.value; });

        if (type === "clock") {
          previewTitle.textContent = "Live World Clock Widget";
          previewSub.textContent = "New York (EST, UTC-5) | London (GMT, UTC+0)";
        } else if (type === "converter") {
          previewTitle.textContent = "GMT to EST Time Converter";
          previewSub.textContent = "Instant Dual-Clock Converter Strip";
        } else {
          previewTitle.textContent = "Meeting Overlap Visualizer";
          previewSub.textContent = "Highlighted Golden Business Hours";
        }

        let snippet = "";
        if (mode === "iframe") {
          snippet = `<iframe src="https://gmttoest.com/widget?type=${type}&theme=${theme}" width="${width}" height="${height}" frameborder="0" loading="lazy" style="border:none; overflow:hidden;" title="GMTtoEST Time Widget"></iframe>`;
        } else {
          snippet = `<div id="gmttoest-widget" data-type="${type}" data-theme="${theme}"></div>\n<script src="https://gmttoest.com/widget.js" async><\/script>`;
        }
        codeOut.textContent = snippet;
      }

      function updateLiveTime() {
        const now = new Date();
        previewTime.textContent = now.toLocaleTimeString('en-US', { timeZone: 'America/New_York' }) + " EST";
      }
      setInterval(updateLiveTime, 1000);
      updateLiveTime();

      [cfgType, cfgTheme, cfgWidth, cfgHeight].forEach(el => {
        el.addEventListener("change", updatePreview);
        el.addEventListener("input", updatePreview);
      });
      embedModes.forEach(r => r.addEventListener("change", updatePreview));

      copyBtn.addEventListener("click", () => {
        navigator.clipboard.writeText(codeOut.textContent).then(() => {
          const orig = copyBtn.textContent;
          copyBtn.textContent = "Copied!";
          setTimeout(() => copyBtn.textContent = orig, 2000);
        });
      });

      updatePreview();
    })();
  </script>
</BaseLayout>
