          <circle cx="0" cy="0" r="50" fill="#12455d" stroke="#2f6278" stroke-width="3" />
          <line x1="0" y1="0" x2="-20" y2="10" stroke="#bdd2dc" stroke-width="3" stroke-linecap="round" />
          <line x1="0" y1="0" x2="0" y2="-30" stroke="#f4fbff" stroke-width="4" stroke-linecap="round" />
          <circle cx="0" cy="0" r="4" fill="#36c7b5" />
          <text x="0" y="70" font-family="'Space Grotesk', sans-serif" font-weight="bold" font-size="14" fill="#bdd2dc" text-anchor="middle">US Eastern (EST)</text>
          <text x="0" y="88" font-family="'Manrope', sans-serif" font-size="12" fill="#8fd7ff" text-anchor="middle">UTC-5 Offset</text>
        </g>
      </svg>
    </div>
  </div>
  
</section>

<!-- ═══════════════════════════════════════════════════════════════════════════
     LIVE CLOCKS
     ═══════════════════════════════════════════════════════════════════════ -->


<!-- ═══════════════════════════════════════════════════════════════════════════
     PARIS / BERLIN & NYC LANDMARK GRAPHIC ILLUSTRATION
     ═══════════════════════════════════════════════════════════════════════ -->
<section class="skyline-container content-section" style="text-align: center; margin: 3rem 0;">
  <h3 class="sr-only">Eiffel Tower & New York Skyline Visual Graphic</h3>
