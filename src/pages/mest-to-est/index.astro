          <text x="0" y="88" font-family="'Manrope', sans-serif" font-size="12" fill="#36c7b5" text-anchor="middle">UTC+2 Summer Offset</text>
        </g>

        <!-- Offset Arrow Badge -->
        <g transform="translate(300, 110)">
          <rect x="-50" y="-20" width="100" height="32" rx="16" fill="#1b536e" stroke="#36c7b5" stroke-width="2" />
          <text x="0" y="2" font-family="'Space Grotesk', sans-serif" font-weight="bold" font-size="13" fill="#36c7b5" text-anchor="middle">EST is -7 Hrs</text>
        </g>

        <!-- Right Clock: US Eastern (EST) -->
