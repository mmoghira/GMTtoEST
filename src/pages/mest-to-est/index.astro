      <!-- Eiffel Tower / European Silhouette (Left) -->
      <g transform="translate(110, 110)">
        <path d="M-30 40 L-10 -30 L-5 -50 L5 -50 L10 -30 L30 40 Z" fill="#12455d" stroke="#2f6278" stroke-width="2" />
        <line x1="0" y1="-50" x2="0" y2="-65" stroke="#36c7b5" stroke-width="3" />
        <circle cx="0" cy="-65" r="4" fill="#36c7b5" />
        <text x="0" y="60" font-family="'Space Grotesk', sans-serif" font-size="14" font-weight="bold" fill="#f4fbff" text-anchor="middle">Central Europe (MEST)</text>
        <text x="0" y="78" font-family="'Manrope', sans-serif" font-size="12" fill="#8fd7ff" text-anchor="middle">Paris • Berlin • Rome • Madrid</text>
      </g>

      <!-- Center offset badge -->
      <g transform="translate(350, 100)">
        <circle cx="0" cy="-10" r="35" fill="#1b536e" stroke="#36c7b5" stroke-width="2" />
        <text x="0" y="-14" font-family="'Space Grotesk', sans-serif" font-size="13" font-weight="bold" fill="#36c7b5" text-anchor="middle">7 HOURS</text>
