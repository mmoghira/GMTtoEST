---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import RelatedConvertersWidget from "theme/components/RelatedConvertersWidget.astro";
import UsersAlsoVisitWidget from "theme/components/UsersAlsoVisitWidget.astro";
import LearnMoreWidget from "theme/components/LearnMoreWidget.astro";
import CountryCityWidget from "theme/components/CountryCityWidget.astro";
import { siteUrl } from "theme/i18n/config";

const lang = "en";
const dir = "ltr";
const slug = "cdt";
const seoTitle = "Central Daylight Time (CDT) – UTC-5 Offset, Rules & Guide";
const pageDescription = "Comprehensive guide to Central Daylight Time (CDT). Explore UTC-5 offset, summer daylight saving rules in central North America, affected cities (Chicago, Houston, Dallas), CDT vs EST overlap, and conversion tables.";

const pubDate = "2026-07-30T10:00:00+05:00";
const updatedDate = "2026-07-30T10:00:00+05:00";

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "CDT, Central Daylight Time, UTC-5, CDT offset, CDT time zone, CDT vs CST, CDT vs EST, Chicago daylight time, spring forward, CDT to GMT, CDT to PST",
  image: "/assets/cdt-timezone-guide.webp",
  imageAlt: "Central Daylight Time (CDT) UTC-5 Offset Guide",
  pubDate,
  updatedDate,
  author: "Jackie Bruce",
  faqs: [
    {
      q: "What does CDT stand for?",
      a: "CDT stands for Central Daylight Time. It is the daylight saving time offset (UTC-5) observed in the Central Time zone of North America during the spring, summer, and early autumn months."
    },
    {
      q: "What is the UTC offset for CDT?",
      a: "The UTC offset for Central Daylight Time (CDT) is UTC-5. Local time in the CDT zone is exactly 5 hours behind Coordinated Universal Time (UTC) and Greenwich Mean Time (GMT)."
    },
    {
      q: "Is CDT the same offset as EST?",
      a: "Yes. Both Central Daylight Time (CDT) and Eastern Standard Time (EST) operate on a UTC-5 offset. During the summer, when Chicago is on CDT (UTC-5) and New York is on EDT (UTC-4), Chicago matches the winter clock time of New York."
    },
    {
      q: "When is CDT active during the year?",
      a: "CDT is active from the second Sunday of March (when clocks 'spring forward' from 2:00 AM to 3:00 AM) until the first Sunday of November (when clocks 'fall back' from 2:00 AM to 1:00 AM)."
    },
    {
      q: "Which major cities observe Central Daylight Time?",
      a: "Major metropolitan areas observing CDT during summer include Chicago, Houston, Dallas, Fort Worth, San Antonio, Austin, Minneapolis, Milwaukee, St. Louis, New Orleans, Memphis, and Winnipeg."
    },
    {
      q: "What is the difference between CDT and CST?",
      a: "CDT (Central Daylight Time) is UTC-5, observed during summer daylight saving months. CST (Central Standard Time) is UTC-6, observed during winter standard time months."
    },
    {
      q: "How far behind GMT is CDT?",
      a: "CDT is 5 hours behind Greenwich Mean Time (GMT/UTC+0). When it is 12:00 PM (noon) GMT in London, it is 7:00 AM CDT in Chicago and Houston."
    },
    {
      q: "How do I convert CDT to Eastern Daylight Time (EDT)?",
      a: "Central Daylight Time (CDT, UTC-5) is 1 hour behind Eastern Daylight Time (EDT, UTC-4). To convert CDT to EDT, add 1 hour (e.g., 10:00 AM CDT equals 11:00 AM EDT)."
    },
    {
      q: "How do I convert CDT to Pacific Daylight Time (PDT)?",
      a: "Central Daylight Time (CDT, UTC-5) is 2 hours ahead of Pacific Daylight Time (PDT, UTC-7). To convert CDT to PDT, subtract 2 hours (e.g., 3:00 PM CDT equals 1:00 PM PDT)."
    },
    {
      q: "Do all central regions observe Daylight Saving Time?",
      a: "No. Most of Saskatchewan in Canada observes Central Standard Time (UTC-6) year-round without CDT shifts. Additionally, Central American nations (such as Guatemala and Costa Rica) and mainland Mexico remain on UTC-6 year-round."
    },
    {
      q: "What is the time difference between CDT and Central European Summer Time (CEST)?",
      a: "Central European Summer Time (CEST, UTC+2) is 7 hours ahead of Central Daylight Time (CDT, UTC-5). When it is 10:00 AM CDT in Chicago, it is 5:00 PM CEST in Berlin and Paris."
    },
    {
      q: "What is the time difference between CDT and India Standard Time (IST)?",
      a: "India Standard Time (IST, UTC+5:30) is 10 hours and 30 minutes ahead of Central Daylight Time (CDT, UTC-5). When it is 8:00 AM CDT in Chicago, it is 6:30 PM IST in New Delhi."
    },
    {
      q: "How does CDT affect agricultural commodity trading?",
      a: "Agricultural futures markets at the Chicago Board of Trade (CBOT) execute trading sessions on local Chicago clock time (CDT during summer). European and Asian commodity traders adjust their order placement relative to UTC-5."
    },
    {
      q: "What is the time difference between CDT and British Summer Time (BST)?",
      a: "British Summer Time (BST, UTC+1) is 6 hours ahead of Central Daylight Time (CDT, UTC-5). When it is 12:00 PM CDT in Dallas, it is 6:00 PM BST in London."
    },
    {
      q: "Why do some Mexican border cities observe CDT while Mexico City does not?",
      a: "In 2022, Mexico abolished DST nationally, keeping Mexico City on UTC-6 year-round. However, northern border municipalities (such as Ciudad Juárez and Reynosa) retained DST to remain synchronized with neighboring US commerce zones."
    },
    {
      q: "What happens to scheduled database tasks during the autumn shift from CDT to CST?",
      a: "When clocks fall back from 2:00 AM CDT to 1:00 AM CST on the first Sunday of November, the 1:00 AM hour repeats. Server cron jobs configured on local time may trigger twice unless configured to run on UTC."
    },
    {
      q: "What is the best time for a meeting between Chicago (CDT) and London (BST)?",
      a: "With a 6-hour time difference between CDT (UTC-5) and BST (UTC+1), the ideal overlap window for business calls is 8:30 AM – 11:30 AM CDT (2:30 PM – 5:30 PM BST)."
    },
    {
      q: "How does CDT impact sports broadcast schedules?",
      a: "US national sports broadcasts originating in the Central Time zone list kickoff times in Eastern and Central times (e.g., '7:00 PM ET / 6:00 PM CT')."
    },
    {
      q: "What is the time difference between CDT and Australian Eastern Standard Time (AEST)?",
      a: "Australian Eastern Standard Time (AEST, UTC+10) is 15 hours ahead of Central Daylight Time (CDT, UTC-5). When it is 7:00 AM CDT in Houston, it is 10:00 PM AEST in Sydney."
    },
    {
      q: "Is CDT an official IANA time zone name?",
      a: "CDT is a display abbreviation. The official IANA time zone identifier for the US Central region is `America/Chicago`, which automatically handles CDT and CST transitions."
    }
  ]
};

const pageUrlPath = `${siteUrl}/${slug}/`;
---

<BaseLayout
  lang={lang}
  dir={dir}
  title={seoTitle}
  description={pageDescription}
  slug={slug}
  meta={meta}
  enableFaqSchema={true}
  enableArticleSchema={true}
  breadcrumbHomeLabel="Home"
  breadcrumbLabel="CDT"
>
  <!-- Hero Section -->
  <section class="hero-banner" aria-labelledby="hero-title">
    <h1 id="hero-title" class="hero-banner-title speakable-headline">
      Central Daylight Time (CDT): <span class="gradient-text">UTC-5 Offset & Summer Rules</span>
    </h1>
  </section>

  <!-- Editorial Info Bar -->
  <div class="editorial-meta-bar" aria-label="Editorial metadata">
    <span>Last Updated: <strong>July 30, 2026</strong></span>
    <span class="separator" aria-hidden="true">•</span>
    <span>Editorially Reviewed by <a href="/author/jackie-bruce/"><strong>Jackie Bruce</strong></a></span>
    <span class="separator" aria-hidden="true">•</span>
    <span>Data Source: <a href="https://www.iana.org/time-zones" target="_blank" rel="noopener noreferrer"><strong>IANA Time Zone Database</strong></a></span>
  </div>

  <div class="article-wrapper">
    <!-- Top Answer Summary Box -->
    <div class="summary-box speakable-summary">
      <div class="summary-header">
        <span class="summary-badge">DAYLIGHT TIME PROFILE</span>
        <h2>Central Daylight Time (CDT) Summary</h2>
      </div>
      <div class="summary-grid">
        <div class="summary-item">
          <span class="label">UTC Offset:</span>
          <span class="val highlight">UTC-5 (5 hours behind GMT)</span>
        </div>
        <div class="summary-item">
          <span class="label">Active Window:</span>
          <span class="val">2nd Sunday March to 1st Sunday November</span>
        </div>
        <div class="summary-item">
          <span class="label">Standard Counterpart:</span>
          <span class="val"><a href="/cst/">CST (Central Standard Time, UTC-6)</a></span>
        </div>
        <div class="summary-item">
          <span class="label">Major Cities:</span>
          <span class="val"><a href="/chicago-time/">Chicago</a>, Houston, Dallas, Minneapolis, Winnipeg</span>
        </div>
        <div class="summary-item">
          <span class="label">Offset Equivalence:</span>
          <span class="val">Shares UTC-5 offset with winter <a href="/est/">EST</a></span>
        </div>
        <div class="summary-item">
          <span class="label">Spring Shift:</span>
          <span class="val">Clocks spring forward 1 hour (2:00 AM → 3:00 AM)</span>
        </div>
      </div>
      <p class="summary-text">
        <strong>Central Daylight Time (CDT)</strong> is the daylight saving time offset observed across central North America from March to November. Operating at <strong>UTC-5</strong>, CDT moves local clocks one hour ahead of winter standard time (<a href="/cst/">CST UTC-6</a>). Interestingly, CDT shares the exact UTC-5 offset as Eastern Standard Time (<a href="/est/">EST</a>).
      </p>
    </div>

    <!-- Table of Contents -->
    <nav class="about-toc" aria-label="Table of Contents">
      <h2>Table of Contents</h2>
      <ul>
        <li><a href="#what-is-cdt">1. What is Central Daylight Time (CDT)?</a></li>
        <li><a href="#cdt-vs-cst-and-est">2. CDT vs. CST & Overlap with Winter EST</a></li>
        <li><a href="#transition-schedule">3. Transition Calendar & Clock Shift Rules</a></li>
        <li><a href="#geographic-observance">4. Geographic Observance & Border Exemptions</a></li>
        <li><a href="#conversion-tables">5. Global CDT Time Conversion Tables</a></li>
        <li><a href="#business-and-trading">6. Commodity Trading (CBOT/CME) & Regional Logistics</a></li>
        <li><a href="#faqs">7. Frequently Asked Questions (20 Detailed Answers)</a></li>
      </ul>
    </nav>

    <!-- Content Sections -->
    <section id="what-is-cdt" class="content-section">
      <h2>1. What is Central Daylight Time (CDT)?</h2>
      <p>
        <strong>Central Daylight Time (CDT)</strong> is the summer daylight saving phase of the Central Time Zone in North America. Governed by the US Uniform Time Act, CDT maintains an offset of <strong>UTC-5</strong>, placing local time 5 hours behind <a href="/utc/">Coordinated Universal Time (UTC)</a> and <a href="/gmt/">Greenwich Mean Time (GMT)</a>.
      </p>
      <p>
        CDT is observed by millions of residents across major metropolitan areas in the United States and Canada, including Chicago, Houston, Dallas-Fort Worth, Minneapolis-St. Paul, St. Louis, and Winnipeg.
      </p>
    </section>

    <!-- SVG Diagram 1: CDT vs EST Offset Equivalence -->
    <section class="diagram-section">
      <div class="diagram-card">
        <h3>Figure 1: UTC-5 Offset Equivalence (Summer CDT ≡ Winter EST)</h3>
        <div class="svg-wrapper">
          <svg viewBox="0 0 800 240" width="100%" height="auto" xmlns="http://www.w3.org/2000/svg" aria-label="CDT vs EST Offset Equivalence Diagram">
            <rect width="800" height="240" fill="var(--panel)" rx="12" stroke="var(--line)" stroke-width="1"/>
            
            <!-- CDT Summer Box -->
            <rect x="60" y="50" width="310" height="130" rx="8" fill="rgba(255,255,255,0.03)" stroke="var(--accent)" stroke-width="2"/>
            <text x="215" y="85" text-anchor="middle" fill="var(--accent)" font-family="Space Grotesk, sans-serif" font-weight="bold" font-size="16">CDT (Summer Central)</text>
            <text x="215" y="120" text-anchor="middle" fill="#ffffff" font-weight="bold" font-size="24">UTC-5</text>
            <text x="215" y="150" text-anchor="middle" fill="var(--muted)" font-size="12">Chicago / Houston (March–Nov)</text>

            <!-- Equals Sign -->
            <text x="400" y="125" text-anchor="middle" fill="var(--accent)" font-family="Space Grotesk, sans-serif" font-weight="bold" font-size="28">=</text>

            <!-- EST Winter Box -->
            <rect x="430" y="50" width="310" height="130" rx="8" fill="rgba(255,255,255,0.03)" stroke="var(--line)" stroke-width="2"/>
            <text x="585" y="85" text-anchor="middle" fill="var(--text)" font-family="Space Grotesk, sans-serif" font-weight="bold" font-size="16">EST (Winter Eastern)</text>
            <text x="585" y="120" text-anchor="middle" fill="#ffffff" font-weight="bold" font-size="24">UTC-5</text>
            <text x="585" y="150" text-anchor="middle" fill="var(--muted)" font-size="12">New York / Toronto (Nov–March)</text>
          </svg>
        </div>
        <p class="diagram-caption">
          Figure 1: Illustration highlighting that Central Daylight Time (CDT) in summer shares the exact UTC-5 offset with Eastern Standard Time (EST) in winter.
        </p>
      </div>
    </section>

    <section id="cdt-vs-cst-and-est" class="content-section">
      <h2>2. CDT vs. CST & Overlap with Winter EST</h2>
      <p>
        Understanding how CDT shifts relative to neighboring zones is key for cross-continental scheduling:
      </p>
      <ul>
        <li><strong>CDT vs CST:</strong> CDT is UTC-5 (summer), whereas <a href="/cst/">CST is UTC-6</a> (winter). Moving from CST to CDT advances local clocks by 1 hour.</li>
        <li><strong>CDT vs EDT:</strong> During summer, both Central and Eastern regions advance their clocks simultaneously. Thus, CDT (UTC-5) remains 1 hour behind <a href="/edt/">EDT (UTC-4)</a>.</li>
        <li><strong>CDT vs EST:</strong> When Chicago is on CDT (UTC-5) and New York is on EDT (UTC-4), Chicago matches the time offset of winter New York (<a href="/est/">EST UTC-5</a>).</li>
      </ul>
      <p>
        For a deep dive into seasonal mechanics, visit our guide on <a href="/daylight-saving-time-explained/">Daylight Saving Time Explained</a>.
      </p>
    </section>

    <section id="transition-schedule" class="content-section">
      <h2>3. Transition Calendar & Clock Shift Rules</h2>
      <p>
        The annual clock adjustments for Central Daylight Time adhere to the US Energy Policy Act of 2005:
      </p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Transition Event</th>
              <th>Exact Time & Date Rule</th>
              <th>Clock Adjustment</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Spring Forward (CST → CDT)</strong></td>
              <td>2nd Sunday of March at 2:00 AM</td>
              <td>Clocks jump from 2:00 AM to 3:00 AM CDT (+1 hour)</td>
            </tr>
            <tr>
              <td><strong>Fall Back (CDT → CST)</strong></td>
              <td>1st Sunday of November at 2:00 AM</td>
              <td>Clocks fall back from 2:00 AM to 1:00 AM CST (-1 hour)</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section id="geographic-observance" class="content-section">
      <h2>4. Geographic Observance & Border Exemptions</h2>
      <p>
        Central Daylight Time covers major industrial regions across North America:
      </p>
      <ul>
        <li><strong>United States:</strong> Illinois, Texas, Minnesota, Missouri, Louisiana, Wisconsin, Iowa, Alabama, Mississippi, Oklahoma, Arkansas, Tennessee (western). See <a href="/usa-time-zones/">USA Time Zones</a>.</li>
        <li><strong>Canada:</strong> Manitoba, Northwestern Ontario, Nunavut. See <a href="/canada-time-zones/">Canada Time Zones</a>.</li>
        <li><strong>Mexican Border Cities:</strong> Ciudad Juárez, Ojinaga, and Reynosa observe CDT in synchronization with the US border economy.</li>
        <li><strong>Non-Observing Exceptions:</strong> Saskatchewan (except Lloydminster) remains on CST (UTC-6) year-round. Central American nations also observe UTC-6 year-round without daylight saving adjustments.</li>
      </ul>
    </section>

    <section id="conversion-tables" class="content-section">
      <h2>5. Global CDT Time Conversion Tables</h2>
      <p>
        Use the table below to convert Central Daylight Time (CDT, UTC-5) to major global time zones during summer:
      </p>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>CDT (UTC-5)</th>
              <th>GMT (UTC+0)<br/><a href="/gmt-to-cdt/">CDT to GMT</a></th>
              <th>EDT (UTC-4)<br/><a href="/gmt-to-cdt/">CDT to EDT</a></th>
              <th>PDT (UTC-7)<br/><a href="/gmt-to-pdt/">CDT to PDT</a></th>
              <th>BST (UTC+1)<br/><a href="/bst-to-est/">CDT to BST</a></th>
              <th>IST (UTC+5:30)<br/><a href="/ist-to-est/">CDT to IST</a></th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>00:00 CDT (Midnight)</td>
              <td>05:00 GMT</td>
              <td>01:00 EDT</td>
              <td>22:00 PDT (Prev Day)</td>
              <td>06:00 BST</td>
              <td>10:30 IST</td>
            </tr>
            <tr>
              <td>06:00 CDT</td>
              <td>11:00 GMT</td>
              <td>07:00 EDT</td>
              <td>04:00 PDT</td>
              <td>12:00 BST</td>
              <td>16:30 IST</td>
            </tr>
            <tr>
              <td>09:00 CDT</td>
              <td>14:00 GMT</td>
              <td>10:00 EDT</td>
              <td>07:00 PDT</td>
              <td>15:00 BST</td>
              <td>19:30 IST</td>
            </tr>
            <tr>
              <td>12:00 CDT (Noon)</td>
              <td>17:00 GMT</td>
              <td>13:00 EDT</td>
              <td>09:00 PDT</td>
              <td>18:00 BST</td>
              <td>22:30 IST</td>
            </tr>
            <tr>
              <td>15:00 CDT</td>
              <td>20:00 GMT</td>
              <td>16:00 EDT</td>
              <td>12:00 PDT</td>
              <td>21:00 BST</td>
              <td>01:30 IST (Next Day)</td>
            </tr>
            <tr>
              <td>18:00 CDT</td>
              <td>23:00 GMT</td>
              <td>19:00 EDT</td>
              <td>15:00 PDT</td>
              <td>00:00 BST (Next Day)</td>
              <td>04:30 IST (Next Day)</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p>
        For live, multi-timezone calculations, launch our <a href="/gmt-to-cdt/">GMT to CDT Time Converter</a>.
      </p>
    </section>

    <!-- SVG Diagram 2: Summer Daylight Saving Offsets -->
    <section class="diagram-section">
      <div class="diagram-card">
        <h3>Figure 2: North American Summer Daylight Saving Offsets</h3>
        <div class="svg-wrapper">
          <svg viewBox="0 0 800 220" width="100%" height="auto" xmlns="http://www.w3.org/2000/svg" aria-label="North American Summer DST Offsets">
            <rect width="800" height="220" fill="var(--panel)" rx="12" stroke="var(--line)" stroke-width="1"/>
            
            <circle cx="160" cy="110" r="30" fill="var(--panel)" stroke="var(--line)" stroke-width="2"/>
            <text x="160" y="114" text-anchor="middle" fill="var(--text)" font-weight="bold" font-size="13">PDT</text>
            <text x="160" y="160" text-anchor="middle" fill="var(--muted)" font-size="11">UTC-7 (Pacific)</text>

            <circle cx="320" cy="110" r="30" fill="var(--panel)" stroke="var(--line)" stroke-width="2"/>
            <text x="320" y="114" text-anchor="middle" fill="var(--text)" font-weight="bold" font-size="13">MDT</text>
            <text x="320" y="160" text-anchor="middle" fill="var(--muted)" font-size="11">UTC-6 (Mountain)</text>

            <circle cx="480" cy="110" r="38" fill="var(--accent)" stroke="#ffffff" stroke-width="2.5"/>
            <text x="480" y="115" text-anchor="middle" fill="#ffffff" font-family="Space Grotesk, sans-serif" font-weight="bold" font-size="16">CDT</text>
            <text x="480" y="165" text-anchor="middle" fill="var(--accent)" font-weight="bold" font-size="12">UTC-5 (Central)</text>

            <circle cx="640" cy="110" r="30" fill="var(--panel)" stroke="var(--line)" stroke-width="2"/>
            <text x="640" y="114" text-anchor="middle" fill="var(--text)" font-weight="bold" font-size="13">EDT</text>
            <text x="640" y="160" text-anchor="middle" fill="var(--muted)" font-size="11">UTC-4 (Eastern)</text>

            <line x1="190" y1="110" x2="290" y2="110" stroke="var(--line)" stroke-width="2"/>
            <line x1="350" y1="110" x2="442" y2="110" stroke="var(--line)" stroke-width="2"/>
            <line x1="518" y1="110" x2="610" y2="110" stroke="var(--line)" stroke-width="2"/>
          </svg>
        </div>
        <p class="diagram-caption">
          Figure 2: Relative positioning of CDT (UTC-5) within the North American summer daylight saving offset continuum.
        </p>
      </div>
    </section>

    <section id="business-and-trading" class="content-section">
      <h2>6. Commodity Trading (CBOT/CME) & Regional Logistics</h2>
      <p>
        During CDT, commodity trading on the Chicago Mercantile Exchange (CME) operates on central local time. Trillion-dollar agricultural futures markets (wheat, corn, soybeans) and oil benchmarks rely on precise CDT timing.
      </p>
      <p>
        Distributed corporate teams managing handovers between London (BST) and Chicago (CDT) enjoy a 6-hour time gap, providing a prime meeting window from 8:30 AM to 11:30 AM CDT. Explore strategies in our guide to <a href="/remote-team-scheduling/">Remote Team Scheduling</a>.
      </p>
    </section>

    <!-- Contextual Widgets Integration -->
    <RelatedConvertersWidget slug={slug} />
    <UsersAlsoVisitWidget slug={slug} />
    <LearnMoreWidget slug={slug} />
    <CountryCityWidget slug={slug} />

    <!-- FAQ Section -->
    <section id="faqs" class="content-section faqs-section">
      <h2>7. Frequently Asked Questions (CDT)</h2>
      <div class="faq-list">
        {meta.faqs.map((faq, index) => (
          <details class="faq-item" open={index === 0}>
            <summary class="faq-question">
              <h3>{faq.q}</h3>
            </summary>
            <div class="faq-answer">
              <p>{faq.a}</p>
            </div>
          </details>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .article-wrapper {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 1rem 3rem;
  }
  .hero-banner {
    text-align: center;
    padding: 3rem 1rem 1.5rem;
  }
  .hero-banner-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--text);
  }
  .gradient-text {
    background: linear-gradient(135deg, var(--accent) 0%, #38bdf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .editorial-meta-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--muted);
    margin-bottom: 2rem;
    padding: 0.75rem 1rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
  }
  .editorial-meta-bar a {
    color: var(--accent);
    text-decoration: none;
  }
  .separator {
    opacity: 0.5;
  }
  .summary-box {
    background: var(--panel);
    border: 1px solid var(--accent);
    border-radius: 12px;
    padding: 1.75rem;
    margin-bottom: 2.5rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.15);
  }
  .summary-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }
  .summary-badge {
    background: var(--accent);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    letter-spacing: 0.05em;
  }
  .summary-header h2 {
    font-size: 1.35rem;
    margin: 0;
