        <rect x="200" y="165" width="200" fill="#1e293b" height="30" stroke="#475569" rx="4" />
        <text x="300" y="185" font-family="sans-serif" font-size="11" fill="#64748b" text-anchor="middle">Sleep in Darkness (4am - 7am)</text>
        
