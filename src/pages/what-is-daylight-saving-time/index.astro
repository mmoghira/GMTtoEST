const lang = "en";
const dir = "ltr";
const slug = "what-is-daylight-saving-time";
const seoTitle = "What is Daylight Saving Time? Definition, Purpose & Clocks Change (2026)";
const pageDescription = "Discover what Daylight Saving Time (DST) is, why clocks spring forward and fall back, global usage, health effects, and DST vs Standard Time differences.";

const pubDate = "2026-07-30T15:00:00+05:00";
const updatedDate = "2026-07-30T15:00:00+05:00";

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "What is Daylight Saving Time, DST definition, Spring Forward Fall Back, Daylight Saving Time explained, Standard Time vs DST, DST history, DST health effects, Sunshine Protection Act",
  image: "/assets/daylight-saving-transition.svg",
  imageAlt: "What is Daylight Saving Time guide diagram",
  pubDate,
  updatedDate,
  author: "Jackie Bruce",
  faqs: [
    {
      q: "What is the exact definition of Daylight Saving Time (DST)?",
      a: "Daylight Saving Time (DST) is the seasonal practice of advancing civil clocks forward by one hour during warmer spring and summer months, then moving them back one hour in autumn to return to standard time. The primary objective is to shift natural daylight from early morning hours to evening hours."
    },
    {
      q: "What is the phrase used to remember clock changes?",
      a: "The standard mnemonic is 'Spring forward, Fall back.' In the spring, clocks are set forward by one hour (e.g., from 2:00 AM to 3:00 AM). In the autumn (fall), clocks are set back by one hour (e.g., from 2:00 AM to 1:00 AM)."
    },
    {
      q: "What is the main purpose of Daylight Saving Time?",
      a: "The initial historical purpose of DST was to conserve energy by extending evening daylight, thereby reducing the need for artificial lighting. In modern times, arguments emphasize increased leisure time, evening retail sales, and reduced evening traffic accidents."
    },
    {
      q: "What is the difference between Standard Time and Daylight Saving Time?",
      a: "Standard Time is the official local time standard based on a region's geographical timezone offset relative to Coordinated Universal Time (UTC). Daylight Saving Time is a temporary one-hour advance (e.g., UTC-5 becomes UTC-4) applied during summer."
    },
    {
      q: "Does Daylight Saving Time create more daylight hours?",
      a: "No. DST does not alter astronomical daylight hours, which are determined strictly by Earth's tilt and solar orbit. It simply shifts civil clock hours to align human waking activity with available daylight."
    },
    {
      q: "When does Daylight Saving Time start and end in North America?",
      a: "In the United States and Canada, DST starts on the second Sunday in March at 2:00 AM (clocks move to 3:00 AM) and ends on the first Sunday in November at 2:00 AM (clocks move back to 1:00 AM)."
    },
    {
      q: "When does Summer Time start and end in Europe?",
      a: "In the European Union and the United Kingdom, DST (referred to as Summer Time) begins on the last Sunday in March at 01:00 UTC and ends on the last Sunday in October at 01:00 UTC."
    },
    {
      q: "Which US states do not observe Daylight Saving Time?",
      a: "Hawaii and Arizona (with the exception of the Navajo Nation) do not observe DST. The territories of Puerto Rico, Guam, American Samoa, the US Virgin Islands, and the Northern Mariana Islands also remain on standard time year-round."
    },
    {
      q: "Does Canada use Daylight Saving Time nationwide?",
      a: "Most Canadian provinces observe DST. However, most of Saskatchewan, Yukon, and selected communities in British Columbia, Ontario, and Quebec maintain year-round standard time."
    },
    {
      q: "Why do countries near the equator skip Daylight Saving Time?",
      a: "Equatorial regions experience almost consistent 12-hour daylight and 12-hour night cycles throughout the entire year. Because daylight hours do not fluctuate seasonally, setting clocks forward provides no benefit."
    },
    {
      q: "How does Daylight Saving Time affect health and circadian rhythms?",
      a: "The spring transition causes acute sleep deprivation and desynchronizes the internal circadian clock. Scientific studies link the spring transition to short-term spikes in cardiovascular events, workplace accidents, and traffic fatalities."
    },
    {
      q: "What is the Sunshine Protection Act?",
      a: "The Sunshine Protection Act is proposed US legislation aimed at making Daylight Saving Time permanent nationwide, eliminating the twice-yearly clock change. While passed by the Senate in 2022, it has not been signed into law."
    },
    {
      q: "Why do farmers historically oppose Daylight Saving Time?",
      a: "Farmers opposed DST because agricultural chores depend on solar cycles, livestock habits, and morning dew drying schedules rather than clock time. Shifting clocks disrupted morning logistics for shipping milk and crops to market."
    },
    {
      q: "What is the difference between EST and EDT?",
      a: "EST stands for Eastern Standard Time (UTC-5), used during winter months. EDT stands for Eastern Daylight Time (UTC-4), used during summer months when DST is active."
    },
    {
      q: "What happens to flight schedules during clock shifts?",
      a: "Airlines and aviation authorities coordinate international flight schedules using UTC (Coordinated Universal Time), which never shifts for DST. Local departure and arrival listings adjust to local civil times."
    },
    {
      q: "How do computer operating systems handle DST shifts?",
      a: "Modern operating systems use the IANA Time Zone Database (tzdb). System clocks maintain internal hardware timers in UTC and automatically update local display times using standard zone rules."
    },
    {
      q: "What happens to cron jobs during the fall clock change?",
      a: "If a cron job is scheduled between 1:00 AM and 2:00 AM during the autumn transition, it may run twice unless configured on UTC or programmed with DST-aware task schedulers."
    },
    {
      q: "Which hemisphere experiences DST during December?",
      a: "The Southern Hemisphere (e.g., parts of Australia and New Zealand) observes DST during December because December is their summer season."
    },
    {
      q: "Is it 'Daylight Saving Time' or 'Daylight Savings Time'?",
      a: "The grammatically correct term is 'Daylight Saving Time' (singular). The word 'saving' acts as a participle modifying 'time.' 'Savings' with an 's' is a common colloquial misnomer."
    },
    {
      q: "How does DST affect energy consumption today?",
      a: "Modern research shows minimal or neutral energy savings. While evening lighting electricity decreases, morning heating demands and late afternoon air conditioning usage frequently offset any savings."
    }
  ]
};

