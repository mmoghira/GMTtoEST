        <rect x="470" y="85" width="200" fill="#0284c7" fill-opacity="0.3" height="30" stroke="#38bdf8" rx="4" />
        <text x="570" y="105" font-family="sans-serif" font-size="11" fill="#7dd3fc" text-anchor="middle">Active Evening (5pm-8pm)</text>

        <!-- DST Shift Bar -->
