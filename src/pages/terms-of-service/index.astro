---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import { siteUrl } from "theme/i18n/config";

const title = "Terms of Service";
const description = "Read GMT to EST Converter's Terms of Service covering permitted use, accuracy, intellectual property, advertising, disclaimers, and user responsibilities.";
const meta = {
  title,
  seoTitle: "Terms of Service & Website Use",
  description,
  keywords: "GMT to EST terms of service, website use, acceptable use, intellectual property, service disclaimer",
  image: "/images/og/default.png",
  imageAlt: "Terms of Service for GMT to EST Converter"
};

const pageUrl = `${siteUrl}/terms-of-service/`;
const lastUpdated = "June 29, 2026";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${pageUrl}#webpage`,
    url: pageUrl,
    name: title,
    description,
    inLanguage: "en",
    dateModified: "2026-06-29",
    isPartOf: {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      url: siteUrl,
      name: "GMT to EST Converter"
    },
    breadcrumb: {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: siteUrl },
        { "@type": "ListItem", position: 2, name: "Terms of Service", item: pageUrl }
      ]
    },
    author: {
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      name: "GMT to EST Converter"
    }
  }
];

const toc = [
  ["about", "About GMT to EST Converter"],
  ["accepting", "Accepting These Terms"],
  ["eligibility", "Who Can Use This Website"],
  ["permitted-use", "How You May Use This Website"],
  ["prohibited-use", "What You May Not Do"],
  ["accuracy", "Accuracy of Tools and Content"],
  ["intellectual-property", "Intellectual Property Rights"],
  ["advertising", "Advertising and Google AdSense"],
  ["communications", "User Communications"],
  ["third-party-services", "Third-Party Services"],
  ["external-links", "External Links"],
  ["availability", "Website Availability and Changes"],
  ["warranties", "Disclaimer of Warranties"],
  ["liability", "Limitation of Liability"],
  ["indemnification", "Indemnification"],
  ["termination", "Termination of Access"],
  ["governing-law", "Governing Law and Disputes"],
  ["changes", "Changes to These Terms"],
  ["severability", "Severability"],
  ["entire-agreement", "Entire Agreement"],
  ["related-policies", "Related Policies"],
  ["contact-terms", "Contact Us"]
];
---

<BaseLayout lang="en" dir="ltr" title={title} description={description} slug="terms-of-service" meta={meta}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} slot="head" />

  <article class="tos-page">
    <header class="tos-header">
      <span class="tos-eyebrow">Website Terms</span>
      <h1>Terms of Service — GMT to EST Converter</h1>
      <p class="tos-meta">Last updated: <time datetime="2026-06-29">{lastUpdated}</time></p>
      <div class="tos-intro">
        <h2>Welcome — Please Read This First</h2>
        <p>We know that Terms of Service pages are not anyone’s favorite reading material. But we believe you should understand the rules before using any website, including ours.</p>
        <p>These Terms are written in plain language: no hidden clauses, just a clear explanation of what we offer, what we expect from visitors, and what protections apply to everyone involved.</p>
        <p>These Terms of Service (“Terms”) govern access to and use of GMT to EST Converter, including all tools, content, resources, and features available on this website. By visiting or using any part of the site, you agree to these Terms. If any part does not work for you, discontinue use and <a href="/contact-us/">contact us with your concerns</a>.</p>
      </div>
    </header>

    <nav class="tos-toc" aria-labelledby="terms-contents-heading">
      <h2 id="terms-contents-heading">Terms of Service Contents</h2>
      <ol>
        {toc.map(([id, label], index) => <li><a href={`#${id}`}>{index + 1}. {label}</a></li>)}
      </ol>
    </nav>

    <div class="tos-body">
      <section class="tos-section" id="about" aria-labelledby="about-heading">
        <h2 id="about-heading">1. About GMT to EST Converter</h2>
        <p>GMT to EST Converter is a free, independently operated online platform built around one purpose: helping people convert time zones accurately, quickly, and without confusion.</p>
        <p>We provide a growing library of tools and resources:</p>
        <ul>
          <li><strong>Time zone converters</strong> — including the <a href="/">GMT to EST Converter</a>, <a href="/cst-to-est/">CST to EST Converter</a>, <a href="/pdt-to-est/">PDT to EST Converter</a>, and <a href="/kst-to-est/">KST to EST Converter</a>.</li>
          <li><strong>Time difference resources</strong> — such as our <a href="/gmt-vs-est/">GMT vs EST guide</a>.</li>
          <li><strong>Meeting-planning guidance</strong> — practical help for global teams and schedules.</li>
          <li><strong>Daylight Saving Time references</strong> — explanations of seasonal changes and offsets.</li>
          <li><strong>Educational content</strong> — our <a href="/time-zone-guide/">Time Zone Guide</a> and articles explaining how global timekeeping works.</li>
        </ul>
        <p>Every core tool and article is free to access. We do not require account registration or place essential features behind a paywall. These Terms apply equally to all visitors, regardless of how they access the site.</p>
      </section>

      <section class="tos-section" id="accepting" aria-labelledby="accepting-heading">
        <h2 id="accepting-heading">2. Accepting These Terms</h2>
        <p>By accessing GMT to EST Converter—whether you visit one page, use a conversion tool, read an article, or contact us—you confirm that:</p>
        <ul>
          <li>You have read and understood these Terms.</li>
          <li>You agree to comply with applicable local, national, and international laws and regulations.</li>
          <li>You accept responsibility for how you use the website and its tools.</li>
          <li>You understand that continued use after an update constitutes acceptance of the revised Terms.</li>
        </ul>
        <p>If you use this website on behalf of a business, organization, or other entity, you represent that you have authority to bind that entity to these Terms.</p>
      </section>

      <section class="tos-section" id="eligibility" aria-labelledby="eligibility-heading">
        <h2 id="eligibility-heading">3. Who Can Use This Website</h2>
        <p>GMT to EST Converter is intended for a general audience. Our tools and content are designed to be appropriate and accessible for users of different ages.</p>
        <p>By using the site, you represent that:</p>
        <ul>
          <li>You are at least 13 years old or use the site under the supervision of a parent or legal guardian.</li>
          <li>Your use does not violate laws applicable in your jurisdiction.</li>
          <li>You are not accessing the site from a location where doing so would be illegal.</li>
        </ul>
        <p>We welcome users from all countries and backgrounds. Time zones do not discriminate, and neither do we.</p>
      </section>

      <section class="tos-section" id="permitted-use" aria-labelledby="permitted-heading">
        <h2 id="permitted-heading">4. How You May Use This Website</h2>
        <p>You may:</p>
        <ul>
          <li>Use our converters and calculators for personal, educational, or business purposes.</li>
          <li>Share links to our pages with colleagues, classmates, friends, or social-media audiences.</li>
          <li>Reference our content in original work with clear attribution, such as “Source: GMT to EST Converter.”</li>
          <li>Embed links to our tools in blog posts, articles, or websites.</li>
          <li>Print or save pages for your own personal reference.</li>
        </ul>
        <p>Use the site honestly, respectfully, and within the boundaries described below.</p>
      </section>

      <section class="tos-section" id="prohibited-use" aria-labelledby="prohibited-heading">
        <h2 id="prohibited-heading">5. What You May Not Do</h2>
        <p>To protect the website and its visitors, you may not:</p>
        <ul>
          <li>Use the site for an unlawful purpose or in violation of applicable law.</li>
          <li>Interfere with, disrupt, or disable website functionality, performance, security, or servers.</li>
          <li>Introduce viruses, trojans, ransomware, spyware, or other malicious code.</li>
          <li>Attempt unauthorized access to systems, servers, databases, accounts, or networks.</li>
          <li>Use scrapers, bots, crawlers, or harvesting programs to extract substantial portions of our content without prior written permission.</li>
          <li>Reproduce or redistribute original articles, tools, guides, layouts, or branding commercially without permission.</li>
          <li>Misrepresent the source of our content or present our work as your own.</li>
          <li>Use the website to create or spread misinformation, especially where incorrect time information could cause harm.</li>
          <li>Engage in behavior that could expose the site, its partners, or visitors to legal or reputational harm.</li>
        </ul>
        <p>Violations may result in suspension or permanent termination of access. We reserve the right to take appropriate action in serious or willful cases.</p>
      </section>

      <section class="tos-section" id="accuracy" aria-labelledby="accuracy-heading">
        <h2 id="accuracy-heading">6. Accuracy of Our Tools and Content</h2>
        <p>We put real effort into keeping time zone tools and educational content accurate. We review pages to reflect time zone rules, Daylight Saving Time changes, and government decisions that affect global timekeeping.</p>
        <ul>
          <li><strong>Rules can change:</strong> Governments may shift clocks, adopt or abandon DST, or reorganize regional zones. There may be a delay before a new rule is reflected.</li>
          <li><strong>Tools are for general use:</strong> They do not replace professional advice or verified systems for legally binding, financially significant, or safety-critical situations.</li>
          <li><strong>Errors can occur:</strong> If you notice one, <a href="/contact-us/">report the inaccurate conversion</a> so we can investigate.</li>
        </ul>
        <p>For flight bookings, legal filings, surgical procedures, financial transactions, or major international events, verify the result through the responsible governmental, airline, or organizational source. The <a href="https://www.iana.org/time-zones" target="_blank" rel="noopener noreferrer">IANA Time Zone Database</a> is an authoritative technical reference, while our <a href="/disclaimer/">Disclaimer</a> explains the limits of this website.</p>
        <p>Using our tools does not substitute for independent verification in high-stakes situations.</p>
      </section>

      <section class="tos-section" id="intellectual-property" aria-labelledby="ip-heading">
        <h2 id="ip-heading">7. Intellectual Property Rights</h2>
        <p>Original articles, guides, educational materials, tool interfaces, website design, page layouts, branding, logos, and graphics created by GMT to EST Converter are protected under applicable copyright, trademark, and intellectual-property laws.</p>
        <p>You may view content for personal reference, share page links, quote brief passages with clear attribution, and reference our tools in original work.</p>
        <p>You may not:</p>
        <ul>
          <li>Copy, reproduce, or republish substantial portions without written permission.</li>
          <li>Present our content as your own.</li>
          <li>Use our content, tools, or branding commercially without permission or a license.</li>
          <li>Remove or obscure copyright notices, attribution, or branding.</li>
          <li>Create derivative works from original content without permission, except where applicable law permits it.</li>
        </ul>
        <p>For commercial products, curricula, or large-scale distribution, <a href="/contact-us/">request content-use permission</a>.</p>
      </section>

      <section class="tos-section" id="advertising" aria-labelledby="advertising-heading">
        <h2 id="advertising-heading">8. Advertising and Google AdSense</h2>
        <p>GMT to EST Converter is free. To support its operation, maintenance, and continued publication, we display advertisements served through Google AdSense and may use other advertising networks.</p>
        <ul>
          <li>Ads may appear alongside conversion tools or within article pages.</li>
          <li>Advertising providers may use cookies and similar technologies subject to consent choices and applicable law.</li>
          <li>Ads may be personalized or non-personalized depending on location, settings, and consent.</li>
          <li>We do not select each specific advertisement; providers determine ad content through their systems and policies.</li>
        </ul>
        <p>We follow applicable <a href="https://support.google.com/adsense/answer/48182?hl=en" target="_blank" rel="noopener noreferrer">Google AdSense Program policies</a> and may report or block advertisements that do not meet available publisher standards.</p>
        <p>An advertisement does not constitute our endorsement of the advertised product, service, or company. We are not responsible for third-party advertiser claims or practices.</p>
        <h3>Managing Advertising and Analytics Preferences</h3>
        <ul>
          <li>Use <a href="https://adssettings.google.com/" target="_blank" rel="noopener noreferrer">Google Ads Settings</a> to manage ad personalization.</li>
          <li>Install the <a href="https://tools.google.com/dlpage/gaoptout" target="_blank" rel="noopener noreferrer">Google Analytics Opt-out Browser Add-on</a> to limit Analytics measurement on supported websites.</li>
          <li>Use browser settings to limit or block advertising cookies.</li>
        </ul>
        <p>Our <a href="/privacy-policy/">Privacy Policy</a> provides more information about advertising data and cookies.</p>
      </section>

      <section class="tos-section" id="communications" aria-labelledby="communications-heading">
        <h2 id="communications-heading">9. User Communications</h2>
        <p>When you contact us through the website or by email, you agree that:</p>
        <ul>
          <li>Information you provide is accurate and truthful to the best of your knowledge.</li>
          <li>You will not submit abusive, threatening, harassing, defamatory, obscene, fraudulent, or unlawful material.</li>
          <li>You will not use contact channels for spam, unsolicited promotions, or automated messages.</li>
          <li>We may use your message to respond, improve services, or identify and fix website issues.</li>
        </ul>
        <p>Personal information submitted through contact channels is handled according to our <a href="/privacy-policy/">Privacy Policy</a>.</p>
      </section>

      <section class="tos-section" id="third-party-services" aria-labelledby="services-heading">
        <h2 id="services-heading">10. Third-Party Services</h2>
        <p>To operate the website, we may integrate services including:</p>
        <ul>
          <li><strong>Google AdSense</strong> for advertising.</li>
          <li><strong>Google Analytics</strong> for aggregate traffic and usage measurement.</li>
          <li><strong>FormSubmit</strong> for delivering messages submitted through our contact form.</li>
          <li><strong>Hosting providers and content delivery networks</strong> for infrastructure and page delivery.</li>
          <li><strong>Security services</strong> for protection against malicious traffic and attacks.</li>
        </ul>
        <p>Providers operate under their own terms and privacy policies. We are not responsible for third-party practices, content, or reliability. Review the relevant policies before interacting with a third-party service.</p>
      </section>

      <section class="tos-section" id="external-links" aria-labelledby="links-heading">
        <h2 id="links-heading">11. External Links</h2>
        <p>Our website may link to external resources such as government time zone information, world-clock references, service providers, or related articles.</p>
        <p>External links are provided for convenience and information. They do not constitute endorsement of a linked site, its content, operators, products, or policies.</p>
        <p>We do not control external websites and are not responsible for their content, accuracy, privacy practices, security, or availability. When you follow an external link, that site’s own terms and policies govern your interaction.</p>
      </section>

      <section class="tos-section" id="availability" aria-labelledby="availability-heading">
        <h2 id="availability-heading">12. Website Availability and Changes</h2>
        <p>We work to keep GMT to EST Converter available, fast, and functional, but cannot guarantee uninterrupted access. Temporary unavailability may result from:</p>
        <ul>
          <li>Planned maintenance or upgrades</li>
          <li>Security patches and updates</li>
          <li>Unexpected technical failures</li>
          <li>Hosting or infrastructure outages</li>
          <li>Cyberattacks, natural disasters, or events outside our reasonable control</li>
        </ul>
        <p>We may modify or improve tools, add resources, discontinue features that are no longer maintained or accurate, or change the site’s structure and appearance. We will make reasonable efforts to communicate significant planned changes, but urgent maintenance may occur without notice.</p>
      </section>

      <section class="tos-section" id="warranties" aria-labelledby="warranties-heading">
        <h2 id="warranties-heading">13. Disclaimer of Warranties</h2>
        <p>GMT to EST Converter is provided on an <strong>“as is” and “as available”</strong> basis without warranties of any kind, express or implied.</p>
        <p>To the fullest extent permitted by applicable law, we disclaim implied warranties of merchantability, fitness for a particular purpose, and warranties that the website will be uninterrupted, error-free, secure, free from harmful components, or completely accurate and current.</p>
        <p>Time zone tools depend on regulatory data that can change. Although we strive for accuracy, we cannot guarantee that every result is correct at all times or appropriate for every use.</p>
      </section>

      <section class="tos-section" id="liability" aria-labelledby="liability-heading">
        <h2 id="liability-heading">14. Limitation of Liability</h2>
        <p>To the fullest extent permitted by applicable law, GMT to EST Converter, its operators, contributors, and affiliated parties shall not be liable for damages arising from use of or inability to use the website, including:</p>
        <ul>
          <li>Time lost or scheduling errors resulting from a conversion</li>
          <li>Missed flights, meetings, deadlines, or business opportunities</li>
          <li>Costs caused by interruption or unavailability</li>
          <li>Loss of data caused by technical failures or security incidents</li>
          <li>Third-party claims connected with advertisements or external links</li>
        </ul>
        <p>This limitation applies regardless of foreseeability or legal theory, including contract, tort, negligence, or strict liability. Use of the site is at your own risk. Independently verify high-stakes time information through official sources.</p>
      </section>

      <section class="tos-section" id="indemnification" aria-labelledby="indemnification-heading">
        <h2 id="indemnification-heading">15. Indemnification</h2>
        <p>To the extent permitted by applicable law, you agree to indemnify, defend, and hold harmless GMT to EST Converter and its operators from claims, damages, losses, liabilities, costs, or reasonable legal expenses arising from:</p>
        <ul>
          <li>Your use or misuse of the website or tools</li>
          <li>Your violation of these Terms</li>
          <li>Your violation of applicable law</li>
          <li>Your infringement of intellectual-property, privacy, or other third-party rights</li>
          <li>Content you submit through contact channels</li>
        </ul>
        <p>This obligation survives termination where applicable.</p>
      </section>

      <section class="tos-section" id="termination" aria-labelledby="termination-heading">
        <h2 id="termination-heading">16. Termination of Access</h2>
        <p>We may suspend or terminate access if we reasonably believe a visitor has violated these Terms, harmed the website or others, used the platform unlawfully or fraudulently, or attempted to compromise security, systems, or data.</p>
        <p>Termination does not affect rights or obligations that arose previously. Provisions that naturally survive termination—including intellectual-property rights, disclaimers, liability limitations, and indemnification—continue to apply.</p>
      </section>

      <section class="tos-section" id="governing-law" aria-labelledby="law-heading">
        <h2 id="law-heading">17. Governing Law and Disputes</h2>
        <p>These Terms are governed and interpreted according to applicable laws, without regard to conflict-of-law principles.</p>
        <p>If a dispute arises, we encourage you to <a href="/contact-us/">contact us first</a>. We aim to resolve concerns fairly and reasonably without formal proceedings.</p>
        <p>If a dispute cannot be resolved informally, it is subject to the jurisdiction of courts applicable to the location from which this website is operated, unless consumer-protection law requires another jurisdiction.</p>
      </section>

      <section class="tos-section" id="changes" aria-labelledby="changes-heading">
        <h2 id="changes-heading">18. Changes to These Terms</h2>
        <p>We may revise these Terms as services grow, laws change, or practices evolve. When changes are made, the “Last updated” date will be revised and material changes will be reflected in the text.</p>
        <p>Review this page periodically. Continued use after changes are posted constitutes acceptance of the revised Terms. If you disagree, discontinue use of the site.</p>
      </section>

      <section class="tos-section" id="severability" aria-labelledby="severability-heading">
        <h2 id="severability-heading">19. Severability</h2>
        <p>If a provision is found unenforceable or invalid, it will be modified to the minimum extent necessary to make it enforceable or, if that is not possible, severed. Remaining provisions continue in full force and effect.</p>
      </section>

      <section class="tos-section" id="entire-agreement" aria-labelledby="agreement-heading">
        <h2 id="agreement-heading">20. Entire Agreement</h2>
        <p>These Terms, together with our <a href="/privacy-policy/">Privacy Policy</a> and other published policies, constitute the agreement between you and GMT to EST Converter regarding website use. They supersede prior understandings or representations about that use.</p>
      </section>

      <section class="tos-section" id="related-policies" aria-labelledby="policies-heading">
        <h2 id="policies-heading">21. Related Policies</h2>
        <p>These Terms work with other documents and resources:</p>
        <nav aria-label="Related website policies">
          <ul class="related-links">
            <li><a href="/privacy-policy/">Privacy Policy</a><span>How information is collected, used, and protected.</span></li>
            <li><a href="/disclaimer/">Disclaimer</a><span>Accuracy limits and independent-verification guidance.</span></li>
            <li><a href="/about-us/">About Us</a><span>Who we are and why we built the platform.</span></li>
            <li><a href="/contact-us/">Contact Us</a><span>How to send questions, reports, or concerns.</span></li>
          </ul>
        </nav>
      </section>

      <section class="tos-section tos-contact" id="contact-terms" aria-labelledby="contact-heading">
        <h2 id="contact-heading">22. Contact Us</h2>
        <p>If you have a question, concern, or comment about these Terms, please use our <a href="/contact-us/">Contact Us page</a> or email <a href="mailto:gmttoest@gmail.com">gmttoest@gmail.com</a>.</p>
        <p>We would rather answer your question than have you leave with unresolved concerns.</p>
      </section>

      <footer class="tos-note">
        <h2>A Note From Our Team</h2>
        <p>We built GMT to EST Converter because a simple, accurate, free time zone tool should be available to everyone.</p>
        <p>These Terms are not here to intimidate or confuse. They set clear expectations, protect honest users, and help maintain a website people can trust. We hold ourselves to the same standards we ask of visitors: be accurate, fair, and transparent.</p>
        <p>Thank you for using GMT to EST Converter. We appreciate every visit.</p>
        <p><strong>The GMT to EST Converter Team</strong></p>
      </footer>
    </div>
  </article>
</BaseLayout>

<style>
  .tos-page {
    max-width: 880px;
    margin: 0 auto;
    padding: 3rem 1.5rem 5rem;
  }
  .tos-header {
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--line);
  }
  .tos-eyebrow {
    display: inline-block;
    margin-bottom: .75rem;
    color: var(--accent);
    font-size: .78rem;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .tos-header h1 {
    margin: 0 0 .75rem;
    color: var(--text);
    font-size: clamp(2rem, 5vw, 3.25rem);
    line-height: 1.08;
  }
  .tos-meta { margin: 0 0 2rem; color: var(--muted); font-size: .875rem; }
  .tos-intro {
    padding: clamp(22px, 4vw, 32px);
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--panel);
  }
  .tos-intro h2 { margin: 0 0 1rem; color: var(--text); font-size: 1.35rem; }
  .tos-intro p, .tos-section p, .tos-note p {
    margin: 0 0 1rem;
    color: var(--muted);
    font-size: .975rem;
    line-height: 1.75;
  }
  .tos-intro p:last-child, .tos-section p:last-child, .tos-note p:last-child { margin-bottom: 0; }
  .tos-page a { color: var(--accent); text-underline-offset: 3px; }
  .tos-page strong { color: var(--text); }
  .tos-toc {
    margin-bottom: 1rem;
    padding: 26px 30px;
    border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--line));
    border-left: 4px solid var(--accent);
    border-radius: 0 12px 12px 0;
    background: color-mix(in srgb, var(--accent) 8%, var(--panel));
  }
  .tos-toc h2 {
    margin: 0 0 14px;
    color: var(--text);
    font-size: 1rem;
    letter-spacing: .06em;
    text-transform: uppercase;
  }
  .tos-toc ol {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 7px 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tos-toc a { font-size: .9rem; line-height: 1.45; }
  .tos-section {
    padding: 2.25rem 0;
    border-bottom: 1px solid var(--line);
  }
  .tos-section h2 {
    display: flex;
    gap: .65rem;
    align-items: flex-start;
    margin: 0 0 1rem;
    color: var(--text);
    font-size: clamp(1.2rem, 3vw, 1.5rem);
    line-height: 1.3;
  }
  .tos-section h2::before {
    flex: 0 0 4px;
    width: 4px;
    height: 1.4rem;
    margin-top: .1rem;
    border-radius: 2px;
    background: var(--accent);
    content: "";
  }
  .tos-section h3 { margin: 1.5rem 0 .75rem; color: var(--text); font-size: 1.05rem; }
  .tos-section ul {
    display: grid;
    gap: .55rem;
    margin: .75rem 0 1rem;
    padding-left: 1.4rem;
  }
  .tos-section li { color: var(--muted); font-size: .975rem; line-height: 1.65; }
  .related-links {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    padding: 0 !important;
    list-style: none;
  }
  .related-links li {
    display: grid;
    gap: .35rem;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: 9px;
    background: var(--panel);
  }
  .related-links a { font-weight: 750; }
