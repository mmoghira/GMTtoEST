---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import { getLang, getPageMeta, getTranslation, siteUrl } from "theme/i18n/config";

const lang = "ar";
const dir = "rtl";
const slug = "about-us";
const t = getTranslation(lang);

const seoTitle = "من نحن | محول GMT إلى EST";
const pageDescription = "تعرف على موقعنا وفريق التحرير المتخصص لمحول GMT إلى EST ورسالتنا لتسهيل حساب فروق التوقيت والمناطق الزمنية بدقة تامة وموثوقية.";

const canonical = `${siteUrl}/ar/about-us/`;

// JSON-LD Schema definitions for AboutPage in Arabic
const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "@id": `${canonical}#webpage`,
    "url": canonical,
    "name": seoTitle,
    "description": pageDescription,
    "inLanguage": lang,
    "isPartOf": {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      "url": siteUrl,
      "name": "GMT to EST Converter"
    },
    "about": {
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      "name": "GMT to EST Converter",
      "url": siteUrl,
      "logo": `${siteUrl}/assets/logo.png`,
      "email": "contact@gmttoestconverter.com",
      "description": "منصة مجانية ومستقلة لتحويل المناطق الزمنية وحساب الفوارق بين توقيت غرينتش والتوقيت الشرقي للولايات المتحدة وكندا.",
      "foundingDate": "2024"
    },
    "breadcrumb": {
      "@id": `${canonical}#breadcrumb`
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${canonical}#breadcrumb`,
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "الرئيسية",
        "item": `${siteUrl}/ar/`
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "من نحن",
        "item": canonical
      }
    ]
  }
];
---

<BaseLayout
  lang={lang}
  dir={dir}
  title={seoTitle}
  description={pageDescription}
  slug={slug}
  enableFaqSchema={false}
  allowAds={true}
  breadcrumbHomeLabel="الرئيسية"
  breadcrumbLabel="من نحن"
>

<!-- Inject additional JSON-LD Schemas -->
<script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

<section class="content reveal" style="direction: rtl; text-align: right; padding: 20px; max-width: 900px; margin: 0 auto; line-height: 1.8;">
  
  <h1 style="color: var(--accent); margin-bottom: 24px; font-size: 2.2em; border-bottom: 2px solid var(--line); padding-bottom: 12px;">من نحن ومهمتنا المعرفية</h1>
  
  <p style="font-size: 1.1em; color: var(--text); margin-bottom: 20px;">
    مرحباً بكم في منصة <strong>محول GMT إلى EST</strong>، وجهتكم الأولى والأكثر موثوقية لفهم فروق التوقيت وإدارة المناطق الزمنية حول العالم. نحن منصة معرفية مستقلة تهدف لتبسيط العقبات المرتبطة بجدولة المواعيد وتنسيق العمليات التجارية عبر الحدود الجغرافية، مع التركيز بشكل خاص على الفوارق بين التوقيت العالمي المنسق وخطوط التوقيت الشرقي لأمريكا الشمالية.
  </p>

  <!-- 1. مقدمة عامة ورسالتنا -->
  <h2 style="color: var(--accent-2); margin-top: 32px; margin-bottom: 16px;">1. مقدمة عامة ورسالتنا (Our Mission)</h2>
  <p style="color: var(--muted); margin-bottom: 16px;">
    تتلخص رسالتنا الأساسية في توفير أداة حسابية سهلة الاستخدام ومقالات تثقيفية عميقة تقدم حلولاً واقعية لمشكلات التوقيت اليومية. نحن نؤمن بأن العالم الرقمي الحديث قد أزال الحدود المادية بين الدول، ولكن تظل فروق التوقيت واحدة من آخر التحديات الكبرى التي تواجه رواد الأعمال الرقميين والموظفين المستقلين والشركات الموزعة. نسعى لأن نكون المرجع الذي يمنع الأخطاء التنظيمية ويضمن الحفاظ على سير العمليات اليومية بسلاسة تامة.
  </p>

  <!-- 2. لماذا نهتم بالمнаطق الزمنية؟ -->
  <h2 style="color: var(--accent-2); margin-top: 32px; margin-bottom: 16px;">2. لماذا نهتم بالمناطق الزمنية؟ (Why Time Zones Matter)</h2>
  <p style="color: var(--muted); margin-bottom: 16px;">
    المناطق الزمنية ليست مجرد خطوط جغرافية وهمية على الخريطة، بل هي ركائز أساسية تدير حياة مليارات البشر يومياً. من إقلاع رحلات الطيران الدولية وتنظيم جداول المعاملات البنكية العابرة للقارات، إلى متابعة البث المباشر للفعاليات وإجراء مقابلات العمل؛ يعتمد كل ذلك على الفهم الصحيح والدقيق للوقت. إن أي خطأ طفيف بمقدار ساعة واحدة بسبب سوء فهم الفروق الموسمية قد يتسبب في خسائر مالية أو إلغاء صفقات تجارية هامة.
  </p>

  <!-- 3. منهجيتنا ودقة التحويل -->
  <h2 style="color: var(--accent-2); margin-top: 32px; margin-bottom: 16px;">3. منهجيتنا ودقة التحويل (Our Methodology)</h2>
  <p style="color: var(--muted); margin-bottom: 16px;">
    نتبع في تطوير أدوات التحويل البرمجية لدينا معايير تقنية صارمة لضمان موثوقية كل نتيجة يراها المستخدم. يقوم المحول الخاص بنا بعمليات الحساب استناداً إلى أحدث قواعد البيانات الجغرافية وبمزامنة مباشرة مع الخوادم الزمنية القياسية. عندما يختار المستخدم تاريخاً معيناً، يبحث النظام بشكل تلقائي في سجلات التحول الموسمي للتأكد مما إذا كانت المنطقة المطلوبة تقع تحت وطأة التوقيت الصيفي أو الشتوي في ذلك التاريخ المحدد.
  </p>

  <!-- 4. أهمية دمج قاعدة بيانات IANA -->
  <h2 style="color: var(--accent-2); margin-top: 32px; margin-bottom: 16px;">4. أهمية دمج قاعدة بيانات IANA (IANA Database Integration)</h2>
  <p style="color: var(--muted); margin-bottom: 16px;">
    للحفاظ على جودة خالية من العيوب، يتم تحديث موقعنا تلقائياً ليعكس التحديثات الصادرة عن الهيئة الدولية لأرقام الإنترنت المخصصة (IANA). هذه القاعدة تعد المعيار الذهبي المعتمد من قبل كبرى الشركات التكنولوجية وأنظمة التشغيل مثل لينكس وويندوز لتتبع التغيرات السياسية والجغرافية التي تطرأ على توقيت الدول والمقاطعات.
  </p>

  <!-- 5. التوقيت الصيفي وعقبات الجدولة العالمية -->
  <h2 style="color: var(--accent-2); margin-top: 32px; margin-bottom: 16px;">5. التوقيت الصيفي وعقبات الجدولة (Daylight Saving Time)</h2>
  <p style="color: var(--muted); margin-bottom: 16px;">
    التوقيت الصيفي (DST) يمثل التحدي الأكبر عند حساب الفروق الزمنية، نظراً لأن مواعيد بدء وانهاء العمل بالتوقيت الصيفي تختلف من قارة إلى أخرى، بل وقد تلغيه بعض الدول تماماً بينما تستمر دول أخرى في تطبيقه. نحن نوضح للمستخدمين الفروق الجوهرية بين التوقيت الصيفي الشرقي (EDT - UTC-4) والتوقيت القياسي الشرقي (EST - UTC-5)، ونبين كيف يؤدي ذلك لتغيير الفجوة الزمنية مع غرينتش من 5 ساعات في الشتاء إلى 4 ساعات في الصيف.
  </p>

  <!-- 6. الفئات المستهدفة بخدماتنا -->
  <h2 style="color: var(--accent-2); margin-top: 32px; margin-bottom: 16px;">6. الفئات المستهدفة بخدماتنا (Target Audience)</h2>
  <p style="color: var(--muted); margin-bottom: 16px;">
    نحن فخورون بتقديم خدماتنا لشريحة واسعة ومتنوعة من المستخدمين حول العالم، والذين يعتمدون علينا لتسيير أعمالهم اليومية:
  </p>
  
  <div style="margin-right: 20px; border-right: 3px solid var(--accent); padding-right: 15px; margin-bottom: 20px;">
    <h3 style="color: var(--text); margin-bottom: 8px;">الشركات والفرق الموزعة عالمياً</h3>
    <p style="color: var(--muted); font-size: 0.95em; margin-bottom: 12px;">
      نساعد مديري المشاريع على جدولة اجتماعات دورية تتوافق مع ساعات العمل الرسمية لجميع الموظفين المقيمين في مناطق زمنية متباعدة، مما يضمن أقصى إنتاجية دون إرهاق أي طرف.
    </p>

    <h3 style="color: var(--text); margin-bottom: 8px;">العاملين المستقلين والمطورين</h3>
    <p style="color: var(--muted); font-size: 0.95em; margin-bottom: 12px;">
      يستخدم المستقلون الذين يقدمون خدماتهم لعملاء في الولايات المتحدة أو كندا موقعنا لتنظيم تسليم المهام والرد على الرسائل في الفترات التي تنشط فيها مكاتب عملائهم.
    </p>

    <h3 style="color: var(--text); margin-bottom: 8px;">المسافرين ومنظمي الرحلات الجوية</h3>
    <p style="color: var(--muted); font-size: 0.95em; margin-bottom: 12px;">
      نوفر للمسافرين وسيلة سريعة للتحقق من أوقات الهبوط والإقلاع المحلية وتجنب الارتباك الذي يصاحب السفر الطويل عبر القارات.
    </p>

    <h3 style="color: var(--text); margin-bottom: 8px;">الطلاب ومتابعي المؤتمرات الرقمية</h3>
    <p style="color: var(--muted); font-size: 0.95em;">
      نضمن لطلاب التعليم عن بعد ومتابعي الندوات الافتراضية العالمية عدم تفويت أي محاضرة أو اختبار دولي بسبب حسابات التوقيت الخاطئة.
    </p>
  </div>

  <!-- 7. التزامنا بتطبيق معايير E-E-A-T وجودة المحتوى -->
  <h2 style="color: var(--accent-2); margin-top: 32px; margin-bottom: 16px;">7. التزامنا بتطبيق معايير E-E-A-T (Quality Commitment)</h2>
  <p style="color: var(--muted); margin-bottom: 16px;">
    نحن ندرك جيداً أهمية تقديم معلومات دقيقة في بيئة الإنترنت الحالية التي تعج بالمحتوى المكرر والترجمات الآلية الرديئة. لهذا السبب، يلتزم موقعنا بمعايير جوجل لتجربة وموثوقية المحتوى (E-E-A-T):
  </p>
  <ul style="margin: 12px 0; padding-right: 20px; list-style-type: square; color: var(--muted);">
    <li><strong>التخصص:</strong> ينصب تركيزنا التام والكامل على دراسة وشرح فروق التوقيت والمناطق الزمنية فقط، مما يجعلنا مرجعاً متخصصاً.</li>
    <li><strong>الخبرة البشرية:</strong> تُكتب مقالاتنا وتُصمم شروحاتنا بأيدي محررين ملمين بعلم الخرائط والتقسيمات الزمنية الدولية.</li>
    <li><strong>المصداقية:</strong> نعتمد دائماً على المراجع الرسمية مثل الهيئات الفلكية وقواعد بيانات الوقت العالمية لتأكيد الأرقام والجداول الزمنية المتاحة.</li>
  </ul>

  <!-- 8. فريق العمل والتحرير -->
  <h2 style="color: var(--accent-2); margin-top: 32px; margin-bottom: 16px;">8. فريق العمل والتحرير (Editorial & Review Team)</h2>
  <p style="color: var(--muted); margin-bottom: 16px;">
    يتكون فريق العمل لدينا من نخبة من المحررين والمبرمجين المتخصصين في تطوير خدمات الويب الجغرافية وتصميم واجهات تفاعلية مريحة تلبي احتياجات الزوار بسرعة وكفاءة عالية.
  </p>
  <h3 style="color: var(--text); margin-bottom: 8px;">الأستاذة دجيكي بروس ومراجعة المحتوى</h3>
  <p style="color: var(--muted); margin-bottom: 16px;">
    تتولى الأستاذة <strong>دجيكي بروس</strong> (المتخصصة في شؤون التوقيت العالمي وجودة المحتوى) مهمة المراجعة الدورية والتدقيق والاعتماد لكافة المواد التوضيحية المتاحة على صفحات الموقع، لضمان اتساقها وخلوها من الأخطاء وتقديمها بلغة تناسب كافة فئات المستخدمين.
  </p>

  <!-- 9. الأهداف المستقبلية والتطوير المستمر -->
  <h2 style="color: var(--accent-2); margin-top: 32px; margin-bottom: 16px;">9. الأهداف المستقبلية والتطوير المستمر (Future Goals)</h2>
  <p style="color: var(--muted); margin-bottom: 16px;">
    نعمل باستمرار على تطوير أدواتنا الحسابية لتشمل المزيد من الميزات التفاعلية، مثل منبهات البريد الإلكتروني للمواعيد العالمية، وجداول الإكسل القابلة للتحميل، والتطبيقات المصغرة التي يمكن للمطورين تضمينها في مواقعهم لمساعدتهم على تسيير مشروعاتهم بسلاسة.
  </p>

  <!-- 10. الشفافية والسياسات المتبعة -->
  <h2 style="color: var(--accent-2); margin-top: 32px; margin-bottom: 16px;">10. الشفافية والسياسات المتبعة (Transparency & Policies)</h2>
  <p style="color: var(--muted); margin-bottom: 16px;">
    نحن نحافظ على سياسات واضحة تماماً فيما يتعلق ببيانات المستخدمين والإعلانات المعتمدة على صفحاتنا. لمزيد من التفاصيل حول كيفية استخدامنا لملفات تعريف الارتباط أو حدود المسؤولية المتبادلة، يُرجى زيارة صفحة <a href="/privacy-policy/" style="color: var(--accent); text-decoration: underline;">سياسة الخصوصية</a> وصفحة <a href="/ar/disclaimer/" style="color: var(--accent); text-decoration: underline;">إخلاء المسؤولية</a> القانونية.
  </p>

  <!-- 11. تواصل معنا وقنوات الدعم -->
  <h2 style="color: var(--accent-2); margin-top: 32px; margin-bottom: 16px;">11. تواصل معنا وقنوات الدعم (Contact Us)</h2>
  <p style="color: var(--muted); margin-bottom: 16px;">
    نحن نرحب دائماً بالاقتراحات والتقارير المتعلقة بالأخطاء البرمجية أو اللغوية من قرائنا الأعزاء. إذا كانت لديكم أي فكرة تودون مشاركتها معنا لتطوير الموقع، أو رغبة في الإبلاغ عن مشكلة فنية واجهتكم، يُرجى عدم التردد في التواصل مع فريق العمل مباشرة من خلال تعبئة النموذج المتوفر في صفحة <a href="/contact-us/" style="color: var(--accent); text-decoration: underline;">اتصل بنا</a>. نقرأ كافة رسائلكم ونسعى للرد عليها في أقرب وقت ممكن.
  </p>

  <p style="font-size: 0.9em; color: var(--muted); margin-top: 24px; border-top: 1px solid var(--line); padding-top: 12px;">
    آخر تحديث لهذه الصفحة: أكتوبر 2026 | تمت المراجعة والتدقيق بواسطة دجيكي بروس
  </p>

  <!-- روابط داخلية عربية -->
  <div style="margin-top: 32px; padding: 16px; background: var(--panel); border: 1px solid var(--line); border-radius: 8px;">
    <h3 style="color: var(--accent); margin-bottom: 12px;">روابط قانونية ومعلوماتية</h3>
    <ul style="list-style: none; padding: 0; display: flex; gap: 16px; flex-wrap: wrap;">
      <li><a href="/ar/" style="color: var(--accent-2); text-decoration: underline;">الرئيسية</a></li>
      <li><a href="/ar/disclaimer/" style="color: var(--accent-2); text-decoration: underline;">إخلاء المسؤولية</a></li>
      <li><a href="/privacy-policy/" style="color: var(--accent-2); text-decoration: underline;">سياسة الخصوصية</a></li>
      <li><a href="/terms-of-service/" style="color: var(--accent-2); text-decoration: underline;">شروط الخدمة</a></li>
      <li><a href="/editorial-policy/" style="color: var(--accent-2); text-decoration: underline;">السياسة التحريرية</a></li>
      <li><a href="/contact-us/" style="color: var(--accent-2); text-decoration: underline;">اتصل بنا</a></li>
    </ul>
  </div>

</section>

</BaseLayout>
