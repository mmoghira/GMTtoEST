---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import { getLang, getPageMeta, getTranslation, siteUrl } from "theme/i18n/config";

const lang = "ar";
const dir = "rtl";
const slug = "disclaimer";
const t = getTranslation(lang);

const seoTitle = "إخلاء المسؤولية | محول GMT إلى EST";
const pageDescription = "إخلاء المسؤولية والشروط القانونية لمحول GMT إلى EST. اقرأ عن حدود دقة تحويلات المناطق الزمنية والتوقيت الصيفي، وسياسة الإعلانات والروابط الخارجية.";

const canonical = `${siteUrl}/ar/disclaimer/`;

// JSON-LD Schema definitions in Arabic
const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${canonical}#webpage`,
    "url": canonical,
    "name": seoTitle,
    "description": pageDescription,
    "inLanguage": lang,
    "isPartOf": {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      "url": siteUrl,
      "name": "GMT to EST Converter"
    },
    "breadcrumb": {
      "@id": `${canonical}#breadcrumb`
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${canonical}#breadcrumb`,
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "الرئيسية",
        "item": `${siteUrl}/ar/`
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "إخلاء المسؤولية",
        "item": canonical
      }
    ]
  }
];
---

<BaseLayout
  lang={lang}
  dir={dir}
  title={seoTitle}
  description={pageDescription}
  slug={slug}
  enableFaqSchema={false}
  allowAds={false}
  breadcrumbHomeLabel="الرئيسية"
  breadcrumbLabel="إخلاء المسؤولية"
>

<!-- Inject additional JSON-LD Schemas -->
<script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

<section class="content reveal" style="direction: rtl; text-align: right; padding: 20px; max-width: 900px; margin: 0 auto; line-height: 1.8;">
  
  <h1 style="color: var(--accent); margin-bottom: 24px; font-size: 2.2em; border-bottom: 2px solid var(--line); padding-bottom: 12px;">إخلاء المسؤولية القانونية</h1>
  
  <p style="font-size: 1.1em; color: var(--text); margin-bottom: 20px;">
    مرحباً بكم في صفحة إخلاء المسؤولية الخاصة بموقع <strong>محول GMT إلى EST</strong>. تم إعداد هذه الوثيقة القانونية لتوضيح الحدود والشروط الحاكمة لاستخدام الخدمات والأدوات والمعلومات المقدمة عبر موقعنا الإلكتروني. يُرجى قراءة هذه الصفحة بعناية قبل استخدام المحول أو الاعتماد على الجداول الزمنية المدرجة فيه. إن استخدامك للموقع يمثل موافقة صريحة على البنود والشروط الواردة في هذا المستند.
  </p>

  <!-- 1. إخلاء المسؤولية العام -->
  <h2 style="color: var(--accent-2); margin-top: 32px; margin-bottom: 16px;">1. إخلاء المسؤولية العام (General Disclaimer)</h2>
  <p style="color: var(--muted); margin-bottom: 16px;">
    إن كافة المعلومات والأدوات والخدمات المتاحة على هذا الموقع الإلكتروني تُقدم «كما هي» و«كما تتوفر»، دون أي ضمانات من أي نوع، سواء كانت صريحة أو ضمنية. نحن لا نمثل جهة حكومية أو هيئة دولية رسمية مسؤولة عن قياس الوقت، بل نحن منصة مستقلة توفر خدمات تحويل المناطق الزمنية لتسهيل التواصل والتنسيق بين الأفراد والشركات على نطاق عالمي.
  </p>

  <!-- 2. دقة المعلومات والبيانات -->
  <h2 style="color: var(--accent-2); margin-top: 32px; margin-bottom: 16px;">2. دقة المعلومات والبيانات (Accuracy of Information)</h2>
  <p style="color: var(--muted); margin-bottom: 16px;">
    يبذل فريق التحرير لدينا أقصى جهوده لضمان أن تكون كافة الشروحات اللغوية والتوضيحات الحسابية والمقالات المكتوبة دقيقة وحديثة ومفيدة للمستخدمين. ومع ذلك، لا نضمن خلو الموقع تماماً من الأخطاء التحريرية أو المطبعية أو الحسابية الطفيفة التي قد تقع أثناء إدخال البيانات أو معالجة النصوص. يقع على عاتق المستخدم دائماً مراجعة المواعيد الحاسمة عبر مصادر متعددة للتأكد من مطابقتها التامة.
  </p>

  <!-- 3. دقة تحويلات المناطق الزمنية والتقلبات الموسمية -->
  <h2 style="color: var(--accent-2); margin-top: 32px; margin-bottom: 16px;">3. دقة تحويلات المناطق الزمنية والتوقيت الصيفي (Time Zone Conversion Accuracy)</h2>
  <p style="color: var(--muted); margin-bottom: 16px;">
    يعتمد محول الوقت في نظامنا البرمجي على قواعد بيانات معترف بها عالمياً، وفي مقدمتها قاعدة بيانات الهيئة الدولية لأرقام الإنترنت المخصصة (IANA). تضمن هذه القاعدة الحفاظ على تحديثات مستمرة لرموز المناطق والتوقيت الصيفي (DST).
  </p>
  <p style="color: var(--muted); margin-bottom: 16px;">
    على الرغم من ذلك، قد تظهر اختلافات طفيفة في حساب الوقت نتيجة للتغييرات المفاجئة التي قد تقرها الحكومات المحلية في بعض الدول دون إشعار مسبق كافٍ، أو بسبب الفوارق الزمنية البسيطة في أوقات تفعيل التوقيت الصيفي بين دول مثل الولايات المتحدة والمملكة المتحدة. وبناءً على ذلك، لا يتحمل الموقع مسؤولية أي تحويل غير دقيق قد ينتج عن هذه التغيرات الطارئة في السياسات المحلية للمناطق الزمنية.
  </p>

  <!-- 4. الغرض التعليمي والارشادي للموقع -->
  <h2 style="color: var(--accent-2); margin-top: 32px; margin-bottom: 16px;">4. الغرض التعليمي والإرشادي للموقع (Educational Purpose)</h2>
  <p style="color: var(--muted); margin-bottom: 16px;">
    إن الهدف الرئيسي من إنشاء هذا الموقع والمقالات التوضيحية المدرجة فيه هو تقديم شروحات إرشادية وتعليمية لمساعدة المستخدمين على فهم الأنظمة المعقدة للمناطق الزمنية. إن المحتوى المكتوب لا يهدف إلى إيجاد مرجعية علمية مطلقة، بل يسعى لتبسيط الفوارق بين المصطلحات والمفاهيم الجغرافية المعقدة مثل خطوط الطول والتوقيت الفلكي الشمسي والتوقيت الذري القياسي لجمهور واسع من متصفحي الإنترنت.
  </p>

  <!-- 5. عدم تقديم مشورة مهنية أو قانونية أو مالية -->
  <h2 style="color: var(--accent-2); margin-top: 32px; margin-bottom: 16px;">5. عدم تقديم مشورة مهنية أو قانونية أو مالية (No Professional Advice)</h2>
  <p style="color: var(--muted); margin-bottom: 16px;">
    إن محتوى هذا الموقع لا يجب اعتباره بأي حال من الأحوال بمثابة مشورة مالية أو قانونية أو مهنية. إذا كنت تقوم بتنسيق صفقات تجارية حساسة، أو تتداول في أسواق الأسهم والعملات الرقمية التي تتأثر بالدقيقة والثانية، أو تنسق مواعيد قانونية ومحاكمات رسمية، فلا يجب عليك الاعتماد الحصري على هذا المحول. يُرجى مراجعة الساعات الرسمية المعتمدة للمؤسسات المالية المعنية مباشرة لضمان سلامة العمليات التجارية والاستثمارية الخاصة بك.
  </p>

  <!-- 6. إخلاء مسؤولية الروابط الخارجية والمصادر المستقلة -->
  <h2 style="color: var(--accent-2); margin-top: 32px; margin-bottom: 16px;">6. إخلاء مسؤولية الروابط الخارجية (External Links Disclaimer)</h2>
  <p style="color: var(--muted); margin-bottom: 16px;">
    قد يحتوي موقعنا على روابط تشعبية توجه المستخدمين إلى مواقع خارجية مستقلة لا تخضع لإشرافنا أو إدارتنا. نحن نوفر هذه الروابط لزيادة الفائدة المعرفية وتوفير مراجع إضافية موثوقة فقط. لا يتحمل الموقع أي مسؤولية عن محتوى هذه المواقع الخارجية، أو دقة المعلومات المنشورة فيها، أو سياسات الخصوصية وشروط الاستخدام المعتمدة لديها. إن تصفحك لأي موقع خارجي يقع تماماً تحت مسؤوليتك الخاصة.
  </p>

  <!-- 7. محتوى وإعلانات الأطراف الثالثة -->
  <h2 style="color: var(--accent-2); margin-top: 32px; margin-bottom: 16px;">7. محتوى الأطراف الثالثة (Third Party Content)</h2>
  <p style="color: var(--muted); margin-bottom: 16px;">
    قد يتم عرض محتوى أو تعليقات أو تحليلات مقدمة من جهات خارجية أو أفراد مستقلين على صفحات موقعنا. إن الآراء الواردة في هذا المحتوى تعبر فقط عن وجهة نظر أصحابها ولا تعكس بالضرورة رأي إدارة الموقع أو توجهاتها الرسمية. نحن لا نتحقق بشكل مستقل من صحة كافة الادعاءات الواردة في مشاركات الأطراف الثالثة.
  </p>

  <!-- 8. إخلاء المسؤولية الإعلانية وبرنامج جوجل أدسنس -->
  <h2 style="color: var(--accent-2); margin-top: 32px; margin-bottom: 16px;">8. إعلان جوجل أدسنس وإخلاء المسؤولية الإعلانية (Google AdSense Disclaimer)</h2>
  <p style="color: var(--muted); margin-bottom: 16px;">
    يستخدم موقعنا نظام إعلانات جوجل أدسنس (Google AdSense) لعرض الإعلانات التجارية المخصصة للمستخدمين بناءً على اهتماماتهم وتصفحهم السابق. إن ظهور أي إعلان لمنتج أو خدمة على منصتنا لا يعني بأي حال من الأحوال مصادقة أو توصية من إدارة الموقع بهذا المنتج أو الخدمة. يقع على عاتق المستخدم التحقق التام من مصداقية المعلنين وجودة الخدمات قبل إتمام أي عمليات شراء أو إدخال بيانات حساسة على المواقع الإعلانية.
  </p>

  <!-- 9. إفصاح التسويق بالعمولة والإيرادات -->
  <h2 style="color: var(--accent-2); margin-top: 32px; margin-bottom: 16px;">9. إفصاح التسويق بالعمولة (Affiliate Disclosure)</h2>
  <p style="color: var(--muted); margin-bottom: 16px;">
    لتغطية تكاليف تشغيل الخوادم وصيانة الموقع، قد نشارك في بعض برامج التسويق بالعمولة. هذا يعني أننا قد نحصل على عمولة مالية بسيطة عند قيامك بالنقر على بعض الروابط المتاحة في المقالات وإتمام عمليات شراء للمنتجات الموصى بها. نؤكد دائماً أننا لا نوصي إلا بالخدمات والأدوات التي نعتقد أنها تقدم قيمة حقيقية للمستخدمين، وأن هذه العمولات لا تؤثر مطلقاً على نزاهة وموضوعية التقييمات والشروحات التي نقدمها.
  </p>

  <!-- 10. حقوق الطبع والنشر والملكية الفكرية لحقوق الطبع -->
  <h2 style="color: var(--accent-2); margin-top: 32px; margin-bottom: 16px;">10. حقوق الطبع والنشر والملكية الفكرية (Copyright Notice)</h2>
  <p style="color: var(--muted); margin-bottom: 16px;">
    إن كافة المواد المنشورة على هذا الموقع، بما في ذلك النصوص البرمجية، والتصاميم الرسومية، والرسوم البيانية بصيغة SVG، والمقالات والشروحات المكتوبة، محمية بموجب قوانين حقوق الملكية الفكرية الدولية وحقوق الطبع والنشر. يُمنع منعاً باتاً نسخ أو إعادة نشر أو توزيع أي جزء من هذا الموقع على منصات أخرى دون الحصول على إذن كتابي مسبق وصريح من إدارة الموقع.
  </p>

  <!-- 11. الملكية الفكرية والعلامات التجارية -->
  <h2 style="color: var(--accent-2); margin-top: 32px; margin-bottom: 16px;">11. الملكية الفكرية (Intellectual Property)</h2>
  <p style="color: var(--muted); margin-bottom: 16px;">
    العلامات التجارية والأسماء التجارية واللوجو الخاص بموقع <strong>محول GMT إلى EST</strong> هي ملك خاص وحصري للشركة المالكة. إن استخدام هذه العلامات لأغراض تجارية دون موافقة يعرض المخالف للملاحقة القانونية وفقاً للقوانين المعتمدة لحماية العلامات التجارية والملكية الفكرية.
  </p>

  <!-- 12. سياسة الاستخدام العادل للمواد والمعلومات -->
  <h2 style="color: var(--accent-2); margin-top: 32px; margin-bottom: 16px;">12. الاستخدام العادل (Fair Use)</h2>
  <p style="color: var(--muted); margin-bottom: 16px;">
    يجوز للمؤسسات التعليمية والأكاديميين والباحثين استخدام أجزاء محدودة من الشروحات والمعلومات المتاحة في موقعنا لأغراض علمية وغير تجارية، بشرط الإشارة الصريحة والواضحة لاسم الموقع ووضع رابط تشعبي نشط يوجه إلى الصفحة الأصلية كمصدر للمعلومات، وذلك تماشياً مع مبادئ الاستخدام العادل.
  </p>

  <!-- 13. تحديد المسؤولية القانونية وحقوق التعويض -->
  <h2 style="color: var(--accent-2); margin-top: 32px; margin-bottom: 16px;">13. تحديد المسؤولية القانونية (Limitation of Liability)</h2>
  <p style="color: var(--muted); margin-bottom: 16px;">
    بموجب الحد الأقصى الذي يسمح به القانون المعمول به، لا يتحمل مالكو ومطورو ومحررو موقع <strong>محول GMT إلى EST</strong> المسؤولية القانونية عن أي أضرار مباشرة أو غير مباشرة، أو خاصة، أو تبعية، أو عرضية قد تنجم عن استخدام أو عدم القدرة على استخدام الموقع وأدوات التحويل الخاصة به. يشمل ذلك، على سبيل المثال لا الحصر، خسارة الأرباح المالية، أو فوات الفرص التجارية، أو اضطراب الأعمال، أو ضياع البيانات، حتى لو تم إخطار الموقع بإمكانية حدوث مثل هذه الأضرار مسبقاً.
  </p>

  <!-- 14. مسؤولية المستخدم الفردية والتحقق الذاتي -->
  <h2 style="color: var(--accent-2); margin-top: 32px; margin-bottom: 16px;">14. مسؤولية المستخدم (User Responsibility)</h2>
  <p style="color: var(--muted); margin-bottom: 16px;">
    تعتبر مسؤولية التحقق النهائي من التواقيت والمواعيد مسؤولية شخصية تقع على عاتق المستخدم وحده. يجب على المستخدم التحقق يدوياً وبشكل دوري من دقة الساعات وحسابات التوقيت قبل حضور الامتحانات الجامعية الدولية، أو تنظيم رحلات الطيران الدولية، أو الدخول في غرف المحادثة والاجتماعات مع فرق العمل العالمية لتلافي أي أخطاء ناجمة عن خلل الحسابات.
  </p>

  <!-- 15. التعديلات والتغييرات على سياسة إخلاء المسؤولية -->
  <h2 style="color: var(--accent-2); margin-top: 32px; margin-bottom: 16px;">15. التعديلات والتغييرات على إخلاء المسؤولية (Changes to Disclaimer)</h2>
  <p style="color: var(--muted); margin-bottom: 16px;">
    تلتزم إدارة الموقع بمراجعة وتحديث بنود صفحة إخلاء المسؤولية هذه بشكل دوري للتكيف مع أي متطلبات قانونية جديدة أو تحديثات برمجية تطرأ على طريقة عمل المنصة. نحتفظ بالحق الكامل في تعديل هذه الوثيقة في أي وقت دون إشعار مسبق. تسري التعديلات فور نشرها على هذه الصفحة، ويعتبر استمرارك في استخدام الموقع بعد النشر موافقة ضمنية على البنود الجديدة.
  </p>

  <!-- 16. معلومات الاتصال وإرسال الاستفسارات القانونية -->
  <h2 style="color: var(--accent-2); margin-top: 32px; margin-bottom: 16px;">16. معلومات الاتصال (Contact Information)</h2>
  <p style="color: var(--muted); margin-bottom: 16px;">
    إذا كانت لديكم أي استفسارات قانونية، أو ملاحظات بشأن دقة التراجم العربية والتحويلات المدرجة في الموقع، أو رغبة في الإبلاغ عن أخطاء تقنية، يُرجى التواصل معنا مباشرة عبر صفحة <a href="/contact-us/" style="color: var(--accent); text-decoration: underline;">اتصل بنا</a> المخصصة لذلك. يسعد فريق الدعم لدينا بمراجعة ملاحظاتكم والعمل على تصحيح أي خلل في أسرع وقت ممكن.
  </p>

  <!-- 17. مراجعة واعتماد المستشار القانوني والتحريري -->
  <h2 style="color: var(--accent-2); margin-top: 32px; margin-bottom: 16px;">17. المراجعة والاعتماد التحريري</h2>
  <p style="color: var(--muted); margin-bottom: 16px;">
    تخضع هذه الوثيقة القانونية ومقالات الموقع للمراجعة والتدقيق الدوري بواسطة الأستاذة <strong>دجيكي بروس</strong> (المتخصصة في شؤون التوقيت العالمي والسياسات القانونية للمواقع الإلكترونية)، لضمان جودة المحتوى وموافقته لأعلى معايير المصداقية والثقة الرقمية (E-E-A-T).
  </p>

  <p style="font-size: 0.9em; color: var(--muted); margin-top: 24px; border-top: 1px solid var(--line); padding-top: 12px;">
    آخر تحديث لهذه الصفحة: أكتوبر 2026 | تمت المراجعة والتدقيق بواسطة دجيكي بروس
  </p>

  <!-- روابط داخلية عربية -->
  <div style="margin-top: 32px; padding: 16px; background: var(--panel); border: 1px solid var(--line); border-radius: 8px;">
    <h3 style="color: var(--accent); margin-bottom: 12px;">روابط قانونية ذات صلة</h3>
    <ul style="list-style: none; padding: 0; display: flex; gap: 16px; flex-wrap: wrap;">
      <li><a href="/ar/" style="color: var(--accent-2); text-decoration: underline;">الرئيسية</a></li>
      <li><a href="/privacy-policy/" style="color: var(--accent-2); text-decoration: underline;">سياسة الخصوصية</a></li>
      <li><a href="/terms-of-service/" style="color: var(--accent-2); text-decoration: underline;">شروط الخدمة</a></li>
      <li><a href="/editorial-policy/" style="color: var(--accent-2); text-decoration: underline;">السياسة التحريرية</a></li>
      <li><a href="/contact-us/" style="color: var(--accent-2); text-decoration: underline;">اتصل بنا</a></li>
      <li><a href="/ar/about-us/" style="color: var(--accent-2); text-decoration: underline;">من نحن</a></li>
    </ul>
  </div>

</section>

</BaseLayout>
