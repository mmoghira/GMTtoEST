        <!-- Left Clock: EET (Athens/Helsinki - UTC+2) -->
        <g transform="translate(140, 115)">
          <circle cx="0" cy="0" r="50" fill="#12455d" stroke="#36c7b5" stroke-width="3" />
          <line x1="0" y1="0" x2="0" y2="-32" stroke="#f4fbff" stroke-width="3" stroke-linecap="round" />
          <line x1="0" y1="0" x2="22" y2="0" stroke="#8fd7ff" stroke-width="4" stroke-linecap="round" />
          <circle cx="0" cy="0" r="4" fill="#36c7b5" />
          <text x="0" y="70" font-family="'Space Grotesk', sans-serif" font-weight="bold" font-size="14" fill="#f4fbff" text-anchor="middle">Athens / Helsinki (EET)</text>
          <text x="0" y="88" font-family="'Manrope', sans-serif" font-size="12" fill="#36c7b5" text-anchor="middle">UTC+2 Offset</text>
        </g>

        <!-- Right Clock: EST (New York - UTC-5) -->
        <g transform="translate(460, 115)">
          <circle cx="0" cy="0" r="50" fill="#12455d" stroke="#2f6278" stroke-width="3" />
          <line x1="0" y1="0" x2="-22" y2="22" stroke="#bdd2dc" stroke-width="3" stroke-linecap="round" />
          <line x1="0" y1="0" x2="0" y2="-32" stroke="#f4fbff" stroke-width="4" stroke-linecap="round" />
          <circle cx="0" cy="0" r="4" fill="#36c7b5" />
          <text x="0" y="70" font-family="'Space Grotesk', sans-serif" font-weight="bold" font-size="14" fill="#bdd2dc" text-anchor="middle">New York (EST)</text>
