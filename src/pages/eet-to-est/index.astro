      <rect x="15" y="30" width="90" height="6" fill="#2f6278" />
      <!-- Columns -->
      <rect x="20" y="36" width="8" height="54" fill="#164d68" />
      <rect x="35" y="36" width="8" height="54" fill="#164d68" />
      <rect x="50" y="36" width="8" height="54" fill="#164d68" />
      <rect x="65" y="36" width="8" height="54" fill="#164d68" />
      <rect x="80" y="36" width="8" height="54" fill="#164d68" />
      <rect x="92" y="36" width="8" height="54" fill="#164d68" />
      <!-- Base -->
      <rect x="10" y="90" width="100" height="10" fill="#12455d" />
      <text x="60" y="115" font-family="'Space Grotesk', sans-serif" font-size="12" font-weight="bold" fill="#8fd7ff" text-anchor="middle">Athens / EET</text>
    </g>

    <!-- Transatlantic Bridge Wave -->
