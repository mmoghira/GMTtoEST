---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import Converter from "theme/components/Converter.astro";
import { getTranslation, siteUrl } from "theme/i18n/config";

const lang = "en";
const dir = "ltr";
const slug = "gmt-to-eat";
const t = getTranslation(lang);

const pageTitle = "GMT to EAT Converter";
const seoTitle = "GMT to EAT Converter – Greenwich Mean Time to East Africa Time";
const pageDescription = "Convert GMT to EAT instantly. See the current time difference between Greenwich Mean Time (UTC+0) and East Africa Time (UTC+3), with Nairobi and Addis Ababa clocks.";

const context = {
  from: "GMT",
  to: "EAT",
  fromZone: "UTC",
  toZone: "Africa/Nairobi"
};

const canonical = `${siteUrl}/gmt-to-eat/`;

// 24-hour conversion table data (GMT → EAT = GMT + 3)
function formatHour12(hour: number) {
  const normalized = ((hour % 24) + 24) % 24;
  const period = normalized < 12 ? "AM" : "PM";
  const displayHour = normalized % 12 || 12;
  return `${displayHour}:00 ${period}`;
}

const conversionRows = Array.from({ length: 24 }, (_, hour) => {
  const eatHour = hour + 3;
  const eatNormalized = ((eatHour % 24) + 24) % 24;
  const nextDay = eatHour >= 24;
  const period = eatNormalized < 12 ? "AM" : "PM";
  const displayHour = eatNormalized % 12 || 12;
  return {
    gmt: formatHour12(hour),
    eat: `${displayHour}:00 ${period}${nextDay ? " (+1 day)" : ""}`,
    dayNote: nextDay ? "Next day" : "Same day"
  };
});

// Popular conversions
const popularConversions = [
  { gmt: "12:00 AM (Midnight)", eat: "3:00 AM EAT", note: "Late night in Nairobi, midnight in Greenwich" },
  { gmt: "2:00 AM", eat: "5:00 AM EAT", note: "Dawn breaking in Addis Ababa, night in London" },
  { gmt: "4:00 AM", eat: "7:00 AM EAT", note: "Start of day in Kampala, early morning in Greenwich" },
  { gmt: "6:00 AM", eat: "9:00 AM EAT", note: "Workday beginning in Dar es Salaam, morning in Greenwich" },
  { gmt: "8:00 AM", eat: "11:00 AM EAT", note: "Mid-morning focus in Kenya, morning starting in London" },
  { gmt: "10:00 AM", eat: "1:00 PM EAT", note: "Lunch break in Ethiopia, mid-morning in Greenwich" },
  { gmt: "12:00 PM (Noon)", eat: "3:00 PM EAT", note: "Afternoon productivity in Uganda, noon in Greenwich" },
  { gmt: "2:00 PM", eat: "5:00 PM EAT", note: "Late afternoon for East Africa teams, afternoon in London" },
  { gmt: "4:00 PM", eat: "7:00 PM EAT", note: "Offices closing in Nairobi, UK offices winding down" },
  { gmt: "6:00 PM", eat: "9:00 PM EAT", note: "Evening relaxation in Kampala, evening in Greenwich" },
  { gmt: "8:00 PM", eat: "11:00 PM EAT", note: "Late night in Tanzania, night in Greenwich" },
  { gmt: "10:00 PM", eat: "1:00 AM EAT (+1 day)", note: "After midnight in East Africa, late night in London" }
];

// FAQ data
const faqs = [
  { q: "What is EAT?", a: "EAT stands for Eastern Africa Time. It is a standard time zone observed in several East African countries, running exactly 3 hours ahead of Coordinated Universal Time (UTC+3) and Greenwich Mean Time (GMT+3)." },
  { q: "What is the offset of Eastern Africa Time?", a: "Eastern Africa Time operates at a fixed offset of UTC+3, which is 3 hours ahead of Greenwich Mean Time (GMT)." },
  { q: "Does EAT observe Daylight Saving Time?", a: "No. Eastern Africa Time does not observe Daylight Saving Time (DST). The offset remains UTC+3 year-round, which simplifies schedule planning for international partners." },
  { q: "Which countries follow Eastern Africa Time?", a: "Countries observing EAT year-round include Kenya, Uganda, Tanzania, Ethiopia, Somalia, Djibouti, Eritrea, South Sudan, Comoros, and Madagascar." },
  { q: "How many hours ahead of GMT is EAT?", a: "EAT is exactly 3 hours ahead of Greenwich Mean Time (GMT) when the UK is on standard time. When the UK observes British Summer Time (BST, UTC+1), EAT is 2 hours ahead of London." },
  { q: "Does Nairobi observe EAT?", a: "Yes. Nairobi, Kenya, follows Eastern Africa Time (EAT, UTC+3) year-round and does not adjust clocks for daylight saving." },
  { q: "Does Addis Ababa follow EAT?", a: "Yes. Addis Ababa, the capital of Ethiopia, observes EAT (UTC+3) throughout the year." },
  { q: "Does Kampala follow EAT?", a: "Yes. Kampala, Uganda, observes EAT (UTC+3) year-round." },
  { q: "Does Dar es Salaam follow EAT?", a: "Yes. Dar es Salaam, Tanzania, observes EAT (UTC+3) year-round." },
  { q: "What is the IANA identifier for East Africa Time?", a: "The primary canonical IANA time zone identifier for Eastern Africa Time is Africa/Nairobi. Other identifiers include Africa/Addis_Ababa, Africa/Dar_es_Salaam, Africa/Kampala, and Africa/Mogadishu." },
  { q: "How do I manually convert GMT to EAT?", a: "To convert GMT to EAT manually, simply add 3 hours to the GMT clock. For example, 10:00 AM GMT + 3 hours = 1:00 PM EAT." },
  { q: "What is 6 PM GMT in EAT?", a: "6:00 PM GMT converts to 9:00 PM EAT on the same calendar day." },
  { q: "What is 12 AM GMT in East Africa?", a: "12:00 AM (Midnight) GMT converts to 3:00 AM EAT on the same calendar day." },
  { q: "Does Madagascar use EAT?", a: "Yes. Madagascar observes Eastern Africa Time (UTC+3) year-round, including its capital Antananarivo." },
  { q: "Does Somalia use EAT?", a: "Yes. Somalia, including Mogadishu, observes EAT (UTC+3) year-round." },
  { q: "Does Djibouti use EAT?", a: "Yes. Djibouti observes EAT (UTC+3) year-round." },
  { q: "Does Eritrea observe EAT?", a: "Yes. Eritrea, including Asmara, observes EAT (UTC+3) year-round." },
  { q: "Does South Sudan use EAT?", a: "Yes. South Sudan observes EAT (UTC+3) year-round." },
  { q: "Does Mayotte use EAT?", a: "Yes. Mayotte, an insular region of France in the Indian Ocean, observes EAT (UTC+3) year-round." },
  { q: "Do the Comoros islands use EAT?", a: "Yes. The Union of the Comoros observes EAT (UTC+3) year-round." },
  { q: "How accurate is this GMT to EAT converter?", a: "Our converter uses the official IANA Time Zone Database loaded directly via the browser Intl API, ensuring absolute accuracy for any calendar date." },
  { q: "What is the difference between EAT and EEST?", a: "EAT is Eastern Africa Time (UTC+3), used year-round. EEST is Eastern European Summer Time (UTC+3), observed in Eastern Europe only during summer daylight saving hours." },
  { q: "What is the difference between EAT and CAT?", a: "EAT is Eastern Africa Time (UTC+3), while CAT is Central Africa Time (UTC+2). EAT runs exactly 1 hour ahead of CAT." },
  { q: "Why doesn't East Africa use daylight saving time?", a: "East Africa is situated close to the equator. Because daylight hours remain nearly constant at roughly 12 hours year-round, there is no economic or energy benefit to shifting clocks." },
  { q: "Do database logs use GMT or EAT?", a: "Computer networks and databases store log files in UTC (GMT) to avoid chronological confusion. User interfaces then translate these values to local EAT for East African users." },
  { q: "Is EAT the same as Arabia Standard Time?", a: "EAT (Eastern Africa Time) and AST (Arabia Standard Time) share the same UTC offset of +3 hours. However, they refer to different geographic regions. AST is observed in Saudi Arabia, Iraq, Yemen, and other Middle Eastern nations." },
  { q: "What is the standard workday overlap between GMT and EAT?", a: "The optimal business overlap occurs between 8:00 AM GMT and 2:00 PM GMT, which is 11:00 AM EAT and 5:00 PM EAT. This provides 5 hours of concurrent working time." },
  { q: "Can EAT be represented as GMT+3?", a: "Yes. EAT operates exactly 3 hours ahead of Coordinated Universal Time, which corresponds to the GMT+3 notation." },
  { q: "Does Uganda observe clock changes?", a: "No. Uganda does not observe daylight saving time, maintaining a constant UTC+3 offset." },
  { q: "Can this converter assist with NGO operations?", a: "Yes. The meeting planner helps international NGOs coordinate between headquarters in London/Geneva and field offices in Nairobi/Addis Ababa." }
];

const meta = {
  seoTitle: "GMT to EAT Converter – Greenwich Mean Time to East Africa Time",
  description: "Convert GMT to EAT instantly. See the current time difference between Greenwich Mean Time (UTC+0) and East Africa Time (UTC+3), with Nairobi clocks.",
  keywords: "GMT to EAT, GMT to Eastern Africa Time, Greenwich Mean Time to Eastern Africa Time, GMT EAT Converter, Convert GMT to EAT, Current EAT Time, GMT UTC to EAT, East Africa Time Converter, GMT to Nairobi Time, GMT to Addis Ababa Time, GMT to Kampala Time, GMT to Dar es Salaam Time, GMT to East Africa Time, Time Difference GMT and EAT",
  image: "/assets/gmt-to-eat-og.svg",
  imageAlt: "GMT to EAT Converter – Convert Greenwich Mean Time to Eastern Africa Time",
  faqs,
  appDescription: "Free online GMT to EAT converter with real-time clocks, DST-aware calculation, 24-hour conversion chart, and meeting planner for scheduling between Greenwich Mean Time and Eastern Africa Time.",
  applicationCategory: "UtilityApplication",
  operatingSystem: "Any",
  howToName: "How to Convert GMT to EAT",
  howToDescription: "Step-by-step guide to converting Greenwich Mean Time to Eastern Africa Time using our free online tool.",
  howToSteps: [
    { name: "Confirm Eastern Africa offset", text: "EAT is always UTC+3. East African nations do not observe daylight saving, meaning the offset remains constant year-round." },
    { name: "Input your GMT time", text: "Select your desired GMT time using our interactive date-time picker. The tool defaults to the current time." },
    { name: "Observe the calculated result", text: "Our calculator checks the date and displays the result in EAT (+3 offset) automatically." },
    { name: "Copy or swap the result", text: "Read the converted Eastern Africa Time and click the copy button to save the result." }
  ],
};
