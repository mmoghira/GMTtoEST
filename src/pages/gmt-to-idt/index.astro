---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import Converter from "theme/components/Converter.astro";
import { getTranslation, pageUrl, siteUrl } from "theme/i18n/config";

const lang = "en";
const dir = "ltr";
const slug = "gmt-to-idt";
const t = getTranslation(lang);

const pageTitle = "GMT to IDT Converter";
const seoTitle = "GMT to IDT Converter – Greenwich Mean Time to Israel Daylight Time";
const pageDescription = "Convert GMT to IDT instantly. See the current time difference between Greenwich Mean Time and Israel Daylight Time, plus Tel Aviv and Jerusalem clock guides.";

const context = {
  from: "GMT",
  to: "IDT",
  fromZone: "UTC",
  toZone: "Asia/Jerusalem"
};

const canonical = `${siteUrl}/gmt-to-idt/`;

// 24-hour conversion table data (GMT → IDT = GMT + 3)
function formatHour12(hour: number) {
  const normalized = ((hour % 24) + 24) % 24;
  const period = normalized < 12 ? "AM" : "PM";
  const displayHour = normalized % 12 || 12;
  return `${displayHour}:00 ${period}`;
}

const conversionRows = Array.from({ length: 24 }, (_, hour) => {
  const idtHour = hour + 3;
  const idtNormalized = ((idtHour % 24) + 24) % 24;
  const nextDay = idtHour >= 24;
  const period = idtNormalized < 12 ? "AM" : "PM";
  const displayHour = idtNormalized % 12 || 12;
  return {
    gmt: formatHour12(hour),
    idt: `${displayHour}:00 ${period}${nextDay ? " (+1 day)" : ""}`,
    dayNote: nextDay ? "Next day" : "Same day"
  };
});

// Popular conversions
const popularConversions = [
  { gmt: "12:00 AM (Midnight)", idt: "3:00 AM IDT", note: "Middle of the night in Tel Aviv and Jerusalem" },
  { gmt: "2:00 AM", idt: "5:00 AM IDT", note: "Dawn in Israel, pre-work hours" },
  { gmt: "4:00 AM", idt: "7:00 AM IDT", note: "Morning routines begin in Haifa and Tel Aviv" },
  { gmt: "6:00 AM", idt: "9:00 AM IDT", note: "Israeli offices open and start their workday" },
  { gmt: "8:00 AM", idt: "11:00 AM IDT", note: "Mid-morning focus hours across Israel, UK starting work" },
  { gmt: "10:00 AM", idt: "1:00 PM IDT", note: "Lunch break in Jerusalem, mid-morning in Greenwich" },
  { gmt: "12:00 PM (Noon)", idt: "3:00 PM IDT", note: "Afternoon collaboration slot" },
  { gmt: "2:00 PM", idt: "5:00 PM IDT", note: "Winding down in Israel, afternoon in Greenwich" },
  { gmt: "4:00 PM", idt: "7:00 PM IDT", note: "Evening hours in Eilat, UK offices closing" },
  { gmt: "6:00 PM", idt: "9:00 PM IDT", note: "Nighttime in Tel Aviv, evening in London" },
  { gmt: "8:00 PM", idt: "11:00 PM IDT", note: "Late night in Israel, prime time in Greenwich" },
  { gmt: "10:00 PM", idt: "1:00 AM IDT (+1)", note: "Midnight in Jerusalem, bedtime in Greenwich" }
];

// FAQ data
const faqs = [
  { q: "What is IDT?", a: "IDT stands for Israel Daylight Time. It is the daylight saving time zone observed in Israel during the summer months. It runs exactly 3 hours ahead of Coordinated Universal Time (UTC+3) and Greenwich Mean Time (GMT+3)." },
  { q: "How many hours is IDT ahead of GMT?", a: "IDT is exactly 3 hours ahead of Greenwich Mean Time (GMT). For example, when it is 12:00 PM (Noon) GMT, it is 3:00 PM IDT in Tel Aviv and Jerusalem." },
  { q: "Is Israel always on IDT?", a: "No. Israel transitions between IDT (Israel Daylight Time, UTC+3) in the summer and IST (Israel Standard Time, UTC+2) in the winter. The switch happens annually between March and October." },
  { q: "Does Jerusalem follow IDT?", a: "Yes. Jerusalem, the capital of Israel, observes IDT (UTC+3) during the daylight saving period and IST (UTC+2) during the winter months." },
  { q: "What is the difference between IDT and IST?", a: "IDT is Israel Daylight Time (UTC+3), used during summer. IST is Israel Standard Time (UTC+2), used during winter. The change shifts clocks by 1 hour to optimize evening daylight." },
  { q: "When does Israel switch to IDT?", a: "Israel switches to IDT on the Friday before the last Sunday of March. Clocks move forward by 1 hour from 2:00 AM IST to 3:00 AM IDT." },
  { q: "When does Israel switch back to IST?", a: "Israel switches back to IST on the last Sunday of October. Clocks fall back by 1 hour from 2:00 AM IDT to 1:00 AM IST." },
  { q: "Does Tel Aviv follow IDT?", a: "Yes. Tel Aviv observes IDT (UTC+3) during the summer and IST (UTC+2) in the winter, following the national time zone schedule of Israel." },
  { q: "How accurate is this GMT to IDT converter?", a: "Our converter uses the official IANA Time Zone Database (specifically the Asia/Jerusalem ruleset), loaded directly via the browser API. This guarantees 100% precision for any calendar date." },
  { q: "What is 6 PM GMT in IDT?", a: "6:00 PM GMT converts to 9:00 PM IDT on the same day. Since IDT is 3 hours ahead, we simply advance the clock by 180 minutes." },
  { q: "Is GMT the same as UTC?", a: "For civil scheduling, GMT (Greenwich Mean Time) and UTC (Coordinated Universal Time) are identical (offset +0). UTC is the modern atomic baseline, while GMT is the solar standard." },
  { q: "Can I manually convert GMT to IDT?", a: "Yes. Add 3 hours to the GMT clock during the summer. For instance, 10:00 AM GMT + 3 hours = 1:00 PM IDT. If the date is in winter, add 2 hours for IST." },
  { q: "Which cities follow Israel Daylight Time?", a: "All cities in Israel follow IDT during summer, including Jerusalem, Tel Aviv, Haifa, Eilat, Beersheba, and Netanya." },
  { q: "What is the IANA key for Israel time?", a: "The canonical IANA time zone identifier for Israel is Asia/Jerusalem. It automatically manages transitions between standard and daylight saving time." },
  { q: "Does Eilat use IDT?", a: "Yes. The southern resort city of Eilat observes IDT (UTC+3) in summer and IST (UTC+2) in winter, synchronized with the rest of the nation." },
  { q: "How does IDT compare to BST?", a: "BST (British Summer Time) is UTC+1. Since IDT is UTC+3, Israel is exactly 2 hours ahead of the UK during their overlapping summer periods." },
  { q: "How does IDT compare to CEST?", a: "CEST (Central European Summer Time) is UTC+2. Since IDT is UTC+3, Israel is exactly 1 hour ahead of Paris, Berlin, and Rome during summer." },
  { q: "What happens to flight schedules during the clock change?", a: "While flight duration remains the same, departure and arrival local times in Tel Aviv adjust by 1 hour when Israel switches between IST and IDT." },
  { q: "Why does Israel change its clocks on Friday?", a: "Israel transitions to daylight saving time on a Friday morning to minimize disruption to the Jewish Sabbath (Shabbat), which begins Friday evening." },
  { q: "Do database logs use GMT or IDT?", a: "Databases almost always use UTC (GMT) to log transactions consistently. Systems then render the timestamps in local IDT for Israeli users." },
  { q: "What is 12 AM GMT in Tel Aviv local time?", a: "12:00 AM (Midnight) GMT is equal to 3:00 AM IDT on the same day in Tel Aviv." },
  { q: "Does Haifa follow IDT?", a: "Yes. Haifa, Israel's major northern port city, follows IDT (UTC+3) from March to October and IST (UTC+2) from October to March." },
  { q: "How does the Palestinian Authority time relate to IDT?", a: "The West Bank and Gaza follow Gaza/Hebron time rules (Asia/Gaza or Asia/Hebron). While they generally match Israel's offset, their daylight saving transition dates sometimes differ." },
  { q: "Why is Israel's timezone offset UTC+2 and UTC+3?", a: "Israel is geographically positioned in the Eastern Mediterranean, aligning with the Eastern European Time zone (EET/EEST) meridian." },
  { q: "Does Israel coordinate clock changes with Europe?", a: "Israel's transition dates are close to the European Union's schedule, but not always identical, as Israel's spring forward is set for a Friday rather than Sunday." }
];

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "GMT to IDT, GMT to Israel Daylight Time, Greenwich Mean Time to Israel Daylight Time, GMT IDT Converter, Convert GMT to IDT, GMT to Israel Time, Israel Daylight Time Converter, Current IDT Time, GMT UTC to IDT, GMT to Jerusalem Time, GMT to Tel Aviv Time, Time Difference GMT and IDT",
  image: "/assets/gmt-to-idt-og.svg",
  imageAlt: "GMT to IDT Converter – Convert Greenwich Mean Time to Israel Daylight Time",
  faqs,
  appDescription: "Free online GMT to IDT converter with real-time clocks, DST-aware calculation, 24-hour conversion chart, and meeting planner for scheduling between Greenwich Mean Time and Israel Daylight Time.",
  applicationCategory: "UtilityApplication",
  operatingSystem: "Any",
  howToName: "How to Convert GMT to IDT",
  howToDescription: "Step-by-step guide to converting Greenwich Mean Time to Israel Daylight Time using our free online tool.",
  howToSteps: [
    { name: "Verify the season", text: "IDT is active in Israel from the Friday before the last Sunday of March to the last Sunday of October. If outside this window, Israel is on IST." },
    { name: "Input your GMT time", text: "Select your desired GMT time using our interactive date and time picker. The tool defaults to the current time." },
    { name: "Verify active offsets", text: "Our calculator automatically checks the selected date and displays the result in IDT (+3 offset) or IST (+2 offset) depending on the DST schedule." },
    { name: "Read and copy the result", text: "Check the equivalent Israel time, view the day shift indicators, and click the copy button to save the conversion." }
  ],
};
---

