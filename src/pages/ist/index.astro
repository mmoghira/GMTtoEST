            <text x="150" y="160" text-anchor="middle" fill="var(--muted)" font-size="11">-10.5 Hours</text>

            <circle cx="320" cy="110" r="30" fill="var(--panel)" stroke="var(--line)" stroke-width="2"/>
            <text x="320" y="114" text-anchor="middle" fill="var(--text)" font-weight="bold" font-size="13">GMT</text>
            <text x="320" y="160" text-anchor="middle" fill="var(--muted)" font-size="11">-5.5 Hours</text>

            <circle cx="680" cy="110" r="30" fill="var(--panel)" stroke="var(--line)" stroke-width="2"/>
            <text x="680" y="114" text-anchor="middle" fill="var(--text)" font-weight="bold" font-size="13">AEST</text>
            <text x="680" y="160" text-anchor="middle" fill="var(--muted)" font-size="11">+4.5 Hours</text>

            <line x1="180" y1="110" x2="290" y2="110" stroke="var(--line)" stroke-width="2"/>
