              <td>03:30</td>
              <td>22:30 (Prev Day)</td>
              <td>23:30 (Prev Day)</td>
              <td>19:30 (Prev Day)</td>
              <td>04:30</td>
            </tr>
            <tr>
              <td>12:00 IST (Noon)</td>
              <td>06:30</td>
              <td>01:30</td>
              <td>02:30</td>
              <td>22:30 (Prev Day)</td>
              <td>07:30</td>
            </tr>
            <tr>
              <td>15:00 IST</td>
              <td>09:30</td>
              <td>04:30</td>
              <td>05:30</td>
              <td>01:30</td>
              <td>10:30</td>
            </tr>
            <tr>
              <td>18:30 IST</td>
              <td>13:00</td>
              <td>08:00</td>
              <td>09:00</td>
              <td>05:00</td>
              <td>14:00</td>
            </tr>
            <tr>
              <td>21:30 IST</td>
              <td>16:00</td>
              <td>11:00</td>
              <td>12:00</td>
              <td>08:00</td>
              <td>17:00</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p>
        For live, interactive calculations, launch our dedicated <a href="/ist-to-est/">IST to EST Converter</a>.
      </p>
    </section>

    <!-- SVG Diagram 2: IST Relational Dial -->
    <section class="diagram-section">
      <div class="diagram-card">
        <h3>Figure 2: IST Relational Offset Dial Relative to World Hubs</h3>
        <div class="svg-wrapper">
          <svg viewBox="0 0 800 220" width="100%" height="auto" xmlns="http://www.w3.org/2000/svg" aria-label="IST Relational Offset Dial">
            <rect width="800" height="220" fill="var(--panel)" rx="12" stroke="var(--line)" stroke-width="1"/>
            
