      <!-- Side by Side Visual Clocks -->
      <g transform="translate(100, 100)">
        <circle cx="0" cy="0" r="60" fill="#12455d" stroke="#2f6278" stroke-width="4" />
        <!-- AEST Clock Hands show 10:00 -->
        <line x1="0" y1="0" x2="-30" y2="-30" stroke="#f4fbff" stroke-width="4" stroke-linecap="round" />
        <line x1="0" y1="0" x2="0" y2="-45" stroke="#bdd2dc" stroke-width="2" />
        <circle cx="0" cy="0" r="5" fill="#36c7b5" />
        <text x="0" y="85" font-family="'Space Grotesk', sans-serif" font-weight="bold" font-size="16" fill="#bdd2dc" text-anchor="middle">AEST Time (UTC+10)</text>
      </g>

      <g transform="translate(300, 100)">
        <text x="0" y="10" font-family="'Space Grotesk', sans-serif" font-weight="bold" font-size="32" fill="#36c7b5" text-anchor="middle">←</text>
        <rect x="-45" y="-35" width="90" height="26" rx="13" fill="#1b536e" />
        <text x="0" y="-17" font-family="'Manrope', sans-serif" font-size="12" font-weight="800" fill="#36c7b5" text-anchor="middle">-15 HOURS</text>
      </g>

      <g transform="translate(500, 100)">
        <circle cx="0" cy="0" r="60" fill="#12455d" stroke="#36c7b5" stroke-width="4" />
        <!-- EST is -15 hours behind AEST, so hands show 7:00 on standard winter -->
        <line x1="0" y1="0" x2="-30" y2="30" stroke="#f4fbff" stroke-width="4" stroke-linecap="round" />
        <line x1="0" y1="0" x2="0" y2="-45" stroke="#8fd7ff" stroke-width="3" stroke-linecap="round" />
        <circle cx="0" cy="0" r="5" fill="#36c7b5" />
        <text x="0" y="85" font-family="'Space Grotesk', sans-serif" font-weight="bold" font-size="16" fill="#f4fbff" text-anchor="middle">EST Time (UTC-5)</text>
      </g>
    </svg>
  </div>

  <div class="method-grid">
    <article class="method-card">
      <h3>AEST Standard (+10)</h3>
      <p>Australian Eastern Standard Time (AEST, UTC+10) is observed in winter across eastern states, including Sydney, Melbourne, and Brisbane.</p>
    </article>
    <article class="method-card">
      <h3>EST standard (-5)</h3>
      <p>Eastern Standard Time runs at UTC-5. It is the winter time baseline for New York, Toronto, Washington D.C., and Boston.</p>
    </article>
    <article class="method-card">
      <h3>DST Transition dates</h3>
      <p>Because the southern and northern hemispheres transition on opposite schedules, the time gap shifts by 1 hour during spring and autumn.</p>
    </article>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════════════════════
     24-HOUR CONVERSION TABLE
     ═══════════════════════════════════════════════════════════════════════ -->
<section class="examples-section" id="conversion-chart" aria-labelledby="chart-heading">
