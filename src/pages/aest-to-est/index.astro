        </g>

        <!-- Right Clock: New York (EST) -->
        <g transform="translate(470, 110)">
          <circle cx="0" cy="0" r="50" fill="#12455d" stroke="#36c7b5" stroke-width="3" />
          <!-- EST is -15 hours behind AEST, so if AEST is 10:00, EST is 19:00 -->
          <line x1="0" y1="0" x2="-20" y2="20" stroke="#bdd2dc" stroke-width="3" stroke-linecap="round" />
