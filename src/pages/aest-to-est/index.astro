      <h3 style="font-size: 1.2rem; margin-top: 0; margin-bottom: 1rem; font-family: 'Space Grotesk', sans-serif;">AEST to EST 24-Hour Transition Grid</h3>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 120" width="1000" height="120" style="display: block;">
        <rect x="20" y="45" width="960" height="20" fill="#1b536e" rx="10" />
        <rect x="20" y="45" width="960" height="20" fill="url(#accentGrad)" rx="10" opacity="0.3" />
        
        <!-- Major Markers -->
        <!-- 12 AM AEST -->
        <g transform="translate(40, 55)">
