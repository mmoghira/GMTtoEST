          <text x="0" y="88" font-family="'Manrope', sans-serif" font-size="12" fill="#36c7b5" text-anchor="middle">UTC-5 Standard</text>
        </g>

        <!-- Flow indicator -->
        <g transform="translate(300, 100)">
          <rect x="-55" y="-35" width="110" height="24" rx="12" fill="#36c7b5" />
