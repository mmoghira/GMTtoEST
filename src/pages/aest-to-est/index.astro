    <div class="table-wrap">
      <table aria-label="AEST and EST daylight saving comparison table">
        <caption class="sr-only">Comparison of seasonal offsets between Eastern Australia and US Eastern Time</caption>
        <thead>
          <tr>
            <th>Time Zone Pairing</th>
            <th>Active Offsets</th>
            <th>Difference</th>
            <th>Typical Period</th>
            <th>Key Cities Involved</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>AEST to EST (Standard)</strong></td>
            <td>UTC+10 vs UTC−5</td>
            <td><strong>AEST +15 hours</strong></td>
            <td>Standard winter in both regions</td>
            <td>Sydney / Brisbane vs New York / Toronto</td>
          </tr>
          <tr>
            <td><strong>AEST to EDT (US Summer)</strong></td>
            <td>UTC+10 vs UTC−4</td>
            <td><strong>AEST +14 hours</strong></td>
            <td>April to October (US Daylight Saving)</td>
            <td>Brisbane (year-round) / Sydney vs New York / Miami</td>
          </tr>
