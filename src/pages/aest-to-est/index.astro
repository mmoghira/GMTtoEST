---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import Converter from "theme/components/Converter.astro";
import { getTranslation, pageUrl, siteUrl } from "theme/i18n/config";

const lang = "en";
const dir = "ltr";
const slug = "aest-to-est";
const t = getTranslation(lang);

const pageTitle = "AEST to EST Converter";
const seoTitle = "AEST to EST Converter – Convert Australian Eastern Standard to US Eastern";
const pageDescription = "Convert AEST to EST instantly. Find the current time difference between Australian Eastern Standard Time (UTC+10) and US Eastern Standard Time (UTC-5), with tables and clocks.";

const context = {
  from: "AEST",
  to: "EST",
  fromZone: "Australia/Sydney",
  toZone: "America/New_York"
};

const canonical = `${siteUrl}/aest-to-est/`;

// 24-hour conversion table data (AEST → EST = AEST - 15)
function formatHour12(hour: number) {
  const normalized = ((hour % 24) + 24) % 24;
  const period = normalized < 12 ? "AM" : "PM";
  const displayHour = normalized % 12 || 12;
  return `${displayHour}:00 ${period}`;
}

const conversionRows = Array.from({ length: 24 }, (_, hour) => {
  const estHour = hour - 15;
  const estNormalized = ((estHour % 24) + 24) % 24;
  const prevDay = estHour < 0;
  const period = estNormalized < 12 ? "AM" : "PM";
  const displayHour = estNormalized % 12 || 12;
  return {
    aest: formatHour12(hour),
    est: `${displayHour}:00 ${period}${prevDay ? " (prev day)" : ""}`,
    dayNote: prevDay ? "Previous day" : "Same day"
  };
});

// Popular conversions
const popularConversions = [
  { aest: "12:00 AM (Midnight)", est: "9:00 AM EST (prev day)", note: "Start of standard business day in New York and Toronto" },
  { aest: "2:00 AM", est: "11:00 AM EST (prev day)", note: "Mid-morning in New York, middle of the night in Sydney" },
  { aest: "4:00 AM", est: "1:00 PM EST (prev day)", note: "Lunch break in US Eastern Time, pre-dawn in Australia" },
  { aest: "6:00 AM", est: "3:00 PM EST (prev day)", note: "Afternoon focus in America, dawn starting in Melbourne" },
  { aest: "8:00 AM", est: "5:00 PM EST (prev day)", note: "US standard office hours ending, morning starting in Brisbane" },
  { aest: "10:00 AM", est: "7:00 PM EST (prev day)", note: "Evening in North America, mid-morning in Canberra" },
  { aest: "12:00 PM (Noon)", est: "9:00 PM EST (prev day)", note: "Bedtime in New York, midday in Australia" },
  { aest: "2:00 PM", est: "11:00 PM EST (prev day)", note: "Late night in America, afternoon in Sydney" },
  { aest: "4:00 PM", est: "1:00 AM EST", note: "Midnight hours in North America, late afternoon in Melbourne" },
  { aest: "6:00 PM", est: "3:00 AM EST", note: "Pre-dawn hours in New York, evening in Brisbane" },
  { aest: "8:00 PM", est: "5:00 AM EST", note: "Early morning in US Eastern Time, night in Sydney" },
  { aest: "10:00 PM", est: "7:00 AM EST", note: "US East Coast waking up, late night in Melbourne" }
];

// FAQ data
const faqs = [
  { q: "What is AEST?", a: "AEST stands for Australian Eastern Standard Time. It is the winter time zone observed in eastern parts of Australia (including Sydney, Melbourne, Brisbane, and Canberra), running exactly 10 hours ahead of Coordinated Universal Time (UTC+10)." },
  { q: "What is EST?", a: "EST stands for Eastern Standard Time. It is the winter time zone observed in the eastern parts of North America (including New York, Toronto, and Miami), running exactly 5 hours behind Coordinated Universal Time (UTC-5)." },
  { q: "How many hours behind AEST is EST?", a: "EST is exactly 15 hours behind AEST. For example, when it is 10:00 PM AEST in Sydney, it is 7:00 AM EST in New York on the same day." },
  { q: "Is New York always on EST?", a: "No. New York observes Eastern Daylight Time (EDT, UTC-4) in the summer months, transitioning back to EST (UTC-5) in winter." },
  { q: "What is the difference between EST and EDT?", a: "EST is Eastern Standard Time (UTC-5), used in winter. EDT is Eastern Daylight Time (UTC-4), used during the summer daylight saving months." },
  { q: "Does Brisbane observe daylight saving time?", a: "No. Brisbane and the state of Queensland remain on AEST (UTC+10) all year, while Sydney and Melbourne switch to AEDT (UTC+11) in summer." },
  { q: "Which Australian cities follow AEST in winter?", a: "Major cities observing AEST in winter include Sydney, Melbourne, Brisbane, Canberra, and Hobart." },
  { q: "How accurate is this AEST to EST converter?", a: "Our converter utilizes the canonical IANA Time Zone Database (specifically the Australia/Sydney and America/New_York rulesets), ensuring complete accuracy across all calendar dates." },
  { q: "How do I manually convert AEST to EST?", a: "To convert AEST to EST manually, subtract 15 hours from the AEST time. For example, 9:00 PM AEST minus 15 hours equals 6:00 AM EST." },
  { q: "What is 9 AM AEST in EST?", a: "9:00 AM AEST converts to 6:00 PM EST on the previous calendar day." },
  { q: "Is GMT the same as UTC?", a: "For daily scheduling, GMT (Greenwich Mean Time) and UTC (Coordinated Universal Time) represent the same offset (+0). UTC is the modern atomic standard, while GMT is the astronomical solar standard." },
  { q: "What is the time gap between Sydney and New York in standard winter?", a: "During standard winter in both hemispheres, Sydney is on AEST (UTC+10) and New York is on EST (UTC-5), resulting in a 15-hour difference." },
  { q: "Does Melbourne observe daylight saving?", a: "Yes. Melbourne observes AEDT (UTC+11) from the first Sunday in October to the first Sunday in April." },
  { q: "Does Canberra follow the same time zone as Sydney?", a: "Yes. Canberra and the Australian Capital Territory observe AEST (UTC+10) in winter and AEDT (UTC+11) in summer, matching Sydney's clock shifts." }
];

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "AEST to EST, Australian Eastern Standard Time to Eastern Standard Time, Convert AEST to EST, AEST EST Converter, AEST to Eastern Time, AEST to New York Time, AEST to Toronto Time, AEST to US Time, Australian Time to EST, Current EST Time, Current AEST Time, Time Difference AEST and EST, Australia to USA Time Converter",
  image: "/assets/aest-to-est-og.svg",
  imageAlt: "AEST to EST Converter – Convert Australian Eastern Standard Time to Eastern Standard Time",
  faqs,
  appDescription: "Free online AEST to EST converter with real-time clocks, DST-aware calculation, 24-hour conversion chart, and meeting planner for scheduling between Australian Eastern Standard Time and Eastern Standard Time.",
  applicationCategory: "UtilityApplication",
  operatingSystem: "Any",
  howToName: "How to Convert AEST to EST",
  howToDescription: "Step-by-step guide to converting Australian Eastern Standard Time to Eastern Standard Time using our free online tool.",
  howToSteps: [
    { name: "Check local offsets", text: "Identify if Eastern Australia is in AEST (UTC+10) or AEDT (UTC+11) and if North America is in EST (UTC-5) or EDT (UTC-4) on your target date." },
    { name: "Input your AEST time", text: "Select your desired AEST time using the interactive date and time picker. The tool defaults to the current time." },
    { name: "Check the calendar date", text: "Our calculator evaluates the chosen date against the Australian and US DST calendars to determine the correct relative offset." },
    { name: "Read and copy the EST result", text: "View the converted time, along with day status (same/previous day) and active offsets, and click copy to save the result." }
  ],
};
---

<BaseLayout
  lang={lang}
  dir={dir}
  title={seoTitle}
  description={pageDescription}
  slug={slug}
  meta={meta}
  mode="gmt-est"
  enableFaqSchema={true}
  allowAds={true}
  breadcrumbHomeLabel="Home"
  breadcrumbLabel="AEST to EST"
  hreflangCodes={["en"]}
>

<!-- ═══════════════════════════════════════════════════════════════════════════
