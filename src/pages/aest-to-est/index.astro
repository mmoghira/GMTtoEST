    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 250" width="100%" height="auto" style="display: block;">
      <rect width="800" height="250" fill="#0c354a" rx="8" />
      
      <!-- Left side: Sydney (Day/Afternoon theme) -->
      <g transform="translate(0, 0)">
        <rect x="20" y="20" width="360" height="210" fill="#12455d" rx="6" />
        <!-- Sydney Opera House Sails -->
        <path d="M60 180 Q80 120 100 180 Z" fill="#bdd2dc" stroke="#2f6278" stroke-width="1.5" />
        <path d="M90 180 Q110 110 130 180 Z" fill="#f4fbff" stroke="#2f6278" stroke-width="1.5" />
        <path d="M120 180 Q135 130 150 180 Z" fill="#bdd2dc" stroke="#2f6278" stroke-width="1.5" />
        <!-- Harbour Bridge Silhouette -->
        <path d="M 180 180 A 100 100 0 0 1 340 180" fill="none" stroke="#1b536e" stroke-width="8" />
