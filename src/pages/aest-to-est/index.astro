---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import Converter from "theme/components/Converter.astro";
import { getTranslation, pageUrl, siteUrl } from "theme/i18n/config";

const lang = "en";
const dir = "ltr";
const slug = "aest-to-est";
const t = getTranslation(lang);

const pageTitle = "AEST to EST: Time Difference & Conversion";
const seoTitle = "AEST to EST: Time Difference & Conversion";
const pageDescription = "Convert AEST to EST: Australian Eastern Standard Time (UTC+10) is 15 hours ahead of EST (UTC-5). View 24-hour conversion tables, DST shifts, and FAQs.";

const context = {
  from: "AEST",
  to: "EST",
  fromZone: "Australia/Sydney",
  toZone: "America/New_York"
};

const canonical = `${siteUrl}/aest-to-est/`;

// 24-hour conversion table data (AEST → EST = AEST - 15)
function formatHour12(hour: number) {
  const normalized = ((hour % 24) + 24) % 24;
  const period = normalized < 12 ? "AM" : "PM";
  const displayHour = normalized % 12 || 12;
  return `${displayHour}:00 ${period}`;
}

const conversionRows = Array.from({ length: 24 }, (_, hour) => {
  const estHour = hour - 15;
  const estNormalized = ((estHour % 24) + 24) % 24;
  const prevDay = estHour < 0;
  const period = estNormalized < 12 ? "AM" : "PM";
  const displayHour = estNormalized % 12 || 12;
  return {
    aest: formatHour12(hour),
    est: `${displayHour}:00 ${period}${prevDay ? " (prev day)" : ""}`,
    dayNote: prevDay ? "Previous calendar day" : "Same calendar day"
  };
});

// Reverse quick reference (EST → AEST = EST + 15)
const reverseConversionRows = [
  { est: "12:00 AM EST (Midnight)", aest: "3:00 PM AEST", dayNote: "Same calendar day" },
  { est: "6:00 AM EST", aest: "9:00 PM AEST", dayNote: "Same calendar day" },
  { est: "8:00 AM EST", aest: "11:00 PM AEST", dayNote: "Same calendar day" },
  { est: "9:00 AM EST", aest: "12:00 AM AEST (Midnight)", dayNote: "Next calendar day (+1)" },
  { est: "12:00 PM EST (Noon)", aest: "3:00 AM AEST", dayNote: "Next calendar day (+1)" },
  { est: "3:00 PM EST", aest: "6:00 AM AEST", dayNote: "Next calendar day (+1)" },
  { est: "5:00 PM EST", aest: "8:00 AM AEST", dayNote: "Next calendar day (+1)" },
  { est: "8:00 PM EST", aest: "11:00 AM AEST", dayNote: "Next calendar day (+1)" },
  { est: "10:00 PM EST", aest: "1:00 PM AEST", dayNote: "Next calendar day (+1)" }
];

// Popular conversions
const popularConversions = [
  { aest: "12:00 AM AEST (Midnight)", est: "9:00 AM EST (prev day)", note: "US East Coast morning workday begins; midnight in Sydney/Melbourne" },
  { aest: "6:00 AM AEST", est: "3:00 PM EST (prev day)", note: "Early morning in Eastern Australia; mid-afternoon in New York & Toronto" },
  { aest: "8:00 AM AEST", est: "5:00 PM EST (prev day)", note: "Prime handover window: Australian workday starts as US office hours close" },
  { aest: "9:00 AM AEST", est: "6:00 PM EST (prev day)", note: "High-volume search: Morning in Australia corresponds to early evening in US ET" },
  { aest: "10:00 AM AEST", est: "7:00 PM EST (prev day)", note: "Mid-morning team sync in Sydney/Brisbane; post-work evening in New York" },
  { aest: "12:00 PM AEST (Noon)", est: "9:00 PM EST (prev day)", note: "High-volume search: Lunchtime in Eastern Australia equals late evening in US" },
  { aest: "2:00 PM AEST", est: "11:00 PM EST (prev day)", note: "Afternoon collaboration in Australia; late night in New York" },
  { aest: "4:00 PM AEST", est: "1:00 AM EST", note: "Late afternoon in Australia; middle of the night on US East Coast" },
  { aest: "6:00 PM AEST", est: "3:00 AM EST", note: "Evening in Australia; pre-dawn hours in North America" },
  { aest: "8:00 PM AEST", est: "5:00 AM EST", note: "Night in Australia; early dawn hours in New York" },
  { aest: "10:00 PM AEST", est: "7:00 AM EST", note: "Late evening in Australia; US East Coast wakes up for the workday" },
  { aest: "11:00 PM AEST", est: "8:00 AM EST", note: "Bedtime in Eastern Australia; standard office arrival in New York" }
];

// FAQ data
const faqs = [
  {
    q: "What is the time difference between AEST and EST?",
    a: "During standard time, Australian Eastern Standard Time (AEST, UTC+10) is exactly 15 hours ahead of Eastern Standard Time (EST, UTC-5). When it is 8:00 PM AEST in Sydney or Brisbane, it is 5:00 AM EST in New York on the same calendar day."
  },
  {
    q: "How many hours ahead is AEST compared to EST?",
    a: "AEST is 15 hours ahead of EST. Because eastern Australia is on the opposite side of the International Date Line from the Americas, local morning and afternoon times in AEST correspond to the previous calendar day in EST."
  },
  {
    q: "What is 12 PM AEST in EST?",
    a: "12:00 PM (Noon) AEST converts to 9:00 PM EST on the previous calendar day. For example, if it is 12:00 PM AEST on Tuesday, it is 9:00 PM EST on Monday night in New York. If the US is observing Eastern Daylight Time (EDT, UTC-4), it is 10:00 PM EDT on the previous day."
  },
  {
    q: "What is 9 AM AEST in EST?",
    a: "9:00 AM AEST converts to 6:00 PM EST on the previous calendar day. During US daylight saving time (EDT, UTC-4), 9:00 AM AEST converts to 7:00 PM EDT on the previous day."
  },
  {
    q: "How do I manually convert AEST to EST?",
    a: "To convert AEST to EST manually, subtract 15 hours from your current AEST time. If subtracting 15 hours produces a negative value, add 24 hours to the result and set the date to the previous calendar day. For example, 10:00 AM AEST minus 15 hours equals 7:00 PM EST on the previous day."
  },
  {
    q: "Why does the time difference change between 14, 15, and 16 hours?",
    a: "Because Australia and North America sit in opposite hemispheres, their daylight saving transitions occur on opposite schedules. When eastern Australia observes AEDT (UTC+11) and the US observes EST (UTC-5), the gap is 16 hours. When both observe standard time (AEST UTC+10 and EST UTC-5), the gap is 15 hours. When North America observes EDT (UTC-4) while Australia remains on AEST (UTC+10), the gap is 14 hours."
  },
  {
    q: "What is the difference between AEST and AEDT?",
    a: "AEST stands for Australian Eastern Standard Time (UTC+10), observed in winter. AEDT stands for Australian Eastern Daylight Time (UTC+11), observed during the southern summer from the first Sunday in October to the first Sunday in April in NSW, Victoria, ACT, and Tasmania."
  },
  {
    q: "Does Brisbane or Queensland observe Daylight Saving Time?",
    a: "No. Brisbane and the entire state of Queensland remain on AEST (UTC+10) year-round without daylight saving adjustments. Consequently, Brisbane maintains a 14-hour difference from EDT in northern summer and a 15-hour difference from EST in northern winter."
  },
  {
    q: "Is New York always on EST?",
    a: "No. New York and the US East Coast observe Eastern Daylight Time (EDT, UTC-4) from the second Sunday in March to the first Sunday in November, and Eastern Standard Time (EST, UTC-5) during the winter months."
  },
  {
    q: "What is 12 PM EST in AEST?",
    a: "12:00 PM (Noon) EST converts to 3:00 AM AEST on the following calendar day (+1 day). For example, 12:00 PM EST on Monday is 3:00 AM AEST on Tuesday."
  },
  {
    q: "What is the best time for a conference call between Sydney and New York?",
    a: "The most practical collaboration window occurs between 8:00 AM and 10:00 AM AEST, which corresponds to 5:00 PM and 7:00 PM EST on the previous day. This allows Australian team members to sync at the start of their day while US team members wrap up their afternoon."
  },
  {
    q: "Which Australian cities follow AEST?",
    a: "Major Australian cities in the AEST zone include Sydney, Melbourne, Brisbane, Canberra, Gold Coast, Hobart, and Cairns. Sydney, Melbourne, Canberra, and Hobart switch to AEDT in summer, while Brisbane and Cairns stay on AEST year-round."
  },
  {
    q: "How does the International Date Line affect AEST to EST conversion?",
    a: "Because eastern Australia is UTC+10 and Eastern North America is UTC-5, local times in AEST between 12:00 AM and 3:00 PM fall into yesterday's calendar date in EST. Always double-check both the hour and the calendar date when booking international flights or setting meeting calendar invites."
  },
  {
    q: "How accurate is this AEST to EST converter?",
    a: "Our converter utilizes the canonical IANA Time Zone Database (specifically Australia/Sydney and America/New_York rulesets), accounting for every historical and upcoming daylight saving transition across all calendar dates."
  }
];

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "AEST to EST, AEST to EST conversion, AEST to EST converter, Australian Eastern Standard Time to Eastern Standard Time, AEST time difference EST, AEST vs EST, 12 PM AEST to EST, 9 AM AEST to EST, Sydney to New York time difference, AEST to EST time converter",
  image: "/assets/aest-to-est-og.svg",
  imageAlt: "AEST to EST Converter – Convert Australian Eastern Standard Time to Eastern Standard Time",
  faqs,
  appDescription: "Free online AEST to EST converter with real-time clocks, DST-aware calculation, 24-hour conversion chart, and meeting planner for scheduling between Australian Eastern Standard Time and Eastern Standard Time.",
  applicationCategory: "UtilityApplication",
  operatingSystem: "Any",
  howToName: "How to Convert AEST to EST",
  howToDescription: "Step-by-step guide to converting Australian Eastern Standard Time (AEST) to Eastern Standard Time (EST) using our free online tool.",
  howToSteps: [
    { name: "Check active seasonal offsets", text: "Identify whether Eastern Australia is observing AEST (UTC+10) or AEDT (UTC+11) and whether North America is observing EST (UTC-5) or EDT (UTC-4) on your target calendar date." },
    { name: "Input your AEST time", text: "Select your desired AEST time using the interactive date and time picker. The tool automatically defaults to the current live clock." },
    { name: "Verify calendar date rollover", text: "Notice whether your converted time falls into the same calendar day or shifts back to the previous day in Eastern North America." },
    { name: "Copy and share your converted time", text: "Review the converted Eastern Time, active daylight saving indicators, and copy the formatted result directly to your clipboard." }
  ],
};
---

<BaseLayout
  lang={lang}
  dir={dir}
  title={seoTitle}
  description={pageDescription}
  slug={slug}
  meta={meta}
  mode="gmt-est"
  enableFaqSchema={true}
  allowAds={true}
  breadcrumbHomeLabel="Home"
  breadcrumbLabel="AEST to EST"
>

<!-- ═══════════════════════════════════════════════════════════════════════════
     H1 & INTRODUCTION
     ═══════════════════════════════════════════════════════════════════════ -->
<section class="hero-banner">
  <h1 class="hero-banner-title">
    AEST to EST: <span class="gradient-text">Time Difference &amp; Converter</span>
  </h1>
</section>

<!-- PRIMARY CONVERTER, LIVE CLOCKS & DIRECT ANSWER (Above the Fold) -->
<div style="max-width: 900px; margin: 0 auto; padding: 0 16px 24px;">
  <Converter intent="dynamic" t={t} context={context} />
  
  <!-- LIVE CLOCKS -->
  <section class="clock-grid" aria-label="Live Clocks" style="margin-top: 24px;">
    <h2>Live Clocks</h2>
    <div class="clock-card">
      <span class="eyebrow">Source Time Zone</span>
      <strong id="gmtClock">--:--:--</strong>
      <p style="margin-top: 4px; font-size: 0.85rem; color: var(--muted);">Australian Eastern Standard Time (AEST, UTC+10)</p>
    </div>
    <div class="clock-card">
      <span class="eyebrow">Target Time Zone</span>
      <strong id="estClock">--:--:--</strong>
      <p style="margin-top: 4px; font-size: 0.85rem; color: var(--muted);">Active Zone: <em id="estZone">ET</em></p>
    </div>
  </section>

  <!-- DIRECT ANSWER CALLOUT BOX (Above the Fold Snippet Target) -->
  <div class="info-callout" style="margin-top: 24px;">
    <p style="font-size: 1.15rem; font-weight: 700; color: var(--text); margin-bottom: 8px;">
      Quick Answer: How do you convert AEST to EST?
    </p>
    <p>
      <strong>AEST is 15 hours ahead of EST.</strong> Australian Eastern Standard Time (AEST) runs on <strong>UTC+10</strong>, while Eastern Standard Time (EST) runs on <strong>UTC−5</strong>. To convert AEST to EST, <strong>subtract 15 hours</strong> from AEST time:
    </p>
    <ul style="margin: 8px 0 12px 20px; color: var(--text); line-height: 1.6;">
      <li><strong>12:00 PM AEST (Noon)</strong> = <strong>9:00 PM EST (previous day)</strong></li>
      <li><strong>9:00 AM AEST</strong> = <strong>6:00 PM EST (previous day)</strong></li>
      <li><strong>8:00 PM AEST</strong> = <strong>5:00 AM EST (same day)</strong></li>
    </ul>
    <p style="margin-top: 8px; font-size: 0.95rem; color: var(--muted);">
      <strong>Daylight Saving Variations:</strong> When the US East Coast is on Eastern Daylight Time (EDT, UTC−4) and eastern Australia is on AEST (UTC+10), the difference narrows to <strong>14 hours</strong>. When Australia shifts to AEDT (UTC+11) and the US is on EST (UTC−5), the difference widens to <strong>16 hours</strong>. Brisbane and Queensland remain on AEST (UTC+10) year-round without daylight saving shifts.
    </p>
  </div>
</div>

<!-- FEATURE ICONS (CUSTOM SVG) -->
<section class="feature-strip" aria-label="Tool Features">
  <div class="feature-item">
    <!-- Icon: Clock -->
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feature-icon" aria-hidden="true">
      <circle cx="12" cy="12" r="10"></circle>
      <polyline points="12 6 12 12 16 14"></polyline>
