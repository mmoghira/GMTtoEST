import { siteUrl } from "theme/i18n/config";
import RelatedConvertersWidget from "theme/components/RelatedConvertersWidget.astro";
import UsersAlsoVisitWidget from "theme/components/UsersAlsoVisitWidget.astro";
import LearnMoreWidget from "theme/components/LearnMoreWidget.astro";
import CountryCityWidget from "theme/components/CountryCityWidget.astro";

const lang = "en";
const dir = "ltr";
const slug = "how-time-zones-work";
const seoTitle = "How Time Zones Work: Physics, Meridians & Time Standards Guide";
const pageDescription = "Discover how global time zones work. Learn Earth's 15-degree longitudinal mechanics, prime meridian baseline, fractional offsets, IANA timezone database, and POSIX rules.";

const pubDate = "2026-07-30T10:00:00+05:00";
const updatedDate = "2026-07-30T10:00:00+05:00";

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "how time zones work, time zone physics, 15 degrees per hour, Prime Meridian, longitudinal time zones, IANA timezone database, fractional time zones, UTC offset mechanics, standard time zones",
  image: "/assets/how-time-zones-work-physics.svg",
  imageAlt: "Earth Longitudinal Meridian Division and Time Zone System",
  pubDate,
  updatedDate,
  author: "Jackie Bruce",
  faqs: [
    {
      q: "How many time zones exist on Earth?",
      a: "Geographically, Earth is divided into 24 standard 15-degree longitudinal time zones. However, due to political boundaries, fractional offsets (+5:30, +9:30), and daylight saving shifts, there are currently over 38 civil time offsets in active use."
    },
    {
      q: "Why are time zones spaced 15 degrees of longitude apart?",
      a: "Earth rotates 360 degrees on its axis in roughly 24 hours. Dividing 360 degrees by 24 hours equals exactly 15 degrees per hour. Therefore, moving 15 degrees east or west corresponds to a 1-hour solar time difference."
    },
    {
      q: "What is the Prime Meridian?",
      a: "The Prime Meridian is the line of 0° longitude that passes through the Royal Observatory in Greenwich, London. It serves as the geographic baseline for measuring longitudinal distances and calculating global UTC offsets."
    },
    {
      q: "Why do some countries use half-hour or 45-minute time zones?",
      a: "Some nations adopt fractional offsets to better center their civil clocks around local solar noon across their national borders. Examples include India Standard Time (UTC+5:30), Australian Central Standard Time (UTC+9:30), and Nepal Time (UTC+5:45)."
    },
    {
      q: "Why do political boundaries distort natural time zone lines?",
      a: "Natural time zones run along straight longitudinal meridians. However, governments alter time zone boundaries so that provinces, trading regions, or entire countries remain on a single unified clock for economic and administrative convenience."
    },
    {
      q: "What is China's single time zone policy?",
      a: "Although China spans five geographic 15-degree time zones, the Chinese government mandates a single national time zone—Beijing Time (UTC+8)—across the entire country."
    },
    {
      q: "What is the IANA Time Zone Database?",
      a: "The IANA Time Zone Database (also known as tzdb or Olson database) is a master software repository maintaining historic and current timezone offset rules, DST transition dates, and geographical boundaries for every region on Earth."
    },
    {
      q: "How does travelling east or west affect clock time?",
      a: "Travelling east moves your clock forward (+1 hour per 15° longitude), while travelling west moves your clock backward (-1 hour per 15° longitude)."
    },
    {
      q: "What happens when you cross the International Date Line?",
      a: "The International Date Line (180° meridian) marks the calendar date transition. Crossing it heading west advances the date by 1 calendar day, while crossing it heading east subtracts 1 calendar day."
    },
    {
      q: "What is the difference between EST and UTC-5?",
      a: "EST (Eastern Standard Time) is a specific regional time zone, whereas UTC-5 is the mathematical offset specifying that local time is 5 hours behind Coordinated Universal Time."
    },
    {
      q: "How does solar noon differ from 12:00 PM clock noon?",
      a: "Solar noon occurs when the sun reaches its highest point in the sky. Clock noon (12:00 PM) is an artificial civil average. Solar noon varies slightly depending on your exact longitudinal position within a time zone."
    },
    {
      q: "Why does Russia have 11 time zones?",
      a: "Russia stretches across over 170 degrees of longitude from Eastern Europe to the Pacific Ocean, requiring 11 consecutive time zones (from UTC+2 to UTC+12) to keep civil time aligned with local daylight."
    },
    {
      q: "What time zone is observed at the North and South Poles?",
      a: "At the geographic North and South Poles, all 24 longitudinal meridians converge at a single point. Research stations at the poles typically operate on UTC or the official time zone of their supply base (such as New Zealand time for Antarctica's McMurdo Station)."
    },
    {
      q: "How do smartphones update time zones automatically when travelling?",
      a: "Smartphones use cellular tower triangulation and GPS signals to determine geographic coordinates, querying internal IANA timezone tables to update local civil clocks instantly."
    },
    {
      q: "What is Kiribati's UTC+14 offset?",
      a: "The Pacific island nation of Kiribati moved its line of date in 1994 to align all its islands into a single calendar date, creating the world's furthest forward timezone: UTC+14."
    },
    {
      q: "What is a POSIX time zone string?",
      a: "A POSIX time zone string is a concise text format used by UNIX operating systems (such as `EST5EDT,M3.2.0,M11.1.0`) to describe standard offsets, daylight saving offsets, and annual transition dates."
    },
    {
      q: "Why is GMT to EST conversion 5 hours?",
      a: "Because the Eastern longitude in North America sits approximately 75 degrees west of Greenwich, London (75° / 15° = 5 hours offset)."
    },
    {
      q: "Does space or orbit have time zones?",
      a: "Astronauts aboard the International Space Station (ISS) operate on Coordinated Universal Time (UTC) to maintain a standardized schedule across international partner agencies."
    },
    {
      q: "What is Solar Time?",
      a: "Solar Time is timekeeping measured directly by the position of the Sun (e.g., using a sundial), where 12:00 PM occurs exactly when the sun crosses the local meridian."
    },
    {
      q: "How do I calculate the time difference between two cities?",
      a: "Find the UTC offset for both cities, then subtract the starting city's offset from the target city's offset. For example, converting <a href=\"/gmt-to-est/\">GMT (UTC+0) to EST (UTC-5)</a>: $-5 - 0 = -5$ hours."
    }
  ]
};

const pageUrlPath = `${siteUrl}/how-time-zones-work/`;

