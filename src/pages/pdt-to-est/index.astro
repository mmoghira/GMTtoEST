---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import Converter from "theme/components/Converter.astro";
import { getLang, getTranslation, siteUrl } from "theme/i18n/config";

const lang = getLang("en");
const t = getTranslation(lang.code);
const pageUrl = `${siteUrl}/pdt-to-est/`;

const meta = {
  title: "PDT to EST Converter: Convert Pacific Time",
  description: "Convert PDT to EST with live clocks, DST support, a 24-hour conversion chart, and a practical meeting planner for Pacific and Eastern Time schedules today.",
  keywords: "PDT to EST, PDT to EST Converter, Convert PDT to EST, Pacific Time to Eastern Time, Pacific Daylight Time to Eastern Time, PDT vs EST, what is 5 PM PDT in EST, what is 8 PM PDT in EST, what is 1 PM PDT in EST, what is 7 PM PDT in EST, how many hours is PDT behind EST",
  image: "/assets/pdt-to-est-converter-interface-1200.avif",
  imageAlt: "PDT to EST converter interface showing Pacific and Eastern Time coordination",
  preloadImage: "/assets/pdt-to-est-converter-interface-1200.avif",
  preloadImageSrcset: "/assets/pdt-to-est-converter-interface-600.avif 600w, /assets/pdt-to-est-converter-interface-1200.avif 1200w",
  preloadImageSizes: "(max-width: 720px) 92vw, 560px",
  preloadImageType: "image/avif",
  ogType: "website"
};

const quickRows = [
  ["6 AM", "9 AM"], ["7 AM", "10 AM"], ["8 AM", "11 AM"], ["9 AM", "12 PM"], ["10 AM", "1 PM"],
  ["11 AM", "2 PM"], ["12 PM", "3 PM"], ["1 PM", "4 PM"], ["2 PM", "5 PM"], ["3 PM", "6 PM"],
  ["4 PM", "7 PM"], ["5 PM", "8 PM"], ["6 PM", "9 PM"], ["7 PM", "10 PM"], ["8 PM", "11 PM"]
];

const hourlyRows = [
  ["12 AM", "3 AM"], ["1 AM", "4 AM"], ["2 AM", "5 AM"], ["3 AM", "6 AM"], ["4 AM", "7 AM"], ["5 AM", "8 AM"],
  ["6 AM", "9 AM"], ["7 AM", "10 AM"], ["8 AM", "11 AM"], ["9 AM", "12 PM"], ["10 AM", "1 PM"], ["11 AM", "2 PM"],
  ["12 PM", "3 PM"], ["1 PM", "4 PM"], ["2 PM", "5 PM"], ["3 PM", "6 PM"], ["4 PM", "7 PM"], ["5 PM", "8 PM"],
  ["6 PM", "9 PM"], ["7 PM", "10 PM"], ["8 PM", "11 PM"], ["9 PM", "12 AM next day"], ["10 PM", "1 AM next day"], ["11 PM", "2 AM next day"]
];

const additionalConversions = [
  { id: "ten-am-pdt", question: "What is 10 AM PDT in EST?", answer: "10 AM PDT = 1 PM EDT.", impact: "It is a reliable early-afternoon Eastern slot for a design review or customer presentation after the West Coast team has settled into the day." },
  { id: "twelve-pm-pdt", question: "What is 12 PM PDT in EST?", answer: "12 PM PDT = 3 PM EDT.", impact: "A Pacific lunch-hour meeting becomes a mid-afternoon Eastern meeting, leaving time for an East Coast follow-up before close of business." },
  { id: "three-pm-pdt", question: "What is 3 PM PDT in EST?", answer: "3 PM PDT = 6 PM EDT.", impact: "This lands after a typical Eastern workday, so reserve it for an urgent handoff, a webinar, or an audience that expects an evening slot." },
  { id: "six-pm-pdt", question: "What is 6 PM PDT in EST?", answer: "6 PM PDT = 9 PM EDT.", impact: "It works for a nationwide launch or live community event, but it is too late for most recurring East Coast team meetings." },
  { id: "nine-pm-pdt", question: "What is 9 PM PDT in EST?", answer: "9 PM PDT = 12 AM EDT the next day.", impact: "Always label the Eastern date as well as the time here, because a West Coast evening event has already crossed midnight for New York and Boston." }
];

const howToSteps = [
  { name: "Start with Pacific daylight time", text: "Enter the California, Seattle, or other Pacific Time appointment in the PDT input above." },
  { name: "Move the meeting three hours later", text: "Add three hours to reach the matching Eastern Time during the daylight-saving season." },
  { name: "Confirm the date before sending", text: "Use the date-aware result to see PDT or PST and EDT or EST correctly around daylight-saving changes." }
];

const faqItems = [
  { q: "Is PDT the same as EST?", a: "No. PDT is Pacific Daylight Time and is used on the West Coast during daylight saving time. EST is Eastern Standard Time and is used in winter. For a summer meeting, compare PDT with EDT: Eastern Time is three hours ahead." },
  { q: "How many hours behind is PDT from EST?", a: "For practical Pacific-to-Eastern scheduling during daylight saving time, Pacific Time is three hours behind Eastern Time because PDT is UTC-7 and EDT is UTC-4. Strict EST is UTC-5, so a date-aware tool should label the active Eastern abbreviation." },
  { q: "What is the best meeting time between PDT and EST?", a: "For a recurring coast-to-coast business meeting, 9 AM PDT to 2 PM PDT is usually best. That is 12 PM EDT to 5 PM EDT, giving Pacific teams a productive morning and Eastern teams a usable afternoon." },
  { q: "Why is Eastern Time 3 hours ahead of Pacific Time?", a: "During daylight saving time, Pacific locations use PDT at UTC-7 while Eastern locations use EDT at UTC-4. The three-hour difference reflects those active regional offsets and stays consistent while both zones observe daylight saving time." },
  { q: "What is 5 PM PDT in EST?", a: "5 PM PDT equals 8 PM Eastern Time, observed as EDT during the Pacific daylight-saving season." },
  { q: "What is 8 PM PDT in EST?", a: "8 PM PDT equals 11 PM Eastern Time, observed as EDT during the Pacific daylight-saving season." },
  { q: "What is 1 PM PDT in EST?", a: "1 PM PDT equals 4 PM Eastern Time, observed as EDT during the Pacific daylight-saving season." },
  { q: "What is 7 PM PDT in EST?", a: "7 PM PDT equals 10 PM Eastern Time, observed as EDT during the Pacific daylight-saving season." },
  { q: "What is 8 AM PDT in EST?", a: "8 AM PDT equals 11 AM Eastern Time, observed as EDT during the Pacific daylight-saving season." },
  { q: "What is the PDT vs EST difference?", a: "PDT is UTC-7 and EST is UTC-5, so their strict abbreviation-to-abbreviation difference is two hours. In real summer scheduling, Eastern locations use EDT at UTC-4, which makes Pacific Daylight Time three hours behind Eastern Time." }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
      "url": pageUrl,
      "name": meta.title,
      "description": meta.description,
      "inLanguage": "en"
    },
    {
      "@type": "WebApplication",
      "@id": `${pageUrl}#app`,
      "name": "PDT to EST Converter",
      "url": pageUrl,
      "description": "A date-aware PDT to Eastern Time converter with live Pacific and Eastern clocks, a quick conversion table, and a meeting planner.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "Any",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "featureList": ["PDT input and Eastern Time output", "Live Pacific and Eastern clocks", "DST-aware date conversion", "24-hour PDT to Eastern Time chart", "Pacific-to-Eastern meeting planner"]
    },
    {
      "@type": "HowTo",
      "@id": `${pageUrl}#howto`,
      "name": "How to Convert PDT to Eastern Time",
      "description": "Use a three-hour shift for Pacific Daylight Time to Eastern Time, then confirm the date-aware abbreviation before scheduling.",
      "step": howToSteps.map((step, index) => ({ "@type": "HowToStep", "position": index + 1, "name": step.name, "text": step.text }))
    },
    {
      "@type": "FAQPage",
      "@id": `${pageUrl}#faq`,
      "mainEntity": faqItems.map((item) => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": { "@type": "Answer", "text": item.a }
      }))
    }
  ]
};
---

<BaseLayout lang={lang.code} dir={lang.dir} title={meta.title} description={meta.description} slug="pdt-to-est" meta={meta} breadcrumbHomeLabel="Home" breadcrumbLabel="PDT to EST">
  <script type="application/ld+json" set:html={JSON.stringify(schema)} slot="head" />

  <section class="hero-banner">
    <h1 class="hero-banner-title">PDT to EST <span class="gradient-text">Converter</span> | Pacific Time to Eastern Time</h1>
  </section>

  <nav class="pdt-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">PDT to EST</span>
  </nav>

  <section class="hero pdt-hero" aria-labelledby="pdt-intro">
    <div class="hero-copy">
      <p class="eyebrow">Pacific-to-Eastern scheduling</p>
      <h2 id="pdt-intro">Eastern Time is 3 hours ahead of Pacific Daylight Time.</h2>
      <p>When it is 9 AM in Los Angeles, San Francisco, or Seattle, it is 12 PM in New York, Boston, Miami, and Washington, DC. Use the live clocks and date-aware PDT to EST converter to keep coast-to-coast plans on time.</p>
      <div class="pdt-live-clocks" aria-label="Live Pacific and Eastern time clocks">
        <div><span>Live PDT Clock</span><strong id="gmtClock">--:--</strong></div>
        <div><span>Live EDT Clock</span><strong id="estClock">--:--</strong><em id="estZone">EDT</em></div>
      </div>
      <ul class="pdt-trust-list" aria-label="Converter benefits">
        <li>DST Aware</li>
        <li>Live Time Calculation</li>
        <li>Free Online Tool</li>
      </ul>
      <figure class="hero-visual reveal">
        <picture>
          <source type="image/avif" srcset="/assets/pdt-to-est-converter-interface-600.avif 600w, /assets/pdt-to-est-converter-interface-1200.avif 1200w" sizes="(max-width: 860px) 92vw, 560px" />
          <source type="image/webp" srcset="/assets/pdt-to-est-converter-interface-600.webp 600w, /assets/pdt-to-est-converter-interface-1200.webp 1200w" sizes="(max-width: 860px) 92vw, 560px" />
          <img width="1200" height="800" src="/assets/pdt-to-est-converter-interface-1200.webp" alt={meta.imageAlt} fetchpriority="high" loading="eager" decoding="async" />
        </picture>
        <figcaption>Coordinate Pacific and Eastern schedules without losing the three-hour shift.</figcaption>
      </figure>
    </div>
    <Converter intent="dynamic" t={t} context={{ from: "PDT", to: "EST", fromZone: "America/Los_Angeles", toZone: "America/New_York" }} />
  </section>

  <section class="examples-section pdt-quick-table" aria-labelledby="quick-table-title">
    <h2 id="quick-table-title">PDT to Eastern Time Quick Table</h2>
    <p>For daylight-season appointments, add three hours to Pacific Daylight Time.</p>
    <div class="table-wrap">
      <table>
        <thead><tr><th>PDT</th><th>Eastern Time</th></tr></thead>
        <tbody>{quickRows.map(([pdt, eastern]) => <tr><td>{pdt}</td><td>{eastern}</td></tr>)}</tbody>
      </table>
    </div>
  </section>

  <section class="examples-section" aria-labelledby="how-to-title">
    <h2 id="how-to-title">How to Convert PDT to EST</h2>
    <p>The practical formula for a summer Pacific-to-Eastern appointment is simple: <strong>PDT + 3 Hours = EDT</strong>. This page uses “EST” as the common search term, but the active Eastern abbreviation during PDT is usually EDT.</p>
    <div class="method-grid pdt-step-grid">
      {howToSteps.map((step, index) => (
        <article class="method-card">
          <span class="step">{index + 1}</span>
          <h3>{step.name}</h3>
          <p>{step.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="examples-section" aria-labelledby="popular-conversions-title">
    <h2 id="popular-conversions-title">Popular PDT to EST Conversions</h2>
    <p>This full 24-hour chart is useful for release windows, support handoffs, online events, and calls that cross midnight on the East Coast.</p>
    <figure class="pdt-wide-figure reveal">
      <picture>
        <source type="image/avif" srcset="/assets/pdt-vs-est-hourly-comparison-600.avif 600w, /assets/pdt-vs-est-hourly-comparison-1200.avif 1200w" sizes="(max-width: 860px) 92vw, 1180px" />
        <source type="image/webp" srcset="/assets/pdt-vs-est-hourly-comparison-600.webp 600w, /assets/pdt-vs-est-hourly-comparison-1200.webp 1200w" sizes="(max-width: 860px) 92vw, 1180px" />
        <img width="1200" height="800" src="/assets/pdt-vs-est-hourly-comparison-1200.webp" alt="PDT versus Eastern Time hourly comparison with a three-hour west-to-east shift" loading="lazy" decoding="async" />
      </picture>
      <figcaption>A visual reminder that a Pacific workday arrives three hours later on the East Coast.</figcaption>
    </figure>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Pacific Daylight Time</th><th>Eastern Time</th></tr></thead>
        <tbody>{hourlyRows.map(([pdt, eastern]) => <tr><td>{pdt} PDT</td><td>{eastern} EDT</td></tr>)}</tbody>
      </table>
    </div>
  </section>

  <section class="content pdt-answer-grid" aria-label="Common PDT to Eastern Time answers">
    <article><h2 id="five-pm-pdt">What is 5 PM PDT in EST?</h2><p><strong>5 PM PDT = 8 PM EDT.</strong> A California team wrapping at 5 PM reaches the East Coast at 8 PM, so this is usually too late for a same-day client meeting.</p></article>
    <article><h2 id="eight-pm-pdt">What is 8 PM PDT in EST?</h2><p><strong>8 PM PDT = 11 PM EDT.</strong> This is a useful broadcast or launch conversion, but it is outside most Eastern business hours.</p></article>
    <article><h2 id="one-pm-pdt">What is 1 PM PDT in EST?</h2><p><strong>1 PM PDT = 4 PM EDT.</strong> It is a dependable late-afternoon Eastern slot for a product review or cross-functional check-in.</p></article>
    <article><h2 id="seven-pm-pdt">What is 7 PM PDT in EST?</h2><p><strong>7 PM PDT = 10 PM EDT.</strong> Use it for evening webinars or audience events, not a standard coast-to-coast work session.</p></article>
    <article><h2 id="eight-am-pdt">What is 8 AM PDT in EST?</h2><p><strong>8 AM PDT = 11 AM EDT.</strong> This is one of the easiest morning options for a Seattle or Silicon Valley team meeting Eastern colleagues before lunch.</p></article>
    <article><h2 id="hours-behind">How Many Hours is PDT Behind EST?</h2><p><strong>Pacific Time is 3 hours behind Eastern Time</strong> while daylight saving time is active in both regions: PDT is UTC-7 and EDT is UTC-4.</p></article>
    {additionalConversions.map((item) => <article><h2 id={item.id}>{item.question}</h2><p><strong>{item.answer}</strong> {item.impact}</p></article>)}
  </section>

  <section class="examples-section" aria-labelledby="pdt-vs-est-title">
    <h2 id="pdt-vs-est-title">PDT vs EST: Key Differences</h2>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Feature</th><th>PDT</th><th>Eastern Time</th></tr></thead>
        <tbody>
          <tr><td>UTC Offset</td><td>UTC-7</td><td>EDT is UTC-4; EST is UTC-5</td></tr>
          <tr><td>Practical Time Difference</td><td colspan="2">PDT is 3 hours behind EDT during the daylight-saving season.</td></tr>
          <tr><td>Major Cities</td><td>Los Angeles, San Francisco, Seattle, Las Vegas</td><td>New York, Boston, Miami, Washington, DC</td></tr>
          <tr><td>DST Rules</td><td>Uses PDT from spring to fall</td><td>Uses EDT from spring to fall and EST in winter</td></tr>
          <tr><td>Business Usage</td><td>West Coast product, media, and engineering teams</td><td>East Coast clients, finance, operations, and leadership teams</td></tr>
        </tbody>
      </table>
    </div>
    <p>Strictly speaking, PDT and EST are two hours apart by UTC offset. For the real-world situation people usually mean by “PDT to EST,” Eastern locations are on EDT, making the scheduling gap three hours.</p>
  </section>

  <section class="content" aria-labelledby="coast-examples-title">
    <h2 id="coast-examples-title">Coast-to-Coast Scheduling Examples</h2>
    <article><h3>Los Angeles to New York</h3><p>A 9 AM PDT kickoff for a Los Angeles creative team lands at 12 PM EDT in New York. It works well for a midday campaign review before New York afternoon meetings begin.</p></article>
    <article><h3>San Francisco to Boston</h3><p>A San Francisco engineering demo at 10 AM PDT becomes 1 PM EDT in Boston, leaving both teams enough runway for questions and follow-up tasks that same day.</p></article>
    <article><h3>Seattle to Miami</h3><p>A Seattle support handoff at 8 AM PDT arrives at 11 AM EDT in Miami, a useful window for resolving priority cases before the Eastern lunch hour.</p></article>
    <article><h3>Las Vegas to Washington, DC</h3><p>A 2 PM PDT stakeholder update from Las Vegas is 5 PM EDT in Washington, DC. Keep it concise, because it reaches the far edge of the Eastern workday.</p></article>
  </section>

  <section class="examples-section" aria-labelledby="meeting-planner-title">
    <h2 id="meeting-planner-title">PDT to EST Meeting Planner</h2>
    <p>The most reliable shared business window is <strong>9 AM PDT to 2 PM PDT</strong>, which is <strong>12 PM EDT to 5 PM EDT</strong>. It gives West Coast teams a productive morning and East Coast teams a usable afternoon.</p>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Pacific Time</th><th>Eastern Time</th><th>Planning note</th></tr></thead>
        <tbody>
          <tr><td>9 AM PDT</td><td>12 PM EDT</td><td>Best first overlap hour</td></tr>
          <tr><td>10 AM PDT</td><td>1 PM EDT</td><td>Strong collaboration slot</td></tr>
          <tr><td>11 AM PDT</td><td>2 PM EDT</td><td>Good for working sessions</td></tr>
          <tr><td>12 PM PDT</td><td>3 PM EDT</td><td>Useful for client reviews</td></tr>
          <tr><td>1 PM PDT</td><td>4 PM EDT</td><td>Good for decision meetings</td></tr>
          <tr><td>2 PM PDT</td><td>5 PM EDT</td><td>Last comfortable recurring slot</td></tr>
        </tbody>
      </table>
    </div>
    <figure class="pdt-wide-figure reveal">
      <picture>
        <source type="image/avif" srcset="/assets/pdt-to-est-meeting-planner-600.avif 600w, /assets/pdt-to-est-meeting-planner-1200.avif 1200w" sizes="(max-width: 860px) 92vw, 1180px" />
        <source type="image/webp" srcset="/assets/pdt-to-est-meeting-planner-600.webp 600w, /assets/pdt-to-est-meeting-planner-1200.webp 1200w" sizes="(max-width: 860px) 92vw, 1180px" />
        <img width="1200" height="800" src="/assets/pdt-to-est-meeting-planner-1200.webp" alt="West Coast to East Coast meeting planner for Pacific and Eastern Time teams" loading="lazy" decoding="async" />
      </picture>
      <figcaption>Build recurring meetings around the part of the day both coasts can use well.</figcaption>
    </figure>
  </section>

  <section class="content" aria-labelledby="dst-title">
    <h2 id="dst-title">Daylight Saving Time: PDT to EDT</h2>
    <article><h3>The active summer offsets</h3><p><strong>PDT = UTC-7</strong> and <strong>EDT = UTC-4</strong>. The difference remains three hours, so a Pacific invite remains three hours later for Eastern participants while both zones observe daylight saving time.</p></article>
    <article><h3>Why the date still matters</h3><p>North American daylight-saving changes normally occur on the same weekends, but calendar invites, travel, and global participants can make shorthand risky. The converter checks the selected date and gives the active named-zone result.</p></article>
    <figure class="pdt-wide-figure reveal">
      <picture>
        <source type="image/avif" srcset="/assets/pdt-to-est-daylight-saving-guide-600.avif 600w, /assets/pdt-to-est-daylight-saving-guide-1200.avif 1200w" sizes="(max-width: 860px) 92vw, 1180px" />
        <source type="image/webp" srcset="/assets/pdt-to-est-daylight-saving-guide-600.webp 600w, /assets/pdt-to-est-daylight-saving-guide-1200.webp 1200w" sizes="(max-width: 860px) 92vw, 1180px" />
        <img width="1200" height="800" src="/assets/pdt-to-est-daylight-saving-guide-1200.webp" alt="Pacific and Eastern daylight saving time guide showing clocks moving together while three hours apart" loading="lazy" decoding="async" />
      </picture>
      <figcaption>Both zones shift for daylight saving time while keeping the summer three-hour difference.</figcaption>
    </figure>
  </section>

  <section class="faq" aria-labelledby="faq-title">
    <h2 id="faq-title">PDT to EST FAQs</h2>
    {faqItems.map((item) => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}
  </section>

  <section class="other-tools" aria-labelledby="related-tools-title">
    <h2 id="related-tools-title">Related Time Zone Tools</h2>
    <div class="related-grid">
      <article class="related-card"><h3><a href="/cdt-to-est/">CDT to EST converter</a></h3><p>Compare Central and Eastern schedules when a one-hour shift is all you need.</p></article>
      <article class="related-card"><h3><a href="/cst-to-est/">CST to EST converter</a></h3><p>Plan winter Central-to-Eastern appointments with standard-time labels.</p></article>
      <article class="related-card"><h3><a href="/est-to-gmt/">EST to GMT converter</a></h3><p>Reverse the direction when an Eastern meeting needs a GMT-friendly time.</p></article>
      <article class="related-card"><h3><a href="/time-zone-guide/">Time zone guide</a></h3><p>Review abbreviations, daylight saving rules, and date-aware scheduling basics.</p></article>
      <article class="related-card"><h3><a href="/">GMT to EST Converter</a></h3><p>Use the main tool for GMT-to-Eastern schedules and international planning.</p></article>
    </div>
  </section>
</BaseLayout>

<style>
  .pdt-hero {
    align-items: start;
  }

  .pdt-breadcrumb {
    display: flex;
    gap: 8px;
    align-items: center;
    width: min(1180px, calc(100% - 32px));
    margin: 18px auto -22px;
    color: var(--muted);
    font-size: .9rem;
  }

  .pdt-breadcrumb a {
    color: var(--accent);
    font-weight: 800;
  }

  .pdt-hero h2 {
    margin: 0 0 14px;
    font-size: clamp(1.65rem, 3.5vw, 2.6rem);
    line-height: 1.12;
  }

  .pdt-live-clocks {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin: 22px 0 14px;
  }

  .pdt-live-clocks > div {
    display: grid;
    gap: 4px;
    min-height: 96px;
    padding: 14px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--panel);
  }

  .pdt-live-clocks span,
  .pdt-live-clocks em {
    color: var(--muted);
    font-size: .82rem;
    font-style: normal;
    font-weight: 800;
  }

  .pdt-live-clocks strong {
    font-size: clamp(1.35rem, 3vw, 2rem);
    line-height: 1;
  }

  .pdt-trust-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    margin: 0;
    padding: 0;
    color: var(--text);
    font-size: .9rem;
    font-weight: 800;
    list-style: none;
  }

  .pdt-trust-list li::before {
    content: "";
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 7px;
    border-radius: 999px;
    background: var(--accent);
  }

  .pdt-quick-table {
    padding-top: 14px;
  }

  .pdt-step-grid {
    margin-top: 18px;
  }

  .pdt-step-grid .step {
    margin-bottom: 14px;
  }

  .pdt-wide-figure {
    margin: 20px 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--panel);
  }

  .pdt-wide-figure img {
    width: 100%;
    height: auto;
  }

  .pdt-wide-figure figcaption {
    padding: 10px 14px;
    color: var(--muted);
    font-size: .9rem;
  }

  .pdt-answer-grid article h2 {
    margin-bottom: 10px;
    font-size: clamp(1.25rem, 2.5vw, 1.65rem);
  }

  @media (max-width: 640px) {
    .pdt-live-clocks {
      grid-template-columns: 1fr;
    }
  }
</style>
