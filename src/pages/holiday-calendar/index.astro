    margin-top: 20px;
    color: var(--text);
  }
  
  .prose p {
    margin-bottom: 16px;
    color: var(--muted);
  }
  
  .prose ul {
    color: var(--muted);
    margin-bottom: 24px;
  }
  
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 800px;
  }
  
  .faq-item {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 12px 16px;
  }
  
