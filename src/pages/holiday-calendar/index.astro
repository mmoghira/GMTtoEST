---
import BaseLayout from "theme/layouts/BaseLayout.astro";

const lang = "en";
const dir = "ltr";
const slug = "holiday-calendar";
const seoTitle = "Holiday Calendar — Public Holidays for 40+ Countries (2025–2030)";
const pageDescription = "Explore public and bank holidays for over 40 countries from 2025 to 2030. Export to ICS, calculate working days, and plan global business operations.";

const pubDate = "2026-07-30T15:00:00+05:00";
const updatedDate = "2026-07-30T15:00:00+05:00";

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "holiday calendar, international public holidays, bank holidays 2025 2026, global business scheduling, working days calculator, download ICS holidays",
  pubDate,
  updatedDate,
  author: "Time Intelligence Team",
  faqs: [
    {
      q: "What countries are included in this holiday calendar?",
      a: "Our calendar includes over 40 major countries, spanning North America (US, Canada, Mexico), Europe (UK, Germany, France, Italy, Spain, etc.), Asia (Japan, China, India, South Korea, etc.), South America (Brazil), Africa (South Africa, Nigeria, Egypt, Kenya), and Oceania (Australia, New Zealand)."
    },
    {
      q: "Are these holidays considered non-working days?",
      a: "Yes, the holidays listed in this calendar are generally recognized as national public holidays or statutory holidays where most businesses and financial markets are closed. However, regional variations exist."
    },
    {
      q: "Can I download these holidays to my personal calendar?",
      a: "Yes! You can click the 'Export ICS' button to download a standard .ics file for the selected country and year. This file can be imported into Google Calendar, Outlook, Apple Calendar, and other popular calendar applications."
    },
    {
      q: "How do you calculate the number of working days?",
      a: "We calculate working days by starting with the total number of days in the month or year, subtracting all weekends (Saturdays and Sundays for most countries), and then subtracting any public holidays that fall on a weekday."
    },
    {
      q: "Does the calendar account for substitute holidays?",
      a: "Yes. For many countries, if a major public holiday (like Christmas or Independence Day) falls on a weekend, a substitute weekday (usually Monday) is observed as a day off. Our algorithmic generation handles standard substitution rules."
    },
    {
      q: "Why are some holidays missing from my country?",
      a: "To keep the tool streamlined for global business scheduling, we focus on nationwide, statutory public holidays. Regional or state-specific holidays (like State holidays in the US or territory holidays in Australia) might not be included unless they have nationwide impact."
    },
    {
      q: "How far into the future does the calendar go?",
      a: "The tool is currently programmed to provide accurate public holiday data from 2025 through the end of 2030, allowing for long-term project planning and contract scheduling."
    },
    {
      q: "Is there an API available for this holiday data?",
      a: "Currently, we provide the data via this interactive web tool and downloadable ICS files. We are exploring a REST API for enterprise users in the future."
    },
    {
      q: "What is the difference between a Bank Holiday and a Public Holiday?",
      a: "In the UK and some Commonwealth countries, 'Bank Holiday' is the legal term for a public holiday because banks and many businesses close. In practice, for business scheduling, they are functionally identical to public holidays."
    },
    {
      q: "Do you track religious holidays?",
      a: "We track religious holidays only if they are legally recognized as national public holidays in the respective country (e.g., Christmas in the US, Eid al-Fitr in the UAE, Diwali in India). Purely observant religious holidays without legal day-off status are not included to maintain focus on business scheduling."
    }
  ]
};
---

<BaseLayout
  lang={lang}
  dir={dir}
  title={seoTitle}
  description={pageDescription}
  slug={slug}
  meta={meta}
  enableFaqSchema={true}
  enableArticleSchema={true}
>
  <div class="hero-banner">
    <div class="hero-banner-title">
      <h1>International <span class="gradient-text">Holiday Calendar</span></h1>
    </div>
    <p style="color: #fff; margin-top: 20px; font-size: 1.2rem;">Public Holidays & Working Days for 40+ Countries (2025–2030)</p>
  </div>

  <section class="calendar-tool">
    <div class="card tool-container">
      
      <div class="controls-panel">
        <div class="selectors">
          <div class="input-group">
            <label for="country-select">Country:</label>
            <select id="country-select">
              <!-- Populated via JS -->
            </select>
          </div>
          
          <div class="input-group">
            <label for="year-select">Year:</label>
            <select id="year-select">
              <option value="2025">2025</option>
              <option value="2026" selected>2026</option>
              <option value="2027">2027</option>
              <option value="2028">2028</option>
              <option value="2029">2029</option>
              <option value="2030">2030</option>
            </select>
          </div>
        </div>
        
        <div class="export-actions">
          <button id="export-ics-btn" class="btn-primary">
            Export Year as .ICS
          </button>
        </div>
      </div>

      <div class="stats-bar">
        <div class="stat-item">
          <span class="stat-label">Total Holidays (Year):</span>
          <span class="stat-value" id="stat-yearly-holidays">--</span>
        </div>
        <div class="stat-item">
          <span class="stat-label">Working Days (Year):</span>
          <span class="stat-value" id="stat-yearly-workdays">--</span>
        </div>
        <div class="stat-item">
          <span class="stat-label">Working Days (Month):</span>
          <span class="stat-value" id="stat-monthly-workdays">--</span>
        </div>
      </div>

      <div class="calendar-wrapper">
        <div class="month-nav">
          <button id="prev-month-btn" class="btn-icon" aria-label="Previous Month">←</button>
          <h2 id="current-month-display">January 2026</h2>
          <button id="next-month-btn" class="btn-icon" aria-label="Next Month">→</button>
        </div>
        
        <div class="calendar-grid">
          <div class="day-header">Sun</div>
          <div class="day-header">Mon</div>
          <div class="day-header">Tue</div>
          <div class="day-header">Wed</div>
          <div class="day-header">Thu</div>
          <div class="day-header">Fri</div>
          <div class="day-header">Sat</div>
          <!-- Days populated via JS -->
        </div>
      </div>
      
      <div class="month-holidays-list">
        <h3>Holidays in <span id="list-month-name">January</span></h3>
        <ul id="holidays-ul">
          <!-- Populated via JS -->
        </ul>
      </div>

    </div>
  </section>

  <section class="educational-content">
    <h2>International Holiday Planning Guide</h2>
    <article class="prose">
      <p>When operating a global business or managing a distributed team, understanding international holidays is critical. A day that is a standard Tuesday in New York might be a major national holiday in Tokyo, meaning banks are closed, emails go unanswered, and project timelines can slip if not properly accounted for. This comprehensive guide and our interactive tool are designed to bridge that gap.</p>

      <h3>How Holidays Affect Global Business Scheduling</h3>
      <p>Public holidays disrupt the standard business rhythm. Here are the primary areas impacted:</p>
      <ul>
        <li><strong>Financial Transactions:</strong> Cross-border payments often rely on the SWIFT network and correspondent banks. If it's a bank holiday in the country of the intermediary bank (often the US or UK), your transaction may be delayed by a day or more, even if neither the sending nor receiving country is on holiday.</li>
        <li><strong>Supply Chain Logistics:</strong> Customs offices, ports, and freight forwarders observe national holidays. A shipment arriving in China during the Golden Week (early October) or the Lunar New Year will experience significant delays.</li>
        <li><strong>Project Deadlines:</strong> When assigning tasks to international team members, assuming a standard 5-day work week can lead to missed deadlines. You must factor in local holidays to accurately estimate working days.</li>
        <li><strong>Customer Support:</strong> If you offer 24/7 support but route overflow traffic to an offshore team in India or the Philippines, you need to be aware of their major holidays (like Diwali or Holy Week) to ensure adequate staffing.</li>
      </ul>

      <h3>Understanding Working Day Calculations</h3>
      <p>A "working day" or "business day" is typically defined as any day from Monday through Friday that is not a public holiday. However, this simple definition has global exceptions:</p>
      <ul>
        <li><strong>Weekend Variations:</strong> While the Monday-Friday work week is common, it is not universal. Many countries in the Middle East, such as the UAE (historically, though they recently shifted), Saudi Arabia, and Israel, observe a Sunday-Thursday work week. Our tool currently assumes a Saturday-Sunday weekend for standardization, but this is an important nuance to remember for the MENA region.</li>
        <li><strong>Substitute Holidays (Observances):</strong> If a fixed-date holiday like Christmas (December 25) falls on a Saturday or Sunday, many countries (including the US, UK, and Canada) will observe the holiday on the preceding Friday or following Monday. This ensures workers do not "lose" a day off. Our calendar logic specifically calculates these substitute days.</li>
        <li><strong>Bridge Days:</strong> In many European and Latin American countries, if a public holiday falls on a Tuesday or Thursday, employees frequently take the Monday or Friday off to create a long weekend. While not official public holidays, these "bridge days" (puentes in Spanish) drastically reduce business productivity.</li>
      </ul>

      <h3>Regional Holiday Overviews</h3>
      
      <h4>North America</h4>
      <p>The US observes federal holidays, but private employers aren't legally mandated to offer them all. The big six are New Year's, Memorial Day, Independence Day, Labor Day, Thanksgiving, and Christmas. Canada has statutory holidays, with variations per province (e.g., St. Jean Baptiste Day in Quebec). Mexico has mandated rest days, including Constitution Day and Revolution Day.</p>

      <h4>Europe</h4>
      <p>Europe generally enjoys a high number of public holidays. The UK relies on "Bank Holidays." France and Germany have significant regional variations, especially in Germany where Catholic states (like Bavaria) have more holidays (like Corpus Christi) than northern states. Common European holidays include Easter Monday, Ascension Day, Whit Monday, and Assumption of Mary.</p>

      <h4>Asia-Pacific</h4>
      <p>Asia features major cultural and lunar-based holidays. China has two massive "Golden Weeks": Lunar New Year (Jan/Feb) and National Day (Oct 1). During these weeks, business largely halts. Japan has 16 national holidays, including Golden Week in late April/early May. India has three national holidays (Republic Day, Independence Day, Gandhi Jayanti), but dozens of regional and religious holidays depending on the state.</p>

      <h3>Integration with Other Tools</h3>
      <p>To maximize your team's efficiency, use this holiday calendar in conjunction with our other time intelligence tools. Use the <a href="/business-hours-overlap/">Business Hours Overlap</a> tool to find daily meeting times, the <a href="/meeting-planner/">Meeting Planner</a> to schedule specific events while avoiding holidays, and the <a href="/world-clock/">World Clock</a> for real-time tracking. If you are flying out to meet a client, don't forget to check the <a href="/travel-planner/">Travel Planner</a>.</p>
    </article>
  </section>

  <section id="faq" class="faq-section">
    <h2>Frequently Asked Questions</h2>
    <div class="faq-list">
      {meta.faqs.map(faq => (
        <details class="faq-item">
          <summary>{faq.q}</summary>
          <div class="faq-answer"><p>{faq.a}</p></div>
        </details>
      ))}
    </div>
  </section>

  <section class="related-tools">
    <h2>Related Tools</h2>
    <div class="tools-grid">
      <a href="/meeting-planner/" class="tool-card">
        <h3>Meeting Planner</h3>
        <p>Schedule meetings considering time zones and holidays.</p>
      </a>
      <a href="/business-hours-overlap/" class="tool-card">
        <h3>Business Hours Overlap</h3>
        <p>Find the best daily times for global team collaboration.</p>
      </a>
      <a href="/travel-planner/" class="tool-card">
        <h3>Travel Planner</h3>
        <p>Manage time zones and jet lag for international travel.</p>
      </a>
      <a href="/world-clock/" class="tool-card">
        <h3>World Clock</h3>
        <p>View current local times in major cities worldwide.</p>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
