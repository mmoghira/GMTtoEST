    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  
  .input-group label {
    font-size: 0.9rem;
    color: var(--muted);
    font-weight: bold;
  }
  
  select {
    padding: 10px 16px;
    border-radius: 6px;
    border: 1px solid var(--line);
    background: var(--bg);
    color: var(--text);
    min-width: 200px;
  }
  
  button {
    padding: 10px 20px;
    border-radius: 6px;
    border: none;
    cursor: pointer;
    font-weight: bold;
    transition: background 0.2s;
  }
  
  .btn-primary {
    background: var(--accent);
    color: #fff;
  }
  
  .btn-primary:hover {
    background: var(--accent-2);
  }
  
  .btn-icon {
    background: var(--line);
    color: var(--text);
    padding: 8px 16px;
    font-size: 1.2rem;
  }
  
  .btn-icon:hover {
    background: var(--muted);
    color: var(--bg);
  }
  
  .stats-bar {
    display: flex;
    gap: 24px;
    background: color-mix(in srgb, var(--bg) 50%, var(--panel));
    padding: 16px;
    border-radius: 8px;
    margin-bottom: 24px;
    border: 1px solid var(--line);
    flex-wrap: wrap;
  }
  
  .stat-item {
    display: flex;
    flex-direction: column;
  }
  
  .stat-label {
    font-size: 0.8rem;
    color: var(--muted);
    text-transform: uppercase;
  }
  
  .stat-value {
    font-size: 1.5rem;
    font-weight: bold;
    color: var(--accent);
  }
  
  .calendar-wrapper {
    margin-bottom: 32px;
  }
  
  .month-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
  }
  
  .month-nav h2 {
    margin: 0;
    color: var(--text);
  }
  
  .calendar-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 4px;
  }
  
  .day-header {
    text-align: center;
    font-weight: bold;
    padding: 8px;
    background: var(--bg);
    border-radius: 4px;
    color: var(--muted);
  }
  
  .day-cell {
    min-height: 80px;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 4px;
