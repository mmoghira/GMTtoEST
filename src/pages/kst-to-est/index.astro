];

function hourLabel(hour: number) {
  const suffix = hour >= 12 ? "PM" : "AM";
  const display = hour % 12 || 12;
  return `${display}:00 ${suffix}`;
}

function easternFromKst(hour: number, difference: number) {
  const easternHour = (hour - difference + 24) % 24;
  const day = hour < difference ? "previous day" : "same date";
  return `${hourLabel(easternHour)} ${day}`;
}

const hourlyRows = Array.from({ length: 24 }, (_, hour) => ({
  kst: hourLabel(hour),
  est: easternFromKst(hour, 14),
  edt: easternFromKst(hour, 13)
}));

