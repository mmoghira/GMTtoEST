---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import Converter from "theme/components/Converter.astro";
import { getTranslation, pageUrl, siteUrl } from "theme/i18n/config";

const lang = "en";
const dir = "ltr";
const slug = "gmt-to-eet";
const t = getTranslation(lang);

const pageTitle = "GMT to EET Converter";
const seoTitle = "GMT to EET Converter – Greenwich Mean Time to Eastern European Time";
const pageDescription = "Convert GMT to EET instantly. Find the current time difference between Greenwich Mean Time (UTC+0) and Eastern European Time (UTC+2), with Athens and Helsinki clocks.";

const context = {
  from: "GMT",
  to: "EET",
  fromZone: "UTC",
  toZone: "Europe/Athens"
};

const canonical = `${siteUrl}/gmt-to-eet/`;

// 24-hour conversion table data (GMT → EET = GMT + 2)
function formatHour12(hour: number) {
  const normalized = ((hour % 24) + 24) % 24;
  const period = normalized < 12 ? "AM" : "PM";
  const displayHour = normalized % 12 || 12;
  return `${displayHour}:00 ${period}`;
}

const conversionRows = Array.from({ length: 24 }, (_, hour) => {
  const eetHour = hour + 2;
  const eetNormalized = ((eetHour % 24) + 24) % 24;
  const nextDay = eetHour >= 24;
  const period = eetNormalized < 12 ? "AM" : "PM";
  const displayHour = eetNormalized % 12 || 12;
  return {
    gmt: formatHour12(hour),
    eet: `${displayHour}:00 ${period}${nextDay ? " (+1 day)" : ""}`,
    dayNote: nextDay ? "Next day" : "Same day"
  };
});

// Popular conversions
const popularConversions = [
  { gmt: "12:00 AM (Midnight)", eet: "2:00 AM EET", note: "Late night in Athens, midnight in Greenwich" },
  { gmt: "2:00 AM", eet: "4:00 AM EET", note: "Pre-dawn hours in Finland, middle of the night in London" },
  { gmt: "4:00 AM", eet: "6:00 AM EET", note: "Dawn in Kyiv, early morning in Greenwich" },
  { gmt: "6:00 AM", eet: "8:00 AM EET", note: "Workday beginning in Romania, morning in Greenwich" },
  { gmt: "8:00 AM", eet: "10:00 AM EET", note: "Mid-morning focus in Athens, morning starting in Greenwich" },
  { gmt: "10:00 AM", eet: "12:00 PM (Noon) EET", note: "Lunch break in Helsinki, mid-morning in Greenwich" },
  { gmt: "12:00 PM (Noon)", eet: "2:00 PM EET", note: "Afternoon productivity in Bucharest, noon in Greenwich" },
  { gmt: "2:00 PM", eet: "4:00 PM EET", note: "Late afternoon for Eastern Europe teams, afternoon in Greenwich" },
  { gmt: "4:00 PM", eet: "6:00 PM EET", note: "Standard offices closing in Athens, UK offices winding down" },
  { gmt: "6:00 PM", eet: "8:00 PM EET", note: "Evening relaxation in Finland, evening in Greenwich" },
  { gmt: "8:00 PM", eet: "10:00 PM EET", note: "Bedtime in Kyiv, night in London" },
  { gmt: "10:00 PM", eet: "12:00 AM (Midnight) EET", note: "Midnight in Romania, late night in Greenwich" }
];

// FAQ data
const faqs = [
  { q: "What is EET?", a: "EET stands for Eastern European Time. It is the winter standard time zone observed in parts of Eastern Europe, the Middle East, and North Africa, running exactly 2 hours ahead of Coordinated Universal Time (UTC+2) and Greenwich Mean Time (GMT+2)." },
  { q: "What is the difference between EET and EEST?", a: "EET is Eastern European Time (UTC+2), used in winter. EEST is Eastern European Summer Time (UTC+3), used during the summer daylight saving months." },
  { q: "How many hours ahead of GMT is EET?", a: "EET is exactly 2 hours ahead of Greenwich Mean Time (GMT). For example, when it is 10:00 AM GMT in London, it is 12:00 PM (Noon) EET in Athens." },
  { q: "Does EET observe daylight saving?", a: "Yes. Most countries observing EET shift forward by 1 hour to EEST (UTC+3) from the last Sunday in March to the last Sunday in October." },
  { q: "Which countries use EET?", a: "Countries observing EET in winter include Greece, Finland, Romania, Bulgaria, Ukraine, Cyprus, Moldova, Estonia, Latvia, and Lithuania." },
  { q: "What is 6 PM GMT in EET?", a: "6:00 PM GMT converts to 8:00 PM EET on the same calendar day." },
  { q: "Can I manually convert GMT to EET?", a: "Yes. Add 2 hours to the GMT clock. For example, 3:00 PM GMT + 2 hours = 5:00 PM EET. If the target date falls during the summer, add 3 hours for EEST." },
  { q: "How accurate is this GMT to EET converter?", a: "Our converter utilizes the canonical IANA Time Zone Database (specifically the Europe/Athens ruleset), ensuring complete accuracy across all calendar dates." },
  { q: "Is EET the same as UTC+2?", a: "Yes. Eastern European Time runs exactly 2 hours ahead of UTC, represented as UTC+2." },
  { q: "Does Athens use EET?", a: "Yes. Athens, Greece, observes EET (UTC+2) in winter and EEST (UTC+3) in summer." },
  { q: "Does Helsinki use EET?", a: "Yes. Helsinki, Finland, observes EET (UTC+2) in winter and EEST (UTC+3) in summer." },
  { q: "Does Bucharest use EET?", a: "Yes. Bucharest, Romania, observes EET (UTC+2) in winter and EEST (UTC+3) in summer." },
  { q: "Does Sofia use EET?", a: "Yes. Sofia, Bulgaria, observes EET (UTC+2) in winter and EEST (UTC+3) in summer." },
  { q: "Does Kyiv use EET?", a: "Yes. Kyiv, Ukraine, observes EET (UTC+2) in winter and EEST (UTC+3) in summer." },
  { q: "What is the IANA identifier for Eastern Europe?", a: "Common IANA time zone identifiers for regions observing EET/EEST include Europe/Athens, Europe/Helsinki, Europe/Bucharest, and Europe/Kyiv." },
  { q: "Do computer networks use EET?", a: "Servers typically run on UTC (GMT) to ensure database consistency. User applications then translate these timestamps to local EET offsets for display." },
  { q: "What is 12 AM GMT in Athens local time?", a: "12:00 AM (Midnight) GMT is equal to 2:00 AM EET on the same day in Athens." },
  { q: "Why is EET used in Eastern Europe?", a: "The EET time zone is structured to align daylight hours with civil schedules across eastern European longitude belts." },
  { q: "Does Cyprus follow EET?", a: "Yes. Cyprus observes EET (UTC+2) in winter and EEST (UTC+3) in summer." },
  { q: "Does Moldova follow EET?", a: "Yes. Moldova observes EET (UTC+2) in winter and EEST (UTC+3) in summer." },
  { q: "Do the Baltic states observe EET?", a: "Yes. Estonia, Latvia, and Lithuania observe EET (UTC+2) in winter and EEST (UTC+3) in summer." },
  { q: "What offset is GMT+2?", a: "GMT+2 represents an offset 2 hours ahead of Greenwich Mean Time. This matches the offset of EET during standard winter months." },
  { q: "When does EET end each year?", a: "EET ends on the last Sunday of March at 2:00 AM local time, when clocks move forward to 3:00 AM EEST." },
  { q: "When does EET begin each year?", a: "EET begins on the last Sunday of October at 4:00 AM local time, when clocks fall back to 3:00 AM EET." },
  { q: "Can this converter help with remote team planning?", a: "Yes. The meeting planner helps identify viable crossover business hours between Greenwich Mean Time and Eastern Europe." }
];

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "GMT to EET, GMT to Eastern European Time, Greenwich Mean Time to Eastern European Time, GMT EET Converter, Convert GMT to EET, GMT to Europe Time, Current EET Time, GMT UTC to EET, Eastern European Time Converter, GMT to Athens Time, GMT to Helsinki Time, GMT to Bucharest Time, GMT to Kyiv Time, GMT to Sofia Time, Time Difference GMT and EET",
  image: "/assets/gmt-to-eet-og.svg",
  imageAlt: "GMT to EET Converter – Convert Greenwich Mean Time to Eastern European Time",
  faqs,
  appDescription: "Free online GMT to EET converter with real-time clocks, DST-aware calculation, 24-hour conversion chart, and meeting planner for scheduling between Greenwich Mean Time and Eastern European Time.",
  applicationCategory: "UtilityApplication",
  operatingSystem: "Any",
  howToName: "How to Convert GMT to EET",
  howToDescription: "Step-by-step guide to converting Greenwich Mean Time to Eastern European Time using our free online tool.",
  howToSteps: [
    { name: "Verify the season in Eastern Europe", text: "EET (UTC+2) is observed from the last Sunday of October to the last Sunday of March. In the remaining months, Eastern Europe uses EEST (UTC+3)." },
    { name: "Input your GMT time", text: "Select your desired GMT time using our interactive date and time picker. The tool defaults to the current time." },
    { name: "Check the offset results", text: "Our calculator checks the date and displays the result in EET (+2 offset) or EEST (+3 offset) based on Europe's daylight saving calendar." },
    { name: "Copy or swap the result", text: "Read the equivalent Athens/Helsinki time and click the copy button to save the conversion result." }
  ],
};
---

<BaseLayout
