        <rect x="-45" y="-35" width="90" height="26" rx="13" fill="#1b536e" />
        <text x="0" y="-17" font-family="'Manrope', sans-serif" font-size="12" font-weight="800" fill="#36c7b5" text-anchor="middle">+2 HOURS</text>
      </g>

      <g transform="translate(500, 100)">
        <circle cx="0" cy="0" r="60" fill="#12455d" stroke="#36c7b5" stroke-width="4" />
        <!-- EET is +2 hours, so hands point in same direction but PM/AM is swapped -->
        <line x1="0" y1="0" x2="0" y2="-45" stroke="#f4fbff" stroke-width="4" stroke-linecap="round" />
        <line x1="0" y1="0" x2="0" y2="-45" stroke="#8fd7ff" stroke-width="3" stroke-linecap="round" />
