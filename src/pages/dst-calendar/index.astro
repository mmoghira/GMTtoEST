  .filter-controls input {
    padding: 0.5rem;
    border-radius: 4px;
    border: 1px solid var(--line);
    background: var(--bg);
    color: var(--text);
    margin-left: 1rem;
  }
  .ics-btn {
    background: var(--accent);
    color: #fff;
    border: none;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    cursor: pointer;
    font-size: 0.8rem;
    margin-left: 0.5rem;
  }
  .cross-link-card {
    background: var(--panel);
    border: 1px solid var(--line);
    padding: 1rem;
    border-radius: 8px;
    text-align: center;
    color: var(--text);
    font-weight: bold;
    text-decoration: none;
    transition: transform 0.2s;
  }
  .cross-link-card:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
  }
