<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Search Filter
    const searchInput = document.getElementById('tableSearch');
    const tableRows = document.querySelectorAll('#dstTable tbody tr');
    
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const term = (e.target as HTMLInputElement).value.toLowerCase();
        tableRows.forEach(row => {
          const text = row.textContent?.toLowerCase() || '';
          (row as HTMLElement).style.display = text.includes(term) ? '' : 'none';
        });
      });
    }

    // Countdown Logic
    const upcomingDates = [
      { date: new Date('2026-03-08T07:00:00Z'), label: 'US DST Start' },
      { date: new Date('2026-03-29T01:00:00Z'), label: 'EU Summer Time Start' },
      { date: new Date('2026-10-25T01:00:00Z'), label: 'EU Summer Time End' },
      { date: new Date('2026-11-01T06:00:00Z'), label: 'US DST End' },
      { date: new Date('2027-03-14T07:00:00Z'), label: 'US DST Start (2027)' }
    ];

    function updateCountdown() {
      const now = new Date();
      let nextTransition = null;
      for (let i = 0; i < upcomingDates.length; i++) {
        if (upcomingDates[i].date > now) {
          nextTransition = upcomingDates[i];
          break;
        }
      }

      if (nextTransition) {
        const diff = nextTransition.date.getTime() - now.getTime();
        const d = Math.floor(diff / (1000 * 60 * 60 * 24));
        const h = Math.floor((diff / (1000 * 60 * 60)) % 24);
        const m = Math.floor((diff / 1000 / 60) % 60);
        const s = Math.floor((diff / 1000) % 60);
        
        const elDays = document.getElementById('cd-days');
        const elHrs = document.getElementById('cd-hours');
        const elMins = document.getElementById('cd-mins');
        const elSecs = document.getElementById('cd-secs');
        const elTarget = document.getElementById('cd-target-text');

        if (elDays) elDays.textContent = d.toString().padStart(2, '0');
        if (elHrs) elHrs.textContent = h.toString().padStart(2, '0');
        if (elMins) elMins.textContent = m.toString().padStart(2, '0');
        if (elSecs) elSecs.textContent = s.toString().padStart(2, '0');
        if (elTarget) elTarget.textContent = 'Next: ' + nextTransition.label;
      }
    }
    setInterval(updateCountdown, 1000);
    updateCountdown();

    // ICS Generator
    document.querySelectorAll('.ics-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const dateStr = target.getAttribute('data-date');
        const titleStr = target.getAttribute('data-title');
        if (dateStr && titleStr) {
          const icsContent = `BEGIN:VCALENDAR\nVERSION:2.0\nBEGIN:VEVENT\nDTSTART:${dateStr}\nSUMMARY:${titleStr}\nEND:VEVENT\nEND:VCALENDAR`;
          const blob = new Blob([icsContent], { type: 'text/calendar' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = titleStr.replace(/\\s+/g, '_') + '.ics';
          a.click();
          URL.revokeObjectURL(url);
        }
      });
    });
  });
</script>
