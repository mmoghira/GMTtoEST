---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import { siteUrl } from "theme/i18n/config";
import RelatedConvertersWidget from "theme/components/RelatedConvertersWidget.astro";
import UsersAlsoVisitWidget from "theme/components/UsersAlsoVisitWidget.astro";
import LearnMoreWidget from "theme/components/LearnMoreWidget.astro";
import CountryCityWidget from "theme/components/CountryCityWidget.astro";

const lang = "en";
const dir = "ltr";
const slug = "unix-time-explained";
const seoTitle = "Unix Time Explained: Epoch Seconds, Converter & Developers Guide";
const pageDescription = "Learn Unix time (POSIX / Epoch time). Understand how seconds since Jan 1, 1970 UTC work, 32-bit Year 2038 problem, 64-bit timestamps, and code snippets.";

const pubDate = "2026-07-30T15:00:00+05:00";
const updatedDate = "2026-07-30T15:00:00+05:00";

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "Unix time explained, Epoch timestamp, POSIX time, Jan 1 1970 UTC, Year 2038 problem, Y2K38 overflow, convert Unix timestamp, Unix time code examples",
  image: "/assets/unix-time-epoch-diagram.svg",
  imageAlt: "Unix time epoch timeline and Year 2038 problem diagram",
  pubDate,
  updatedDate,
  author: "Jackie Bruce",
  faqs: [
    {
      q: "What is Unix time (Epoch time)?",
      a: "Unix time (also known as POSIX time or Epoch time) is a system for tracking time expressed as the total number of elapsed seconds since 00:00:00 UTC on Thursday, January 1, 1970 (the Unix Epoch), excluding leap seconds."
    },
    {
      q: "Why was January 1, 1970 chosen as the Unix Epoch?",
      a: "January 1, 1970 was selected arbitrarily by early Bell Labs Unix engineers (Ken Thompson and Dennis Ritchie) as a clean, rounded reference date near the initial development of the Unix operating system."
    },
    {
      q: "Is Unix time affected by timezones or Daylight Saving Time?",
      a: "No. Unix time is strictly referenced to Coordinated Universal Time (UTC). It represents an absolute point in universal time and does not change based on geographic location or local daylight saving shifts."
    },
    {
      q: "What is the Year 2038 problem (Y2K38)?",
      a: "The Year 2038 problem refers to an integer overflow issue in legacy 32-bit signed integer systems storing Unix time. On January 19, 2038 at 03:14:07 UTC, a 32-bit signed integer exceeds its maximum capacity (2,147,483,647) and wraps around to negative numbers (-2,147,483,648), resetting clocks to December 13, 1901."
    },
    {
      q: "How does 64-bit Unix time fix the Year 2038 problem?",
      a: "Modern 64-bit systems use a 64-bit integer to store Unix timestamps. A 64-bit signed integer extends the maximum capacity to over 292 billion years into the future, effectively eliminating overflow risk."
    },
    {
      q: "How does Unix time handle leap seconds?",
      a: "Unix time officially ignores leap seconds. When a positive leap second occurs, the Unix timestamp repeats a second (e.g., 23:59:59 UTC repeats), keeping the integer count strictly matched to standard day lengths (86,400 seconds per day)."
    },
    {
      q: "What is a negative Unix timestamp?",
      a: "A negative Unix timestamp represents a time prior to the January 1, 1970 Epoch. For example, -86,400 represents December 31, 1969 at 00:00:00 UTC."
    },
    {
      q: "How do I get the current Unix timestamp in JavaScript?",
      a: "In JavaScript, use `Math.floor(Date.now() / 1000)` for seconds, or `Date.now()` for milliseconds."
    },
    {
      q: "How do I get the current Unix timestamp in Python?",
      a: "In Python, use `import time; int(time.time())` or `from datetime import datetime, timezone; int(datetime.now(timezone.utc).timestamp())`."
    },
    {
      q: "How do I get the current Unix timestamp in Go?",
      a: "In Go, use `time.Now().Unix()` for seconds, or `time.Now().UnixMilli()` for milliseconds."
    },
    {
      q: "How do I convert a Unix timestamp to human-readable ISO 8601 in SQL?",
      a: "In PostgreSQL, use `to_timestamp(epoch_val) AT TIME ZONE 'UTC'`. In MySQL, use `FROM_UNIXTIME(epoch_val)`."
    },
    {
      q: "What is the difference between Unix time in seconds and milliseconds?",
      a: "Unix time in seconds is a 10-digit integer (e.g., 1785418800). Unix time in milliseconds is a 13-digit integer (e.g., 1785418800000), widely used in JavaScript and Java APIs."
    },
    {
      q: "Why do database systems index Unix timestamps faster than text dates?",
      a: "Integer comparisons require far fewer CPU cycles and memory cache operations than string matching, making numeric Unix timestamps ideal for high-throughput database indexing."
    },
    {
      q: "Can Unix time represent nanosecond precision?",
      a: "Yes. High-performance languages like Go, Rust, and C++ access nanosecond Unix timestamps (19-digit integers) via hardware CPU timers."
    },
    {
      q: "What is the connection between Unix time and UTC?",
      a: "Unix time is derived directly from Coordinated Universal Time (UTC). Every Unix timestamp corresponds to a specific moment on the UTC timeline."
    },
    {
      q: "How does Unix time simplify cross-timezone scheduling?",
      a: "Because Unix timestamps are timezone-independent, systems store timestamps as UTC integers and format local times on the client side using the user's local timezone rules."
    },
    {
      q: "What is the Unix timestamp for 2000-01-01 00:00:00 UTC (Y2K)?",
      a: "The Unix timestamp for Y2K (Jan 1, 2000 00:00:00 UTC) is `946684800`."
    },
    {
      q: "What was the 'Billennium' in Unix time history?",
      a: "The 'Billennium' occurred on September 9, 2001 at 01:46:40 UTC, when the Unix timestamp reached 1,000,000,000 (one billion seconds)."
    },
    {
      q: "How does Network Time Protocol (NTP) interact with Unix time?",
      a: "NTP servers broadcast atomic time references, allowing system kernels to adjust their internal Unix clock counters and prevent time drift."
    },
    {
      q: "Why do log aggregators (like Elasticsearch) standardize on Unix time or ISO 8601?",
      a: "Log aggregators parse incoming log streams from distributed servers across multiple timezones into unified UTC Unix timestamps for real-time alerting."
    }
  ]
};

const pageUrlPath = `${siteUrl}/${slug}/`;

const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    "@id": `${pageUrlPath}#article`,
    "mainEntityOfPage": pageUrlPath,
    "headline": seoTitle,
    "description": pageDescription,
    "datePublished": pubDate,
    "dateModified": updatedDate,
    "inLanguage": "en",
    "author": {
      "@type": "Person",
      "name": "Jackie Bruce",
      "jobTitle": "Senior Time Zone Analyst",
      "url": `${siteUrl}/author/jackie-bruce/`
    },
    "publisher": {
      "@type": "Organization",
      "name": "GMT to EST Converter",
      "logo": {
        "@type": "ImageObject",
        "url": `${siteUrl}/logo.svg`
      }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": `${siteUrl}/`
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Unix Time Explained",
        "item": pageUrlPath
      }
    ]
  }
];
