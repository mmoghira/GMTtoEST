---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import Converter from "theme/components/Converter.astro";
import { getTranslation } from "theme/i18n/config";

const lang = "en";
const dir = "ltr";
const slug = "gmt-to-adt";
const t = getTranslation(lang);

const pageTitle = "GMT to ADT Converter";
const seoTitle = "GMT to ADT Converter – Convert Greenwich Mean Time to Atlantic Daylight Time";
const pageDescription = "Convert GMT to ADT with our free timezone converter. GMT is UTC+0 and ADT is UTC-3, making ADT 3 hours behind GMT. See conversion tables, examples, date changes, and daylight saving details.";

const context = {
  from: "GMT",
  to: "ADT",
  fromZone: "UTC",
  toZone: "America/Halifax"
};

function formatHour12(hour: number) {
  const ampm = hour >= 12 ? "PM" : "AM";
  const h = hour % 12 || 12;
  return `${h}:00 ${ampm}`;
}

// 24-hour table: GMT (UTC+0) → ADT (UTC-3) = subtract 3 hours
const conversionRows = Array.from({ length: 24 }, (_, hour) => {
  let adtHour = hour - 3;
  const prevDay = adtHour < 0;
  if (prevDay) adtHour += 24;
  return {
    gmt: formatHour12(hour),
    adt: `${formatHour12(adtHour)}${prevDay ? " (-1 day)" : ""}`,
    dayNote: prevDay ? "Previous day" : "Same day"
  };
});

const faqs = [
  {
    q: "What is the difference between GMT and ADT?",
    a: "GMT (Greenwich Mean Time) operates at UTC+0 baseline year-round. ADT (Atlantic Daylight Time) operates at UTC-3 during summer Daylight Saving Time. ADT is 3 hours behind GMT."
  },
  {
    q: "Is ADT 3 hours behind GMT?",
    a: "Yes. During Daylight Saving Time (March to November), Atlantic Daylight Time (ADT, UTC-3) is exactly 3 hours behind Greenwich Mean Time (GMT, UTC+0). When it is 12:00 PM (noon) GMT in London, it is 9:00 AM ADT in Halifax, Nova Scotia."
  },
  {
    q: "What does ADT stand for?",
    a: "ADT stands for Atlantic Daylight Time. It is the daylight-saving designation for the Atlantic Time Zone in North America, used during summer months."
  },
  {
    q: "What is ADT in UTC?",
    a: "ADT operates at UTC-3 (Coordinated Universal Time minus 3 hours)."
  },
  {
    q: "How do I convert GMT to ADT?",
    a: "To convert GMT to ADT, subtract 3 hours from the GMT time. For example, 3:00 PM GMT minus 3 hours equals 12:00 PM (noon) ADT."
  },
  {
    q: "Is ADT the same as AST?",
    a: "No. ADT (Atlantic Daylight Time, UTC-3) is observed during summer Daylight Saving Time. AST (Atlantic Standard Time, UTC-4) is observed during winter standard time. ADT is 1 hour ahead of AST."
  },
  {
    q: "Does GMT to ADT conversion change by date?",
    a: "Yes. Early morning GMT hours from 00:00 to 02:59 (12:00 AM to 2:59 AM) fall onto the previous calendar evening in ADT (e.g., 00:00 GMT = 9:00 PM ADT previous day)."
  },
  {
    q: "Can GMT and ADT have different calendar dates?",
    a: "Yes. Because ADT is 3 hours behind GMT, any GMT time between midnight and 2:59 AM corresponds to the previous calendar day in ADT."
  },
  {
    q: "What time is 12 PM GMT in ADT?",
    a: "12:00 PM (noon) GMT is 9:00 AM ADT on the same day."
  },
  {
    q: "What time is midnight GMT in ADT?",
    a: "Midnight (00:00 GMT) is 9:00 PM ADT on the previous day."
  },
  {
    q: "When is ADT used?",
    a: "ADT is used from the second Sunday in March to the first Sunday in November across Atlantic Canadian provinces (Nova Scotia, New Brunswick, Prince Edward Island, parts of Labrador) and Bermuda."
  },
  {
    q: "Should I use ADT or AST for Atlantic Time?",
    a: "Use ADT (UTC-3) during summer Daylight Saving Time (March to November). Use AST (UTC-4) during winter standard time (November to March)."
  }
];

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "gmt to adt, GMT to ADT converter, Greenwich Mean Time to Atlantic Daylight Time, convert GMT to ADT, GMT ADT conversion, GMT time to ADT, GMT to Atlantic Daylight Time, GMT and ADT difference, GMT vs ADT, ADT UTC offset",
  image: "/assets/gmt-to-adt-converter.webp",
  imageAlt: "GMT to ADT converter comparing Greenwich Mean Time and Atlantic Daylight Time",
  faqs,
  appDescription: "Free online GMT to ADT converter featuring live clocks, 24-hour schedules, DST-aware calculations, and cross-atlantic team meeting planners between Greenwich Mean Time and Atlantic Daylight Time.",
  applicationCategory: "UtilityApplication",
  operatingSystem: "Any",
  preloadImage: "/assets/gmt-to-adt-converter.webp",
  preloadImageSrcset: "/assets/gmt-to-adt-converter.webp 1200w",
  preloadImageSizes: "(max-width: 720px) 92vw, 1000px",
  preloadImageType: "image/webp",
  howToName: "How to Convert GMT to ADT",
  howToDescription: "Simple steps to convert Greenwich Mean Time (GMT) to Atlantic Daylight Time (ADT).",
  howToSteps: [
    { name: "Enter GMT Time", text: "Select your desired hour and date in Greenwich Mean Time (UTC+0)." },
    { name: "Subtract 3 Hours", text: "Subtract 3 hours to convert GMT to Atlantic Daylight Time (UTC-3)." },
    { name: "Check Date Rollover", text: "If subtracting 3 hours drops below 12:00 AM, the date rolls back to the previous calendar day in ADT." }
  ]
};

const relatedConverters = [
  { href: "/gmt-to-ast/", label: "GMT to AST Converter", desc: "Convert Greenwich Mean Time (UTC+0) to Atlantic Standard Time (UTC-4)." },
  { href: "/gmt-to-est/", label: "GMT to EST Converter", desc: "Convert Greenwich Mean Time (UTC+0) to Eastern Standard Time (UTC-5)." },
  { href: "/gmt-to-edt/", label: "GMT to EDT Converter", desc: "Convert Greenwich Mean Time (UTC+0) to Eastern Daylight Time (UTC-4)." },
  { href: "/gmt-to-utc/", label: "GMT to UTC Converter", desc: "Convert Greenwich Mean Time (UTC+0) to Coordinated Universal Time (UTC+0)." },
  { href: "/adt-to-est/", label: "ADT to EST Converter", desc: "Convert Atlantic Daylight Time (UTC-3) to Eastern Standard Time (UTC-5)." },
  { href: "/gmt-to-pdt/", label: "GMT to PDT Converter", desc: "Convert Greenwich Mean Time (UTC+0) to Pacific Daylight Time (UTC-7)." }
];
---

<BaseLayout
  lang={lang}
  dir={dir}
  title={meta.seoTitle}
  description={meta.description}
  slug={slug}
  meta={meta}
  enableFaqSchema={true}
  allowAds={true}
  breadcrumbHomeLabel="Home"
  breadcrumbLabel="GMT to ADT"
  hreflangCodes={["en"]}
>
  <main class="converter-page">
    <header class="page-header">
      <h1>{pageTitle}</h1>
      <p class="lead">
        Convert Greenwich Mean Time (GMT, UTC+0) to Atlantic Daylight Time (ADT, UTC-3) instantly. 
        ADT is <strong>3 hours behind GMT</strong>. Use our interactive converter for live clocks, 
        24-hour conversion charts, and date rollover tracking across international schedules.
      </p>
    </header>

    <section class="converter-section" aria-label="Interactive Time Converter">
      <Converter intent="converter" t={t} context={context} />
    </section>

    <section class="status-card-section">
      <div class="status-card">
        <div class="status-item">
          <span class="status-label">Greenwich Mean Time</span>
          <span class="status-value">UTC+0</span>
        </div>
        <div class="status-arrow">
          <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
          <span class="status-diff">-3 HRS</span>
        </div>
        <div class="status-item">
          <span class="status-label">Atlantic Daylight Time</span>
          <span class="status-value">UTC-3</span>
        </div>
      </div>
      <p class="status-note">
        Atlantic Daylight Time (UTC-3) is 3 hours behind Greenwich Mean Time (UTC+0). Subtract 3 hours to convert GMT to ADT.
      </p>
    </section>

    <figure class="hero-image">
      <img 
        src="/assets/gmt-to-adt-converter.webp" 
        alt="GMT to ADT converter comparing London and Atlantic Canada Daylight Time" 
        width="1200" 
        height="630" 
        loading="eager"
      />
      <figcaption>Comparing Greenwich Mean Time (GMT, UTC+0) in London with Atlantic Daylight Time (ADT, UTC-3) in Halifax, Nova Scotia.</figcaption>
    </figure>

    <article class="content-body">
      <h2>GMT to ADT Time Difference</h2>
      <p>
        The standard time difference between Greenwich Mean Time (GMT) and Atlantic Daylight Time (ADT) is exactly <strong>3 hours</strong>. 
        GMT operates at <strong>UTC+0</strong>, while ADT operates at <strong>UTC-3</strong>. Because UTC-3 is 3 hours behind UTC+0, 
        Atlantic Daylight Time is always 3 hours behind Greenwich Mean Time during the summer daylight saving period.
      </p>
      <div class="formula-box">
        <code>ADT = GMT − 3 hours</code>
      </div>
      <p>
        Here are quick practical conversion examples during Atlantic Daylight Time:
      </p>
      <ul class="example-list">
        <li><strong>00:00 GMT (12:00 AM)</strong> = <strong>9:00 PM ADT</strong> (Previous day)</li>
        <li><strong>03:00 AM GMT</strong> = <strong>12:00 AM (Midnight) ADT</strong> (Same day)</li>
        <li><strong>06:00 AM GMT</strong> = <strong>3:00 AM ADT</strong> (Same day)</li>
        <li><strong>12:00 PM (Noon) GMT</strong> = <strong>9:00 AM ADT</strong> (Same day)</li>
        <li><strong>3:00 PM GMT</strong> = <strong>12:00 PM (Noon) ADT</strong> (Same day)</li>
        <li><strong>6:00 PM GMT</strong> = <strong>3:00 PM ADT</strong> (Same day)</li>
        <li><strong>9:00 PM GMT</strong> = <strong>6:00 PM ADT</strong> (Same day)</li>
        <li><strong>11:00 PM GMT</strong> = <strong>8:00 PM ADT</strong> (Same day)</li>
      </ul>

      <figure class="content-image">
        <img 
          src="/assets/gmt-to-adt-time-difference.webp" 
          alt="Timezone graphic showing GMT to ADT conversion with a 3-hour offset" 
          width="800" 
          height="533" 
          loading="lazy"
        />
        <figcaption>ADT is 3 hours behind GMT: 12:00 PM GMT corresponds to 9:00 AM ADT.</figcaption>
      </figure>

      <h2>How to Convert GMT to ADT</h2>
      <p>
        Converting GMT to Atlantic Daylight Time (ADT) is simple and direct:
      </p>
      <ol class="step-list">
        <li><strong>Identify the GMT time:</strong> Start with your time in Greenwich Mean Time (UTC+0).</li>
        <li><strong>Subtract 3 hours:</strong> Subtract 3 hours from the GMT hour value.</li>
        <li><strong>Check calendar date:</strong> If subtracting 3 hours drops below 00:00 (12:00 AM), the ADT time falls onto the previous calendar day.</li>
      </ol>

      <h2>GMT to ADT Conversion Table (24 Hours)</h2>
      <p>
        This full 24-hour reference table displays every hour of Greenwich Mean Time alongside its corresponding Atlantic Daylight Time.
      </p>
      <div class="table-container">
        <table class="time-table">
          <thead>
            <tr>
              <th>Greenwich Mean Time (GMT)</th>
              <th>Atlantic Daylight Time (ADT)</th>
              <th>Calendar Day Shift</th>
            </tr>
          </thead>
          <tbody>
            {conversionRows.map(row => (
              <tr>
                <td>{row.gmt}</td>
                <td><strong>{row.adt}</strong></td>
                <td><span class={`tag ${row.dayNote === 'Previous day' ? 'tag-prev' : 'tag-same'}`}>{row.dayNote}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h2>GMT to ADT Practical Examples</h2>
      <p>
        Here are detailed scenario examples for converting GMT to ADT across key daily business hours:
      </p>
      <ul>
        <li><strong>12:00 GMT to ADT:</strong> 12:00 PM GMT minus 3 hours equals <strong>9:00 AM ADT</strong>. This marks the start of the Atlantic Canada workday.</li>
        <li><strong>15:00 GMT to ADT:</strong> 3:00 PM GMT minus 3 hours equals <strong>12:00 PM (Noon) ADT</strong>. Perfect for scheduling transatlantic lunch meetings.</li>
        <li><strong>18:00 GMT to ADT:</strong> 6:00 PM GMT minus 3 hours equals <strong>3:00 PM ADT</strong>. Ideal for late afternoon team check-ins before UK offices close.</li>
        <li><strong>21:00 GMT to ADT:</strong> 9:00 PM GMT minus 3 hours equals <strong>6:00 PM ADT</strong>. Represents early evening in Halifax.</li>
        <li><strong>00:00 GMT (Midnight) to ADT:</strong> 12:00 AM GMT minus 3 hours equals <strong>9:00 PM ADT on the previous calendar day</strong>.</li>
      </ul>

      <h2>What Is GMT?</h2>
      <p>
        <strong>GMT</strong> stands for <strong>Greenwich Mean Time</strong>. It represents solar time measured at the Royal Observatory in Greenwich, London, operating at <strong>UTC+0</strong>. GMT serves as the world's civil time baseline and anchor for international time zone offsets.
      </p>

      <h2>What Is ADT?</h2>
      <p>
        <strong>ADT</strong> stands for <strong>Atlantic Daylight Time</strong>. It operates at an offset of <strong>UTC-3</strong>. 
        ADT is used in Atlantic Canada during Daylight Saving Time, from the second Sunday in March to the first Sunday in November. 
        Major Canadian cities observing ADT include Halifax (Nova Scotia), Moncton and Fredericton (New Brunswick), Charlottetown (Prince Edward Island), and parts of Labrador, as well as the island of Bermuda. The IANA identifier is <code>America/Halifax</code>.
      </p>

      <h2>GMT vs ADT Comparison</h2>
      <div class="table-container">
        <table class="time-table">
          <thead>
            <tr>
              <th>Feature</th>
              <th>GMT</th>
              <th>ADT</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Full Name</strong></td>
              <td>Greenwich Mean Time</td>
              <td>Atlantic Daylight Time</td>
            </tr>
            <tr>
              <td><strong>UTC Offset</strong></td>
              <td>UTC+0</td>
              <td>UTC-3</td>
            </tr>
            <tr>
              <td><strong>Difference</strong></td>
              <td colspan="2">ADT is 3 hours behind GMT</td>
            </tr>
            <tr>
              <td><strong>Season</strong></td>
              <td>Year-round baseline</td>
              <td>Summer (March to November)</td>
            </tr>
            <tr>
              <td><strong>IANA Identifier</strong></td>
              <td>UTC</td>
              <td>America/Halifax</td>
            </tr>
            <tr>
              <td><strong>Key Cities</strong></td>
              <td>London, Reykjavik, Accra</td>
              <td>Halifax, Fredericton, Hamilton (Bermuda)</td>
            </tr>
          </tbody>
        </table>
      </div>

      <h2>ADT vs AST: Daylight Saving vs Standard Time in Atlantic Canada</h2>
      <p>
        It is essential to understand the difference between ADT and <a href="/gmt-to-ast/">AST (Atlantic Standard Time)</a>:
      </p>
      <div class="table-container">
        <table class="time-table">
          <thead>
            <tr>
              <th>Time Zone</th>
              <th>Abbreviation</th>
              <th>UTC Offset</th>
              <th>GMT Difference</th>
              <th>Season</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Atlantic Daylight Time</td>
              <td>ADT</td>
              <td>UTC-3</td>
              <td>GMT − 3 hours</td>
              <td>Summer (March to November)</td>
            </tr>
            <tr>
              <td>Atlantic Standard Time</td>
              <td>AST</td>
              <td>UTC-4</td>
              <td>GMT − 4 hours</td>
              <td>Winter (November to March)</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p>
        During summer, Atlantic Canada operates on ADT (UTC-3), so the offset from GMT is 3 hours. In winter, Atlantic Canada switches to AST (UTC-4), widening the gap from GMT to 4 hours.
      </p>

      <figure class="content-image">
        <img 
          src="/assets/gmt-adt-ast-time-zone-comparison.webp" 
          alt="Infographic comparing GMT (UTC+0), ADT (UTC-3), and AST (UTC-4)" 
          width="800" 
          height="533" 
          loading="lazy"
        />
        <figcaption>Comparing GMT (UTC+0) with ADT (UTC-3, Summer) and AST (UTC-4, Winter).</figcaption>
      </figure>

      <h2>GMT to ADT Across Different Dates (Date Rollover Explained)</h2>
      <p>
        Because ADT is 3 hours behind GMT, early morning GMT hours (00:00 to 02:59 GMT) fall onto the previous calendar evening in ADT:
      </p>
      <ul>
        <li><strong>00:00 GMT (Midnight)</strong> ➔ <strong>9:00 PM ADT previous day</strong></li>
        <li><strong>01:00 GMT</strong> ➔ <strong>10:00 PM ADT previous day</strong></li>
        <li><strong>02:00 GMT</strong> ➔ <strong>11:00 PM ADT previous day</strong></li>
        <li><strong>03:00 GMT</strong> ➔ <strong>12:00 AM (Midnight) ADT same day</strong></li>
      </ul>

      <h2>Who Uses GMT to ADT Conversion?</h2>
      <p>
        Converting GMT to ADT is essential for various professional and logistical activities:
      </p>
      <div class="grid-cards">
        <div class="card">
          <h4>Transatlantic Remote Teams</h4>
          <p>Companies headquartered in Europe or the UK coordinating daily work schedules with remote software developers and operations staff in Nova Scotia or New Brunswick.</p>
        </div>
        <div class="card">
          <h4>Maritime Shipping & Logistics</h4>
          <p>Shipping companies operating out of the Port of Halifax coordinating vessel arrivals and port cargo logistics with UK and European maritime hubs.</p>
        </div>
        <div class="card">
          <h4>Aviation & Global Flight Schedules</h4>
          <p>Airports and transatlantic flight coordinators tracking UTC flight plans for transatlantic arrivals into Halifax Stanfield International Airport (YHZ).</p>
        </div>
        <div class="card">
          <h4>Broadcasting & Live Events</h4>
          <p>Media networks coordinating live broadcast feeds, webinars, and international sports coverage across UK and Atlantic Canadian viewing windows.</p>
        </div>
      </div>

      <h2>GMT to ADT Conversion Tips</h2>
      <ul>
        <li><strong>Always check the calendar date:</strong> If your GMT time is between midnight and 2:59 AM, remember that the ADT date will be the previous day.</li>
        <li><strong>Verify Daylight Saving dates:</strong> Ensure Atlantic Canada is currently in ADT (UTC-3) rather than AST (UTC-4). DST runs from March to November.</li>
        <li><strong>Distinguish UK BST vs GMT:</strong> In summer, the UK shifts to British Summer Time (BST, UTC+1). When London is in BST and Halifax is in ADT, the local difference is 4 hours (BST is 4 hours ahead of ADT). Pure GMT (UTC+0) to ADT is strictly 3 hours.</li>
      </ul>

      <h2>GMT to Halifax Time</h2>
      <p>
        Halifax, Nova Scotia is the primary urban center in the Atlantic Time Zone. In summer (March to November), Halifax operates on ADT (UTC-3), which is 3 hours behind GMT.
      </p>

      <h2>GMT to Bermuda Time</h2>
      <p>
        Bermuda operates on Atlantic Time on the exact same schedule as Nova Scotia. During summer, Bermuda uses ADT (UTC-3, 3 hours behind GMT).
      </p>

      <h2>Daylight Saving Time Rules in Atlantic Canada</h2>
      <p>
        Atlantic Canada transitions to Daylight Saving Time (ADT) on the second Sunday in March at 2:00 AM AST (clocks jump forward 1 hour to 3:00 AM ADT). 
        Daylight Saving Time ends on the first Sunday in November at 2:00 AM ADT (clocks fall back 1 hour to 1:00 AM AST).
      </p>

      <h2>Frequently Asked Questions</h2>
      <div class="faq-container">
        {faqs.map((faq) => (
          <details class="faq-item">
            <summary class="faq-question">{faq.q}</summary>
            <div class="faq-answer"><p>{faq.a}</p></div>
          </details>
        ))}
      </div>

      <div class="related-converters">
        <h2>Related Time Zone Converters</h2>
        <div class="converter-grid">
          {relatedConverters.map(link => (
            <a href={link.href} class="converter-link-card">
              <span class="converter-label">{link.label}</span>
              <span class="converter-desc">{link.desc}</span>
            </a>
          ))}
        </div>
      </div>
    </article>
  </main>
</BaseLayout>

<style>
  .converter-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1rem;
    color: var(--text);
