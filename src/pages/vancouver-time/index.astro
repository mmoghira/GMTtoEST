---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import { siteUrl } from "theme/i18n/config";
import RelatedConvertersWidget from "theme/components/RelatedConvertersWidget.astro";
import UsersAlsoVisitWidget from "theme/components/UsersAlsoVisitWidget.astro";
import LearnMoreWidget from "theme/components/LearnMoreWidget.astro";
import CountryCityWidget from "theme/components/CountryCityWidget.astro";

const lang = "en";
const dir = "ltr";
const slug = "vancouver-time";
const seoTitle = "Vancouver Time Now: Current Clock Offset & PST/PDT Guide (2026)";
const pageDescription = "Find exact current local time in Vancouver, BC, Canada. Learn about Pacific Standard Time (PST), Pacific Daylight Time (PDT), UTC-8/UTC-7 offsets, DST transition dates, and global business coordination.";

const pubDate = "2026-07-30T10:00:00+05:00";
const updatedDate = "2026-07-30T10:00:00+05:00";

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "Vancouver Time, Current Time in Vancouver, Pacific Time Zone, PST to EST, PDT offset, Vancouver clock, Vancouver IANA timezone, Canada Time Zones",
  pubDate,
  updatedDate,
  author: "Jackie Bruce",
  faqs: [
    {
      q: "What time zone is Vancouver in?",
      a: "Vancouver, British Columbia is located in the Pacific Time Zone of North America. It observes Pacific Standard Time (PST, UTC-8) during winter and Pacific Daylight Time (PDT, UTC-7) during summer."
    },
    {
      q: "What is Vancouver's current UTC offset?",
      a: "During Pacific Standard Time (PST), Vancouver is UTC-8. During Daylight Saving Time (PDT), Vancouver shifts to UTC-7."
    },
    {
      q: "What is the time difference between Vancouver and Toronto?",
      a: "Vancouver is 3 hours behind Toronto. When it is 12:00 PM (noon) in Toronto (Eastern Time), it is 9:00 AM in Vancouver (Pacific Time). Both regions observe DST on identical schedules."
    },
    {
      q: "What is the time difference between Vancouver and New York?",
      a: "Vancouver is 3 hours behind New York. When it is 4:00 PM in New York (EDT/EST), it is 1:00 PM in Vancouver (PDT/PST)."
    },
    {
      q: "What is the time difference between Vancouver and London?",
      a: "During standard time, Vancouver is 8 hours behind London (GMT). During summer, Vancouver (PDT, UTC-7) is 8 hours behind London (BST, UTC+1). During DST transition weeks in March and October, the difference is briefly 7 hours."
    },
    {
      q: "When does Daylight Saving Time start and end in Vancouver?",
      a: "Daylight Saving Time begins on the second Sunday of March at 2:00 AM local time (clocks move forward to 3:00 AM PDT). It ends on the first Sunday of November at 2:00 AM local time (clocks move back to 1:00 AM PST)."
    },
    {
      q: "What is the IANA time zone identifier for Vancouver?",
      a: "The IANA Time Zone Database key for Vancouver is America/Vancouver."
    },
    {
      q: "Is Vancouver time identical to Seattle and Los Angeles time?",
      a: "Yes. Vancouver shares the exact same Pacific Time Zone offsets (UTC-8 / UTC-7) and Daylight Saving Time rules as Seattle, San Francisco, and Los Angeles."
    },
    {
      q: "What is the time difference between Vancouver and Tokyo?",
      a: "Vancouver is 17 hours behind Tokyo (JST) during standard time (PST) and 16 hours behind Tokyo during Daylight Saving Time (PDT)."
    },
    {
      q: "What is the time difference between Vancouver and Sydney?",
      a: "Vancouver is 19 hours behind Sydney during northern winter / southern summer, and 17 hours behind Sydney during northern summer / southern winter."
    },
    {
      q: "Does all of British Columbia observe Daylight Saving Time?",
      a: "Most of British Columbia, including Vancouver and Victoria, observes DST. However, a few peace river communities like Dawson Creek remain on Mountain Standard Time (UTC-7) year-round."
    },
    {
      q: "What is the optimal time for a Vancouver-to-London business meeting?",
      a: "The best call window is between 8:00 AM and 9:30 AM Vancouver time, corresponding to 4:00 PM to 5:30 PM London time."
    },
    {
      q: "What is the best time to coordinate meetings between Vancouver and Asia-Pacific hubs?",
      a: "Due to the 15-to-17-hour time gap, late afternoon or early evening in Vancouver (4:00 PM – 7:00 PM PDT) aligns with morning hours in Tokyo, Seoul, and Singapore (8:00 AM – 11:00 AM next day)."
    },
    {
      q: "How does Vancouver's time zone impact its film and tech industries?",
      a: "As 'Hollywood North' and a major tech hub (Microsoft, Amazon, gaming studios), Vancouver aligns seamlessly with California tech centers while remaining easily accessible for east-coast reporting."
    },
    {
      q: "How do I convert UTC to Vancouver local time?",
      a: "To convert UTC to Vancouver PST (winter), subtract 8 hours. To convert UTC to Vancouver PDT (summer), subtract 7 hours."
    },
    {
      q: "What military time letter code represents Vancouver standard time?",
      a: "Vancouver standard time (PST, UTC-8) corresponds to Uniform (U) time, while Vancouver daylight time (PDT, UTC-7) corresponds to Tango (T) time."
    },
    {
      q: "What major airports operate on Vancouver time?",
      a: "Vancouver International Airport (YVR) handles transpacific and trans-Canada flight operations adhering strictly to America/Vancouver local time."
    },
    {
      q: "Has British Columbia considered switching to permanent Daylight Saving Time?",
      a: "Yes, British Columbia passed legislation to adopt permanent Pacific Daylight Time, but implementation is contingent on neighboring US Pacific states (Washington, Oregon, California) enacting federal approval."
    },
    {
      q: "What is the time difference between Vancouver and Chicago?",
      a: "Vancouver is 2 hours behind Chicago. When it is 12:00 PM in Chicago (Central Time), it is 10:00 AM in Vancouver (Pacific Time)."
    },
    {
      q: "How should software developers store Vancouver timestamps?",
      a: "Always persist timestamps in UTC format in databases, using America/Vancouver in presentation layers to convert and display local times cleanly."
    }
  ]
};

const pageUrlPath = `${siteUrl}/vancouver-time/`;

const pageSchema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${pageUrlPath}#webpage`,
    "url": pageUrlPath,
    "name": seoTitle,
    "description": pageDescription,
    "inLanguage": lang,
    "isPartOf": { "@id": `${siteUrl}/#website` }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${pageUrlPath}#breadcrumb`,
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteUrl}/` },
      { "@type": "ListItem", "position": 2, "name": "Vancouver Time", "item": pageUrlPath }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "@id": `${pageUrlPath}#article`,
    "headline": seoTitle,
    "description": pageDescription,
    "datePublished": pubDate,
    "dateModified": updatedDate,
    "author": { "@type": "Person", "name": meta.author },
    "publisher": { "@type": "Organization", "name": "GMT to EST Converter", "url": siteUrl },
    "mainEntityOfPage": pageUrlPath
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${pageUrlPath}#faq`,
    "mainEntity": meta.faqs.map(faq => ({
      "@type": "Question",
      "name": faq.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.a
      }
    }))
  }
];
---

<BaseLayout lang={lang} dir={dir} title={seoTitle} description={pageDescription} slug={slug} meta={meta} enableFaqSchema={true}>
  <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} slot="head" />

  <div class="container content-wrapper">
    <header class="page-header">
      <h1>Vancouver Time: Complete Guide to Pacific Standard & Daylight Time (2026)</h1>
      <div class="reading-meta">
        <span><strong>Author:</strong> {meta.author}</span> | 
        <span><strong>Last Updated:</strong> July 30, 2026</span> | 
        <span><strong>Reading Time:</strong> 15 mins</span>
      </div>
    </header>

    <!-- Top Answer Summary Box -->
    <div class="summary-box">
      <h2>Quick Summary: Current Time Rules in Vancouver</h2>
      <div class="summary-grid">
        <div class="summary-item">
          <strong>City & Province:</strong> Vancouver, British Columbia, Canada
        </div>
        <div class="summary-item">
          <strong>Primary Time Zone:</strong> Pacific Time (PT)
        </div>
        <div class="summary-item">
          <strong>Standard Time Offset (Winter):</strong> PST (UTC-8 / GMT-8)
        </div>
        <div class="summary-item">
          <strong>Daylight Saving Offset (Summer):</strong> PDT (UTC-7 / GMT-7)
        </div>
        <div class="summary-item">
          <strong>IANA Database Key:</strong> <code>America/Vancouver</code>
        </div>
        <div class="summary-item">
          <strong>Difference vs Toronto / NY (Eastern Time):</strong> 3 hours behind
        </div>
      </div>
    </div>

    <section class="content-section">
      <h2>Understanding Vancouver Local Time & Pacific Time Zone Geography</h2>
      <p>
        Vancouver, British Columbia is Canada's premier Pacific gateway city, located between the Strait of Georgia and the Coast Mountains. As the third-largest metropolitan area in Canada, Vancouver acts as a vital bridge for transpacific trade, international technology expansion, film production ("Hollywood North"), and green technology venture capital.
      </p>
      <p>
        Vancouver operates within the North American Pacific Time Zone. During winter months, it observes <strong>Pacific Standard Time (PST)</strong> at <a href="/what-is-utc/">UTC-8</a>. In the spring, clocks shift forward by one hour to observe <strong>Pacific Daylight Time (PDT)</strong> at <a href="/gmt-to-pst/">UTC-7</a>.
      </p>
      <p>
        Because Vancouver shares its longitude and daylight saving schedules with US West Coast hubs like <a href="/los-angeles-time/">Los Angeles</a>, San Francisco, and Seattle, real-time collaboration across the Pacific coast is seamless. However, cross-country communication with Canadian commercial centers like <a href="/toronto-time/">Toronto</a> and Ottawa requires navigating a constant 3-hour time difference.
      </p>

      <div class="info-callout">
        <h3>Key Rule: The 3-Hour Trans-Canada Time Gap</h3>
        <p>
          Vancouver is always <strong>3 hours behind Eastern Time (Toronto / Montreal / New York)</strong>. When it is 12:00 PM (noon) in Toronto, office workers in Vancouver are just beginning their workday at 9:00 AM PST/PDT.
        </p>
      </div>
    </section>

    <!-- Visual SVG Diagram 1 -->
    <section class="content-section">
      <h2>Vancouver Pacific Time UTC Offset Visual Architecture</h2>
      <p>
        The diagram below visualizes Vancouver's position across global meridians relative to Greenwich Mean Time, US Eastern Time, and Asian financial markets.
      </p>

      <div class="svg-diagram-container">
        <svg viewBox="0 0 800 340" width="100%" height="auto" xmlns="http://www.w3.org/2000/svg" aria-label="Vancouver Time Zone Offset Visual">
          <rect width="800" height="340" fill="var(--panel)" rx="12" stroke="var(--line)" stroke-width="2"/>
          <text x="400" y="38" fill="var(--accent)" font-family="Space Grotesk, sans-serif" font-size="20" font-weight="bold" text-anchor="middle">Vancouver (America/Vancouver) Meridian Map</text>

          <!-- Timeline Bar -->
          <line x1="60" y1="120" x2="740" y2="120" stroke="var(--line)" stroke-width="4"/>

          <!-- Tokyo Marker -->
          <circle cx="120" cy="120" r="8" fill="var(--accent-2)"/>
          <text x="120" y="95" fill="var(--text)" font-size="13" font-weight="bold" text-anchor="middle">Tokyo (JST)</text>
          <text x="120" y="150" fill="var(--muted)" font-size="12" text-anchor="middle">UTC+9</text>

          <!-- UTC Marker -->
          <circle cx="280" cy="120" r="10" fill="var(--accent-2)"/>
          <text x="280" y="95" fill="var(--text)" font-size="14" font-weight="bold" text-anchor="middle">UTC / GMT</text>
          <text x="280" y="150" fill="var(--muted)" font-size="12" text-anchor="middle">UTC+0</text>

          <!-- Toronto Marker -->
          <circle cx="560" cy="120" r="8" fill="#8fd7ff"/>
          <text x="560" y="95" fill="var(--text)" font-size="13" text-anchor="middle">Toronto (EST/EDT)</text>
          <text x="560" y="150" fill="var(--muted)" font-size="12" text-anchor="middle">UTC-5 / UTC-4</text>

          <!-- Vancouver Marker -->
          <circle cx="680" cy="120" r="12" fill="#36c7b5" stroke="#ffffff" stroke-width="3"/>
          <text x="680" y="90" fill="var(--accent)" font-size="16" font-weight="bold" text-anchor="middle">VANCOUVER</text>
          <text x="680" y="150" fill="var(--text)" font-weight="bold" font-size="13" text-anchor="middle">UTC-8 (PST) / UTC-7 (PDT)</text>

          <!-- Season Card -->
          <rect x="180" y="190" width="440" height="115" fill="var(--bg)" rx="8" stroke="var(--line)" stroke-width="1.5"/>
          <text x="400" y="218" fill="var(--text)" font-family="Space Grotesk, sans-serif" font-size="15" font-weight="bold" text-anchor="middle">Daylight Saving Schedule (Vancouver)</text>
          <text x="400" y="248" fill="var(--muted)" font-size="13" text-anchor="middle">Spring Forward: 2nd Sunday in March (+1h to PDT, UTC-7)</text>
          <text x="400" y="276" fill="var(--muted)" font-size="13" text-anchor="middle">Fall Back: 1st Sunday in November (-1h to PST, UTC-8)</text>
        </svg>
      </div>
    </section>

    <section class="content-section">
      <h2>Daylight Saving Transition Calendar for Vancouver (2026–2028)</h2>
      <p>
        Like most Canadian provinces outside of Saskatchewan, British Columbia observes Daylight Saving Time under standardized North American rules. The exact transition dates for upcoming years are detailed in the schedule below:
      </p>

      <div class="table-responsive">
        <table class="comparison-table">
          <thead>
            <tr>
              <th>Year</th>
              <th>Spring Forward (DST Begins)</th>
              <th>Fall Back (DST Ends)</th>
              <th>Active Local Offset</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>2026</strong></td>
              <td>March 8, 2026 (2:00 AM PST &rarr; 3:00 AM PDT)</td>
              <td>November 1, 2026 (2:00 AM PDT &rarr; 1:00 AM PST)</td>
              <td>PDT (UTC-7)</td>
            </tr>
            <tr>
              <td><strong>2027</strong></td>
              <td>March 14, 2027 (2:00 AM PST &rarr; 3:00 AM PDT)</td>
              <td>November 7, 2027 (2:00 AM PDT &rarr; 1:00 AM PST)</td>
              <td>PDT (UTC-7)</td>
            </tr>
            <tr>
              <td><strong>2028</strong></td>
              <td>March 12, 2028 (2:00 AM PST &rarr; 3:00 AM PDT)</td>
              <td>November 5, 2028 (2:00 AM PDT &rarr; 1:00 AM PST)</td>
              <td>PDT (UTC-7)</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="content-section">
      <h2>Transpacific Business & Multi-Zone Meeting Strategies</h2>
      <p>
        Vancouver's strategic position on the Pacific Rim requires managers and project leads to balance two entirely different scheduling windows: European corporate hours in the morning and East Asian corporate hours in the evening.
      </p>

      <div class="table-responsive">
        <table class="comparison-table">
          <thead>
            <tr>
              <th>Global Business Hub</th>
              <th>Standard Local Hours</th>
              <th>Best Vancouver Meeting Window (PDT)</th>
              <th>Status / Notes</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>London (GMT/BST)</strong></td>
              <td>9:00 AM – 5:00 PM BST</td>
              <td>8:00 AM – 9:00 AM PDT</td>
              <td>Very tight 1-hour overlap before London office closes.</td>
            </tr>
            <tr>
              <td><strong>New York / Toronto (EDT)</strong></td>
              <td>9:00 AM – 5:00 PM EDT</td>
              <td>8:00 AM – 2:00 PM PDT</td>
              <td>Excellent 6-hour working overlap across North America.</td>
            </tr>
            <tr>
              <td><strong>Tokyo (JST)</strong></td>
              <td>9:00 AM – 5:00 PM JST</td>
              <td>4:00 PM – 7:00 PM PDT (Prev. Day)</td>
              <td>Evening overlap in Vancouver hits morning hours in Tokyo.</td>
            </tr>
            <tr>
              <td><strong>Sydney (AEST/AEDT)</strong></td>
              <td>9:00 AM – 5:00 PM AEDT</td>
              <td>3:00 PM – 6:00 PM PDT (Prev. Day)</td>
              <td>Convenient evening call window across the Pacific.</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="tip-box">
        <h3>Pro Strategy: Asia-Pacific Evening Call Windows</h3>
        <p>
          Because Vancouver is 16 hours behind Tokyo and 17 hours behind Sydney during summer, schedule team syncs at <strong>5:00 PM Vancouver time on Monday</strong>. In Tokyo, it will be 9:00 AM on Tuesday morning, enabling clean work handoffs without requiring middle-of-the-night calls.
        </p>
      </div>
    </section>

    <!-- Visual SVG Diagram 2 -->
    <section class="content-section">
      <h2>Vancouver Transpacific Overlap Visual Timeline</h2>
      <div class="svg-diagram-container">
        <svg viewBox="0 0 800 260" width="100%" height="auto" xmlns="http://www.w3.org/2000/svg" aria-label="Vancouver Transpacific Timeline">
          <rect width="800" height="260" fill="var(--panel)" rx="12" stroke="var(--line)" stroke-width="2"/>
          <text x="400" y="35" fill="var(--accent)" font-family="Space Grotesk, sans-serif" font-size="18" font-weight="bold" text-anchor="middle">Vancouver Transpacific Dual Scheduling Window</text>

          <!-- Morning Window -->
          <rect x="80" y="75" width="280" height="140" fill="var(--bg)" rx="8" stroke="var(--line)"/>
          <text x="220" y="105" fill="var(--accent-2)" font-weight="bold" font-size="15" text-anchor="middle">Morning Window (8 AM - 10 AM PDT)</text>
          <text x="220" y="135" fill="var(--text)" font-size="13" text-anchor="middle">Overlaps with UK / Europe Afternoon</text>
          <text x="220" y="160" fill="var(--muted)" font-size="12" text-anchor="middle">• London: 4:00 PM – 6:00 PM BST</text>
          <text x="220" y="185" fill="var(--muted)" font-size="12" text-anchor="middle">• Toronto / NY: 11:00 AM – 1:00 PM EDT</text>

          <!-- Evening Window -->
          <rect x="440" y="75" width="280" height="140" fill="var(--bg)" rx="8" stroke="var(--line)"/>
          <text x="580" y="105" fill="var(--accent)" font-weight="bold" font-size="15" text-anchor="middle">Evening Window (4 PM - 7 PM PDT)</text>
          <text x="580" y="135" fill="var(--text)" font-size="13" text-anchor="middle">Overlaps with Asia-Pacific Next Morning</text>
          <text x="580" y="160" fill="var(--muted)" font-size="12" text-anchor="middle">• Tokyo: 8:00 AM – 11:00 AM JST (+1 day)</text>
          <text x="580" y="185" fill="var(--muted)" font-size="12" text-anchor="middle">• Sydney: 9:00 AM – 12:00 PM AEST (+1 day)</text>
        </svg>
      </div>
    </section>

    <section class="content-section">
      <h2>Vancouver Hourly Direct Time Conversion Reference Table</h2>
      <p>
        Quick lookup table for converting Vancouver (PDT) to GMT/UTC, Eastern Time, and Tokyo Standard Time.
      </p>

      <div class="table-responsive">
        <table class="comparison-table">
          <thead>
            <tr>
              <th>Vancouver Time (PDT)</th>
              <th>UTC / GMT Offset</th>
              <th>Toronto / NY (EDT)</th>
              <th>Tokyo Time (JST)</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>00:00 (Midnight)</td><td>07:00 UTC</td><td>03:00 AM EDT</td><td>04:00 PM JST</td></tr>
            <tr><td>03:00 AM</td><td>10:00 UTC</td><td>06:00 AM EDT</td><td>07:00 PM JST</td></tr>
            <tr><td>06:00 AM</td><td>13:00 UTC</td><td>09:00 AM EDT</td><td>10:00 PM JST</td></tr>
            <tr><td>09:00 AM</td><td>16:00 UTC</td><td>12:00 PM EDT</td><td>01:00 AM JST (+1 day)</td></tr>
            <tr><td>12:00 PM (Noon)</td><td>19:00 UTC</td><td>03:00 PM EDT</td><td>04:00 AM JST (+1 day)</td></tr>
            <tr><td>03:00 PM</td><td>22:00 UTC</td><td>06:00 PM EDT</td><td>07:00 AM JST (+1 day)</td></tr>
            <tr><td>06:00 PM</td><td>01:00 UTC (+1 day)</td><td>09:00 PM EDT</td><td>10:00 AM JST (+1 day)</td></tr>
            <tr><td>09:00 PM</td><td>04:00 UTC (+1 day)</td><td>12:00 AM EDT (+1 day)</td><td>01:00 PM JST (+1 day)</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="content-section faq-section">
      <h2>Frequently Asked Questions About Vancouver Time</h2>
      <div class="faq-list">
        {meta.faqs.map((faq) => (
          <details class="faq-item">
            <summary class="faq-question">{faq.q}</summary>
            <div class="faq-answer">
              <p>{faq.a}</p>
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- Widgets Section -->
    <RelatedConvertersWidget slug={slug} />
    <UsersAlsoVisitWidget slug={slug} />
    <LearnMoreWidget slug={slug} />
    <CountryCityWidget slug={slug} />
  </div>
</BaseLayout>

<style>
  .content-wrapper {
    padding-top: 2rem;
    padding-bottom: 4rem;
    max-width: 1100px;
    margin: 0 auto;
  }
  .page-header h1 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 2.3rem;
    color: var(--text);
    margin-bottom: 0.5rem;
  }
  .reading-meta {
    font-size: 0.9rem;
    color: var(--muted);
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }
  .summary-box {
    background: var(--panel);
    border: 2px solid var(--accent);
    border-radius: 12px;
    padding: 1.8rem;
    margin-bottom: 2.5rem;
  }
  .summary-box h2 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.4rem;
    color: var(--accent);
    margin-top: 0;
    margin-bottom: 1.2rem;
  }
  .summary-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }
  .summary-item {
    background: var(--bg);
    padding: 0.9rem 1.1rem;
    border-radius: 8px;
    border: 1px solid var(--line);
    font-size: 0.95rem;
  }
  .summary-item strong {
    display: block;
    color: var(--accent-2);
    margin-bottom: 0.25rem;
  }
  .content-section {
    margin-bottom: 3rem;
  }
  .content-section h2 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.7rem;
    color: var(--text);
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.4rem;
  }
  .content-section p {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--muted);
    margin-bottom: 1.2rem;
  }
  .info-callout, .tip-box {
    background: var(--panel);
    border-left: 4px solid var(--accent);
    padding: 1.3rem 1.6rem;
    border-radius: 6px;
    margin: 1.8rem 0;
  }
  .info-callout h3, .tip-box h3 {
    margin-top: 0;
    font-family: 'Space Grotesk', sans-serif;
    color: var(--accent);
    font-size: 1.2rem;
  }
  .svg-diagram-container {
    margin: 2rem 0;
    background: var(--bg);
    padding: 1rem;
    border-radius: 12px;
    border: 1px solid var(--line);
  }
  .table-responsive {
    overflow-x: auto;
    margin: 1.8rem 0;
  }
  .comparison-table {
    width: 100%;
    border-collapse: collapse;
    background: var(--panel);
    border-radius: 8px;
    overflow: hidden;
  }
  .comparison-table th, .comparison-table td {
    padding: 1rem;
    text-align: left;
    border-bottom: 1px solid var(--line);
    font-size: 0.95rem;
  }
  .comparison-table th {
    background: var(--bg);
    color: var(--accent-2);
    font-family: 'Space Grotesk', sans-serif;
  }
  .faq-section details {
    background: var(--panel);
    border: 1px solid var(--line);
