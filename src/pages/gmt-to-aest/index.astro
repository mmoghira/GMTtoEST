        <line x1="0" y1="0" x2="0" y2="-42" stroke="#bdd2dc" stroke-width="2" />
        <circle cx="0" cy="0" r="5" fill="#36c7b5" />
        <text x="0" y="85" font-family="'Space Grotesk', sans-serif" font-weight="bold" font-size="16" fill="#bdd2dc" text-anchor="middle">GMT Time (UTC+0)</text>
