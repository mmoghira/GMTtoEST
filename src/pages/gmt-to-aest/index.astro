---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import Converter from "theme/components/Converter.astro";
import { getTranslation, pageUrl, siteUrl } from "theme/i18n/config";

const lang = "en";
const dir = "ltr";
const slug = "gmt-to-aest";
const t = getTranslation(lang);

const pageTitle = "GMT to AEST Converter";
const seoTitle = "GMT to AEST Converter – Greenwich Mean Time to Australian Eastern Time";
const pageDescription = "Convert GMT to AEST instantly with our free timezone calculator. View the current time difference between Greenwich Mean Time and Australian Eastern Standard Time, with 24-hour charts, Sydney, Melbourne and Brisbane guides.";

const context = {
  from: "GMT",
  to: "AEST",
  fromZone: "UTC",
  toZone: "Australia/Sydney"
};

const canonical = `${siteUrl}/gmt-to-aest/`;

// 24-hour conversion table data (GMT → AEST = GMT + 10)
function formatHour12(hour: number) {
  const normalized = ((hour % 24) + 24) % 24;
  const period = normalized < 12 ? "AM" : "PM";
  const displayHour = normalized % 12 || 12;
  return `${displayHour}:00 ${period}`;
}

const conversionRows = Array.from({ length: 24 }, (_, hour) => {
  const aestHour = hour + 10;
  const aestNormalized = ((aestHour % 24) + 24) % 24;
  const nextDay = aestHour >= 24;
  const period = aestNormalized < 12 ? "AM" : "PM";
  const displayHour = aestNormalized % 12 || 12;
  return {
    gmt: formatHour12(hour),
    aest: `${displayHour}:00 ${period}${nextDay ? " (+1 day)" : ""}`,
    dayNote: nextDay ? "Next day" : "Same day"
  };
});

// Popular conversions
const popularConversions = [
  { gmt: "12:00 AM (Midnight)", aest: "10:00 AM AEST", note: "Mid-morning in Brisbane, Sydney, and Melbourne" },
  { gmt: "2:00 AM", aest: "12:00 PM (Noon) AEST", note: "Lunch break hours in Eastern Australia" },
  { gmt: "4:00 AM", aest: "2:00 PM AEST", note: "Early afternoon collaboration window in Sydney" },
  { gmt: "6:00 AM", aest: "4:00 PM AEST", note: "Late afternoon for Australian businesses before close" },
  { gmt: "8:00 AM", aest: "6:00 PM AEST", note: "Evening overlap slot as UK workday begins" },
  { gmt: "10:00 AM", aest: "8:00 PM AEST", note: "Nighttime relaxation for Australian teams, mid-morning in GMT" },
  { gmt: "12:00 PM (Noon)", aest: "10:00 PM AEST", note: "Bedtime in Eastern Australia, noon in Greenwich" },
  { gmt: "2:00 PM", aest: "12:00 AM AEST (+1)", note: "Midnight in Sydney, afternoon in Greenwich" },
  { gmt: "4:00 PM", aest: "2:00 AM AEST (+1)", note: "UK offices wrap up, Australia is sleeping" },
  { gmt: "6:00 PM", aest: "4:00 AM AEST (+1)", note: "Early hours of the next morning in Canberra" },
  { gmt: "8:00 PM", aest: "6:00 AM AEST (+1)", note: "Dawn in Australia, night in London" },
  { gmt: "10:00 PM", aest: "8:00 AM AEST (+1)", note: "Start of next workday in Brisbane, bedtime in GMT" },
];

// FAQ data
const faqs = [
  { q: "What is AEST?", a: "AEST stands for Australian Eastern Standard Time. It is the time zone used along the eastern coast of Australia, running exactly 10 hours ahead of Coordinated Universal Time (UTC+10). AEST is observed during standard winter months in New South Wales, Victoria, Tasmania, the Australian Capital Territory, and year-round in Queensland." },
  { q: "How many hours ahead of GMT is AEST?", a: "AEST is exactly 10 hours ahead of Greenwich Mean Time (GMT). For example, when it is 8:00 AM GMT, it is 6:00 PM AEST in Sydney, Melbourne, and Brisbane." },
  { q: "Is Sydney always on AEST?", a: "No. Sydney, New South Wales, shifts from AEST (UTC+10) to AEDT (Australian Eastern Daylight Time, UTC+11) during the daylight saving period. This switch happens annually from the first Sunday in October to the first Sunday in April." },
  { q: "Does Queensland use AEST?", a: "Yes. Queensland observes Australian Eastern Standard Time (AEST, UTC+10) all year round. The state does not participate in daylight saving time, meaning Brisbane remains on UTC+10 even when Sydney and Melbourne shift to UTC+11." },
  { q: "What is the difference between AEST and AEDT?", a: "AEST is Australian Eastern Standard Time (UTC+10), whereas AEDT is Australian Eastern Daylight Time (UTC+11). AEDT is one hour ahead of AEST and is observed in participating southeastern states during summer." },
  { q: "Does Melbourne use daylight saving?", a: "Yes. Melbourne (Victoria) observes daylight saving time, shifting from AEST (UTC+10) to AEDT (UTC+11) from the first Sunday in October to the first Sunday in April." },
  { q: "Does Brisbane use AEST all year?", a: "Yes. Brisbane is located in Queensland, which does not observe daylight saving. Consequently, Brisbane uses AEST (UTC+10) during both winter and summer months." },
  { q: "How accurate is this GMT to AEST converter?", a: "Our converter is powered by the latest IANA Time Zone Database (specifically the Australia/Sydney and Australia/Brisbane regional database files). This guarantees 100% precision and automatic handling of seasonal transitions." },
  { q: "What is 6 PM GMT in AEST?", a: "6:00 PM GMT converts to 4:00 AM AEST the next day. Since AEST is 10 hours ahead, we add 10 hours, shifting the time past midnight into the early morning of the following calendar day." },
  { q: "Is GMT the same as UTC?", a: "For daily scheduling, GMT (Greenwich Mean Time) and UTC (Coordinated Universal Time) represent the same offset (+0). Technically, UTC is a modern atomic standard, while GMT is an astronomical solar standard." },
  { q: "Can I convert GMT to AEST manually?", a: "Yes. Simply add 10 hours to the GMT time. For example, 9:00 AM GMT + 10 hours = 7:00 PM AEST. Make sure to check if the target date is in standard time or daylight saving time (AEDT, +11) for Sydney/Melbourne." },
  { q: "Which states in Australia use AEST?", a: "Queensland, New South Wales, Victoria, Tasmania, and the Australian Capital Territory (ACT) use AEST during standard time. Queensland uses it year-round." },
  { q: "Does Canberra follow AEST?", a: "Yes. The Australian Capital Territory (ACT), where Canberra is located, follows AEST (UTC+10) during winter and shifts to AEDT (UTC+11) during the daylight saving months." },
  { q: "What is the IANA identifier for AEST?", a: "The primary IANA zone keys for AEST are Australia/Sydney (for areas observing DST) and Australia/Brisbane (for Queensland, which stays on standard time all year)." },
  { q: "Is Sydney ahead of Brisbane?", a: "During the winter months, Sydney and Brisbane both use AEST (UTC+10), so they have the same time. During summer, Sydney uses AEDT (UTC+11) and is 1 hour ahead of Brisbane." },
  { q: "Does the Northern Territory use AEST?", a: "No. The Northern Territory follows Australian Central Standard Time (ACST), which is UTC+9:30, placing it 30 minutes behind AEST." },
  { q: "Does Western Australia follow AEST?", a: "No. Western Australia uses Australian Western Standard Time (AWST, UTC+8), which runs 2 hours behind AEST." },
  { q: "What is the time gap between London and Brisbane in summer?", a: "During the northern hemisphere summer, London is on BST (UTC+1) and Brisbane is on AEST (UTC+10), making Brisbane 9 hours ahead of London. In winter, London is on GMT (UTC+0), so Brisbane is 10 hours ahead." },
  { q: "What is the timezone transition day in Australia?", a: "Daylight saving starts on the first Sunday in October (clocks forward 1 hour at 2 AM) and ends on the first Sunday in April (clocks back 1 hour at 3 AM)." },
  { q: "Do computer networks use GMT or AEST?", a: "Almost all servers and networks record times in UTC (GMT) to avoid gaps or double logs during daylight saving transitions. Client systems then render it in AEST for Australian users." },
  { q: "Is AEST the same as Sydney time?", a: "Only during winter. Sydney time matches AEST (UTC+10) from April to October, but shifts to AEDT (UTC+11) from October to April." },
  { q: "What is 12 AM GMT in Brisbane local time?", a: "12:00 AM (Midnight) GMT is equal to 10:00 AM AEST on the same day in Brisbane." },
  { q: "Does Tasmania observe AEST?", a: "Yes. Tasmania observes AEST (UTC+10) in winter and AEDT (UTC+11) in summer, matching Sydney and Melbourne." },
  { q: "Why doesn't Queensland observe daylight saving time?", a: "Queensland abandoned daylight saving due to geographical factors; the tropical north experiences minimal daylight variation between seasons, and regional residents preferred maintaining standard time." },
  { q: "Can this converter help with remote team scheduling?", a: "Yes. The meeting planner helps align calendars between GMT-based offices and teams located in Eastern Australia, identifying comfortable overlap hours." }
];

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "GMT to AEST, GMT to Australian Eastern Standard Time, Australian Eastern Standard Time, GMT AEST Converter, Convert GMT to AEST, GMT to Sydney Time, GMT to Melbourne Time, GMT to Brisbane Time, GMT to Canberra Time, Greenwich Mean Time to AEST, GMT Australia Time Converter, Australian Time Converter, Current AEST Time, AEST Time Converter, GMT UTC to AEST",
  image: "/assets/gmt-to-aest-og.svg",
  imageAlt: "GMT to AEST Converter – Convert Greenwich Mean Time to Australian Eastern Standard Time",
  faqs,
  appDescription: "Free online GMT to AEST converter with real-time clocks, DST-aware calculation, 24-hour conversion chart, and meeting planner for scheduling between Greenwich Mean Time and Australian Eastern Standard Time.",
  applicationCategory: "UtilityApplication",
  operatingSystem: "Any",
  howToName: "How to Convert GMT to AEST",
  howToDescription: "Step-by-step guide to converting Greenwich Mean Time to Australian Eastern Standard Time using our free online tool.",
  howToSteps: [
    { name: "Verify the Australian state", text: "Identify if the target location is in Queensland (AEST UTC+10 all year) or states like New South Wales and Victoria which transition to AEDT (UTC+11) in summer." },
    { name: "Enter your GMT time", text: "Select your GMT time using the interactive date and time picker. The tool defaults to the current time." },
    { name: "Check the calendar date", text: "Our calculator evaluates the chosen date against the Australian DST calendar to determine whether AEST (+10) or AEDT (+11) applies." },
    { name: "Read and copy the AEST result", text: "View the converted time, along with day status (same/next day) and active offsets, and click copy to save the result." }
  ],
};
