        />
      </picture>
      <figcaption class="infographic-caption">{imagesMeta[7].caption}</figcaption>
    </figure>

    <p>
      Always utilize the IANA identifier <code>America/Toronto</code> in your code to calculate offset changes dynamically:
    </p>
    <ul>
      <li><strong>Standard ISO 8601 (Winter):</strong> <code>2026-12-15T09:00:00-05:00</code></li>
      <li><strong>Daylight ISO 8601 (Summer):</strong> <code>2026-06-15T09:00:00-04:00</code></li>
    </ul>
  </section>

