---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import Converter from "theme/components/Converter.astro";
import { getTranslation, pageUrl, siteUrl } from "theme/i18n/config";

const lang = "en";
const dir = "ltr";
const slug = "cat-to-est";
const t = getTranslation(lang);

const pageTitle = "CAT to EST Converter";
const seoTitle = "CAT to EST Converter – Central Africa Time to Eastern Standard Time";
const pageDescription = "Convert CAT to EST instantly. Calculate the exact 7-hour time difference between Central Africa Time and US Eastern Standard Time with live clocks, meeting planner, and conversion charts.";

const context = {
  from: "CAT",
  to: "EST",
  fromZone: "Africa/Maputo",
  toZone: "America/New_York"
};

const canonical = `${siteUrl}/cat-to-est/`;

// ═══════════════════════════════════════════════════════════════════════════
// 24-HOUR CONVERSION TABLE DATA & HELPER FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════
// CAT → EST: EST is 7 hours behind CAT
// ═══════════════════════════════════════════════════════════════════════════
function formatHour12(hour: number) {
  const normalized = ((hour % 24) + 24) % 24;
  const period = normalized < 12 ? "AM" : "PM";
  const displayHour = normalized % 12 || 12;
  return `${displayHour}:00 ${period}`;
}

const conversionRows = Array.from({ length: 24 }, (_, hour) => {
  const estHour = hour - 7;
  const estNormalized = ((estHour % 24) + 24) % 24;
  const prevDay = estHour < 0;
  const period = estNormalized < 12 ? "AM" : "PM";
  const displayHour = estNormalized % 12 || 12;
  return {
    cat: formatHour12(hour),
    est: `${displayHour}:00 ${period}${prevDay ? " (-1 day)" : ""}`,
    dayNote: prevDay ? "Previous day in US" : "Same day"
  };
});

// Popular conversions
const popularConversions = [
  { cat: "12:00 AM (Midnight)", est: "5:00 PM EST (Prev Day)", note: "Late afternoon on US East Coast as Africa enters midnight" },
  { cat: "2:00 AM CAT", est: "7:00 PM EST (Prev Day)", note: "US prime time evening while Central Africa sleeps" },
  { cat: "6:00 AM CAT", est: "11:00 PM EST (Prev Day)", note: "Late night in New York as Central Africa wakes up" },
  { cat: "8:00 AM CAT", est: "1:00 AM EST", note: "African morning start while US East Coast is overnight" },
  { cat: "10:00 AM CAT", est: "3:00 AM EST", note: "Mid-morning business hours across Mozambique, Zimbabwe, and Zambia" },
  { cat: "12:00 PM (Noon) CAT", est: "5:00 AM EST", note: "Central Africa lunch hour; pre-dawn on US East Coast" },
  { cat: "2:00 PM CAT", est: "7:00 AM EST", note: "US East Coast morning start overlap with African mid-afternoon" },
  { cat: "4:00 PM CAT", est: "9:00 AM EST", note: "Prime operational window: US office open overlap with African afternoon" },
  { cat: "5:00 PM CAT", est: "10:00 AM EST", note: "Peak collaboration hour before Central Africa offices close" },
  { cat: "7:00 PM CAT", est: "12:00 PM (Noon) EST", note: "US lunchtime while Central Africa relaxes in evening" },
  { cat: "9:00 PM CAT", est: "2:00 PM EST", note: "US mid-afternoon work hours during African evening" },
  { cat: "11:00 PM CAT", est: "4:00 PM EST", note: "US market closing wrap-up window" },
];

// FAQ data (18 detailed FAQs)
const faqs = [
  { q: "What is Central Africa Time (CAT)?", a: "Central Africa Time (CAT) is a time zone used in central and southern Africa. It is set at UTC+2 (two hours ahead of Coordinated Universal Time). Nations using CAT include Mozambique, Zimbabwe, Zambia, Malawi, Rwanda, Burundi, Botswana, and eastern Democratic Republic of the Congo." },
  { q: "What is Eastern Standard Time (EST)?", a: "Eastern Standard Time (EST) is the standard time offset used on the East Coast of North America, including major hubs like New York, Washington D.C., Atlanta, Miami, and Toronto. It runs at UTC-5 (five hours behind Coordinated Universal Time)." },
  { q: "How many hours is EST behind CAT?", a: "Eastern Standard Time (EST) is exactly 7 hours behind Central Africa Time (CAT). To convert CAT to EST, subtract 7 hours from the CAT time (e.g., 4:00 PM CAT becomes 9:00 AM EST)." },
  { q: "Does Central Africa Time (CAT) observe Daylight Saving Time?", a: "No. None of the countries in the Central Africa Time zone observe Daylight Saving Time (DST). CAT remains strictly at UTC+2 throughout the entire calendar year." },
  { q: "Does Eastern Standard Time (EST) switch to Daylight Saving Time?", a: "Yes. In the United States and Canada, regions in the Eastern time zone switch to Eastern Daylight Time (EDT, UTC-4) from the second Sunday in March to the first Sunday in November. During the EDT summer period, the gap narrows to 6 hours instead of 7 hours." },
  { q: "Which major African cities operate on CAT?", a: "Key commercial hubs on CAT include Maputo (Mozambique), Harare (Zimbabwe), Lusaka (Zambia), Lilongwe (Malawi), Kigali (Rwanda), Bujumbura (Burundi), Lubumbashi (DRC), and Gaborone (Botswana)." },
  { q: "What is the best time for a meeting between CAT and EST?", a: "The best overlap window for video calls between Central Africa and the US East Coast is between 3:00 PM CAT and 5:00 PM CAT. This corresponds to 8:00 AM EST to 10:00 AM EST in New York, capturing the start of the US workday and the end of the African workday." },
  { q: "Is CAT the same offset as South Africa Standard Time (SAST)?", a: "Yes. Both Central Africa Time (CAT) and South Africa Standard Time (SAST) operate at UTC+2 and do not observe Daylight Saving Time. They share identical clock times year-round." },
  { q: "Is CAT the same offset as Eastern European Time (EET)?", a: "During the winter months, Eastern European Time (EET) is at UTC+2, matching CAT. However, in summer, Eastern European countries switch to EEST (UTC+3), whereas CAT stays at UTC+2 year-round." },
  { q: "How do I calculate CAT to EST manually?", a: "Subtract 7 hours from the CAT time. If the result is negative, add 24 hours and roll back to the previous calendar day. For instance, 5:00 AM CAT minus 7 hours equals 10:00 PM EST on the previous evening." },
  { q: "Why are mineral and agricultural trades between Southern Africa and New York sensitive to timezone differences?", a: "Major mining operations in Zambia and DRC export copper and cobalt, while agriculture exporters in Malawi and Zimbabwe deal with US commodity markets. Scheduling morning price fixes requires syncing CAT afternoon hours with US morning opening bells." },
  { q: "How does the date change when converting CAT to EST?", a: "Because EST is 7 hours behind CAT, early morning hours in Central Africa (between 12:00 AM Midnight and 6:59 AM CAT) correspond to the previous calendar day in Eastern Standard Time." },
  { q: "Do airlines flying between North America and Southern Africa use CAT or EST?", a: "Airlines list local departure and arrival times in local airport time (CAT or EST/EDT), but flight operations, telemetry, and pilot logs are managed in UTC to ensure flight safety." },
  { q: "What is the IANA timezone identifier for Central Africa Time?", a: "The IANA Time Zone Database represents CAT using keys such as Africa/Maputo, Africa/Harare, Africa/Lusaka, and Africa/Kigali. All these identifiers resolve to UTC+2." },
  { q: "Are financial transactions between US banks and CAT institutions instant?", a: "Interbank SWIFT settlements sent from US East Coast institutions during US afternoon hours arrive in Central Africa after African banks have closed for the day, processing on the following CAT business morning." },
  { q: "Does Egypt standard time match CAT?", a: "Egypt has periodically adjusted its DST policies. When Egypt operates at UTC+2, it matches CAT, but when Egypt observes summer DST (UTC+3), it runs one hour ahead of CAT." },
  { q: "What is the time difference between Kigali (Rwanda) and New York (EST)?", a: "Kigali is on Central Africa Time (UTC+2). During EST (winter), Kigali is 7 hours ahead of New York. During EDT (summer), Kigali is 6 hours ahead of New York." },
  { q: "How reliable is this CAT to EST conversion calculator?", a: "Our converter uses standard IANA timezone database rules via native browser engine calls, accurately accounting for daylight savings rules in North America while maintaining CAT's static offset." },
  { q: "How does Central Africa Time compare to Greenwich Mean Time (GMT)?", a: "Central Africa Time (CAT) is exactly 2 hours ahead of Greenwich Mean Time (GMT/UTC+0). When it is 12:00 PM GMT in London during winter, it is 2:00 PM CAT in Maputo and Harare." },
  { q: "Do Mozambique and Zimbabwe ever change their timezone?", a: "No. Neither Mozambique nor Zimbabwe has altered its UTC+2 standard time offset in recent decades. The offset remains permanent across all seasons." },
  { q: "What is the offset difference between Lusaka (Zambia) and Atlanta (Georgia)?", a: "Lusaka operates on CAT (UTC+2) and Atlanta operates on EST (UTC-5) or EDT (UTC-4). During US winter, Lusaka is 7 hours ahead of Atlanta; during US summer, it is 6 hours ahead." },
  { q: "How does CAT affect international sports broadcasting?", a: "Major sporting events hosted in Southern Africa (such as international cricket tests in Harare or football matches in Maputo) broadcast in prime afternoon CAT slots, which air during early morning EST hours in the United States." },
  { q: "What time zone is Lubumbashi in the Democratic Republic of the Congo?", a: "Lubumbashi, the mining capital of the DRC, operates on Central Africa Time (CAT, UTC+2). Unlike western DRC (Kinshasa, which uses WAT UTC+1), eastern DRC remains permanently at UTC+2." },
  { q: "Does Botswana use Central Africa Time all year round?", a: "Yes. Botswana observes Central Africa Time (CAT, UTC+2) permanently throughout the year without seasonal clock changes." },
  { q: "How do US investors monitor African stock markets on CAT?", a: "Stock exchanges like the Lusaka Securities Exchange (LuSE) and the Zimbabwe Stock Exchange (ZSE) operate during morning and midday CAT hours, which correspond to overnight and pre-dawn hours in EST." },
  { q: "What is the offset difference between Blantyre (Malawi) and Boston (Massachusetts)?", a: "Blantyre runs on CAT (UTC+2) and Boston runs on EST (UTC-5). In winter, Blantyre is 7 hours ahead of Boston; in summer (EDT, UTC-4), Blantyre is 6 hours ahead." },
  { q: "Does Mozambique observe Daylight Saving Time?", a: "No, Mozambique does not observe Daylight Saving Time. It stays on Central Africa Time (CAT, UTC+2) year-round." },
  { q: "How do international flight arrivals from Johannesburg/Maputo map to EST?", a: "Flights departing Southern Africa late in the evening (around 9:00 PM CAT) arrive in North America early the following morning EST after a long-haul transoceanic flight." },
  { q: "What is the time difference between Victoria Falls and New York City?", a: "Victoria Falls (Zambia/Zimbabwe) is on CAT (UTC+2), making it 7 hours ahead of New York during EST and 6 hours ahead during EDT." },
  { q: "How do software systems parse Africa/Maputo and America/New_York timestamps?", a: "System libraries use Olson IANA timezone database definitions to map Africa/Maputo (+02:00) and America/New_York (-05:00 standard, -04:00 DST), resolving timestamps automatically." },
  { q: "What is the capital of Mozambique and what timezone does it use?", a: "Maputo is the capital of Mozambique, and it uses Central Africa Time (CAT, UTC+2) permanently." },
  { q: "What is the capital of Zimbabwe and what timezone does it use?", a: "Harare is the capital of Zimbabwe, operating on Central Africa Time (CAT, UTC+2) without daylight saving changes." },
  { q: "What is the capital of Zambia and what timezone does it use?", a: "Lusaka is the capital of Zambia, operating on Central Africa Time (CAT, UTC+2) permanently." },
  { q: "What is the capital of Malawi and what timezone does it use?", a: "Lilongwe is the capital of Malawi, operating on Central Africa Time (CAT, UTC+2) year-round." },
];

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "CAT to EST, CAT to EST Converter, Central Africa Time to Eastern Standard Time, Convert CAT to EST, Maputo to New York time, Lusaka to EST, Harare to New York time difference, CAT timezone offset",
  image: "/assets/cat-to-est-og.svg",
  imageAlt: "CAT to EST Converter – Convert Central Africa Time to Eastern Standard Time",
  faqs,
  appDescription: "Free online CAT to EST converter featuring real-time interactive clocks, 24-hour comparison charts, and global business meeting planners.",
  applicationCategory: "UtilityApplication",
  operatingSystem: "Any",
  howToName: "How to Convert CAT to EST",
  howToDescription: "Simple steps to convert Central Africa Time to US Eastern Standard Time.",
  howToSteps: [
    { name: "Input CAT Time", text: "Select your desired Central Africa Time in the converter." },
    { name: "Subtract 7 Hours", text: "The tool automatically subtracts 7 hours to calculate the Eastern Standard Time (EST)." },
    { name: "Check Date Shift", text: "If the input CAT time is early morning (before 7:00 AM), note that the EST time falls on the previous calendar day." },
    { name: "Account for US Summer Time", text: "If converting dates between March and November, remember the US observes Eastern Daylight Time (EDT, UTC-4), making the difference 6 hours." }
  ],
};
---

<BaseLayout
  lang={lang}
  dir={dir}
  title={seoTitle}
  description={pageDescription}
  slug={slug}
  meta={meta}
  mode="gmt-est"
  enableFaqSchema={true}
  allowAds={true}
  breadcrumbHomeLabel="Home"
  breadcrumbLabel="CAT to EST"
>

<!-- ═══════════════════════════════════════════════════════════════════════════
     H1 & INTRODUCTION
     ═══════════════════════════════════════════════════════════════════════ -->
<section class="hero-banner">
  <h1 class="hero-banner-title">
    CAT to EST <span class="gradient-text">Converter</span>
  </h1>
</section>

<!-- PRIMARY CONVERTER & LIVE CLOCKS (Above the Fold) -->
<div style="max-width: 900px; margin: 0 auto; padding: 0 16px 24px;">
  <Converter intent="dynamic" t={t} context={context} />
  
  <!-- LIVE CLOCKS -->
  <section class="clock-grid" aria-label="Live Clocks" style="margin-top: 24px;">
    <h2>Live Clocks</h2>
    <div class="clock-card">
      <span class="eyebrow">Source Time Zone</span>
      <strong id="gmtClock">--:--:--</strong>
    </div>
    <div class="clock-card">
      <span class="eyebrow">Target Time Zone</span>
      <strong id="estClock">--:--:--</strong>
      <p style="margin-top: 4px; font-size: 0.85rem; color: var(--muted);">Active Zone: <em id="estZone">ET</em></p>
    </div>
  </section>
</div>


</div>
</div>


<!-- FEATURE ICONS (CUSTOM SVG) -->
<section class="feature-strip" aria-label="Tool Features">
  <div class="feature-item">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feature-icon" aria-hidden="true">
      <circle cx="12" cy="12" r="10"></circle>
      <polyline points="12 6 12 12 16 14"></polyline>
    </svg>
    <span>7-Hour Time Gap</span>
  </div>
  <div class="feature-item">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feature-icon" aria-hidden="true">
      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
      <line x1="16" y1="2" x2="16" y2="6"></line>
      <line x1="8" y1="2" x2="8" y2="6"></line>
      <line x1="3" y1="10" x2="21" y2="10"></line>
    </svg>
    <span>US DST Logic Included</span>
  </div>
  <div class="feature-item">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feature-icon" aria-hidden="true">
      <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
      <circle cx="9" cy="7" r="4"></circle>
      <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
      <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
    </svg>
    <span>Transatlantic Meeting Sync</span>
  </div>
  <div class="feature-item">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feature-icon" aria-hidden="true">
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="2" y1="12" x2="22" y2="12"></line>
      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
    </svg>
    <span>Africa & US East Coast</span>
