      <g transform="translate(350, 100)">
        <circle cx="0" cy="-10" r="35" fill="#1b536e" stroke="#36c7b5" stroke-width="2" />
        <text x="0" y="-14" font-family="'Space Grotesk', sans-serif" font-size="13" font-weight="bold" fill="#36c7b5" text-anchor="middle">7 HOURS</text>
        <text x="0" y="4" font-family="'Space Grotesk', sans-serif" font-size="11" fill="#f4fbff" text-anchor="middle">BEHIND</text>
        <path d="M-40 25 L40 25" stroke="#36c7b5" stroke-width="2" marker-end="url(#arrow)" />
