      <rect width="700" height="200" fill="#0c354a" rx="8" />
      
      <!-- African Savanna Silhouette (Left) -->
      <g transform="translate(100, 110)">
        <path d="M-70 40 L-70 10 C-40 0, -20 -10, 0 -10 C 20 -10, 40 0, 70 10 L70 40 Z" fill="#12455d" />
        <!-- Acacia Tree silhouette -->
        <path d="M-20 10 L-20 -20 C-35 -30, -10 -45, 0 -45 C 10 -45, 35 -30, 20 -20 L20 10 Z" fill="#36c7b5" opacity="0.7" />
        <text x="0" y="60" font-family="'Space Grotesk', sans-serif" font-size="14" font-weight="bold" fill="#f4fbff" text-anchor="middle">Central Africa (CAT)</text>
        <text x="0" y="78" font-family="'Manrope', sans-serif" font-size="12" fill="#8fd7ff" text-anchor="middle">Maputo • Harare • Lusaka</text>
      </g>

