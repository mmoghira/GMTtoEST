---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import { getPageMeta } from "theme/i18n/config";

const metaBase = getPageMeta("en", "about");
const meta = { ...metaBase, keywords: "about gmt to est, about GMTtoEST, about us GMT to EST, timezone converter about" };
---

<BaseLayout lang="en" dir="ltr" title={meta.title} description={meta.description} slug="about" meta={meta}>
  <section class="content" aria-labelledby="about">
    <h1 id="about">{meta.title}</h1>
    <p>GMT to EST Converter provides fast, date-aware timezone conversions between GMT (UTC) and Eastern Time (EST/EDT). Our mission is to make scheduling across time zones simple and reliable.</p>
    <h2>Our approach</h2>
    <p>We use the IANA timezone rules (for example, <code>America/New_York</code>) to account for daylight saving transitions. The converter shows whether a result is EST or EDT and the exact offset for the selected date.</p>
    <h2>Contribute</h2>
    <p>If you'd like to help with translations, report an issue, or suggest improvements, please visit the <a href="/en/contact/">Contact</a> page.</p>
  </section>
</BaseLayout>
