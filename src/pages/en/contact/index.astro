---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import { getPageMeta } from "theme/i18n/config";

const metaBase = getPageMeta("en", "contact");
const meta = { ...metaBase, keywords: "contact gmt to est, contact GMTtoEST, support GMT to EST, feedback GMT to EST" };
---

<BaseLayout lang="en" dir="ltr" title={meta.title} description={meta.description} slug="contact" meta={meta}>
  <section class="content" aria-labelledby="contact">
    <h1 id="contact">{meta.title}</h1>
    <p>We welcome feedback, translation help, and reports of issues. Use the contact options below.</p>
    <h2>Email</h2>
    <p>Email us at <a href="mailto:hello@gmttoest.com">hello@gmttoest.com</a> (replace with your preferred contact address).</p>
    <h2>Quick message</h2>
    <form action="mailto:hello@gmttoest.com" method="post" enctype="text/plain">
      <label>Name<br><input type="text" name="name" required></label>
      <label>Email<br><input type="email" name="email" required></label>
      <label>Message<br><textarea name="message" rows="6" required></textarea></label>
      <button type="submit">Send</button>
    </form>
  </section>
</BaseLayout>
