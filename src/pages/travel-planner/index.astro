    <div class="cross-links-grid">
      <a href="/world-clock/" class="cross-link-card">🌍 World Clock</a>
      <a href="/meeting-planner/" class="cross-link-card">📅 Meeting Planner</a>
      <a href="/event-time-converter/" class="cross-link-card">🎯 Event Time Converter</a>
      <a href="/developer-tools/" class="cross-link-card">🛠️ Developer Tools</a>
      <a href="/holiday-calendar/" class="cross-link-card">🎉 Holiday Calendar</a>
      <a href="/tools/" class="cross-link-card">🧰 All Tools Hub</a>
    </div>
  </section>

</BaseLayout>

