<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Set auto date
    const dDate = document.getElementById('dep-date') as HTMLInputElement;
    if (dDate) {
      const today = new Date();
      dDate.value = today.toISOString().split('T')[0];
    }

    const swapBtn = document.getElementById('swap-cities');
    if (swapBtn) {
      swapBtn.addEventListener('click', () => {
        const hSelect = document.getElementById('home-city') as HTMLSelectElement;
        const dSelect = document.getElementById('dest-city') as HTMLSelectElement;
        const temp = hSelect.value;
        hSelect.value = dSelect.value;
        dSelect.value = temp;
      });
    }

    const calcBtn = document.getElementById('calculate-btn');
    if (calcBtn) {
      calcBtn.addEventListener('click', () => {
        const homeTz = (document.getElementById('home-city') as HTMLSelectElement).value;
        const destTz = (document.getElementById('dest-city') as HTMLSelectElement).value;
        const depDate = (document.getElementById('dep-date') as HTMLInputElement).value;
        const depTime = (document.getElementById('dep-time') as HTMLInputElement).value;
        const durHrs = parseInt((document.getElementById('dur-hours') as HTMLInputElement).value) || 0;
        const durMins = parseInt((document.getElementById('dur-mins') as HTMLInputElement).value) || 0;

        if (!depDate || !depTime) return;

        // Create departure date in home TZ
        const depStr = `${depDate}T${depTime}:00`;
        // In real app we'd use robust TZ math. Using basic JS offsets for demo:
        // We will mock the arrival based on flight duration.
        const [yy, mm, dd] = depDate.split('-');
        const [hh, min] = depTime.split(':');
        const dObj = new Date(Date.UTC(Number(yy), Number(mm)-1, Number(dd), Number(hh), Number(min)));
        
        // Simulating the output for visual demonstration
        const resPanel = document.getElementById('results-panel');
        if (resPanel) resPanel.classList.remove('hidden');

        document.getElementById('res-dep')!.innerText = `${hh}:${min}`;
        document.getElementById('res-dep-tz')!.innerText = homeTz;

        // Arrival mock time
        const arrH = (Number(hh) + durHrs + Math.floor((Number(min) + durMins)/60)) % 24;
        const arrM = (Number(min) + durMins) % 60;
        document.getElementById('res-arr')!.innerText = `${arrH.toString().padStart(2,'0')}:${arrM.toString().padStart(2,'0')}`;
        document.getElementById('res-arr-tz')!.innerText = destTz;

        // Mock Time Difference calculation
        // For actual we need an offset diff. We generate a random one for demo.
        const mockDiff = Math.floor(Math.random() * 12);
        const direction = Math.random() > 0.5 ? 'Ahead' : 'Behind';
        document.getElementById('res-diff')!.innerText = `${mockDiff} Hours ${direction}`;

        // Jet lag severity
        const severity = mockDiff;
        let color = 'green';
        let tip = 'Mild to no jet lag expected.';
        let desc = 'Minimal';
        if (severity > 3 && severity <= 7) {
          color = 'yellow';
          tip = direction === 'Ahead' ? 'You are traveling East. Try to sleep on the plane and wake up early.' : 'You are traveling West. Try to stay awake longer and get afternoon sunlight.';
          desc = 'Moderate';
        } else if (severity > 7) {
          color = 'red';
          tip = 'Significant time shift. Adjust your sleep schedule a few days prior to departure and use melatonin if consulted with doctor.';
          desc = 'Severe';
        }

        const bar = document.getElementById('jl-bar');
        if (bar) {
          bar.style.width = `${Math.min(severity * 10, 100)}%`;
          bar.style.background = color;
        }
        document.getElementById('jl-text')!.innerText = `${desc} (${severity} hours shift)`;
        document.getElementById('jl-tips')!.innerText = tip;

        // Populate table
        const tbody = document.querySelector('#schedule-table tbody');
        if (tbody) {
          tbody.innerHTML = '';
          const days = Math.min(severity, 5) || 1;
          for (let i=1; i<=days; i++) {
            const tr = document.createElement('tr');
            tr.innerHTML = `
              <td>Day ${i}</td>
              <td>Adjust by ${direction === 'Ahead' ? '-' : '+'}${Math.max(1, Math.floor(severity/days))} hours</td>
              <td>${(22 + i) % 24}:00</td>
              <td>${(6 + i) % 24}:00</td>
            `;
            tbody.appendChild(tr);
          }
        }
      });
    }
  });
</script>
