const lang = "en";
const dir = "ltr";
const slug = "travel-planner";
const seoTitle = "Travel Time Zone Planner — Jet Lag Calculator & Trip Scheduler";
const pageDescription = "Calculate jet lag severity, plan your travel schedule, and get tips for crossing multiple time zones. Plan flights across time zones easily.";

const pubDate = "2026-07-30T15:00:00+05:00";
const updatedDate = "2026-07-30T15:00:00+05:00";

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "travel planner, jet lag calculator, time zone travel, international flights schedule",
  image: "/assets/travel-planner-og.png",
  imageAlt: "Travel Time Zone Planner and Jet Lag Calculator",
  pubDate,
  updatedDate,
  faqs: [
    { q: "What causes jet lag?", a: "Jet lag is a temporary sleep problem that can affect anyone who quickly travels across multiple time zones. Your body has its own internal clock, or circadian rhythm, that signals to your body when to stay awake and when to sleep. Jet lag occurs because your body's clock is still synced to your original time zone." },
    { q: "How long does jet lag last?", a: "As a general rule, it takes about one day to recover for each time zone crossed. For example, if you cross six time zones, it may take three to five days for your body to fully adjust, though individual experiences vary widely." },
    { q: "Is eastward travel worse than westward?", a: "Yes, for most people traveling east is harder because it 'advances' your body clock, meaning you have to go to sleep and wake up earlier. Traveling west 'delays' your clock, which generally aligns better with our natural tendency to stay up later." },
    { q: "Should I sleep on the plane?", a: "If it's nighttime at your destination while you're flying, try to sleep. If it's daytime there, try to stay awake. Adjusting your sleep schedule to your destination time zone as soon as you board the flight can help." },
    { q: "Does drinking alcohol or caffeine help?", a: "No, both can worsen jet lag. Caffeine can keep you awake longer than desired, and alcohol can disrupt sleep quality and increase dehydration. Stick to water to stay hydrated." },
    { q: "Can melatonin cure jet lag?", a: "Melatonin supplements can help reset your body's internal clock and may reduce jet lag symptoms. It's often most effective when traveling east, taken before your new bedtime. Consult your doctor first." },
    { q: "How does light exposure affect jet lag?", a: "Light is a primary cue that influences your circadian rhythm. Exposing yourself to sunlight at the destination can help sync your body clock. Avoid bright light in the evening to prepare for sleep." },
    { q: "Are short trips worth adjusting for?", a: "If your trip is less than two or three days, it might be better to stay on your home time zone schedule as much as possible, rather than trying to adjust and immediately readjust upon return." }
  ]
};

const pageUrlPath = `${siteUrl}/${slug}/`;

