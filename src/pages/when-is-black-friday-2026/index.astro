---
import BaseLayout from "theme/layouts/BaseLayout.astro";

const lang = "en";
const dir = "ltr";
const slug = "when-is-black-friday-2026";
const seoTitle = "When Is Black Friday 2026? Date, Weekend & Cyber Monday";
const pageDescription = "Black Friday 2026 is Friday, November 27, the day after Thanksgiving. See the full Thanksgiving weekend dates.";

const pubDate = "2026-10-25T13:00:00+05:00";
const updatedDate = "2026-10-25T13:00:00+05:00";

const meta = {
  seoTitle,
  exactTitle: true,
  description: pageDescription,
  keywords: "when is black friday 2026, black friday 2026 date, thanksgiving weekend 2026, cyber monday 2026, small business saturday 2026",
  pubDate,
  updatedDate,
  author: "Time Intelligence Team",
  faqs: [
    {
      q: "When is Black Friday 2026?",
      a: "Friday, November 27, 2026."
    },
    {
      q: "Why is Black Friday after Thanksgiving?",
      a: "Black Friday is defined as the Friday after Thanksgiving, which is the fourth Thursday in November, so its calendar date moves each year."
    },
    {
      q: "When is Cyber Monday 2026?",
      a: "Monday, November 30, 2026."
    },
    {
      q: "Is Black Friday a federal holiday?",
      a: "No, it is not a US federal holiday, even though many workplaces close or give staff the day off."
    }
  ]
};
---

<BaseLayout
  lang={lang}
  dir={dir}
  title={seoTitle}
  description={pageDescription}
  slug={slug}
  meta={meta}
  enableFaqSchema={true}
  enableArticleSchema={true}
  allowAds={true}
>
  <!-- Event schema for Black Friday 2026 -->
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Event",
    "name": "Black Friday 2026",
    "startDate": "2026-11-27",
    "endDate": "2026-11-27",
    "eventStatus": "https://schema.org/EventScheduled",
    "eventAttendanceMode": "https://schema.org/MixedEventAttendanceMode",
    "description": "Black Friday 2026 shopping event occurring the day after Thanksgiving."
  })} />

  <!-- Hero Banner -->
  <div class="hero-banner">
    <h1 class="hero-banner-title">When Is Black Friday 2026?</h1>
    <p style="color: #bdd2dc; font-size: clamp(1rem, 2.2vw, 1.25rem); max-width: 640px; margin: 12px auto 0;">
      Dates, full Thanksgiving shopping weekend schedule, and live countdown.
    </p>
  </div>

  <div style="max-width: 780px; margin: 0 auto; padding-top: 24px;">

    <!-- Quick Answer Block Directly Below H1 (Server-Rendered) -->
    <div style="background: color-mix(in srgb, var(--accent) 12%, var(--panel)); border-left: 4px solid var(--accent); border-radius: 0 12px 12px 0; padding: 20px 24px; margin-bottom: 28px; box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);">
      <span style="display: block; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent-2); font-weight: 800; margin-bottom: 6px;">Quick Answer</span>
      <p style="margin: 0; font-size: 1.12rem; line-height: 1.65; color: var(--text); font-weight: 600;">
        Black Friday 2026 is Friday, November 27, 2026, the day after Thanksgiving Day on Thursday, November 26, 2026. Cyber Monday follows on Monday, November 30, 2026.
      </p>
    </div>

    <!-- Hero Image -->
    <div class="infographic-wrapper">
      <img
        src="/assets/when-is-black-friday-2026-hero.webp"
        alt="Calendar marking Black Friday on Friday 27 November 2026 after Thanksgiving"
        class="infographic-image"
        width="960"
        height="540"
        loading="eager"
      />
    </div>

    <!-- H2: Black Friday 2026 date -->
    <section>
      <h2 style="font-size: clamp(1.5rem, 3.5vw, 2rem); border-bottom: 1px solid var(--line); padding-bottom: 12px; margin-bottom: 16px;">Black Friday 2026 date</h2>
      <p style="color: var(--muted); line-height: 1.7; max-width: 72ch;">
        Black Friday in 2026 takes place on <strong style="color: var(--text);">Friday, November 27, 2026</strong>.
      </p>

      <!-- Live Countdown Card -->
      <div style="background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 24px; text-align: center; margin: 24px 0; box-shadow: var(--shadow);">
        <span style="display: block; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent); font-weight: 800; margin-bottom: 12px;">Countdown to Black Friday 2026</span>
        <div id="bf-countdown" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; max-width: 500px; margin: 0 auto;" class="countdown-grid">
          <div style="background: var(--bg); border: 1px solid var(--line); border-radius: 8px; padding: 12px 6px;">
            <strong id="cd-days" style="display: block; font-size: 2rem; color: var(--accent); font-weight: 900;">--</strong>
            <span style="font-size: 0.75rem; color: var(--muted); text-transform: uppercase;">Days</span>
          </div>
          <div style="background: var(--bg); border: 1px solid var(--line); border-radius: 8px; padding: 12px 6px;">
            <strong id="cd-hours" style="display: block; font-size: 2rem; color: var(--text); font-weight: 900;">--</strong>
            <span style="font-size: 0.75rem; color: var(--muted); text-transform: uppercase;">Hours</span>
          </div>
          <div style="background: var(--bg); border: 1px solid var(--line); border-radius: 8px; padding: 12px 6px;">
            <strong id="cd-minutes" style="display: block; font-size: 2rem; color: var(--accent-2); font-weight: 900;">--</strong>
            <span style="font-size: 0.75rem; color: var(--muted); text-transform: uppercase;">Minutes</span>
          </div>
          <div style="background: var(--bg); border: 1px solid var(--line); border-radius: 8px; padding: 12px 6px;">
            <strong id="cd-seconds" style="display: block; font-size: 2rem; color: var(--warn); font-weight: 900;">--</strong>
            <span style="font-size: 0.75rem; color: var(--muted); text-transform: uppercase;">Seconds</span>
          </div>
        </div>
        <p id="cd-passed-message" style="display: none; font-size: 1.2rem; font-weight: 800; color: var(--accent); margin-top: 12px;">
          Black Friday 2026 has arrived!
        </p>
      </div>
    </section>

    <!-- H2: Why Black Friday moves every year -->
    <section>
      <h2 style="font-size: clamp(1.5rem, 3.5vw, 2rem); border-bottom: 1px solid var(--line); padding-bottom: 12px; margin-bottom: 16px;">Why Black Friday moves every year</h2>
      <p style="color: var(--muted); line-height: 1.7; max-width: 72ch;">
        Black Friday is always defined as the Friday immediately following Thanksgiving Day in the United States. Under US federal law enacted in 1941, Thanksgiving is permanently observed on the <strong>fourth Thursday in November</strong>.
      </p>
      <p style="color: var(--muted); line-height: 1.7; max-width: 72ch; margin-top: 12px;">
        Because the calendar dates of Thursdays shift each November, Thanksgiving can fall anywhere between November 22 and November 28. Consequently, Black Friday always falls between <strong>November 23 and November 29</strong>. It is never tied to a static calendar date.
      </p>
    </section>

    <!-- Diagram -->
    <div class="infographic-wrapper">
      <figure style="margin: 0; text-align: center;">
        <img
          src="/assets/thanksgiving-weekend-2026.webp"
          alt="Timeline of the Thanksgiving weekend 2026 from Thanksgiving to Cyber Monday"
          class="infographic-image"
          width="800"
          height="450"
          loading="lazy"
        />
        <figcaption class="infographic-caption">Thanksgiving, Black Friday, Small Business Saturday and Cyber Monday in 2026.</figcaption>
      </figure>
    </div>

    <!-- H2: The full Thanksgiving weekend 2026 -->
    <section>
      <h2 style="font-size: clamp(1.5rem, 3.5vw, 2rem); border-bottom: 1px solid var(--line); padding-bottom: 12px; margin-bottom: 16px;">The full Thanksgiving weekend 2026</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Day & Date</th>
              <th>Occasion</th>
              <th>Description</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Thursday, November 26, 2026</td>
              <td>Thanksgiving Day</td>
              <td>US federal holiday; family gatherings and traditional meals</td>
            </tr>
            <tr>
              <td>Friday, November 27, 2026</td>
              <td>Black Friday</td>
              <td>Unofficial kickoff of the holiday shopping season</td>
            </tr>
            <tr>
              <td>Saturday, November 28, 2026</td>
              <td>Small Business Saturday</td>
              <td>Nationwide initiative supporting independent local merchants</td>
            </tr>
            <tr>
              <td>Monday, November 30, 2026</td>
              <td>Cyber Monday</td>
              <td>Major online-focused commercial sale and technology promotion day</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- H2: Is Black Friday a public holiday? -->
    <section>
      <h2 style="font-size: clamp(1.5rem, 3.5vw, 2rem); border-bottom: 1px solid var(--line); padding-bottom: 12px; margin-bottom: 16px;">Is Black Friday a public holiday?</h2>
      <p style="color: var(--muted); line-height: 1.7; max-width: 72ch;">
        No. Black Friday is not a US federal holiday. Many corporate employers, schools, and private offices choose to close or provide paid leave to grant employees a four-day holiday weekend. However, financial markets, banks, post offices, and local government offices follow their own independent schedules and operations—they are not universally closed.
      </p>
    </section>

    <!-- H2: When do Black Friday sales actually start? -->
    <section>
      <h2 style="font-size: clamp(1.5rem, 3.5vw, 2rem); border-bottom: 1px solid var(--line); padding-bottom: 12px; margin-bottom: 16px;">When do Black Friday sales actually start?</h2>
      <p style="color: var(--muted); line-height: 1.7; max-width: 72ch;">
        Many retailers now run online promotional deals days or even weeks before Black Friday arrives. In-store operating hours, doorbusters, and opening times vary widely by company and physical store location. Check each individual retailer's official website directly for their confirmed operating hours and promotional schedule.
      </p>
    </section>

    <!-- Internal Links -->
    <section>
      <div class="info-callout">
        <p>
          Need to count the exact number of days or business days until the shopping holiday? Use our <a href="/days-between-dates-calculator/" style="color: var(--accent); font-weight: 700; text-decoration: underline; text-underline-offset: 3px;">Days Between Dates Calculator</a>. You can also explore our <a href="/" style="color: var(--accent); font-weight: 700; text-decoration: underline; text-underline-offset: 3px;">GMT to EST Converter</a> homepage.
        </p>
      </div>
    </section>
  </div>

  <!-- FAQ Section -->
  <section style="max-width: 780px; margin: 0 auto; padding: 48px 0 24px;">
    <h2 style="font-size: clamp(1.5rem, 3.5vw, 2rem); text-align: center; margin-bottom: 20px;">Frequently Asked Questions</h2>
    <div class="faq">
      {meta.faqs.map(faq => (
        <details style="padding: 16px; background: var(--panel); border: 1px solid var(--line); border-radius: 8px;">
          <summary style="font-weight: 800; cursor: pointer;">{faq.q}</summary>
          <p style="margin: 12px 0 0; color: var(--muted); line-height: 1.65;">{faq.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- Countdown Script -->
  <script is:inline>
    (function () {
      var targetDate = new Date('2026-11-27T00:00:00');

      var daysEl = document.getElementById('cd-days');
      var hoursEl = document.getElementById('cd-hours');
      var minutesEl = document.getElementById('cd-minutes');
      var secondsEl = document.getElementById('cd-seconds');
      var countdownGrid = document.getElementById('bf-countdown');
      var passedMessage = document.getElementById('cd-passed-message');

      function updateCountdown() {
        var now = new Date();
        var diff = targetDate.getTime() - now.getTime();

        if (diff <= 0) {
          daysEl.textContent = '0';
          hoursEl.textContent = '0';
          minutesEl.textContent = '0';
          secondsEl.textContent = '0';
          passedMessage.style.display = 'block';
          return;
        }

        var totalSeconds = Math.floor(diff / 1000);
        var days = Math.floor(totalSeconds / 86400);
        var remSec = totalSeconds % 86400;
        var hours = Math.floor(remSec / 3600);
        remSec %= 3600;
        var minutes = Math.floor(remSec / 60);
        var seconds = remSec % 60;

        daysEl.textContent = days;
        hoursEl.textContent = hours;
        minutesEl.textContent = minutes;
        secondsEl.textContent = seconds;
      }

      updateCountdown();
      setInterval(updateCountdown, 1000);
    })();
  </script>

  <style>
    @media (max-width: 480px) {
      .countdown-grid {
        grid-template-columns: repeat(2, 1fr) !important;
      }
    }
  </style>
</BaseLayout>
