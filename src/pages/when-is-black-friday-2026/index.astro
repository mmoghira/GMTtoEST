---
import BaseLayout from "theme/layouts/BaseLayout.astro";

const lang = "en";
const dir = "ltr";
const slug = "when-is-black-friday-2026";
const seoTitle = "When Is Black Friday 2026? Date, Countdown & Cyber Monday";
const pageDescription = "Black Friday 2026 is Friday, November 27, 2026, following Thanksgiving on November 26. Track the live countdown, weekend shopping schedule, and Cyber Monday dates.";

const pubDate = "2026-10-25T13:00:00+05:00";
const updatedDate = "2026-10-25T14:40:00+05:00";

const meta = {
  seoTitle,
  exactTitle: true,
  description: pageDescription,
  keywords: "when is black friday 2026, black friday 2026 date, black friday countdown, thanksgiving weekend 2026, small business saturday 2026, cyber monday 2026",
  pubDate,
  updatedDate,
  author: "Time Intelligence Team",
  faqs: [
    {
      q: "What is the official date for Black Friday in 2026?",
      a: "Black Friday 2026 takes place on Friday, November 27, 2026. It is observed on the day immediately following Thanksgiving Day in the United States."
    },
    {
      q: "Why does the date of Black Friday change every year?",
      a: "Under US federal law established in 1941, Thanksgiving is permanently set as the fourth Thursday in November. Because Thursday dates shift annually between November 22 and 28, Black Friday moves accordingly between November 23 and 29."
    },
    {
      q: "What are the dates for Thanksgiving weekend and Cyber Monday 2026?",
      a: "The full shopping weekend includes Thanksgiving Day on Thursday, November 26; Black Friday on Friday, November 27; Small Business Saturday on Saturday, November 28; and Cyber Monday on Monday, November 30, 2026."
    },
    {
      q: "Is Black Friday a federal holiday in the United States?",
      a: "No. Black Friday is not a recognized US federal holiday. While federal offices and mail delivery operate normally, many state governments, corporate employers, and public school districts grant paid leave for a four-day holiday weekend."
    },
    {
      q: "What is the difference between Black Friday and Cyber Monday?",
      a: "Black Friday traditionally emphasizes in-store doorbusters, large home electronics, TVs, and department store sales (alongside early digital releases). Cyber Monday focuses exclusively on online e-commerce deals, laptops, software subscriptions, gaming gear, and site-wide digital discounts."
    },
    {
      q: "When will Black Friday take place in 2027?",
      a: "In 2027, Thanksgiving Day falls on Thursday, November 25, 2027. Consequently, Black Friday 2027 will take place on Friday, November 26, 2027."
    }
  ]
};
---

<BaseLayout
  lang={lang}
  dir={dir}
  title={seoTitle}
  description={pageDescription}
  slug={slug}
  meta={meta}
  enableFaqSchema={true}
  enableArticleSchema={true}
  allowAds={true}
>
  <!-- Schema: Article Structured Data -->
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "When Is Black Friday 2026? Date, Countdown & Cyber Monday",
    "description": pageDescription,
    "image": "https://gmttoestconverter.com/assets/black-friday-2026-shopping-guide.webp",
    "datePublished": pubDate,
    "dateModified": updatedDate,
    "author": {
      "@type": "Organization",
      "name": "Time Intelligence Team",
      "url": "https://gmttoestconverter.com"
    },
    "publisher": {
      "@type": "Organization",
      "name": "GMTtoESTConverter.com",
      "url": "https://gmttoestconverter.com"
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": "https://gmttoestconverter.com/when-is-black-friday-2026/"
    }
  })}></script>

  <!-- Schema: Event Structured Data -->
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Event",
    "name": "Black Friday 2026",
    "startDate": "2026-11-27T00:00:00-05:00",
    "endDate": "2026-11-27T23:59:59-05:00",
    "eventStatus": "https://schema.org/EventScheduled",
    "eventAttendanceMode": "https://schema.org/MixedEventAttendanceMode",
    "description": "Black Friday 2026 commercial shopping event taking place across the United States and internationally.",
    "location": {
      "@type": "Place",
      "name": "United States & Global Retailers"
    }
  })}></script>

  <!-- Hero Banner -->
  <div class="hero-banner">
    <h1 class="hero-banner-title">When Is Black Friday 2026?</h1>
    <p style="color: #bdd2dc; font-size: clamp(1rem, 2.2vw, 1.25rem); max-width: 680px; margin: 12px auto 0;">
      Verified date, live Eastern Time countdown, Thanksgiving holiday weekend schedule, and shopping tips.
    </p>
  </div>

  <div style="max-width: 780px; margin: 0 auto; padding-top: 24px;">

    <!-- Direct Answer Block (Quick Answer) -->
    <div style="background: color-mix(in srgb, var(--accent) 12%, var(--panel)); border-left: 4px solid var(--accent); border-radius: 0 12px 12px 0; padding: 22px 26px; margin-bottom: 24px; box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);">
      <span style="display: block; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent-2); font-weight: 800; margin-bottom: 6px;">Direct Answer</span>
      <p style="margin: 0; font-size: 1.15rem; line-height: 1.65; color: var(--text); font-weight: 600;">
        Black Friday 2026 is on <strong>Friday, November 27, 2026</strong>. It falls directly after Thanksgiving Day on Thursday, November 26, 2026, and is followed by Small Business Saturday on November 28 and Cyber Monday on Monday, November 30, 2026.
      </p>
    </div>

    <!-- Live Countdown Component Card (High Visual Priority) -->
    <div id="countdown-card" style="background: var(--panel); border: 2px solid var(--line); border-radius: 14px; padding: clamp(20px, 4vw, 32px); text-align: center; margin: 24px 0; box-shadow: var(--shadow);">
      <span style="display: block; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--accent); font-weight: 800; margin-bottom: 4px;">Live Countdown</span>
      <h2 style="font-size: clamp(1.2rem, 2.8vw, 1.6rem); margin-top: 0; margin-bottom: 8px; border: none; padding: 0;">Countdown to Black Friday 2026</h2>
      <p style="font-size: 0.85rem; color: var(--muted); margin: 0 auto 16px; max-width: 500px;">
        Target: Midnight kickoff on Friday, November 27, 2026 (00:00:00 US Eastern Standard Time / UTC−5).
      </p>

      <!-- Accessible fallback message if JS is disabled -->
      <noscript>
        <div style="background: var(--bg); border: 1px solid var(--line); border-radius: 8px; padding: 12px; margin-bottom: 12px; color: var(--text);">
          Black Friday begins promptly at 00:00 EST on Friday, November 27, 2026. Enable JavaScript for a live ticking countdown.
        </div>
      </noscript>

      <!-- Live Countdown Grid -->
      <div id="bf-countdown" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; max-width: 540px; margin: 0 auto;" class="countdown-grid" aria-live="polite">
        <div style="background: var(--bg); border: 1px solid var(--line); border-radius: 10px; padding: 16px 8px;">
          <strong id="cd-days" style="display: block; font-size: clamp(2rem, 5vw, 2.75rem); color: var(--accent); font-weight: 900; line-height: 1; font-variant-numeric: tabular-nums;">--</strong>
          <span style="font-size: 0.75rem; color: var(--muted); text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em; margin-top: 6px; display: block;">Days</span>
        </div>
        <div style="background: var(--bg); border: 1px solid var(--line); border-radius: 10px; padding: 16px 8px;">
          <strong id="cd-hours" style="display: block; font-size: clamp(2rem, 5vw, 2.75rem); color: var(--text); font-weight: 900; line-height: 1; font-variant-numeric: tabular-nums;">--</strong>
          <span style="font-size: 0.75rem; color: var(--muted); text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em; margin-top: 6px; display: block;">Hours</span>
        </div>
        <div style="background: var(--bg); border: 1px solid var(--line); border-radius: 10px; padding: 16px 8px;">
          <strong id="cd-minutes" style="display: block; font-size: clamp(2rem, 5vw, 2.75rem); color: var(--accent-2); font-weight: 900; line-height: 1; font-variant-numeric: tabular-nums;">--</strong>
          <span style="font-size: 0.75rem; color: var(--muted); text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em; margin-top: 6px; display: block;">Minutes</span>
        </div>
        <div style="background: var(--bg); border: 1px solid var(--line); border-radius: 10px; padding: 16px 8px;">
          <strong id="cd-seconds" style="display: block; font-size: clamp(2rem, 5vw, 2.75rem); color: var(--warn); font-weight: 900; line-height: 1; font-variant-numeric: tabular-nums;">--</strong>
          <span style="font-size: 0.75rem; color: var(--muted); text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em; margin-top: 6px; display: block;">Seconds</span>
        </div>
      </div>

      <!-- Live Status Banner (Only appears upon arrival) -->
      <div id="cd-passed-message" style="display: none; background: rgba(54, 199, 181, 0.15); border: 1px solid var(--accent); border-radius: 8px; padding: 14px; margin-top: 16px; color: #ffffff; font-weight: 800; font-size: 1.15rem;">
        🎉 Black Friday 2026 has officially arrived!
      </div>
    </div>

    <!-- Editorial Hero Image (Eager Loading for LCP) -->
    <div class="infographic-wrapper" style="margin-top: 32px;">
      <img
        src="/assets/black-friday-2026-shopping-guide.webp"
        alt="Black Friday 2026 holiday shopping calendar showing dates for Thanksgiving, Black Friday, Small Business Saturday and Cyber Monday"
        class="infographic-image"
        width="960"
        height="540"
        loading="eager"
      />
    </div>

    <!-- H2: Thanksgiving 2026 date and the holiday connection -->
    <section>
      <h2 style="font-size: clamp(1.5rem, 3.5vw, 2rem); border-bottom: 1px solid var(--line); padding-bottom: 12px; margin-bottom: 16px;">Thanksgiving 2026 date and the holiday connection</h2>
      <p style="color: var(--muted); line-height: 1.7; max-width: 72ch;">
        In 2026, <strong>Thanksgiving Day falls on Thursday, November 26, 2026</strong>. Black Friday immediately follows on <strong>November 27</strong>.
      </p>
      <p style="color: var(--muted); line-height: 1.7; max-width: 72ch; margin-top: 12px;">
        The bond between Thanksgiving and commercial holiday shopping originated in the late 19th and early 20th centuries. Department store parades—most notably the Macy's Thanksgiving Day Parade launched in 1924—traditionally culminated with the arrival of Santa Claus, signaling the official start of the Christmas gift-buying season. By the 1960s, the term "Black Friday" was popularized by Philadelphia traffic police to describe the heavy pedestrian and automotive congestion surrounding downtown retail stores on the day after Thanksgiving. Later, retailers reframed the narrative, associating Black Friday with the point in the financial year when store accounts crossed from operating at a loss ("in the red") into profitability ("in the black").
      </p>
    </section>

    <!-- H2: Why Black Friday's calendar date moves every year -->
    <section style="margin-top: 36px;">
      <h2 style="font-size: clamp(1.5rem, 3.5vw, 2rem); border-bottom: 1px solid var(--line); padding-bottom: 12px; margin-bottom: 16px;">Why Black Friday's calendar date moves every year</h2>
      <p style="color: var(--muted); line-height: 1.7; max-width: 72ch;">
        Unlike calendar holidays with static dates such as Christmas Day (December 25) or New Year's Day (January 1), Black Friday is a floating observance.
      </p>
      <p style="color: var(--muted); line-height: 1.7; max-width: 72ch; margin-top: 12px;">
        On December 26, 1941, President Franklin D. Roosevelt signed Public Law 77-372, officially establishing that Thanksgiving in the United States must always be celebrated on the <strong>fourth Thursday of November</strong>. Because the fourth Thursday shifts between November 22 and November 28 depending on how the calendar month aligns:
      </p>
      <ul style="color: var(--muted); line-height: 1.7; padding-left: 20px; margin: 14px 0;">
        <li>The <strong>earliest possible date</strong> for Black Friday is <strong>November 23</strong> (occurring when November begins on a Thursday).</li>
        <li>The <strong>latest possible date</strong> for Black Friday is <strong>November 29</strong> (occurring when November begins on a Friday).</li>
        <li>In <strong>2026</strong>, November 1 is a Sunday, making November 26 the fourth Thursday and placing Black Friday on <strong>November 27</strong>.</li>
      </ul>
      <p style="color: var(--muted); line-height: 1.7; max-width: 72ch;">
        To calculate the exact number of days or business working hours between today and Thanksgiving weekend, try our <a href="/days-between-dates-calculator/" style="color: var(--accent); font-weight: 700; text-decoration: underline; text-underline-offset: 3px;">Days Between Dates Calculator</a> or check the <a href="/time-duration-calculator/" style="color: var(--accent); font-weight: 700; text-decoration: underline; text-underline-offset: 3px;">Time Duration Calculator</a>.
      </p>
    </section>

    <!-- Explanatory Diagram 2: Thanksgiving Weekend Calendar -->
    <div class="infographic-wrapper" style="margin-top: 36px;">
      <figure style="margin: 0; text-align: center;">
        <img
          src="/assets/black-friday-thanksgiving-weekend-calendar.webp"
          alt="Timeline infographic outlining the Thanksgiving weekend schedule from Thursday November 26 to Cyber Monday November 30 2026"
          class="infographic-image"
          width="800"
          height="450"
          loading="lazy"
        />
        <figcaption class="infographic-caption">Chronological schedule of the 2026 holiday shopping weekend.</figcaption>
      </figure>
    </div>

    <!-- H2: The full Thanksgiving weekend 2026 shopping schedule -->
    <section style="margin-top: 36px;">
      <h2 style="font-size: clamp(1.5rem, 3.5vw, 2rem); border-bottom: 1px solid var(--line); padding-bottom: 12px; margin-bottom: 16px;">The full Thanksgiving weekend 2026 shopping schedule</h2>
      <p style="color: var(--muted); line-height: 1.7; max-width: 72ch;">
        Today, holiday shopping is no longer confined to a single Friday. The commercial calendar spans a five-day sequence often referred to by retailers as the "Cyber 5":
      </p>
      <div style="background: var(--panel); border: 1px solid var(--line); border-radius: 8px; overflow-x: auto; margin: 18px 0;">
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.95rem; min-width: 580px;">
          <thead>
            <tr style="border-bottom: 1px solid var(--line); background: var(--bg);">
              <th style="padding: 12px 14px; color: var(--accent-2);">Date & Day</th>
              <th style="padding: 12px 14px; color: var(--accent-2);">Occasion</th>
              <th style="padding: 12px 14px; color: var(--accent-2);">Focus & Shopping Significance</th>
            </tr>
          </thead>
          <tbody style="color: var(--muted);">
            <tr style="border-bottom: 1px solid var(--line);">
              <td style="padding: 12px 14px; font-weight: 700; color: var(--text);">Thursday, Nov 26, 2026</td>
              <td style="padding: 12px 14px; color: #93c5fd; font-weight: 700;">Thanksgiving Day</td>
              <td style="padding: 12px 14px;">US federal holiday. Most major big-box retailers remain closed for family gatherings, though online early-access sales open in the afternoon and evening.</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--line);">
              <td style="padding: 12px 14px; font-weight: 700; color: var(--text);">Friday, Nov 27, 2026</td>
              <td style="padding: 12px 14px; color: var(--warn); font-weight: 800;">Black Friday</td>
              <td style="padding: 12px 14px;">The peak day for in-store doorbusters, department store promotions, consumer electronics, television bundles, and comprehensive omnichannel sales.</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--line);">
              <td style="padding: 12px 14px; font-weight: 700; color: var(--text);">Saturday, Nov 28, 2026</td>
              <td style="padding: 12px 14px; color: #6ee7b7; font-weight: 700;">Small Business Saturday</td>
              <td style="padding: 12px 14px;">Founded in 2010 to encourage consumers to patronize independent downtown boutiques, local craft stores, neighborhood bookstores, and community merchants.</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--line);">
              <td style="padding: 12px 14px; font-weight: 700; color: var(--text);">Sunday, Nov 29, 2026</td>
              <td style="padding: 12px 14px; color: #cbd5e1; font-weight: 600;">Cyber Sunday</td>
              <td style="padding: 12px 14px;">A digital transition day featuring early online Cyber Monday sneak peeks and limited-inventory flash markdowns.</td>
            </tr>
            <tr>
              <td style="padding: 12px 14px; font-weight: 700; color: var(--text);">Monday, Nov 30, 2026</td>
              <td style="padding: 12px 14px; color: #c084fc; font-weight: 800;">Cyber Monday</td>
              <td style="padding: 12px 14px;">The biggest online shopping event of the year, focusing heavily on technology hardware, laptops, PC gaming gear, digital subscriptions, and site-wide free shipping codes.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Explanatory Diagram 3: Black Friday vs Cyber Monday -->
    <div class="infographic-wrapper" style="margin-top: 36px;">
      <figure style="margin: 0; text-align: center;">
        <img
          src="/assets/black-friday-vs-cyber-monday-guide.webp"
          alt="Comparison diagram highlighting distinct product categories and shopping methods for Black Friday vs Cyber Monday"
          class="infographic-image"
          width="800"
          height="450"
          loading="lazy"
        />
        <figcaption class="infographic-caption">Key differences between Black Friday retail deals and Cyber Monday online markdowns.</figcaption>
      </figure>
    </div>

    <!-- H2: Black Friday vs. Cyber Monday: Practical differences -->
    <section style="margin-top: 36px;">
      <h2 style="font-size: clamp(1.5rem, 3.5vw, 2rem); border-bottom: 1px solid var(--line); padding-bottom: 12px; margin-bottom: 16px;">Black Friday vs. Cyber Monday: Practical differences</h2>
      <p style="color: var(--muted); line-height: 1.7; max-width: 72ch;">
        While Black Friday and Cyber Monday were once entirely distinct—one occurring on physical retail store floors and the other behind computer screens—modern commerce has blended both into digital environments. Nevertheless, notable tactical differences remain for savvy shoppers:
      </p>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; margin: 20px 0;">
        <div style="background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 20px;">
          <h3 style="font-size: 1.15rem; color: var(--warn); margin-top: 0; margin-bottom: 8px;">Black Friday (Nov 27)</h3>
          <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0;">
            Historically best for major home appliances, large-screen 4K televisions, gaming consoles, apparel, toys, and doorbuster loss-leaders. Brick-and-mortar stores offer exclusive in-person inventory alongside curb-side pickup options.
          </p>
        </div>
        <div style="background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 20px;">
          <h3 style="font-size: 1.15rem; color: #c084fc; margin-top: 0; margin-bottom: 8px;">Cyber Monday (Nov 30)</h3>
          <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0;">
            Best for personal computing, laptops, tablets, smart home ecosystems, SaaS subscriptions, digital gift cards, and fashion retailers offering sitewide percentage discounts (e.g., 30% to 50% off entire carts).
          </p>
        </div>
      </div>
    </section>

    <!-- H2: Smart shopping preparation: Budgeting, price comparison, and avoiding false discounts -->
    <section style="margin-top: 36px;">
      <h2 style="font-size: clamp(1.5rem, 3.5vw, 2rem); border-bottom: 1px solid var(--line); padding-bottom: 12px; margin-bottom: 16px;">Smart shopping preparation: Budgeting, price comparison, and avoiding false discounts</h2>
      <p style="color: var(--muted); line-height: 1.7; max-width: 72ch;">
        With aggressive promotional messaging during the holiday season, strategic preparation helps consumers secure genuine savings while avoiding retail traps:
      </p>
      <ul style="color: var(--muted); line-height: 1.7; padding-left: 20px; margin: 14px 0;">
        <li><strong>Track Historical Price Trends:</strong> Use free price-tracking extensions and tools (such as CamelCamelCamel or Keepa) to verify whether a "sale" price is genuinely the lowest price of the year or merely a markup returned to average retail value.</li>
        <li><strong>Set a Fixed Spending Limit:</strong> Establish a holiday shopping spreadsheet with strict per-person budgets before promotional emails begin arriving to prevent impulse buying.</li>
        <li><strong>Examine Model Numbers Carefully:</strong> Beware of "derivative models"—televisions and electronics manufactured specifically for holiday doorbuster sales that lack specific HDMI ports, premium panel refresh rates, or audio capabilities found on standard models.</li>
        <li><strong>Verify Holiday Return Windows:</strong> Most reputable retailers extend standard 14-day or 30-day return windows through mid-January for items purchased between late October and December, but restocking fees and exclusions on opened software or electronics often apply.</li>
      </ul>
    </section>

    <!-- H2: When do retail promotions and store hours actually start? -->
    <section style="margin-top: 36px;">
      <h2 style="font-size: clamp(1.5rem, 3.5vw, 2rem); border-bottom: 1px solid var(--line); padding-bottom: 12px; margin-bottom: 16px;">When do retail promotions and store hours actually start?</h2>
      <p style="color: var(--muted); line-height: 1.7; max-width: 72ch;">
        The traditional tradition of standing in midnight lines outside shopping malls on Thanksgiving night has largely shifted. Most major retailers (including Walmart, Target, Best Buy, and Costco) now keep physical doors closed on Thanksgiving Day, launching their primary online promotions early on Thursday morning.
      </p>
      <p style="color: var(--muted); line-height: 1.7; max-width: 72ch; margin-top: 12px;">
        Physical store opening times on Friday, November 27, 2026, typically range from <strong>5:00 a.m. to 6:00 a.m. local time</strong>. However, because promotional calendars and operating hours are established independently by each retail chain, shoppers should verify localized store hours directly on individual merchant websites rather than relying on generalized assumptions.
      </p>
    </section>

    <!-- H2: Looking forward: When is Black Friday in 2027? -->
    <section style="margin-top: 36px;">
      <h2 style="font-size: clamp(1.5rem, 3.5vw, 2rem); border-bottom: 1px solid var(--line); padding-bottom: 12px; margin-bottom: 16px;">Looking forward: When is Black Friday in 2027?</h2>
      <p style="color: var(--muted); line-height: 1.7; max-width: 72ch;">
        For commercial supply chain planners, e-commerce managers, and advance holiday organizers:
      </p>
      <div style="background: var(--panel); border-left: 4px solid var(--accent); border-radius: 0 8px 8px 0; padding: 18px 22px; margin: 16px 0;">
        <strong style="display: block; font-size: 1.1rem; color: #ffffff;">Black Friday 2027 Date: Friday, November 26, 2027</strong>
        <span style="display: block; color: var(--muted); font-size: 0.95rem; margin-top: 6px;">
          Thanksgiving Day 2027 falls on Thursday, November 25, 2027. Cyber Monday 2027 follows on Monday, November 29, 2027.
        </span>
      </div>
      <p style="color: var(--muted); line-height: 1.7; max-width: 72ch;">
        Once November 27, 2026 passes, our editorial team will update this page to reflect verified post-event retrospective metrics and launch the active countdown for Black Friday 2027.
      </p>
    </section>

    <!-- Internal Links Card -->
    <section style="margin-top: 36px;">
      <div class="info-callout" style="background: var(--panel); border-left: 4px solid var(--accent); padding: 20px; border-radius: 8px;">
        <h3 style="font-size: 1.15rem; color: #ffffff; margin-top: 0; margin-bottom: 8px;">Related Time & Date Tools</h3>
        <p style="color: var(--muted); line-height: 1.6; margin: 0;">
          Count the exact days remaining until the holiday sales rush with the <a href="/days-between-dates-calculator/" style="color: var(--accent); font-weight: 700; text-decoration: underline; text-underline-offset: 3px;">Days Between Dates Calculator</a>, measure event windows with the <a href="/time-duration-calculator/" style="color: var(--accent); font-weight: 700; text-decoration: underline; text-underline-offset: 3px;">Time Duration Calculator</a>, or verify international launch hours using the live <a href="/full-screen-clock/" style="color: var(--accent); font-weight: 700; text-decoration: underline; text-underline-offset: 3px;">Full Screen Clock</a>.
        </p>
      </div>
    </section>
  </div>

  <!-- FAQ Section -->
  <section style="max-width: 780px; margin: 0 auto; padding: 48px 0 24px;">
    <h2 style="font-size: clamp(1.5rem, 3.5vw, 2rem); text-align: center; margin-bottom: 20px;">Frequently Asked Questions</h2>
    <div class="faq">
      {meta.faqs.map(faq => (
        <details style="padding: 16px; background: var(--panel); border: 1px solid var(--line); border-radius: 8px; margin-bottom: 12px;">
          <summary style="font-weight: 800; cursor: pointer; color: var(--text);">{faq.q}</summary>
          <p style="margin: 12px 0 0; color: var(--muted); line-height: 1.65;">{faq.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- Resilient Countdown Script -->
  <script is:inline>
    (function () {
      // Black Friday 2026 begins midnight Friday Nov 27, 2026 US Eastern Standard Time (EST is UTC-5 in late November)
      // Equivalent to 2026-11-27T05:00:00.000Z
      var TARGET_TIMESTAMP_MS = 1795755600000;

      var daysEl = document.getElementById('cd-days');
      var hoursEl = document.getElementById('cd-hours');
      var minutesEl = document.getElementById('cd-minutes');
      var secondsEl = document.getElementById('cd-seconds');
      var passedMessage = document.getElementById('cd-passed-message');

      function updateCountdown() {
        var now = Date.now();
        var diff = TARGET_TIMESTAMP_MS - now;

        if (diff <= 0) {
          if (daysEl) daysEl.textContent = '0';
          if (hoursEl) hoursEl.textContent = '0';
          if (minutesEl) minutesEl.textContent = '0';
          if (secondsEl) secondsEl.textContent = '0';
          if (passedMessage) passedMessage.style.display = 'block';
          return;
        }

        var totalSeconds = Math.floor(diff / 1000);
        var days = Math.floor(totalSeconds / 86400);
        var rem1 = totalSeconds % 86400;
        var hours = Math.floor(rem1 / 3600);
        var rem2 = rem1 % 3600;
        var minutes = Math.floor(rem2 / 60);
        var seconds = rem2 % 60;

        if (daysEl) daysEl.textContent = days;
        if (hoursEl) hoursEl.textContent = hours;
        if (minutesEl) minutesEl.textContent = minutes;
        if (secondsEl) secondsEl.textContent = seconds;
        if (passedMessage) passedMessage.style.display = 'none';
      }

      // Initialize immediately to prevent placeholder dashes, then update every second
      try {
        updateCountdown();
        setInterval(updateCountdown, 1000);
      } catch (err) {
        console.error('Countdown initialization error:', err);
      }
    })();
  </script>

  <style>
    @media (max-width: 480px) {
      .countdown-grid {
        grid-template-columns: repeat(2, 1fr) !important;
      }
    }
  </style>
</BaseLayout>
