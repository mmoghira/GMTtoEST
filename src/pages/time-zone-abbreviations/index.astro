    { name: "travel-timezone-abbreviations.webp", alt: "Travel Planning Illustration" },
    { name: "business-meeting-abbreviations.webp", alt: "Business Meeting Illustration" }
  ].map((img) => ({
    "@context": "https://schema.org",
    "@type": "ImageObject",
    "contentUrl": `${siteUrl}/assets/${img.name}`,
    "license": `${siteUrl}/terms-of-service/`,
    "acquireLicensePage": `${siteUrl}/contact-us/`,
    "creditText": "GMT to EST Converter",
