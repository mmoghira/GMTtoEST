    </article>

    <!-- UTC -->
    <article class="method-card" style="margin-bottom: 2rem;">
      <h3>UTC</h3>
      <p>
        <strong>Full Name:</strong> Coordinated Universal Time  
        <br /><strong>Offset:</strong> Reference baseline (UTC+0) year-round  
