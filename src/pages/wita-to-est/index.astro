---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import Converter from "theme/components/Converter.astro";
import { getLang, getTranslation, getPageMeta } from "theme/i18n/config";

const lang = "en";
const dir = "ltr";
const slug = "wita-to-est";
const t = getTranslation(lang);
const meta = getPageMeta(lang, "witaToEst");

const seoTitle = "WITA to EST Converter – Bali & Central Indonesia to Eastern Time";
const pageDescription = "Convert WITA to EST and EDT instantly. View the 24-hour conversion chart, check Bali to New York time shifts, and schedule international meetings.";

const context = {
  from: "WITA",
  to: "EST",
  fromZone: "Asia/Makassar",
  toZone: "America/New_York"
};

const canonical = "https://gmttoestconverter.com/wita-to-est/";

// Helper to format 12-hour values
function formatHour12(hour: number, minute: number = 0) {
  const normalized = ((hour % 24) + 24) % 24;
  const period = normalized < 12 ? "AM" : "PM";
  const displayHour = normalized % 12 || 12;
  return `${displayHour}:${String(minute).padStart(2, "0")} ${period}`;
}

// Generate the 24-hour comparative table rows (WITA = UTC+8, EST = UTC-5 / EDT = UTC-4)
const conversionRows = Array.from({ length: 24 }, (_, hour) => {
  const estHour = (hour - 13 + 24) % 24;
  const estDayDiff = (hour - 13) < 0 ? "Previous day" : "Same day";

  const edtHour = (hour - 12 + 24) % 24;
  const edtDayDiff = (hour - 12) < 0 ? "Previous day" : "Same day";

  return {
    wita: formatHour12(hour),
    est: `${formatHour12(estHour)} EST (${estDayDiff})`,
    edt: `${formatHour12(edtHour)} EDT (${edtDayDiff})`,
    offset: "WITA is UTC+8 | EST is UTC-5 / EDT is UTC-4",
    notes: `Winter gap: 13h (EST). Summer gap: 12h (EDT).`
  };
});

// JSON-LD Schema definitions
const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "WITA to EST Converter",
    "applicationCategory": "UtilitiesApplication",
    "operatingSystem": "Any",
    "url": canonical,
    "description": "Free online WITA to EST converter with real-time clocks, Bali to New York time shifts, and date-aware timezone guidelines."
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is WITA?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "WITA stands for Waktu Indonesia Tengah, which is Central Indonesian Time. It operates at a UTC+8 offset, covering regions like Bali, Sulawesi, Lesser Sunda Islands, and Nusantara (East Kalimantan)."
        }
      },
      {
        "@type": "Question",
        "name": "What does WITA stand for?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "WITA stands for Waktu Indonesia Tengah, the Indonesian name for Central Indonesian Time, used across the central archipelago."
        }
      },
      {
        "@type": "Question",
        "name": "How many hours ahead is WITA?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "WITA is 13 hours ahead of Eastern Standard Time (EST) in winter, and 12 hours ahead of Eastern Daylight Time (EDT) in summer. Indonesia does not change its clocks, so the gap depends entirely on US daylight saving transitions."
        }
      },
      {
        "@type": "Question",
        "name": "What is the difference between WITA and EST?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The timezone difference is exactly 13 hours during standard winter time (EST, UTC-5) and reduces to 12 hours during summer daylight saving time (EDT, UTC-4)."
        }
      },
      {
        "@type": "Question",
        "name": "Does WITA observe daylight saving time?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No. Indonesia does not observe Daylight Saving Time (DST). WITA remains permanently fixed at UTC+8 year-round."
        }
      },
      {
        "@type": "Question",
        "name": "Does EST change during daylight saving?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, the US Eastern Time Zone transitions to Eastern Daylight Time (EDT, UTC-4) on the second Sunday of March, and returns to Eastern Standard Time (EST, UTC-5) on the first Sunday of November."
        }
      },
      {
        "@type": "Question",
        "name": "Which Indonesian cities use WITA?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Major cities in the WITA timezone include Makassar (Sulawesi), Denpasar (Bali), Mataram (Lombok), Palu, Kendari, Kupang, and Nusantara (the new capital region in East Kalimantan)."
        }
      },
      {
        "@type": "Question",
        "name": "Is Bali in WITA?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, Bali is located within the Central Indonesian Time (WITA) zone and operates on a permanent UTC+8 offset."
        }
      },
      {
        "@type": "Question",
        "name": "Is WITA the same as AWST?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, in terms of offset, WITA and AWST (Australian Western Standard Time) both operate at UTC+8. However, they are legally distinct and serve different geographic regions."
        }
      },
      {
        "@type": "Question",
        "name": "Can I convert future dates?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Our timezone converter is date-aware, meaning it checks whether Daylight Saving Time is active on the selected US date to apply the correct 12-hour (summer) or 13-hour (winter) gap automatically."
        }
      },
      {
        "@type": "Question",
        "name": "Can I use this converter for meetings?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, it is designed to help corporate coordinators, remote workers, and agencies align business hours between Indonesia and the US East Coast."
        }
      },
      {
        "@type": "Question",
        "name": "Is this converter accurate?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Our converter uses the official IANA Time Zone Database (specifically the America/New_York and Asia/Makassar files) to ensure correct offsets."
        }
      },
      {
        "@type": "Question",
        "name": "How often is time zone data updated?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Our database updates automatically when changes are published by the Internet Assigned Numbers Authority (IANA)."
        }
      },
      {
        "@type": "Question",
        "name": "Can I use this converter for flights?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, travelers can convert departure and arrival times to manage trans-Pacific transit between Indonesian hubs like Ngurah Rai Airport (DPS) and New York (JFK)."
        }
      },
      {
        "@type": "Question",
        "name": "Can I bookmark this page?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, you can bookmark this page (/wita-to-est/) for quick access to live clocks, comparative charts, meeting planners, and seasonal offset rules."
        }
      },
      {
        "@type": "Question",
        "name": "Is this converter free?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, our converter is completely free to use with no registrations, limits, or subscriptions required."
        }
      },
      {
        "@type": "Question",
        "name": "What is the difference between WITA, WIB, and WIT?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Indonesia has three timezones: WIB (Western Indonesian Time, UTC+7), WITA (Central Indonesian Time, UTC+8), and WIT (Eastern Indonesian Time, UTC+9). WITA is 1 hour ahead of WIB and 1 hour behind WIT."
        }
      },
      {
        "@type": "Question",
        "name": "Is Nusantara in the WITA timezone?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, Nusantara, the new capital city of Indonesia located in East Kalimantan, operates within the Central Indonesian Time (WITA, UTC+8) zone."
        }
      },
      {
        "@type": "Question",
        "name": "Does Jakarta use WITA?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No, Jakarta is located in Java and uses WIB (Western Indonesian Time, UTC+7). It is 1 hour behind Bali (WITA) and 12/13 hours ahead of New York."
        }
      },
      {
        "@type": "Question",
        "name": "Why doesn't Indonesia observe daylight saving time?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Indonesia is located near the equator, where day length remains relatively constant throughout the year. This makes Daylight Saving Time unnecessary."
        }
      },
      {
        "@type": "Question",
        "name": "What is the best meeting time between Bali and New York?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Due to the 12/13 hour gap, the best window is 8:00 AM to 9:00 AM New York time, which corresponds to 8:00 PM to 9:00 PM WITA in Bali."
        }
      },
      {
        "@type": "Question",
        "name": "How do BPO companies in Bali manage WITA to EST schedules?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "BPO companies run night shifts starting at 8:00 PM or 9:00 PM WITA to align with morning operations on the US East Coast."
        }
      },
      {
        "@type": "Question",
        "name": "Does Singapore share the WITA offset?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Singapore operates on Singapore Standard Time (SGT, UTC+8), which matches the WITA offset."
        }
      },
      {
        "@type": "Question",
        "name": "Can I schedule webinars between Indonesia and the USA using this tool?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, this converter is designed to help coordinators select times that avoid conflicts for participants in both countries."
        }
      },
      {
        "@type": "Question",
        "name": "Is there a day change when converting WITA to EST?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Because WITA is 12 to 13 hours ahead of EST, early morning hours in Indonesia correspond to the previous afternoon/evening in the US."
        }
      },
      {
        "@type": "Question",
        "name": "How does this converter handle EDT?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The tool automatically detects the selected date and applies a 12-hour offset during US Daylight Saving Time (EDT) and a 13-hour offset during standard winter time (EST)."
        }
      },
      {
        "@type": "Question",
        "name": "Who is the editorial reviewer for this site's content?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "All timezone content and calculators are reviewed by Jackie Bruce, our content specialist, ensuring technical accuracy."
        }
      },
      {
        "@type": "Question",
        "name": "What is the database source for this converter?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "This tool uses the official IANA Time Zone Database, maintaining synchronization with global time standards."
        }
      },
      {
        "@type": "Question",
        "name": "Does the US Eastern time zone include Florida?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, Florida is located within the Eastern Time Zone (observing EST and EDT) and coordinates on the same clocks as New York."
        }
      },
      {
        "@type": "Question",
        "name": "Is there a mobile version of this converter?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, our responsive web application is optimized for mobile displays, adjusting layout elements for easy use on smartphones."
        }
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://gmttoestconverter.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "WITA to EST Converter",
        "item": canonical
      }
    ]
  }
];
---

<BaseLayout
  lang={lang}
  dir={dir}
  title={seoTitle}
  description={pageDescription}
  slug={slug}
  meta={meta}
  mode="gmt-est"
  enableFaqSchema={true}
  allowAds={true}
  breadcrumbHomeLabel="Home"
  breadcrumbLabel="WITA to EST"
  hreflangCodes={["en"]}
>

<!-- Inject additional JSON-LD Schemas -->
<script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

<!-- ═══════════════════════════════════════════════════════════════════════════
     H1: WITA TO EST CONVERTER
     ═══════════════════════════════════════════════════════════════════════ -->
<section class="hero-banner">
  <h1 class="hero-banner-title">
    WITA to EST Converter
  </h1>
</section>

<!-- PRIMARY CONVERTER & LIVE CLOCKS (Above the Fold) -->
<div style="max-width: 900px; margin: 0 auto; padding: 0 16px 24px;">
  <Converter intent="converter" t={t} context={context} />
  
  <!-- LIVE CLOCKS -->
  <section class="clock-grid" aria-label="Live Clocks" style="margin-top: 24px;">
    <h2>Live Clocks</h2>
    <div class="clock-card">
      <span class="eyebrow">Source Time Zone</span>
      <strong id="gmtClock">--:--:--</strong>
    </div>
    <div class="clock-card">
      <span class="eyebrow">Target Time Zone</span>
      <strong id="estClock">--:--:--</strong>
      <p style="margin-top: 4px; font-size: 0.85rem; color: var(--muted);">Active Zone: <em id="estZone">ET</em></p>
    </div>
  </section>
</div>


</div>
</div>


<!-- LIVE CONVERTER COMPONENT -->
<section class="converter-wrapper reveal" id="calculator-section">
  <div class="converter-box">
    <Converter
      lang={lang}
      dir={dir}
      slug={slug}
      t={t}
      context={context}
    />
  </div>
</section>

<!-- FEATURE STRIP -->
<section class="feature-strip" aria-label="Key Specifications">
  <div class="feature-item">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feature-icon" aria-hidden="true">
      <circle cx="12" cy="12" r="10"></circle>
      <polyline points="12 6 12 12 16 14"></polyline>
    </svg>
    <span>Real-Time Clock Sync</span>
  </div>
  <div class="feature-item">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feature-icon" aria-hidden="true">
      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
      <line x1="16" y1="2" x2="16" y2="6"></line>
      <line x1="8" y1="2" x2="8" y2="6"></line>
      <line x1="3" y1="10" x2="21" y2="10"></line>
    </svg>
    <span>DST Transition Detection</span>
  </div>
  <div class="feature-item">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feature-icon" aria-hidden="true">
      <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"></polygon>
      <line x1="9" y1="3" x2="9" y2="18"></line>
      <line x1="15" y1="6" x2="15" y2="21"></line>
    </svg>
    <span>IANA Database Standards</span>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════════════════════
     1. CONVERT CENTRAL INDONESIAN TIME TO EASTERN TIME
     ═══════════════════════════════════════════════════════════════════════ -->
<section class="method-section reveal" id="convert-instantly">
  <div class="method-intro">
    <div class="eyebrow">Instant Calculation</div>
    <h2>Convert Central Indonesian Time to Eastern Time</h2>
    <p>
      Our synchronization engine converts Central Indonesian Time (WITA) to Eastern Standard Time (EST) and Eastern Daylight Time (EDT) in the browser. Select your preferred date, enter the source time, and retrieve the translated value instantly.
    </p>
    <p>
      This calculator supports scheduling, travel, and logistics operations. By referencing official databases, it ensures conversions are accurate.
    </p>
  </div>
  
  <!-- SVG 1: HERO WORLD CLOCK ILLUSTRATION -->
  <div class="hero-visual" style="max-width: 800px; margin: 24px auto 0;">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 240" width="100%" height="auto" style="background: linear-gradient(135deg, #071b26 0%, #0f3446 100%); border-radius: 8px;">
      <text x="400" y="40" font-family="'Space Grotesk', sans-serif" font-size="20" font-weight="bold" fill="#36c7b5" text-anchor="middle">WITA TO EST SYNCHRONIZED WORLD CLOCK</text>
      
      <!-- WITA Clock Dial -->
      <g transform="translate(220, 130)">
        <circle cx="0" cy="0" r="50" fill="#0c354a" stroke="#2f6278" stroke-width="3" />
        <line x1="0" y1="0" x2="0" y2="-35" stroke="#f4fbff" stroke-width="3" stroke-linecap="round" />
        <line x1="0" y1="0" x2="25" y2="0" stroke="#36c7b5" stroke-width="2" stroke-linecap="round" />
        <text x="0" y="70" font-family="'Space Grotesk', sans-serif" font-size="14" font-weight="bold" fill="#f4fbff" text-anchor="middle">WITA (UTC+8)</text>
      </g>
      
      <!-- Sync Arrow -->
      <path d="M 370 130 L 430 130" stroke="#36c7b5" stroke-width="3" fill="none" marker-end="url(#arrow)" />
      <text x="400" y="115" font-family="'Manrope', sans-serif" font-size="12" fill="#8fd7ff" text-anchor="middle">12-13h Shift</text>
      
      <!-- EST Clock Dial -->
      <g transform="translate(580, 130)">
        <circle cx="0" cy="0" r="50" fill="#0c354a" stroke="#2f6278" stroke-width="3" />
        <line x1="0" y1="0" x2="-20" y2="-20" stroke="#f4fbff" stroke-width="3" stroke-linecap="round" />
        <line x1="0" y1="0" x2="15" y2="25" stroke="#8fd7ff" stroke-width="2" stroke-linecap="round" />
        <text x="0" y="70" font-family="'Space Grotesk', sans-serif" font-size="14" font-weight="bold" fill="#36c7b5" text-anchor="middle">EST (UTC-5)</text>
      </g>
      
      <defs>
        <marker id="arrow" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 0 L 10 5 L 0 10 z" fill="#36c7b5" />
        </marker>
      </defs>
    </svg>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════════════════════
     2. CURRENT WITA AND EST TIME
     ═══════════════════════════════════════════════════════════════════════ -->


<!-- ═══════════════════════════════════════════════════════════════════════════
     3. WHAT IS WITA?
     ═══════════════════════════════════════════════════════════════════════ -->
<section class="method-section reveal" id="what-is-wita">
  <div class="method-intro">
    <div class="eyebrow">TimeZone Definition</div>
    <h2>What is WITA?</h2>
    <p>
      WITA stands for Waktu Indonesia Tengah, which is Central Indonesian Time. It operates at a UTC+8 offset, covering regions like Bali, Sulawesi, Lesser Sunda Islands, and Nusantara (East Kalimantan).
    </p>
    <p>
      Indonesia does not observe Daylight Saving Time, so WITA remains permanently fixed at UTC+8 year-round.
    </p>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════════════════════
     4. WHERE IS WITA USED?
     ═══════════════════════════════════════════════════════════════════════ -->
<section class="method-section reveal" id="where-used">
  <div class="method-intro">
    <div class="eyebrow">TimeZone Geography</div>
    <h2>Where is WITA Used?</h2>
    <p>
      WITA is used across the central provinces of Indonesia, including Bali, East Kalimantan, South Kalimantan, North Kalimantan, Sulawesi, West Nusa Tenggara, East Nusa Tenggara, and the new capital city Nusantara.
    </p>
    <p>
      This timezone acts as a bridge between the western region (WIB, UTC+7) and the eastern region (WIT, UTC+9).
    </p>
  </div>
  
  <!-- SVG 2: INDONESIA MAP HIGHLIGHTING WITA REGIONS -->
  <div class="hero-visual" style="max-width: 800px; margin: 24px auto 0;">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 240" width="100%" height="auto" style="background: #0f172a; border-radius: 8px;">
      <text x="400" y="35" font-family="'Space Grotesk', sans-serif" font-size="16" font-weight="bold" fill="#f4fbff" text-anchor="middle">INDONESIA TIME ZONE BOUNDARIES</text>
      
      <!-- WIB Area -->
      <rect x="80" y="70" width="180" height="130" fill="#0c354a" stroke="#2f6278" stroke-width="2" rx="4" />
      <text x="170" y="130" font-family="'Space Grotesk', sans-serif" font-size="13" font-weight="bold" fill="#bdd2dc" text-anchor="middle">WIB (UTC+7)</text>
      <text x="170" y="150" font-family="'Manrope', sans-serif" font-size="10" fill="#bdd2dc" text-anchor="middle">Jakarta / Java</text>

      <!-- WITA Area -->
      <rect x="300" y="70" width="200" height="130" fill="#12455d" stroke="#36c7b5" stroke-width="2.5" rx="4" />
      <text x="400" y="130" font-family="'Space Grotesk', sans-serif" font-size="14" font-weight="bold" fill="#36c7b5" text-anchor="middle">WITA (UTC+8)</text>
      <text x="400" y="150" font-family="'Manrope', sans-serif" font-size="11" fill="#f4fbff" text-anchor="middle">Bali / Makassar / Nusantara</text>
      
      <!-- WIT Area -->
      <rect x="540" y="70" width="180" height="130" fill="#0c354a" stroke="#2f6278" stroke-width="2" rx="4" />
      <text x="630" y="130" font-family="'Space Grotesk', sans-serif" font-size="13" font-weight="bold" fill="#bdd2dc" text-anchor="middle">WIT (UTC+9)</text>
      <text x="630" y="150" font-family="'Manrope', sans-serif" font-size="10" fill="#bdd2dc" text-anchor="middle">Maluku / Papua</text>
    </svg>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════════════════════
     5. WITA VS EST
     ═══════════════════════════════════════════════════════════════════════ -->
<section class="method-section reveal" id="wita-vs-est">
  <div class="method-intro">
    <div class="eyebrow">Standard Clarifications</div>
    <h2>WITA vs EST</h2>
    <p>
      WITA is Central Indonesian Time (UTC+8), permanently fixed year-round. EST is US Eastern Standard Time (UTC-5), active during the winter months.
    </p>
    <p>
      Because WITA is UTC+8 and EST is UTC-5, the difference is exactly 13 hours. When the US transitions to Eastern Daylight Time (EDT, UTC-4) in the summer, the gap reduces to 12 hours.
    </p>
  </div>
  
  <!-- SVG 3: WITA → EST TIMELINE -->
  <div class="hero-visual" style="max-width: 800px; margin: 24px auto 0;">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 180" width="100%" height="auto" style="background: #0f172a; border-radius: 8px;">
      <text x="400" y="35" font-family="'Space Grotesk', sans-serif" font-size="16" font-weight="bold" fill="#f4fbff" text-anchor="middle">WITA VS EST SEASONAL TIMELINE OFFSET</text>
      <line x1="80" y1="100" x2="720" y2="100" stroke="#2f6278" stroke-width="4" />
      
      <!-- EST Node -->
      <circle cx="200" cy="100" r="10" fill="#36c7b5" />
      <text x="200" y="75" font-family="'Space Grotesk', sans-serif" font-size="13" font-weight="bold" fill="#f4fbff" text-anchor="middle">EST (UTC-5)</text>
      <text x="200" y="130" font-family="'Manrope', sans-serif" font-size="11" fill="#bdd2dc" text-anchor="middle">New York (Winter)</text>

      <!-- WITA Node -->
