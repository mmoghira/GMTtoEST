---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import { getPageMeta, siteUrl } from "theme/i18n/config";

const metaBase = getPageMeta("en", "disclaimer");
const meta = {
  ...metaBase,
  seoTitle: "Disclaimer & Accuracy Notice",
  description: "Read the GMT to EST Converter disclaimer covering time-zone accuracy, professional advice limits, advertising, external links, and user responsibility.",
  keywords: "GMT to EST disclaimer, time zone accuracy, conversion tool limitations, user responsibility, advertising disclaimer"
};

const pageUrl = `${siteUrl}/disclaimer/`;
const lastUpdated = "June 29, 2026";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${pageUrl}#webpage`,
    url: pageUrl,
    name: "Disclaimer — GMT to EST Converter",
    description: meta.description,
    inLanguage: "en",
    dateModified: "2026-06-29",
    isPartOf: {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      url: siteUrl,
      name: "GMT to EST Converter"
    },
    author: {
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      name: "GMT to EST Converter"
    }
  }
];

const toc = [
  ["nature", "Nature of Our Content"],
  ["accuracy", "Accuracy of Time Zone Information"],
  ["professional-advice", "Not Professional Advice"],
  ["responsible-use", "Responsible Use"],
  ["advertising", "Advertising Transparency"],
  ["external-links", "External Links"],
  ["third-party-services", "Third-Party Services"],
  ["availability", "Website Availability"],
  ["liability", "Limitation of Liability"],
  ["intellectual-property", "Intellectual Property Rights"],
  ["user-responsibility", "User Responsibility"],
  ["changes", "Changes to This Disclaimer"],
  ["contact-disclaimer", "Contact Us"],
  ["related-policies", "Related Policies"],
  ["commitment", "Our Commitment to You"]
];
---

<BaseLayout lang="en" dir="ltr" title={meta.title} description={meta.description} slug="disclaimer" meta={meta}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} slot="head" />

  <article class="disclaimer-page">
    <header class="disclaimer-header">
      <span class="disclaimer-eyebrow">Important Information</span>
      <h1>Disclaimer — GMT to EST Converter</h1>
      <p class="disclaimer-meta">Last updated: <time datetime="2026-06-29">{lastUpdated}</time></p>
      <div class="disclaimer-intro">
        <h2>Let’s Be Upfront With You</h2>
        <p>At GMT to EST Converter, honesty is not just a policy—it is the foundation of everything we publish.</p>
        <p>We built this platform because accurate, free, easy-to-use time zone tools should be available to everyone. Part of being helpful is being transparent about what our tools are designed to do and where their limitations lie.</p>
        <p>This Disclaimer sets clear expectations. It explains the nature of our information, the boundaries of our responsibility, and when you should verify critical information through authoritative sources.</p>
        <p>By accessing or using GMT to EST Converter—including a conversion tool, article, guide, or reference table—you acknowledge the terms and limitations described below.</p>
      </div>
    </header>

    <nav class="disclaimer-toc" aria-labelledby="disclaimer-contents">
      <h2 id="disclaimer-contents">Disclaimer Contents</h2>
      <ol>
        {toc.map(([id, label], index) => <li><a href={`#${id}`}>{index + 1}. {label}</a></li>)}
      </ol>
    </nav>

    <div class="disclaimer-body">
      <section class="disclaimer-section" id="nature" aria-labelledby="nature-heading">
        <h2 id="nature-heading">1. Nature of Our Content — General Information Only</h2>
        <p>Everything published on GMT to EST Converter is provided for <strong>general informational and educational purposes only</strong>.</p>
        <p>Our platform offers:</p>
        <ul>
          <li>The main <a href="/">GMT to EST time converter</a></li>
          <li><a href="/cst-to-est/">CST</a>, <a href="/cdt-to-est/">CDT</a>, <a href="/pdt-to-est/">PDT</a>, <a href="/mst-to-est/">MST</a>, <a href="/ast-to-est/">AST</a>, and <a href="/kst-to-est/">KST to EST converters</a></li>
          <li>Time-difference resources and meeting-planning guidance</li>
          <li>Daylight Saving Time schedules and explanations</li>
          <li>World time-zone references</li>
          <li>Educational articles and our <a href="/time-zone-guide/">Time Zone Guide</a></li>
        </ul>
        <p>These resources help remote workers, students, international teams, travelers, developers, educators, and other visitors answer everyday scheduling questions.</p>
        <p>They are not designed and should not be used as the sole basis for decisions where a timing error could result in legal consequences, financial loss, physical harm, or another serious outcome.</p>
      </section>

      <section class="disclaimer-section" id="accuracy" aria-labelledby="accuracy-heading">
        <h2 id="accuracy-heading">2. Accuracy of Time Zone Information — What You Should Know</h2>
        <p>We take accuracy seriously. We review conversion tools and content to reflect recognized time-zone rules, Daylight Saving Time schedules, and government or legislative changes that affect how time is observed.</p>
        <p>Time zones are not static. Governments may change them, countries may adopt or abandon Daylight Saving Time, and regional authorities may move areas between time zones. Changes can be announced with limited notice.</p>
        <p>Although we work to stay current, there may be a delay between an official change and its appearance in our tools or articles. We cannot guarantee that every result will be accurate at every moment.</p>
        <div class="disclaimer-callout">
          <strong>When accuracy is critical, independently verify through an authoritative source.</strong>
          <ul>
            <li>Official government or regulatory websites</li>
            <li>Airline, railway, or transportation schedules</li>
            <li>Your employer, institution, or event organizer</li>
            <li>The official <a href="https://www.iana.org/time-zones" target="_blank" rel="noopener noreferrer">IANA Time Zone Database</a></li>
            <li>Legal counsel or a contract administrator for deadline-sensitive matters</li>
          </ul>
        </div>
        <p>We are a helpful first step, not the final authority. If a result appears wrong, please <a href="/contact-us/">report the time-zone inaccuracy</a>.</p>
      </section>

      <section class="disclaimer-section" id="professional-advice" aria-labelledby="advice-heading">
        <h2 id="advice-heading">3. Not Professional Advice — In Any Form</h2>
        <p>Nothing published on GMT to EST Converter constitutes professional advice. Website content is not a substitute for:</p>
        <ul>
          <li><strong>Legal advice</strong> about contracts, statutes, court filings, or binding deadlines</li>
          <li><strong>Financial advice</strong> about trading windows, transactions, markets, or investments</li>
          <li><strong>Medical advice</strong> about appointments, medication timing, or healthcare coordination</li>
          <li><strong>Tax advice</strong> about filings, payments, or regulatory submissions</li>
          <li><strong>Business consulting</strong> about professional shift, payroll, or operational planning</li>
          <li><strong>Government guidance</strong> about visas, immigration, compliance, or official appointments</li>
          <li><strong>Institutional educational scheduling</strong> about examinations, enrollment, or academic deadlines</li>
        </ul>
        <p>Where precision is legally, financially, medically, or professionally significant, consult a qualified professional and verify timing through the responsible official channel.</p>
        <p>Our tools are designed to help; they do not replace expert judgment.</p>
      </section>

      <section class="disclaimer-section" id="responsible-use" aria-labelledby="responsible-heading">
        <h2 id="responsible-heading">4. Responsible Use of Our Time Zone Tools</h2>
        <p>Everyday scheduling—such as planning a video call, team meeting, class, or live stream—is the kind of use our platform is built for.</p>
        <p>By using our tools, you accept responsibility for verifying results before acting where an error could cause meaningful harm or loss. This is especially important for:</p>
        <ul>
          <li><strong>International travel</strong>, where an error could cause a missed departure</li>
          <li><strong>Legal or contractual deadlines</strong> with binding consequences</li>
          <li><strong>Medical appointments and procedures</strong></li>
          <li><strong>Online examinations and academic submissions</strong></li>
          <li><strong>Financial transactions and trading windows</strong></li>
          <li><strong>Large-scale business operations</strong>, including payroll and shift handoffs</li>
          <li><strong>Live events and broadcasts</strong> requiring precise technical coordination</li>
        </ul>
        <p>We do our best, but responsibility for verifying time-critical information rests with the user.</p>
      </section>

      <section class="disclaimer-section" id="advertising" aria-labelledby="advertising-heading">
        <h2 id="advertising-heading">5. Advertising on This Website — Full Transparency</h2>
        <p>GMT to EST Converter is free. To help cover the costs of building, maintaining, and improving our tools and content, we display advertisements through <strong>Google AdSense</strong> and may use other advertising partners.</p>
        <h3>What Ads May Appear</h3>
        <p>Text, display, and other standard formats may appear alongside conversion tools or article content.</p>
        <h3>How Ads May Be Targeted</h3>
        <p>Advertising providers may use cookies and similar technologies. Depending on location, consent, and applicable privacy law, you may see personalized or non-personalized ads.</p>
        <h3>What We Do Not Control or Endorse</h3>
        <p>We do not select or directly control every advertisement. Google’s systems determine ad content under its policies. An ad’s appearance does not represent our endorsement or verification of the advertised product, service, company, or claim. Research an offer independently before purchasing.</p>
        <h3>Our Advertising Standards</h3>
        <p>We follow applicable <a href="https://support.google.com/adsense/answer/48182?hl=en" target="_blank" rel="noopener noreferrer">Google AdSense Program policies</a> and may report or block ads that violate available publisher controls. If an ad appears problematic, <a href="/contact-us/">send us an advertising concern</a>.</p>
        <h3>Managing Your Ad Experience</h3>
        <ul>
          <li>Use <a href="https://adssettings.google.com/" target="_blank" rel="noopener noreferrer">Google Ads Settings</a> to manage personalized advertising.</li>
          <li>Use the <a href="https://optout.networkadvertising.org/" target="_blank" rel="noopener noreferrer">NAI Consumer Opt-Out</a> for participating advertising companies.</li>
          <li>Adjust browser settings to limit or block advertising cookies.</li>
        </ul>
        <p>Our <a href="/privacy-policy/">Privacy Policy</a> explains how advertising and analytics data are handled.</p>
      </section>

      <section class="disclaimer-section" id="external-links" aria-labelledby="links-heading">
        <h2 id="links-heading">6. External Links — We Do Not Control What Is Out There</h2>
        <p>GMT to EST Converter may link to external websites, databases, government portals, service providers, and third-party resources. These links are provided in good faith for convenience and information.</p>
        <ul>
          <li>A link does not mean we endorse, recommend, verify, or accept responsibility for the external site.</li>
          <li>We cannot guarantee that linked pages will remain available, accurate, secure, or unchanged.</li>
          <li>External pages may be modified, moved, or removed after we link to them.</li>
        </ul>
        <p>Visiting an external site is at your discretion and subject to its terms, privacy policy, and standards. Review those documents before sharing personal information.</p>
        <p>If you find a broken or problematic link, please <a href="/contact-us/">report the external link</a>.</p>
      </section>

      <section class="disclaimer-section" id="third-party-services" aria-labelledby="services-heading">
        <h2 id="services-heading">7. Third-Party Services</h2>
        <p>To provide a fast, secure, and functional website, we may use:</p>
        <ul>
          <li><strong>Hosting providers</strong> for infrastructure and website delivery</li>
          <li><strong>Content delivery networks</strong> for fast loading in different regions</li>
          <li><strong>Security services</strong> for malicious traffic and attack protection</li>
          <li><strong>Google Analytics</strong> for aggregate usage measurement</li>
          <li><strong>Google AdSense</strong> for advertising</li>
          <li><strong>FormSubmit</strong> for contact-form message delivery</li>
        </ul>
        <p>Each provider operates under its own terms and privacy policies. We are not responsible for third-party practices, content, availability, or data handling. Review relevant provider policies before interacting with a service.</p>
      </section>

      <section class="disclaimer-section" id="availability" aria-labelledby="availability-heading">
        <h2 id="availability-heading">8. Website Availability — We Aim for Uptime, but Cannot Promise It</h2>
        <p>We work to keep GMT to EST Converter online, fast, and operational. No website can guarantee uninterrupted availability. Disruptions may result from:</p>
        <ul>
          <li>Scheduled maintenance or upgrades</li>
          <li>Security patches</li>
          <li>Unexpected hosting or server failures</li>
          <li>Network problems outside our control</li>
          <li>Third-party service outages</li>
          <li>Cyberattacks, natural events, or other circumstances beyond reasonable control</li>
        </ul>
        <p>We are not liable for inconvenience, scheduling errors, or losses resulting from an inability to access the site. Keep an authoritative backup resource available for critical situations. We will work to restore service as soon as reasonably possible.</p>
      </section>

      <section class="disclaimer-section" id="liability" aria-labelledby="liability-heading">
        <h2 id="liability-heading">9. Limitation of Liability</h2>
        <p>To the fullest extent permitted by applicable law, GMT to EST Converter—including its operators, contributors, team members, and affiliates—shall not be liable for damages arising from use of or inability to use this website.</p>
        <p>This includes:</p>
        <ul>
          <li><strong>Direct damages</strong>, such as missed appointments or scheduling conflicts</li>
          <li><strong>Indirect damages</strong>, such as business losses, reputational harm, or operational disruption</li>
          <li><strong>Consequential damages</strong>, including lost revenue or contracts</li>
          <li><strong>Incidental damages</strong>, such as recovery costs after an interruption</li>
          <li><strong>Loss of data</strong> caused by technical failures or security incidents</li>
          <li><strong>Third-party claims</strong> connected with ads, links, or service providers</li>
        </ul>
        <p>This limitation applies regardless of foreseeability or whether a claim is brought under contract, tort, negligence, strict liability, or another theory.</p>
        <p><strong>By using this website, you accept responsibility for how you apply its information and results.</strong></p>
      </section>

      <section class="disclaimer-section" id="intellectual-property" aria-labelledby="ip-heading">
        <h2 id="ip-heading">10. Intellectual Property Rights</h2>
        <p>Original articles, guides, educational materials, tool interfaces, page layouts, design elements, logos, and branding created by GMT to EST Converter are protected under applicable intellectual-property laws.</p>
        <p>You may:</p>
        <ul>
          <li>Use our tools and content for personal, educational, or business reference.</li>
          <li>Share links through social media, email, or other platforms.</li>
          <li>Quote brief passages with clear attribution to GMT to EST Converter.</li>
          <li>Reference our work in original content with appropriate credit.</li>
        </ul>
        <p>You may not:</p>
        <ul>
          <li>Copy or republish substantial portions without written permission.</li>
          <li>Present our articles, tools, or resources as your own.</li>
          <li>Reproduce tools or resources commercially without a license.</li>
          <li>Remove or obscure copyright, attribution, or branding.</li>
        </ul>
        <p>For commercial products, curricula, or large-scale redistribution, <a href="/contact-us/">request permission to use our content</a>.</p>
      </section>

      <section class="disclaimer-section" id="user-responsibility" aria-labelledby="responsibility-heading">
        <h2 id="responsibility-heading">11. User Responsibility</h2>
        <p><strong>When you use our tools or content to make a decision, responsibility for that decision rests with you.</strong></p>
        <p>For most everyday uses—scheduling a call, planning travel, or coordinating a remote team—our tools are designed to work as intended. But no automated tool can replace human judgment and independent verification in a high-stakes situation.</p>
        <p>Before relying on a conversion for a legal filing, surgical appointment, flight departure, financial transaction, or another critical event, confirm it through the responsible official source.</p>
        <p>We want you to succeed in whatever you are scheduling. That means being honest about where our responsibility ends and yours begins.</p>
      </section>

      <section class="disclaimer-section" id="changes" aria-labelledby="changes-heading">
        <h2 id="changes-heading">12. Changes to This Disclaimer</h2>
        <p>We may update this Disclaimer to reflect website changes, applicable legal developments, new tools or services, visitor feedback, or legal review.</p>
        <p>When revisions are made, the “Last updated” date at the top will be changed. Review this page periodically. Continued use after an update is posted constitutes acceptance of the revised Disclaimer to the extent permitted by law.</p>
      </section>

      <section class="disclaimer-section disclaimer-contact" id="contact-disclaimer" aria-labelledby="contact-heading">
        <h2 id="contact-heading">13. Contact Us</h2>
        <p>If you have a question about this Disclaimer, want to report inaccurate content, have a concern about an advertisement, or need content-use permission, please use our <a href="/contact-us/">Contact Us page</a> or email <a href="mailto:gmttoest@gmail.com">gmttoest@gmail.com</a>.</p>
        <p>Your feedback helps us improve, and we take genuine reports seriously.</p>
      </section>

      <section class="disclaimer-section" id="related-policies" aria-labelledby="policies-heading">
        <h2 id="policies-heading">14. Related Policies</h2>
        <p>This Disclaimer works with our other governing documents:</p>
        <nav aria-label="Related website policies">
          <ul class="related-links">
            <li><a href="/privacy-policy/">Privacy Policy</a><span>How we collect, use, and protect information.</span></li>
            <li><a href="/terms-of-service/">Terms of Service</a><span>The conditions governing website use.</span></li>
            <li><a href="/about-us/">About Us</a><span>Who we are and why we built this platform.</span></li>
            <li><a href="/contact-us/">Contact Us</a><span>How to send questions, corrections, or feedback.</span></li>
          </ul>
        </nav>
      </section>

      <footer class="disclaimer-commitment" id="commitment">
        <h2>Our Commitment to You</h2>
        <p>We built GMT to EST Converter because simple, accurate, free time zone tools should exist—and the people behind them should be honest about what those tools can and cannot do.</p>
        <p>This Disclaimer is about respecting you enough to be direct: our tools are useful for everyday scheduling, every digital resource has limits, and important decisions deserve more than one source of information.</p>
        <p>Use our tools with confidence. Verify the critical details. If something looks wrong, tell us and we will investigate.</p>
        <p><strong>The GMT to EST Converter Team</strong></p>
      </footer>
    </div>
  </article>
</BaseLayout>

<style>
  .disclaimer-page {
    max-width: 880px;
    margin: 0 auto;
    padding: 3rem 1.5rem 5rem;
  }
  .disclaimer-header {
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--line);
  }
  .disclaimer-eyebrow {
    display: inline-block;
    margin-bottom: .75rem;
    color: var(--accent);
    font-size: .78rem;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .disclaimer-header h1 {
    margin: 0 0 .75rem;
    color: var(--text);
    font-size: clamp(2rem, 5vw, 3.25rem);
    line-height: 1.08;
  }
  .disclaimer-meta { margin: 0 0 2rem; color: var(--muted); font-size: .875rem; }
  .disclaimer-intro {
    padding: clamp(22px, 4vw, 32px);
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--panel);
  }
  .disclaimer-intro h2 { margin: 0 0 1rem; color: var(--text); font-size: 1.35rem; }
  .disclaimer-intro p, .disclaimer-section p, .disclaimer-commitment p {
    margin: 0 0 1rem;
    color: var(--muted);
    font-size: .975rem;
    line-height: 1.75;
  }
  .disclaimer-intro p:last-child, .disclaimer-section p:last-child, .disclaimer-commitment p:last-child { margin-bottom: 0; }
  .disclaimer-page a { color: var(--accent); text-underline-offset: 3px; }
  .disclaimer-page strong { color: var(--text); }
  .disclaimer-toc {
    margin-bottom: 1rem;
    padding: 26px 30px;
    border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--line));
    border-left: 4px solid var(--accent);
    border-radius: 0 12px 12px 0;
    background: color-mix(in srgb, var(--accent) 8%, var(--panel));
  }
  .disclaimer-toc h2 {
    margin: 0 0 14px;
    color: var(--text);
    font-size: 1rem;
    letter-spacing: .06em;
    text-transform: uppercase;
  }
  .disclaimer-toc ol {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 7px 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .disclaimer-toc a { font-size: .9rem; line-height: 1.45; }
  .disclaimer-section {
    padding: 2.25rem 0;
    border-bottom: 1px solid var(--line);
  }
  .disclaimer-section h2 {
    display: flex;
    gap: .65rem;
    align-items: flex-start;
    margin: 0 0 1rem;
    color: var(--text);
    font-size: clamp(1.2rem, 3vw, 1.5rem);
    line-height: 1.3;
  }
  .disclaimer-section h2::before {
    flex: 0 0 4px;
    width: 4px;
    height: 1.4rem;
    margin-top: .1rem;
    border-radius: 2px;
    background: var(--accent);
    content: "";
  }
  .disclaimer-section h3 { margin: 1.5rem 0 .75rem; color: var(--text); font-size: 1.05rem; }
  .disclaimer-section ul {
    display: grid;
    gap: .55rem;
    margin: .75rem 0 1rem;
    padding-left: 1.4rem;
  }
  .disclaimer-section li { color: var(--muted); font-size: .975rem; line-height: 1.65; }
  .disclaimer-callout {
    margin: 1.25rem 0;
    padding: 1.25rem;
    border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--line));
    border-radius: 10px;
    background: color-mix(in srgb, var(--accent) 7%, var(--panel));
  }
  .related-links {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    padding: 0 !important;
    list-style: none;
  }
  .related-links li {
    display: grid;
    gap: .35rem;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: 9px;
    background: var(--panel);
  }
  .related-links a { font-weight: 750; }
  .related-links span { font-size: .85rem; }
  .disclaimer-contact {
    padding: 2rem;
    border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--line));
    border-radius: 12px;
    background: color-mix(in srgb, var(--accent) 7%, var(--panel));
  }
  .disclaimer-commitment {
    margin-top: 2rem;
    padding: clamp(24px, 5vw, 38px);
    border-radius: 14px;
    background: linear-gradient(135deg, #0f172a, #1e293b);
  }
  .disclaimer-commitment h2 { margin: 0 0 1rem; color: #fff; font-size: 1.4rem; }
  .disclaimer-commitment p { color: #cbd5e1; }
  .disclaimer-commitment strong { color: #fff; }
  .disclaimer-page a:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--accent) 55%, transparent);
    outline-offset: 3px;
  }
  @media (max-width: 640px) {
    .disclaimer-page { padding: 2rem 1rem 3rem; }
    .disclaimer-toc { padding: 22px 20px; }
    .disclaimer-toc ol, .related-links { grid-template-columns: 1fr; }
    .disclaimer-contact { padding: 1.25rem; }
  }
</style>
