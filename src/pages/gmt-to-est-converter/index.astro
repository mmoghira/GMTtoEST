---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import HomePage from "theme/components/HomePage.astro";
import { getLang, getPageMeta, getTranslation } from "theme/i18n/config";

const lang = getLang("en");
const t = getTranslation(lang.code);
const meta = getPageMeta(lang.code, "home");
---

<BaseLayout lang={lang.code} dir={lang.dir} title={meta.title} description={meta.description} meta={meta} enableFaqSchema={true} enableArticleSchema={true}>
  <HomePage title={meta.title} description={meta.description} kind="converter" t={t} primaryKeyword={meta.title} meta={meta} />
</BaseLayout>
