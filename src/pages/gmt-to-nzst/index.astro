<section class="skyline-container content-section" style="text-align: center; margin: 3rem 0;">
  <h3 class="sr-only">Auckland Skyline Graphic</h3>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 220" width="100%" height="auto" style="display: block; max-width: 800px; margin: 0 auto; background: linear-gradient(180deg, #0c354a 0%, #12455d 100%); border-radius: 12px; border: 1px solid var(--line);">
