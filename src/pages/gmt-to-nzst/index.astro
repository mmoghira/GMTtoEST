---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import Converter from "theme/components/Converter.astro";
import { getTranslation, pageUrl, siteUrl } from "theme/i18n/config";

const lang = "en";
const dir = "ltr";
const slug = "gmt-to-nzst";
const t = getTranslation(lang);

const pageTitle = "GMT to NZST Converter";
const seoTitle = "GMT to NZST Converter – Greenwich Mean Time to New Zealand Standard Time";
const pageDescription = "Convert GMT to NZST instantly. See the current time difference between Greenwich Mean Time and New Zealand Standard Time, with Auckland and Wellington clocks.";

const context = {
  from: "GMT",
  to: "NZST",
  fromZone: "UTC",
  toZone: "Pacific/Auckland"
};

const canonical = `${siteUrl}/gmt-to-nzst/`;

// 24-hour conversion table data (GMT → NZST = GMT + 12)
function formatHour12(hour: number) {
  const normalized = ((hour % 24) + 24) % 24;
  const period = normalized < 12 ? "AM" : "PM";
  const displayHour = normalized % 12 || 12;
  return `${displayHour}:00 ${period}`;
}

const conversionRows = Array.from({ length: 24 }, (_, hour) => {
  const nzstHour = hour + 12;
  const nzstNormalized = ((nzstHour % 24) + 24) % 24;
  const nextDay = nzstHour >= 24;
  const period = nzstNormalized < 12 ? "AM" : "PM";
  const displayHour = nzstNormalized % 12 || 12;
  return {
    gmt: formatHour12(hour),
    nzst: `${displayHour}:00 ${period}${nextDay ? " (+1 day)" : ""}`,
    dayNote: nextDay ? "Next day" : "Same day"
  };
});

// Popular conversions
const popularConversions = [
  { gmt: "12:00 AM (Midnight)", nzst: "12:00 PM (Noon) NZST", note: "Midday lunch break across Auckland and Wellington" },
  { gmt: "2:00 AM", nzst: "2:00 PM NZST", note: "Early afternoon in Christchurch, late night in London" },
  { gmt: "4:00 AM", nzst: "4:00 PM NZST", note: "Late afternoon for New Zealand businesses before close" },
  { gmt: "6:00 AM", nzst: "6:00 PM NZST", note: "Evening relaxation in Hamilton, morning starting in Greenwich" },
  { gmt: "8:00 AM", nzst: "8:00 PM NZST", note: "Nighttime hours in New Zealand, London starting the workday" },
  { gmt: "10:00 AM", nzst: "10:00 PM NZST", note: "Bedtime in Auckland, mid-morning in Greenwich" },
  { gmt: "12:00 PM (Noon)", nzst: "12:00 AM NZST (+1)", note: "Midnight in Wellington, noon in Greenwich" },
  { gmt: "2:00 PM", nzst: "2:00 AM NZST (+1)", note: "Middle of the night in New Zealand, afternoon in Greenwich" },
  { gmt: "4:00 PM", nzst: "4:00 AM NZST (+1)", note: "Pre-dawn in Christchurch, UK offices closing" },
  { gmt: "6:00 PM", nzst: "6:00 AM NZST (+1)", note: "Dawn in New Zealand, evening in Greenwich" },
  { gmt: "8:00 PM", nzst: "8:00 AM NZST (+1)", note: "Start of next workday in Hamilton, night in London" },
  { gmt: "10:00 PM", nzst: "10:00 AM NZST (+1)", note: "Mid-morning focus in Auckland, bedtime in Greenwich" }
];

// FAQ data
const faqs = [
  { q: "What is NZST?", a: "NZST stands for New Zealand Standard Time. It is the winter time zone observed in New Zealand, running exactly 12 hours ahead of Coordinated Universal Time (UTC+12) and Greenwich Mean Time (GMT+12)." },
  { q: "How many hours ahead of GMT is NZST?", a: "NZST is exactly 12 hours ahead of Greenwich Mean Time (GMT). For example, when it is 9:00 AM GMT in London, it is 9:00 PM NZST in Auckland and Wellington." },
  { q: "Is Auckland always on NZST?", a: "No. Auckland shifts from NZST (New Zealand Standard Time, UTC+12) to NZDT (New Zealand Daylight Time, UTC+13) during the summer months. The transition occurs from the last Sunday of September to the first Sunday of April." },
  { q: "Does New Zealand observe Daylight Saving Time?", a: "Yes. New Zealand observes daylight saving by switching to NZDT (UTC+13) in summer, shifting clocks forward by 1 hour to extend evening light." },
  { q: "What is the difference between NZST and NZDT?", a: "NZST is New Zealand Standard Time (UTC+12), used in winter. NZDT is New Zealand Daylight Time (UTC+13), used during summer. NZDT runs 1 hour ahead of NZST." },
  { q: "Does Wellington use daylight saving?", a: "Yes. Wellington observes daylight saving, transitioning from NZST (UTC+12) to NZDT (UTC+13) from September to April." },
  { q: "How accurate is this GMT to NZST converter?", a: "Our converter uses the canonical IANA Time Zone Database (specifically the Pacific/Auckland ruleset) loaded via the browser API. This guarantees 100% precision for any selected calendar date." },
  { q: "What is 8 PM GMT in NZST?", a: "8:00 PM GMT converts to 8:00 AM NZST the following day. Since NZST is 12 hours ahead, adding 12 hours wraps the clock precisely to the morning of the next calendar day." },
  { q: "Is GMT the same as UTC?", a: "For daily scheduling, GMT (Greenwich Mean Time) and UTC (Coordinated Universal Time) represent the same offset (+0). UTC is the modern atomic baseline, while GMT is the astronomical solar baseline." },
  { q: "Can I manually convert GMT to NZST?", a: "Yes. Add 12 hours to the GMT clock. For example, 10:00 AM GMT + 12 hours = 10:00 PM NZST. If the target date falls during the southern summer, add 13 hours for NZDT." },
  { q: "Which cities use NZST?", a: "All major cities in New Zealand follow NZST in winter, including Auckland, Wellington, Christchurch, Hamilton, Dunedin, Tauranga, and Palmerston North." },
  { q: "Does Chatham Island follow the same time zone?", a: "No. Chatham Island observes Chatham Island Standard Time (CHAST, UTC+12:45) in winter and Chatham Island Daylight Time (CHADT, UTC+13:45) in summer, running 45 minutes ahead of the rest of New Zealand." },
  { q: "What is the IANA identifier for New Zealand?", a: "The canonical IANA time zone identifier is Pacific/Auckland, which automatically manages the seasonal shifts between NZST and NZDT." },
  { q: "Does Christchurch use NZST?", a: "Yes. Christchurch observes NZST (UTC+12) during winter and shifts to NZDT (UTC+13) in summer, synchronized with the national time standard." },
  { q: "Why is New Zealand's offset +12 hours?", a: "New Zealand's geographical position sits near the International Date Line, placing it among the first countries to experience a new calendar day." },
  { q: "Does Hamilton follow NZST?", a: "Yes. Hamilton, in the North Island, follows the national time zone schedule, using NZST (UTC+12) in winter and NZDT (UTC+13) in summer." },
  { q: "What happens to international flight times during the clock change?", a: "Aviation schedules run on UTC/GMT, but local departure and arrival times in New Zealand shift by 1 hour when clocks change. Check local details carefully when booking travel." },
  { q: "Do computer networks use NZST?", a: "Servers typically run on UTC (GMT) to ensure database logging remains consistent. Local applications then render these timestamps in NZST for New Zealand users." },
  { q: "Does Dunedin use daylight saving?", a: "Yes. Dunedin, in the South Island, observes daylight saving time, shifting from NZST (UTC+12) to NZDT (UTC+13) on the national transition dates." },
  { q: "What is the relative gap between London and Auckland in summer?", a: "During the northern hemisphere summer (UK on BST, UTC+1; NZ on NZST, UTC+12), Auckland is 11 hours ahead of London. In standard winter (UK on GMT, UTC+0; NZ on NZDT, UTC+13), Auckland is 13 hours ahead." },
  { q: "Does Tauranga follow NZST?", a: "Yes. Tauranga observes NZST (UTC+12) during standard winter months and AEDT-equivalent NZDT (UTC+13) in summer." },
  { q: "What is 12 AM GMT in Auckland local time?", a: "12:00 AM (Midnight) GMT is equal to 12:00 PM (Noon) NZST on the same day in Auckland." },
  { q: "When does NZST end each year?", a: "NZST ends on the last Sunday of September at 2:00 AM local time, when clocks move forward to 3:00 AM NZDT." },
  { q: "When does NZST begin each year?", a: "NZST begins on the first Sunday of April at 3:00 AM local time, when clocks fall back to 2:00 AM NZST." },
  { q: "Does the Cook Islands follow NZST?", a: "No. The Cook Islands, though in free association with New Zealand, follow Cook Islands Time (CKT, UTC-10), running 22 hours behind New Zealand Standard Time." }
];

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "GMT to NZST, GMT to New Zealand Standard Time, Greenwich Mean Time to NZST, GMT NZST Converter, Convert GMT to NZST, GMT to New Zealand Time, Current NZST Time, GMT UTC to NZST, GMT to Auckland Time, GMT to Wellington Time, GMT to Christchurch Time, GMT to Hamilton Time, New Zealand Time Converter, Time Difference GMT and NZST",
  image: "/assets/gmt-to-nzst-og.svg",
  imageAlt: "GMT to NZST Converter – Convert Greenwich Mean Time to New Zealand Standard Time",
  faqs,
  appDescription: "Free online GMT to NZST converter with real-time clocks, DST-aware calculation, 24-hour conversion chart, and meeting planner for scheduling between Greenwich Mean Time and New Zealand Standard Time.",
  applicationCategory: "UtilityApplication",
  operatingSystem: "Any",
  howToName: "How to Convert GMT to NZST",
  howToDescription: "Step-by-step guide to converting Greenwich Mean Time to New Zealand Standard Time using our free online tool.",
  howToSteps: [
    { name: "Verify the season in New Zealand", text: "NZST is observed from the first Sunday of April to the last Sunday of September. In the remaining months, New Zealand uses NZDT (UTC+13)." },
    { name: "Input your GMT time", text: "Select your desired GMT time using our interactive date and time picker. The tool defaults to the current time." },
    { name: "Check the offset results", text: "Our calculator checks the date and displays the result in NZST (+12 offset) or NZDT (+13 offset) based on New Zealand's daylight saving calendar." },
    { name: "Copy or swap the result", text: "Read the equivalent Auckland/Wellington time and click the copy button to save the conversion result." }
  ],
};
---

<BaseLayout
  lang={lang}
  dir={dir}
  title={seoTitle}
  description={pageDescription}
  slug={slug}
  meta={meta}
  mode="gmt-est"
  enableFaqSchema={true}
  allowAds={true}
  breadcrumbHomeLabel="Home"
  breadcrumbLabel="GMT to NZST"
  hreflangCodes={["en"]}
>

<!-- ═══════════════════════════════════════════════════════════════════════════
     H1 & INTRODUCTION
     ═══════════════════════════════════════════════════════════════════════ -->
<section class="hero-banner">
  <h1 class="hero-banner-title">
    GMT to NZST <span class="gradient-text">Converter</span>
  </h1>
</section>

<!-- PRIMARY CONVERTER & LIVE CLOCKS (Above the Fold) -->
<div style="max-width: 720px; margin: 0 auto; padding: 0 16px 24px;">
  <Converter intent="dynamic" t={t} context={context} />
  
  <div class="live-clock-strip" style="margin-top: 16px; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px;">
    <div class="clock-card" style="text-align: center; padding: 12px 16px; background: var(--panel); border: 1px solid var(--line); border-radius: 10px;">
      <span class="eyebrow" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); display: block; margin-bottom: 4px;">Live Source Time</span>
      <strong class="top-gmt-clock" style="font-size: 1.25rem; font-family: 'Space Grotesk', sans-serif; color: var(--accent); font-weight: 700;">--:--:--</strong>
    </div>
    <div class="clock-card" style="text-align: center; padding: 12px 16px; background: var(--panel); border: 1px solid var(--line); border-radius: 10px;">
      <span class="eyebrow" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); display: block; margin-bottom: 4px;">Live Target Time</span>
      <strong class="top-est-clock" style="font-size: 1.25rem; font-family: 'Space Grotesk', sans-serif; color: var(--accent); font-weight: 700;">--:--:--</strong>
      <em class="top-est-zone" style="font-size: 0.8rem; color: var(--muted); font-style: normal; margin-left: 4px;">ET</em>
    </div>
  </div>
</div>


<!-- FEATURE ICONS (CUSTOM SVG) -->
<section class="feature-strip" aria-label="Tool Features">
  <div class="feature-item">
    <!-- Icon: Clock -->
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feature-icon" aria-hidden="true">
      <circle cx="12" cy="12" r="10"></circle>
      <polyline points="12 6 12 12 16 14"></polyline>
    </svg>
    <span>Live Clocks</span>
  </div>
  <div class="feature-item">
    <!-- Icon: Calendar -->
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feature-icon" aria-hidden="true">
      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
      <line x1="16" y1="2" x2="16" y2="6"></line>
      <line x1="8" y1="2" x2="8" y2="6"></line>
