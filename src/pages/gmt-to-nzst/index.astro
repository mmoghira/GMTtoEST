        <path d="M50 160 C 150 70, 200 200, 350 100 C 450 40, 500 130, 550 90" fill="none" stroke="#36c7b5" stroke-width="4" stroke-linecap="round" opacity="0.8" />
        <path d="M50 160 C 150 70, 200 200, 350 100 C 450 40, 500 130, 550 90" fill="none" stroke="#8fd7ff" stroke-width="2" stroke-linecap="round" opacity="0.4" stroke-dasharray="10 5" />
        
        <!-- Left Clock: Greenwich -->
        <g transform="translate(130, 110)">
