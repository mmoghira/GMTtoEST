---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import { siteUrl } from "theme/i18n/config";

const title = "Privacy Policy";
const description = "Learn how GMT to EST Converter handles contact data, cookies, analytics, advertising, security, retention, and the privacy rights of visitors worldwide.";
const meta = {
  title,
  seoTitle: "Privacy Policy & Data Protection",
  description,
  keywords: "GMT to EST privacy policy, data protection, cookies, Google Analytics, Google AdSense, privacy rights",
  image: "/images/og/default.png",
  imageAlt: "Privacy Policy for GMT to EST Converter"
};

const lastUpdated = "July 6, 2026";
const pageCanonical = `${siteUrl}/privacy-policy/`;

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${pageCanonical}#webpage`,
    url: pageCanonical,
    name: title,
    description,
    inLanguage: "en",
    dateModified: "2026-07-06",
    isPartOf: {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      url: siteUrl,
      name: "GMT to EST Converter"
    },
    breadcrumb: {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: siteUrl },
        { "@type": "ListItem", position: 2, name: "Privacy Policy", item: pageCanonical }
      ]
    },
    author: {
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      name: "GMT to EST Converter"
    },
    speakable: {
      "@type": "SpeakableSpecification",
      cssSelector: [".pp-intro", ".pp-section h2"]
    }
  }
];

const toc = [
  ["#who-we-are", "Who We Are"],
  ["#information-we-collect", "What Information We Collect"],
  ["#cookies", "Cookies and Similar Technologies"],
  ["#advertising", "Google AdSense and Advertising"],
  ["#analytics", "Google Analytics"],
  ["#how-we-use-information", "How We Use Information"],
  ["#what-we-do-not-do", "What We Do Not Do"],
  ["#data-sharing", "Data Sharing and Third Parties"],
  ["#third-party-services", "Third-Party Services We Use"],
  ["#external-links", "External Links"],
  ["#childrens-privacy", "Children's Privacy"],
  ["#international-visitors", "International Visitors"],
  ["#privacy-rights", "Your Privacy Rights and Choices"],
  ["#data-retention", "Data Retention"],
  ["#data-security", "Data Security"],
  ["#policy-changes", "Changes to This Privacy Policy"],
  ["#privacy-contact", "Contact Us"],
  ["#our-commitment", "Our Commitment to You"]
];
---

<BaseLayout lang="en" dir="ltr" title={title} description={description} slug="privacy-policy" meta={meta}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} slot="head" />

  <header class="pp-hero">
    <span class="pp-badge">Legal &amp; Privacy</span>
    <h1>Privacy Policy <span>— GMT to EST Converter</span></h1>
    <p>Last updated: <time datetime="2026-07-06">{lastUpdated}</time></p>
  </header>

  <div class="pp-wrapper">
    <section class="pp-card pp-intro" aria-labelledby="introduction-heading">
      <h2 id="introduction-heading">Introduction</h2>
      <p>At GMT to EST Converter, we believe you deserve to know exactly how your information is handled — in plain language, without legal jargon or vague promises.</p>
      <p>This Privacy Policy explains what data we collect when you visit our website, why we collect it, how we use it, who we share it with, and what control you have over your own information. It applies to all <a href="/">time conversion tools</a>, pages, and resources available at GMT to EST Converter.</p>
      <p>By using our website, you agree to the practices described in this policy. If you do not agree with any part of this policy, we encourage you to discontinue use of the site and <a href="/contact-us/">contact us with any concerns</a>.</p>
      <p>We review and update this policy regularly. The “Last updated” date at the top of this page always reflects the most current version.</p>
    </section>

    <nav class="pp-toc" aria-labelledby="toc-heading">
      <h2 id="toc-heading">Privacy Policy Contents</h2>
      <ol>
        {toc.map(([href, label]) => <li><a href={href}>{label}</a></li>)}
      </ol>
    </nav>

    <section class="pp-card pp-section" id="who-we-are" aria-labelledby="who-heading">
      <h2 id="who-heading">Who We Are</h2>
      <p>GMT to EST Converter is a free, independently operated online platform dedicated to helping people convert time zones quickly, accurately, and without confusion.</p>
      <p>Our tools serve remote workers, international businesses, students, educators, project managers, travelers, developers, and anyone else who needs to cross a time zone boundary in daily life or work.</p>
      <p>We do not require account registration. We do not sell access to our tools or charge visitors to use the site. Our platform is and will remain freely accessible to everyone.</p>
      <p>Learn more about our work on the <a href="/about-us/">About GMT to EST Converter page</a>. If you have questions about how the site operates, please use our <a href="/contact-us/">Contact Us page</a>.</p>
    </section>

    <section class="pp-card pp-section" id="information-we-collect" aria-labelledby="collection-heading">
      <h2 id="collection-heading">What Information We Collect</h2>
      <p>We collect two types of information: information you voluntarily give us and information that is automatically collected when you browse the web.</p>

      <h3>1. Information You Provide Directly</h3>
      <p>The primary time we collect personally identifiable information is when you choose to contact us through our Contact Us page. You may submit:</p>
      <ul>
        <li>Your name</li>
        <li>Your email address</li>
        <li>A subject or message topic</li>
        <li>Your message</li>
      </ul>
      <p>You are never required to provide this information unless you choose to initiate contact. It is used to review and respond to your inquiry.</p>
      <p>We do not use contact submissions for marketing or add your email address to a mailing list without explicit consent. Our form uses FormSubmit, so submitted information is transmitted through that provider to deliver your message to us.</p>

      <h3>2. Automatically Collected Technical Information</h3>
      <p>Like most websites, our site and service providers may automatically receive and temporarily process technical data when you visit. This may include:</p>
      <ul>
        <li><strong>IP address</strong>, with provider-specific privacy handling and anonymization where required</li>
        <li><strong>Browser type and version</strong></li>
        <li><strong>Device type</strong>, such as desktop, tablet, or mobile</li>
        <li><strong>Operating system</strong></li>
        <li><strong>Referring website</strong>, if any</li>
        <li><strong>Pages visited</strong> and navigation order</li>
        <li><strong>Date and time</strong> of your visit</li>
        <li><strong>Session duration</strong></li>
        <li><strong>Approximate geographic region</strong>, such as country or city level rather than precise location</li>
        <li><strong>Website performance and error data</strong></li>
      </ul>
      <p>We use this information in aggregate to understand site usage, identify technical issues, and improve the visitor experience. We do not use analytics reports to identify visitors by name.</p>
    </section>

    <section class="pp-card pp-section" id="cookies" aria-labelledby="cookies-heading">
      <h2 id="cookies-heading">Cookies and Similar Technologies</h2>
      <p>Cookies are small text files that websites store on your device to remember information between visits or sessions. They are standard web technologies used for functionality, measurement, and advertising.</p>

      <h3>How We Use Cookies</h3>
      <ul>
        <li><strong>Functionality:</strong> To remember preferences and settings that help the site work correctly.</li>
        <li><strong>Performance:</strong> To measure how pages load and identify technical issues.</li>
        <li><strong>Analytics:</strong> To understand aggregate visitor behavior and improve our tools.</li>
        <li><strong>Advertising:</strong> To help advertising partners, including Google, deliver and measure ads.</li>
      </ul>

      <h3>Types of Cookies on This Site</h3>
      <p><strong>Essential cookies</strong> support functions necessary for the website to operate. Disabling them may affect site functionality.</p>
      <p><strong>Analytics cookies</strong> help us understand how visitors interact with the site, including popular pages, approximate visit duration, and referral sources.</p>
      <p><strong>Advertising cookies</strong> may be set by providers such as Google AdSense to deliver, limit, and measure ads. Their behavior depends on your location, consent choices, and provider settings.</p>

      <h3>Managing Your Cookie Preferences</h3>
      <p>You can control, limit, or delete cookies through your browser settings. Most browsers let you view stored cookies, delete existing cookies, block cookies from specific websites, or block third-party cookies. Disabling some cookies may affect website functionality.</p>
      <p>You can manage Google advertising preferences through <a href="https://adssettings.google.com/" target="_blank" rel="noopener noreferrer">Google Ads Settings</a>.</p>
    </section>

    <section class="pp-card pp-section" id="advertising" aria-labelledby="advertising-heading">
      <h2 id="advertising-heading">Google AdSense and Advertising</h2>
      <p>To support the free operation of this website, GMT to EST Converter displays advertisements provided by <strong>Google AdSense</strong> and may work with other trusted advertising partners.</p>
      <p>Google AdSense is an advertising service operated by Google LLC. When you visit pages that display ads, Google may use cookies and similar technologies to:</p>
      <ul>
        <li>Serve ads based on previous browsing activity where personalization is permitted</li>
        <li>Limit how often a particular ad is shown</li>
        <li>Detect fraud and protect advertising systems</li>
        <li>Measure advertising effectiveness</li>
        <li>Deliver ads that may be more relevant to you</li>
      </ul>
      <p>Ads may be <strong>personalized</strong> using interests and browsing activity or <strong>non-personalized</strong> using contextual information. The applicable experience depends on your location, privacy law, consent choices, and Google settings.</p>
      <p>We do not select every specific advertisement shown. Ad delivery is controlled by Google’s systems, subject to Google’s policies and available publisher controls.</p>

      <h3>Managing Your Ad Preferences</h3>
      <ul>
        <li><a href="https://adssettings.google.com/" target="_blank" rel="noopener noreferrer">Google Ads Settings</a> — manage ad personalization.</li>
        <li><a href="https://optout.networkadvertising.org/" target="_blank" rel="noopener noreferrer">NAI opt-out tools</a> — manage interest-based advertising choices from participating companies.</li>
        <li><a href="https://www.youronlinechoices.com/" target="_blank" rel="noopener noreferrer">Your Online Choices</a> — advertising choices for users in participating European countries.</li>
      </ul>
      <p>Read <a href="https://policies.google.com/technologies/ads" target="_blank" rel="noopener noreferrer">Google’s advertising privacy information</a> for more detail.</p>
    </section>

    <section class="pp-card pp-section" id="analytics" aria-labelledby="analytics-heading">
      <h2 id="analytics-heading">Google Analytics</h2>
      <p>We use <strong>Google Analytics</strong>, a web analytics service provided by Google LLC, to understand how people use our website. Analytics may collect:</p>
      <ul>
        <li>Pages visited and navigation order</li>
        <li>Time spent on pages and session statistics</li>
        <li>Device, browser, and operating-system information</li>
        <li>Approximate country or region</li>
        <li>Referral source, such as search, direct, social, or another website</li>
        <li>Which tools and resources receive the most use</li>
      </ul>
      <p>We use Analytics reports in aggregate and do not use them to identify individual visitors. This information helps us assess mobile performance and decide which tools to build, improve, and prioritize.</p>
      <p>Google Analytics data is governed by <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer">Google’s Privacy Policy</a>. You can opt out across websites by installing the <a href="https://tools.google.com/dlpage/gaoptout" target="_blank" rel="noopener noreferrer">Google Analytics Opt-out Browser Add-on</a>.</p>
    </section>

    <section class="pp-card pp-section" id="how-we-use-information" aria-labelledby="use-heading">
      <h2 id="use-heading">How We Use the Information We Collect</h2>
      <div class="pp-table-wrap">
        <table>
          <thead><tr><th scope="col">Purpose</th><th scope="col">Information Used</th></tr></thead>
          <tbody>
            <tr><td>Responding to contact inquiries</td><td>Name, email address, topic, and message</td></tr>
            <tr><td>Improving time zone tools and content</td><td>Aggregate analytics information</td></tr>
            <tr><td>Identifying and fixing technical issues</td><td>Performance and error data</td></tr>
            <tr><td>Monitoring abuse or security threats</td><td>Technical request and session data</td></tr>
            <tr><td>Displaying and measuring advertisements</td><td>Advertising cookies and provider data</td></tr>
            <tr><td>Complying with legal obligations</td><td>Information required by applicable law</td></tr>
            <tr><td>Understanding broad visitor patterns</td><td>Aggregate device, referral, and regional data</td></tr>
          </tbody>
        </table>
      </div>
      <p>We use information for the purposes described in this policy. If our practices materially change, we will update this policy and obtain consent where applicable law requires it.</p>
    </section>

    <section class="pp-card pp-section" id="what-we-do-not-do" aria-labelledby="not-do-heading">
      <h2 id="not-do-heading">What We Do Not Do</h2>
      <ul class="pp-check-list">
        <li><strong>We do not sell personal information</strong> to data brokers or marketers.</li>
        <li><strong>We do not rent or trade email addresses</strong> or contact details.</li>
        <li><strong>We do not build named personal profiles</strong> from our analytics reports.</li>
        <li><strong>We do not intentionally use data beyond the purposes stated</strong> in this policy.</li>
        <li><strong>We do not knowingly collect personal data from children under 13.</strong></li>
        <li><strong>We do not send unsolicited marketing emails.</strong></li>
      </ul>
    </section>

    <section class="pp-card pp-section" id="data-sharing" aria-labelledby="sharing-heading">
      <h2 id="sharing-heading">Data Sharing and Third Parties</h2>
      <p>We do not sell, rent, or trade personal information.</p>
      <p><strong>Service providers:</strong> Companies supporting hosting, content delivery, security, analytics, advertising, or form delivery may process information necessary to perform those services. Their handling is governed by their terms, privacy notices, and applicable agreements.</p>
      <p><strong>Advertising partners:</strong> Google AdSense and related services operate as described in the advertising section.</p>
      <p><strong>Legal compliance:</strong> Information may be disclosed when required by applicable law, court order, or valid legal process.</p>
      <p><strong>Protection of rights:</strong> Information may be disclosed when reasonably necessary to protect the security, integrity, or legal rights of GMT to EST Converter, our visitors, or others.</p>
      <p>Any disclosure under our control is limited to what is reasonably necessary for the stated purpose.</p>
    </section>

    <section class="pp-card pp-section" id="third-party-services" aria-labelledby="services-heading">
      <h2 id="services-heading">Third-Party Services We Use</h2>
      <ul>
        <li><strong>Google AdSense</strong> — advertising delivery and measurement; see <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer">Google’s Privacy Policy</a>.</li>
        <li><strong>Google Analytics</strong> — aggregate website measurement; see <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer">Google’s Privacy Policy</a>.</li>
        <li><strong>FormSubmit</strong> — delivery of contact-form messages; see <a href="https://formsubmit.co/privacy.pdf" target="_blank" rel="noopener noreferrer">FormSubmit’s privacy terms</a>.</li>
        <li><strong>Web hosting and content delivery providers</strong> — reliable hosting and global page delivery.</li>
        <li><strong>Security services</strong> — protection against malicious traffic, abuse, and attacks.</li>
      </ul>
    </section>

    <section class="pp-card pp-section" id="external-links" aria-labelledby="external-heading">
      <h2 id="external-heading">External Links</h2>
      <p>Our website may link to external resources such as official government time zone information, world-clock references, service providers, and educational sources.</p>
      <p>These links are provided for convenience and information. We do not control the content, privacy practices, availability, or security of third-party websites. Following an external link means you leave GMT to EST Converter and become subject to that website’s terms and privacy policy.</p>
      <p>Review the privacy policy of any external website before providing personal information. Our <a href="/disclaimer/">website disclaimer</a> contains additional information about third-party resources and accuracy limits.</p>
    </section>

    <section class="pp-card pp-section" id="childrens-privacy" aria-labelledby="children-heading">
      <h2 id="children-heading">Children’s Privacy</h2>
      <p>GMT to EST Converter is a general-audience website. Its tools and content may be useful to people of different ages, but the site is not specifically directed toward children under 13.</p>
      <p>We do not knowingly collect, store, or process personal information from children under 13. If we learn that such information was submitted, we will take reasonable steps to delete it.</p>
      <p>If you are a parent or guardian and believe a child has sent personal information through our Contact page, please <a href="/contact-us/">submit a privacy request</a> so we can review it promptly.</p>
    </section>

    <section class="pp-card pp-section" id="international-visitors" aria-labelledby="international-heading">
      <h2 id="international-heading">International Visitors</h2>
      <p>Our website is accessible internationally, and visitors may have different privacy rights depending on location and applicable law. For example:</p>
      <ul>
        <li><strong>European Union and EEA visitors</strong> may have rights under the General Data Protection Regulation (GDPR).</li>
        <li><strong>California residents</strong> may have rights under the California Consumer Privacy Act (CCPA) and related amendments.</li>
        <li><strong>United Kingdom visitors</strong> may have rights under the UK GDPR and Data Protection Act.</li>
      </ul>
      <p>Information may be processed in countries where our service providers operate. Those countries may have different data-protection standards from your home jurisdiction.</p>
    </section>

    <section class="pp-card pp-section" id="privacy-rights" aria-labelledby="rights-heading">
      <h2 id="rights-heading">Your Privacy Rights and Choices</h2>
      <p>Depending on your location and applicable law, you may have the right to:</p>
      <ul>
        <li><strong>Access</strong> personal information we hold about you.</li>
        <li><strong>Correct</strong> inaccurate or incomplete information.</li>
        <li><strong>Request deletion</strong> where the law provides that right.</li>
        <li><strong>Restrict or object</strong> to certain processing in applicable circumstances.</li>
        <li><strong>Withdraw consent</strong> where processing is based on consent.</li>
        <li><strong>Request data portability</strong> where applicable.</li>
        <li><strong>Opt out of personalized advertising</strong> using the controls described above.</li>
      </ul>
      <p>To exercise a right relating to information under our control, use the <a href="/contact-us/">privacy option on our Contact Us form</a>. We will review legitimate requests and respond within any timeframe required by applicable law. We may need information to verify a request and identify relevant records.</p>
      <p>We will not discriminate against you for exercising an applicable privacy right.</p>
    </section>

    <section class="pp-card pp-section" id="data-retention" aria-labelledby="retention-heading">
      <h2 id="retention-heading">Data Retention</h2>
      <p>We retain information only for as long as reasonably necessary for the purposes described in this policy, to maintain security, resolve follow-up questions, or comply with applicable legal obligations.</p>
      <p>Contact submissions are kept long enough to review and respond to an inquiry and for a reasonable follow-up period. Analytics and advertising providers apply their own retention settings and policies to information they process.</p>
      <p>When information under our control is no longer reasonably needed, we may delete or anonymize it, subject to technical, security, and legal requirements.</p>
    </section>

    <section class="pp-card pp-section" id="data-security" aria-labelledby="security-heading">
      <h2 id="security-heading">Data Security</h2>
      <p>We take reasonable administrative, technical, and organizational measures to protect information against unauthorized access, misuse, loss, alteration, or disclosure. Measures include encrypted HTTPS transmission, restricted administrative access, reputable hosting infrastructure, and periodic security review.</p>
      <p>No method of internet transmission or electronic storage is completely secure. While we take reasonable precautions, we cannot guarantee absolute security. Do not submit passwords, payment-card details, government identification numbers, medical records, or other highly sensitive information through our contact form.</p>
      <p>If you believe information has been compromised in connection with this site, please <a href="/contact-us/">report the security concern</a> promptly.</p>
    </section>

    <section class="pp-card pp-section" id="policy-changes" aria-labelledby="changes-heading">
      <h2 id="changes-heading">Changes to This Privacy Policy</h2>
      <p>We may update this Privacy Policy as our services evolve, laws change, or our practices are refined.</p>
      <p>When changes are made, we will update the <strong>“Last updated”</strong> date at the top and revise the relevant text. For significant changes, we may also place a notice on the website.</p>
      <p>Review this page periodically to stay informed. Continued use after an updated policy is posted indicates acceptance of the revised policy to the extent permitted by applicable law.</p>
    </section>

    <section class="pp-contact-card" id="privacy-contact" aria-labelledby="contact-heading">
      <h2 id="contact-heading">Contact Us About Privacy</h2>
      <p>If you have a question, concern, or request related to this Privacy Policy or how information is handled, we want to hear from you.</p>
      <address>
        <strong>GMT to EST Converter</strong>
        <a href="/contact-us/">Use our Contact Us form</a>
        <a href="mailto:gmttoest@gmail.com">gmttoest@gmail.com</a>
      </address>
      <p>Privacy messages are reviewed carefully. Provide enough detail for us to understand the request, but do not include passwords or other highly sensitive information.</p>
    </section>

    <section class="pp-card pp-section" id="our-commitment" aria-labelledby="commitment-heading">
      <h2 id="commitment-heading">Our Commitment to You</h2>
      <p>Privacy is not an afterthought at GMT to EST Converter — it is a foundation.</p>
      <p>We built this website to be genuinely useful, free, and trustworthy. That means being transparent about what is collected, honest about how information is used, and respectful of your right to control your own information.</p>
      <p>Thank you for trusting us with your visit. We do not take that lightly.</p>
      <p><strong>The GMT to EST Converter Team</strong></p>
    </section>

    <nav class="pp-related" aria-labelledby="related-heading">
      <h2 id="related-heading">Related Policies and Resources</h2>
      <ul>
        <li><a href="/about-us/">About Us</a></li>
        <li><a href="/contact-us/">Contact Us</a></li>
        <li><a href="/terms-of-service/">Terms of Service</a></li>
        <li><a href="/disclaimer/">Disclaimer</a></li>
        <li><a href="/time-zone-guide/">Time Zone Guide</a></li>
      </ul>
    </nav>
  </div>
</BaseLayout>

<style>
  .pp-hero {
    position: relative;
    overflow: hidden;
    margin: 0 calc(-50vw + 50%);
    width: 100vw;
    padding: 56px 24px 52px;
    background: linear-gradient(135deg, #0f172a, #1e293b);
    color: #fff;
    text-align: center;
  }
  .pp-hero::before {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 80% 60% at 50% 0%, rgba(14,165,233,.15), transparent);
    content: "";
    pointer-events: none;
  }
  .pp-badge {
    position: relative;
    display: inline-block;
    margin-bottom: 18px;
    padding: 5px 14px;
    border: 1px solid rgba(59,130,246,.3);
    border-radius: 20px;
    background: rgba(30,58,138,.4);
    color: #93c5fd;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
  }
  .pp-hero h1 {
    position: relative;
    margin: 0 0 14px;
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.15;
  }
  .pp-hero h1 span { color: #93c5fd; }
  .pp-hero p { position: relative; margin: 0; color: #cbd5e1; }
  .pp-wrapper {
    display: grid;
    gap: 20px;
    max-width: 880px;
    margin: 0 auto;
    padding: 48px 24px 80px;
  }
  .pp-card {
    padding: clamp(24px, 5vw, 40px);
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--panel);
  }
  .pp-card h2, .pp-contact-card h2, .pp-related h2 {
    margin: 0 0 16px;
    color: var(--text);
    font-size: clamp(1.35rem, 3vw, 1.75rem);
    line-height: 1.25;
  }
  .pp-card h3 { margin: 24px 0 10px; color: var(--text); font-size: 1.08rem; }
  .pp-card p, .pp-contact-card p {
    margin: 0 0 14px;
    color: var(--muted);
    font-size: .975rem;
    line-height: 1.8;
  }
  .pp-card p:last-child, .pp-contact-card p:last-child { margin-bottom: 0; }
  .pp-card ul {
    display: grid;
    gap: 7px;
    margin: 0 0 16px;
    padding-left: 22px;
  }
  .pp-card li { color: var(--muted); font-size: .975rem; line-height: 1.7; }
  .pp-wrapper a { color: var(--accent); font-weight: 650; text-underline-offset: 3px; }
  .pp-wrapper strong { color: var(--text); }
  .pp-toc {
    padding: 28px 32px;
    border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--line));
    border-left: 4px solid var(--accent);
    border-radius: 0 12px 12px 0;
    background: color-mix(in srgb, var(--accent) 8%, var(--panel));
  }
  .pp-toc h2 {
    margin: 0 0 14px;
    color: var(--text);
    font-size: 1rem;
    letter-spacing: .06em;
    text-transform: uppercase;
  }
  .pp-toc ol {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 7px 28px;
    margin: 0;
    padding-left: 20px;
  }
  .pp-toc li { color: var(--muted); font-size: .9rem; line-height: 1.5; }
  .pp-table-wrap {
    overflow-x: auto;
    margin: 18px 0;
    border: 1px solid var(--line);
    border-radius: 10px;
  }
