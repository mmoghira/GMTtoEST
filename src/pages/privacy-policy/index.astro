---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import { getPageMeta } from "theme/i18n/config";

const metaBase = getPageMeta("en", "privacy");
const meta = { ...metaBase, keywords: "GMT to EST privacy, privacy policy, data collection, cookies, analytics" };
---

<BaseLayout lang="en" dir="ltr" title={meta.title} description={meta.description} slug="privacy-policy" meta={meta}>
  <section class="content" aria-labelledby="privacy">
    <h1 id="privacy">{meta.title}</h1>
    <p>This privacy policy explains what information GMT to EST collects and how we use it.</p>
    <h2>Information we collect</h2>
    <p>We do not require accounts. We may collect non-identifying usage data via analytics (page views, anonymous events) and standard browser data for security and analytics.</p>
    <h2>Cookies and analytics</h2>
    <p>We use minimal cookies and may use third-party analytics to understand traffic patterns. No personal data is sold to third parties.</p>
    <h2>Data requests</h2>
    <p>If you have questions about data or wish to request deletion, contact us via the <a href="/contact/">Contact</a> page.</p>
  </section>
</BaseLayout>
