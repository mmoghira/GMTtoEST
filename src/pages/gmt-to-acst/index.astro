---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import Converter from "theme/components/Converter.astro";
import { getTranslation, pageUrl, siteUrl } from "theme/i18n/config";

const lang = "en";
const dir = "ltr";
const slug = "gmt-to-acst";
const t = getTranslation(lang);

const pageTitle = "GMT to ACST Converter";
const seoTitle = "GMT to ACST Converter – Greenwich Mean Time to Australian Central Standard Time";
const pageDescription = "Convert GMT to ACST instantly. Calculate the exact 9.5-hour time difference between Greenwich Mean Time (UTC+0) and Australian Central Standard Time (UTC+9:30) with live clocks.";

const context = {
  from: "GMT",
  to: "ACST",
  fromZone: "UTC",
  toZone: "Australia/Adelaide"
};

const canonical = `${siteUrl}/gmt-to-acst/`;

// ═══════════════════════════════════════════════════════════════════════════
// 24-HOUR CONVERSION TABLE DATA & HELPER FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════
// GMT → ACST: ACST is 9 hours 30 minutes ahead of GMT
// ═══════════════════════════════════════════════════════════════════════════
function formatHour12(hour: number, minutes: number = 0) {
  const normalizedHour = ((hour % 24) + 24) % 24;
  const period = normalizedHour < 12 ? "AM" : "PM";
  const displayHour = normalizedHour % 12 || 12;
  const displayMinutes = minutes < 10 ? `0${minutes}` : `${minutes}`;
  return `${displayHour}:${displayMinutes} ${period}`;
}

const conversionRows = Array.from({ length: 24 }, (_, hour) => {
  // GMT hour:minute to total minutes, add 9h 30m (570 mins)
  const totalGmtMins = hour * 60;
  let totalAcstMins = totalGmtMins + 570;
  const nextDay = totalAcstMins >= 1440;
  if (nextDay) {
    totalAcstMins -= 1440; // Roll over to next day
  }
  const acstHour = Math.floor(totalAcstMins / 60);
  const acstMins = totalAcstMins % 60;

  return {
    gmt: formatHour12(hour, 0),
    acst: `${formatHour12(acstHour, acstMins)}${nextDay ? " (+1 day)" : ""}`,
    dayNote: nextDay ? "Next day in Australia" : "Same day"
  };
});

// Popular conversions
const popularConversions = [
  { gmt: "12:00 AM (Midnight) GMT", acst: "9:30 AM ACST", note: "Central Australian workday begins as GMT enters new day" },
  { gmt: "2:00 AM GMT", acst: "11:30 AM ACST", note: "Mid-morning focus hours across Adelaide, Darwin, and Broken Hill" },
  { gmt: "5:00 AM GMT", acst: "2:30 PM ACST", note: "Afternoon shift in Central Australia during London pre-dawn" },
  { gmt: "8:00 AM GMT", acst: "5:30 PM ACST", note: "London morning opening overlap with Australian end-of-day wrap-up" },
  { gmt: "10:00 AM GMT", acst: "7:30 PM ACST", note: "Prime evening sync for UK business calls with Adelaide" },
  { gmt: "12:00 PM (Noon) GMT", acst: "9:30 PM ACST", note: "London lunch hour; late evening in Central Australia" },
  { gmt: "2:30 PM GMT", acst: "12:00 AM (Midnight) ACST", note: "Midnight in Central Australia; afternoon operations in London" },
  { gmt: "4:00 PM GMT", acst: "1:30 AM ACST (+1 Day)", note: "London financial market close during Australian night" },
  { gmt: "6:00 PM GMT", acst: "3:30 AM ACST (+1 Day)", note: "Late evening in UK; pre-dawn hours in Central Australia" },
  { gmt: "8:00 PM GMT", acst: "5:30 AM ACST (+1 Day)", note: "Dawn in Adelaide and Darwin as UK evening winds down" },
  { gmt: "9:30 PM GMT", acst: "7:00 AM ACST (+1 Day)", note: "Australian early morning shift opening next calendar day" },
  { gmt: "11:30 PM GMT", acst: "9:00 AM ACST (+1 Day)", note: "Start of next business morning in Central Australia" },
];

// FAQ data (26 detailed FAQs)
const faqs = [
  { q: "What is Australian Central Standard Time (ACST)?", a: "Australian Central Standard Time (ACST) is the standard time zone running at UTC+9:30 (nine hours and thirty minutes ahead of Coordinated Universal Time). It is observed in South Australia, the Northern Territory, and Broken Hill." },
  { q: "What is Greenwich Mean Time (GMT)?", a: "Greenwich Mean Time (GMT) is the standard time reference running at UTC+0 along the Prime Meridian (0° longitude) in Greenwich, London." },
  { q: "How many hours is ACST ahead of GMT?", a: "Australian Central Standard Time (ACST) is 9 hours and 30 minutes ahead of Greenwich Mean Time (GMT). To convert GMT to ACST, add 9 hours and 30 minutes to the GMT time." },
  { q: "Why does ACST have a half-hour offset (+9:30)?", a: "In 1899, South Australia adopted UTC+9:30 to create a localized time standard centered between Western Australia (UTC+8) and Eastern Australia (UTC+10)." },
  { q: "Does Greenwich Mean Time (GMT) observe Daylight Saving Time?", a: "No. GMT itself stays fixed at UTC+0 year-round. However, the United Kingdom switches to British Summer Time (BST, UTC+1) from March to October." },
  { q: "Does South Australia observe Daylight Saving Time?", a: "Yes. South Australia switches to Australian Central Daylight Time (ACDT, UTC+10:30) from the first Sunday in October to the first Sunday in April." },
  { q: "Does the Northern Territory observe Daylight Saving Time?", a: "No. The Northern Territory (including Darwin and Alice Springs) remains permanently on ACST (UTC+9:30) all year round." },
  { q: "What is the best overlap time for a business meeting between London and Adelaide?", a: "The best overlap window is between 8:00 AM GMT and 10:00 AM GMT. In Adelaide (ACST), this corresponds to 5:30 PM ACST to 7:30 PM ACST, allowing UK staff to start their morning as Australian offices finish their day." },
  { q: "Which major Australian cities operate on ACST?", a: "Major cities on ACST include Adelaide (South Australia), Darwin and Alice Springs (Northern Territory), and the mining center of Broken Hill (New South Wales)." },
  { q: "How do defense partnerships like AUKUS manage time zones between London and Adelaide?", a: "Joint defense initiatives and naval engineering projects between the UK Ministry of Defence and South Australian defense shipyards log telemetry in UTC, mapping operational shifts to GMT and ACST." },
  { q: "How do I calculate GMT to ACST manually?", a: "Add 9 hours and 30 minutes to the GMT time. Example: 8:00 AM GMT plus 9 hours = 5:00 PM, plus 30 minutes = 5:30 PM ACST on the same calendar day." },
  { q: "What happens to calendar dates when converting GMT afternoon to ACST?", a: "Because ACST is 9.5 hours ahead of GMT, any GMT timestamp after 2:30 PM GMT rolls over into the next calendar day in Central Australia." },
  { q: "What is the IANA time zone identifier for ACST?", a: "The official IANA database keys for Australian Central Time are Australia/Adelaide (South Australia) and Australia/Darwin (Northern Territory)." },
  { q: "How do cricket fans in the UK watch Ashes matches played at the Adelaide Oval?", a: "Day matches at the Adelaide Oval starting at 10:30 AM ACST broadcast live in the UK at 1:00 AM GMT late overnight." },
  { q: "What is the offset difference between London and Darwin during UK summer?", a: "During UK summer (BST, UTC+1), London is at UTC+1 while Darwin stays at ACST (UTC+9:30). The difference narrows to 8.5 hours." },
  { q: "What is the offset difference between London and Adelaide during Australian summer?", a: "During Australian summer, Adelaide switches to ACDT (UTC+10:30). If London is on standard GMT (UTC+0), Adelaide is 10.5 hours ahead of London." },
  { q: "How do scientific observatories coordinate deep space tracking between the UK and Central Australia?", a: "Observatories in the UK and Australia stream radio telescope sensor data in UTC, translating research schedules into local GMT and ACST hours." },
  { q: "How reliable is our GMT to ACST conversion calculator?", a: "Our converter uses official IANA time zone database definitions via native browser engine APIs, delivering 100% precision across all seasonal shifts." },
  { q: "What is the capital of South Australia and its timezone?", a: "Adelaide is the capital city of South Australia, operating on ACST (UTC+9:30) in winter and ACDT (UTC+10:30) in summer." },
  { q: "What is the capital of the Northern Territory and its timezone?", a: "Darwin is the capital city of the Northern Territory, operating permanently on ACST (UTC+9:30) year-round." },
  { q: "What is the distance between London and Adelaide?", a: "Adelaide is located approximately 10,150 miles (16,330 km) southeast of London." },
  { q: "How do UK universities collaborate with South Australian institutions?", a: "Academic institutions like Oxford and Cambridge share joint research grants with the University of Adelaide, utilizing the 8:00 AM GMT / 5:30 PM ACST overlap slot." },
  { q: "Why does Broken Hill use South Australian time instead of New South Wales time?", a: "Broken Hill adopted ACST (UTC+9:30) due to its historical railway connection and trading ties to Adelaide rather than Sydney." },
  { q: "What role does Darwin Port play in UK-Australia trade?", a: "Darwin Port handles northern Australian shipping routes connecting to global maritime channels, managing vessel arrivals in ACST." },
  { q: "How do financial clearinghouses reconcile trades between London and Adelaide?", a: "Interbank settlements sent from London during late UK afternoon hours arrive in Central Australia after midnight, processing on the following ACST business morning." },
  { q: "Does Lord Howe Island use ACST?", a: "No. Lord Howe Island uses Lord Howe Standard Time (UTC+10:30), which is 1 hour ahead of ACST." },
  { q: "What is the offset difference between London and Adelaide during Australian winter?", a: "London operates on GMT (UTC+0) and Adelaide operates on ACST (UTC+9:30). Adelaide is 9.5 hours ahead of London." },
  { q: "What is the offset difference between London and Adelaide during Australian summer?", a: "During Australian summer, Adelaide switches to ACDT (UTC+10:30). If London is on standard GMT (UTC+0), Adelaide is 10.5 hours ahead." },
  { q: "What time zone is Alice Springs in?", a: "Alice Springs is located in the Northern Territory of Australia and operates permanently on ACST (UTC+9:30) year-round without daylight saving." },
  { q: "How do software systems parse UTC and Australia/Adelaide timestamps?", a: "Software libraries use standard IANA tz database definitions to map UTC (+00:00) and Australia/Adelaide (+09:30 standard, +10:30 DST), converting timestamps seamlessly." },
  { q: "What is the difference between ACST and AWST?", a: "ACST (Australian Central Standard Time) is UTC+9:30. AWST (Australian Western Standard Time) is UTC+8. ACST is 1.5 hours ahead of AWST." },
  { q: "What is the capital of South Australia and what timezone does it use?", a: "Adelaide is the capital of South Australia, operating on ACST (UTC+9:30) in winter and ACDT (UTC+10:30) in summer." },
  { q: "What is the capital of the Northern Territory and what timezone does it use?", a: "Darwin is the capital of the Northern Territory, operating permanently on ACST (UTC+9:30) year-round without daylight saving." },
  { q: "What is the primary airport in South Australia and its timezone?", a: "Adelaide Airport (ADL) operates on ACST (UTC+9:30) in winter and ACDT (UTC+10:30) in summer." },
  { q: "What is the primary airport in Northern Territory and its timezone?", a: "Darwin International Airport (DRW) operates on ACST (UTC+9:30) permanently." },
  { q: "What is the landmark rock formation in Central Australia and its timezone?", a: "Uluru (Ayers Rock) is located in Central Australia and operates on ACST (UTC+9:30) year-round." },
  { q: "What is the UNESCO World Heritage park in the Northern Territory and its timezone?", a: "Kakadu National Park operates on ACST (UTC+9:30) permanently." },
];

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "GMT to ACST, GMT to ACST Converter, Greenwich Mean Time to Australian Central Standard Time, Convert GMT to ACST, London to Adelaide time, GMT to Darwin, 9.5 hour timezone converter, UK to Australia time",
  image: "/assets/gmt-to-acst-og.svg",
  imageAlt: "GMT to ACST Converter – Convert Greenwich Mean Time to Australian Central Standard Time",
  faqs,
  appDescription: "Free online GMT to ACST converter featuring live clocks, 9.5-hour half-hour offset calculations, 24-hour schedules, and UK-Australia business planners.",
  applicationCategory: "UtilityApplication",
  operatingSystem: "Any",
  howToName: "How to Convert GMT to ACST",
  howToDescription: "Simple steps to convert Greenwich Mean Time to Australian Central Standard Time.",
  howToSteps: [
    { name: "Input GMT Time", text: "Select your desired Greenwich Mean Time in the converter tool." },
    { name: "Add 9 Hours 30 Minutes", text: "The calculator automatically adds 9.5 hours to determine Australian Central Standard Time (ACST)." },
    { name: "Check Date Rollover", text: "For GMT times after 2:30 PM, note that the calculated ACST time falls on the following calendar day." },
    { name: "Verify Daylight Saving Shifts", text: "Account for UK summer time (BST, UTC+1) from March to October, and South Australian summer time (ACDT, UTC+10:30) from October to April." }
  ],
};
