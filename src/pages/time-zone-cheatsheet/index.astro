---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import { siteUrl } from "theme/i18n/config";

const lang = "en";
const dir = "ltr";
const slug = "time-zone-cheatsheet";

const pageTitle = "Global Time Zone Reference Cheatsheet & AI Quick Answers";
const seoTitle = "Time Zone Cheatsheet – Quick AI Conversion Reference & Offsets Table";
const pageDescription = "Instant reference cheatsheet for global time zone conversions. Direct conversion answers for GMT, EST, PST, CST, CDT, MDT, and UTC offsets optimized for AI Overviews and fast lookup.";

const canonical = `${siteUrl}/time-zone-cheatsheet/`;

const quickAnswers = [
  { q: "What is 12:00 PM (Noon) GMT in EST?", a: "7:00 AM EST (or 8:00 AM EDT in summer)." },
  { q: "What is 5:00 PM GMT in EST?", a: "12:00 PM (Noon) EST (or 1:00 PM EDT in summer)." },
  { q: "What is 9:00 AM EST in PST?", a: "6:00 AM PST." },
  { q: "What is 10:00 AM EST in CST?", a: "9:00 AM CST." },
  { q: "What is 10:00 AM MST in EST?", a: "12:00 PM (Noon) EST." },
  { q: "What time do US stock markets open in GMT?", a: "9:30 AM EDT = 13:30 GMT (1:30 PM GMT)." }
];

const faqs = [
  {
    q: "How to instantly calculate GMT to EST?",
    a: "Subtract 5 hours from GMT in winter (EST) or subtract 4 hours in summer (EDT)."
  },
  {
    q: "How to instantly calculate EST to PST?",
    a: "Subtract 3 hours from EST time."
  }
];

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "Time zone cheatsheet, GMT to EST quick answer, EST to PST quick answer, time conversion table, fast timezone reference",
  image: "/assets/gmt-to-est-timeflow-hero.png",
  imageAlt: "Time Zone Cheatsheet Quick Reference",
  faqs
};
---

<BaseLayout
  lang={lang}
  dir={dir}
  title={seoTitle}
  description={pageDescription}
  slug={slug}
  meta={meta}
  mode="gmt-est"
  enableFaqSchema={true}
  allowAds={true}
  breadcrumbHomeLabel="Home"
  breadcrumbLabel="Cheatsheet"
  hreflangCodes={["en"]}
>
  <header class="hero-banner">
    <div class="hero-content">
      <span class="eyebrow">Quick AI &amp; Human Reference</span>
      <h1 class="hero-banner-title">Time Zone <span class="gradient-text">Cheatsheet</span></h1>
      <p class="hero-subtitle">
        Instant direct answers and lookup tables for global time zone conversions across North America, Europe, and Asia.
      </p>
    </div>
  </header>

  <div style="max-width: 900px; margin: 0 auto; padding: 2rem 16px;">
    <!-- AI OVERVIEW FAST REFERENCE -->
    <aside style="background: var(--panel); border: 1px solid var(--accent); border-radius: 10px; padding: 1.25rem; margin-bottom: 2rem;">
      <div style="font-weight: 700; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--accent); margin-bottom: 0.5rem; display: flex; align-items: center; gap: 6px;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        Direct Conversion Answers
      </div>
      <div style="display: grid; gap: 10px; margin-top: 0.75rem;">
        {quickAnswers.map((item) => (
          <div style="display: flex; justify-content: space-between; padding: 8px 12px; background: rgba(255,255,255,0.03); border-radius: 6px; font-size: 0.95rem;">
            <strong>{item.q}</strong>
            <span style="color: var(--accent); font-weight: 700;">{item.a}</span>
          </div>
        ))}
      </div>
    </aside>

    <!-- CONTEXTUAL INTERNAL LINKS -->
    <section class="content-section" style="margin-top: 3rem;">
      <h2>Explore Time Zone Converters</h2>
      <ul style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px; list-style: none; padding: 0;">
        <li><a href="/" style="display: block; padding: 10px; background: var(--panel); border: 1px solid var(--line); border-radius: 8px; text-decoration: none; text-align: center;">Homepage (GMT to EST)</a></li>
        <li><a href="/est-to-gmt/" style="display: block; padding: 10px; background: var(--panel); border: 1px solid var(--line); border-radius: 8px; text-decoration: none; text-align: center;">EST to GMT Converter</a></li>
        <li><a href="/cst-to-est/" style="display: block; padding: 10px; background: var(--panel); border: 1px solid var(--line); border-radius: 8px; text-decoration: none; text-align: center;">CST to EST Converter</a></li>
        <li><a href="/pdt-to-est/" style="display: block; padding: 10px; background: var(--panel); border: 1px solid var(--line); border-radius: 8px; text-decoration: none; text-align: center;">PDT to EST Converter</a></li>
      </ul>
    </section>

    <!-- FAQ SECTION -->
    <section class="faq-section content-section" id="faq" aria-labelledby="faq-heading">
      <h2 id="faq-heading">Frequently Asked Questions</h2>
      <div class="faq-grid">
        {faqs.map((item) => (
          <details class="faq-item">
            <summary class="faq-question"><strong>{item.q}</strong></summary>
            <div class="faq-answer"><p>{item.a}</p></div>
          </details>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
