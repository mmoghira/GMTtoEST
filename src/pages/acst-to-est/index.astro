      <g transform="translate(110, 110)">
        <path d="M-60 40 L-60 10 C-30 -10, -10 -25, 0 -25 C 10 -25, 30 -10, 60 10 L60 40 Z" fill="#12455d" stroke="#2f6278" stroke-width="2" />
