---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import Converter from "theme/components/Converter.astro";
import { getTranslation, pageUrl, siteUrl } from "theme/i18n/config";

const lang = "en";
const dir = "ltr";
const slug = "acst-to-est";
const t = getTranslation(lang);

const pageTitle = "ACST to EST Converter";
const seoTitle = "ACST to EST Converter – Australian Central Standard Time to Eastern Standard Time";
const pageDescription = "Convert ACST to EST instantly. Calculate the exact 14.5-hour time difference between Australian Central Standard Time (UTC+9:30) and US Eastern Standard Time (UTC-5) with live clocks.";

const context = {
  from: "ACST",
  to: "EST",
  fromZone: "Australia/Adelaide",
  toZone: "America/New_York"
};

const canonical = `${siteUrl}/acst-to-est/`;

// ═══════════════════════════════════════════════════════════════════════════
// 24-HOUR CONVERSION TABLE DATA & HELPER FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════
// ACST → EST: EST is 14 hours 30 minutes behind ACST
// ═══════════════════════════════════════════════════════════════════════════
function formatHour12(hour: number, minutes: number = 0) {
  const normalizedHour = ((hour % 24) + 24) % 24;
  const period = normalizedHour < 12 ? "AM" : "PM";
  const displayHour = normalizedHour % 12 || 12;
  const displayMinutes = minutes < 10 ? `0${minutes}` : `${minutes}`;
  return `${displayHour}:${displayMinutes} ${period}`;
}

const conversionRows = Array.from({ length: 24 }, (_, hour) => {
  // ACST hour:minute to total minutes, subtract 14h 30m (870 mins)
  const totalAcstMins = hour * 60;
  let totalEstMins = totalAcstMins - 870;
  const prevDay = totalEstMins < 0;
  if (prevDay) {
    totalEstMins += 1440; // Add 24 hours in minutes
  }
  const estHour = Math.floor(totalEstMins / 60);
  const estMins = totalEstMins % 60;

  return {
    acst: formatHour12(hour, 0),
    est: `${formatHour12(estHour, estMins)}${prevDay ? " (-1 day)" : ""}`,
    dayNote: prevDay ? "Previous day in US" : "Same day"
  };
});

// Popular conversions
const popularConversions = [
  { acst: "12:00 AM (Midnight) ACST", est: "9:30 AM EST (Prev Day)", note: "US East Coast morning start while Adelaide begins midnight" },
  { acst: "2:00 AM ACST", est: "11:30 AM EST (Prev Day)", note: "Midday work hours in New York while Central Australia sleeps" },
  { acst: "6:00 AM ACST", est: "3:30 PM EST (Prev Day)", note: "US afternoon wrap-up as Central Australia wakes up" },
  { acst: "9:30 AM ACST", est: "7:00 PM EST (Prev Day)", note: "US prime time evening during Central Australian morning start" },
  { acst: "12:00 PM (Noon) ACST", est: "9:30 PM EST (Prev Day)", note: "Late evening in US East Coast during Australian midday" },
  { acst: "2:30 PM ACST", est: "12:00 AM (Midnight) EST", note: "Midnight in US East Coast; afternoon focus in Adelaide & Darwin" },
  { acst: "4:30 PM ACST", est: "2:00 AM EST", note: "Overnight in Eastern US during Australian afternoon wrap-up" },
  { acst: "6:00 PM ACST", est: "3:30 AM EST", note: "Early pre-dawn in New York during Adelaide evening" },
  { acst: "8:00 PM ACST", est: "5:30 AM EST", note: "Early morning in US East Coast during Australian evening" },
  { acst: "9:30 PM ACST", est: "7:00 AM EST", note: "US morning office open overlap with Australian late evening" },
  { acst: "10:30 PM ACST", est: "8:00 AM EST", note: "Prime transatlantic/transpacific executive call window" },
  { acst: "11:30 PM ACST", est: "9:00 AM EST", note: "US East Coast morning start as Australian day completes" },
];

// FAQ data (26 detailed FAQs)
const faqs = [
  { q: "What is Australian Central Standard Time (ACST)?", a: "Australian Central Standard Time (ACST) is the standard time zone used in central Australia, operating at UTC+9:30 (nine hours and thirty minutes ahead of Coordinated Universal Time). It is observed in South Australia, the Northern Territory, and Broken Hill." },
  { q: "What is Eastern Standard Time (EST)?", a: "Eastern Standard Time (EST) is the standard time used on the East Coast of North America (UTC-5), including New York, Washington D.C., Boston, Atlanta, and Toronto." },
  { q: "How many hours is EST behind ACST?", a: "Eastern Standard Time (EST) is 14 hours and 30 minutes behind Australian Central Standard Time (ACST). To calculate EST from ACST, subtract 14 hours and 30 minutes." },
  { q: "Why does ACST have a half-hour offset (+9:30)?", a: "In 1899, South Australia adopted UTC+9:30 to better align local clock time with solar longitude midway between Perth (UTC+8) and Sydney (UTC+10)." },
  { q: "Does South Australia observe Daylight Saving Time?", a: "Yes. South Australia switches to Australian Central Daylight Time (ACDT, UTC+10:30) from the first Sunday in October to the first Sunday in April." },
  { q: "Does the Northern Territory observe Daylight Saving Time?", a: "No. The Northern Territory (including Darwin and Alice Springs) remains permanently on ACST (UTC+9:30) all year round." },
  { q: "Does Eastern Standard Time (EST) observe Daylight Saving Time?", a: "Yes. North American Eastern regions switch to Eastern Daylight Time (EDT, UTC-4) from March to November, which alters the time gap to 13.5 hours or 14.5 hours depending on cross-hemisphere seasonal overlaps." },
  { q: "What is the best time for a meeting between Adelaide and New York?", a: "The best overlap window is between 9:30 PM ACST and 11:30 PM ACST. In New York (EST), this corresponds to 7:00 AM EST to 9:00 AM EST, allowing US teams to start their day as Australian teams wrap up their evening." },
  { q: "Which major Australian cities operate on ACST?", a: "Major hubs on ACST include Adelaide (South Australia), Darwin and Alice Springs (Northern Territory), and the mining community of Broken Hill (New South Wales)." },
  { q: "How do defense and aerospace facilities in Woomera and Pine Gap manage time zones?", a: "Joint defense research facilities near Pine Gap (Alice Springs) and Woomera test ranges operate locally on ACST while logging all defense data and satellite communications in UTC." },
  { q: "How do I calculate ACST to EST manually?", a: "Subtract 14 hours and 30 minutes from the ACST clock time. For example, 12:00 PM (Noon) ACST minus 14 hours = 10:00 PM, minus 30 minutes = 9:30 PM EST on the previous calendar day." },
  { q: "What happens to calendar dates when converting ACST to EST?", a: "Because EST is 14.5 hours behind ACST, any ACST time between 12:00 AM Midnight and 2:29 PM ACST falls on the previous calendar day in Eastern Standard Time." },
  { q: "What is the IANA time zone identifier for ACST?", a: "The standardized IANA database key for Australian Central Time is Australia/Adelaide for South Australia and Australia/Darwin for the Northern Territory." },
  { q: "How do wine exporters in South Australia coordinate shipments to US East Coast importers?", a: "South Australian wineries in the Barossa Valley and McLaren Vale use late afternoon ACST hours to sync shipping manifests with US East Coast distribution hubs during early US morning hours." },
  { q: "What is the offset difference between Darwin and New York in summer?", a: "Darwin stays at ACST (UTC+9:30) year-round. During US summer (EDT, UTC-4), Darwin is 13.5 hours ahead of New York." },
  { q: "What is the offset difference between Adelaide and New York during Australian summer?", a: "During Australian summer, Adelaide switches to ACDT (UTC+10:30). If New York is on standard EST (UTC-5), Adelaide is 15.5 hours ahead of New York." },
  { q: "How do mining companies in the Northern Territory trade on US commodity exchanges?", a: "Mining operations extracting copper and uranium in the Northern Territory monitor New York COMEX prices overnight during early morning ACST hours." },
  { q: "How reliable is our ACST to EST conversion calculator?", a: "Our calculator relies on official IANA time zone rules loaded natively via browser engines, providing 100% accurate conversion across both northern and southern hemisphere seasonal shifts." },
  { q: "What is the capital city of South Australia?", a: "Adelaide is the capital city of South Australia, operating on ACST (UTC+9:30) in winter and ACDT (UTC+10:30) in summer." },
  { q: "What is the capital city of the Northern Territory?", a: "Darwin is the capital city of the Northern Territory, operating permanently on ACST (UTC+9:30) without daylight saving changes." },
  { q: "What is the distance between Adelaide and New York?", a: "Adelaide is located approximately 10,350 miles (16,650 km) from New York City across the Pacific Ocean." },
  { q: "How do transpacific flights from Australia to North America manage date changes?", a: "Flights crossing the International Date Line from Australia to the US land on the same local date or previous calendar day despite 15+ hours of flight time." },
  { q: "How do university researchers at the University of Adelaide collaborate with Ivy League schools in EST?", a: "Academic teams conduct virtual seminars using the 9:30 PM ACST / 7:00 AM EST overlap window." },
  { q: "Why does Broken Hill use South Australian time instead of New South Wales time?", a: "Broken Hill is located in far western New South Wales, but its historical railway ties and geographic proximity to Adelaide led it to adopt ACST (UTC+9:30) rather than AEST (UTC+10)." },
  { q: "What role does Darwin Port play in international maritime logistics?", a: "Darwin Port serves as Australia's primary northern maritime gateway to Asia and international trade routes, logging port traffic in ACST." },
  { q: "Does Lord Howe Island use ACST?", a: "No. Lord Howe Island uses Lord Howe Standard Time (UTC+10:30), which is 1 hour ahead of ACST." },
  { q: "What is the offset difference between Adelaide and Atlanta during Australian winter?", a: "Adelaide operates on ACST (UTC+9:30) and Atlanta operates on EDT (UTC-4) in summer or EST (UTC-5) in winter. Between ACST and standard EST, Adelaide is 14.5 hours ahead." },
  { q: "What time zone is Alice Springs in?", a: "Alice Springs is located in the Northern Territory of Australia and operates permanently on ACST (UTC+9:30) year-round without daylight saving." },
  { q: "How do sports broadcasts from Australia (such as Aussie Rules Football or Adelaide Strikers cricket) air in EST?", a: "Night games in Adelaide starting at 7:30 PM ACST air live in North America at 5:00 AM EST on the same day." },
  { q: "What is the difference between ACST and AEST?", a: "ACST (Australian Central Standard Time) is UTC+9:30. AEST (Australian Eastern Standard Time) is UTC+10. AEST is 30 minutes ahead of ACST." },
  { q: "How do software applications handle Australia/Adelaide vs America/New_York timestamps?", a: "System libraries use standard IANA tz database definitions to convert Australia/Adelaide (+09:30 standard, +10:30 DST) and America/New_York (-05:00 standard, -04:00 DST), resolving timestamps automatically." },
  { q: "What is the capital of South Australia and what timezone does it use?", a: "Adelaide is the capital of South Australia, operating on ACST (UTC+9:30) in winter and ACDT (UTC+10:30) in summer." },
  { q: "What is the capital of the Northern Territory and what timezone does it use?", a: "Darwin is the capital of the Northern Territory, operating permanently on ACST (UTC+9:30) without daylight saving." },
  { q: "What is the famous red rock landmark in the Northern Territory and its timezone?", a: "Uluru (Ayers Rock) is located in the Northern Territory and operates on ACST (UTC+9:30) year-round." },
  { q: "What is Kakadu National Park and its timezone?", a: "Kakadu National Park is a UNESCO World Heritage site in the Northern Territory, operating on ACST (UTC+9:30) year-round." },
];

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "ACST to EST, ACST to EST Converter, Australian Central Standard Time to Eastern Standard Time, Convert ACST to EST, Adelaide to New York time, Darwin to EST, 14.5 hour timezone converter, South Australia to US time",
  image: "/assets/acst-to-est-og.svg",
  imageAlt: "ACST to EST Converter – Convert Australian Central Standard Time to Eastern Standard Time",
  faqs,
  appDescription: "Free online ACST to EST converter featuring live clocks, 14.5-hour half-hour offset calculations, 24-hour schedules, and transpacific business planners.",
  applicationCategory: "UtilityApplication",
  operatingSystem: "Any",
  howToName: "How to Convert ACST to EST",
  howToDescription: "Simple steps to convert Australian Central Standard Time to US Eastern Standard Time.",
  howToSteps: [
    { name: "Input ACST Time", text: "Select your desired Australian Central Standard Time in the converter tool." },
    { name: "Subtract 14 Hours 30 Minutes", text: "The calculator automatically subtracts 14.5 hours to determine Eastern Standard Time (EST)." },
    { name: "Check Date Shift", text: "For ACST times before 2:30 PM, note that the calculated EST time falls on the previous calendar day." },
    { name: "Verify Daylight Saving Shifts", text: "Account for South Australian daylight saving (ACDT, UTC+10:30) from October to April, and US daylight saving (EDT, UTC-4) from March to November." }
  ],
};
---

<BaseLayout
