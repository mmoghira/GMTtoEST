---
import BaseLayout from "theme/layouts/BaseLayout.astro";

const lang = "en";
const dir = "ltr";
const slug = "ramadan-2027-dates";
const seoTitle = "Ramadan 2027 Dates | Start Date & Eid al-Fitr 2027";
const pageDescription = "Ramadan 2027 is expected to start on 8 February, with Eid al-Fitr expected on 9-10 March, subject to moon sighting. See the full dates.";

const pubDate = "2026-10-25T16:00:00+05:00";
const updatedDate = "2026-10-25T16:10:00+05:00";

const meta = {
  seoTitle,
  exactTitle: true,
  description: pageDescription,
  keywords: "ramadan 2027 dates, ramadan start date 2027, when does ramadan start in 2027, eid al-fitr 2027 date, ramadan 2027 calendar, laylat al-qadr 2027, ramadan moon sighting",
  pubDate,
  updatedDate,
  author: "Time Intelligence Team",
  faqs: [
    {
      q: "When does Ramadan start in 2027?",
      a: "Ramadan is expected to start on Monday, 8 February 2027, subject to moon sighting."
    },
    {
      q: "When is Eid al-Fitr in 2027?",
      a: "Eid al-Fitr is expected on 9–10 March 2027, depending on moon sighting and country."
    },
    {
      q: "Why are Ramadan dates called expected?",
      a: "Because the Islamic month starts with the sighting of the new moon, so the exact date can move by a day and can differ by country until the moon is sighted."
    },
    {
      q: "How long is Ramadan?",
      a: "Ramadan lasts about 29 or 30 days, depending on the moon sighting that determines the end of the month."
    }
  ]
};

// Exactly 3 rows for the Ramadan 2027 overview table
const RAMADAN_EVENTS_2027 = [
  {
    event: "Ramadan start",
    date: "Monday, 8 February 2027",
    note: "Expected first fasting day in many calendars; subject to moon sighting."
  },
  {
    event: "Laylat al-Qadr",
    date: "During the last ten nights of Ramadan",
    note: "The exact night varies by tradition and country; no single fixed night should be presented as certain."
  },
  {
    event: "Eid al-Fitr",
    date: "Tuesday, 9 March to Wednesday, 10 March 2027",
    note: "Expected dates; the actual date depends on moon sighting and country."
  }
];
---

<BaseLayout
  lang={lang}
  dir={dir}
  title={seoTitle}
  description={pageDescription}
  slug={slug}
  meta={meta}
  enableArticleSchema={true}
  enableFaqSchema={true}
  allowAds={true}
>
  <!-- Hero Banner -->
  <div class="hero-banner">
    <h1 class="hero-banner-title">Ramadan 2027 Dates</h1>
    <p style="color: #bdd2dc; font-size: clamp(1rem, 2.2vw, 1.25rem); max-width: 680px; margin: 12px auto 0;">
      Expected dates for the sacred month of Ramadan 2027, Laylat al-Qadr, and Eid al-Fitr celebrations.
    </p>
  </div>

  <div style="max-width: 860px; margin: 0 auto; padding-top: 24px;">

    <!-- ═══════════════════════════════════════════════════════════════════════
         QUICK ANSWER (SERVER-RENDERED DIRECTLY BELOW H1)
         ═══════════════════════════════════════════════════════════════════════ -->
    <section class="quick-answer-card" style="background: var(--panel); border: 2px solid var(--accent); border-radius: 14px; padding: 22px 26px; box-shadow: var(--shadow); margin-bottom: 32px;">
      <h2 style="margin: 0 0 10px; font-size: 1.2rem; font-weight: 800; color: var(--accent); font-family: 'Space Grotesk', system-ui, sans-serif;">
        Quick Answer
      </h2>
      <p style="margin: 0; font-size: 1.05rem; line-height: 1.65; color: #ffffff; font-weight: 500;">
        Ramadan 2027 is expected to start on Monday, 8 February 2027, with the first fasting day on that date in most calendars. Eid al-Fitr, marking the end of Ramadan, is expected on 9–10 March 2027, depending on moon sighting and country. All Islamic dates here are expected, not confirmed, until the moon is sighted.
      </p>
    </section>

    <!-- Hero Image Banner -->
    <div style="margin: 0 0 36px; text-align: center;">
      <img
        src="/assets/ramadan-2027-dates-hero.webp"
        alt="Crescent moon and calendar marking the expected start of Ramadan in 2027"
        width="960"
        height="540"
        loading="eager"
        decoding="async"
        style="width: 100%; height: auto; border-radius: 12px; border: 1px solid var(--line); box-shadow: var(--shadow);"
      />
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════════
         MAIN ARTICLE CONTENT (STRICT ORDER)
         1. H2: When does Ramadan start in 2027?
         2. H2: Ramadan 2027 dates at a glance
         3. H2: Why Ramadan moves every year
         4. H2: What is Ramadan?
         5. Calendar note: Ramadan and Easter 2027
         6. H2: Frequently Asked Questions
         ═══════════════════════════════════════════════════════════════════════ -->
    <article class="article-content">

      <!-- Section 1: When does Ramadan start in 2027? -->
      <h2>When does Ramadan start in 2027?</h2>
      <p>
        Ramadan is the ninth month of the Islamic calendar, a sacred lunar calendar governed by celestial cycles. Because lunar months commence upon the verified sighting of the waxing crescent moon (Hilal), the exact start date cannot be declared with total certainty months in advance. The official confirmation can move by a day depending on local astronomical visibility, weather conditions, and the religious authorities governing each country.
      </p>
      <p>
        Across global astronomical and calendar projections, <strong>Monday, 8 February 2027</strong>, is the expected first fasting day in many calendars.
      </p>
      <p>
        Some published schedules list the evening of <strong>Sunday, 7 February 2027</strong>, as the start of the month. This does not indicate a conflicting or contradictory date; rather, it reflects how time is measured in the Islamic calendar, where days begin at sunset rather than midnight. The evening of Sunday, 7 February represents the opening of the moon-sighting window and the commencement of the first nightly Taraweeh prayers, followed by the first daytime fast beginning at dawn on Monday, 8 February.
      </p>

      <!-- Section 2: Ramadan 2027 dates at a glance -->
      <h2>Ramadan 2027 dates at a glance</h2>
      <p>
        The table below provides an overview of the projected dates and major milestones associated with Ramadan 2027. All dates are strictly expected and subject to official moon sighting:
      </p>

      <div class="table-wrapper" style="overflow-x: auto; margin: 24px 0 16px; border: 1px solid var(--line); border-radius: 12px; background: var(--panel);">
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.95rem;">
          <thead>
            <tr style="background: #082030; border-bottom: 2px solid var(--line);">
              <th scope="col" style="padding: 14px 16px; color: var(--accent); font-weight: 800; font-family: 'Space Grotesk', sans-serif;">Event</th>
              <th scope="col" style="padding: 14px 16px; color: #38bdf8; font-weight: 800; font-family: 'Space Grotesk', sans-serif; white-space: nowrap;">Expected date or period</th>
              <th scope="col" style="padding: 14px 16px; color: #cbd5e1; font-weight: 800; font-family: 'Space Grotesk', sans-serif;">Important note</th>
            </tr>
          </thead>
          <tbody>
            {RAMADAN_EVENTS_2027.map((row, idx) => (
              <tr style={`border-bottom: 1px solid rgba(255, 255, 255, 0.06); ${idx % 2 === 1 ? 'background: rgba(255, 255, 255, 0.02);' : ''}`}>
                <td style="padding: 14px 16px; font-weight: 700; color: #ffffff; white-space: nowrap;">{row.event}</td>
                <td style="padding: 14px 16px; white-space: nowrap; font-family: 'Space Grotesk', monospace; color: '#fde047'; font-weight: 700;">
                  {row.date}
                </td>
                <td style="padding: 14px 16px; color: #94a3b8; font-size: 0.88rem; line-height: 1.5;">{row.note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Calendar Diagram Visual Image -->
      <figure style="margin: 32px 0 36px; text-align: center;">
        <img
          src="/assets/ramadan-2027-calendar.webp"
          alt="Calendar diagram for Ramadan 2027 from February to March with Eid al-Fitr marked as expected"
          width="800"
          height="450"
          loading="lazy"
          decoding="async"
          style="width: 100%; height: auto; border-radius: 12px; border: 1px solid var(--line); box-shadow: var(--shadow);"
        />
        <figcaption style="font-size: 0.88rem; color: var(--muted); margin-top: 10px; font-style: italic;">
          Ramadan 2027 is expected from 8 February, with Eid al-Fitr expected on 9–10 March, subject to moon sighting.
        </figcaption>
      </figure>

      <!-- Section 3: Why Ramadan moves every year -->
      <h2>Why Ramadan moves every year</h2>
      <p>
        The Islamic calendar (Hijri calendar) is an exclusively lunar system consisting of 12 lunar months totaling approximately 354 or 355 days. Because a solar year measured by the Gregorian calendar spans roughly 365.24 days, the lunar year is approximately 10 to 11 days shorter than the solar year.
      </p>
      <p>
        Consequently, Islamic dates rotate backward through the seasons, beginning about 10 to 11 days earlier on the Gregorian calendar with each passing year. This natural shift explains why Ramadan in 2027 is projected to fall across February and March, notably earlier in the Gregorian calendar year than the observance in 2026. Over a cycle of roughly 33 solar years, Ramadan visits every season, from the short days of winter to the long heat of midsummer.
      </p>

      <!-- Section 4: What is Ramadan? -->
      <h2>What is Ramadan?</h2>
      <p>
        Ramadan is revered as the holiest month of the Islamic year, commemorating the period during which the Holy Qur'an was first revealed to Prophet Muhammad (peace be upon him). Throughout the month, Muslims around the world dedicate themselves to spiritual discipline, self-restraint, heightened worship, and compassionate outreach:
      </p>
      <ul style="padding-left: 24px; margin-bottom: 20px; line-height: 1.7;">
        <li style="margin-bottom: 8px;">
          <strong>Fasting (Sawm):</strong> Adult Muslims who are physically able observe mandatory fasting each day from dawn (Fajr) until sunset (Maghrib), abstaining completely from all food, drink, smoking, and marital relations.
        </li>
        <li style="margin-bottom: 8px;">
          <strong>Daily Meals (Suhoor &amp; Iftar):</strong> Observants awaken before dawn to eat <em>Suhoor</em>, a nourishing pre-fasting meal. At sunset, families and communities gather for <em>Iftar</em>, traditionally opening the fast with dates and water followed by an evening meal.
        </li>
        <li style="margin-bottom: 8px;">
          <strong>Prayer &amp; Reflection:</strong> The month is characterized by increased Qur'anic recitation and nightly congregational prayers known as <em>Taraweeh</em>.
        </li>
        <li style="margin-bottom: 8px;">
          <strong>Charity (Zakat &amp; Sadaqah):</strong> Muslims actively emphasize generosity, feeding those in need and fulfilling mandatory charitable duties (Zakat al-Fitr) prior to Eid prayers.
        </li>
      </ul>
      <p style="padding: 14px 18px; background: rgba(0, 212, 170, 0.06); border-left: 3px solid var(--accent); border-radius: 6px; color: #ffffff; font-weight: 500;">
        Iftar and Suhoor times vary by location. Check a reliable local Islamic calendar or mosque timetable for the correct times in your city.
      </p>
      <p style="margin-top: 16px;">
        Because the timing of dawn and sunset depends strictly on geographic latitude and local coordinates, fasting hours vary across the globe. Fasting timetables must always be sourced from localized mosques or regional Islamic centers rather than a generic worldwide clock.
      </p>

      <!-- Section 5: Calendar Note -->
      <section style="margin: 36px 0; padding: 18px 22px; background: var(--panel); border: 1px solid var(--line); border-radius: 10px;">
        <p style="margin: 0; line-height: 1.7;">
          <strong>Calendar note:</strong> Ramadan is expected to begin in February 2027, with Eid al-Fitr expected in March. <a href="/easter-2027-date/">Easter Sunday</a> also falls in March 2027, on 28 March. These are separate religious observances, and their dates appearing in the same month is a calendar coincidence. If you are tracking annual holidays or coordinating global team availability across seasonal events, explore our comprehensive <a href="/holidays-2027/">Holidays in 2027</a> calendar hub, measure exact intervals with the <a href="/days-between-dates-calculator/">Days Between Dates Calculator</a>, or verify international call times with our <a href="/">GMT to EST Converter</a>.
        </p>
      </section>

      <!-- Section 6: Frequently Asked Questions -->
      <h2>Frequently Asked Questions</h2>
      <div class="faq-container" style="display: flex; flex-direction: column; gap: 14px; margin-top: 20px;">
        {meta.faqs.map((faq) => (
          <details style="background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 16px 20px;">
            <summary style="font-weight: 800; font-size: 1.05rem; cursor: pointer; color: var(--text);">
              {faq.q}
            </summary>
            <p style="margin: 12px 0 0; color: #bdd2dc; font-size: 0.95rem; line-height: 1.6;">
              {faq.a}
            </p>
          </details>
        ))}
      </div>

    </article>

  </div>

  <style>
    .article-content {
      line-height: 1.75;
      color: #bdd2dc;
    }
    .article-content h2 {
      color: #ffffff;
      font-size: clamp(1.35rem, 2.5vw, 1.75rem);
      margin: 36px 0 16px;
      padding-bottom: 8px;
      border-bottom: 1px solid var(--line);
      font-family: "Space Grotesk", system-ui, sans-serif;
    }
    .article-content p {
      margin-bottom: 16px;
    }
    .article-content a {
      color: var(--accent);
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    .article-content a:hover {
      color: #ffffff;
    }
  </style>
</BaseLayout>
