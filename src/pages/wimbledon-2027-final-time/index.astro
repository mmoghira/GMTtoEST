---
import BaseLayout from "theme/layouts/BaseLayout.astro";

const lang = "en";
const dir = "ltr";
const slug = "wimbledon-2027-final-time";
const seoTitle = "Wimbledon 2027 Final Time | Schedule, Dates & Time Zones";
const pageDescription =
  "Wimbledon 2027 finals are 10 and 11 July. See the men's final time in London, New York, India and more, plus the full schedule.";

const pubDate = "2026-10-25T16:20:00+05:00";
const updatedDate = "2026-10-25T16:35:00+05:00";

const meta = {
  seoTitle,
  exactTitle: true,
  description: pageDescription,
  exactDescription: true,
  keywords:
    "wimbledon 2027 final time, wimbledon 2027 schedule, wimbledon mens final 2027, wimbledon womens final 2027, wimbledon final time new york, wimbledon bst edt, wimbledon 2027 dates",
  pubDate,
  updatedDate,
  author: "Time Intelligence Team",
  faqs: [
    {
      q: "When is the Wimbledon 2027 men's final?",
      a: "Sunday 11 July 2027, on Centre Court. The exact start time is set in the official order of play, published the evening before."
    },
    {
      q: "When is the Wimbledon 2027 women's final?",
      a: "Saturday 10 July 2027, on Centre Court."
    },
    {
      q: "What time is the Wimbledon final in New York?",
      a: "It depends on the London start time confirmed in the order of play: 09:00 EDT if the final starts at 14:00 BST, or 11:00 EDT if it starts at 16:00 BST."
    },
    {
      q: "When does Wimbledon 2027 start and end?",
      a: "The main draw runs from Monday 28 June to Sunday 11 July 2027."
    }
  ]
};

// Tournament schedule entries (Section 4)
const WIMBLEDON_2027_SCHEDULE = [
  {
    stage: "Qualifying",
    date: "Monday 22 to Thursday 25 June 2027",
    venueNotes: "Roehampton"
  },
  {
    stage: "Main draw",
    date: "Monday 28 June to Sunday 11 July 2027",
    venueNotes: "The Championships"
  },
  {
    stage: "Quarter-finals",
    date: "Tuesday 6 and Wednesday 7 July 2027",
    venueNotes: "—"
  },
  {
    stage: "Ladies' semi-finals",
    date: "Thursday 8 July 2027",
    venueNotes: "—"
  },
  {
    stage: "Gentlemen's semi-finals",
    date: "Friday 9 July 2027",
    venueNotes: "—"
  },
  {
    stage: "Ladies' Singles Final",
    date: "Saturday 10 July 2027",
    venueNotes: "Centre Court"
  },
  {
    stage: "Gentlemen's Singles Final",
    date: "Sunday 11 July 2027",
    venueNotes: "Centre Court"
  }
];

// Scenario A (14:00 BST)
const SCENARIO_A = [
  { location: "London", localTime: "14:00", timeZone: "BST" },
  { location: "UTC", localTime: "13:00", timeZone: "UTC" },
  { location: "New York", localTime: "09:00", timeZone: "EDT" },
  { location: "Los Angeles", localTime: "06:00", timeZone: "PDT" },
  { location: "Mumbai", localTime: "18:30", timeZone: "IST" }
];

// Scenario B (16:00 BST)
const SCENARIO_B = [
  { location: "London", localTime: "16:00", timeZone: "BST" },
  { location: "UTC", localTime: "15:00", timeZone: "UTC" },
  { location: "New York", localTime: "11:00", timeZone: "EDT" },
  { location: "Los Angeles", localTime: "08:00", timeZone: "PDT" },
  { location: "Mumbai", localTime: "20:30", timeZone: "IST" }
];

// Conditional Event Schema for Gentlemen's Singles Final only (Section 8)
// Uses date-only (2027-07-11) without invented or unsupported start time.
const gentlemenFinalEventSchema = {
  "@context": "https://schema.org",
  "@type": "Event",
  "name": "Wimbledon 2027 Gentlemen's Singles Final",
  "startDate": "2027-07-11",
  "endDate": "2027-07-11",
  "eventStatus": "https://schema.org/EventScheduled",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "location": {
    "@type": "Place",
    "name": "Centre Court, All England Lawn Tennis and Croquet Club",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "London",
      "addressCountry": "GB"
    }
  },
  "description": "The Gentlemen's Singles Final at The Championships, Wimbledon 2027 on Centre Court in London."
};
---

<BaseLayout
  lang={lang}
  dir={dir}
  title={seoTitle}
  description={pageDescription}
  slug={slug}
  meta={meta}
  enableArticleSchema={true}
  enableFaqSchema={true}
  allowAds={true}
>
  <!-- Schema: Dedicated Event for Gentlemen's Singles Final Only (Date-only, unconfirmed start time) -->
  <script type="application/ld+json" set:html={JSON.stringify(gentlemenFinalEventSchema)} />

  <!-- Hero Banner -->
  <div class="hero-banner">
    <h1 class="hero-banner-title">Wimbledon 2027 Final Time</h1>
    <p style="color: #bdd2dc; font-size: clamp(1rem, 2.2vw, 1.25rem); max-width: 720px; margin: 12px auto 0; line-height: 1.5;">
      Championship final dates, tournament schedule, London-to-global time-zone conversions, and official order of play guidance.
    </p>
  </div>

  <div style="max-width: 860px; margin: 0 auto; padding-top: 24px;">

    <!-- =======================================================================
         SECTION 3: QUICK ANSWER (SERVER-RENDERED DIRECTLY BELOW H1)
         ======================================================================= -->
    <section class="quick-answer-card" style="background: var(--panel); border: 2px solid var(--accent); border-radius: 14px; padding: 22px 26px; box-shadow: var(--shadow); margin-bottom: 32px;">
      <h2 style="font-size: 1.15rem; font-weight: 800; color: var(--accent); text-transform: uppercase; letter-spacing: 0.05em; margin: 0 0 10px;">
        Quick Answer
      </h2>
      <p style="font-size: 1.12rem; font-weight: 600; line-height: 1.65; color: #ffffff; margin: 0;">
        The Championships, Wimbledon 2027 run from Monday, 28 June to Sunday, 11 July 2027. The Ladies' Singles Final is on Saturday, 10 July 2027 and the Gentlemen's Singles Final is on Sunday, 11 July 2027, both on Centre Court in London. The exact start time for each final is set in the official order of play, published the evening before — see the conversion table below for the usual afternoon start times in your time zone.
      </p>
    </section>

    <!-- =======================================================================
         MAIN ARTICLE CONTENT (EXACT H2 ORDER FROM SECTION 4)
         ======================================================================= -->
    <article class="article-content" style="color: #e2e8f0; line-height: 1.7; font-size: 1.05rem;">

      <!-- SECTION 4.1: H2: Wimbledon 2027 schedule -->
      <section style="margin-bottom: 40px;">
        <h2 style="font-size: clamp(1.5rem, 3.2vw, 2rem); font-weight: 800; color: #ffffff; font-family: 'Space Grotesk', system-ui, sans-serif; margin-bottom: 16px;">
          Wimbledon 2027 schedule
        </h2>
        <p style="margin-bottom: 20px;">
          The provisional stage-by-stage calendar for The Championships, Wimbledon 2027 is structured as follows:
        </p>

        <!-- Schedule Table -->
        <div style="overflow-x: auto; margin-bottom: 14px; border-radius: 10px; border: 1px solid var(--line);">
          <table style="width: 100%; border-collapse: collapse; text-align: left; background: var(--panel);">
            <thead>
              <tr style="background: rgba(14, 26, 48, 0.95); border-bottom: 2px solid var(--line);">
                <th style="padding: 14px 18px; font-weight: 800; color: #ffffff; font-size: 0.95rem;">Stage</th>
                <th style="padding: 14px 18px; font-weight: 800; color: #ffffff; font-size: 0.95rem;">Date</th>
                <th style="padding: 14px 18px; font-weight: 800; color: #ffffff; font-size: 0.95rem;">Venue / notes</th>
              </tr>
            </thead>
            <tbody>
              {WIMBLEDON_2027_SCHEDULE.map((row) => (
                <tr style="border-bottom: 1px solid var(--line);">
                  <td style="padding: 14px 18px; font-weight: 700; color: #38bdf8;">{row.stage}</td>
                  <td style="padding: 14px 18px; font-weight: 700; color: #ffffff;">{row.date}</td>
                  <td style="padding: 14px 18px; color: #cbd5e1;">{row.venueNotes}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <!-- Mandatory Caveat immediately beneath table -->
        <p style="font-size: 0.95rem; color: #94a3b8; font-style: italic; margin-top: 8px; margin-bottom: 24px;">
          The schedule is provisional and can change — check the official Wimbledon order of play for the day.
        </p>

        <!-- Hero Tennis Calendar Image (Section 7) -->
        <div style="margin: 28px 0; text-align: center;">
          <img
            src="/assets/wimbledon-2027-final-time-hero.webp"
            alt="Tennis court calendar marking the Wimbledon 2027 finals on 10 and 11 July"
            width="960"
            height="540"
            loading="eager"
            decoding="async"
            style="width: 100%; height: auto; border-radius: 12px; border: 1px solid var(--line); box-shadow: var(--shadow);"
          />
        </div>
      </section>

      <!-- SECTION 4.2: H2: What time is the Wimbledon 2027 final? -->
      <section style="margin-bottom: 40px;">
        <h2 style="font-size: clamp(1.5rem, 3.2vw, 2rem); font-weight: 800; color: #ffffff; font-family: 'Space Grotesk', system-ui, sans-serif; margin-bottom: 16px;">
          What time is the Wimbledon 2027 final?
        </h2>
        <p style="margin-bottom: 16px;">
          The final's exact start time should be checked in the official order of play published the evening before the relevant final day. Centre Court finals-day play has been scheduled in the afternoon London time, but this page does not confirm one fixed start time for either 2027 final.
        </p>
        <p style="margin-bottom: 24px;">
          The following tables show two possible start-time scenarios for conversion purposes. Readers must use the time confirmed in the official order of play. Neither 14:00 BST nor 16:00 BST is confirmed for 2027.
        </p>

        <!-- Scenario A Table -->
        <div style="margin-bottom: 28px;">
          <div style="font-size: 0.95rem; font-weight: 800; color: #38bdf8; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px;">
            Illustrative conversion — only if the official start time is 14:00 BST.
          </div>
          <div style="overflow-x: auto; border-radius: 10px; border: 1px solid var(--line);">
            <table style="width: 100%; border-collapse: collapse; text-align: left; background: var(--panel);">
              <thead>
                <tr style="background: rgba(14, 26, 48, 0.95); border-bottom: 2px solid var(--line);">
                  <th style="padding: 12px 16px; font-weight: 800; color: #ffffff; font-size: 0.9rem;">Location</th>
                  <th style="padding: 12px 16px; font-weight: 800; color: #ffffff; font-size: 0.9rem;">Local time</th>
                  <th style="padding: 12px 16px; font-weight: 800; color: #ffffff; font-size: 0.9rem;">Time zone</th>
                </tr>
              </thead>
              <tbody>
                {SCENARIO_A.map((row) => (
                  <tr style="border-bottom: 1px solid var(--line);">
                    <td style="padding: 12px 16px; font-weight: 700; color: #cbd5e1;">{row.location}</td>
                    <td style="padding: 12px 16px; font-weight: 800; color: #ffffff;">{row.localTime}</td>
                    <td style="padding: 12px 16px; color: #38bdf8; font-weight: 700;">{row.timeZone}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Scenario B Table -->
        <div style="margin-bottom: 28px;">
          <div style="font-size: 0.95rem; font-weight: 800; color: var(--accent); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px;">
            Illustrative conversion — only if the official start time is 16:00 BST.
          </div>
          <div style="overflow-x: auto; border-radius: 10px; border: 1px solid var(--line);">
            <table style="width: 100%; border-collapse: collapse; text-align: left; background: var(--panel);">
              <thead>
                <tr style="background: rgba(14, 26, 48, 0.95); border-bottom: 2px solid var(--line);">
                  <th style="padding: 12px 16px; font-weight: 800; color: #ffffff; font-size: 0.9rem;">Location</th>
                  <th style="padding: 12px 16px; font-weight: 800; color: #ffffff; font-size: 0.9rem;">Local time</th>
                  <th style="padding: 12px 16px; font-weight: 800; color: #ffffff; font-size: 0.9rem;">Time zone</th>
                </tr>
              </thead>
              <tbody>
                {SCENARIO_B.map((row) => (
                  <tr style="border-bottom: 1px solid var(--line);">
                    <td style="padding: 12px 16px; font-weight: 700; color: #cbd5e1;">{row.location}</td>
                    <td style="padding: 12px 16px; font-weight: 800; color: #ffffff;">{row.localTime}</td>
                    <td style="padding: 12px 16px; color: var(--accent); font-weight: 700;">{row.timeZone}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Conversion Diagram Image (Section 7) -->
        <figure style="margin: 28px 0; text-align: center;">
          <img
            src="/assets/wimbledon-2027-final-time-zones.webp"
            alt="Time conversion table for the Wimbledon final from London to New York, Los Angeles and Mumbai"
            width="800"
            height="450"
            loading="lazy"
            decoding="async"
            style="width: 100%; height: auto; border-radius: 12px; border: 1px solid var(--line); box-shadow: var(--shadow);"
          />
          <figcaption style="margin-top: 10px; font-size: 0.9rem; color: #94a3b8; font-style: italic;">
            Convert the London final time — check the official order of play for the confirmed start time.
          </figcaption>
        </figure>
      </section>

      <!-- SECTION 4.3: H2: Wimbledon 2027 final time in your time zone -->
      <section style="margin-bottom: 40px;">
        <h2 style="font-size: clamp(1.5rem, 3.2vw, 2rem); font-weight: 800; color: #ffffff; font-family: 'Space Grotesk', system-ui, sans-serif; margin-bottom: 16px;">
          Wimbledon 2027 final time in your time zone
        </h2>
        <p style="margin-bottom: 16px;">
          Visitors can use our <a href="/compare-time-zones/" style="color: var(--accent); text-decoration: underline; font-weight: 700;">Compare Time Zones page</a> or refer to the two illustrative conversion tables above to calculate the start time for their exact location once the afternoon schedule is confirmed.
        </p>

        <div style="background: rgba(14, 26, 48, 0.8); border-left: 4px solid var(--accent); border-radius: 6px; padding: 16px 20px; margin-bottom: 20px;">
          <p style="margin: 0; color: #e2e8f0; font-size: 1rem; line-height: 1.6;">
            London in July is on BST (UTC+1), not GMT. Converting from GMT instead of BST can make the calculated London-to-local start time one hour early.
          </p>
        </div>

        <p style="margin-bottom: 16px;">
          Because the United Kingdom observes British Summer Time throughout July, London clocks are one hour ahead of UTC (UTC+1). When converting London afternoon play to North American or Asian time zones, remember that New York is on Eastern Daylight Time (EDT, UTC−4, five hours behind London) and Los Angeles is on Pacific Daylight Time (PDT, UTC−7, eight hours behind London). Meanwhile, Mumbai operates on India Standard Time (IST, UTC+5:30, four and a half hours ahead of London).
        </p>
        <p style="font-size: 0.95rem; color: #cbd5e1;">
          If you want to keep an accurate digital timepiece open on your desktop or secondary display while following Centre Court action, our <a href="/full-screen-clock/" style="color: var(--accent); text-decoration: underline; font-weight: 700;">Full-Screen Clock</a> offers clean, distraction-free timekeeping.
        </p>
      </section>

      <!-- SECTION 4.4: H2: How to watch and check the order of play -->
      <section style="margin-bottom: 40px;">
        <h2 style="font-size: clamp(1.5rem, 3.2vw, 2rem); font-weight: 800; color: #ffffff; font-family: 'Space Grotesk', system-ui, sans-serif; margin-bottom: 16px;">
          How to watch and check the order of play
        </h2>
        <p style="margin-bottom: 16px; line-height: 1.7;">
          Broadcasting and streaming rights vary by country, and match schedules depend on court assignments and weather conditions. The official order of play is published the evening before each day of play by the tournament organizers. Visitors should check the official Wimbledon schedule and their local broadcaster's current programming information for confirmed start times, court assignments, and viewing availability. To convert any newly announced match schedule to US Eastern Time, you can always visit the <a href="/" style="color: var(--accent); text-decoration: underline; font-weight: 700;">GMT to EST Converter homepage</a>.
        </p>
      </section>

      <!-- SECTION 5: H2: Frequently Asked Questions -->
      <section style="margin-bottom: 40px;">
        <h2 style="font-size: clamp(1.5rem, 3.2vw, 2rem); font-weight: 800; color: #ffffff; font-family: 'Space Grotesk', system-ui, sans-serif; margin-bottom: 20px;">
          Frequently Asked Questions
        </h2>

        <div style="display: flex; flex-direction: column; gap: 14px;">
          {meta.faqs.map((faq) => (
            <details style="background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 18px 20px; transition: border-color 0.2s;">
              <summary style="font-size: 1.08rem; font-weight: 800; color: #ffffff; cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center;">
                <span>{faq.q}</span>
                <span style="color: var(--accent); font-size: 1.2rem; font-weight: bold; margin-left: 12px;">+</span>
              </summary>
              <p style="margin: 12px 0 0; color: #cbd5e1; font-size: 0.98rem; line-height: 1.6;">
                {faq.a}
              </p>
            </details>
          ))}
        </div>
      </section>

    </article>

  </div>
</BaseLayout>
