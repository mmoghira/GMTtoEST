---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import Converter from "theme/components/Converter.astro";
import { getLang, getTranslation, getPageMeta } from "theme/i18n/config";

const lang = "ru";
const dir = "ltr";
const slug = "";
const t = getTranslation(lang);
const meta = getPageMeta(lang, "home");

const seoTitle = "Конвертер GMT в EST | GMT в EST с учетом летнего времени";
const pageDescription = "Мгновенно переводите время из GMT в EST или EDT. Живые часы, 24-часовая таблица разницы во времени, календарь перевода часов и ответы на вопросы.";

const context = {
  from: "GMT",
  to: "EST",
  fromZone: "UTC",
  toZone: "America/New_York"
};

const canonical = "https://gmttoestconverter.com/ru/";

// Helper to format 12-hour values
function formatHour12(hour: number, minute: number = 0) {
  const normalized = ((hour % 24) + 24) % 24;
  const period = normalized < 12 ? "AM" : "PM";
  const displayHour = normalized % 12 || 12;
  return `${displayHour}:${String(minute).padStart(2, "0")} ${period}`;
}

// Generate the 24-hour comparative table rows (EST = GMT - 5, EDT = GMT - 4)
const conversionRows = Array.from({ length: 24 }, (_, hour) => {
  const estHour = (hour - 5 + 24) % 24;
  const estDayDiff = (hour - 5) < 0 ? "Предыдущий день" : "Тот же день";

  const edtHour = (hour - 4 + 24) % 24;
  const edtDayDiff = (hour - 4) < 0 ? "Предыдущий день" : "Тот же день";

  return {
    gmt: formatHour12(hour),
    est: `${formatHour12(estHour)} EST (${estDayDiff})`,
    edt: `${formatHour12(edtHour)} EDT (${edtDayDiff})`,
    offset: "GMT (UTC+0) | EST (UTC-5) / EDT (UTC-4)",
    notes: `Зимой: разница 5 ч (EST). Летом: разница 4 ч (EDT).`
  };
});

// JSON-LD Schema definitions in Russian
const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Конвертер GMT в EST",
    "applicationCategory": "UtilitiesApplication",
    "operatingSystem": "Any",
    "url": canonical,
    "description": "Бесплатный онлайн-конвертер GMT в EST с живыми часами, учетом летнего времени и подробными таблицами разницы во времени."
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Что такое GMT?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "GMT (Greenwich Mean Time) — это Среднее время по Гринвичу, которое служит астрономическим ориентиром и соответствует часовому поясу UTC+0."
        }
      },
      {
        "@type": "Question",
        "name": "Что такое EST?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "EST (Eastern Standard Time) — это Восточное стандартное время в Северной Америке (UTC-5), используемое в зимние месяцы."
        }
      },
      {
        "@type": "Question",
        "name": "Какова разница во времени между GMT и EST?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Зимой разница составляет 5 часов (EST отстает от GMT на 5 часов). Летом, во время действия летнего времени EDT (UTC-4), разница сокращается до 4 часов."
        }
      },
      {
        "@type": "Question",
        "name": "Когда действует летнее время EDT?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Летнее время EDT действует со второго воскресенья марта до первого воскресенья ноября. В этот период восточные регионы США и Канады переводят часы на 1 час вперед (UTC-4)."
        }
      },
      {
        "@type": "Question",
        "name": "Учитывает ли этот конвертер летнее время?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Да, калькулятор является интеллектуальным и автоматически определяет, какой офсет (EST или EDT) действует на выбранную вами дату."
        }
      },
      {
        "@type": "Question",
        "name": "Какая разница между GMT и UTC?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "GMT — это часовой пояс, основанный на вращении Земли, а UTC — это международный стандарт времени, основанный на атомных часах. В гражданской практике их значения совпадают."
        }
      },
      {
        "@type": "Question",
        "name": "Какие города России наиболее зависимы от разницы GMT и EST?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Москва, Санкт-Петербург, Новосибирск, Екатеринбург и Владивосток активно координируют международные сделки, логистику и IT-процессы с США."
        }
      },
      {
        "@type": "Question",
        "name": "Какое время в Москве относительно GMT?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Московское время (MSK) находится на постоянном смещении UTC+3, что означает, что Москва всегда на 3 часа опережает GMT."
        }
      },
      {
        "@type": "Question",
        "name": "Как координировать встречи между Москвой и Нью-Йорком?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Лучшее время для звонков — с 16:00 до 19:00 по московскому времени, что соответствует 9:00–12:00 по времени Нью-Йорка (EDT летом) или 8:00–11:00 (EST зимой)."
        }
      },
      {
        "@type": "Question",
        "name": "Подходит ли этот конвертер для планирования авиарейсов?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Да, калькулятор точно переводит часы отправления и прибытия, помогая составить правильный план поездки."
        }
      },
      {
        "@type": "Question",
        "name": "Бесплатен ли этот сервис?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Да, конвертер полностью бесплатен и не требует регистрации для проведения расчетов."
        }
      },
      {
        "@type": "Question",
        "name": "Как переводится аббревиатура EST?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "EST расшифровывается как Eastern Standard Time — Восточное стандартное время Северной Америки."
        }
      },
      {
        "@type": "Question",
        "name": "Использует ли Нью-Йорк летнее время?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Да, Нью-Йорк переходит на летнее время (EDT, UTC-4) в марте и возвращается на зимнее (EST, UTC-5) в ноябре."
        }
      },
      {
        "@type": "Question",
        "name": "Какова разница во времени между Сибирью и Восточным побережьем США?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Новосибирск (UTC+7) опережает Нью-Йорк (EST, UTC-5) на 12 часов зимой и на 11 часов летом (EDT, UTC-4)."
        }
      },
      {
        "@type": "Question",
        "name": "Какова разница во времени между Екатеринбургом и Нью-Йорком?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Екатеринбург (UTC+5) опережает Нью-Йорк на 10 часов зимой и на 9 часов летом."
        }
      },
      {
        "@type": "Question",
        "name": "Какова разница во времени между Владивостоком и Нью-Йорком?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Владивосток (UTC+10) опережает Нью-Йорк на 15 часов зимой и на 14 часов летом, что требует тщательного планирования звонков."
        }
      },
      {
        "@type": "Question",
        "name": "Как перевести 12:00 PM GMT в EST?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "12:00 PM GMT (полдень) — это 7:00 AM EST зимой или 8:00 AM EDT летом."
        }
      },
      {
        "@type": "Question",
        "name": "Как перевести 8:00 AM GMT в EST?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "8:00 AM GMT — это 3:00 AM EST зимой или 4:00 AM EDT летом."
        }
      },
      {
        "@type": "Question",
        "name": "Как перевести 6:00 PM GMT в EST?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "6:00 PM GMT — это 1:00 PM EST зимой или 2:00 PM EDT летом."
        }
      },
      {
        "@type": "Question",
        "name": "Какие штаты США используют EST?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Штаты Восточного побережья, включая Нью-Йорк, Флориду, Пенсильванию, Массачусетс и округ Колумбия, используют EST/EDT."
        }
      },
      {
        "@type": "Question",
        "name": "Использует ли Великобритания GMT круглый год?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Нет. В летние месяцы Великобритания переходит на Британское летнее время (BST, UTC+1), возвращаясь к GMT (UTC+0) зимой."
        }
      },
      {
        "@type": "Question",
        "name": "Где находится точка отсчета GMT?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Точка отсчета находится на Гринвичском меридиане в Лондоне, Великобритания."
        }
      },
      {
        "@type": "Question",
        "name": "Влияет ли летнее время в Великобритании на разницу с США?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Да. Поскольку переходы на летнее время в США и Великобритании происходят в разные даты, возникают короткие периоды весной и осенью, когда разница временно меняется."
        }
      },
      {
        "@type": "Question",
        "name": "Какова разница во времени между Лондоном и Нью-Йорком летом?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Летом Лондон находится на BST (UTC+1), а Нью-Йорк — на EDT (UTC-4). Разница составляет ровно 5 часов."
        }
      },
      {
        "@type": "Question",
        "name": "Можно ли использовать конвертер на мобильном телефоне?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Да, интерфейс оптимизирован для работы на смартфонах и планшетах."
        }
      },
      {
        "@type": "Question",
        "name": "Откуда конвертер берет информацию о часовых поясах?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Все расчеты базируются на официальной базе данных часовых поясов IANA, обновляемой в реальном времени."
        }
      },
      {
        "@type": "Question",
        "name": "Как работает кнопка Swap (Реверс)?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Нажатие на кнопку реверса мгновенно меняет направление конвертации, позволяя переводить время из EST в GMT."
        }
      },
      {
        "@type": "Question",
        "name": "Использует ли Торонто время EST?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Да, Торонто и провинция Онтарио в Канаде используют Eastern Time (EST/EDT) синхронно с Нью-Йорком."
        }
      },
      {
        "@type": "Question",
        "name": "Что делать, если время на моем компьютере настроено неправильно?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Наш конвертер ориентируется на серверное время и базу данных IANA, поэтому сбои на вашем устройстве не повлияют на точность перевода."
        }
      },
      {
        "@type": "Question",
        "name": "Кто является редактором контента на этом сайте?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Специалист по международной хронометрии Джеки Брюс периодически проверяет тексты и функционал конвертера."
        }
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Главная",
        "item": canonical
      }
    ]
  }
];
---

<BaseLayout
  lang={lang}
  dir={dir}
  title={seoTitle}
  description={pageDescription}
  slug={slug}
  meta={meta}
  mode="gmt-est"
  enableFaqSchema={true}
  allowAds={true}
  breadcrumbHomeLabel="Главная"
  breadcrumbLabel=""
>

<!-- Inject additional JSON-LD Schemas -->
<script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

<!-- ═══════════════════════════════════════════════════════════════════════════
     H1: КОНВЕРТЕР GMT В EST
     ═══════════════════════════════════════════════════════════════════════ -->
<section class="hero-banner">
  <h1 class="hero-banner-title">
    Конвертер GMT в EST
  </h1>
</section>

<!-- PRIMARY CONVERTER & LIVE CLOCKS (Above the Fold) -->
<div style="max-width: 900px; margin: 0 auto; padding: 0 16px 24px;">
  <Converter intent="converter" t={t} context={context} />
  
  <!-- LIVE CLOCKS -->
  <section class="clock-grid" aria-label="Live Clocks" style="margin-top: 24px;">
    <h2>Live Clocks</h2>
    <div class="clock-card">
      <span class="eyebrow">Source Time Zone</span>
      <strong id="gmtClock">--:--:--</strong>
    </div>
    <div class="clock-card">
      <span class="eyebrow">Target Time Zone</span>
      <strong id="estClock">--:--:--</strong>
      <p style="margin-top: 4px; font-size: 0.85rem; color: var(--muted);">Active Zone: <em id="estZone">ET</em></p>
    </div>
  </section>
</div>


</div>
</div>


<!-- LIVE CONVERTER COMPONENT -->
<section class="converter-wrapper reveal" id="calculator-section">
  <div class="converter-box">
    
  </div>
</section>

<!-- FEATURE STRIP -->
<section class="feature-strip" aria-label="Основные характеристики">
  <div class="feature-item">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feature-icon" aria-hidden="true">
      <circle cx="12" cy="12" r="10"></circle>
      <polyline points="12 6 12 12 16 14"></polyline>
    </svg>
    <span>Синхронизация в реальном времени</span>
  </div>
  <div class="feature-item">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feature-icon" aria-hidden="true">
      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
      <line x1="16" y1="2" x2="16" y2="6"></line>
      <line x1="8" y1="2" x2="8" y2="6"></line>
      <line x1="3" y1="10" x2="21" y2="10"></line>
    </svg>
    <span>Автоопределение DST</span>
  </div>
  <div class="feature-item">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feature-icon" aria-hidden="true">
      <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"></polygon>
      <line x1="9" y1="3" x2="9" y2="18"></line>
      <line x1="15" y1="6" x2="15" y2="21"></line>
    </svg>
    <span>Официальные стандарты IANA</span>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════════════════════
     1. ПЕРЕВОД ВРЕМЕНИ ИЗ GMT В EST
     ═══════════════════════════════════════════════════════════════════════ -->
<section class="method-section reveal" id="convert-instantly">
  <div class="method-intro">
    <div class="eyebrow">Мгновенный расчет</div>
    <h2>Перевод времени из GMT в EST</h2>
    <p>
      Наш интерактивный калькулятор переводит Среднее время по Гринвичу (GMT) в Восточное стандартное время (EST) и Восточное летнее время (EDT). Укажите нужную дату и время, чтобы мгновенно получить точный результат.
    </p>
    <p>
      Этот сервис помогает координировать расписания, планировать звонки и организовывать логистику. Все вычисления автоматически корректируются в соответствии с сезонными изменениями смещения.
    </p>
  </div>
  
  <!-- SVG 1: RUSSIAN HERO BANNER -->
  <div class="hero-visual" style="max-width: 800px; margin: 24px auto 0;">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 240" width="100%" height="auto" style="background: linear-gradient(135deg, #071b26 0%, #0f3446 100%); border-radius: 8px;">
      <text x="400" y="40" font-family="'Space Grotesk', sans-serif" font-size="20" font-weight="bold" fill="#36c7b5" text-anchor="middle">СИНХРОНИЗИРОВАННЫЕ МИРОВЫЕ ЧАСЫ</text>
      
      <!-- GMT Clock Dial -->
      <g transform="translate(180, 130)">
        <circle cx="0" cy="0" r="50" fill="#0c354a" stroke="#2f6278" stroke-width="3" />
        <line x1="0" y1="0" x2="0" y2="-35" stroke="#f4fbff" stroke-width="3" stroke-linecap="round" />
        <line x1="0" y1="0" x2="25" y2="0" stroke="#36c7b5" stroke-width="2" stroke-linecap="round" />
        <text x="0" y="70" font-family="'Space Grotesk', sans-serif" font-size="14" font-weight="bold" fill="#f4fbff" text-anchor="middle">GMT (UTC+0)</text>
      </g>
      
      <!-- Sync Arrow -->
      <path d="M 310 130 L 490 130" stroke="#36c7b5" stroke-width="3" fill="none" marker-end="url(#arrow)" />
      <text x="400" y="115" font-family="'Manrope', sans-serif" font-size="12" fill="#8fd7ff" text-anchor="middle">Сдвиг на 4-5 часов назад</text>
      
      <!-- EST Clock Dial -->
      <g transform="translate(620, 130)">
        <circle cx="0" cy="0" r="50" fill="#0c354a" stroke="#2f6278" stroke-width="3" />
        <line x1="0" y1="0" x2="-20" y2="-20" stroke="#f4fbff" stroke-width="3" stroke-linecap="round" />
        <line x1="0" y1="0" x2="15" y2="25" stroke="#8fd7ff" stroke-width="2" stroke-linecap="round" />
        <text x="0" y="70" font-family="'Space Grotesk', sans-serif" font-size="14" font-weight="bold" fill="#36c7b5" text-anchor="middle">EST (UTC-5)</text>
      </g>
      
      <defs>
        <marker id="arrow" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 0 L 10 5 L 0 10 z" fill="#36c7b5" />
        </marker>
      </defs>
    </svg>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════════════════════
     2. ТЕКУЩЕЕ ВРЕМЯ GMT И EST
     ═══════════════════════════════════════════════════════════════════════ -->


<!-- ═══════════════════════════════════════════════════════════════════════════
     3. ЧТО ТАКЕ СРЕДНЕЕ ВРЕМЯ ПО ГРИНВИЧУ (GMT)?
     ═══════════════════════════════════════════════════════════════════════ -->
<section class="method-section reveal" id="what-is-gmt">
  <div class="method-intro">
    <div class="eyebrow">Определение часового пояса</div>
    <h2>Что такое Среднее время по Гринвичу (GMT)?</h2>
    <p>
      Среднее время по Гринвичу (GMT) исторически привязано к Королевской обсерватории в Гринвиче, Лондон. Оно используется как базовый часовой пояс (UTC+0) для координации времени во всем мире.
    </p>
    <p>
      В отличие от регионов, переходящих на летнее время, GMT остается постоянным в течение всего года, служа стабильной отправной точкой.
    </p>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════════════════════
     4. ЧТО ТАКЕ ВОСТОЧНОЕ СТАНДАРТНОЕ ВРЕМЯ (EST)?
     ═══════════════════════════════════════════════════════════════════════ -->
<section class="method-section reveal" id="what-is-est">
  <div class="method-intro">
    <div class="eyebrow">Определение часового пояса</div>
    <h2>Что такое Восточное стандартное время (EST)?</h2>
    <p>
      Восточное стандартное время (EST) — это часовой пояс Северной Америки, имеющий смещение UTC-5. Оно охватывает крупные экономические и финансовые центры Восточного побережья США и Канады.
    </p>
    <p>
      Летом в этом регионе вводится летнее время EDT (Eastern Daylight Time) со смещением UTC-4, что временно сокращает разницу с Гринвичем.
    </p>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════════════════════
     5. РАЗНИЦА ЧАСОВЫХ ПОЯСОВ GMT И EST
     ═══════════════════════════════════════════════════════════════════════ -->
<section class="method-section reveal" id="time-difference">
  <div class="method-intro">
    <div class="eyebrow">Разница во времени</div>
    <h2>Разница часовых поясов GMT и EST</h2>
    <p>
      Разница во времени между GMT и Восточным побережьем меняется в зависимости от времени года:
    </p>
    <ul style="margin: 16px 0 0; padding-left: 1.5rem; color: var(--muted); line-height: 1.7;">
      <li><strong>Зимний период (EST)</strong>: Восточное побережье отстает от Гринвича на <strong>5 часов</strong> (GMT опережает EST на 5 часов).</li>
      <li><strong>Летний период (EDT)</strong>: Восточное побережье отстает от Гринвича на <strong>4 часа</strong> (GMT опережает EDT на 4 часа).</li>
    </ul>
  </div>
  
  <!-- SVG 2: GMT → EST INFOGRAPHIC IN RUSSIAN -->
  <div class="hero-visual" style="max-width: 800px; margin: 24px auto 0;">
