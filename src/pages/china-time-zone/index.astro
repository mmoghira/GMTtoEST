---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import { siteUrl } from "theme/i18n/config";

const lang = "en";
const dir = "ltr";
const slug = "china-time-zone";
const seoTitle = "China Time Zone Guide: Beijing Time, CST & Offset (2026)";
const pageDescription = "Comprehensive guide to China Time Zone (Beijing Time, CST, UTC+8). Learn why China uses one single time zone across 5 geographic solar zones.";

const pubDate = "2026-07-30T15:00:00+05:00";
const updatedDate = "2026-07-30T15:00:00+05:00";

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "China Time Zone, China Standard Time, CST, Beijing Time, China UTC Offset, UTC+8, Xinjiang Time, Urumqi Time, Hong Kong Time, Macao Time, China Time Guide",
  image: "/assets/china-time-zone-map.webp",
  imageAlt: "China Time Zone Map Graphic showing single Beijing Time standard",
  pubDate,
  updatedDate,
  author: "Jackie Bruce",
  faqs: [
    {
      q: "What time zone does China use?",
      a: "China officially uses a single standard time zone known as China Standard Time (CST), or Beijing Time (北京时间). It operates at an offset of UTC+8 year-round across the entire nation."
    },
    {
      q: "How many geographical time zones does China span?",
      a: "Geographically, the landmass of China spans five solar time zones, ranging from UTC+5 in far western Xinjiang and Tibet to UTC+9 in eastern Heilongjiang. However, the government unifies all region civil time under UTC+8."
    },
    {
      q: "Does China observe Daylight Saving Time?",
      a: "No. China does not observe Daylight Saving Time (DST). Clocks remain set to UTC+8 year-round."
    },
    {
      q: "Has China ever used Daylight Saving Time?",
      a: "Yes. China experimented with Daylight Saving Time between 1986 and 1991 to conserve electricity. However, due to administrative difficulties and minimal energy savings in a country spanning vast latitudes, the policy was abandoned in 1992."
    },
    {
      q: "What is Xinjiang Time or Urumqi Time?",
      a: "Xinjiang Time (also known as Urumqi Time) is an unofficial local time zone set at UTC+6 (two hours behind Beijing Time). It is used informally by many local residents in the Xinjiang Uyghur Autonomous Region to align daily routines with natural daylight, whereas state agencies, schools, and transportation operate strictly on Beijing Time (UTC+8)."
    },
    {
      q: "What time zones do Hong Kong and Macau use?",
      a: "Hong Kong and Macau both operate at UTC+8 year-round. They are designated in international timezone databases as Hong Kong Time (HKT) and Macau Standard Time (MST), sharing the exact same time as mainland Beijing Time."
    },
    {
      q: "Why did China establish a single national time zone?",
      a: "Following the founding of the People's Republic of China in 1949, Chairman Mao Zedong's government established Beijing Time (UTC+8) as the sole national standard to foster national unity, streamline national administration, and simplify logistics across railway and telecommunication networks."
    },
    {
      q: "What was China's time zone structure before 1949?",
      a: "Prior to 1949, the Republic of China maintained five official time zones established in 1912: Kunlun (UTC+5:30), Sinkiang-Tibet (UTC+6), Kansu-Szechuan (UTC+7), Chungking/Chungyuan (UTC+8), and Changpai (UTC+8:30)."
    },
    {
      q: "What is the time difference between Beijing and New York?",
      a: "During US winter (EST, UTC-5), Beijing (CST, UTC+8) is 13 hours ahead of New York. During US summer (EDT, UTC-4), Beijing is 12 hours ahead of New York."
    },
    {
      q: "What is the time difference between Beijing and London?",
      a: "During UK winter (GMT, UTC+0), Beijing is 8 hours ahead of London. During UK summer (BST, UTC+1), Beijing is 7 hours ahead of London."
    },
    {
      q: "What meridian is used for Beijing Time?",
      a: "Beijing Time is calculated based on the 120° East longitude meridian, which passes through Hangzhou in Zhejiang Province, roughly 150 kilometers south of Shanghai and east of Beijing."
    },
    {
      q: "Which institution maintains official standard time in China?",
      a: "National standard time in China is maintained by the National Time Service Center (NTSC) of the Chinese Academy of Sciences, located in Lintong District, Xi'an, Shaanxi Province."
    },
    {
      q: "What is the solar time difference between western and eastern China?",
      a: "The natural solar time difference between Kashgar in western Xinjiang (75° E) and Fuyuan in eastern Heilongjiang (134° E) is over 4 hours. When it is solar noon in Heilongjiang (around 11:30 a.m. Beijing Time), it is still dark early morning in Xinjiang."
    },
    {
      q: "How do work hours in western China adjust for Beijing Time?",
      a: "Because western cities like Kashgar and Urumqi operate on UTC+8 civil time, official office hours start later in the morning (e.g. 10:00 a.m. or 10:30 a.m. Beijing Time) and extend into the evening (until 19:30 or 20:00 Beijing Time)."
    },
    {
      q: "What is the IANA time zone identifier for mainland China?",
      a: "The primary IANA time zone database identifier for mainland China is `Asia/Shanghai`. Additional regional identifiers include `Asia/Urumqi`, `Asia/Hong_Kong`, and `Asia/Macau`."
    },
    {
      q: "Why is the abbreviation CST sometimes confusing for China?",
      a: "CST stands for China Standard Time (UTC+8), Central Standard Time in North America (UTC-6), and Cuba Standard Time (UTC-5). Developers and schedulers should always specify UTC+8 or `Asia/Shanghai` to eliminate ambiguity."
    },
    {
      q: "What are the trading hours of the Shanghai and Shenzhen Stock Exchanges?",
      a: "The Shanghai Stock Exchange (SSE) and Shenzhen Stock Exchange (SZSE) operate from 09:30 to 11:30 CST (morning session) and 13:00 to 15:00 CST (afternoon session), Monday through Friday."
    },
    {
      q: "What is the time difference between China and Tokyo, Japan?",
      a: "Tokyo (JST, UTC+9) is 1 hour ahead of Beijing (CST, UTC+8) year-round."
    },
    {
      q: "What is the time difference between China and India?",
      a: "China (UTC+8) is 2.5 hours ahead of India (IST, UTC+5:30) year-round."
    },
    {
      q: "How should software developers format timestamps for China?",
      a: "Developers should store data in UTC (`YYYY-MM-DDTHH:MM:SSZ`) and format for display using timezone identifiers like `Asia/Shanghai` or explicit `+08:00` offset."
    }
  ]
};

const pageUrlPath = `${siteUrl}/china-time-zone/`;

const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    "@id": `${pageUrlPath}#article`,
    "mainEntityOfPage": pageUrlPath,
    "headline": seoTitle,
    "description": pageDescription,
    "datePublished": pubDate,
    "dateModified": updatedDate,
    "inLanguage": "en",
    "author": {
      "@type": "Person",
      "name": "Jackie Bruce",
      "jobTitle": "Senior Time Zone Analyst",
      "url": `${siteUrl}/author/jackie-bruce/`
    },
    "publisher": {
      "@type": "Organization",
      "name": "GMT to EST Converter",
      "logo": {
        "@type": "ImageObject",
        "url": `${siteUrl}/logo.svg`
      }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "SpeakableSpecification",
    "cssSelector": [".speakable-headline", ".speakable-summary"]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": `${siteUrl}/`
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "China Time Zone Guide",
        "item": pageUrlPath
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "DefinedTerm",
    "@id": `${siteUrl}/#zone-cst-china`,
    "name": "China Standard Time (CST)",
    "description": "The unified national standard time zone of the People's Republic of China, fixed at UTC+8."
  }
];
---

<BaseLayout
  lang={lang}
  dir={dir}
  title={seoTitle}
  description={pageDescription}
  slug={slug}
  meta={meta}
  mode="gmt-est"
  enableFaqSchema={true}
  enableArticleSchema={true}
  allowAds={true}
  breadcrumbHomeLabel="Home"
  breadcrumbLabel="China Time Zone Guide"
  hreflangCodes={["en"]}
>
  <script type="application/ld+json" set:html={JSON.stringify(schemas)} slot="head" />

  <!-- HERO & SUMMARY SECTION -->
  <section class="hero-banner" aria-labelledby="hero-title">
    <h1 id="hero-title" class="hero-banner-title speakable-headline">
      China Time Zone Guide: <span class="gradient-text">Beijing Time, CST &amp; UTC+8</span>
    </h1>
  </section>

  <div class="editorial-meta-bar" aria-label="Editorial metadata">
    <span>Last Updated: <strong>July 30, 2026</strong></span>
    <span class="separator" aria-hidden="true">•</span>
    <span>Editorially Reviewed by <a href="/author/jackie-bruce/"><strong>Jackie Bruce</strong></a></span>
    <span class="separator" aria-hidden="true">•</span>
    <span>Data Source: <a href="http://www.ntsc.ac.cn" target="_blank" rel="noopener noreferrer"><strong>National Time Service Center (NTSC)</strong></a></span>
  </div>

  <section class="acdt-intro content-section" aria-label="Quick Guide Summary">
    <div class="info-callout speakable-summary" style="background: var(--panel); border-left: 4px solid var(--accent); padding: 1.5rem; margin-bottom: 2rem; border-radius: 6px;">
      <h3 style="margin-top: 0;">Quick Answer: What Time Zone is China In?</h3>
      <p>
        The People's Republic of China observes a single national time zone known officially as <strong>China Standard Time (CST)</strong> or <strong>Beijing Time (北京时间)</strong>, set permanently at <strong>UTC+8</strong>. 
      </p>
      <p>
        Although China's massive geographic expanse spans five natural solar time zones (from UTC+5 to UTC+9), the nation does <strong>not</strong> use multiple regional time zones nor observe Daylight Saving Time. All civil administrative functions, flight schedules, stock markets, and railway networks operate on UTC+8.
      </p>
    </div>

    <div class="reading-meta" style="margin-top: 1rem; color: var(--muted); font-size: 0.9rem;">
      <span>⏱️ Estimated Reading Time: <strong>23 minutes</strong></span>
    </div>
  </section>

  <!-- TABLE OF CONTENTS -->
  <section class="table-of-contents reveal" aria-label="Table of Contents" style="background: var(--panel); padding: 1.5rem; border-radius: 8px; margin: 2rem 0;">
    <span class="toc-kicker" style="font-weight: bold; color: var(--accent); text-transform: uppercase; font-size: 0.85rem;">Detailed Navigation</span>
    <h2 style="margin-top: 0.5rem;">Guide Contents</h2>
    <ol style="line-height: 1.8;">
      <li><a href="#overview-china-time">1. Overview of China Standard Time (Beijing Time)</a></li>
      <li><a href="#five-solar-zones-one-time">2. Five Geographic Solar Zones vs One Civil Time Zone</a></li>
      <li><a href="#xinjiang-time-informal">3. Xinjiang Time (Urumqi Time) Dual-Clock System</a></li>
      <li><a href="#history-pre-1949-zones">4. History of China's Time Zones (Pre-1949 to Present)</a></li>
      <li><a href="#hong-kong-macau-zones">5. Hong Kong Time (HKT) &amp; Macau Time (MST)</a></li>
      <li><a href="#china-vs-world-comparison">6. China vs World Time Zones Comparison Table</a></li>
      <li><a href="#scheduling-china-us-europe">7. Business Overlap: Beijing, New York &amp; London</a></li>
      <li><a href="#developer-guide-cst">8. Developer Guide: Handling `Asia/Shanghai` vs `Asia/Urumqi`</a></li>
      <li><a href="#frequently-asked-questions">9. Frequently Asked Questions (20 FAQs)</a></li>
    </ol>
  </section>

  <!-- SVG DIAGRAM -->
  <section class="content-section" aria-label="China Solar vs Civil Time Zone Diagram">
    <h2>Geographic Solar Zones Unified Under UTC+8</h2>
    <p>
      The diagram below illustrates China's 5 natural solar time zones spanning longitude 73° E to 135° E, unified under the official single national offset of UTC+8 (Beijing Time).
    </p>

    <div class="svg-container" style="width: 100%; overflow-x: auto; text-align: center; margin: 2rem 0;">
      <svg viewBox="0 0 800 320" width="100%" height="auto" xmlns="http://www.w3.org/2000/svg" style="background: var(--panel); border-radius: 8px; padding: 1rem; border: 1px solid var(--line, #333);">
        <text x="400" y="30" fill="currentColor" text-anchor="middle" font-size="18" font-weight="bold">China's 5 Solar Zones vs Official Beijing Time (UTC+8)</text>
        
        <!-- 5 Solar Zones Bar -->
        <g transform="translate(50, 70)">
          <rect x="0" y="0" width="140" height="40" fill="#3b82f6" opacity="0.6" />
          <text x="70" y="25" fill="#fff" text-anchor="middle" font-size="12">Solar UTC+5 (Far West)</text>
          
          <rect x="140" y="0" width="140" height="40" fill="#2563eb" opacity="0.7" />
          <text x="210" y="25" fill="#fff" text-anchor="middle" font-size="12">Solar UTC+6 (Xinjiang)</text>
          
          <rect x="280" y="0" width="140" height="40" fill="#1d4ed8" opacity="0.8" />
          <text x="350" y="25" fill="#fff" text-anchor="middle" font-size="12">Solar UTC+7 (Sichuan)</text>
          
          <rect x="420" y="0" width="140" height="40" fill="#15803d" opacity="0.9" />
          <text x="490" y="25" fill="#fff" text-anchor="middle" font-size="12">Solar UTC+8 (Beijing/East)</text>
          
          <rect x="560" y="0" width="140" height="40" fill="#166534" opacity="0.9" />
          <text x="630" y="25" fill="#fff" text-anchor="middle" font-size="12">Solar UTC+9 (Heilongjiang)</text>
        </g>
        
        <!-- Unified Official Line -->
        <rect x="50" y="140" width="700" height="45" fill="#f59e0b" rx="6" />
        <text x="400" y="168" fill="#000" text-anchor="middle" font-size="16" font-weight="bold">UNIFIED OFFICIAL CIVIL TIME: Beijing Time (UTC+8 Year-Round)</text>
        
        <!-- Explanatory Box -->
        <rect x="50" y="210" width="700" height="80" fill="var(--panel)" stroke="var(--line, #444)" rx="6" />
        <text x="70" y="235" fill="currentColor" font-size="13" font-weight="bold">Key Regional Impact:</text>
        <text x="70" y="255" fill="currentColor" font-size="12">• Western Xinjiang observes informal Xinjiang Time (UTC+6) in daily civilian life</text>
        <text x="70" y="275" fill="currentColor" font-size="12">• Standard meridian 120° E calculated at Hangzhou (NTSC timing station in Xi'an)</text>
      </svg>
    </div>
  </section>

  <!-- SECTION 1 -->
  <section id="overview-china-time" class="content-section">
    <h2>1. Overview of China Standard Time (Beijing Time)</h2>
    <p>
      China Standard Time (CST), officially termed <strong>Beijing Time</strong> (北京时间), is the single standardized civil time for the People's Republic of China. Operating at a fixed offset of <strong>UTC+8</strong>, CST is 8 hours ahead of Coordinated Universal Time.
    </p>
    <p>
      China is the third-largest nation by land area in the world, spanning approximately 5,000 kilometers from east to west. While other geographically expansive nations such as the United States (<a href="/usa-time-zones/">USA Time Zones</a>) and Russia (<a href="/russia-time-zones/">Russia Time Zones</a>) utilize multiple time zones, China operates entirely under one official clock.
    </p>
  </section>

  <!-- SECTION 2 -->
  <section id="five-solar-zones-one-time" class="content-section">
    <h2>2. Five Geographic Solar Zones vs One Civil Time Zone</h2>
    <p>
      Geographically, China spans from longitude 73° E (Pamir Mountains) to 135° E (Amur and Ussuri rivers confluence). In pure astronomical terms, this area naturally encompasses five 15-degree longitude bands:
    </p>
    <ul>
      <li><strong>UTC+5 (75° E):</strong> Far western borders of Xinjiang and Pamir plateau.</li>
      <li><strong>UTC+6 (90° E):</strong> Western Xinjiang, Tibet Autonomous Region.</li>
      <li><strong>UTC+7 (105° E):</strong> Gansu, Sichuan, Yunnan, Chongqing, Shaanxi.</li>
      <li><strong>UTC+8 (120° E):</strong> Beijing, Shanghai, Guangzhou, Tianjin, Shandong, Zhejiang (Standard Meridian).</li>
      <li><strong>UTC+9 (135° E):</strong> Eastern tips of Heilongjiang and Jilin.</li>
    </ul>
    <p>
      Because all of these regions follow UTC+8 civil time, residents in western cities like Kashgar experience solar noon around 03:00 p.m. Beijing Time, and summer sunsets occur after 10:00 p.m.
    </p>
  </section>

  <!-- SECTION 3 -->
  <section id="xinjiang-time-informal" class="content-section">
    <h2>3. Xinjiang Time (Urumqi Time) Dual-Clock System</h2>
    <p>
      In the Xinjiang Uyghur Autonomous Region in far western China, a unique dual-time phenomenon exists:
    </p>
    <ul>
      <li><strong>Beijing Time (UTC+8):</strong> Used officially by government offices, civil aviation, high-speed rail, state banks, and national exams.</li>
      <li><strong>Xinjiang Time / Urumqi Time (UTC+6):</strong> Used informally by ethnic Uyghur populations for daily social interactions, store opening hours, and personal scheduling.</li>
    </ul>
    <p>
      When scheduling appointments in Xinjiang, locals explicitly clarify whether a proposed meeting time is "Beijing Time" or "Xinjiang Time" to prevent two-hour misunderstandings.
    </p>
  </section>

  <!-- SECTION 4 -->
  <section id="history-pre-1949-zones" class="content-section">
    <h2>4. History of China's Time Zones (Pre-1949 to Present)</h2>
    <p>
      In 1912, the Central Observatory of the Republic of China divided the nation into five official time zones:
    </p>
    <ol style="line-height: 1.8;">
      <li><strong>Kunlun Zone (UTC+5:30):</strong> Far western Xinjiang and Tibet.</li>
      <li><strong>Sinkiang-Tibet Zone (UTC+6):</strong> Xinjiang and Qinghai.</li>
      <li><strong>Kansu-Szechuan Zone (UTC+7):</strong> Central provinces including Sichuan and Shaanxi.</li>
      <li><strong>Chungyuan Zone (UTC+8):</strong> Coastal provinces including Beijing, Shanghai, and Nanjing.</li>
      <li><strong>Changpai Zone (UTC+8:30):</strong> Northeastern Manchuria.</li>
    </ol>
    <p>
      In 1949, following the creation of the People's Republic of China, the central government unified all regions under Beijing Time (UTC+8) to foster central coordination and administrative simplicity.
    </p>
  </section>

  <!-- SECTION 5 -->
  <section id="hong-kong-macau-zones" class="content-section">
    <h2>5. Hong Kong Time (HKT) &amp; Macau Time (MST)</h2>
    <p>
      The Special Administrative Regions of Hong Kong and Macau maintain their own designated time zone names within the IANA database:
    </p>
    <ul>
      <li><strong>Hong Kong Time (HKT):</strong> <code>Asia/Hong_Kong</code> (UTC+8).</li>
      <li><strong>Macau Standard Time (MST):</strong> <code>Asia/Macau</code> (UTC+8).</li>
    </ul>
    <p>
      Both regions share the exact same UTC+8 offset as mainland Beijing Time and do not observe Daylight Saving Time.
    </p>
  </section>

  <!-- SECTION 6 -->
  <section id="china-vs-world-comparison" class="content-section">
    <h2>6. China vs World Time Zones Comparison Table</h2>
    <p>
      Compare Beijing Time (CST, UTC+8) with major financial and commercial hubs worldwide:
    </p>
    <table class="data-table" style="width: 100%; border-collapse: collapse; margin: 1.5rem 0;">
      <thead>
        <tr style="background: var(--panel); border-bottom: 2px solid var(--line);">
          <th style="padding: 10px; text-align: left;">City / Country</th>
          <th style="padding: 10px; text-align: left;">Standard Difference vs Beijing</th>
          <th style="padding: 10px; text-align: left;">Summer DST Difference vs Beijing</th>
          <th style="padding: 10px; text-align: left;">Tool / Guide Link</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">New York (US East)</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">New York is 13 hours behind</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">New York is 12 hours behind</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);"><a href="/gmt-to-est/">GMT to EST Converter</a></td>
        </tr>
        <tr>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">London (UK)</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">London is 8 hours behind</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">London is 7 hours behind</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);"><a href="/united-kingdom-time-zone/">UK Time Zone Guide</a></td>
        </tr>
        <tr>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Tokyo (Japan)</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Tokyo is 1 hour ahead</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Tokyo is 1 hour ahead</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);"><a href="/japan-time-zone/">Japan Time Zone Guide</a></td>
        </tr>
        <tr>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">New Delhi (India)</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">India is 2.5 hours behind</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">India is 2.5 hours behind</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);"><a href="/india-time-zone/">India Time Zone Guide</a></td>
        </tr>
        <tr>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Sydney (Australia)</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Sydney is 2 hours ahead</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);">Sydney is 3 hours ahead</td>
          <td style="padding: 10px; border-bottom: 1px solid var(--line);"><a href="/australia-time-zones/">Australia Time Zones</a></td>
        </tr>
      </tbody>
    </table>
  </section>

  <!-- SECTION 7 -->
  <section id="scheduling-china-us-europe" class="content-section">
    <h2>7. Business Overlap: Beijing, New York &amp; London</h2>
    <p>
      Cross-border commerce with Chinese suppliers, manufacturers, and technology centers requires careful time planning:
    </p>
    <ul>
      <li><strong>Beijing to New York Overlap:</strong> 20:00 - 22:00 CST corresponds to 08:00 - 10:00 EDT (US morning / China evening).</li>
      <li><strong>Beijing to London Overlap:</strong> 15:00 - 18:00 CST corresponds to 08:00 - 11:00 BST (London morning / China late afternoon).</li>
    </ul>
  </section>

  <!-- SECTION 8 -->
  <section id="developer-guide-cst" class="content-section">
    <h2>8. Developer Guide: Handling `Asia/Shanghai` vs `Asia/Urumqi`</h2>
    <p>
      Software systems targeting China must follow these timezone handling guidelines:
    </p>
    <ol style="line-height: 1.8;">
      <li><strong>Standard Identifier:</strong> Use <code>Asia/Shanghai</code> for mainland servers and users.</li>
      <li><strong>Xinjiang User Interfaces:</strong> For applications operating specifically within Xinjiang, offering <code>Asia/Urumqi</code> allows local clients to toggle display offsets between UTC+8 and UTC+6.</li>
      <li><strong>Avoid CST Confusion:</strong> Always declare <code>UTC+8</code> or ISO offset string <code>+08:00</code> rather than the ambiguous abbreviation "CST".</li>
    </ol>
  </section>

  <!-- SECTION 9: FAQS -->
  <section id="frequently-asked-questions" class="content-section">
    <h2>9. Frequently Asked Questions</h2>
    <div class="faq-accordion">
      {meta.faqs.map((faq) => (
        <details class="faq-item" style="margin-bottom: 1rem; padding: 1rem; background: var(--panel); border-radius: 6px;">
          <summary style="font-weight: bold; cursor: pointer; font-size: 1.1rem; color: var(--accent);">
            {faq.q}
          </summary>
          <p style="margin-top: 0.8rem; line-height: 1.6;">
            {faq.a}
          </p>
        </details>
      ))}
    </div>
  </section>
</BaseLayout>
