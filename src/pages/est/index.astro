---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import RelatedConvertersWidget from "theme/components/RelatedConvertersWidget.astro";
import UsersAlsoVisitWidget from "theme/components/UsersAlsoVisitWidget.astro";
import LearnMoreWidget from "theme/components/LearnMoreWidget.astro";
import CountryCityWidget from "theme/components/CountryCityWidget.astro";
import { siteUrl } from "theme/i18n/config";

const lang = "en";
const dir = "ltr";
const slug = "est";
const seoTitle = "Eastern Standard Time (EST) – UTC-5 Offset, Cities & Guide";
const pageDescription = "Comprehensive guide to Eastern Standard Time (EST). Explore UTC-5 offset, North American coverage (New York, Toronto, Miami), EST vs EDT seasonal transitions, stock exchange hours, and conversion tables.";

const pubDate = "2026-07-30T10:00:00+05:00";
const updatedDate = "2026-07-30T10:00:00+05:00";

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "EST, Eastern Standard Time, UTC-5, EST offset, EST time zone, EST vs EDT, New York time, Toronto time, EST to GMT, stock market hours EST",
  image: "/assets/est-timezone-guide.webp",
  imageAlt: "Eastern Standard Time (EST) UTC-5 Offset Guide",
  pubDate,
  updatedDate,
  author: "Jackie Bruce",
  faqs: [
    {
      q: "What does EST stand for?",
      a: "EST stands for Eastern Standard Time. It is a standard time offset observed in the eastern region of North America, keeping clocks 5 hours behind Coordinated Universal Time (UTC-5)."
    },
    {
      q: "What is the UTC offset for EST?",
      a: "The UTC offset for Eastern Standard Time (EST) is UTC-5. During standard winter months, local time in the Eastern zone is exactly 5 hours behind Greenwich Mean Time (GMT/UTC)."
    },
    {
      q: "Which major cities observe Eastern Standard Time?",
      a: "Major North American metropolitan areas observing EST during winter include New York City, Washington D.C., Toronto, Montreal, Miami, Atlanta, Boston, Philadelphia, and Pittsburgh. Additionally, Panama and Jamaica observe EST (UTC-5) year-round."
    },
    {
      q: "What is the difference between EST and EDT?",
      a: "EST (Eastern Standard Time) is the standard time offset (UTC-5) observed during autumn and winter months. EDT (Eastern Daylight Time) is daylight saving time (UTC-4) observed during spring and summer months when clocks are set forward by 1 hour."
    },
    {
      q: "When does EST change to EDT?",
      a: "Eastern Standard Time (EST) changes to Eastern Daylight Time (EDT) on the second Sunday of March at 2:00 AM local time, when clocks 'spring forward' by one hour. The transition back to EST occurs on the first Sunday of November at 2:00 AM local time."
    },
    {
      q: "How far behind GMT is EST?",
      a: "EST is 5 hours behind Greenwich Mean Time (GMT/UTC+0). When it is 12:00 PM (noon) GMT in London, it is 7:00 AM EST in New York and Toronto."
    },
    {
      q: "Does Jamaica observe Daylight Saving Time in Eastern Time?",
      a: "No. Jamaica operates on Eastern Standard Time (UTC-5) year-round without daylight saving adjustments. As a result, Jamaica matches New York time in the winter, but runs 1 hour behind New York in the summer when New York shifts to EDT."
    },
    {
      q: "What are the operating hours of the New York Stock Exchange (NYSE) in EST?",
      a: "The New York Stock Exchange (NYSE) and NASDAQ open their regular trading session at 9:30 AM Eastern Time and close at 4:00 PM Eastern Time. These operating hours track local Eastern clock time year-round, adjusting with EDT in summer."
    },
    {
      q: "How do I convert EST to Pacific Standard Time (PST)?",
      a: "Eastern Standard Time (EST, UTC-5) is 3 hours ahead of Pacific Standard Time (PST, UTC-8). To convert EST to PST, subtract 3 hours from EST (e.g., 3:00 PM EST equals 12:00 PM PST)."
    },
    {
      q: "How do I convert EST to Central Standard Time (CST)?",
      a: "Eastern Standard Time (EST, UTC-5) is 1 hour ahead of Central Standard Time (CST, UTC-6). To convert EST to CST, subtract 1 hour (e.g., 10:00 AM EST equals 9:00 AM CST)."
    },
    {
      q: "Which US states are entirely or partially in the Eastern Time Zone?",
      a: "23 US states operate fully or partially within the Eastern Time Zone. States fully in Eastern Time include New York, Pennsylvania, Ohio, North Carolina, South Carolina, Georgia, Virginia, and Massachusetts. States split between Eastern and Central time include Florida, Indiana, Kentucky, Tennessee, and Michigan."
    },
    {
      q: "Which Canadian provinces observe Eastern Standard Time?",
      a: "The Canadian provinces of Ontario, Quebec, and eastern Nunavut observe Eastern Standard Time during winter. Toronto, Ottawa, and Montreal are all located in the Eastern Time zone."
    },
    {
      q: "What is the time difference between EST and Central European Time (CET)?",
      a: "Central European Time (CET, UTC+1) is 6 hours ahead of Eastern Standard Time (EST, UTC-5). When it is 10:00 AM EST in New York, it is 4:00 PM CET in Paris and Berlin."
    },
    {
      q: "What is the time difference between EST and India Standard Time (IST)?",
      a: "India Standard Time (IST, UTC+5:30) is 10 hours and 30 minutes ahead of Eastern Standard Time (EST, UTC-5). When it is 8:00 AM EST in New York, it is 6:30 PM IST in New Delhi and Mumbai."
    },
    {
      q: "What is the time difference between EST and Australian Eastern Standard Time (AEST)?",
      a: "Australian Eastern Standard Time (AEST, UTC+10) is 15 hours ahead of Eastern Standard Time (EST, UTC-5). When it is 7:00 AM EST in New York, it is 10:00 PM AEST in Sydney and Melbourne."
    },
    {
      q: "Why is Eastern Time called the 'anchor' timezone for US broadcasting?",
      a: "Because the majority of the US population resides in the Eastern Time Zone and major television network headquarters are located in New York, US prime-time television broadcasts and sports kickoff times are scheduled around Eastern Time (e.g., '8:00 PM Eastern / 7:00 PM Central')."
    },
    {
      q: "Does Panama use EST?",
      a: "Yes. Panama is geographically positioned in the Eastern Time zone coordinates and observes UTC-5 year-round without Daylight Saving Time adjustments."
    },
    {
      q: "How do automated servers handle EST to EDT clock shifts?",
      a: "To prevent data duplication or execution gaps when clocks spring forward or fall back, enterprise server systems configure database timestamps in UTC and handle conversion to EST/EDT at the display layer."
    },
    {
      q: "Is EST the same as US Eastern Time?",
      a: "EST specifically refers to Eastern Standard Time (UTC-5), which is active during winter. US Eastern Time (ET) is the overarching umbrella term that includes both EST (winter) and EDT (summer)."
    },
    {
      q: "What happens to flight schedules during the transition to EST in November?",
      a: "Airlines publish flight schedules based on local arrival and departure clock times. During the November 'fall back' clock shift, flight reservation systems automatically adjust UTC transit durations so passenger itineraries remain accurate."
    }
  ]
};

const pageUrlPath = `${siteUrl}/${slug}/`;
---

<BaseLayout
  lang={lang}
  dir={dir}
  title={seoTitle}
  description={pageDescription}
  slug={slug}
  meta={meta}
  enableFaqSchema={true}
  enableArticleSchema={true}
  breadcrumbHomeLabel="Home"
  breadcrumbLabel="EST"
>
  <!-- Hero Section -->
  <section class="hero-banner" aria-labelledby="hero-title">
    <h1 id="hero-title" class="hero-banner-title speakable-headline">
      Eastern Standard Time (EST): <span class="gradient-text">UTC-5 Offset & Comprehensive Guide</span>
    </h1>
  </section>

  <!-- Editorial Info Bar -->
  <div class="editorial-meta-bar" aria-label="Editorial metadata">
    <span>Last Updated: <strong>July 30, 2026</strong></span>
    <span class="separator" aria-hidden="true">•</span>
    <span>Editorially Reviewed by <a href="/author/jackie-bruce/"><strong>Jackie Bruce</strong></a></span>
    <span class="separator" aria-hidden="true">•</span>
    <span>Data Source: <a href="https://www.iana.org/time-zones" target="_blank" rel="noopener noreferrer"><strong>IANA Time Zone Database</strong></a></span>
  </div>

  <div class="article-wrapper">
    <!-- Top Answer Summary Box -->
    <div class="summary-box speakable-summary">
      <div class="summary-header">
        <span class="summary-badge">TIME ZONE PROFILE</span>
        <h2>Eastern Standard Time (EST) Summary</h2>
      </div>
      <div class="summary-grid">
        <div class="summary-item">
          <span class="label">UTC Offset:</span>
          <span class="val highlight">UTC-5 (5 hours behind GMT)</span>
        </div>
        <div class="summary-item">
          <span class="label">Active Season:</span>
          <span class="val">November to March (Winter in US/Canada)</span>
        </div>
        <div class="summary-item">
          <span class="label">DST Counterpart:</span>
          <span class="val"><a href="/edt/">EDT (Eastern Daylight Time, UTC-4)</a></span>
        </div>
        <div class="summary-item">
          <span class="label">Major Metros:</span>
          <span class="val"><a href="/new-york-time/">New York</a>, <a href="/toronto-time/">Toronto</a>, Miami, Montreal, D.C.</span>
        </div>
        <div class="summary-item">
          <span class="label">Year-Round Regions:</span>
          <span class="val">Jamaica, Panama, Cayman Islands</span>
        </div>
        <div class="summary-item">
          <span class="label">Financial Center:</span>
          <span class="val">Wall Street / NYSE (09:30 - 16:00 ET)</span>
        </div>
      </div>
      <p class="summary-text">
        <strong>Eastern Standard Time (EST)</strong> is the standard time zone for the eastern coast of North America during autumn and winter, maintaining a fixed offset of <strong>UTC-5</strong>. Covering major commercial hubs including New York City, Toronto, Washington D.C., and Miami, EST is the primary economic reference time for North American stock exchanges and television broadcasting networks.
      </p>
    </div>

    <!-- Table of Contents -->
    <nav class="about-toc" aria-label="Table of Contents">
      <h2>Table of Contents</h2>
      <ul>
        <li><a href="#what-is-est">1. What is Eastern Standard Time (EST)?</a></li>
        <li><a href="#est-vs-edt">2. EST vs. EDT: Seasonal Clock Transitions</a></li>
        <li><a href="#geographic-extent">3. Geographic Extent & Non-DST Exceptions</a></li>
        <li><a href="#stock-markets">4. Wall Street, NYSE & Financial Markets</a></li>
        <li><a href="#conversion-tables">5. Global Time Conversion Tables (GMT, PST, CST, CET, IST)</a></li>
        <li><a href="#broadcasting-and-business">6. Media Broadcasting & Remote Team Operations</a></li>
        <li><a href="#faqs">7. Frequently Asked Questions (20 Detailed Answers)</a></li>
      </ul>
    </nav>

    <!-- Content Sections -->
    <section id="what-is-est" class="content-section">
      <h2>1. What is Eastern Standard Time (EST)?</h2>
      <p>
        <strong>Eastern Standard Time (EST)</strong> is the standard time offset observed across eastern North America during the non-daylight saving months (from early November to mid-March). EST operates exactly <strong>5 hours behind <a href="/utc/">Coordinated Universal Time (UTC-5)</a></strong> and <a href="/gmt/">Greenwich Mean Time (GMT)</a>.
      </p>
      <p>
        The Eastern Time Zone was first established in 1883 by American and Canadian railroads to replace local solar time. In 1918, the US Congress codified Eastern Standard Time into federal law under the Standard Time Act, delegating boundary oversight to the Department of Transportation (DOT).
      </p>
      <p>
        Today, Eastern Standard Time encompasses over 150 million residents in North America, representing the most populated time zone in both the United States and Canada.
      </p>
    </section>

    <!-- SVG Diagram 1: EST vs EDT Seasonal Map -->
    <section class="diagram-section">
      <div class="diagram-card">
        <h3>Figure 1: Eastern Time Annual Cycle (EST ⇄ EDT Shift)</h3>
        <div class="svg-wrapper">
          <svg viewBox="0 0 800 240" width="100%" height="auto" xmlns="http://www.w3.org/2000/svg" aria-label="EST vs EDT Seasonal Transition Diagram">
            <rect width="800" height="240" fill="var(--panel)" rx="12" stroke="var(--line)" stroke-width="1"/>
            
            <!-- Winter Phase Box -->
            <rect x="50" y="50" width="310" height="130" rx="8" fill="rgba(255,255,255,0.03)" stroke="var(--line)" stroke-width="1.5"/>
            <text x="205" y="85" text-anchor="middle" fill="var(--text)" font-family="Space Grotesk, sans-serif" font-weight="bold" font-size="16">WINTER (Nov 1st Sun – Mar 2nd Sun)</text>
            <text x="205" y="120" text-anchor="middle" fill="var(--accent)" font-weight="bold" font-size="22">EST (UTC-5)</text>
            <text x="205" y="150" text-anchor="middle" fill="var(--muted)" font-size="12">Standard Time (Clocks Fall Back)</text>

            <!-- Transition Arrows -->
            <path d="M 375 90 Q 400 70 425 90" fill="none" stroke="var(--accent)" stroke-width="2.5" marker-end="url(#arrow)"/>
            <text x="400" y="60" text-anchor="middle" fill="var(--accent)" font-size="11" font-weight="bold">Spring Forward (+1h) March</text>

            <path d="M 425 140 Q 400 160 375 140" fill="none" stroke="var(--muted)" stroke-width="2.5"/>
            <text x="400" y="180" text-anchor="middle" fill="var(--muted)" font-size="11">Fall Back (-1h) November</text>

            <!-- Summer Phase Box -->
            <rect x="440" y="50" width="310" height="130" rx="8" fill="rgba(255,255,255,0.03)" stroke="var(--accent)" stroke-width="1.5"/>
            <text x="595" y="85" text-anchor="middle" fill="var(--text)" font-family="Space Grotesk, sans-serif" font-weight="bold" font-size="16">SUMMER (Mar 2nd Sun – Nov 1st Sun)</text>
            <text x="595" y="120" text-anchor="middle" fill="var(--accent)" font-weight="bold" font-size="22">EDT (UTC-4)</text>
            <text x="595" y="150" text-anchor="middle" fill="var(--muted)" font-size="12">Daylight Saving Time (Clocks Spring Forward)</text>
          </svg>
        </div>
        <p class="diagram-caption">
          Figure 1: Illustration showing how North America's Eastern region transitions between Eastern Standard Time (EST, UTC-5) in winter and Eastern Daylight Time (EDT, UTC-4) in summer.
        </p>
      </div>
    </section>

    <section id="est-vs-edt" class="content-section">
      <h2>2. EST vs. EDT: Seasonal Clock Transitions</h2>
      <p>
        A frequent point of confusion is the distinction between <strong>EST</strong> and <strong>EDT</strong>. For a full comparison, see our detailed guide on <a href="/est-vs-edt/">EST vs EDT</a>.
      </p>
      <ul>
        <li>
          <strong>EST (Eastern Standard Time):</strong> Represents UTC-5 offset. Active from the first Sunday of November to the second Sunday of March.
        </li>
        <li>
          <strong>EDT (Eastern Daylight Time):</strong> Represents UTC-4 offset. Active from the second Sunday of March to the first Sunday of November.
        </li>
      </ul>
      <p>
        The generic term <strong>Eastern Time (ET)</strong> automatically applies whichever offset is legally active on a given date.
      </p>
    </section>

    <section id="geographic-extent" class="content-section">
      <h2>3. Geographic Extent & Non-DST Exceptions</h2>
      <p>
        The Eastern Time Zone stretches from northern Canada to South America:
      </p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Country / Region</th>
              <th>Specific States / Provinces</th>
              <th>DST Status</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>United States</strong></td>
              <td>23 states including NY, PA, OH, GA, FL (most), MA, VA, NC</td>
              <td>Observes DST (EST winter / EDT summer)</td>
            </tr>
            <tr>
              <td><strong>Canada</strong></td>
              <td>Ontario, Quebec, eastern Nunavut</td>
              <td>Observes DST (EST winter / EDT summer)</td>
            </tr>
            <tr>
              <td><strong>Caribbean Nations</strong></td>
              <td>Bahamas, Haiti</td>
              <td>Observes DST (EST winter / EDT summer)</td>
            </tr>
            <tr>
              <td><strong>Year-Round EST Regions</strong></td>
              <td>Jamaica, Cayman Islands, Panama</td>
              <td>No DST shift (Perpetual UTC-5)</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p>
        For state-by-state rules across North America, review our comprehensive guides on <a href="/usa-time-zones/">USA Time Zones</a> and <a href="/canada-time-zones/">Canada Time Zones</a>.
      </p>
    </section>

    <section id="stock-markets" class="content-section">
      <h2>4. Wall Street, NYSE & Financial Markets</h2>
      <p>
        New York City is the financial capital of the global economy. The <strong>New York Stock Exchange (NYSE)</strong> and <strong>NASDAQ</strong> operate on Eastern Time:
      </p>
      <ul>
        <li><strong>Pre-Market Trading:</strong> 4:00 AM – 9:30 AM EST</li>
        <li><strong>Regular Trading Session:</strong> 9:30 AM – 4:00 PM EST</li>
        <li><strong>After-Hours Trading:</strong> 4:00 PM – 8:00 PM EST</li>
      </ul>
      <p>
        Because trading hours are tied to local clock time, international investors in London, Frankfurt, and Tokyo adjust their market tracking schedules when North America shifts between EST and EDT. Explore our analysis of <a href="/stock-market-opening-times/">Stock Market Opening Times worldwide</a> for full details.
      </p>
    </section>

    <section id="conversion-tables" class="content-section">
      <h2>5. Global Time Conversion Tables (GMT, PST, CST, CET, IST)</h2>
      <p>
        Use the quick reference table below to convert EST (UTC-5) during standard winter hours to major global time zones:
      </p>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>EST (UTC-5)</th>
              <th>GMT / UTC<br/><a href="/gmt-to-est/">EST to GMT</a></th>
              <th>PST (UTC-8)<br/><a href="/est-to-gmt/">EST to PST</a></th>
              <th>CST (UTC-6)<br/><a href="/est-to-gmt/">EST to CST</a></th>
              <th>CET (UTC+1)<br/><a href="/cet-to-est/">EST to CET</a></th>
              <th>IST (UTC+5:30)<br/><a href="/ist-to-est/">EST to IST</a></th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>00:00 EST (Midnight)</td>
              <td>05:00 GMT</td>
              <td>21:00 PST (Prev Day)</td>
              <td>23:00 CST (Prev Day)</td>
              <td>06:00 CET</td>
              <td>10:30 IST</td>
            </tr>
            <tr>
              <td>06:00 EST</td>
              <td>11:00 GMT</td>
              <td>03:00 PST</td>
              <td>05:00 CST</td>
              <td>12:00 CET</td>
              <td>16:30 IST</td>
            </tr>
            <tr>
              <td>09:00 EST</td>
              <td>14:00 GMT</td>
              <td>06:00 PST</td>
              <td>08:00 CST</td>
              <td>15:00 CET</td>
              <td>19:30 IST</td>
            </tr>
            <tr>
              <td>12:00 EST (Noon)</td>
              <td>17:00 GMT</td>
              <td>09:00 PST</td>
              <td>11:00 CST</td>
              <td>18:00 CET</td>
              <td>22:30 IST</td>
            </tr>
            <tr>
              <td>15:00 EST</td>
              <td>20:00 GMT</td>
              <td>12:00 PST</td>
              <td>14:00 CST</td>
              <td>21:00 CET</td>
              <td>01:30 IST (Next Day)</td>
            </tr>
            <tr>
              <td>18:00 EST</td>
              <td>23:00 GMT</td>
              <td>15:00 PST</td>
              <td>17:00 CST</td>
              <td>00:00 CET (Next Day)</td>
              <td>04:30 IST (Next Day)</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p>
        For live, interactive conversion calculations between GMT and EST, try our specialized <a href="/gmt-to-est/">GMT to EST Converter</a>.
      </p>
    </section>

    <!-- SVG Diagram 2: Global Offset Dial -->
    <section class="diagram-section">
      <div class="diagram-card">
        <h3>Figure 2: Relative Hour Offsets Measured from EST (UTC-5 Baseline)</h3>
        <div class="svg-wrapper">
          <svg viewBox="0 0 800 220" width="100%" height="auto" xmlns="http://www.w3.org/2000/svg" aria-label="EST Offset Comparison Wheel">
            <rect width="800" height="220" fill="var(--panel)" rx="12" stroke="var(--line)" stroke-width="1"/>
            
            <!-- EST Center -->
            <circle cx="400" cy="110" r="40" fill="var(--accent)" stroke="#ffffff" stroke-width="3"/>
            <text x="400" y="115" text-anchor="middle" fill="#ffffff" font-family="Space Grotesk, sans-serif" font-weight="bold" font-size="16">EST</text>
            <text x="400" y="170" text-anchor="middle" fill="var(--accent)" font-weight="bold" font-size="13">UTC-5 Baseline</text>

            <!-- PST West -->
            <circle cx="160" cy="110" r="30" fill="var(--panel)" stroke="var(--line)" stroke-width="2"/>
            <text x="160" y="114" text-anchor="middle" fill="var(--text)" font-weight="bold" font-size="13">PST</text>
            <text x="160" y="160" text-anchor="middle" fill="var(--muted)" font-size="11">-3 Hours</text>

            <!-- GMT East -->
            <circle cx="560" cy="110" r="30" fill="var(--panel)" stroke="var(--line)" stroke-width="2"/>
            <text x="560" y="114" text-anchor="middle" fill="var(--text)" font-weight="bold" font-size="13">GMT</text>
            <text x="560" y="160" text-anchor="middle" fill="var(--muted)" font-size="11">+5 Hours</text>

            <!-- IST East -->
            <circle cx="700" cy="110" r="30" fill="var(--panel)" stroke="var(--line)" stroke-width="2"/>
            <text x="700" y="114" text-anchor="middle" fill="var(--text)" font-weight="bold" font-size="13">IST</text>
            <text x="700" y="160" text-anchor="middle" fill="var(--muted)" font-size="11">+10.5 Hours</text>

            <!-- Connecting Lines -->
            <line x1="200" y1="110" x2="350" y2="110" stroke="var(--line)" stroke-width="2"/>
            <line x1="450" y1="110" x2="520" y2="110" stroke="var(--line)" stroke-width="2"/>
            <line x1="600" y1="110" x2="660" y2="110" stroke="var(--line)" stroke-width="2"/>
          </svg>
        </div>
        <p class="diagram-caption">
          Figure 2: Relative time offset spread comparing EST (UTC-5) against PST (-3h), GMT (+5h), and IST (+10.5h).
        </p>
      </div>
    </section>

    <section id="broadcasting-and-business" class="content-section">
      <h2>6. Media Broadcasting & Remote Team Operations</h2>
      <p>
        Because EST covers the financial and media hubs of New York and Atlanta (CNN, NBC, CBS, ABC), prime-time television and national events are announced using Eastern Time. 
      </p>
      <p>
        For distributed software engineering and sales teams, coordinating work between Eastern Time and European hubs requires taking advantage of the morning window (08:00 AM – 12:00 PM EST), which aligns with the European afternoon (01:00 PM – 05:00 PM GMT/CET). Learn how to optimize cross-continental schedules in our guide to <a href="/best-time-us-europe-meetings/">US–Europe Business Meeting Scheduling</a>.
      </p>
    </section>

    <!-- Contextual Widgets Integration -->
    <RelatedConvertersWidget slug={slug} />
    <UsersAlsoVisitWidget slug={slug} />
    <LearnMoreWidget slug={slug} />
    <CountryCityWidget slug={slug} />

    <!-- FAQ Section -->
    <section id="faqs" class="content-section faqs-section">
      <h2>7. Frequently Asked Questions (EST)</h2>
      <div class="faq-list">
        {meta.faqs.map((faq, index) => (
          <details class="faq-item" open={index === 0}>
            <summary class="faq-question">
              <h3>{faq.q}</h3>
            </summary>
            <div class="faq-answer">
              <p>{faq.a}</p>
            </div>
          </details>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .article-wrapper {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 1rem 3rem;
  }
  .hero-banner {
    text-align: center;
    padding: 3rem 1rem 1.5rem;
  }
  .hero-banner-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--text);
  }
  .gradient-text {
    background: linear-gradient(135deg, var(--accent) 0%, #38bdf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .editorial-meta-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--muted);
    margin-bottom: 2rem;
    padding: 0.75rem 1rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
  }
  .editorial-meta-bar a {
    color: var(--accent);
    text-decoration: none;
