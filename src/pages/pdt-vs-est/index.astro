---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import { getTranslation, pageUrl, siteUrl } from "theme/i18n/config";

const lang = "en";
const dir = "ltr";
const slug = "pdt-vs-est";
const t = getTranslation(lang);

const pageTitle = "PDT vs EST Time Zone Comparison";
const seoTitle = "PDT vs EST – Time Difference, Offsets, & Meeting Guide";
const pageDescription = "Comprehensive breakdown of PDT vs EST. Understand the time difference between Pacific Daylight Time (UTC-7) and Eastern Standard Time (UTC-5 / UTC-4 EDT), stock market hours, and transcontinental scheduling.";

const canonical = `${siteUrl}/pdt-vs-est/`;

const faqs = [
  {
    q: "What is the time difference between PDT and EST?",
    a: "Pacific Daylight Time (PDT, UTC-7) is 2 hours behind Eastern Standard Time (EST, UTC-5). However, during summer when Eastern states observe Eastern Daylight Time (EDT, UTC-4), PDT is 3 hours behind EDT."
  },
  {
    q: "What is 9 AM PDT in Eastern Time?",
    a: "9:00 AM PDT converts to 12:00 PM (Noon) EDT (or 11:00 AM EST in winter)."
  },
  {
    q: "How do Silicon Valley and Wall Street synchronize working hours?",
    a: "Because of the 3-hour summer gap, major cross-coastal meetings are scheduled between 9:00 AM PDT (12:00 PM EDT) and 2:00 PM PDT (5:00 PM EDT)."
  }
];

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "PDT vs EST, Pacific Daylight Time vs Eastern Standard Time, PDT vs EST time difference, UTC-7 vs UTC-5, Los Angeles to New York time, 3 hour time gap",
  image: "/assets/gmt-to-est-timeflow-hero.png",
  imageAlt: "PDT vs EST Time Zone Comparison",
  faqs
};
---

<BaseLayout
  lang={lang}
  dir={dir}
  title={seoTitle}
  description={pageDescription}
  slug={slug}
  meta={meta}
  mode="gmt-est"
  enableFaqSchema={true}
  allowAds={true}
  breadcrumbHomeLabel="Home"
  breadcrumbLabel="PDT vs EST"
  hreflangCodes={["en"]}
>
  <header class="hero-banner">
    <div class="hero-content">
      <span class="eyebrow">Time Zone Technical Comparison</span>
      <h1 class="hero-banner-title">PDT vs EST <span class="gradient-text">Comparison</span></h1>
      <p class="hero-subtitle">
        An in-depth technical analysis comparing Pacific Daylight Time (UTC-7) and Eastern Standard Time / Daylight Time, stock trading hours, and transcontinental remote work protocols.
      </p>
    </div>
  </header>

  <div style="max-width: 900px; margin: 0 auto; padding: 2rem 16px;">
    <!-- AI OVERVIEW SUMMARY BOX -->
    <aside style="background: var(--panel); border: 1px solid var(--accent); border-radius: 10px; padding: 1.25rem; margin-bottom: 2rem;">
      <div style="font-weight: 700; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--accent); margin-bottom: 0.5rem; display: flex; align-items: center; gap: 6px;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        Key AI Summary: PDT vs EST
      </div>
      <ul style="margin: 0; padding-left: 1.25rem; color: var(--text); font-size: 0.95rem; line-height: 1.6;">
        <li><strong>Time Offset Gap:</strong> PDT operates at UTC-7, while EST operates at UTC-5 (2 hours difference) and EDT operates at UTC-4 (3 hours difference).</li>
        <li><strong>Wall Street Trading:</strong> NYSE/NASDAQ open at 9:30 AM EDT = 6:30 AM PDT on the US West Coast.</li>
        <li><strong>Golden Meeting Window:</strong> 9:30 AM PDT to 2:00 PM PDT (12:30 PM EDT to 5:00 PM EDT).</li>
      </ul>
    </aside>

    <section class="content-section">
      <h2>Analyzing the PDT to EST Offset Shift</h2>
      <p>
        During summer months (mid-March to early November), the US Pacific coast switches to Pacific Daylight Time (PDT, UTC-7). Meanwhile, the US East Coast switches to Eastern Daylight Time (EDT, UTC-4). Throughout this entire summer period, Eastern Time remains <strong>exactly 3 hours ahead of Pacific Time</strong>.
      </p>
    </section>

    <section class="content-section">
      <h2>Quick Reference Conversion Table</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Pacific Daylight Time (PDT, UTC-7)</th>
              <th>Eastern Time Equivalent (EDT, UTC-4)</th>
              <th>Business Alignment Context</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>6:30 AM PDT</td><td>9:30 AM EDT</td><td>Wall Street market opening bell (NYSE / NASDAQ)</td></tr>
            <tr><td>8:00 AM PDT</td><td>11:00 AM EDT</td><td>West Coast office arrival &amp; East Coast mid-morning</td></tr>
            <tr><td>9:00 AM PDT</td><td>12:00 PM (Noon) EDT</td><td>Transcontinental golden meeting window opens</td></tr>
            <tr><td>1:00 PM PDT</td><td>4:00 PM EDT</td><td>US stock exchange closing bell &amp; East Coast afternoon wrap</td></tr>
            <tr><td>2:00 PM PDT</td><td>5:00 PM EDT</td><td>East Coast office close / West Coast afternoon focus</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="content-section">
      <h2>Related Converters &amp; Guides</h2>
      <ul style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px; list-style: none; padding: 0;">
        <li><a href="/pdt-to-est/" style="padding: 10px; background: var(--panel); border: 1px solid var(--line); border-radius: 8px; text-decoration: none; display: block; text-align: center;">PDT to EST Converter</a></li>
        <li><a href="/est-to-pst/" style="padding: 10px; background: var(--panel); border: 1px solid var(--line); border-radius: 8px; text-decoration: none; display: block; text-align: center;">EST to PST Converter</a></li>
        <li><a href="/cst-vs-est/" style="padding: 10px; background: var(--panel); border: 1px solid var(--line); border-radius: 8px; text-decoration: none; display: block; text-align: center;">CST vs EST Guide</a></li>
        <li><a href="/time-zone-guide/" style="padding: 10px; background: var(--panel); border: 1px solid var(--line); border-radius: 8px; text-decoration: none; display: block; text-align: center;">Time Zone Guide</a></li>
      </ul>
    </section>

    <!-- FAQ SECTION -->
    <section class="faq-section content-section" id="faq" aria-labelledby="faq-heading">
      <h2 id="faq-heading">Frequently Asked Questions</h2>
      <div class="faq-grid">
        {faqs.map((item) => (
          <details class="faq-item">
            <summary class="faq-question"><strong>{item.q}</strong></summary>
            <div class="faq-answer"><p>{item.a}</p></div>
          </details>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
