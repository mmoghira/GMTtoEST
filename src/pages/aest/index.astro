---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import RelatedConvertersWidget from "theme/components/RelatedConvertersWidget.astro";
import UsersAlsoVisitWidget from "theme/components/UsersAlsoVisitWidget.astro";
import LearnMoreWidget from "theme/components/LearnMoreWidget.astro";
import CountryCityWidget from "theme/components/CountryCityWidget.astro";
import { siteUrl } from "theme/i18n/config";

const lang = "en";
const dir = "ltr";
const slug = "aest";
const seoTitle = "Australian Eastern Standard Time (AEST) – UTC+10 Offset & Guide";
const pageDescription = "Comprehensive guide to Australian Eastern Standard Time (AEST). Explore UTC+10 offset, state-by-state DST rules (Sydney/Melbourne shift to AEDT vs Brisbane staying AEST), and conversion tables.";

const pubDate = "2026-07-30T10:00:00+05:00";
const updatedDate = "2026-07-30T10:00:00+05:00";

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "AEST, Australian Eastern Standard Time, UTC+10, AEST offset, AEST time zone, AEST vs AEDT, Sydney time, Melbourne time, Brisbane time, AEST to EST, AEST to GMT",
  image: "/assets/aest-timezone-guide.webp",
  imageAlt: "Australian Eastern Standard Time (AEST) UTC+10 Offset Guide",
  pubDate,
  updatedDate,
  author: "Jackie Bruce",
  faqs: [
    {
      q: "What does AEST stand for?",
      a: "AEST stands for Australian Eastern Standard Time. It is the standard time offset (UTC+10) observed along the eastern coast of Australia."
    },
    {
      q: "What is the UTC offset for AEST?",
      a: "The UTC offset for Australian Eastern Standard Time (AEST) is UTC+10. Local clock time in the AEST zone is exactly 10 hours ahead of Greenwich Mean Time (GMT) and Coordinated Universal Time (UTC)."
    },
    {
      q: "Which major Australian cities observe AEST?",
      a: "Major cities located in the AEST zone include Sydney, Melbourne, Brisbane, Canberra (ACT), Hobart, and Gold Coast."
    },
    {
      q: "What is the difference between AEST and AEDT?",
      a: "AEST (Australian Eastern Standard Time) is UTC+10, active during the southern hemisphere winter. AEDT (Australian Eastern Daylight Time) is UTC+11, active during the southern hemisphere summer in participating states."
    },
    {
      q: "Does Queensland observe Daylight Saving Time in AEST?",
      a: "No. The state of Queensland (including Brisbane, Gold Coast, and Cairns) observes AEST (UTC+10) year-round without daylight saving adjustments."
    },
    {
      q: "Which Australian states switch from AEST to AEDT in summer?",
      a: "New South Wales (Sydney), Victoria (Melbourne), Tasmania (Hobart), and the Australian Capital Territory (Canberra) switch to AEDT (UTC+11) from early October to early April."
    },
    {
      q: "When does Daylight Saving Time begin and end in Australia?",
      a: "In participating southern Australian states, Daylight Saving Time (AEDT, UTC+11) begins on the first Sunday of October at 2:00 AM AEST and ends on the first Sunday of April at 3:00 AM AEDT."
    },
    {
      q: "How far ahead of Greenwich Mean Time (GMT) is AEST?",
      a: "AEST (UTC+10) is 10 hours ahead of Greenwich Mean Time (GMT, UTC+0). When it is 8:00 AM GMT in London, it is 6:00 PM AEST in Brisbane, Sydney, and Melbourne."
    },
    {
      q: "How far ahead of US Eastern Standard Time (EST) is AEST?",
      a: "AEST (UTC+10) is 15 hours ahead of US Eastern Standard Time (EST, UTC-5). When it is 7:00 AM EST in New York, it is 10:00 PM AEST in Sydney."
    },
    {
      q: "How do I convert AEST to US Pacific Standard Time (PST)?",
      a: "Australian Eastern Standard Time (AEST, UTC+10) is 18 hours ahead of Pacific Standard Time (PST, UTC-8). When it is 10:00 AM AEST in Sydney, it is 4:00 PM the previous day PST in Los Angeles."
    },
    {
      q: "What is the time difference between AEST and India Standard Time (IST)?",
      a: "Australian Eastern Standard Time (AEST, UTC+10) is 4 hours and 30 minutes ahead of India Standard Time (IST, UTC+5:30). When it is 4:30 PM AEST in Sydney, it is 12:00 PM (noon) IST in New Delhi."
    },
    {
      q: "What is the time difference between AEST and Central European Time (CET)?",
      a: "AEST (UTC+10) is 9 hours ahead of Central European Time (CET, UTC+1). When it is 6:00 PM AEST in Sydney, it is 9:00 AM CET in Paris and Berlin."
    },
    {
      q: "What are the trading hours of the Australian Securities Exchange (ASX)?",
      a: "The Australian Securities Exchange (ASX) in Sydney opens for equity trading at 10:00 AM local Eastern Time (AEST/AEDT) and closes at 4:00 PM local Eastern Time."
    },
    {
      q: "Why is the Australian market important for global financial traders?",
      a: "Because of its eastern geographical location, the Sydney stock market is one of the first major financial centers in the world to open each calendar day, establishing early direction for Asian trading sessions."
    },
    {
      q: "How do border towns like Coolangatta and Tweed Heads handle the summer AEST/AEDT split?",
      a: "Coolangatta (Queensland, AEST UTC+10) and Tweed Heads (New South Wales, AEDT UTC+11) sit directly on the state border. During summer, stepping across the street moves your clock forward or back by 1 hour, earning it the nickname 'the one-hour street.'"
    },
    {
      q: "What is the time difference between AEST and Lord Howe Island?",
      a: "Lord Howe Island operates on Lord Howe Standard Time (LHST, UTC+10:30) in winter and advances by just 30 minutes to UTC+11 in summer, making it one of the rare half-hour DST zones."
    },
    {
      q: "How do remote teams schedule meetings between US West Coast and AEST?",
      a: "Because AEST is 18 hours ahead of PST, virtual teams hold cross-continental syncs late afternoon US time (4:00 PM PST), which corresponds to mid-morning the next calendar day in Sydney (10:00 AM AEST next day)."
    },
    {
      q: "What is the time difference between AEST and New Zealand Standard Time (NZST)?",
      a: "New Zealand Standard Time (NZST, UTC+12) is 2 hours ahead of Australian Eastern Standard Time (AEST, UTC+10)."
    },
    {
      q: "How do airlines manage domestic flights between Brisbane and Sydney during summer?",
      a: "Flight schedules display local wall-clock departure and arrival times. Flight durations between Brisbane and Sydney account for the 1-hour time jump when traveling south during summer."
    },
    {
      q: "How is AEST configured in software servers?",
      a: "Developers avoid ambiguous acronyms like 'AEST' and configure server timezone libraries with IANA identifiers such as `Australia/Sydney` or `Australia/Brisbane`."
    }
  ]
};

const pageUrlPath = `${siteUrl}/${slug}/`;
---

<BaseLayout
  lang={lang}
  dir={dir}
  title={seoTitle}
  description={pageDescription}
  slug={slug}
  meta={meta}
  enableFaqSchema={true}
  enableArticleSchema={true}
  breadcrumbHomeLabel="Home"
  breadcrumbLabel="AEST"
>
  <!-- Hero Section -->
  <section class="hero-banner" aria-labelledby="hero-title">
    <h1 id="hero-title" class="hero-banner-title speakable-headline">
      Australian Eastern Standard Time (AEST): <span class="gradient-text">UTC+10 Offset & Guide</span>
    </h1>
  </section>

  <!-- Editorial Info Bar -->
  <div class="editorial-meta-bar" aria-label="Editorial metadata">
    <span>Last Updated: <strong>July 30, 2026</strong></span>
    <span class="separator" aria-hidden="true">•</span>
    <span>Editorially Reviewed by <a href="/author/jackie-bruce/"><strong>Jackie Bruce</strong></a></span>
    <span class="separator" aria-hidden="true">•</span>
    <span>Data Source: <a href="https://www.australia.gov.au/about-australia/facts-and-figures/time-zones-and-daylight-saving" target="_blank" rel="noopener noreferrer"><strong>Australian Government Time Zone Registry</strong></a></span>
  </div>

  <div class="article-wrapper">
    <!-- Top Answer Summary Box -->
    <div class="summary-box speakable-summary">
      <div class="summary-header">
        <span class="summary-badge">TIME ZONE PROFILE</span>
        <h2>Australian Eastern Standard Time (AEST) Summary</h2>
      </div>
      <div class="summary-grid">
        <div class="summary-item">
          <span class="label">UTC Offset:</span>
          <span class="val highlight">UTC+10 (10 hours ahead of GMT)</span>
        </div>
        <div class="summary-item">
          <span class="label">Active Window:</span>
          <span class="val">April to October (Southern Winter)</span>
        </div>
        <div class="summary-item">
          <span class="label">DST Counterpart:</span>
          <span class="val">AEDT (Australian Eastern Daylight Time, UTC+11)</span>
        </div>
        <div class="summary-item">
          <span class="label">Major Metros:</span>
          <span class="val"><a href="/sydney-time/">Sydney</a>, Melbourne, Brisbane, Canberra, Hobart</span>
        </div>
        <div class="summary-item">
          <span class="label">Queensland Status:</span>
          <span class="val">Brisbane stays on AEST (UTC+10) year-round</span>
        </div>
        <div class="summary-item">
          <span class="label">Time Diff to EST:</span>
          <span class="val">AEST is 15 hours ahead of <a href="/est/">EST (UTC-5)</a></span>
        </div>
      </div>
      <p class="summary-text">
        <strong>Australian Eastern Standard Time (AEST)</strong> is the standard time zone covering the eastern seaboard of Australia. Operating at <strong>UTC+10</strong>, AEST is 10 hours ahead of <a href="/gmt/">Greenwich Mean Time (GMT)</a> and 15 hours ahead of US Eastern Standard Time (<a href="/est/">EST</a>). While Queensland remains on AEST year-round, southern states (NSW, Victoria, Tasmania, ACT) advance to AEDT (UTC+11) during the southern summer.
      </p>
    </div>

    <!-- Table of Contents -->
    <nav class="about-toc" aria-label="Table of Contents">
      <h2>Table of Contents</h2>
      <ul>
        <li><a href="#what-is-aest">1. What is Australian Eastern Standard Time (AEST)?</a></li>
        <li><a href="#aest-vs-aedt">2. AEST vs. AEDT: State-by-State Daylight Saving Split</a></li>
        <li><a href="#transition-calendar">3. Southern Hemisphere DST Transition Schedule</a></li>
        <li><a href="#geographic-extent">4. State Breakdown Across Eastern Australia</a></li>
        <li><a href="#conversion-tables">5. Global AEST Time Conversion Tables (GMT, EST, PST, IST)</a></li>
        <li><a href="#financial-markets">6. Australian Securities Exchange (ASX) & APAC Opening Bell</a></li>
        <li><a href="#faqs">7. Frequently Asked Questions (20 Detailed Answers)</a></li>
      </ul>
    </nav>

    <!-- Content Sections -->
    <section id="what-is-aest" class="content-section">
      <h2>1. What is Australian Eastern Standard Time (AEST)?</h2>
      <p>
        <strong>Australian Eastern Standard Time (AEST)</strong> is the primary standard time zone for eastern Australia. Operating at <strong>UTC+10</strong> (10 hours ahead of <a href="/utc/">Coordinated Universal Time</a> and <a href="/gmt/">Greenwich Mean Time</a>), AEST encompasses over 80% of Australia's total population.
      </p>
      <p>
        Standardized under state acts in 1895, AEST covers Australia's premier financial and cultural centers, including Sydney, Melbourne, Brisbane, Canberra, and Hobart.
      </p>
    </section>

    <!-- SVG Diagram 1: Australian DST State Split -->
    <section class="diagram-section">
      <div class="diagram-card">
        <h3>Figure 1: Australian Summer Daylight Saving State Split</h3>
        <div class="svg-wrapper">
          <svg viewBox="0 0 800 240" width="100%" height="auto" xmlns="http://www.w3.org/2000/svg" aria-label="Australian Summer DST Split Diagram">
            <rect width="800" height="240" fill="var(--panel)" rx="12" stroke="var(--line)" stroke-width="1"/>
            
            <!-- Queensland Box (No DST) -->
            <rect x="60" y="50" width="310" height="130" rx="8" fill="rgba(255,255,255,0.03)" stroke="var(--line)" stroke-width="1.5"/>
            <text x="215" y="85" text-anchor="middle" fill="var(--text)" font-family="Space Grotesk, sans-serif" font-weight="bold" font-size="16">QUEENSLAND (Year-Round)</text>
            <text x="215" y="120" text-anchor="middle" fill="var(--accent)" font-weight="bold" font-size="24">AEST (UTC+10)</text>
            <text x="215" y="150" text-anchor="middle" fill="var(--muted)" font-size="12">Brisbane / Gold Coast (No DST Shift)</text>

            <!-- Versus Line -->
            <text x="400" y="125" text-anchor="middle" fill="var(--muted)" font-family="Space Grotesk, sans-serif" font-weight="bold" font-size="20">vs</text>

            <!-- Southern States Box (DST Active) -->
            <rect x="430" y="50" width="310" height="130" rx="8" fill="rgba(255,255,255,0.03)" stroke="var(--accent)" stroke-width="2"/>
            <text x="585" y="85" text-anchor="middle" fill="var(--accent)" font-family="Space Grotesk, sans-serif" font-weight="bold" font-size="16">NSW / VIC / TAS / ACT (Summer)</text>
            <text x="585" y="120" text-anchor="middle" fill="#ffffff" font-weight="bold" font-size="24">AEDT (UTC+11)</text>
            <text x="585" y="150" text-anchor="middle" fill="var(--muted)" font-size="12">Sydney / Melbourne / Hobart (Oct–April)</text>
          </svg>
        </div>
        <p class="diagram-caption">
          Figure 1: Illustration showing Australia's eastern time split during summer, where Queensland stays on AEST (UTC+10) while southern states shift to AEDT (UTC+11).
        </p>
      </div>
    </section>

    <section id="aest-vs-aedt" class="content-section">
      <h2>2. AEST vs. AEDT: State-by-State Daylight Saving Split</h2>
      <p>
        During the southern hemisphere summer (October to April), Australia's eastern seaboard splits into two separate time offsets:
      </p>
      <ul>
        <li><strong>AEST (UTC+10):</strong> Maintained year-round in Queensland (Brisbane). No clocks change.</li>
        <li><strong>AEDT (UTC+11):</strong> Observed in New South Wales (Sydney), Victoria (Melbourne), Tasmania (Hobart), and the ACT (Canberra). Clocks advance by 1 hour.</li>
      </ul>
      <p>
        For broader context on Australian time zone rules, visit our guide on <a href="/australia-time-zones/">Australia Time Zones</a>.
      </p>
    </section>

    <section id="transition-calendar" class="content-section">
      <h2>3. Southern Hemisphere DST Transition Schedule</h2>
      <p>
        Because Australia is in the Southern Hemisphere, its daylight saving seasons are reversed relative to North America and Europe:
      </p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Transition Event</th>
              <th>Date & Clock Rule</th>
              <th>Clock Shift</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Spring Shift (AEST → AEDT)</strong></td>
              <td>First Sunday of October at 2:00 AM AEST</td>
              <td>Clocks jump from 2:00 AM to 3:00 AM AEDT (+1 hour)</td>
            </tr>
            <tr>
              <td><strong>Autumn Shift (AEDT → AEST)</strong></td>
              <td>First Sunday of April at 3:00 AM AEDT</td>
              <td>Clocks fall back from 3:00 AM to 2:00 AM AEST (-1 hour)</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section id="geographic-extent" class="content-section">
      <h2>4. State Breakdown Across Eastern Australia</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>State / Territory</th>
              <th>Capital City</th>
              <th>Summer DST Status</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>New South Wales</strong></td>
              <td><a href="/sydney-time/">Sydney</a></td>
              <td>Shifts to AEDT (UTC+11)</td>
            </tr>
            <tr>
              <td><strong>Victoria</strong></td>
              <td>Melbourne</td>
              <td>Shifts to AEDT (UTC+11)</td>
            </tr>
            <tr>
              <td><strong>Queensland</strong></td>
              <td>Brisbane</td>
              <td>Remains on AEST (UTC+10) year-round</td>
            </tr>
            <tr>
              <td><strong>Australian Capital Territory</strong></td>
              <td>Canberra</td>
              <td>Shifts to AEDT (UTC+11)</td>
            </tr>
            <tr>
              <td><strong>Tasmania</strong></td>
              <td>Hobart</td>
              <td>Shifts to AEDT (UTC+11)</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section id="conversion-tables" class="content-section">
      <h2>5. Global AEST Time Conversion Tables (GMT, EST, PST, IST)</h2>
      <p>
        Convert Australian Eastern Standard Time (AEST, UTC+10) to major global time zones:
      </p>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>AEST (UTC+10)</th>
              <th>GMT (UTC+0)<br/><a href="/gmt-to-aest/">AEST to GMT</a></th>
              <th>EST (UTC-5)<br/><a href="/aest-to-est/">AEST to EST</a></th>
              <th>EDT (UTC-4)<br/><a href="/aest-to-est/">AEST to EDT</a></th>
              <th>PST (UTC-8)<br/><a href="/gmt-to-pst/">AEST to PST</a></th>
              <th>IST (UTC+5:30)<br/><a href="/ist-to-est/">AEST to IST</a></th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>00:00 AEST (Midnight)</td>
              <td>14:00 (Prev Day)</td>
              <td>09:00 (Prev Day)</td>
              <td>10:00 (Prev Day)</td>
              <td>06:00 (Prev Day)</td>
              <td>19:30 (Prev Day)</td>
            </tr>
            <tr>
              <td>06:00 AEST</td>
              <td>20:00 (Prev Day)</td>
              <td>15:00 (Prev Day)</td>
              <td>16:00 (Prev Day)</td>
              <td>12:00 (Prev Day)</td>
              <td>01:30</td>
            </tr>
            <tr>
              <td>09:00 AEST</td>
              <td>23:00 (Prev Day)</td>
              <td>18:00 (Prev Day)</td>
              <td>19:00 (Prev Day)</td>
              <td>15:00 (Prev Day)</td>
              <td>04:30</td>
            </tr>
            <tr>
              <td>12:00 AEST (Noon)</td>
              <td>02:00</td>
              <td>21:00 (Prev Day)</td>
              <td>22:00 (Prev Day)</td>
              <td>18:00 (Prev Day)</td>
              <td>07:30</td>
            </tr>
            <tr>
              <td>15:00 AEST</td>
              <td>05:00</td>
              <td>00:00</td>
              <td>01:00</td>
              <td>21:00 (Prev Day)</td>
              <td>10:30</td>
            </tr>
            <tr>
              <td>18:00 AEST</td>
              <td>08:00</td>
              <td>03:00</td>
              <td>04:00</td>
              <td>00:00</td>
              <td>13:30</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p>
        For live, interactive conversion calculation, use our <a href="/aest-to-est/">AEST to EST Converter</a>.
      </p>
    </section>

    <!-- SVG Diagram 2: AEST Relational Offset Dial -->
    <section class="diagram-section">
      <div class="diagram-card">
        <h3>Figure 2: AEST (UTC+10) Relational Offset Dial</h3>
        <div class="svg-wrapper">
          <svg viewBox="0 0 800 220" width="100%" height="auto" xmlns="http://www.w3.org/2000/svg" aria-label="AEST Relational Offset Dial">
            <rect width="800" height="220" fill="var(--panel)" rx="12" stroke="var(--line)" stroke-width="1"/>
            
            <circle cx="650" cy="110" r="38" fill="var(--accent)" stroke="#ffffff" stroke-width="2.5"/>
            <text x="650" y="115" text-anchor="middle" fill="#ffffff" font-family="Space Grotesk, sans-serif" font-weight="bold" font-size="16">AEST</text>
            <text x="650" y="165" text-anchor="middle" fill="var(--accent)" font-weight="bold" font-size="12">UTC+10 Baseline</text>

            <circle cx="150" cy="110" r="30" fill="var(--panel)" stroke="var(--line)" stroke-width="2"/>
            <text x="150" y="114" text-anchor="middle" fill="var(--text)" font-weight="bold" font-size="13">EST</text>
            <text x="150" y="160" text-anchor="middle" fill="var(--muted)" font-size="11">-15 Hours</text>

            <circle cx="380" cy="110" r="30" fill="var(--panel)" stroke="var(--line)" stroke-width="2"/>
            <text x="380" y="114" text-anchor="middle" fill="var(--text)" font-weight="bold" font-size="13">GMT</text>
            <text x="380" y="160" text-anchor="middle" fill="var(--muted)" font-size="11">-10 Hours</text>

            <line x1="180" y1="110" x2="350" y2="110" stroke="var(--line)" stroke-width="2"/>
            <line x1="410" y1="110" x2="612" y2="110" stroke="var(--line)" stroke-width="2"/>
          </svg>
        </div>
        <p class="diagram-caption">
          Figure 2: Relative time offset dial placing AEST (+10h) relative to GMT (-10h) and US Eastern Standard Time (-15h).
        </p>
      </div>
    </section>

    <section id="financial-markets" class="content-section">
      <h2>6. Australian Securities Exchange (ASX) & APAC Opening Bell</h2>
      <p>
        The <strong>Australian Securities Exchange (ASX)</strong> opens trading at 10:00 AM local Eastern Time (AEST/AEDT) and closes at 4:00 PM. Because Sydney is positioned near the International Date Line, the ASX is among the earliest major stock exchanges in the world to open each business day, establishing market sentiment for the wider Asia-Pacific region.
      </p>
    </section>

    <!-- Contextual Widgets Integration -->
    <RelatedConvertersWidget slug={slug} />
    <UsersAlsoVisitWidget slug={slug} />
    <LearnMoreWidget slug={slug} />
    <CountryCityWidget slug={slug} />

    <!-- FAQ Section -->
    <section id="faqs" class="content-section faqs-section">
      <h2>7. Frequently Asked Questions (AEST)</h2>
      <div class="faq-list">
        {meta.faqs.map((faq, index) => (
          <details class="faq-item" open={index === 0}>
            <summary class="faq-question">
              <h3>{faq.q}</h3>
            </summary>
            <div class="faq-answer">
              <p>{faq.a}</p>
            </div>
          </details>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .article-wrapper {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 1rem 3rem;
  }
  .hero-banner {
    text-align: center;
    padding: 3rem 1rem 1.5rem;
  }
  .hero-banner-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--text);
  }
  .gradient-text {
    background: linear-gradient(135deg, var(--accent) 0%, #38bdf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .editorial-meta-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--muted);
    margin-bottom: 2rem;
    padding: 0.75rem 1rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
  }
  .editorial-meta-bar a {
    color: var(--accent);
    text-decoration: none;
  }
  .separator {
    opacity: 0.5;
  }
  .summary-box {
    background: var(--panel);
    border: 1px solid var(--accent);
    border-radius: 12px;
    padding: 1.75rem;
    margin-bottom: 2.5rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.15);
  }
  .summary-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }
  .summary-badge {
    background: var(--accent);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    letter-spacing: 0.05em;
  }
  .summary-header h2 {
    font-size: 1.35rem;
    margin: 0;
    color: var(--text);
  }
  .summary-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
    margin-bottom: 1.25rem;
  }
  .summary-item {
    background: rgba(255,255,255,0.03);
    padding: 0.75rem 1rem;
    border-radius: 6px;
    border: 1px solid var(--line);
