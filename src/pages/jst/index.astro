---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import RelatedConvertersWidget from "theme/components/RelatedConvertersWidget.astro";
import UsersAlsoVisitWidget from "theme/components/UsersAlsoVisitWidget.astro";
import LearnMoreWidget from "theme/components/LearnMoreWidget.astro";
import CountryCityWidget from "theme/components/CountryCityWidget.astro";
import { siteUrl } from "theme/i18n/config";

const lang = "en";
const dir = "ltr";
const slug = "jst";
const seoTitle = "Japan Standard Time (JST) – UTC+9 Offset, Tokyo Time & Guide";
const pageDescription = "Comprehensive guide to Japan Standard Time (JST). Learn UTC+9 offset, Akashi 135°E meridian, why Japan does not observe Daylight Saving Time, and world conversion tables.";

const pubDate = "2026-07-30T10:00:00+05:00";
const updatedDate = "2026-07-30T10:00:00+05:00";

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "JST, Japan Standard Time, UTC+9, JST offset, JST time zone, Tokyo time, JST to EST, JST to GMT, JST to PST, Akashi meridian, Japan time guide",
  image: "/assets/japan-standard-time-jst-utc-plus-9.webp",
  imageAlt: "Japan Standard Time (JST) UTC+9 Offset Guide",
  pubDate,
  updatedDate,
  author: "Jackie Bruce",
  faqs: [
    {
      q: "What does JST stand for?",
      a: "JST stands for Japan Standard Time (日本標準時, Nihon Hyōjunji). It is the official standard time observed throughout Japan, operating at a constant offset of UTC+9."
    },
    {
      q: "What is the UTC offset for Japan Standard Time (JST)?",
      a: "The UTC offset for Japan Standard Time (JST) is UTC+9. Local clock time across Japan is exactly 9 hours ahead of Greenwich Mean Time (GMT) and Coordinated Universal Time (UTC)."
    },
    {
      q: "Does Japan observe Daylight Saving Time (DST)?",
      a: "No. Japan does not observe Daylight Saving Time. Clocks remain fixed at UTC+9 year-round without seasonal adjustments."
    },
    {
      q: "Has Japan ever observed Daylight Saving Time in the past?",
      a: "Yes. Between 1948 and 1951, Japan observed Daylight Saving Time under the Allied post-WWII occupation (SCAP). However, the practice faced widespread domestic opposition from farmers, commuters, and workers, leading the Japanese Diet to repeal it in 1952."
    },
    {
      q: "What is the reference meridian for Japan Standard Time?",
      a: "Japan Standard Time is calculated based on the 135° East longitude meridian, which passes directly through Akashi City in Hyogo Prefecture. Akashi is widely known across Japan as the 'City of Time' (Toki no Machi)."
    },
    {
      q: "Which major cities operate on Japan Standard Time?",
      a: "All Japanese cities operate on JST, including Tokyo, Yokohama, Osaka, Nagoya, Sapporo, Kobe, Kyoto, Fukuoka, Hiroshima, and Sendai."
    },
    {
      q: "How far ahead of US Eastern Standard Time (EST) is JST?",
      a: "During North American winter standard time (EST, UTC-5), Japan Standard Time (JST, UTC+9) is 14 hours ahead of Eastern Standard Time. When it is 8:00 AM EST in New York, it is 10:00 PM JST the same calendar day in Tokyo."
    },
    {
      q: "How far ahead of US Eastern Daylight Time (EDT) is JST?",
      a: "During North American summer daylight saving time (EDT, UTC-4), Japan Standard Time (JST, UTC+9) is 13 hours ahead of Eastern Daylight Time. When it is 8:00 AM EDT in New York, it is 9:00 PM JST the same day in Tokyo."
    },
    {
      q: "How do I convert JST to Greenwich Mean Time (GMT/UTC)?",
      a: "To convert JST to GMT/UTC, subtract 9 hours from JST. For example, 18:00 (6:00 PM) JST minus 9 hours equals 09:00 AM GMT."
    },
    {
      q: "How far ahead of US Pacific Standard Time (PST) is JST?",
      a: "During winter, Japan Standard Time (JST, UTC+9) is 17 hours ahead of Pacific Standard Time (PST, UTC-8). During Pacific summer (PDT, UTC-7), JST is 16 hours ahead of Los Angeles and San Francisco."
    },
    {
      q: "Why does Japan have only one time zone despite spanning thousands of islands?",
      a: "Although Japan's islands stretch over 3,000 kilometers from northeast to southwest, its longitudinal width is relatively compact (about 20° of longitude). A unified time zone simplifies rail schedules (Shinkansen), national broadcasting (NHK), financial markets, and administrative governance."
    },
    {
      q: "What is the time difference between JST and Central European Time (CET)?",
      a: "During European winter (CET, UTC+1), JST is 8 hours ahead of Paris and Berlin. During European summer (CEST, UTC+2), JST is 7 hours ahead."
    },
    {
      q: "What is the time difference between JST and British Summer Time (BST)?",
      a: "During British Summer Time (BST, UTC+1), JST (UTC+9) is 8 hours ahead of London. When it is 1:00 PM BST in London, it is 9:00 PM JST in Tokyo."
    },
    {
      q: "What is the time difference between JST and Australian Eastern Standard Time (AEST)?",
      a: "Australian Eastern Standard Time (AEST, UTC+10) is 1 hour ahead of JST. During Australian summer daylight time (AEDT, UTC+11), Sydney and Melbourne are 2 hours ahead of Tokyo."
    },
    {
      q: "What are the trading hours of the Tokyo Stock Exchange (TSE)?",
      a: "The Tokyo Stock Exchange (TSE) conducts regular equity trading on weekdays from 9:00 AM to 11:30 AM JST (morning session) and from 12:30 PM to 3:30 PM JST (afternoon session, extended in November 2024)."
    },
    {
      q: "What is the official atomic clock authority in Japan?",
      a: "The National Institute of Information and Communications Technology (NICT), located in Koganei, Tokyo, generates and maintains Japan Standard Time using a cluster of commercial cesium atomic clocks and hydrogen masers."
    },
    {
      q: "What is the IANA time zone database identifier for JST?",
      a: "In computing systems and the IANA time zone database (tzdb), Japan Standard Time is represented by the primary identifier `Asia/Tokyo`."
    },
    {
      q: "How does JST coordinate with Singapore and Hong Kong?",
      a: "Singapore (SGT, UTC+8) and Hong Kong (HKT, UTC+8) are exactly 1 hour behind Japan Standard Time (JST, UTC+9). When it is 10:00 AM JST in Tokyo, it is 9:00 AM in Singapore and Hong Kong."
    },
    {
      q: "Did Japan ever have multiple time zones in modern history?",
      a: "Between 1895 and 1937, Japan maintained two time zones: Central Standard Time (UTC+9) for the main islands and Western Standard Time (UTC+8) for Taiwan and parts of Okinawa. In December 1937, Western Standard Time was abolished to unify national timekeeping."
    },
    {
      q: "How can remote teams schedule meetings between Tokyo and New York?",
      a: "The optimal virtual meeting overlap window occurs between 8:00 AM – 10:00 AM JST (which corresponds to 7:00 PM – 9:00 PM EDT or 6:00 PM – 8:00 PM EST the previous evening in New York), or 8:00 PM – 10:00 PM JST (7:00 AM – 9:00 AM EDT/EST)."
    }
  ]
};

const pageUrlPath = `${siteUrl}/${slug}/`;
---

<BaseLayout
  lang={lang}
  dir={dir}
  title={seoTitle}
  description={pageDescription}
  slug={slug}
  meta={meta}
  enableFaqSchema={true}
  enableArticleSchema={true}
  breadcrumbHomeLabel="Home"
  breadcrumbLabel="JST"
>
  <!-- Hero Section -->
  <section class="hero-banner" aria-labelledby="hero-title">
    <h1 id="hero-title" class="hero-banner-title speakable-headline">
      Japan Standard Time (JST): <span class="gradient-text">UTC+9 Offset & Guide</span>
    </h1>
  </section>

  <!-- Editorial Info Bar -->
  <div class="editorial-meta-bar" aria-label="Editorial metadata">
    <span>Last Updated: <strong>July 30, 2026</strong></span>
    <span class="separator" aria-hidden="true">•</span>
    <span>Editorially Reviewed by <a href="/author/jackie-bruce/"><strong>Jackie Bruce</strong></a></span>
    <span class="separator" aria-hidden="true">•</span>
    <span>Data Source: <a href="https://www.nict.go.jp/en/" target="_blank" rel="noopener noreferrer"><strong>NICT National Institute of Information and Communications Technology</strong></a></span>
  </div>

  <div class="article-wrapper">
    <!-- Top Answer Summary Box -->
    <div class="summary-box speakable-summary">
      <div class="summary-header">
        <span class="summary-badge">TIME ZONE PROFILE</span>
        <h2>Japan Standard Time (JST) Summary</h2>
      </div>
      <div class="summary-grid">
        <div class="summary-item">
          <span class="label">UTC Offset:</span>
          <span class="val highlight">UTC+9 (9 hours ahead of GMT)</span>
        </div>
        <div class="summary-item">
          <span class="label">Reference Meridian:</span>
          <span class="val">135° East (Akashi, Hyogo Prefecture)</span>
        </div>
        <div class="summary-item">
          <span class="label">DST Observance:</span>
          <span class="val">None (Fixed year-round standard)</span>
        </div>
        <div class="summary-item">
          <span class="label">Primary Regions:</span>
          <span class="val"><a href="/japan-time-zone/">Japan</a> (125+ Million Population)</span>
        </div>
        <div class="summary-item">
          <span class="label">Major Cities:</span>
          <span class="val"><a href="/tokyo-time/">Tokyo</a>, Osaka, Kyoto, Yokohama, Sapporo, Fukuoka</span>
        </div>
        <div class="summary-item">
          <span class="label">Time Diff to EST:</span>
          <span class="val">JST is 14 hrs ahead of <a href="/est/">EST (UTC-5)</a> / 13 hrs ahead of EDT</span>
        </div>
      </div>
      <p class="summary-text">
        <strong>Japan Standard Time (JST)</strong> is the official standard time observed across all prefectures of Japan. Operating at a fixed offset of <strong>UTC+9</strong>, JST is 9 hours ahead of <a href="/gmt/">Greenwich Mean Time (GMT)</a> and does not observe Daylight Saving Time. Governed scientifically by the atomic clock arrays of the National Institute of Information and Communications Technology (NICT), JST serves as the temporal heartbeat of East Asian finance and high-technology manufacturing.
      </p>
    </div>

    <!-- Table of Contents -->
    <nav class="about-toc" aria-label="Table of Contents">
      <h2>Table of Contents</h2>
      <ul>
        <li><a href="#what-is-jst">1. What is Japan Standard Time (JST)?</a></li>
        <li><a href="#akashi-meridian">2. The 135° East Meridian & Akashi "City of Time"</a></li>
        <li><a href="#why-no-dst">3. Why Japan Does Not Observe Daylight Saving Time</a></li>
        <li><a href="#conversion-tables">4. Global JST Time Conversion Tables (GMT, EST, PST, CET, AEST)</a></li>
        <li><a href="#financial-markets">5. Tokyo Financial Markets & Stock Exchange Trading Hours</a></li>
        <li><a href="#follow-the-sun">6. Follow-the-Sun Operations & Virtual Meeting Overlaps</a></li>
        <li><a href="#faqs">7. Frequently Asked Questions (20 Detailed Answers)</a></li>
      </ul>
    </nav>

    <!-- Content Sections -->
    <section id="what-is-jst" class="content-section">
      <h2>1. What is Japan Standard Time (JST)?</h2>
      <p>
        <strong>Japan Standard Time (JST)</strong> was formally enacted by Imperial Ordinance No. 51 on July 13, 1886, taking official effect on January 1, 1888. The ordinance established standard time for the Japanese Empire based upon the <strong>135th meridian east of Greenwich</strong>.
      </p>
      <p>
        In contemporary computing and international standards, JST is cataloged under the IANA time zone database as <code>Asia/Tokyo</code>. Unlike continental landmasses that span numerous standard time bands, Japan regulates its entire national territory under this single standard, ensuring seamless synchronization across its bullet train infrastructure (Shinkansen), telecommunications grids, and equity exchanges.
      </p>
    </section>

    <!-- SVG Diagram 1: 135 East Meridian -->
    <section class="diagram-section">
      <div class="diagram-card">
        <h3>Figure 1: Japan 135° East Longitude Reference Meridian</h3>
        <div class="svg-wrapper">
          <svg viewBox="0 0 800 240" width="100%" height="auto" xmlns="http://www.w3.org/2000/svg" aria-label="Japan 135 East Meridian Diagram">
            <rect width="800" height="240" fill="var(--panel)" rx="12" stroke="var(--line)" stroke-width="1"/>
            
            <!-- Prime Meridian 0 -->
            <line x1="100" y1="40" x2="100" y2="200" stroke="var(--line)" stroke-dasharray="4,4"/>
            <text x="100" y="30" text-anchor="middle" fill="var(--muted)" font-size="12">0° Prime Meridian (GMT/UTC)</text>

            <!-- Arrow East -->
            <path d="M 120 120 L 510 120" stroke="var(--accent)" stroke-width="2.5"/>
            <text x="315" y="105" text-anchor="middle" fill="var(--accent)" font-size="12" font-weight="bold">+135° East Longitude (+9h 00m)</text>

            <!-- 135 East Meridian Line -->
            <line x1="530" y1="30" x2="530" y2="210" stroke="var(--accent)" stroke-width="3"/>
            <text x="530" y="25" text-anchor="middle" fill="var(--accent)" font-family="Space Grotesk, sans-serif" font-weight="bold" font-size="14">135° E Meridian (JST Standard)</text>

            <!-- Akashi Node -->
            <circle cx="530" cy="120" r="30" fill="var(--accent)" stroke="#ffffff" stroke-width="2"/>
            <text x="530" y="125" text-anchor="middle" fill="#ffffff" font-weight="bold" font-size="13">Akashi</text>
            <text x="530" y="165" text-anchor="middle" fill="var(--text)" font-size="11">Hyogo Prefecture (Toki no Machi)</text>

            <!-- Tokyo Node -->
            <circle cx="680" cy="120" r="22" fill="var(--panel)" stroke="var(--line)" stroke-width="2"/>
            <text x="680" y="124" text-anchor="middle" fill="var(--text)" font-weight="bold" font-size="11">Tokyo</text>
            <text x="680" y="165" text-anchor="middle" fill="var(--muted)" font-size="10">139.7° E (~19m ahead of solar noon)</text>
          </svg>
        </div>
        <p class="diagram-caption">
          Figure 1: Illustration showing the 135° East longitude meridian passing through Akashi, establishing the UTC+9 baseline for Japan Standard Time.
        </p>
      </div>
    </section>

    <section id="akashi-meridian" class="content-section">
      <h2>2. The 135° East Meridian & Akashi "City of Time"</h2>
      <p>
        The mathematical basis of standard time systems divides the 360 degrees of the Earth's circumference into 24 standard 15-degree zones (360° / 24 = 15° per hour). The 135th meridian east of Greenwich is exactly divisible by 15:
      </p>
      <div class="my-4 p-4 bg-slate-100 dark:bg-slate-800/80 rounded-xl border-l-4 border-emerald-500 font-mono text-sm">
        135° East Longitude &nbsp;÷&nbsp; 15° per hour &nbsp;=&nbsp; 9.0 Hours East of Greenwich (UTC+9)
      </div>
      <p>
        Because this line bisects Akashi City in Hyogo Prefecture, Akashi erected the famous Akashi Municipal Planetarium and meridian markers throughout the town. While Tokyo sits slightly east at roughly 139.7° East longitude (where local solar noon occurs about 19 minutes earlier than JST clock noon), observing 135°E provides optimal national balance.
      </p>
    </section>

    <section id="why-no-dst" class="content-section">
      <h2>3. Why Japan Does Not Observe Daylight Saving Time</h2>
      <p>
        Japan is the only G7 nation that does not practice seasonal clock changes. Following the end of the Second World War, the Supreme Commander for the Allied Powers (SCAP) mandated Daylight Saving Time in Japan from May 1948 to September 1951.
      </p>
      <p>
        The policy was widely disliked by the Japanese population. Agricultural workers faced disrupted routines, office workers suffered longer working hours without increased compensation, and the humid summer climate made evening cooling less effective. Shortly after Japan regained national sovereignty under the Treaty of San Francisco, the National Diet unanimously abolished Daylight Saving Time in 1952. Despite occasional debates during energy crises and international sporting events, public consensus and business leadership strongly support keeping JST stable year-round.
      </p>
    </section>

    <section id="conversion-tables" class="content-section">
      <h2>4. Global JST Time Conversion Tables (GMT, EST, PST, CET, AEST)</h2>
      <p>
        Because Japan remains at UTC+9 year-round while North American and European counterparts adjust their clocks seasonally, conversion offsets change twice per year. Explore our dedicated converters: <a href="/jst-to-est/">JST to EST Converter</a>, <a href="/gmt-to-jst/">GMT to JST Converter</a>, and the reference table below:
      </p>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Tokyo (JST, UTC+9)</th>
              <th>New York (EST/EDT)</th>
              <th>London (GMT/BST)</th>
              <th>Los Angeles (PST/PDT)</th>
              <th>Paris / Berlin (CET/CEST)</th>
              <th>Sydney (AEST/AEDT)</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>09:00 JST (Morning)</td>
              <td>19:00 / 20:00 (Prev Day)</td>
              <td>00:00 / 01:00</td>
              <td>16:00 / 17:00 (Prev Day)</td>
              <td>01:00 / 02:00</td>
              <td>10:00 / 11:00</td>
            </tr>
            <tr>
              <td>12:00 JST (Noon)</td>
              <td>22:00 / 23:00 (Prev Day)</td>
              <td>03:00 / 04:00</td>
              <td>19:00 / 20:00 (Prev Day)</td>
              <td>04:00 / 05:00</td>
              <td>13:00 / 14:00</td>
            </tr>
            <tr>
              <td>15:00 JST (Afternoon)</td>
              <td>01:00 / 02:00</td>
              <td>06:00 / 07:00</td>
              <td>22:00 / 23:00 (Prev Day)</td>
              <td>07:00 / 08:00</td>
              <td>16:00 / 17:00</td>
            </tr>
            <tr>
              <td>18:00 JST (Evening)</td>
              <td>04:00 / 05:00</td>
              <td>09:00 / 10:00</td>
              <td>01:00 / 02:00</td>
              <td>10:00 / 11:00</td>
              <td>19:00 / 20:00</td>
            </tr>
            <tr>
              <td>21:00 JST (Night)</td>
              <td>07:00 / 08:00</td>
              <td>12:00 / 13:00</td>
              <td>04:00 / 05:00</td>
              <td>13:00 / 14:00</td>
              <td>22:00 / 23:00</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- SVG Diagram 2: Global Spread -->
    <section class="diagram-section">
      <div class="diagram-card">
        <h3>Figure 2: Relative Global Time Offset Spread for JST</h3>
        <div class="svg-wrapper">
          <svg viewBox="0 0 800 220" width="100%" height="auto" xmlns="http://www.w3.org/2000/svg" aria-label="Global Timezone Offsets Relative to JST">
            <rect width="800" height="220" fill="var(--panel)" rx="12" stroke="var(--line)" stroke-width="1"/>
            
            <circle cx="480" cy="110" r="38" fill="var(--accent)" stroke="#ffffff" stroke-width="3"/>
            <text x="480" y="115" text-anchor="middle" fill="#ffffff" font-weight="bold" font-size="14">JST</text>
            <text x="480" y="165" text-anchor="middle" fill="var(--accent)" font-weight="bold" font-size="11">UTC+9 (Reference)</text>

            <circle cx="120" cy="110" r="30" fill="var(--panel)" stroke="var(--line)" stroke-width="2"/>
            <text x="120" y="114" text-anchor="middle" fill="var(--text)" font-weight="bold" font-size="13">EST</text>
            <text x="120" y="160" text-anchor="middle" fill="var(--muted)" font-size="11">-14 Hours (Winter)</text>

            <circle cx="280" cy="110" r="30" fill="var(--panel)" stroke="var(--line)" stroke-width="2"/>
            <text x="280" y="114" text-anchor="middle" fill="var(--text)" font-weight="bold" font-size="13">GMT</text>
            <text x="280" y="160" text-anchor="middle" fill="var(--muted)" font-size="11">-9 Hours</text>

            <circle cx="680" cy="110" r="30" fill="var(--panel)" stroke="var(--line)" stroke-width="2"/>
            <text x="680" y="114" text-anchor="middle" fill="var(--text)" font-weight="bold" font-size="13">AEST</text>
            <text x="680" y="160" text-anchor="middle" fill="var(--muted)" font-size="11">+1 Hour</text>

            <line x1="150" y1="110" x2="250" y2="110" stroke="var(--line)" stroke-width="2"/>
            <line x1="310" y1="110" x2="442" y2="110" stroke="var(--line)" stroke-width="2"/>
            <line x1="518" y1="110" x2="650" y2="110" stroke="var(--line)" stroke-width="2"/>
          </svg>
        </div>
        <p class="diagram-caption">
          Figure 2: Relative time offset spread placing JST (UTC+9) 9 hours ahead of London and 14 hours ahead of New York.
        </p>
      </div>
    </section>

    <section id="financial-markets" class="content-section">
      <h2>5. Tokyo Financial Markets & Stock Exchange Trading Hours</h2>
      <p>
        As one of the world's leading financial centers, the Tokyo Stock Exchange (TSE / 日本取引所グループ) anchors liquidity in the Asian trading session before European markets open:
      </p>
      <ul>
        <li><strong>Morning Trading Session (前場, Zenba):</strong> 9:00 AM JST – 11:30 AM JST.</li>
        <li><strong>Lunch Break (昼休み):</strong> 11:30 AM JST – 12:30 PM JST.</li>
        <li><strong>Afternoon Trading Session (後場, Goba):</strong> 12:30 PM JST – 3:30 PM JST (closing auction).</li>
      </ul>
      <p>
        For broader market comparisons across international exchanges, consult our guide on <a href="/stock-market-opening-times/">Stock Market Opening Times Worldwide</a>.
      </p>
    </section>

    <section id="follow-the-sun" class="content-section">
      <h2>6. Follow-the-Sun Operations & Virtual Meeting Overlaps</h2>
      <p>
        Multinational engineering and financial teams maintain round-the-clock handover protocols through Tokyo:
      </p>
      <ul>
        <li><strong>Tokyo to London Handover:</strong> 4:00 PM – 6:00 PM JST corresponds to 7:00 AM – 9:00 AM GMT (or 8:00 AM – 10:00 AM BST in summer), providing a natural 2-hour operational overlap.</li>
        <li><strong>Tokyo to New York Handover:</strong> Morning hours in Tokyo (8:00 AM – 10:00 AM JST) align with the previous evening in New York (7:00 PM – 9:00 PM EDT or 6:00 PM – 8:00 PM EST).</li>
      </ul>
      <p>
        Check our interactive <a href="/meeting-planner/">Global Meeting Planner</a> and <a href="/time-difference-calculator/">Time Difference Calculator</a> to schedule cross-border conferences without errors.
      </p>
    </section>

    <!-- Contextual Widgets Integration -->
    <RelatedConvertersWidget slug={slug} />
    <UsersAlsoVisitWidget slug={slug} />
    <LearnMoreWidget slug={slug} />
    <CountryCityWidget slug={slug} />

    <!-- FAQ Section -->
    <section id="faqs" class="content-section faqs-section">
      <h2>7. Frequently Asked Questions (JST)</h2>
      <div class="faq-list">
        {meta.faqs.map((faq, index) => (
          <details class="faq-item" open={index === 0}>
            <summary class="faq-question">
              <h3>{faq.q}</h3>
            </summary>
            <div class="faq-answer">
              <p>{faq.a}</p>
            </div>
          </details>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .article-wrapper {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 1rem 3rem;
  }
  .hero-banner {
    text-align: center;
    padding: 3rem 1rem 1.5rem;
  }
  .hero-banner-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--text);
  }
  .gradient-text {
    background: linear-gradient(135deg, var(--accent) 0%, #38bdf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .editorial-meta-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--muted);
    margin-bottom: 2rem;
    padding: 0.75rem 1rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
  }
  .editorial-meta-bar a {
    color: var(--accent);
    text-decoration: none;
  }
  .separator {
    opacity: 0.5;
  }
  .summary-box {
    background: var(--panel);
    border: 1px solid var(--accent);
    border-radius: 12px;
    padding: 1.75rem;
    margin-bottom: 2.5rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.15);
  }
  .summary-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }
  .summary-badge {
    background: var(--accent);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    letter-spacing: 0.05em;
  }
  .summary-header h2 {
    font-size: 1.35rem;
    margin: 0;
    color: var(--text);
  }
  .summary-grid {
