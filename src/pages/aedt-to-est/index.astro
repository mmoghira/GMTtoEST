                <span class="faq-icon">+</span>
              </summary>
              <div class="faq-answer">
                <p>{faq.a}</p>
              </div>
            </details>
          ))}
        </div>
      </section>

      <section>
        <h2>Related Time Zone Converters</h2>
        <div class="grid-cards related-converters">
          {relatedConverters.map(link => (
            <a href={link.href} class="card converter-link-card">
              <h3>{link.label}</h3>
              <p>{link.desc}</p>
            </a>
          ))}
        </div>
      </section>
    </article>
  </main>
</BaseLayout>

