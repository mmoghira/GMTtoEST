       ═══════════════════════════════════════════════════════════════════════ -->
  <section id="time-difference" class="content-section reveal" aria-label="Time Difference Details">
    <h2>5. Time Difference Details (UTC-5 Offset)</h2>
    <p>
      The time difference between Coordinated Universal Time and Eastern Standard Time is exactly five hours. EST is calculated by subtracting five hours from the current UTC time:
    </p>
    <div class="formula-box">
      {"$$\\text{EST} = \\text{UTC} - 5 \\text{ hours}$$"}
      <br />
      {"$$\\text{UTC} = \\text{EST} + 5 \\text{ hours}$$"}
    </div>
    
    <!-- Custom Inline SVG: Clock Comparison (Infographic 4) -->
    <div style="margin: 2.5rem 0; text-align: center; border: 1px solid var(--line); padding: 1.5rem; border-radius: 12px; background: var(--panel);">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 220" width="100%" height="auto" style="display: block; margin: 0 auto;">
        <rect width="800" height="220" fill="#0f172a" rx="8" />
        
        <!-- UTC Clock -->
        <g transform="translate(150, 110)">
          <circle cx="0" cy="0" r="70" fill="#12455d" stroke="#8fd7ff" stroke-width="4" />
          <!-- Hour markers -->
