            <th>Summer Offset (Mar - Nov)</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>UTC</strong></td>
            <td>Scientific Standard</td>
            <td>UTC+0 (Fixed)</td>
            <td>UTC+0 (Fixed)</td>
          </tr>
          <tr>
            <td><strong>EST</strong></td>
            <td>Winter Time Zone</td>
            <td>UTC-5 (Active)</td>
            <td>Inactive (Becomes EDT)</td>
          </tr>
          <tr>
            <td><strong>EDT</strong></td>
            <td>Summer Time Zone</td>
            <td>Inactive (Becomes EST)</td>
            <td>UTC-4 (Active)</td>
          </tr>
        </tbody>
      </table>
    </div>

