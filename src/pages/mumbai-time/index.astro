---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import { siteUrl } from "theme/i18n/config";
import RelatedConvertersWidget from "theme/components/RelatedConvertersWidget.astro";
import UsersAlsoVisitWidget from "theme/components/UsersAlsoVisitWidget.astro";
import LearnMoreWidget from "theme/components/LearnMoreWidget.astro";
import CountryCityWidget from "theme/components/CountryCityWidget.astro";

const lang = "en";
const dir = "ltr";
const slug = "mumbai-time";
const seoTitle = "Mumbai Time Now: Current Clock Offset & IST Guide (2026)";
const pageDescription = "Get current exact local time in Mumbai, India. Learn about India Standard Time (IST), UTC+5:30 fixed offset, BSE/NSE trading hours, and London/NY time conversions.";

const pubDate = "2026-07-30T10:00:00+05:00";
const updatedDate = "2026-07-30T10:00:00+05:00";

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "Mumbai Time, Current Time in Mumbai, IST Time Zone, India Standard Time, Mumbai UTC+5:30, Mumbai clock, Asia/Kolkata timezone, India Time Zone",
  pubDate,
  updatedDate,
  author: "Jackie Bruce",
  faqs: [
    {
      q: "What time zone is Mumbai in?",
      a: "Mumbai, India operates in India Standard Time (IST), which has a fixed year-round offset of UTC+5:30."
    },
    {
      q: "Does Mumbai observe Daylight Saving Time?",
      a: "No. Mumbai and the entire nation of India do not observe Daylight Saving Time. Clocks remain fixed at UTC+5:30 year-round."
    },
    {
      q: "What is Mumbai's time difference from GMT/UTC?",
      a: "Mumbai is always 5 hours and 30 minutes ahead of Coordinated Universal Time (UTC+5:30) and Greenwich Mean Time (GMT)."
    },
    {
      q: "What is the time difference between Mumbai and London?",
      a: "During British winter (GMT, UTC+0), Mumbai is 5.5 hours ahead of London. During British summer (BST, UTC+1), Mumbai is 4.5 hours ahead of London."
    },
    {
      q: "What is the time difference between Mumbai and New York?",
      a: "During US winter (EST, UTC-5), Mumbai is 10.5 hours ahead of New York. During US summer (EDT, UTC-4), Mumbai is 9.5 hours ahead of New York."
    },
    {
      q: "What is the IANA time zone identifier for Mumbai?",
      a: "The official IANA Time Zone Database key for Mumbai is Asia/Kolkata."
    },
    {
      q: "What stock exchanges operate on Mumbai time?",
      a: "The Bombay Stock Exchange (BSE) and National Stock Exchange of India (NSE), both headquartered in Mumbai, operate on local IST time (9:15 AM to 3:30 PM IST)."
    },
    {
      q: "What is the time difference between Mumbai and Dubai?",
      a: "Mumbai (IST, UTC+5:30) is 1.5 hours (90 minutes) ahead of Dubai (GST, UTC+4) year-round."
    },
    {
      q: "What is the time difference between Mumbai and Tokyo?",
      a: "Tokyo (JST, UTC+9) is 3.5 hours ahead of Mumbai (IST, UTC+5:30) year-round."
    },
    {
      q: "What is the time difference between Mumbai and Singapore?",
      a: "Singapore (SST, UTC+8) is 2.5 hours ahead of Mumbai (IST, UTC+5:30) year-round."
    },
    {
      q: "Why does India use a half-hour offset (UTC+5:30)?",
      a: "India adopted UTC+5:30 in 1905 to establish a single unified standard time zone based on the 82.5° East meridian passing through Mirzapur, providing balanced daylight coverage for the entire sub-continent."
    },
    {
      q: "What is the best time for a Mumbai-to-London business meeting?",
      a: "The optimal window is between 2:00 PM and 6:30 PM Mumbai time, corresponding to 9:30 AM to 2:00 PM London time (BST)."
    },
    {
      q: "What is the best time for a Mumbai-to-New York business call?",
      a: "Schedule calls between 6:30 PM and 8:30 PM Mumbai time, which matches 9:00 AM to 11:00 AM New York time (EDT)."
    },
    {
      q: "Does all of India use the same time zone as Mumbai?",
      a: "Yes. The entire Republic of India (from Mumbai to Delhi, Kolkata, Bengaluru, and Chennai) observes India Standard Time (IST) uniformly."
    },
    {
      q: "What military time designation corresponds to Mumbai time?",
      a: "Because IST is a half-hour offset, it is represented in aviation and military contexts as Echo-Star (E*) or simply specified with numeric offset +05:30."
    },
    {
      q: "What major airport operates on Mumbai time?",
      a: "Chhatrapati Shivaji Maharaj International Airport (BOM) operates flight schedules strictly on Asia/Kolkata local time."
    },
    {
      q: "What is the time difference between Mumbai and Sydney?",
      a: "Sydney is 4.5 hours ahead of Mumbai during Australian winter (AEST, UTC+10) and 5.5 hours ahead during Australian summer (AEDT, UTC+11)."
    },
    {
      q: "What is the time difference between Mumbai and San Francisco / Los Angeles?",
      a: "Mumbai is 12.5 hours ahead of Pacific Daylight Time (PDT, UTC-7) and 13.5 hours ahead of Pacific Standard Time (PST, UTC-8)."
    },
    {
      q: "Are Mumbai time and Delhi time identical?",
      a: "Yes. Both Mumbai and Delhi observe India Standard Time (IST, UTC+5:30) with zero time difference."
    },
    {
      q: "How should software developers store Mumbai timestamps?",
      a: "Store timestamps in UTC format in databases, utilizing Asia/Kolkata in front-end applications for localized date-time rendering."
    }
  ]
};

const pageUrlPath = `${siteUrl}/mumbai-time/`;

const pageSchema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${pageUrlPath}#webpage`,
    "url": pageUrlPath,
    "name": seoTitle,
    "description": pageDescription,
    "inLanguage": lang,
    "isPartOf": { "@id": `${siteUrl}/#website` }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${pageUrlPath}#breadcrumb`,
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteUrl}/` },
      { "@type": "ListItem", "position": 2, "name": "Mumbai Time", "item": pageUrlPath }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "@id": `${pageUrlPath}#article`,
    "headline": seoTitle,
    "description": pageDescription,
    "datePublished": pubDate,
    "dateModified": updatedDate,
    "author": { "@type": "Person", "name": meta.author },
    "publisher": { "@type": "Organization", "name": "GMT to EST Converter", "url": siteUrl },
    "mainEntityOfPage": pageUrlPath
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${pageUrlPath}#faq`,
    "mainEntity": meta.faqs.map(faq => ({
      "@type": "Question",
      "name": faq.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.a
      }
    }))
  }
];
---

<BaseLayout lang={lang} dir={dir} title={seoTitle} description={pageDescription} slug={slug} meta={meta} enableFaqSchema={true}>
  <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} slot="head" />

  <div class="container content-wrapper">
    <header class="page-header">
      <h1>Mumbai Time: Complete Guide to India Standard Time (2026)</h1>
      <div class="reading-meta">
        <span><strong>Author:</strong> {meta.author}</span> | 
        <span><strong>Last Updated:</strong> July 30, 2026</span> | 
        <span><strong>Reading Time:</strong> 15 mins</span>
      </div>
    </header>

    <!-- Top Answer Summary Box -->
    <div class="summary-box">
      <h2>Quick Summary: Current Time Rules in Mumbai</h2>
      <div class="summary-grid">
        <div class="summary-item">
          <strong>City & Country:</strong> Mumbai, Maharashtra, India
        </div>
        <div class="summary-item">
          <strong>Primary Time Zone:</strong> India Standard Time (IST)
        </div>
        <div class="summary-item">
          <strong>Year-Round Fixed Offset:</strong> UTC+5:30 (GMT+5:30)
        </div>
        <div class="summary-item">
          <strong>Daylight Saving Observance:</strong> None (Fixed UTC+5:30)
        </div>
        <div class="summary-item">
          <strong>IANA Database Key:</strong> <code>Asia/Kolkata</code>
        </div>
        <div class="summary-item">
          <strong>Difference vs New York (EDT):</strong> 9.5 hours ahead (10.5h in EST)
        </div>
      </div>
    </div>

    <section class="content-section">
      <h2>Understanding Mumbai Local Time & India Standard Time Mechanics</h2>
      <p>
        Mumbai is the financial, commercial, and entertainment capital of India. Located on the Konkan coast of western India, Mumbai houses the Reserve Bank of India (RBI), the Bombay Stock Exchange (BSE), the National Stock Exchange of India (NSE), and major corporate headquarters driving India's multi-trillion dollar economy.
      </p>
      <p>
        Mumbai operates on <strong>India Standard Time (IST)</strong>, maintaining a fixed offset of <a href="/gmt-to-ist/">UTC+5:30</a> year-round. India is one of several countries utilizing a fractional half-hour UTC offset, centered on the 82.5°E meridian passing through Mirzapur in Uttar Pradesh.
      </p>
      <p>
        Because India does not observe Daylight Saving Time, Mumbai's local clocks never shift. However, when corporate partners in <a href="/london-time/">London</a>, <a href="/paris-time/">Paris</a>, or <a href="/new-york-time/">New York</a> shift between standard and daylight saving time, the relative time difference contracts or expands by 60 minutes.
      </p>

      <div class="info-callout">
        <h3>Key Takeaway: The 9.5-Hour US Summer Gap</h3>
        <p>
          During North American summer (EDT), Mumbai is <strong>9 hours and 30 minutes ahead of New York</strong>. During winter (EST), Mumbai is <strong>10 hours and 30 minutes ahead</strong>.
        </p>
      </div>
    </section>

    <!-- Visual SVG Diagram 1 -->
    <section class="content-section">
      <h2>Mumbai IST (UTC+5:30) Global Offset Visual Map</h2>
      <div class="svg-diagram-container">
        <svg viewBox="0 0 800 340" width="100%" height="auto" xmlns="http://www.w3.org/2000/svg" aria-label="Mumbai Time Offset Diagram">
          <rect width="800" height="340" fill="var(--panel)" rx="12" stroke="var(--line)" stroke-width="2"/>
          <text x="400" y="38" fill="var(--accent)" font-family="Space Grotesk, sans-serif" font-size="20" font-weight="bold" text-anchor="middle">Mumbai (Asia/Kolkata) Year-Round UTC+5:30 Offset</text>

          <!-- Timeline Axis -->
          <line x1="60" y1="120" x2="740" y2="120" stroke="var(--line)" stroke-width="4"/>

          <!-- UTC Marker -->
          <circle cx="160" cy="120" r="8" fill="var(--accent-2)"/>
          <text x="160" y="95" fill="var(--text)" font-size="13" text-anchor="middle">UTC / GMT</text>
          <text x="160" y="150" fill="var(--muted)" font-size="12" text-anchor="middle">UTC+0</text>

          <!-- Dubai Marker -->
          <circle cx="340" cy="120" r="8" fill="#8fd7ff"/>
          <text x="340" y="95" fill="var(--text)" font-size="13" text-anchor="middle">Dubai (GST)</text>
          <text x="340" y="150" fill="var(--muted)" font-size="12" text-anchor="middle">UTC+4</text>

          <!-- Mumbai Marker -->
          <circle cx="480" cy="120" r="12" fill="#36c7b5" stroke="#ffffff" stroke-width="3"/>
          <text x="480" y="90" fill="var(--accent)" font-size="16" font-weight="bold" text-anchor="middle">MUMBAI</text>
          <text x="480" y="150" fill="var(--text)" font-weight="bold" font-size="13" text-anchor="middle">UTC+5:30 (IST Fixed)</text>

          <!-- Singapore Marker -->
          <circle cx="620" cy="120" r="8" fill="var(--accent-2)"/>
          <text x="620" y="95" fill="var(--text)" font-size="13" text-anchor="middle">Singapore (SST)</text>
          <text x="620" y="150" fill="var(--muted)" font-size="12" text-anchor="middle">UTC+8</text>

          <!-- Info Box -->
          <rect x="180" y="190" width="440" height="115" fill="var(--bg)" rx="8" stroke="var(--line)" stroke-width="1.5"/>
          <text x="400" y="218" fill="var(--text)" font-family="Space Grotesk, sans-serif" font-size="15" font-weight="bold" text-anchor="middle">India Standard Time (IST) Characteristics</text>
          <text x="400" y="248" fill="var(--muted)" font-size="13" text-anchor="middle">• Half-hour UTC+5:30 offset based on 82.5°E longitude</text>
          <text x="400" y="276" fill="var(--muted)" font-size="13" text-anchor="middle">• Official IANA timezone key: Asia/Kolkata</text>
        </svg>
      </div>
    </section>

    <section class="content-section">
      <h2>Mumbai Financial Markets (BSE / NSE) & Global Trading Hours</h2>
      <p>
        The Bombay Stock Exchange (BSE) and National Stock Exchange (NSE) represent the core of India's equity markets. Core trading hours run from <strong>9:15 AM to 3:30 PM IST</strong>, Monday through Friday.
      </p>

      <div class="table-responsive">
        <table class="comparison-table">
          <thead>
            <tr>
              <th>Exchange</th>
              <th>Local Market Hours</th>
              <th>Equivalent Mumbai Time (IST)</th>
              <th>Overlap Window</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>BSE / NSE (Mumbai)</strong></td>
              <td>9:15 AM – 3:30 PM IST</td>
              <td>9:15 AM – 3:30 PM IST</td>
              <td>Base Indian Trading Session</td>
            </tr>
            <tr>
              <td><strong>London Stock Exchange (LSE)</strong></td>
              <td>8:00 AM – 4:30 PM BST</td>
              <td>12:30 PM – 9:00 PM IST</td>
              <td>3-hour afternoon overlap (12:30 PM – 3:30 PM IST)</td>
            </tr>
            <tr>
              <td><strong>NYSE / NASDAQ (New York)</strong></td>
              <td>9:30 AM – 4:00 PM EDT</td>
              <td>7:00 PM – 1:30 AM IST</td>
              <td>No equity market daytime overlap</td>
            </tr>
            <tr>
              <td><strong>Tokyo Stock Exchange (TSE)</strong></td>
              <td>9:00 AM – 3:00 PM JST</td>
              <td>5:30 AM – 11:30 AM IST</td>
              <td>2.25-hour morning overlap (9:15 AM – 11:30 AM IST)</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="tip-box">
        <h3>Pro Scheduling Tip for Offshore Development Teams</h3>
        <p>
          To maintain real-time contact with US East Coast companies while avoiding midnight fatigue, offshore software engineers in Mumbai operate on a <strong>2:00 PM – 11:00 PM IST shift</strong>. This provides 4.5 hours of direct overlap during the standard US morning (9:30 AM – 2:00 PM EDT).
        </p>
      </div>
    </section>

    <!-- Visual SVG Diagram 2 -->
    <section class="content-section">
      <h2>Mumbai Global Workday Overlap Visual Matrix</h2>
      <div class="svg-diagram-container">
        <svg viewBox="0 0 800 260" width="100%" height="auto" xmlns="http://www.w3.org/2000/svg" aria-label="Mumbai Workday Overlap Matrix">
          <rect width="800" height="260" fill="var(--panel)" rx="12" stroke="var(--line)" stroke-width="2"/>
          <text x="400" y="35" fill="var(--accent)" font-family="Space Grotesk, sans-serif" font-size="18" font-weight="bold" text-anchor="middle">Standard Workday Overlap with Mumbai (9:00 AM - 6:00 PM IST)</text>

          <!-- Mumbai -->
          <text x="120" y="80" fill="var(--text)" font-weight="bold" font-size="14">Mumbai (IST)</text>
          <rect x="220" y="65" width="480" height="22" fill="#36c7b5" rx="4"/>
          <text x="460" y="81" fill="#0c354a" font-size="12" font-weight="bold" text-anchor="middle">9:00 AM – 6:00 PM IST (Base Workday)</text>

          <!-- Singapore -->
          <text x="120" y="130" fill="var(--text)" font-size="14">Singapore (SST)</text>
          <rect x="220" y="115" width="340" height="22" fill="#8fd7ff" rx="4"/>
          <text x="390" y="131" fill="#0c354a" font-size="11" font-weight="bold" text-anchor="middle">Overlap: 9 AM - 2:30 PM IST</text>

          <!-- London -->
          <text x="120" y="180" fill="var(--text)" font-size="14">London (BST)</text>
          <rect x="400" y="165" width="300" height="22" fill="#8fd7ff" rx="4"/>
          <text x="550" y="181" fill="#0c354a" font-size="11" font-weight="bold" text-anchor="middle">Overlap: 1:30 PM - 6 PM IST</text>

          <!-- New York -->
          <text x="120" y="230" fill="var(--text)" font-size="14">New York (EDT)</text>
          <rect x="620" y="215" width="80" height="22" fill="#ffd166" rx="4"/>
          <text x="660" y="231" fill="#0c354a" font-size="11" font-weight="bold" text-anchor="middle">6:30 PM IST</text>
        </svg>
      </div>
    </section>

    <section class="content-section">
      <h2>Mumbai Direct Hourly Time Conversion Reference Table</h2>
      <div class="table-responsive">
        <table class="comparison-table">
          <thead>
            <tr>
              <th>Mumbai Time (IST)</th>
              <th>UTC / GMT Offset</th>
              <th>London Time (BST)</th>
              <th>New York Time (EDT)</th>
              <th>Dubai Time (GST)</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>00:00 (Midnight)</td><td>18:30 UTC (Prev. Day)</td><td>07:30 PM BST (Prev. Day)</td><td>02:30 PM EDT (Prev. Day)</td><td>10:30 PM GST (Prev. Day)</td></tr>
            <tr><td>03:00 AM</td><td>21:30 UTC (Prev. Day)</td><td>10:30 PM BST (Prev. Day)</td><td>05:30 PM EDT (Prev. Day)</td><td>01:30 AM GST</td></tr>
            <tr><td>06:00 AM</td><td>00:30 UTC</td><td>01:30 AM BST</td><td>08:30 PM EDT (Prev. Day)</td><td>04:30 AM GST</td></tr>
            <tr><td>09:00 AM</td><td>03:30 UTC</td><td>04:30 AM BST</td><td>11:30 PM EDT (Prev. Day)</td><td>07:30 AM GST</td></tr>
            <tr><td>12:00 PM (Noon)</td><td>06:30 UTC</td><td>07:30 AM BST</td><td>02:30 AM EDT</td><td>10:30 AM GST</td></tr>
            <tr><td>03:00 PM</td><td>09:30 UTC</td><td>10:30 AM BST</td><td>05:30 AM EDT</td><td>01:30 PM GST</td></tr>
            <tr><td>06:00 PM</td><td>12:30 UTC</td><td>01:30 PM BST</td><td>08:30 AM EDT</td><td>04:30 PM GST</td></tr>
            <tr><td>09:00 PM</td><td>15:30 UTC</td><td>04:30 PM BST</td><td>11:30 AM EDT</td><td>07:30 PM GST</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="content-section faq-section">
      <h2>Frequently Asked Questions About Mumbai Time</h2>
      <div class="faq-list">
        {meta.faqs.map((faq) => (
          <details class="faq-item">
            <summary class="faq-question">{faq.q}</summary>
            <div class="faq-answer">
              <p>{faq.a}</p>
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- Widgets Section -->
    <RelatedConvertersWidget slug={slug} />
    <UsersAlsoVisitWidget slug={slug} />
    <LearnMoreWidget slug={slug} />
    <CountryCityWidget slug={slug} />
  </div>
</BaseLayout>

<style>
  .content-wrapper {
    padding-top: 2rem;
    padding-bottom: 4rem;
    max-width: 1100px;
    margin: 0 auto;
  }
  .page-header h1 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 2.3rem;
    color: var(--text);
    margin-bottom: 0.5rem;
  }
  .reading-meta {
    font-size: 0.9rem;
    color: var(--muted);
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }
  .summary-box {
    background: var(--panel);
    border: 2px solid var(--accent);
    border-radius: 12px;
    padding: 1.8rem;
    margin-bottom: 2.5rem;
  }
  .summary-box h2 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.4rem;
    color: var(--accent);
    margin-top: 0;
    margin-bottom: 1.2rem;
  }
  .summary-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }
  .summary-item {
    background: var(--bg);
    padding: 0.9rem 1.1rem;
    border-radius: 8px;
    border: 1px solid var(--line);
    font-size: 0.95rem;
  }
  .summary-item strong {
    display: block;
    color: var(--accent-2);
    margin-bottom: 0.25rem;
  }
  .content-section {
    margin-bottom: 3rem;
  }
  .content-section h2 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.7rem;
    color: var(--text);
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.4rem;
  }
  .content-section p {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--muted);
    margin-bottom: 1.2rem;
  }
  .info-callout, .tip-box {
    background: var(--panel);
    border-left: 4px solid var(--accent);
    padding: 1.3rem 1.6rem;
    border-radius: 6px;
    margin: 1.8rem 0;
  }
  .info-callout h3, .tip-box h3 {
    margin-top: 0;
    font-family: 'Space Grotesk', sans-serif;
    color: var(--accent);
    font-size: 1.2rem;
  }
  .svg-diagram-container {
    margin: 2rem 0;
    background: var(--bg);
    padding: 1rem;
    border-radius: 12px;
    border: 1px solid var(--line);
  }
  .table-responsive {
    overflow-x: auto;
    margin: 1.8rem 0;
  }
  .comparison-table {
    width: 100%;
    border-collapse: collapse;
    background: var(--panel);
    border-radius: 8px;
    overflow: hidden;
  }
  .comparison-table th, .comparison-table td {
    padding: 1rem;
    text-align: left;
    border-bottom: 1px solid var(--line);
    font-size: 0.95rem;
  }
  .comparison-table th {
    background: var(--bg);
    color: var(--accent-2);
    font-family: 'Space Grotesk', sans-serif;
  }
  .faq-section details {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
    margin-bottom: 1rem;
    padding: 1rem 1.2rem;
  }
  .faq-section summary {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--text);
    cursor: pointer;
  }
  .faq-answer {
    padding-top: 0.8rem;
    border-top: 1px solid var(--line);
    margin-top: 0.8rem;
  }
</style>
