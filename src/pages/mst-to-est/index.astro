  <script is:inline>
    (function setupMstToEstConverter() {
      const tool = document.getElementById("mst-tool");
      if (!tool) return;

      const mountainZone = "America/Denver";
      const easternZone = "America/New_York";
      const state = {
        direction: "mountain-to-eastern",
        format: "24",
        lastText: ""
      };

      const nodes = {
        heading: document.getElementById("mst-tool-heading"),
        date: document.getElementById("mst-date"),
        time24: document.getElementById("mst-time-24"),
        time24Wrap: document.getElementById("mst-time-24-wrap"),
        time12Wrap: document.getElementById("mst-time-12-wrap"),
        hour12: document.getElementById("mst-hour-12"),
        minute12: document.getElementById("mst-minute-12"),
        period: document.getElementById("mst-period"),
        sourceLabel: document.getElementById("mst-source-label"),
        targetLabel: document.getElementById("mst-target-label"),
        sourcePreview: document.getElementById("mst-source-preview"),
        result: document.getElementById("mst-result"),
        offsetBadge: document.getElementById("mst-offset-badge"),
        dstBadge: document.getElementById("mst-dst-badge"),
        explanation: document.getElementById("mst-explanation"),
        copy: document.getElementById("mst-copy")
      };

      const formatterCache = new Map();

      function formatter(key, timeZone, options) {
        const cacheKey = key + "|" + timeZone + "|" + JSON.stringify(options);
        if (!formatterCache.has(cacheKey)) {
          formatterCache.set(cacheKey, new Intl.DateTimeFormat("en-US", { timeZone, ...options }));
        }
        return formatterCache.get(cacheKey);
      }

      function parts(date, timeZone) {
        const map = {};
        formatter("parts", timeZone, {
          year: "numeric",
          month: "2-digit",
          day: "2-digit",
          hour: "2-digit",
          minute: "2-digit",
          second: "2-digit",
          hourCycle: "h23",
          timeZoneName: "short"
        }).formatToParts(date).forEach((part) => {
          map[part.type] = part.value;
        });
        return map;
      }

      function offsetMinutes(date, timeZone) {
        const p = parts(date, timeZone);
        const asUtc = Date.UTC(+p.year, +p.month - 1, +p.day, +p.hour, +p.minute, +p.second);
        return Math.round((asUtc - date.getTime()) / 60000);
      }

      function standardOffsetMinutes(date, timeZone) {
        const year = date.getUTCFullYear();
        const jan = offsetMinutes(new Date(Date.UTC(year, 0, 1, 12)), timeZone);
        const jul = offsetMinutes(new Date(Date.UTC(year, 6, 1, 12)), timeZone);
        return Math.min(jan, jul);
      }

      function isDst(date, timeZone) {
        return offsetMinutes(date, timeZone) !== standardOffsetMinutes(date, timeZone);
      }

      function zoneName(date, timeZone) {
        return parts(date, timeZone).timeZoneName || "";
      }

      function formatOffset(minutes) {
        const sign = minutes >= 0 ? "+" : "-";
        const absolute = Math.abs(minutes);
        const hours = Math.floor(absolute / 60);
        const mins = absolute % 60;
        return "UTC" + sign + hours + (mins ? ":" + String(mins).padStart(2, "0") : "");
      }

      function localToUtc(dateValue, hour, minute, timeZone) {
        const bits = dateValue.split("-").map(Number);
        const base = Date.UTC(bits[0], bits[1] - 1, bits[2], hour, minute, 0);
        let guess = base - offsetMinutes(new Date(base), timeZone) * 60000;
        for (let i = 0; i < 4; i += 1) {
          guess = base - offsetMinutes(new Date(guess), timeZone) * 60000;
        }
        return new Date(guess);
      }

      function sourceTarget() {
        const mountainToEastern = state.direction === "mountain-to-eastern";
        return {
          sourceZone: mountainToEastern ? mountainZone : easternZone,
          targetZone: mountainToEastern ? easternZone : mountainZone,
          sourceName: mountainToEastern ? "Mountain Time" : "Eastern Time",
          targetName: mountainToEastern ? "Eastern Time" : "Mountain Time"
        };
      }

      function formatFull(date, timeZone) {
        return formatter("full", timeZone, {
          weekday: "short",
          month: "short",
          day: "numeric",
          year: "numeric",
          hour: "numeric",
          minute: "2-digit",
          hour12: state.format === "12",
          timeZoneName: "short"
        }).format(date);
      }

      function formatClock(date, timeZone) {
        return formatter("clock", timeZone, {
          hour: "numeric",
          minute: "2-digit",
          second: "2-digit",
          hour12: false,
          timeZoneName: "short"
        }).format(date);
      }

      function formatDate(date, timeZone) {
        return formatter("date", timeZone, {
          weekday: "short",
          month: "short",
          day: "numeric",
          year: "numeric"
        }).format(date);
      }

      function readInput() {
        const dateValue = nodes.date.value;
        if (!dateValue) return null;
        if (state.format === "12") {
          let hour = Math.max(1, Math.min(12, Number(nodes.hour12.value) || 12));
          const minute = Math.max(0, Math.min(59, Number(nodes.minute12.value) || 0));
          if (nodes.period.value === "PM" && hour !== 12) hour += 12;
          if (nodes.period.value === "AM" && hour === 12) hour = 0;
          return { dateValue, hour, minute };
        }
        const value = nodes.time24.value || "09:00";
        const timeParts = value.split(":").map(Number);
        return { dateValue, hour: timeParts[0] || 0, minute: timeParts[1] || 0 };
      }

      function sync12From24() {
        const value = nodes.time24.value || "09:00";
        const timeParts = value.split(":").map(Number);
        const hour24 = timeParts[0] || 0;
        const minute = timeParts[1] || 0;
        nodes.period.value = hour24 >= 12 ? "PM" : "AM";
        nodes.hour12.value = String(hour24 % 12 || 12);
        nodes.minute12.value = String(minute).padStart(2, "0");
      }

      function sync24From12() {
        const input = readInput();
        if (!input) return;
        nodes.time24.value = String(input.hour).padStart(2, "0") + ":" + String(input.minute).padStart(2, "0");
      }

      function setInputFromDate(date, timeZone) {
        const p = parts(date, timeZone);
        nodes.date.value = p.year + "-" + p.month + "-" + p.day;
        nodes.time24.value = p.hour + ":" + p.minute;
        sync12From24();
      }

      function updateDirectionLabels(date) {
        const zones = sourceTarget();
        const sourceAbbr = zoneName(date, zones.sourceZone);
        const targetAbbr = zoneName(date, zones.targetZone);
        nodes.heading.textContent = state.direction === "mountain-to-eastern" ? "Convert MST to EST" : "Convert EST to MST";
        nodes.sourceLabel.textContent = sourceAbbr + " - " + zones.sourceName;
        nodes.targetLabel.textContent = targetAbbr + " - " + zones.targetName;
      }

      function convert() {
        const input = readInput();
        if (!input) return;
        const zones = sourceTarget();
        const date = localToUtc(input.dateValue, input.hour, input.minute, zones.sourceZone);
        if (Number.isNaN(date.getTime())) return;

        updateDirectionLabels(date);

        const sourceOffset = offsetMinutes(date, zones.sourceZone);
        const targetOffset = offsetMinutes(date, zones.targetZone);
        const diffHours = (targetOffset - sourceOffset) / 60;
        const sourceAbbr = zoneName(date, zones.sourceZone);
        const targetAbbr = zoneName(date, zones.targetZone);
        const sourceText = formatFull(date, zones.sourceZone);
        const targetText = formatFull(date, zones.targetZone);
        const sourceDst = isDst(date, zones.sourceZone);
        const targetDst = isDst(date, zones.targetZone);
        const directionWord = diffHours >= 0 ? "ahead of" : "behind";
        const absDiff = Math.abs(diffHours);

        nodes.sourcePreview.textContent = sourceText;
        nodes.result.textContent = targetText;
        nodes.offsetBadge.textContent = sourceAbbr + " " + formatOffset(sourceOffset) + " to " + targetAbbr + " " + formatOffset(targetOffset);
        nodes.dstBadge.textContent = (sourceDst ? sourceAbbr + " observes DST" : sourceAbbr + " is standard time") + "; " + (targetDst ? targetAbbr + " observes DST" : targetAbbr + " is standard time");
        nodes.explanation.textContent = zones.targetName + " is " + absDiff + " hours " + directionWord + " " + zones.sourceName + " on this date.";
        state.lastText = sourceText + " converts to " + targetText + ". " + nodes.offsetBadge.textContent + ". " + nodes.dstBadge.textContent + ".";
      }

      function updateFormat(format) {
        if (state.format === "24" && format === "12") sync12From24();
        if (state.format === "12" && format === "24") sync24From12();
        state.format = format;
        nodes.time24Wrap.hidden = format !== "24";
        nodes.time12Wrap.hidden = format !== "12";
        document.querySelectorAll("[data-format]").forEach((button) => {
          const active = button.dataset.format === format;
          button.classList.toggle("active", active);
          button.setAttribute("aria-pressed", String(active));
        });
        convert();
      }

      function updateDirection(direction) {
        state.direction = direction;
        document.querySelectorAll("[data-direction]").forEach((button) => {
          const active = button.dataset.direction === direction;
          button.classList.toggle("active", active);
          button.setAttribute("aria-pressed", String(active));
        });
        setInputFromDate(new Date(), sourceTarget().sourceZone);
        convert();
      }

      function updateLiveClocks() {
        const now = new Date();
        [
          ["mst", mountainZone],
          ["est", easternZone]
        ].forEach(([prefix, zone]) => {
          const offset = offsetMinutes(now, zone);
          const dst = isDst(now, zone);
          const abbr = zoneName(now, zone);
          const timeNode = document.getElementById(prefix + "-live-time");
          const dateNode = document.getElementById(prefix + "-live-date");
          const abbrNode = document.getElementById(prefix + "-live-abbr");
          const offsetNode = document.getElementById(prefix + "-live-offset");
          const dstNode = document.getElementById(prefix + "-live-dst");
          if (timeNode) timeNode.textContent = formatClock(now, zone);
          if (dateNode) dateNode.textContent = formatDate(now, zone);
          if (abbrNode) abbrNode.textContent = abbr;
          if (offsetNode) offsetNode.textContent = formatOffset(offset);
          if (dstNode) dstNode.textContent = dst ? "Daylight saving active" : "Standard time";
        });
      }

      async function copyText(text, button) {
        if (!text) return;
        try {
          await navigator.clipboard.writeText(text);
        } catch {
          const fallback = document.createElement("textarea");
          fallback.value = text;
          fallback.setAttribute("readonly", "");
          fallback.style.position = "fixed";
          fallback.style.left = "-9999px";
          document.body.appendChild(fallback);
          fallback.select();
          document.execCommand("copy");
          fallback.remove();
        }
        if (button) {
          const original = button.textContent;
          button.textContent = "Copied";
          setTimeout(() => {
            button.textContent = original;
          }, 1100);
        }
      }

      tool.addEventListener("submit", (event) => {
        event.preventDefault();
        convert();
      });

      document.getElementById("mst-now")?.addEventListener("click", () => {
        setInputFromDate(new Date(), sourceTarget().sourceZone);
        convert();
      });

      document.getElementById("mst-swap")?.addEventListener("click", () => {
        updateDirection(state.direction === "mountain-to-eastern" ? "eastern-to-mountain" : "mountain-to-eastern");
      });

      nodes.copy?.addEventListener("click", () => copyText(state.lastText, nodes.copy));

      [nodes.date, nodes.time24, nodes.hour12, nodes.minute12, nodes.period].forEach((node) => {
        node?.addEventListener("input", convert);
        node?.addEventListener("change", convert);
      });

      document.querySelectorAll("[data-format]").forEach((button) => {
        button.addEventListener("click", () => updateFormat(button.dataset.format));
      });

      document.querySelectorAll("[data-direction]").forEach((button) => {
        button.addEventListener("click", () => updateDirection(button.dataset.direction));
      });

      document.querySelectorAll(".mst-copy-row").forEach((button) => {
        button.addEventListener("click", () => copyText(button.dataset.copyText, button));
      });

      setInputFromDate(new Date(), mountainZone);
      updateLiveClocks();
      convert();
      setInterval(updateLiveClocks, 1000);
    })();
  </script>
</BaseLayout>

