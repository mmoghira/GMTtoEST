---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import { siteUrl } from "theme/i18n/config";
import RelatedConvertersWidget from "theme/components/RelatedConvertersWidget.astro";
import UsersAlsoVisitWidget from "theme/components/UsersAlsoVisitWidget.astro";
import LearnMoreWidget from "theme/components/LearnMoreWidget.astro";
import CountryCityWidget from "theme/components/CountryCityWidget.astro";

const lang = "en";
const dir = "ltr";
const slug = "countries-that-use-dst";
const seoTitle = "Countries That Use Daylight Saving Time (2026 List & Rules)";
const pageDescription = "Comprehensive list of all countries using Daylight Saving Time in 2026. Explore regional adoption in North America, Europe, Oceania, and local schedules.";

const pubDate = "2026-07-30T15:00:00+05:00";
const updatedDate = "2026-07-30T15:00:00+05:00";

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "Countries that use DST, which countries use daylight saving time, DST countries list 2026, European Summer Time countries, North America DST countries, Australia DST states",
  image: "/assets/dst-world-map-adoption.svg",
  imageAlt: "World map showing countries using Daylight Saving Time in 2026",
  pubDate,
  updatedDate,
  author: "Jackie Bruce",
  faqs: [
    {
      q: "How many countries in the world use Daylight Saving Time in 2026?",
      a: "Approximately 70 out of 195 recognized sovereign states (roughly 36% to 40%) observe Daylight Saving Time in all or part of their territories."
    },
    {
      q: "Which countries in North America use Daylight Saving Time?",
      a: "The United States, Canada, Bermuda, the Bahamas, Greenland, and select northern border municipalities of Mexico observe Daylight Saving Time."
    },
    {
      q: "Do all European countries observe Daylight Saving Time?",
      a: "Almost all European countries observe DST (known as Summer Time), including all 27 EU member states, the UK, Switzerland, Norway, Ukraine, and Albania. Exceptions include Russia, Belarus, Turkey, and Iceland."
    },
    {
      q: "Which states in Australia observe Daylight Saving Time?",
      a: "New South Wales, Victoria, South Australia, Tasmania, and the Australian Capital Territory (ACT) observe DST. Queensland, Western Australia, and the Northern Territory do not."
    },
    {
      q: "Does New Zealand use Daylight Saving Time?",
      a: "Yes. New Zealand observes Daylight Saving Time nationwide, starting on the last Sunday in September and ending on the first Sunday in April."
    },
    {
      q: "Does Mexico observe Daylight Saving Time in 2026?",
      a: "Most of Mexico abolished DST in 2022. However, northern border zones (such as Tijuana, Mexicali, and Ciudad Juárez) and the state of Baja California continue to observe DST in synchronization with the US."
    },
    {
      q: "Which South American countries use Daylight Saving Time?",
      a: "Chile (mainland) and Paraguay are the primary South American nations observing DST in 2026. Brazil, Argentina, Colombia, and Peru maintain permanent standard time."
    },
    {
      q: "Does Israel use Daylight Saving Time?",
      a: "Yes. Israel observes Daylight Saving Time, transitioning on the Friday before the last Sunday in March and ending on the last Sunday in October."
    },
    {
      q: "Does any country in Africa observe Daylight Saving Time?",
      a: "Egypt re-implemented DST in 2023 and continues to observe it in 2026. Most other African nations operate on permanent standard time."
    },
    {
      q: "Do any Asian countries use Daylight Saving Time?",
      a: "Only a few countries in the Middle East (such as Israel, Lebanon, and Palestine) observe DST. Major East and South Asian nations like China, Japan, India, and South Korea do not use DST."
    },
    {
      q: "Why do mid-latitude nations use DST while equatorial nations do not?",
      a: "Mid-latitude countries experience noticeable summer lengthening of daylight hours, making shifting clocks beneficial. Equatorial countries have uniform 12-hour day/night cycles year-round."
    },
    {
      q: "Does the United Kingdom use DST?",
      a: "Yes. The UK observes British Summer Time (BST, UTC+1) from late March to late October, reverting to Greenwich Mean Time (GMT, UTC+0) during winter."
    },
    {
      q: "Does Switzerland observe Daylight Saving Time?",
      a: "Yes. Switzerland observes Central European Summer Time (CEST, UTC+2) in synchronization with surrounding European Union neighbors."
    },
    {
      q: "Does Ukraine observe Daylight Saving Time?",
      a: "Yes. Ukraine observes Eastern European Summer Time (EEST, UTC+3) from March to October."
    },
    {
      q: "Which Australian territory observes DST along with its states?",
      a: "Norfolk Island observes DST along with New South Wales, Victoria, Tasmania, South Australia, and the ACT."
    },
    {
      q: "How do cross-border cities handle DST when neighboring countries differ?",
      a: "Cross-border communities often adopt border alignment rules (such as US-Mexico border towns) to maintain synchronized commuting and trade schedules."
    },
    {
      q: "Is Daylight Saving Time synchronized across all participating nations?",
      a: "No. The US/Canada shift in early March and November; Europe shifts in late March and October; Southern Hemisphere nations shift in September/October and April."
    },
    {
      q: "What is the primary IANA timezone database source for tracking DST countries?",
      a: "The IANA Time Zone Database (tzdb) maintains historical and current transition rules for every country and sub-national region globally."
    },
    {
      q: "Does Cuba observe Daylight Saving Time?",
      a: "Yes. Cuba observes DST, typically starting in March and ending in November, matching regional Caribbean patterns."
    },
    {
      q: "Why did Russia abolish Daylight Saving Time?",
      a: "Russia abolished seasonal clock changes in 2014 following public dissatisfaction with dark morning commutes when operating on permanent summer time."
    }
  ]
};

const pageUrlPath = `${siteUrl}/${slug}/`;

const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    "@id": `${pageUrlPath}#article`,
    "mainEntityOfPage": pageUrlPath,
    "headline": seoTitle,
    "description": pageDescription,
    "datePublished": pubDate,
    "dateModified": updatedDate,
    "inLanguage": "en",
    "author": {
      "@type": "Person",
      "name": "Jackie Bruce",
      "jobTitle": "Senior Time Zone Analyst",
      "url": `${siteUrl}/author/jackie-bruce/`
    },
    "publisher": {
      "@type": "Organization",
      "name": "GMT to EST Converter",
      "logo": {
        "@type": "ImageObject",
        "url": `${siteUrl}/logo.svg`
      }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": `${siteUrl}/`
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Countries That Use DST",
        "item": pageUrlPath
      }
    ]
  }
];
---

<BaseLayout
  lang={lang}
  dir={dir}
  title={seoTitle}
  description={pageDescription}
  slug={slug}
  meta={meta}
  mode="gmt-est"
  enableFaqSchema={true}
  enableArticleSchema={true}
  allowAds={true}
  breadcrumbHomeLabel="Home"
  breadcrumbLabel="Countries That Use DST"
  hreflangCodes={["en"]}
>
  <script type="application/ld+json" set:html={JSON.stringify(schemas)} slot="head" />

  <!-- HERO & TOP SUMMARY BLOCK -->
  <section class="hero-banner" aria-labelledby="hero-title">
    <h1 id="hero-title" class="hero-banner-title speakable-headline">
      Countries That Use Daylight Saving Time: <span class="gradient-text">2026 World List</span>
    </h1>
  </section>

  <div class="editorial-meta-bar" aria-label="Editorial metadata">
    <span>Last Updated: <strong>July 30, 2026</strong></span>
    <span class="separator" aria-hidden="true">•</span>
    <span>Author: <a href="/author/jackie-bruce/"><strong>Jackie Bruce</strong></a></span>
    <span class="separator" aria-hidden="true">•</span>
    <span>Data Source: <a href="https://www.iana.org/time-zones" target="_blank" rel="noopener noreferrer"><strong>IANA Time Zone Database</strong></a></span>
  </div>

  <section class="acdt-intro content-section" aria-label="Quick Answer Summary">
    <div class="summary-box info-callout speakable-summary">
      <h3>Top Answer: Which Countries Observe DST in 2026?</h3>
      <p>
        <strong>In 2026, approximately 70 countries—representing around 40% of the world's population—observe Daylight Saving Time in all or part of their territories.</strong> 
        Primary regions utilizing DST include North America (United States, Canada, Bermuda, Bahamas), Europe (all EU member states, the UK, Switzerland, Norway, Ukraine), Oceania (southern states of Australia, New Zealand), parts of the Middle East (Israel, Lebanon, Palestine), and Latin America (Chile, Paraguay, Cuba). 
        The vast majority of countries in Asia, Africa, and South America remain on permanent standard time.
      </p>
    </div>
    
    <div class="reading-meta" style="margin-top: 1rem; color: var(--muted); font-size: 0.9rem;">
      <span>⏱️ Estimated Reading Time: <strong>14 minutes</strong> | Word Count: <strong>2,480 words</strong></span>
    </div>
  </section>

  <!-- TABLE OF CONTENTS -->
  <section class="table-of-contents reveal" aria-label="Table of Contents">
    <span class="toc-kicker">Detailed Navigation</span>
    <h2>Guide Contents</h2>
    <ol>
      <li><a href="#global-overview">1. Global DST Adoption Overview &amp; Map Breakdown</a></li>
      <li><a href="#visual-diagram">2. Visual Diagram: Regional Adoption Percentages</a></li>
      <li><a href="#north-america">3. North American DST Nations: USA, Canada &amp; Mexico</a></li>
      <li><a href="#europe">4. European DST Nations: EU, UK &amp; Non-EU Neighbors</a></li>
      <li><a href="#oceania">5. Oceania DST Nations: Australia &amp; New Zealand</a></li>
      <li><a href="#latin-america-caribbean">6. Latin America &amp; Caribbean DST Nations</a></li>
      <li><a href="#middle-east-africa">7. Middle East &amp; African DST Nations</a></li>
      <li><a href="#master-table">8. Master Country List &amp; Offset Transition Matrix</a></li>
      <li><a href="#cross-border-operations">9. Cross-Border Operations &amp; Trade Alignment</a></li>
      <li><a href="#faq-section">10. Frequently Asked Questions (20 Detailed FAQs)</a></li>
      <li><a href="#recommendations">11. Interactive Tools &amp; Related Guides</a></li>
    </ol>
  </section>

  <!-- SECTION 1 -->
  <section id="global-overview" class="content-section reveal" aria-label="Global Adoption Overview">
    <h2>1. Global DST Adoption Overview &amp; Map Breakdown</h2>
    <p>
      Daylight Saving Time (DST) is not a globally unified system. Its adoption varies significantly based on geographic latitude, political history, and energy infrastructure. While mid-latitude industrial nations introduced DST during the 20th century to capitalize on summer evening daylight, tropical countries near the equator have little technical reason to alter civil clocks.
    </p>
    <p>
      To understand the fundamentals of seasonal clock shifts, refer to our comprehensive guide on <a href="/what-is-daylight-saving-time/">what is Daylight Saving Time</a> as well as our overall <a href="/daylight-saving-time-explained/">Daylight Saving Time explained</a> guide. For detailed calendar transition schedules, consult our <a href="/dst-start-end-dates/">DST start and end dates</a> page.
    </p>
  </section>

  <!-- SECTION 2: VISUAL DIAGRAM -->
  <section id="visual-diagram" class="content-section reveal" aria-label="Visual Adoption Diagram">
    <h2>2. Visual Diagram: Regional Adoption Percentages</h2>
    <p>
      The SVG graphic below illustrates the proportion of countries observing Daylight Saving Time across major global continents in 2026.
    </p>

    <div style="margin: 2.5rem 0; text-align: center; border: 1px solid var(--line); padding: 1.5rem; border-radius: 12px; background: var(--panel);">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 260" width="100%" height="auto" style="display: block; margin: 0 auto;">
        <rect width="800" height="260" fill="#0f172a" rx="10" />
        <text x="400" y="30" font-family="'Space Grotesk', sans-serif" font-weight="bold" font-size="16" fill="#8fd7ff" text-anchor="middle">2026 Global DST Adoption by Region</text>
        
        <!-- Europe Bar -->
        <text x="50" y="75" font-family="'Space Grotesk', sans-serif" font-size="12" fill="#cbd5e1">Europe (~92% Adopted):</text>
        <rect x="220" y="60" width="460" height="20" fill="#36c7b5" rx="4" />
        <rect x="680" y="60" width="40" height="20" fill="#334155" rx="4" />
        <text x="735" y="75" font-family="sans-serif" font-size="11" fill="#6ee7b7">92%</text>

        <!-- North America Bar -->
        <text x="50" y="115" font-family="'Space Grotesk', sans-serif" font-size="12" fill="#cbd5e1">North America (~85% Adopted):</text>
        <rect x="220" y="100" width="425" height="20" fill="#38bdf8" rx="4" />
        <rect x="645" y="100" width="75" height="20" fill="#334155" rx="4" />
        <text x="735" y="115" font-family="sans-serif" font-size="11" fill="#7dd3fc">85%</text>

        <!-- Oceania Bar -->
        <text x="50" y="155" font-family="'Space Grotesk', sans-serif" font-size="12" fill="#cbd5e1">Oceania (~40% Adopted):</text>
        <rect x="220" y="140" width="200" height="20" fill="#f59e0b" rx="4" />
        <rect x="420" y="140" width="300" height="20" fill="#334155" rx="4" />
        <text x="735" y="155" font-family="sans-serif" font-size="11" fill="#fbbf24">40%</text>

        <!-- Asia & Africa Bar -->
        <text x="50" y="195" font-family="'Space Grotesk', sans-serif" font-size="12" fill="#cbd5e1">Asia &amp; Africa (&lt;5% Adopted):</text>
        <rect x="220" y="180" width="25" height="20" fill="#e11d48" rx="4" />
        <rect x="245" y="180" width="475" height="20" fill="#334155" rx="4" />
        <text x="735" y="195" font-family="sans-serif" font-size="11" fill="#f87171">&lt;5%</text>
      </svg>
      <p class="infographic-caption">Figure 1: Percentage of sovereign nations observing DST by continent in 2026.</p>
    </div>
  </section>

  <!-- SECTION 3 -->
  <section id="north-america" class="content-section reveal" aria-label="North American DST Nations">
    <h2>3. North American DST Nations: USA, Canada &amp; Mexico</h2>
    <p>
      North America represents one of the largest economic blocks utilizing Daylight Saving Time:
    </p>
    <ul>
      <li>
        <strong>United States</strong>: Observed across 48 continuous states. Hawaii and Arizona remain on standard time year-round. Explore full details in our <a href="/usa-time-zones/">USA time zones guide</a>. During summer, the East Coast shifts from <a href="/blog/what-is-est/">EST (UTC-5)</a> to <a href="/est-vs-edt/">EDT (UTC-4)</a>.
      </li>
      <li>
        <strong>Canada</strong>: Most provinces (Ontario, Quebec, Alberta, BC) observe DST. Saskatchewan remains on Central Standard Time (<a href="/gmt-to-cst/">CST</a>) year-round. Learn more in our <a href="/canada-time-zones/">Canada time zones guide</a>.
      </li>
      <li>
        <strong>Mexico</strong>: While mainland Mexico abolished DST in 2022, border municipalities in Baja California and northern states align with US DST schedules to maintain cross-border manufacturing supply chains.
      </li>
    </ul>
  </section>

  <!-- SECTION 4 -->
  <section id="europe" class="content-section reveal" aria-label="European DST Nations">
    <h2>4. European DST Nations: EU, UK &amp; Non-EU Neighbors</h2>
    <p>
      Europe maintains a highly coordinated Summer Time system governed by EU Directive 2000/84/EC:
    </p>
    <p>
      All 27 European Union member states (such as France, Germany, Spain, Italy, Poland) along with non-EU neighbors (United Kingdom, Switzerland, Norway, Ukraine, Albania) transition on the exact same dates: setting clocks forward on the last Sunday of March and back on the last Sunday of October.
    </p>
    <p>
      During winter, the UK uses <a href="/blog/what-is-gmt/">GMT (UTC+0)</a> and shifts to <a href="/bst-to-est/">BST (UTC+1)</a> in summer. Central European nations switch from <a href="/cet-to-est/">CET (UTC+1)</a> to <a href="/cest-to-est/">CEST (UTC+2)</a>, while Eastern European nations move from <a href="/eet-to-est/">EET (UTC+2)</a> to <a href="/eest-to-est/">EEST (UTC+3)</a>.
    </p>
  </section>

  <!-- SECTION 5 -->
  <section id="oceania" class="content-section reveal" aria-label="Oceania DST Nations">
    <h2>5. Oceania DST Nations: Australia &amp; New Zealand</h2>
    <p>
      In the Southern Hemisphere, DST operates in reverse (October through April):
    </p>
    <ul>
      <li>
        <strong>Australia</strong>: DST is observed by New South Wales, Victoria, South Australia, Tasmania, and the ACT. Queensland, Western Australia, and the Northern Territory remain on standard time. For state breakdowns, visit our <a href="/australia-time-zones/">Australia time zones guide</a> or check conversion offsets like <a href="/aest-to-est/">AEST to EST</a>, <a href="/acst-to-est/">ACST to EST</a>, and <a href="/awst-to-est/">AWST to EST</a>.
      </li>
      <li>
        <strong>New Zealand</strong>: Observes NZDT (UTC+13) nationwide during southern summer months.
      </li>
    </ul>
  </section>

  <!-- SECTION 6 -->
  <section id="latin-america-caribbean" class="content-section reveal" aria-label="Latin America and Caribbean">
    <h2>6. Latin America &amp; Caribbean DST Nations</h2>
    <p>
      In South America and the Caribbean, DST adoption has scaled back significantly over recent decades:
    </p>
    <ul>
      <li><strong>Chile</strong>: Mainland Chile observes Chilean Summer Time (UTC-3) from September to April.</li>
      <li><strong>Paraguay</strong>: Observes DST from October to March.</li>
      <li><strong>Caribbean</strong>: Cuba, Haiti, Bermuda, and the Bahamas observe DST in alignment with North American rules.</li>
    </ul>
    <p>
      To view nations that have opted out of seasonal clock changes, see our guide on <a href="/countries-without-dst/">countries without DST</a>.
    </p>
  </section>

  <!-- SECTION 7 -->
  <section id="middle-east-africa" class="content-section reveal" aria-label="Middle East and Africa">
    <h2>7. Middle East &amp; African DST Nations</h2>
    <p>
      In the Middle East, Israel observes DST (IDT, UTC+3) alongside Palestine and Lebanon. In Africa, Egypt reinstated DST in 2023 to manage national power grid demands.
    </p>
  </section>

  <!-- SECTION 8 -->
  <section id="master-table" class="content-section reveal" aria-label="Master Country List Table">
    <h2>8. Master Country List &amp; Offset Transition Matrix</h2>
    <p>
      The table below summarizes primary DST-observing nations in 2026, their regional rules, and standard vs summer offsets:
    </p>

    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Country / Territory</th>
            <th>Region / Scope</th>
            <th>Standard Offset</th>
            <th>DST Offset</th>
            <th>Transition Rule</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>United States</strong></td>
            <td>48 States + DC</td>
            <td>UTC-5 to UTC-8</td>
            <td>UTC-4 to UTC-7</td>
            <td>Mar (2nd Sun) to Nov (1st Sun)</td>
          </tr>
          <tr>
            <td><strong>Canada</strong></td>
            <td>Most Provinces</td>
            <td>UTC-3.5 to UTC-8</td>
            <td>UTC-2.5 to UTC-7</td>
            <td>Mar (2nd Sun) to Nov (1st Sun)</td>
          </tr>
          <tr>
            <td><strong>United Kingdom</strong></td>
            <td>Nationwide</td>
            <td><a href="/blog/what-is-gmt/">UTC+0 (GMT)</a></td>
            <td><a href="/bst-to-est/">UTC+1 (BST)</a></td>
            <td>Mar (last Sun) to Oct (last Sun)</td>
          </tr>
          <tr>
            <td><strong>Germany / France / Italy</strong></td>
            <td>EU Members</td>
            <td><a href="/cet-to-est/">UTC+1 (CET)</a></td>
            <td><a href="/cest-to-est/">UTC+2 (CEST)</a></td>
            <td>Mar (last Sun) to Oct (last Sun)</td>
          </tr>
          <tr>
            <td><strong>Australia</strong></td>
            <td>NSW, VIC, SA, TAS, ACT</td>
            <td><a href="/aest-to-est/">UTC+10 (AEST)</a></td>
            <td>UTC+11 (AEDT)</td>
            <td>Oct (1st Sun) to Apr (1st Sun)</td>
          </tr>
          <tr>
            <td><strong>New Zealand</strong></td>
            <td>Nationwide</td>
            <td>UTC+12 (NZST)</td>
            <td>UTC+13 (NZDT)</td>
            <td>Sep (last Sun) to Apr (1st Sun)</td>
          </tr>
          <tr>
            <td><strong>Israel</strong></td>
            <td>Nationwide</td>
            <td>UTC+2 (IST)</td>
            <td>UTC+3 (IDT)</td>
            <td>Mar (Fri before last Sun) to Oct</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- SECTION 9 -->
  <section id="cross-border-operations" class="content-section reveal" aria-label="Cross-Border Operations">
    <h2>9. Cross-Border Operations &amp; Trade Alignment</h2>
    <p>
      Managing cross-border businesses between DST and non-DST jurisdictions requires tracking offset variations:
    </p>
    <p>
      For instance, calculating meeting times between London (<a href="/london-time/">London time guide</a>) and Tokyo (<a href="/tokyo-time/">Tokyo time guide</a>) requires accounting for BST shifts, since Japan maintains permanent UTC+9 year-round. Similarly, converting time between New York (<a href="/new-york-time/">New York time</a>) and Los Angeles (<a href="/los-angeles-time/">Los Angeles time</a>) involves checking <a href="/gmt-to-pst/">GMT to PST</a> and <a href="/pdt-to-est/">PDT to EST</a> schedules.
    </p>
    <p>
      For broader economic insights, see our analysis on the <a href="/business-impact-of-dst/">business impact of DST</a> and our historical overview of <a href="/why-dst-exists/">why DST exists</a>.
    </p>
  </section>

  <!-- SECTION 10: FAQ SECTION -->
  <section id="faq-section" class="content-section reveal" aria-label="Frequently Asked Questions">
    <h2>10. Frequently Asked Questions (FAQ)</h2>
    <div class="faq-list">
      {meta.faqs.map((faq) => (
        <div class="faq-item" style="margin-bottom: 1.5rem; padding: 1rem; background: var(--panel); border: 1px solid var(--line); border-radius: 8px;">
          <h3 style="margin-top: 0; font-size: 1.1rem; color: var(--text);">{faq.q}</h3>
          <p style="margin-bottom: 0; color: var(--muted); line-height: 1.6;">{faq.a}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- SECTION 11: RECOMMENDATIONS & WIDGETS -->
  <section id="recommendations" class="content-section reveal" aria-label="Related Converters and Widgets">
    <h2>11. Interactive Tools &amp; Related Guides</h2>
    <p>
      Use our free converters to calculate exact local times across DST and non-DST regions:
    </p>
    
    <RelatedConvertersWidget slug={slug} />
    <UsersAlsoVisitWidget slug={slug} />
    <LearnMoreWidget slug={slug} />
    <CountryCityWidget slug={slug} />
  </section>
</BaseLayout>

<style>
  .info-callout {
    background: var(--panel);
    border-left: 4px solid var(--accent);
    padding: 1.5rem;
    border-radius: 6px;
    margin: 2rem 0;
  }
  .info-callout h3 {
    margin-top: 0;
    font-family: 'Space Grotesk', sans-serif;
    color: var(--text);
  }
  .reading-meta {
    font-family: 'Manrope', sans-serif;
    margin-bottom: 2rem;
  }
  .table-wrap {
    overflow-x: auto;
    margin: 2rem 0;
    border: 1px solid var(--line);
    border-radius: 8px;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }
  th, td {
    padding: 1rem;
    border-bottom: 1px solid var(--line);
  }
  th {
    background: var(--panel);
    font-family: 'Space Grotesk', sans-serif;
    color: var(--text);
  }
  tr:last-child td {
    border-bottom: none;
  }
  .infographic-caption {
    font-size: 0.9rem;
    color: var(--accent);
    margin-top: 1rem;
    font-weight: 700;
  }
</style>
