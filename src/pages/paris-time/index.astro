---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import { siteUrl } from "theme/i18n/config";
import RelatedConvertersWidget from "theme/components/RelatedConvertersWidget.astro";
import UsersAlsoVisitWidget from "theme/components/UsersAlsoVisitWidget.astro";
import LearnMoreWidget from "theme/components/LearnMoreWidget.astro";
import CountryCityWidget from "theme/components/CountryCityWidget.astro";

const lang = "en";
const dir = "ltr";
const slug = "paris-time";
const seoTitle = "Paris Time Now: Current Clock Offset & CET/CEST Guide (2026)";
const pageDescription = "Get current local time in Paris, France. Find Central European Time (CET), Central European Summer Time (CEST), UTC offsets, Euronext trading hours, and London/NY time difference guides.";

const pubDate = "2026-07-30T10:00:00+05:00";
const updatedDate = "2026-07-30T10:00:00+05:00";

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "Paris Time, Current Time in Paris, Paris Time Zone, CET to EST, CEST offset, Paris clock, Europe/Paris timezone, France Time Zone",
  pubDate,
  updatedDate,
  author: "Jackie Bruce",
  faqs: [
    {
      q: "What time zone is Paris in?",
      a: "Paris, France is in the Central European Time Zone. It observes Central European Time (CET, UTC+1) during winter and Central European Summer Time (CEST, UTC+2) during summer."
    },
    {
      q: "What is Paris's current UTC offset?",
      a: "Paris is at UTC+1 during standard winter time (CET) and shifts to UTC+2 during Daylight Saving Time in summer (CEST)."
    },
    {
      q: "What is the time difference between Paris and London?",
      a: "Paris is always 1 hour ahead of London. When it is 12:00 PM in London (GMT or BST), it is 1:00 PM in Paris (CET or CEST). Both regions switch to DST on the exact same date."
    },
    {
      q: "What is the time difference between Paris and New York?",
      a: "During most of the year, Paris is 6 hours ahead of New York. When it is 9:00 AM in New York (EDT/EST), it is 3:00 PM in Paris (CEST/CET). A brief 5-hour difference occurs during DST transition shifts in March and October."
    },
    {
      q: "When does Daylight Saving Time begin and end in Paris?",
      a: "In Paris and across the EU, Daylight Saving Time (CEST) begins on the last Sunday of March at 2:00 AM CET (clocks jump to 3:00 AM). It ends on the last Sunday of October at 3:00 AM CEST (clocks fall back to 2:00 AM CET)."
    },
    {
      q: "What is the IANA time zone identifier for Paris?",
      a: "The official IANA Time Zone Database key for Paris is Europe/Paris."
    },
    {
      q: "What stock market operates on Paris time?",
      a: "Euronext Paris operates on local Paris time, with core equity trading running from 9:00 AM to 5:30 PM CEST/CET."
    },
    {
      q: "What is the time difference between Paris and Tokyo?",
      a: "Tokyo (JST, UTC+9) is 8 hours ahead of Paris during summer (CEST, UTC+2) and 7 hours ahead of Paris during winter (CET, UTC+1)."
    },
    {
      q: "What is the time difference between Paris and Sydney?",
      a: "Sydney is 8 hours ahead of Paris during European summer / Australian winter, and 10 hours ahead of Paris during European winter / Australian summer."
    },
    {
      q: "Does all of Metropolitan France use Paris time?",
      a: "Yes. Metropolitan France observes Europe/Paris time uniformly across all mainland regions and Corsica."
    },
    {
      q: "What is the best time for a Paris-to-New York business meeting?",
      a: "The optimal meeting window is between 3:00 PM and 5:30 PM Paris time, which corresponds to 9:00 AM to 11:30 AM New York time."
    },
    {
      q: "How does Paris time compare to UTC?",
      a: "To convert UTC to Paris standard time (CET), add 1 hour. To convert UTC to Paris summer time (CEST), add 2 hours."
    },
    {
      q: "Why is Paris in UTC+1 instead of Greenwich Mean Time?",
      a: "Geographically, much of France lies near the 0° Greenwich meridian. However, France adopted Central European Time during World War II for economic and administrative alignment with neighboring continental nations like Germany."
    },
    {
      q: "What military time letter code represents Paris time?",
      a: "Paris standard time (CET, UTC+1) corresponds to Alpha (A) time, while Paris daylight time (CEST, UTC+2) corresponds to Bravo (B) time."
    },
    {
      q: "What major international airport operates on Paris time?",
      a: "Paris Charles de Gaulle Airport (CDG) and Paris Orly Airport (ORY) handle flights operating under Europe/Paris local time."
    },
    {
      q: "What is the time difference between Paris and Dubai?",
      a: "Dubai (GST, UTC+4) is 2 hours ahead of Paris during summer (CEST, UTC+2) and 3 hours ahead of Paris during winter (CET, UTC+1)."
    },
    {
      q: "What is the time difference between Paris and Berlin?",
      a: "There is no time difference. Both Paris and Berlin operate on Central European Time (CET/CEST) under identical EU transition schedules."
    },
    {
      q: "Is Paris time the same as Romance Standard Time?",
      a: "Yes. Legacy systems like Microsoft Windows refer to the UTC+1 timezone covering Paris, Brussels, Madrid, and Rome as 'Romance Standard Time'."
    },
    {
      q: "What is the time difference between Paris and Los Angeles?",
      a: "Paris is 9 hours ahead of Los Angeles. When it is 8:00 AM in Los Angeles (PDT), it is 5:00 PM in Paris (CEST)."
    },
    {
      q: "How should software applications format Paris timestamps?",
      a: "Developers should store dates in UTC and apply the Europe/Paris IANA key using libraries like Moment.js, Day.js, or native Intl.DateTimeFormat."
    }
  ]
};

const pageUrlPath = `${siteUrl}/paris-time/`;

const pageSchema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${pageUrlPath}#webpage`,
    "url": pageUrlPath,
    "name": seoTitle,
    "description": pageDescription,
    "inLanguage": lang,
    "isPartOf": { "@id": `${siteUrl}/#website` }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${pageUrlPath}#breadcrumb`,
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteUrl}/` },
      { "@type": "ListItem", "position": 2, "name": "Paris Time", "item": pageUrlPath }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "@id": `${pageUrlPath}#article`,
    "headline": seoTitle,
    "description": pageDescription,
    "datePublished": pubDate,
    "dateModified": updatedDate,
    "author": { "@type": "Person", "name": meta.author },
    "publisher": { "@type": "Organization", "name": "GMT to EST Converter", "url": siteUrl },
    "mainEntityOfPage": pageUrlPath
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${pageUrlPath}#faq`,
    "mainEntity": meta.faqs.map(faq => ({
      "@type": "Question",
      "name": faq.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.a
      }
    }))
  }
];
---

<BaseLayout lang={lang} dir={dir} title={seoTitle} description={pageDescription} slug={slug} meta={meta} enableFaqSchema={true}>
  <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} slot="head" />

  <div class="container content-wrapper">
    <header class="page-header">
      <h1>Paris Time: Complete Guide to Central European Time & CEST (2026)</h1>
      <div class="reading-meta">
        <span><strong>Author:</strong> {meta.author}</span> | 
        <span><strong>Last Updated:</strong> July 30, 2026</span> | 
        <span><strong>Reading Time:</strong> 15 mins</span>
      </div>
    </header>

    <!-- Top Answer Summary Box -->
    <div class="summary-box">
      <h2>Quick Summary: Current Time Rules in Paris</h2>
      <div class="summary-grid">
        <div class="summary-item">
          <strong>City & Country:</strong> Paris, France
        </div>
        <div class="summary-item">
          <strong>Primary Time Zone:</strong> Central European Time (CET)
        </div>
        <div class="summary-item">
          <strong>Standard Time Offset (Winter):</strong> CET (UTC+1 / GMT+1)
        </div>
        <div class="summary-item">
          <strong>Summer Time Offset (DST):</strong> CEST (UTC+2 / GMT+2)
        </div>
        <div class="summary-item">
          <strong>IANA Database Key:</strong> <code>Europe/Paris</code>
        </div>
        <div class="summary-item">
          <strong>Difference vs New York (Eastern Time):</strong> 6 hours ahead
        </div>
      </div>
    </div>

    <section class="content-section">
      <h2>Understanding Paris Local Time & Central European Time Mechanics</h2>
      <p>
        Paris, France serves as one of Europe's primary economic, cultural, and political capitals. As a founding center of international diplomacy, fashion, and continental finance, Paris operates under <strong>Central European Time (CET)</strong> during the winter and <strong>Central European Summer Time (CEST)</strong> during the summer.
      </p>
      <p>
        During standard winter time, Paris is positioned at <a href="/what-is-utc/">UTC+1</a>—exactly 1 hour ahead of <a href="/london-time/">London (GMT)</a> and 6 hours ahead of <a href="/new-york-time/">New York (EST)</a>. When Daylight Saving Time begins across Europe on the last Sunday of March, Paris advances its clocks by one hour to <a href="/cet-to-est/">UTC+2</a>.
      </p>
      <p>
        Because Paris is part of the harmonized European Union timezone framework, its time transition dates match those of <a href="/berlin-time/">Berlin</a>, Madrid, Rome, Amsterdam, and Brussels. Understanding Paris time is essential for tracking Euronext Paris market equity trading, scheduling corporate video conferences, and coordinating international travel through Charles de Gaulle Airport (CDG).
      </p>

      <div class="info-callout">
        <h3>Key Concept: The 6-Hour Transatlantic Difference</h3>
        <p>
          Paris is consistently <strong>6 hours ahead of US Eastern Time</strong> (New York / Miami / Toronto). When standard business begins at 9:00 AM in New York, the time in Paris is already 3:00 PM (15:00 CET/CEST), leaving a 2.5 to 3 hour window for real-time collaboration.
        </p>
      </div>
    </section>

    <!-- Visual SVG Diagram 1 -->
    <section class="content-section">
      <h2>Paris Time Offset & European Daylight Saving Visual Diagram</h2>
      <p>
        The diagram below visualizes Paris's location across European meridians relative to GMT, UTC, and US Eastern Standard Time.
      </p>

      <div class="svg-diagram-container">
        <svg viewBox="0 0 800 340" width="100%" height="auto" xmlns="http://www.w3.org/2000/svg" aria-label="Paris Time Zone Offset Diagram">
          <rect width="800" height="340" fill="var(--panel)" rx="12" stroke="var(--line)" stroke-width="2"/>
          <text x="400" y="38" fill="var(--accent)" font-family="Space Grotesk, sans-serif" font-size="20" font-weight="bold" text-anchor="middle">Paris (Europe/Paris) Time Offset Map</text>

          <!-- Timeline Axis -->
          <line x1="60" y1="120" x2="740" y2="120" stroke="var(--line)" stroke-width="4"/>

          <!-- NY Marker -->
          <circle cx="120" cy="120" r="8" fill="var(--accent-2)"/>
          <text x="120" y="95" fill="var(--text)" font-size="13" font-weight="bold" text-anchor="middle">New York (EST/EDT)</text>
          <text x="120" y="150" fill="var(--muted)" font-size="12" text-anchor="middle">UTC-5 / UTC-4</text>

          <!-- GMT / London Marker -->
          <circle cx="340" cy="120" r="8" fill="#8fd7ff"/>
          <text x="340" y="95" fill="var(--text)" font-size="13" text-anchor="middle">London (GMT/BST)</text>
          <text x="340" y="150" fill="var(--muted)" font-size="12" text-anchor="middle">UTC+0 / UTC+1</text>

          <!-- Paris Marker -->
          <circle cx="480" cy="120" r="12" fill="#36c7b5" stroke="#ffffff" stroke-width="3"/>
          <text x="480" y="90" fill="var(--accent)" font-size="16" font-weight="bold" text-anchor="middle">PARIS</text>
          <text x="480" y="150" fill="var(--text)" font-weight="bold" font-size="13" text-anchor="middle">UTC+1 (CET) / UTC+2 (CEST)</text>

          <!-- Tokyo Marker -->
          <circle cx="700" cy="120" r="8" fill="var(--accent-2)"/>
          <text x="700" y="95" fill="var(--text)" font-size="13" text-anchor="middle">Tokyo (JST)</text>
          <text x="700" y="150" fill="var(--muted)" font-size="12" text-anchor="middle">UTC+9</text>

          <!-- Seasonal Box -->
          <rect x="180" y="190" width="440" height="115" fill="var(--bg)" rx="8" stroke="var(--line)" stroke-width="1.5"/>
          <text x="400" y="218" fill="var(--text)" font-family="Space Grotesk, sans-serif" font-size="15" font-weight="bold" text-anchor="middle">EU Daylight Saving Time Transitions</text>
          <text x="400" y="248" fill="var(--muted)" font-size="13" text-anchor="middle">Last Sunday in March: Advances 1h to CEST (UTC+2)</text>
          <text x="400" y="276" fill="var(--muted)" font-size="13" text-anchor="middle">Last Sunday in October: Reverts 1h to CET (UTC+1)</text>
        </svg>
      </div>
    </section>

    <section class="content-section">
      <h2>European Union Daylight Saving Schedule for Paris (2026–2028)</h2>
      <p>
        France adheres to European Union Directive 2000/84/EC, which synchronizes daylight saving clock adjustments across all EU member states.
      </p>

      <div class="table-responsive">
        <table class="comparison-table">
          <thead>
            <tr>
              <th>Year</th>
              <th>Summer Time Begins (Clocks Spring Forward +1 hr)</th>
              <th>Summer Time Ends (Clocks Fall Back -1 hr)</th>
              <th>Active Local Offset</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>2026</strong></td>
              <td>March 29, 2026 (2:00 AM CET &rarr; 3:00 AM CEST)</td>
              <td>October 25, 2026 (3:00 AM CEST &rarr; 2:00 AM CET)</td>
              <td>CEST (UTC+2)</td>
            </tr>
            <tr>
              <td><strong>2027</strong></td>
              <td>March 28, 2027 (2:00 AM CET &rarr; 3:00 AM CEST)</td>
              <td>October 31, 2027 (3:00 AM CEST &rarr; 2:00 AM CET)</td>
              <td>CEST (UTC+2)</td>
            </tr>
            <tr>
              <td><strong>2028</strong></td>
              <td>March 26, 2028 (2:00 AM CET &rarr; 3:00 AM CEST)</td>
              <td>October 29, 2028 (3:00 AM CEST &rarr; 2:00 AM CET)</td>
              <td>CEST (UTC+2)</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="content-section">
      <h2>Euronext Paris Trading Hours & Global Market Overlap</h2>
      <p>
        Euronext Paris is one of the centerpiece exchanges of the European continent. Core trading hours for CAC 40 listed equities run from 9:00 AM to 5:30 PM CEST/CET Monday through Friday.
      </p>

      <div class="table-responsive">
        <table class="comparison-table">
          <thead>
            <tr>
              <th>Financial Exchange</th>
              <th>Local Market Hours</th>
              <th>Equivalent Paris Time (CEST / Summer)</th>
              <th>Overlap Window</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Euronext Paris</strong></td>
              <td>9:00 AM – 5:30 PM CEST</td>
              <td>9:00 AM – 5:30 PM CEST</td>
              <td>Base European Trading Session</td>
            </tr>
            <tr>
              <td><strong>London Stock Exchange (LSE)</strong></td>
              <td>8:00 AM – 4:30 PM BST</td>
              <td>9:00 AM – 5:30 PM CEST</td>
              <td>Full 100% 8.5-hour trading overlap</td>
            </tr>
            <tr>
              <td><strong>NYSE / NASDAQ (New York)</strong></td>
              <td>9:30 AM – 4:00 PM EDT</td>
              <td>3:30 PM – 10:00 PM CEST</td>
              <td>2-hour afternoon overlap (3:30 PM – 5:30 PM Paris)</td>
            </tr>
            <tr>
              <td><strong>Tokyo Stock Exchange (TSE)</strong></td>
              <td>9:00 AM – 3:00 PM JST</td>
              <td>2:00 AM – 8:00 AM CEST</td>
              <td>No standard daytime equity overlap</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="tip-box">
        <h3>Pro Scheduling Tip for Paris & US Teams</h3>
        <p>
          To host a seamless meeting between teams in Paris and North America, choose <strong>3:30 PM to 5:00 PM Paris time</strong>. This falls between 9:30 AM and 11:00 AM in New York and 6:30 AM and 8:00 AM in California.
        </p>
      </div>
    </section>

    <!-- Visual SVG Diagram 2 -->
    <section class="content-section">
      <h2>Paris Workday Global Overlap Matrix</h2>
      <div class="svg-diagram-container">
        <svg viewBox="0 0 800 260" width="100%" height="auto" xmlns="http://www.w3.org/2000/svg" aria-label="Paris Workday Overlap Matrix">
          <rect width="800" height="260" fill="var(--panel)" rx="12" stroke="var(--line)" stroke-width="2"/>
          <text x="400" y="35" fill="var(--accent)" font-family="Space Grotesk, sans-serif" font-size="18" font-weight="bold" text-anchor="middle">Standard Workday Overlap with Paris (9:00 AM - 6:00 PM CEST)</text>

          <!-- Paris -->
          <text x="120" y="80" fill="var(--text)" font-weight="bold" font-size="14">Paris (CEST)</text>
          <rect x="220" y="65" width="480" height="22" fill="#36c7b5" rx="4"/>
          <text x="460" y="81" fill="#0c354a" font-size="12" font-weight="bold" text-anchor="middle">9:00 AM – 6:00 PM CEST (Base Workday)</text>

          <!-- London -->
          <text x="120" y="130" fill="var(--text)" font-size="14">London (BST)</text>
          <rect x="220" y="115" width="420" height="22" fill="#8fd7ff" rx="4"/>
          <text x="430" y="131" fill="#0c354a" font-size="11" font-weight="bold" text-anchor="middle">Overlap: 9 AM - 5 PM CEST</text>

          <!-- New York -->
          <text x="120" y="180" fill="var(--text)" font-size="14">New York (EDT)</text>
          <rect x="520" y="165" width="180" height="22" fill="#8fd7ff" rx="4"/>
          <text x="610" y="181" fill="#0c354a" font-size="11" font-weight="bold" text-anchor="middle">Overlap: 3 PM - 6 PM CEST</text>

          <!-- Dubai -->
          <text x="120" y="230" fill="var(--text)" font-size="14">Dubai (GST)</text>
          <rect x="220" y="215" width="300" height="22" fill="#ffd166" rx="4"/>
          <text x="370" y="231" fill="#0c354a" font-size="11" font-weight="bold" text-anchor="middle">Overlap: 9 AM - 3 PM CEST</text>
        </svg>
      </div>
    </section>

    <section class="content-section">
      <h2>Paris Direct Time Conversion Reference Table</h2>
      <div class="table-responsive">
        <table class="comparison-table">
          <thead>
            <tr>
              <th>Paris Local Time (CEST)</th>
              <th>UTC / GMT Offset</th>
              <th>London Time (BST)</th>
              <th>New York Time (EDT)</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>00:00 (Midnight)</td><td>22:00 UTC (Prev. Day)</td><td>11:00 PM BST (Prev. Day)</td><td>06:00 PM EDT (Prev. Day)</td></tr>
            <tr><td>03:00 AM</td><td>01:00 UTC</td><td>02:00 AM BST</td><td>09:00 PM EDT (Prev. Day)</td></tr>
            <tr><td>06:00 AM</td><td>04:00 UTC</td><td>05:00 AM BST</td><td>12:00 AM EDT</td></tr>
            <tr><td>09:00 AM</td><td>07:00 UTC</td><td>08:00 AM BST</td><td>03:00 AM EDT</td></tr>
            <tr><td>12:00 PM (Noon)</td><td>10:00 UTC</td><td>11:00 AM BST</td><td>06:00 AM EDT</td></tr>
            <tr><td>03:00 PM</td><td>13:00 UTC</td><td>02:00 PM BST</td><td>09:00 AM EDT</td></tr>
            <tr><td>06:00 PM</td><td>16:00 UTC</td><td>05:00 PM BST</td><td>12:00 PM EDT</td></tr>
            <tr><td>09:00 PM</td><td>19:00 UTC</td><td>08:00 PM BST</td><td>03:00 PM EDT</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="content-section faq-section">
      <h2>Frequently Asked Questions About Paris Time</h2>
      <div class="faq-list">
        {meta.faqs.map((faq) => (
          <details class="faq-item">
            <summary class="faq-question">{faq.q}</summary>
            <div class="faq-answer">
              <p>{faq.a}</p>
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- Widgets Section -->
    <RelatedConvertersWidget slug={slug} />
    <UsersAlsoVisitWidget slug={slug} />
    <LearnMoreWidget slug={slug} />
    <CountryCityWidget slug={slug} />
  </div>
</BaseLayout>

<style>
  .content-wrapper {
    padding-top: 2rem;
    padding-bottom: 4rem;
    max-width: 1100px;
    margin: 0 auto;
  }
  .page-header h1 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 2.3rem;
    color: var(--text);
    margin-bottom: 0.5rem;
  }
  .reading-meta {
    font-size: 0.9rem;
    color: var(--muted);
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }
  .summary-box {
    background: var(--panel);
    border: 2px solid var(--accent);
    border-radius: 12px;
    padding: 1.8rem;
    margin-bottom: 2.5rem;
  }
  .summary-box h2 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.4rem;
    color: var(--accent);
    margin-top: 0;
    margin-bottom: 1.2rem;
  }
  .summary-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }
  .summary-item {
    background: var(--bg);
    padding: 0.9rem 1.1rem;
    border-radius: 8px;
    border: 1px solid var(--line);
    font-size: 0.95rem;
  }
  .summary-item strong {
    display: block;
    color: var(--accent-2);
    margin-bottom: 0.25rem;
  }
  .content-section {
    margin-bottom: 3rem;
  }
  .content-section h2 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.7rem;
    color: var(--text);
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.4rem;
  }
  .content-section p {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--muted);
    margin-bottom: 1.2rem;
  }
  .info-callout, .tip-box {
    background: var(--panel);
    border-left: 4px solid var(--accent);
    padding: 1.3rem 1.6rem;
    border-radius: 6px;
    margin: 1.8rem 0;
  }
  .info-callout h3, .tip-box h3 {
    margin-top: 0;
    font-family: 'Space Grotesk', sans-serif;
    color: var(--accent);
    font-size: 1.2rem;
  }
  .svg-diagram-container {
    margin: 2rem 0;
    background: var(--bg);
    padding: 1rem;
    border-radius: 12px;
    border: 1px solid var(--line);
  }
  .table-responsive {
    overflow-x: auto;
    margin: 1.8rem 0;
  }
  .comparison-table {
    width: 100%;
    border-collapse: collapse;
    background: var(--panel);
    border-radius: 8px;
    overflow: hidden;
  }
  .comparison-table th, .comparison-table td {
    padding: 1rem;
    text-align: left;
    border-bottom: 1px solid var(--line);
    font-size: 0.95rem;
  }
  .comparison-table th {
    background: var(--bg);
    color: var(--accent-2);
    font-family: 'Space Grotesk', sans-serif;
  }
  .faq-section details {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
    margin-bottom: 1rem;
    padding: 1rem 1.2rem;
