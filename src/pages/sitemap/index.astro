---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import { getPageMeta } from "theme/i18n/config";

const metaBase = getPageMeta("en", "sitemap");
const meta = { ...metaBase, keywords: "GMT to EST sitemap, sitemap, site map, site index" };
---

<BaseLayout lang="en" dir="ltr" title={meta.title} description={meta.description} slug="sitemap" meta={meta}>
  <section class="content" aria-labelledby="sitemap">
    <h1 id="sitemap">{meta.title}</h1>
    <p>This page lists the major pages on the site for easy navigation.</p>
    <ul>
      <li><a href="/">Home</a></li>
      <li><a href="/gmt-to-est/">GMT to EST Converter</a></li>
      <li><a href="/est-to-gmt/">EST to GMT Converter</a></li>
      <li><a href="/gmt-vs-est/">GMT vs EST Difference</a></li>
      <li><a href="/time-zone-guide/">Time Zone Guide</a></li>
      <li><a href="/about-us/">About Us</a></li>
      <li><a href="/contact-us/">Contact Us</a></li>
      <li><a href="/privacy-policy/">Privacy Policy</a></li>
      <li><a href="/disclaimer/">Disclaimer</a></li>
    </ul>
    <p>Machine-readable sitemap: <a href="/sitemap.xml">sitemap.xml</a></p>
  </section>
</BaseLayout>
