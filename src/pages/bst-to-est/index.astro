      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 100" width="900" height="100" style="display: block;">
        <rect x="20" y="40" width="860" height="16" fill="#1b536e" rx="8" />
        <g transform="translate(60, 48)">
          <circle cx="0" cy="0" r="7" fill="#36c7b5" />
          <text x="0" y="-18" font-family="'Space Grotesk', sans-serif" font-size="10" font-weight="bold" fill="#bdd2dc" text-anchor="middle">6 AM BST</text>
          <text x="0" y="26" font-family="'Manrope', sans-serif" font-size="10" fill="#8fd7ff" text-anchor="middle">12 AM EST</text>
        </g>
        <g transform="translate(280, 48)">
