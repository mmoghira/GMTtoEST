---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import HomePage from "theme/components/HomePage.astro";
import { getLang, getPageMeta, getTranslation, languages, pages } from "theme/i18n/config";

export function getStaticPaths() {
  return languages.filter(lang => lang.code !== "en").flatMap((lang) =>
    pages.filter((page) => page.slug).map((page) => ({
      params: { lang: lang.code, slug: page.slug },
      props: { page }
    }))
  );
}

const lang = getLang(Astro.params.lang || "en");
const { page } = Astro.props;
const t = getTranslation(lang.code);
const meta = getPageMeta(lang.code, page.labelKey, page.context);
const title = meta.title;
const description = meta.description;
const mode = page.kind === "reverse" ? "est-gmt" : "gmt-est";
const mainTranslatedSlugs = ["", "gmt-to-est", "est-to-gmt", "gmt-vs-est", "time-zone-guide"];
const isMainPage = mainTranslatedSlugs.includes(page.slug);
const robots = "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1";
---

<BaseLayout lang={lang.code} dir={lang.dir} title={title} description={description} slug={page.slug} meta={meta} mode={mode} enableFaqSchema={true} robots={robots}>
  <HomePage labelKey={page.labelKey} title={title} description={description} kind={page.kind} t={t} context={page.context} lang={lang.code} primaryKeyword={meta.title} meta={meta} />
</BaseLayout>
