---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import HomePage from "theme/components/HomePage.astro";
import { getLang, getPageMeta, getTranslation, languages } from "theme/i18n/config";

export function getStaticPaths() {
  return languages.filter(lang => lang.code !== "en").map((lang) => ({ params: { lang: lang.code } }));
}

const lang = getLang(Astro.params.lang || "en");
const t = getTranslation(lang.code);
const meta = getPageMeta(lang.code, "home");
---

<BaseLayout lang={lang.code} dir={lang.dir} title={meta.title} description={meta.description} enableFaqSchema={true}>
  <HomePage title={meta.title} description={meta.description} kind="converter" t={t} />
</BaseLayout>
