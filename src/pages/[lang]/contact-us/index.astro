---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import { getLang, getPageMeta, languages, siteUrl } from "theme/i18n/config";

export function getStaticPaths() {
  return languages.filter(lang => lang.code !== "en").map((lang) => ({ params: { lang: lang.code } }));
}

const lang = getLang(Astro.params.lang);
const isDe = lang.code === "de";
const isFr = lang.code === "fr";
const isIt = lang.code === "it";
const email    = "contact@gmttoestconverter.com";
const metaBase = getPageMeta(lang.code, "contact");
const meta = {
  ...metaBase,
  title: isDe ? "Kontakt | GMT zu EST Umrechner" : isFr ? "Contactez-nous | Convertisseur GMT vers EST" : isIt ? "Contattaci | Convertitore da GMT a EST" : (lang.code === "th" ? "ติดต่อเรา | GMT to EST Converter" : metaBase.title),
  description: isDe ? "Kontaktieren Sie das Team von GMT zu EST Umrechner für Fragen, Feedback, Funktionswünsche oder Partnerschaften." : isFr ? "Contactez l'équipe du Convertisseur GMT vers EST pour vos questions, remarques, suggestions d'amélioration ou partenariats." : isIt ? "Contatta il team del Convertitore da GMT a EST per chiarimenti, segnalazioni di errori o richieste di supporto." : (lang.code === "th" ? "ติดต่อทีมงาน GMT to EST Converter เพื่อแจ้งปัญหา สอบถามข้อมูลทั่วไป หรือแนะนำข้อเสนอแนะต่างๆ" : metaBase.description),
  keywords: "contact GMT to EST, GMT to EST support, GMT to EST feedback, timezone converter contact",
  robots: "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"
};
const title = meta.title;
const description = meta.description;

const pageCanonical = `${siteUrl}/${lang.code}/contact-us/`;

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "@id": `${pageCanonical}#webpage`,
    url: pageCanonical,
    name: title,
    description,
    inLanguage: lang.code,
    isPartOf: {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      url: siteUrl,
      name: isDe ? "GMT zu EST Umrechner" : isFr ? "Convertisseur GMT vers EST" : isIt ? "Convertitore da GMT a EST" : "GMT to EST Converter"
    },
    breadcrumb: {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: isDe ? "Startseite" : isFr ? "Accueil" : isIt ? "Home" : "Home", item: `${siteUrl}/${lang.code}/` },
        { "@type": "ListItem", position: 2, name: isDe ? "Kontakt" : isFr ? "Contactez-nous" : isIt ? "Contattaci" : (lang.code === "th" ? "ติดต่อเรา" : "Contact Us"), item: pageCanonical }
      ]
    }
  }
];
---

<BaseLayout lang={lang.code} dir={lang.dir} title={title} description={description} slug="contact-us" meta={meta}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} slot="head" />

  <section class="contact-page" aria-labelledby="contact-heading">

    {isFr ? (
      <div class="contact-header">
        <h1 id="contact-heading">Contactez-nous</h1>
        <p>Vous avez une question, une remarque ou une suggestion d'amélioration ? Remplissez le formulaire ci-dessous et notre équipe vous répondra sous 1 à 2 jours ouvrés.</p>
        <p class="contact-email-line">
          Ou écrivez-nous directement par e-mail :
          <a href={`mailto:${email}`}>{email}</a>
        </p>
      </div>

      <!-- Success message -->
      <div class="contact-success" id="contact-success" hidden>
        <span class="success-icon">✓</span>
        <div>
          <strong>Message envoyé avec succès !</strong>
          <p>Merci de nous avoir contactés. Nous vous répondrons dans un délai de 1 à 2 jours ouvrés.</p>
        </div>
      </div>

      <!-- Contact Form -->
      <form
        id="contact-form"
        class="contact-form"
        action={`https://formsubmit.co/${email}`}
        method="POST"
      >
        <input type="hidden" name="_subject"  value="Nouveau message depuis gmttoestconverter.com (FR)" />
        <input type="hidden" name="_captcha"  value="false" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_next"     value={`${siteUrl}/${lang.code}/contact-us/?sent=1`} />
        <input type="text"   name="_honey"    style="display:none" tabindex="-1" autocomplete="off" />

        <div class="form-row">
          <div class="form-field">
            <label for="cf-name">Nom complet <span class="req">*</span></label>
            <input id="cf-name" type="text" name="name" placeholder="Jean Dupont" required autocomplete="name" />
          </div>
          <div class="form-field">
            <label for="cf-email">Adresse e-mail <span class="req">*</span></label>
            <input id="cf-email" type="email" name="email" placeholder="nom@exemple.fr" required autocomplete="email" />
          </div>
        </div>

        <div class="form-field">
          <label for="cf-subject">Sujet <span class="req">*</span></label>
          <select id="cf-subject" name="subject" required>
            <option value="" disabled selected>Sélectionnez un sujet…</option>
            <option value="General Question">Question générale</option>
            <option value="Bug Report">Signaler une anomalie (Bug Report)</option>
            <option value="Feature Request">Suggestion de fonctionnalité</option>
            <option value="Translation Help">Aide à la traduction</option>
            <option value="Partnership / Advertising">Partenariat / Collaboration</option>
            <option value="Privacy / Data Request">Demande relative aux données personnelles</option>
            <option value="Other">Autre</option>
          </select>
        </div>

        <div class="form-field">
          <label for="cf-message">Message <span class="req">*</span></label>
          <textarea id="cf-message" name="message" rows="6" placeholder="Comment pouvons-nous vous aider ?…" required></textarea>
        </div>

        <button type="submit" class="form-submit">
          Envoyer le message <span class="arrow">→</span>
        </button>

        <p class="form-note">
          En soumettant ce formulaire, vous acceptez notre <a href={`/${lang.code}/privacy-policy/`}>Politique de confidentialité</a>.
        </p>
      </form>
    ) : isDe ? (
      <div class="contact-header">
        <h1 id="contact-heading">Kontakt (Contact Us)</h1>
        <p>Haben Sie Fragen, Feedback oder Verbesserungsvorschläge? Füllen Sie das Formular aus und wir melden uns innerhalb von 1–2 Werktagen.</p>
        <p class="contact-email-line">
          Oder schreiben Sie uns direkt per E-Mail:
          <a href={`mailto:${email}`}>{email}</a>
        </p>
      </div>

      <!-- Success message -->
      <div class="contact-success" id="contact-success" hidden>
        <span class="success-icon">✓</span>
        <div>
          <strong>Nachricht erfolgreich gesendet!</strong>
          <p>Vielen Dank für Ihre Kontaktaufnahme. Wir antworten in der Regel innerhalb von 1–2 Werktagen.</p>
        </div>
      </div>

      <!-- Contact Form -->
      <form
        id="contact-form"
        class="contact-form"
        action={`https://formsubmit.co/${email}`}
        method="POST"
      >
        <input type="hidden" name="_subject"  value="New contact from gmttoestconverter.com (DE)" />
        <input type="hidden" name="_captcha"  value="false" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_next"     value={`${siteUrl}/${lang.code}/contact-us/?sent=1`} />
        <input type="text"   name="_honey"    style="display:none" tabindex="-1" autocomplete="off" />

        <div class="form-row">
          <div class="form-field">
            <label for="cf-name">Vollständiger Name <span class="req">*</span></label>
            <input id="cf-name" type="text" name="name" placeholder="Max Mustermann" required autocomplete="name" />
          </div>
          <div class="form-field">
            <label for="cf-email">E-Mail-Adresse <span class="req">*</span></label>
            <input id="cf-email" type="email" name="email" placeholder="name@beispiel.de" required autocomplete="email" />
          </div>
        </div>

        <div class="form-field">
          <label for="cf-subject">Betreff <span class="req">*</span></label>
          <select id="cf-subject" name="subject" required>
            <option value="" disabled selected>Betreff auswählen…</option>
            <option value="General Question">Allgemeine Anfrage</option>
            <option value="Bug Report">Fehler melden (Bug Report)</option>
            <option value="Feature Request">Funktionsvorschlag</option>
            <option value="Translation Help">Übersetzungshilfe</option>
            <option value="Partnership / Advertising">Kooperation / Partnerschaft</option>
            <option value="Privacy / Data Request">Datenschutzanfrage</option>
            <option value="Other">Sonstiges</option>
          </select>
        </div>

        <div class="form-field">
          <label for="cf-message">Nachricht <span class="req">*</span></label>
          <textarea id="cf-message" name="message" rows="6" placeholder="Wie können wir Ihnen helfen?…" required></textarea>
        </div>

        <button type="submit" class="form-submit">
          Nachricht senden <span class="arrow">→</span>
        </button>

        <p class="form-note">
          Mit dem Absenden erklären Sie sich mit unserer <a href={`/${lang.code}/privacy-policy/`}>Datenschutzerklärung</a> einverstanden.
        </p>
      </form>
    ) : lang.code === "th" ? (
      <div class="contact-header">
        <h1 id="contact-heading">ติดต่อเรา (Contact Us)</h1>
        <p>มีคำถามหรือข้อเสนอแนะใช่หรือไม่? กรอกแบบฟอร์มด้านล่างแล้วเราจะติดต่อกลับภายใน 1–2 วันทำการ</p>
        <p class="contact-email-line">
          หรือส่งอีเมลถึงเราโดยตรงที่:
          <a href={`mailto:${email}`}>{email}</a>
        </p>
      </div>

      <!-- Success message -->
      <div class="contact-success" id="contact-success" hidden>
        <span class="success-icon">✓</span>
        <div>
          <strong>ส่งข้อความเรียบร้อยแล้ว!</strong>
          <p>ขอบคุณที่ติดต่อเรา เราจะตอบกลับภายใน 1–2 วันทำการ</p>
        </div>
      </div>

      <!-- Contact Form -->
      <form
        id="contact-form"
        class="contact-form"
        action={`https://formsubmit.co/${email}`}
        method="POST"
      >
        <input type="hidden" name="_subject"  value="New contact from gmttoestconverter.com" />
        <input type="hidden" name="_captcha"  value="false" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_next"     value={`${siteUrl}/${lang.code}/contact-us/?sent=1`} />
        <input type="text"   name="_honey"    style="display:none" tabindex="-1" autocomplete="off" />

        <div class="form-row">
          <div class="form-field">
            <label for="cf-name">ชื่อ-นามสกุล <span class="req">*</span></label>
            <input id="cf-name" type="text" name="name" placeholder="สมชาย รักดี" required autocomplete="name" />
          </div>
          <div class="form-field">
            <label for="cf-email">ที่อยู่อีเมล <span class="req">*</span></label>
            <input id="cf-email" type="email" name="email" placeholder="you@example.com" required autocomplete="email" />
          </div>
        </div>

        <div class="form-field">
          <label for="cf-subject">หัวข้อ <span class="req">*</span></label>
          <select id="cf-subject" name="subject" required>
            <option value="" disabled selected>เลือกหัวข้อ...</option>
            <option value="General Question">คำถามทั่วไป</option>
            <option value="Bug Report">รายงานข้อผิดพลาด (บั๊ก)</option>
            <option value="Feature Request">ขอฟีเจอร์ใหม่</option>
            <option value="Translation Help">ช่วยเหลือเรื่องการแปล</option>
            <option value="Partnership / Advertising">พันธมิตร / โฆษณา</option>
            <option value="Privacy / Data Request">ความเป็นส่วนตัว / ขอข้อมูล</option>
            <option value="Other">อื่นๆ</option>
          </select>
        </div>

        <div class="form-field">
          <label for="cf-message">ข้อความ <span class="req">*</span></label>
          <textarea id="cf-message" name="message" rows="6" placeholder="บอกเราว่าเราสามารถช่วยเหลือคุณได้อย่างไร..." required></textarea>
        </div>

        <button type="submit" class="form-submit">
          ส่งข้อความ <span class="arrow">→</span>
        </button>

        <p class="form-note">
          การส่งแบบฟอร์มนี้แสดงว่าคุณยอมรับ <a href="/privacy-policy/">นโยบายความเป็นส่วนตัว</a> ของเรา
        </p>
      </form>
    ) : isIt ? (
      <div class="contact-header">
        <h1 id="contact-heading">Contattaci</h1>
        <p>Hai una domanda, un commento o un suggerimento? Compila il modulo sottostante e il nostro team ti risponderà entro 1–2 giorni lavorativi.</p>
        <p class="contact-email-line">
          Oppure scrivici direttamente via e-mail:
          <a href={`mailto:${email}`}>{email}</a>
        </p>
      </div>

      <!-- Success message -->
      <div class="contact-success" id="contact-success" hidden>
        <span class="success-icon">✓</span>
        <div>
          <strong>Messaggio inviato con successo!</strong>
          <p>Grazie per averci contattato. Ti risponderemo entro 1–2 giorni lavorativi.</p>
        </div>
      </div>

      <!-- Contact Form -->
      <form
        id="contact-form"
        class="contact-form"
        action={`https://formsubmit.co/${email}`}
        method="POST"
      >
        <input type="hidden" name="_subject"  value="Nuovo messaggio da gmttoestconverter.com (IT)" />
        <input type="hidden" name="_captcha"  value="false" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_next"     value={`${siteUrl}/${lang.code}/contact-us/?sent=1`} />
        <input type="text"   name="_honey"    style="display:none" tabindex="-1" autocomplete="off" />

        <div class="form-row">
          <div class="form-field">
            <label for="cf-name">Nome e cognome <span class="req">*</span></label>
            <input id="cf-name" type="text" name="name" placeholder="Mario Rossi" required autocomplete="name" />
          </div>
          <div class="form-field">
            <label for="cf-email">Indirizzo e-mail <span class="req">*</span></label>
            <input id="cf-email" type="email" name="email" placeholder="nome@esempio.it" required autocomplete="email" />
          </div>
        </div>

        <div class="form-field">
          <label for="cf-subject">Oggetto <span class="req">*</span></label>
          <select id="cf-subject" name="subject" required>
            <option value="" disabled selected>Seleziona un oggetto…</option>
            <option value="General Question">Domanda generale</option>
            <option value="Bug Report">Segnalazione bug / errore</option>
            <option value="Feature Request">Richiesta di funzionalità</option>
            <option value="Translation Help">Aiuto per le traduzioni</option>
            <option value="Partnership / Advertising">Partnership / Collaborazione</option>
            <option value="Privacy / Data Request">Richiesta dati / Privacy</option>
            <option value="Other">Altro</option>
          </select>
        </div>

        <div class="form-field">
          <label for="cf-message">Messaggio <span class="req">*</span></label>
          <textarea id="cf-message" name="message" rows="6" placeholder="Come possiamo aiutarti?…" required></textarea>
        </div>

        <button type="submit" class="form-submit">
          Invia messaggio <span class="arrow">→</span>
        </button>

        <p class="form-note">
          Inviando questo modulo accetti la nostra <a href={`/${lang.code}/privacy-policy/`}>Informativa sulla privacy</a>.
        </p>
      </form>
    ) : (
      <div class="contact-header">
        <h1 id="contact-heading">Contact Us</h1>
        <p>Have a question or feedback? Fill out the form below and we'll get back to you within 1–2 business days.</p>
        <p class="contact-email-line">
          Or email us directly at:
          <a href={`mailto:${email}`}>{email}</a>
        </p>
      </div>

      <!-- Success message -->
      <div class="contact-success" id="contact-success" hidden>
        <span class="success-icon">✓</span>
        <div>
          <strong>Message sent!</strong>
          <p>Thanks for reaching out. We'll reply within 1–2 business days.</p>
        </div>
      </div>

      <!-- Contact Form -->
      <form
        id="contact-form"
        class="contact-form"
        action={`https://formsubmit.co/${email}`}
        method="POST"
      >
        <input type="hidden" name="_subject"  value="New contact from gmttoestconverter.com" />
        <input type="hidden" name="_captcha"  value="false" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_next"     value={`${siteUrl}/${lang.code}/contact-us/?sent=1`} />
        <input type="text"   name="_honey"    style="display:none" tabindex="-1" autocomplete="off" />

        <div class="form-row">
          <div class="form-field">
            <label for="cf-name">Full Name <span class="req">*</span></label>
            <input id="cf-name" type="text" name="name" placeholder="John Smith" required autocomplete="name" />
          </div>
          <div class="form-field">
            <label for="cf-email">Email Address <span class="req">*</span></label>
            <input id="cf-email" type="email" name="email" placeholder="you@example.com" required autocomplete="email" />
          </div>
        </div>

        <div class="form-field">
          <label for="cf-subject">Subject <span class="req">*</span></label>
          <select id="cf-subject" name="subject" required>
            <option value="" disabled selected>Select a subject…</option>
            <option value="General Question">General Question</option>
            <option value="Bug Report">Bug Report</option>
            <option value="Feature Request">Feature Request</option>
            <option value="Translation Help">Translation Help</option>
            <option value="Partnership / Advertising">Partnership / Advertising</option>
            <option value="Privacy / Data Request">Privacy / Data Request</option>
            <option value="Other">Other</option>
          </select>
        </div>

        <div class="form-field">
          <label for="cf-message">Message <span class="req">*</span></label>
          <textarea id="cf-message" name="message" rows="6" placeholder="Tell us how we can help…" required></textarea>
        </div>

        <button type="submit" class="form-submit">
          Send Message <span class="arrow">→</span>
        </button>

        <p class="form-note">
          By submitting this form you agree to our <a href={`/${lang.code}/privacy-policy/`}>Privacy Policy</a>.
        </p>
      </form>
    )}

  </section>
</BaseLayout>

<script is:inline>
  (function () {
    const params  = new URLSearchParams(window.location.search);
    const success = document.getElementById('contact-success');
    const form    = document.getElementById('contact-form');
    if (params.get('sent') === '1' && success && form) {
      form.hidden    = true;
      success.hidden = false;
    }
  })();
</script>

<style>
  .contact-page {
    max-width: 680px;
    margin: 0 auto;
    padding: 3rem 1.5rem 5rem;
  }

  /* Header */
  .contact-header {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--line);
  }
  .contact-header h1 {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    font-weight: 800;
    margin: 0 0 0.75rem;
    color: var(--text);
  }
  .contact-header p {
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.65;
    margin: 0 0 0.5rem;
  }
  .contact-email-line a {
    color: var(--accent);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Success */
  .contact-success {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    background: color-mix(in srgb, #22c55e 10%, var(--panel));
    border: 1px solid #22c55e;
    border-radius: 12px;
    padding: 20px 24px;
    margin-bottom: 2rem;
  }
  .success-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    min-width: 34px;
    background: #22c55e;
    color: #fff;
    border-radius: 50%;
    font-weight: 700;
    font-size: 1rem;
  }
  .contact-success strong {
    display: block;
    color: var(--text);
    margin-bottom: 4px;
  }
  .contact-success p {
    color: var(--muted);
    font-size: 0.9rem;
    margin: 0;
  }

  /* Form */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .form-field {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  .form-field label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text);
  }
  .req { color: #ef4444; margin-left: 2px; }

  .form-field input,
  .form-field select,
  .form-field textarea {
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--text);
    font-size: 0.975rem;
    padding: 12px 14px;
    min-height: 48px;
    outline: none;
    font-family: inherit;
    width: 100%;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .form-field input::placeholder,
  .form-field textarea::placeholder {
    color: var(--muted);
    opacity: 0.65;
  }
  .form-field input:focus,
  .form-field select:focus,
  .form-field textarea:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 15%, transparent);
  }
  .form-field select { cursor: pointer; }
  .form-field textarea { resize: vertical; min-height: 150px; line-height: 1.6; }

  /* Submit */
  .form-submit {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--accent);
    color: #fff;
    border: none;
    border-radius: 10px;
    padding: 13px 28px;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    font-family: inherit;
    transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
    box-shadow: 0 4px 14px color-mix(in srgb, var(--accent) 28%, transparent);
    width: fit-content;
  }
  .form-submit:hover {
    background: color-mix(in srgb, var(--accent) 80%, #000);
    transform: translateY(-1px);
  }
  .form-submit:active { transform: translateY(0); }
  .arrow { transition: transform 0.2s; }
  .form-submit:hover .arrow { transform: translateX(4px); }

  /* Note */
  .form-note {
    font-size: 0.8rem;
    color: var(--muted);
    margin: 0;
    line-height: 1.5;
  }
  .form-note a {
    color: var(--accent);
