---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import { languages, getLang, siteUrl } from "theme/i18n/config";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const paths = [];
  
  languages.filter(l => l.code !== "en").forEach(lang => {
    // First find localized posts for this language
    const langPosts = posts.filter(post => post.id.startsWith(`${lang.code}/`));
    
    if (langPosts.length > 0) {
      langPosts.forEach(post => {
        const slug = post.id.split('/').slice(1).join('/');
        paths.push({ params: { lang: lang.code, slug }, props: { post, actualLang: lang.code } });
      });
    } else {
      // Fallback to English posts
      const enPosts = posts.filter(post => post.id.startsWith("en/"));
      enPosts.forEach(post => {
        const slug = post.id.split('/').slice(1).join('/');
        paths.push({ params: { lang: lang.code, slug }, props: { post, actualLang: "en" } });
      });
    }
  });
  
  return paths;
}

const { lang: paramLang } = Astro.params;
const { post, actualLang } = Astro.props;
const { Content } = await render(post);
const imageAlt = post.data.imageAlt || `${post.data.title} featured image`;
const responsiveImageBase = post.data.image?.endsWith("-1200.webp") ? post.data.image.replace("-1200.webp", "") : "";

const langObj = getLang(paramLang);
const pageUrl = `${siteUrl}/${langObj.code}/blog/${Astro.params.slug}/`;
const absoluteImage = post.data.image
  ? post.data.image.startsWith("http")
    ? post.data.image
    : `${siteUrl}${post.data.image}`
  : `${siteUrl}/favicon.png`;

const meta = {
  title: post.data.title,
  description: post.data.description,
  keywords: post.data.keywords,
  image: post.data.image,
  imageAlt,
  ogType: "article",
  twitterCard: "summary_large_image",
  pubDate: post.data.pubDate.toISOString(),
  updatedDate: (post.data.updatedDate || post.data.pubDate).toISOString(),
  preloadImage: responsiveImageBase ? `${responsiveImageBase}-1200.avif` : undefined,
  preloadImageSrcset: responsiveImageBase ? `${responsiveImageBase}-600.avif 600w, ${responsiveImageBase}-1200.avif 1200w` : undefined,
  preloadImageSizes: "(max-width: 760px) 100vw, 900px",
  preloadImageType: responsiveImageBase ? "image/avif" : undefined,
};
const sources = post.data.sources || [];
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": `${pageUrl}#article`,
  mainEntityOfPage: pageUrl,
  headline: post.data.title,
  description: post.data.description,
  image: absoluteImage,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate || post.data.pubDate).toISOString(),
  inLanguage: actualLang,
  keywords: post.data.keywords,
  author: {
    "@type": "Person",
    name: post.data.author || "Jackie Bruce",
    url: `${siteUrl}/author/jackie-bruce/`
  },
  publisher: {
    "@type": "Organization",
    name: "GMT to EST Converter",
    logo: {
      "@type": "ImageObject",
      url: `${siteUrl}/logo.svg`
    }
  },
  citation: sources.map((source) => source.url)
};
---

<BaseLayout lang={langObj.code} dir={langObj.dir} title={meta.title} description={meta.description} slug={`blog/${Astro.params.slug}`} meta={meta}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} slot="head" />

  <article class="content blog-post" aria-labelledby="post-title">
    {actualLang === "en" && langObj.code !== "en" && (
      <div style="background: var(--panel); border: 1px solid var(--accent); border-radius: 6px; padding: 1rem; margin-bottom: 2rem;">
        <p style="margin: 0; font-size: 0.9rem;"><em>Note: This article has not yet been translated and is currently available in English.</em></p>
      </div>
    )}
    
    <header class="post-header">
      <h1 id="post-title">{post.data.title}</h1>
      <div class="post-meta">
        <time datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toLocaleDateString(langObj.code, { year: "numeric", month: "long", day: "numeric" })}
        </time>
        {post.data.author && <span>By <a href="/author/jackie-bruce/" rel="author">{post.data.author}</a></span>}
      </div>
    </header>

    {post.data.image && (
      <figure class="post-hero">
        <picture>
          {responsiveImageBase && <source type="image/avif" srcset={`${responsiveImageBase}-600.avif 600w, ${responsiveImageBase}-1200.avif 1200w`} sizes="(max-width: 760px) 100vw, 900px" />}
          {responsiveImageBase && <source type="image/webp" srcset={`${responsiveImageBase}-600.webp 600w, ${responsiveImageBase}-1200.webp 1200w`} sizes="(max-width: 760px) 100vw, 900px" />}
          <img src={post.data.image} alt={imageAlt} width="1200" height="630" loading="eager" decoding="async" fetchpriority="high" />
        </picture>
      </figure>
    )}
    
    <div class="prose">
      <Content />
    </div>

    {post.data.author && (
      <section class="author-bio-card" aria-label="About the author">
        <div class="author-avatar">
          <span aria-hidden="true">{post.data.author.charAt(0)}</span>
        </div>
        <div class="author-info">
          <h3>Written by <a href="/author/jackie-bruce/" rel="author">{post.data.author}</a></h3>
          <p>Timezone Content Specialist covering GMT, EST, EDT, daylight saving time, and global scheduling.</p>
        </div>
      </section>
    )}

    {sources.length > 0 && (
      <section class="article-sources" aria-label="Sources and References">
        <h2 id="article-sources">Sources &amp; References</h2>
        <ol>
          {sources.map((source) => (
            <li>
              <a href={source.url} target="_blank" rel="noopener noreferrer nofollow">{source.title}</a>
              {source.publisher && <span> — {source.publisher}</span>}
            </li>
          ))}
        </ol>
      </section>
    )}
    
    <footer style="margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--line);">
      <a href={`/${langObj.code}/blog/`}>&larr; Back to Blog</a>
    </footer>
  </article>
</BaseLayout>

<style>
  /* Article-sources styles are in global.css */
</style>
