---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import { getPageMeta, siteUrl, languages, getLang } from "theme/i18n/config";

export function getStaticPaths() {
  return languages.filter(l => l.code !== "en").map(l => ({ params: { lang: l.code } }));
}

const lang = getLang(Astro.params.lang);
const metaBase = getPageMeta(lang.code, "home");
const meta = { title: "Blog - GMT to EST", description: "Read the latest updates and articles about GMT and EST timezone conversions." };

const pageUrl = `${siteUrl}/${lang.code}/blog/`;
---

<BaseLayout lang={lang.code} dir={lang.dir} title={meta.title} description={meta.description} slug="blog" meta={meta}>
  <section class="content" aria-labelledby="blog-title">
    <h1 id="blog-title">Blog</h1>
    <p>Articles and guides are coming soon. Please check back later!</p>
  </section>
</BaseLayout>
