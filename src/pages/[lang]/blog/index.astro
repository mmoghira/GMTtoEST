---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import { getPageMeta, siteUrl, languages, getLang, getTranslation } from "theme/i18n/config";
import { getCollection } from "astro:content";
import { ensureKeywordInAlt, getPrimaryKeyword } from "theme/utils/seo";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const translatedLanguages = new Set(posts.map((post) => post.id.split("/")[0]));
  return languages
    .filter((language) => language.code !== "en" && translatedLanguages.has(language.code))
    .map((language) => ({ params: { lang: language.code } }));
}

const lang = getLang(Astro.params.lang);
const t = getTranslation(lang.code);
const isDe = lang.code === "de";
const isIt = lang.code === "it";

const meta = {
  title: isDe ? "Blog & Ratgeber | GMT zu EST Umrechner" : isIt ? "Blog & Guide ai fusi orari | Convertitore da GMT a EST" : (t.pages?.blog?.title || `Blog - ${t.brand || "GMT to EST"}`),
  description: isDe ? "Aktuelle Leitfäden, Zeitzonen-Updates und praktische Tipps zur Umrechnung zwischen GMT und Eastern Time." : isIt ? "Articoli, approfondimenti, guide pratiche e consigli sulla conversione di fuso orario tra GMT ed Eastern Time." : (t.pages?.blog?.description || "Read the latest updates and articles about GMT and EST timezone conversions."),
  keywords: isDe ? "GMT zu EST Blog, GMT EST Ratgeber, Zeitzonenumrechnung, Sommerzeit Artikel" : isIt ? "blog GMT EST, articoli fusi orari, guida ora legale, conversione oraria" : "GMT to EST blog, EST to GMT guides, timezone conversion articles, daylight saving time",
  image: "/assets/gmt-to-est-converter-featured-image-960.avif",
  imageAlt: isDe ? "GMT zu EST Blog und Zeitzonen-Ratgeber" : isIt ? "Blog del Convertitore da GMT a EST - guide ed eventi internazionali" : "GMT to EST Converter blog - timezone guides and conversion tips",
  robots: undefined
};

const pageUrl = `${siteUrl}/${lang.code}/blog/`;

const allPosts = await getCollection("blog");
const posts = allPosts
  .filter(post => post.id.startsWith(`${lang.code}/`))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout lang={lang.code} dir={lang.dir} title={meta.title} description={meta.description} slug="blog" meta={meta}>
  <section class="content blog-index" aria-labelledby="blog-title">
    <h1 id="blog-title">{isDe ? "Blog & Ratgeber" : isIt ? "Blog e Guide" : (t.nav?.blog || "Blog")}</h1>
    <p>{isDe ? "Aktuelle Leitfäden, Zeitzonen-Updates und praxisnahe Tipps zur Umrechnung zwischen GMT und Eastern Time." : isIt ? "Approfondimenti, guide operative e notizie per gestire al meglio le differenze di fuso orario e i cambi di stagione." : "Read the latest updates, guides, and articles about GMT and EST timezones."}</p>
    
    <div class="blog-grid">
      {posts.length === 0 ? (
        <p>{isDe ? "Noch keine Artikel in dieser Sprache veröffentlicht." : isIt ? "Nessun articolo ancora pubblicato in questa lingua." : "No articles published yet. Check back soon!"}</p>
      ) : (
        posts.map(post => {
          const slug = post.id.split('/').slice(1).join('/');
          const primaryKeyword = getPrimaryKeyword(post.data.keywords, post.data.title);
          const imageAlt = ensureKeywordInAlt(post.data.imageAlt, primaryKeyword, `${primaryKeyword} featured image`);
          const responsiveImageBase = post.data.image?.endsWith("-1200.webp") ? post.data.image.replace("-1200.webp", "") : "";
          return (
            <article class="blog-card">
              {post.data.image && (
                <a class="blog-card-image" href={`/${lang.code}/blog/${slug}/`} aria-label={post.data.title}>
                  <span class="sr-only">{post.data.title}</span>
                  <picture>
                    {responsiveImageBase && <source type="image/avif" srcset={`${responsiveImageBase}-600.avif 600w, ${responsiveImageBase}-1200.avif 1200w`} sizes="(max-width: 760px) 100vw, 360px" />}
                    {responsiveImageBase && <source type="image/webp" srcset={`${responsiveImageBase}-600.webp 600w, ${responsiveImageBase}-1200.webp 1200w`} sizes="(max-width: 760px) 100vw, 360px" />}
                    <img src={post.data.image} alt={imageAlt} width="1200" height="630" loading="lazy" decoding="async" />
                  </picture>
                </a>
              )}
              <div class="blog-card-body">
                <h2><a href={`/${lang.code}/blog/${slug}/`}>{post.data.title}</a></h2>
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString(lang.code, { year: "numeric", month: "long", day: "numeric" })}
                </time>
                <p>{post.data.description}</p>
                <a class="read-more" href={`/${lang.code}/blog/${slug}/`}>{isDe ? `Artikel lesen: ${post.data.title} \u2192` : isIt ? `Leggi l'articolo: ${post.data.title} \u2192` : `Read ${post.data.title} \u2192`}</a>
              </div>
            </article>
          );
        })
      )}
    </div>
  </section>
</BaseLayout>
