---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import HtmlSitemap from "theme/components/HtmlSitemap.astro";
import { getLang, getPageMeta, languages } from "theme/i18n/config";

export function getStaticPaths() {
  return languages.filter(lang => lang.code !== "en").map((lang) => ({ params: { lang: lang.code } }));
}

const lang = getLang(Astro.params.lang);
const metaBase = getPageMeta(lang.code, "sitemap");
const meta = { ...metaBase, keywords: "GMT to EST sitemap, sitemap, site map, site index", robots: "noindex,follow" };
---

<BaseLayout lang={lang.code} dir={lang.dir} title={meta.title} description={meta.description} slug="sitemap" meta={meta} allowAds={false}>
  <section class="content" aria-labelledby="sitemap">
    <h1 id="sitemap">{meta.title}</h1>
    <HtmlSitemap lang={lang.code} />
    <p>Machine-readable sitemap: <a href="/sitemap-index.xml">sitemap-index.xml</a></p>
  </section>
</BaseLayout>
