---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import { getLang, getPageMeta, languages, siteUrl } from "theme/i18n/config";

export function getStaticPaths() {
  return languages.filter(lang => lang.code !== "en").map((lang) => ({ params: { lang: lang.code } }));
}

const lang = getLang(Astro.params.lang);
const isDe = lang.code === "de";
const isFr = lang.code === "fr";
const isTr = lang.code === "tr";
const metaBase = getPageMeta(lang.code, "terms");
const meta = {
  ...metaBase,
  title: isTr ? "Kullanım Koşulları | GMT - EST Dönüştürücü" : isDe ? "Nutzungsbedingungen | GMT zu EST Umrechner" : isFr ? "Conditions d'utilisation | Convertisseur GMT vers EST" : (lang.code === "ja" ? "利用規約 | GMT to EST Converter" : metaBase.title),
  description: isTr ? "Kullanım Koşulları - GMT - EST Dönüştürücü. Hizmet şartları, fikri mülkiyet hakları, doğruluk taahhüdü ve yasal sorumluluk sınırları." : isDe ? "Nutzungsbedingungen für den GMT zu EST Umrechner. Erfahren Sie mehr über Richtlinien, Urheberrechte, Genauigkeit und Haftungsausschlüsse." : isFr ? "Conditions générales d'utilisation du Convertisseur GMT vers EST. Règles d'usage, propriété intellectuelle, précision des calculs et responsabilité." : (lang.code === "ja" ? "GMT to EST Converterの利用規約です。当サイトのご利用に関するルール、免責事項、免責制限について詳しく説明しています。" : metaBase.description),
  keywords: "terms of service, terms and conditions, GMT to EST terms, user agreement, acceptable use policy",
  robots: "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"
};
const title = meta.title;
const description = meta.description;

const pageUrl = `${siteUrl}/${lang.code}/terms-of-service/`;
const lastUpdated = isTr ? "16 Mayıs 2026" : isDe ? "16. Mai 2026" : isFr ? "16 mai 2026" : (lang.code === "ja" ? "2026年7月16日" : "May 8, 2025");

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${pageUrl}#webpage`,
    url: pageUrl,
    name: title,
    description,
    inLanguage: lang.code,
    dateModified: isDe ? "2026-05-16" : isFr ? "2026-05-16" : (lang.code === "ja" ? "2026-07-16" : "2025-05-08"),
    isPartOf: {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      url: siteUrl,
      name: isTr ? "GMT - EST Dönüştürücü" : isDe ? "GMT zu EST Umrechner" : isFr ? "Convertisseur GMT vers EST" : "GMT to EST Converter"
    },
    breadcrumb: {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: isTr ? "Ana Sayfa" : isDe ? "Startseite" : isFr ? "Accueil" : "Home", item: `${siteUrl}/${lang.code}/` },
        { "@type": "ListItem", position: 2, name: isTr ? "Kullanım Koşulları" : isDe ? "Nutzungsbedingungen" : isFr ? "Conditions d'utilisation" : (lang.code === "ja" ? "利用規約" : "Terms of Service"), item: pageUrl }
      ]
    },
    author: {
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      name: isDe ? "GMT zu EST Umrechner" : isFr ? "Convertisseur GMT vers EST" : "GMT to EST Converter"
    }
  }
];
---

<BaseLayout lang={lang.code} dir={lang.dir} title={title} description={description} slug="terms-of-service" meta={meta}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} slot="head" />

  <article class="tos-page">
    {isTr ? (
      <header class="tos-header">
        <h1>Kullanım Koşulları (Terms of Service)</h1>
        <p class="tos-meta">Son Güncelleme: <time datetime="2026-05-16">{lastUpdated}</time></p>
        <p class="tos-intro">
          Lütfen <strong>GMT - EST Dönüştürücü</strong> web sitesini kullanmadan önce bu kullanım koşullarını dikkatlice okuyunuz. Sitemize erişerek bu koşulları kabul etmiş sayılırsınız.
        </p>
      </header>

      <div class="tos-body">
        <section class="tos-section" aria-labelledby="acceptance-tr">
          <h2 id="acceptance-tr">1. Şartların Kabulü</h2>
          <p>
