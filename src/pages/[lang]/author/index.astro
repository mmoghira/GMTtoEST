---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import { getLang, getPageMeta, languages, siteUrl } from "theme/i18n/config";

export function getStaticPaths() {
  return languages.filter(lang => lang.code !== "en").map((lang) => ({ params: { lang: lang.code } }));
}

const lang = getLang(Astro.params.lang);
const isDe = lang.code === "de";
const isFr = lang.code === "fr";
const isIt = lang.code === "it";
const metaBase = getPageMeta(lang.code, "author");
const meta = {
  ...metaBase,
  title: isDe ? "Unser Autoren- und Redaktionsteam | GMT zu EST Umrechner" : isIt ? "Il nostro team editoriale e gli autori | Convertitore da GMT a EST" : metaBase.title,
  description: isDe ? "Lernen Sie die Experten und Redakteure hinter dem GMT zu EST Umrechner kennen. Spezialisten für Zeitzonen, Sommerzeit und globale Zeitkonvertierung." : isIt ? "Scopri gli esperti e i redattori del Convertitore da GMT a EST. Specialisti in sistemi di fuso orario, ora legale e conversione globale." : metaBase.description,
  keywords: "GMT to EST author, timezone author, GMT to EST editorial team, Jackie Bruce",
  robots: "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"
};
const title = meta.title;
const description = meta.description;
const pageUrl = `${siteUrl}/${lang.code}/author/`;

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${pageUrl}#webpage`,
  url: pageUrl,
  name: title,
  description,
  inLanguage: lang.code,
  mainEntity: {
    "@type": "ItemList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        url: `${siteUrl}/${lang.code}/author/jackie-bruce/`,
        item: {
          "@type": "Person",
          name: "Jackie Bruce",
          jobTitle: isFr ? "Spécialiste de la conversion de fuseaux horaires" : isDe ? "Spezialistin für Zeitzoneninhalte" : isIt ? "Specialista in contenuti sui fusi orari" : "Timezone Content Specialist"
        }
      }
    ]
  },
  breadcrumb: {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: isFr ? "Accueil" : isDe ? "Startseite" : isIt ? "Home" : "Home", item: `${siteUrl}/${lang.code}/` },
      { "@type": "ListItem", position: 2, name: isFr ? "Auteurs" : isDe ? "Autoren" : isIt ? "Autori" : "Author", item: pageUrl }
    ]
  }
};
---

<BaseLayout lang={lang.code} dir={lang.dir} title={title} description={description} slug="author" meta={meta}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} slot="head" />

  <section class="content author-hub" aria-labelledby="author-hub-title">
    <h1 id="author-hub-title">{isDe ? "Autoren- und Redaktionsteam" : isFr ? "Équipe éditoriale et auteurs" : isIt ? "Team editoriale e autori" : "Author"}</h1>
    <p>
      {isDe
        ? "Die Inhalte auf GMT zu EST Umrechner werden von einem spezialisierten Redaktionsteam verfasst und geprüft, das auf Zeitzonenpräzision, Sommerzeitumstellungen und praxistaugliche Terminplanung fokussiert ist."
        : isFr
          ? "Les contenus publiés sur Convertisseur GMT vers EST sont rédigés et vérifiés par une équipe éditoriale spécialisée dans la précision des fuseaux horaires, les transitions d'heure d'été et la planification internationale."
          : isIt
            ? "I contenuti del Convertitore da GMT a EST sono scritti e verificati da un team editoriale specializzato nella precisione dei fusi orari, nei passaggi all'ora legale e nella guida pratica alla pianificazione internazionale."
            : "GMT to EST Converter content is written and reviewed by a focused editorial team that specializes in timezone conversion accuracy, daylight saving transitions, and practical scheduling guidance."}
    </p>

    <article class="author-card" aria-labelledby="jackie-bruce">
      <h2 id="jackie-bruce">
        <a href={`/${lang.code}/author/jackie-bruce/`} rel="author">Jackie Bruce</a>
      </h2>
      <p class="role">{isDe ? "Spezialistin für Zeitzoneninhalte" : isFr ? "Spécialiste de la conversion de fuseaux horaires" : isIt ? "Specialista in contenuti sui fusi orari" : "Timezone Content Specialist"}</p>
      <p>
        {isDe
          ? "Jackie behandelt GMT, EST, EDT und datumsbezogene Umrechnungsszenarien für globale Teams, Events und internationale Zeitpläne."
          : isFr
            ? "Jackie couvre le GMT, l'EST, l'EDT et les scénarios de conversion tenant compte de la date pour les équipes distantes, les événements internationaux et la coordination globale."
            : isIt
              ? "Jackie si occupa di GMT, EST, EDT e scenari di conversione basati sulla data per team distribuiti, grandi eventi e coordinamento internazionale."
              : "Jackie covers GMT, EST, EDT, and date-aware conversion scenarios for remote teams, events, and international scheduling."}
      </p>
      <p><a class="profile-link" href={`/${lang.code}/author/jackie-bruce/`}>{isDe ? "Vollständiges Autorenprofil ansehen →" : isFr ? "Consulter le profil complet de l'auteure →" : isIt ? "Visualizza il profilo completo dell'autrice →" : "View full author profile"}</a></p>
    </article>
  </section>
</BaseLayout>

<style>
  .author-hub {
    display: block;
    max-width: 900px;
  }

  .author-hub > p {
    color: var(--muted);
    max-width: 72ch;
  }

  .author-card {
    margin-top: 1.5rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 1.25rem;
    background: var(--panel);
  }

  .author-card h2 {
    margin: 0 0 0.25rem;
    font-size: 1.4rem;
  }

  .author-card h2 a {
    color: var(--accent);
  }

  .author-card .role {
    margin: 0 0 0.75rem;
    color: var(--muted);
    font-weight: 700;
  }

  .author-card p {
    margin: 0.6rem 0;
  }

  .author-card .profile-link {
    color: var(--accent);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
