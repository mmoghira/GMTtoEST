---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import { getLang, languages, siteUrl } from "theme/i18n/config";

export function getStaticPaths() {
  return languages.filter((l) => l.code !== "en").map((l) => ({ params: { lang: l.code } }));
}

const lang = getLang(Astro.params.lang);
const title = "Author";
const description = "Meet the author and editorial team behind GMT to EST Converter timezone guides and conversion content.";
const pageUrl = `${siteUrl}/${lang.code}/author/`;
const meta = {
  title,
  description,
  keywords: "GMT to EST author, timezone author, GMT to EST editorial team, Jackie Bruce"
};

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${pageUrl}#webpage`,
  url: pageUrl,
  name: title,
  description,
  inLanguage: lang.code,
  mainEntity: {
    "@type": "ItemList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        url: `${siteUrl}/author/jackie-bruce/`,
        item: {
          "@type": "Person",
          name: "Jackie Bruce",
          jobTitle: "Timezone Content Specialist"
        }
      }
    ]
  },
  breadcrumb: {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${siteUrl}/${lang.code}/` },
      { "@type": "ListItem", position: 2, name: "Author", item: pageUrl }
    ]
  }
};
---

<BaseLayout lang={lang.code} dir={lang.dir} title={title} description={description} slug="author" meta={meta}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} slot="head" />

  <section class="content author-hub" aria-labelledby="author-hub-title">
    <h1 id="author-hub-title">Author</h1>
    <p>
      GMT to EST Converter content is written and reviewed by a focused editorial team that specializes in timezone
      conversion accuracy, daylight saving transitions, and practical scheduling guidance.
    </p>

    <article class="author-card" aria-labelledby="jackie-bruce">
      <h2 id="jackie-bruce">
        <a href="/author/jackie-bruce/" rel="author">Jackie Bruce</a>
      </h2>
      <p class="role">Timezone Content Specialist</p>
      <p>
        Jackie covers GMT, EST, EDT, and date-aware conversion scenarios for remote teams, events, and international
        scheduling.
      </p>
      <p><a class="profile-link" href="/author/jackie-bruce/">View full author profile</a></p>
    </article>
  </section>
</BaseLayout>

<style>
  .author-hub {
    display: block;
    max-width: 900px;
  }

  .author-hub > p {
    color: var(--muted);
    max-width: 72ch;
  }

  .author-card {
    margin-top: 1.5rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 1.25rem;
    background: var(--panel);
  }

  .author-card h2 {
    margin: 0 0 0.25rem;
    font-size: 1.4rem;
  }

  .author-card h2 a {
    color: var(--accent);
  }

  .author-card .role {
    margin: 0 0 0.75rem;
    color: var(--muted);
    font-weight: 700;
  }

  .author-card p {
    margin: 0.6rem 0;
  }

  .author-card .profile-link {
    color: var(--accent);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
