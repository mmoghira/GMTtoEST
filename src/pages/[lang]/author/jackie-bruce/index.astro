---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import { getLang, getPageMeta, languages, siteUrl } from "theme/i18n/config";
import { getCollection } from "astro:content";

export function getStaticPaths() {
  return languages.filter(lang => lang.code !== "en").map((lang) => ({ params: { lang: lang.code } }));
}

const lang = getLang(Astro.params.lang);
const isDe = lang.code === "de";
const isFr = lang.code === "fr";
const isIt = lang.code === "it";
const isNl = lang.code === "nl";
const metaBase = getPageMeta(lang.code, "authorJackie");
const meta = {
  ...metaBase,
  title: isDe ? "Jackie Bruce – Autorenprofil | GMT zu EST Umrechner" : isIt ? "Jackie Bruce – Profilo autrice | Convertitore da GMT a EST" : isNl ? "Jackie Bruce – Auteursprofiel | GMT naar EST Omrekenaar" : metaBase.title,
  description: isDe ? "Erfahren Sie mehr über Jackie Bruce, Spezialistin für Zeitzonen, GMT, EST, Sommerzeitumstellungen und internationale Terminplanung." : isIt ? "Scopri il profilo di Jackie Bruce, specialista di contenuti sui fusi orari, GMT, EST, EDT, ora legale e pianificazione transatlantica." : isNl ? "Lees meer over Jackie Bruce, specialist in tijdzones, GMT, EST, zomertijdovergangen en internationale agendaplanning." : metaBase.description,
  keywords: "Jackie Bruce, GMT to EST author, timezone expert, EST EDT daylight saving, GMT converter",
  robots: "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"
};
const title = meta.title;
const description = meta.description;
const pageUrl = `${siteUrl}/${lang.code}/author/jackie-bruce/`;

const allPosts = await getCollection("blog");
const authorPosts = allPosts.filter(p => p.id.startsWith(`${lang.code}/`));

const schema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": `${pageUrl}#profile`,
  url: pageUrl,
  name: isFr ? "Jackie Bruce – Profil de l'auteur" : isIt ? "Jackie Bruce – Profilo dell'autrice" : isNl ? "Jackie Bruce – Auteursprofiel" : "Jackie Bruce - Author Profile",
  description,
  inLanguage: lang.code,
  mainEntity: {
    "@type": "Person",
    "@id": `${pageUrl}#person`,
    name: "Jackie Bruce",
    jobTitle: isFr ? "Spécialiste de la conversion de fuseaux horaires" : isDe ? "Spezialistin für Zeitzoneninhalte" : isIt ? "Specialista in contenuti sui fusi orari" : isNl ? "Specialist in tijdzone-inhoud" : "Timezone Content Specialist",
    url: pageUrl,
    worksFor: {
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      name: isFr ? "Convertisseur GMT vers EST" : isDe ? "GMT zu EST Umrechner" : isIt ? "Convertitore da GMT a EST" : isNl ? "GMT naar EST Omrekenaar" : "GMT to EST Converter",
      url: `${siteUrl}/${isDe ? "de/" : isFr ? "fr/" : isIt ? "it/" : isNl ? "nl/" : ""}`
    },
    knowsAbout: [
      "Greenwich Mean Time",
      "Eastern Standard Time",
      "Eastern Daylight Time",
      "Daylight saving time",
      "IANA time zone data",
      "International meeting scheduling",
      "GMT to EST conversion"
    ],
    description: isDe
      ? "Jackie Bruce verfasst praxisnahe Zeitzonen-Ratgeber für den GMT zu EST Umrechner mit Schwerpunkt auf GMT, EST, EDT, Sommerzeit-Übergängen und datumsgenauer Terminplanung."
      : isIt
        ? "Jackie Bruce scrive guide pratiche sui fusi orari per il Convertitore da GMT a EST, con particolare attenzione a GMT, EST, EDT, passaggi all'ora legale e pianificazione basata sulla data."
        : isNl
          ? "Jackie Bruce schrijft praktische tijdzonegidsen voor GMT naar EST Omrekenaar, met focus op GMT, EST, EDT, zomertijdwisselingen en datumgevoelige planning."
          : "Jackie Bruce writes practical timezone guides for GMT to EST Converter, with a focus on GMT, EST, EDT, daylight saving transitions, and date-aware scheduling."
  },
  breadcrumb: {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: isDe ? "Startseite" : isFr ? "Accueil" : isIt ? "Home" : isNl ? "Startpagina" : "Home", item: `${siteUrl}/${lang.code}/` },
      { "@type": "ListItem", position: 2, name: "Jackie Bruce", item: pageUrl }
    ]
  }
};
---

<BaseLayout lang={lang.code} dir={lang.dir} title={title} description={description} slug="author/jackie-bruce" meta={meta}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} slot="head" />

  <section class="content author-page" aria-labelledby="author-title">
    <p class="eyebrow">{isDe ? "Autorin" : isFr ? "Auteure" : isIt ? "Autrice" : isNl ? "Auteur" : "Author"}</p>
    <h1 id="author-title">Jackie Bruce</h1>
    <p class="lead">
      {isDe
        ? "Jackie Bruce ist Spezialistin für Zeitzonen-Inhalte beim GMT zu EST Umrechner. Ihr Fokus liegt darauf, GMT, EST, EDT und Sommerzeit-Regeln für die tägliche Terminplanung verständlich zu machen."
        : isFr
          ? "Jackie Bruce est spécialiste des contenus sur les fuseaux horaires pour le Convertisseur GMT vers EST. Son travail vise à rendre le GMT, l'EST, l'EDT et les règles d'heure d'été clairs et directement applicables pour la planification quotidienne."
          : isIt
            ? "Jackie Bruce è specialista di contenuti sui fusi orari per il Convertitore da GMT a EST. Il suo lavoro si concentra sul rendere le regole di GMT, EST, EDT e ora legale chiare e immediatamente fruibili per la pianificazione quotidiana."
            : isNl
              ? "Jackie Bruce is specialist in tijdzone-inhoud bij GMT naar EST Omrekenaar. Haar werk richt zich op het begrijpelijk en praktisch maken van GMT, EST, EDT en zomertijdregels voor alledaagse planning."
              : "Jackie Bruce is a timezone content specialist for GMT to EST Converter, focused on making GMT, EST, EDT, and daylight saving time rules easier to understand for everyday scheduling."}
    </p>

    <div class="author-summary" aria-label={isDe ? "Zusammenfassung der Autorenexpertise" : isFr ? "Résumé de l'expertise de l'auteure" : isIt ? "Sintesi dell'esperienza dell'autrice" : isNl ? "Samenvatting auteursexpertise" : "Author expertise summary"}>
      <div>
        <strong>{isDe ? "Schwerpunkt" : isFr ? "Domaines d'expertise" : isIt ? "Ambito di competenza" : isNl ? "Aandachtsgebied" : "Focus"}</strong>
        <span>{isDe ? "GMT, EST, EDT, UTC-Offsets, Sommerzeit und globale Meeting-Planung." : isFr ? "GMT, EST, EDT, décalages UTC, heure d'été et planification de réunions internationales." : isIt ? "GMT, EST, EDT, scarti UTC, ora legale e pianificazione di meeting internazionali." : isNl ? "GMT, EST, EDT, UTC-afwijkingen, zomertijd en internationale meetingplanning." : "GMT, EST, EDT, UTC offsets, daylight saving time, and meeting planning."}</span>
      </div>
      <div>
        <strong>{isDe ? "Methodik" : isFr ? "Méthodologie de recherche" : isIt ? "Metodologia di ricerca" : isNl ? "Onderzoeksmethodiek" : "Research Approach"}</strong>
        <span>{isDe ? "Verwendet offizielle Zeitreferenzen, IANA-Zeitzonendatenbanken und datumsbasierte Umrechnungslogik." : isFr ? "Utilisation des références officielles de mesure du temps, des règles IANA et d'une logique de conversion tenant compte de la date." : isIt ? "Utilizzo di standard ufficiali di misurazione del tempo, tabelle IANA e algoritmi di conversione basati sulla data." : isNl ? "Gebruikt officiële tijdstandaarden, IANA-tijdzonegegevens en datumgevoelige omrekeningslogica." : "Uses official timekeeping references, IANA timezone rules, and date-aware conversion logic."}</span>
      </div>
      <div>
        <strong>{isDe ? "Zielgruppe" : isFr ? "Public cible" : isIt ? "Destinatari" : isNl ? "Doelgroep" : "Audience"}</strong>
        <span>{isDe ? "Remote-Teams, Veranstaltungsplaner, Trader und alle, die Zeiten zwischen GMT und Eastern Time koordinieren." : isFr ? "Équipes en télétravail, organisateurs d'événements, professionnels de la finance et particuliers coordonnant des horaires entre GMT et l'heure de l'Est." : isIt ? "Team distribuiti da remoto, organizzatori di eventi, professionisti della finanza e chiunque coordini attività tra GMT ed Eastern Time." : isNl ? "Externe teams, evenementenplanners, beurshandelaren en iedereen die tijden coördineert tussen GMT en Eastern Time." : "Remote teams, event organizers, traders, students, and anyone coordinating across GMT and Eastern Time."}</span>
      </div>
    </div>

    <h2>{isDe ? "Über Jackie" : isFr ? "À propos de Jackie" : isIt ? "Informazioni su Jackie" : isNl ? "Over Jackie" : "About Jackie"}</h2>
    <p>
      {isDe
        ? "Jackie schreibt und prüft Leitfäden, die das Verhältnis zwischen Greenwich Mean Time und Eastern Time verständlich erklären – einschließlich des saisonalen Wechsels zwischen EST (UTC−5) und EDT (UTC−4). Ihre Arbeit betont die datumsgenaue Umrechnung, damit bei Sommerzeitumstellungen keine Fehler entstehen."
        : isFr
          ? "Jackie rédige et vérifie des guides méthodologiques détaillant la relation entre le Greenwich Mean Time et l'heure de l'Est nord-américaine, y compris l'alternance saisonnière entre l'heure normale EST (UTC−5) et l'heure d'été EDT (UTC−4). Ses publications mettent l'accent sur les calculs tenant compte de la date afin de prévenir toute erreur lors des bascules d'heure d'été."
          : isIt
            ? "Jackie redige e supervisiona guide che illustrano la relazione tra il Greenwich Mean Time e l'Eastern Time nordamericano, inclusa l'alternanza stagionale tra EST (UTC−5) ed EDT (UTC−4). I suoi articoli pongono l'accento sul calcolo basato sulla data per evitare errori durante i cambi di orario stagionali."
            : isNl
              ? "Jackie schrijft en controleert gidsen die de verhouding tussen Greenwich Mean Time en Eastern Time helder uitleggen – inclusief de seizoenswisseling tussen EST (UTC−5) en EDT (UTC−4). Haar werk legt de nadruk op datumgevoelig rekenen zodat lezers fouten rondom zomertijdwisselingen voorkomen."
              : "Jackie writes and reviews guides that explain how Greenwich Mean Time relates to Eastern Time, including the seasonal difference between EST at UTC-5 and EDT at UTC-4. Her work emphasizes practical, date-aware conversion so readers can avoid mistakes around daylight saving transitions."}
    </p>

    <h2>{isDe ? "Redaktionelle Schwerpunkte" : isFr ? "Compétences et domaines d'intervention" : isIt ? "Competenze e aree di intervento" : isNl ? "Redactionele expertise" : "Editorial Expertise"}</h2>
    <ul>
      <li>{isDe ? "Erklärung von GMT, UTC-Offsets, EST und EDT in verständlicher Sprache." : isFr ? "Explication claire et accessible des concepts GMT, décalages UTC, EST et EDT." : isIt ? "Spiegazione chiara e accessibile dei concetti di GMT, scarti UTC, EST ed EDT." : isNl ? "Helder uitleggen van GMT, UTC-afwijkingen, EST en EDT in begrijpelijke taal." : "Explaining GMT, UTC offsets, EST, and EDT in plain language."}</li>
      <li>{isDe ? "Prüfung von Sommerzeit-Richtlinien für Standorte der Eastern Time." : isFr ? "Vérification des calendriers d'heure d'été pour toutes les juridictions de l'heure de l'Est." : isIt ? "Verifica delle date e delle normative dell'ora legale per tutte le aree dell'Eastern Time." : isNl ? "Controleren van zomertijdregels voor locaties in de Eastern Time-zone." : "Reviewing daylight saving time guidance for Eastern Time locations."}</li>
      <li>{isDe ? "Terminberatung für internationale Konferenzen, Webinare und Börsenöffnungszeiten." : isFr ? "Conseils pratiques de planification pour les conférences internationales, webinaires et horaires des marchés boursiers." : isIt ? "Consigli pratici di pianificazione per conferenze internazionali, webinar e orari dei mercati azionari." : isNl ? "Planningsadvies voor internationale conferenties, webinars en openingstijden van beurzen." : "Creating scheduling advice for international meetings, webinars, launches, and market hours."}</li>
      <li>{isDe ? "Abgleich aller Inhalte mit offiziellen IANA-Zeitzonendatenbanken." : isFr ? "Contrôle systématique des articles et outils par rapport aux tables officielles de la base IANA." : isIt ? "Controllo sistematico degli articoli e dei calcoli rispetto alle definizioni ufficiali IANA." : isNl ? "Systematische verificatie van alle artikelen en tabellen aan de hand van de officiële IANA-database." : "Checking articles against reputable timezone references and official timekeeping sources."}</li>
    </ul>

    <h2>{isDe ? "Veröffentlichte Artikel" : isFr ? "Articles publiés" : isIt ? "Articoli pubblicati" : isNl ? "Gepubliceerde artikelen" : "Articles"}</h2>
    {authorPosts.length > 0 ? (
      <ul>
        {authorPosts.map((post) => {
          const postSlug = post.id.split("/").slice(1).join("/").replace(/\.(md|mdx)$/, "");
          return (
            <li>
              <a href={`/${lang.code}/blog/${postSlug}/`}>{post.data.title}</a>
            </li>
          );
        })}
      </ul>
    ) : (
      <p>{isDe ? "Keine Artikel für diese Sprache gefunden." : isFr ? "Aucun article de blog publié pour cette langue pour le moment." : isIt ? "Nessun articolo di blog ancora pubblicato per questa lingua." : isNl ? "Geen artikelen gevonden voor deze taal." : "No articles published for this language yet."}</p>
    )}
  </section>
</BaseLayout>

<style>
  .author-page {
    max-width: 900px;
  }

  .author-page .eyebrow {
    color: var(--accent);
    font-weight: 700;
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
  }

  .author-page .lead {
    color: var(--text-light);
    font-size: 1.15rem;
    line-height: 1.7;
  }

  .author-summary {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 2rem 0;
  }

  .author-summary div {
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 1rem;
  }

  .author-summary strong,
  .author-summary span {
    display: block;
  }

  .author-summary span {
    color: var(--text-light);
    margin-top: 0.35rem;
  }

  @media (max-width: 760px) {
    .author-summary {
      grid-template-columns: 1fr;
    }
  }
</style>
