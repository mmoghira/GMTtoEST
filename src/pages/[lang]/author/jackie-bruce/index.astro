---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import { getLang, getPageMeta, languages, siteUrl } from "theme/i18n/config";

export function getStaticPaths() {
  return languages.filter(lang => lang.code !== "en").map((lang) => ({ params: { lang: lang.code } }));
}

const lang = getLang(Astro.params.lang);
const metaBase = getPageMeta(lang.code, "authorJackie");
const meta = {
  ...metaBase,
  keywords: "Jackie Bruce, GMT to EST author, timezone expert, EST EDT daylight saving, GMT converter",
  robots: "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"
};
const title = meta.title;
const description = meta.description;
const pageUrl = `${siteUrl}/${lang.code}/author/jackie-bruce/`;

const schema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": `${pageUrl}#profile`,
  url: pageUrl,
  name: "Jackie Bruce - Author Profile",
  description,
  inLanguage: lang.code,
  mainEntity: {
    "@type": "Person",
    "@id": `${pageUrl}#person`,
    name: "Jackie Bruce",
    jobTitle: "Timezone Content Specialist",
    url: pageUrl,
    worksFor: {
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      name: "GMT to EST Converter",
      url: siteUrl
    },
    knowsAbout: [
      "Greenwich Mean Time",
      "Eastern Standard Time",
      "Eastern Daylight Time",
      "Daylight saving time",
      "IANA time zone data",
      "International meeting scheduling",
      "GMT to EST conversion"
    ],
    description: "Jackie Bruce writes practical timezone guides for GMT to EST Converter, with a focus on GMT, EST, EDT, daylight saving transitions, and date-aware scheduling."
  },
  breadcrumb: {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${siteUrl}/${lang.code}/` },
      { "@type": "ListItem", position: 2, name: "Jackie Bruce", item: pageUrl }
    ]
  }
};
---

<BaseLayout lang={lang.code} dir={lang.dir} title={title} description={description} slug="author/jackie-bruce" meta={meta}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} slot="head" />

  <section class="content author-page" aria-labelledby="author-title">
    <p class="eyebrow">Author</p>
    <h1 id="author-title">Jackie Bruce</h1>
    <p class="lead">Jackie Bruce is a timezone content specialist for GMT to EST Converter, focused on making GMT, EST, EDT, and daylight saving time rules easier to understand for everyday scheduling.</p>

    <div class="author-summary" aria-label="Author expertise summary">
      <div>
        <strong>Focus</strong>
        <span>GMT, EST, EDT, UTC offsets, daylight saving time, and meeting planning.</span>
      </div>
      <div>
        <strong>Research Approach</strong>
        <span>Uses official timekeeping references, IANA timezone rules, and date-aware conversion logic.</span>
      </div>
      <div>
        <strong>Audience</strong>
        <span>Remote teams, event organizers, traders, students, and anyone coordinating across GMT and Eastern Time.</span>
      </div>
    </div>

    <h2>About Jackie</h2>
    <p>Jackie writes and reviews guides that explain how Greenwich Mean Time relates to Eastern Time, including the seasonal difference between EST at UTC-5 and EDT at UTC-4. Her work emphasizes practical, date-aware conversion so readers can avoid mistakes around daylight saving transitions.</p>

    <h2>Editorial Expertise</h2>
    <ul>
      <li>Explaining GMT, UTC offsets, EST, and EDT in plain language.</li>
      <li>Reviewing daylight saving time guidance for Eastern Time locations.</li>
      <li>Creating scheduling advice for international meetings, webinars, launches, and market hours.</li>
      <li>Checking articles against reputable timezone references and official timekeeping sources.</li>
    </ul>

    <h2>Articles</h2>
    <ul>
      <li><a href={`/${lang.code}/blog/icc-womens-t20-world-cup-2026-schedule-gmt-est-bst-timezone/`}>ICC Women's T20 World Cup 2026 Schedule in GMT and EST: Full BST Timezone Guide</a></li>
      <li><a href={`/${lang.code}/blog/nba-finals-time-gmt-2026/`}>What Time Is the 2026 NBA Finals in GMT? EDT and EST Conversion Guide</a></li>
      <li><a href={`/${lang.code}/blog/understanding-gmt-est/`}>Understanding the Difference Between GMT and EST</a></li>
    </ul>
  </section>
</BaseLayout>

<style>
  .author-page {
    max-width: 900px;
  }

  .author-page .eyebrow {
    color: var(--accent);
    font-weight: 700;
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
  }

  .author-page .lead {
    color: var(--text-light);
    font-size: 1.15rem;
    line-height: 1.7;
  }

  .author-summary {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 2rem 0;
  }

  .author-summary div {
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 1rem;
  }

  .author-summary strong,
  .author-summary span {
    display: block;
  }

  .author-summary span {
    color: var(--text-light);
    margin-top: 0.35rem;
  }

  @media (max-width: 760px) {
    .author-summary {
      grid-template-columns: 1fr;
    }
  }
</style>
