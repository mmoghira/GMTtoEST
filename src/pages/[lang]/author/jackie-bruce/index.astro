---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import { getLang, getPageMeta, languages, siteUrl } from "theme/i18n/config";
import { getCollection } from "astro:content";

export function getStaticPaths() {
  return languages.filter(lang => lang.code !== "en").map((lang) => ({ params: { lang: lang.code } }));
}

const lang = getLang(Astro.params.lang);
const isDe = lang.code === "de";
const isFr = lang.code === "fr";
const metaBase = getPageMeta(lang.code, "authorJackie");
const meta = {
  ...metaBase,
  title: isDe ? "Jackie Bruce – Autorenprofil | GMT zu EST Umrechner" : metaBase.title,
  description: isDe ? "Erfahren Sie mehr über Jackie Bruce, Spezialistin für Zeitzonen, GMT, EST, Sommerzeitumstellungen und internationale Terminplanung." : metaBase.description,
  keywords: "Jackie Bruce, GMT to EST author, timezone expert, EST EDT daylight saving, GMT converter",
  robots: "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"
};
const title = meta.title;
const description = meta.description;
const pageUrl = `${siteUrl}/${lang.code}/author/jackie-bruce/`;

const allPosts = await getCollection("blog");
const authorPosts = allPosts.filter(p => p.id.startsWith(`${lang.code}/`));

const schema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": `${pageUrl}#profile`,
  url: pageUrl,
  name: isFr ? "Jackie Bruce – Profil de l'auteur" : "Jackie Bruce - Author Profile",
  description,
  inLanguage: lang.code,
  mainEntity: {
    "@type": "Person",
    "@id": `${pageUrl}#person`,
    name: "Jackie Bruce",
    jobTitle: isFr ? "Spécialiste de la conversion de fuseaux horaires" : isDe ? "Spezialistin für Zeitzoneninhalte" : "Timezone Content Specialist",
    url: pageUrl,
    worksFor: {
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      name: isFr ? "Convertisseur GMT vers EST" : isDe ? "GMT zu EST Umrechner" : "GMT to EST Converter",
      url: `${siteUrl}/${isDe ? "de/" : isFr ? "fr/" : ""}`
    },
    knowsAbout: [
      "Greenwich Mean Time",
      "Eastern Standard Time",
      "Eastern Daylight Time",
      "Daylight saving time",
      "IANA time zone data",
      "International meeting scheduling",
      "GMT to EST conversion"
    ],
    description: isDe
      ? "Jackie Bruce verfasst praxisnahe Zeitzonen-Ratgeber für den GMT zu EST Umrechner mit Schwerpunkt auf GMT, EST, EDT, Sommerzeit-Übergängen und datumsgenauer Terminplanung."
      : "Jackie Bruce writes practical timezone guides for GMT to EST Converter, with a focus on GMT, EST, EDT, daylight saving transitions, and date-aware scheduling."
  },
  breadcrumb: {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: isDe ? "Startseite" : "Home", item: `${siteUrl}/${lang.code}/` },
      { "@type": "ListItem", position: 2, name: "Jackie Bruce", item: pageUrl }
    ]
  }
};
---

<BaseLayout lang={lang.code} dir={lang.dir} title={title} description={description} slug="author/jackie-bruce" meta={meta}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} slot="head" />

  <section class="content author-page" aria-labelledby="author-title">
    <p class="eyebrow">{isDe ? "Autorin" : "Author"}</p>
    <h1 id="author-title">Jackie Bruce</h1>
    <p class="lead">
      {isDe
        ? "Jackie Bruce ist Spezialistin für Zeitzonen-Inhalte beim GMT zu EST Umrechner. Ihr Fokus liegt darauf, GMT, EST, EDT und Sommerzeit-Regeln für die tägliche Terminplanung verständlich zu machen."
        : "Jackie Bruce is a timezone content specialist for GMT to EST Converter, focused on making GMT, EST, EDT, and daylight saving time rules easier to understand for everyday scheduling."}
    </p>

    <div class="author-summary" aria-label={isDe ? "Zusammenfassung der Autorenexpertise" : "Author expertise summary"}>
      <div>
        <strong>{isDe ? "Schwerpunkt" : "Focus"}</strong>
        <span>{isDe ? "GMT, EST, EDT, UTC-Offsets, Sommerzeit und globale Meeting-Planung." : "GMT, EST, EDT, UTC offsets, daylight saving time, and meeting planning."}</span>
      </div>
      <div>
        <strong>{isDe ? "Methodik" : "Research Approach"}</strong>
        <span>{isDe ? "Verwendet offizielle Zeitreferenzen, IANA-Zeitzonendatenbanken und datumsbasierte Umrechnungslogik." : "Uses official timekeeping references, IANA timezone rules, and date-aware conversion logic."}</span>
      </div>
      <div>
        <strong>{isDe ? "Zielgruppe" : "Audience"}</strong>
        <span>{isDe ? "Remote-Teams, Veranstaltungsplaner, Trader und alle, die Zeiten zwischen GMT und Eastern Time koordinieren." : "Remote teams, event organizers, traders, students, and anyone coordinating across GMT and Eastern Time."}</span>
      </div>
    </div>

    <h2>{isDe ? "Über Jackie" : "About Jackie"}</h2>
    <p>
      {isDe
        ? "Jackie schreibt und prüft Leitfäden, die das Verhältnis zwischen Greenwich Mean Time und Eastern Time verständlich erklären – einschließlich des saisonalen Wechsels zwischen EST (UTC−5) und EDT (UTC−4). Ihre Arbeit betont die datumsgenaue Umrechnung, damit bei Sommerzeitumstellungen keine Fehler entstehen."
        : "Jackie writes and reviews guides that explain how Greenwich Mean Time relates to Eastern Time, including the seasonal difference between EST at UTC-5 and EDT at UTC-4. Her work emphasizes practical, date-aware conversion so readers can avoid mistakes around daylight saving transitions."}
    </p>

    <h2>{isDe ? "Redaktionelle Schwerpunkte" : "Editorial Expertise"}</h2>
    <ul>
      <li>{isDe ? "Erklärung von GMT, UTC-Offsets, EST und EDT in verständlicher Sprache." : "Explaining GMT, UTC offsets, EST, and EDT in plain language."}</li>
      <li>{isDe ? "Prüfung von Sommerzeit-Richtlinien für Standorte der Eastern Time." : "Reviewing daylight saving time guidance for Eastern Time locations."}</li>
      <li>{isDe ? "Terminberatung für internationale Konferenzen, Webinare und Börsenöffnungszeiten." : "Creating scheduling advice for international meetings, webinars, launches, and market hours."}</li>
      <li>{isDe ? "Abgleich aller Inhalte mit offiziellen IANA-Zeitzonendatenbanken." : "Checking articles against reputable timezone references and official timekeeping sources."}</li>
    </ul>

    <h2>{isDe ? "Veröffentlichte Artikel" : "Articles"}</h2>
    {authorPosts.length > 0 ? (
      <ul>
        {authorPosts.map((post) => {
          const postSlug = post.id.split("/").slice(1).join("/").replace(/\.(md|mdx)$/, "");
          return (
            <li>
              <a href={`/${lang.code}/blog/${postSlug}/`}>{post.data.title}</a>
            </li>
          );
        })}
      </ul>
    ) : (
      <p>{isDe ? "Keine Artikel für diese Sprache gefunden." : "No articles published for this language yet."}</p>
    )}
  </section>
</BaseLayout>

<style>
  .author-page {
    max-width: 900px;
  }

  .author-page .eyebrow {
    color: var(--accent);
    font-weight: 700;
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
  }

  .author-page .lead {
    color: var(--text-light);
    font-size: 1.15rem;
    line-height: 1.7;
  }

  .author-summary {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 2rem 0;
  }

  .author-summary div {
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 1rem;
  }

  .author-summary strong,
  .author-summary span {
    display: block;
  }

  .author-summary span {
    color: var(--text-light);
    margin-top: 0.35rem;
  }

  @media (max-width: 760px) {
    .author-summary {
      grid-template-columns: 1fr;
    }
  }
</style>
