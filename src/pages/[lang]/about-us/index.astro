---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import { getPageMeta, siteUrl, languages, getLang } from "theme/i18n/config";

export function getStaticPaths() {
  return languages.filter(l => l.code !== "en").map(l => ({ params: { lang: l.code } }));
}

const lang = getLang(Astro.params.lang);
const metaBase = getPageMeta(lang.code, "about");
const meta = {
  ...metaBase,
  keywords: "about gmt to est, about GMTtoEST, about us GMT to EST, timezone converter about",
  robots: lang.code !== "en" ? "noindex,follow" : undefined
};

const pageUrl = `${siteUrl}/${lang.code}/about-us/`;

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "@id": `${pageUrl}#webpage`,
    url: pageUrl,
    name: meta.title,
    description: meta.description,
    inLanguage: lang.code,
    isPartOf: {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      url: siteUrl,
      name: "GMT to EST Converter"
    },
    about: {
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      name: "GMT to EST Converter",
      url: siteUrl,
      logo: `${siteUrl}/assets/logo.png`,
      email: "contact@gmttoestconverter.com",
      description: "Free, accurate timezone converter and guide for GMT and Eastern Time (EST/EDT) conversions.",
      foundingDate: "2024"
    },
    breadcrumb: {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${siteUrl}/${lang.code}/` },
        { "@type": "ListItem", position: 2, name: "About Us", item: pageUrl }
      ]
    }
  }
];
---

<BaseLayout lang={lang.code} dir={lang.dir} title={meta.title} description={meta.description} slug="about-us" meta={meta}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} slot="head" />
  <section class="content" aria-labelledby="about">
    <h1 id="about">{meta.title}</h1>
    <p>GMT to EST Converter provides fast, date-aware timezone conversions between GMT (UTC) and Eastern Time (EST/EDT). Our mission is to make scheduling across time zones simple and reliable.</p>
    <h2>Our approach</h2>
    <p>We use the IANA timezone rules (for example, <code>America/New_York</code>) to account for daylight saving transitions. The converter shows whether a result is EST or EDT and the exact offset for the selected date.</p>
    <h2>Contribute</h2>
    <p>If you'd like to help with translations, report an issue, or suggest improvements, please visit the <a href={`/${lang.code}/contact-us/`}>Contact</a> page.</p>
  </section>
</BaseLayout>
