---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import { getPageMeta, siteUrl, languages, getLang } from "theme/i18n/config";

export function getStaticPaths() {
  return languages.filter(lang => lang.code !== "en").map((lang) => ({ params: { lang: lang.code } }));
}

const lang = getLang(Astro.params.lang);
const isDe = lang.code === "de";
const isFr = lang.code === "fr";
const isIt = lang.code === "it";
const isNl = lang.code === "nl";
const metaBase = getPageMeta(lang.code, "about");
const meta = {
  ...metaBase,
  title: isDe ? "Über uns – GMT zu EST Umrechner" : isFr ? "À propos | Convertisseur GMT vers EST" : isIt ? "Chi siamo | Convertitore da GMT a EST" : isNl ? "Over ons – GMT naar EST Omrekenaar" : metaBase.title,
  description: isDe ? "Erfahren Sie mehr über unsere Mission: Präzise, datumsgenaue Zeitzonenumrechnungen zwischen GMT, EST, EDT und weltweiten Zeitzonen." : isFr ? "Découvrez notre mission : proposer des conversions d'heure précises, synchronisées et tenant compte de l'heure d'été entre GMT, EST, EDT et le monde entier." : isIt ? "Scopri la missione del Convertitore da GMT a EST: conversioni orarie accurate, sincronizzate e conformi agli standard IANA e UTC." : isNl ? "Lees meer over onze missie: uiterst nauwkeurige, datumgevoelige tijdzoneberekeningen tussen GMT, EST, EDT en wereldwijde tijdzones." : metaBase.description,
  keywords: "about gmt to est, about GMTtoEST, about us GMT to EST, timezone converter about",
  robots: "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"
};

const pageUrl = `${siteUrl}/${lang.code}/about-us/`;

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "@id": `${pageUrl}#webpage`,
    url: pageUrl,
    name: meta.title,
    description: meta.description,
    inLanguage: lang.code,
    isPartOf: {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      url: siteUrl,
      name: isDe ? "GMT zu EST Umrechner" : isFr ? "Convertisseur GMT vers EST" : isIt ? "Convertitore da GMT a EST" : isNl ? "GMT naar EST Omrekenaar" : "GMT to EST Converter"
    },
    about: {
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      name: isDe ? "GMT zu EST Umrechner" : isFr ? "Convertisseur GMT vers EST" : isIt ? "Convertitore da GMT a EST" : isNl ? "GMT naar EST Omrekenaar" : "GMT to EST Converter",
      url: `${siteUrl}/${isDe ? "de/" : isFr ? "fr/" : isIt ? "it/" : isNl ? "nl/" : ""}`,
      logo: `${siteUrl}/assets/logo.png`,
      email: "contact@gmttoestconverter.com",
      description: isDe
        ? "Kostenloser, präziser Zeitzonenumrechner und Ratgeber für GMT- und Eastern Time (EST/EDT) Umrechnungen."
        : isFr
          ? "Outil en ligne gratuit et précis pour convertir l'heure entre le méridien de Greenwich (GMT/UTC) et l'heure de l'Est (EST/EDT)."
          : isIt
            ? "Strumento online gratuito e accurato per convertire l'ora tra il meridiano di Greenwich (GMT/UTC) e l'Eastern Time nordamericano (EST/EDT)."
            : isNl
              ? "Gratis en betrouwbare online tijdzone-omrekenaar voor GMT en Eastern Time (EST/EDT) berekeningen."
              : "Free, accurate timezone converter and guide for GMT and Eastern Time (EST/EDT) conversions.",
      foundingDate: "2024"
    },
    breadcrumb: {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: isDe ? "Startseite" : isFr ? "Accueil" : isIt ? "Home" : isNl ? "Startpagina" : "Home", item: `${siteUrl}/${lang.code}/` },
        { "@type": "ListItem", position: 2, name: isDe ? "Über uns" : isFr ? "À propos" : isIt ? "Chi siamo" : isNl ? "Over ons" : "About Us", item: pageUrl }
      ]
    }
  }
];
---

<BaseLayout lang={lang.code} dir={lang.dir} title={meta.title} description={meta.description} slug="about-us" meta={meta}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} slot="head" />
  <section class="content" aria-labelledby="about">
    <h1 id="about">{meta.title}</h1>
    {isDe ? (
      <>
        <p>Der GMT zu EST Umrechner bietet schnelle, datumsgenaue Zeitzonenumrechnungen zwischen Greenwich Mean Time (GMT / UTC) und Eastern Time (EST / EDT). Unsere Mission ist es, die internationale Terminplanung über Zeitzonen hinweg einfach, transparent und fehlerfrei zu gestalten.</p>
        <h2>Unsere Methodik</h2>
        <p>Wir verwenden die offiziellen IANA-Zeitzonenregeln (wie z. B. <code>America/New_York</code> und <code>Europe/Berlin</code>), um Sommerzeitumstellungen automatisch und sekundengenau zu berücksichtigen. Unser Umrechner zeigt für jedes gewählte Datum sofort an, ob Standardzeit (EST, UTC−5) oder Sommerzeit (EDT, UTC−4) gilt.</p>
        <h2>Mitwirken & Feedback</h2>
        <p>Möchten Sie einen Fehler melden, Feedback geben oder Verbesserungsvorschläge einbringen? Nutzen Sie gern unsere <a href={`/${lang.code}/contact-us/`}>Kontaktseite</a>.</p>
      </>
    ) : isFr ? (
      <>
        <p>Le <strong>Convertisseur GMT vers EST</strong> a été développé pour fournir des conversions horaires instantanées et rigoureusement exactes entre le Greenwich Mean Time (GMT/UTC) et l'heure de l'Est nord-américaine (EST/EDT). Notre mission est de rendre la planification et la communication internationales simples, fiables et transparentes pour tous les utilisateurs francophones.</p>
        <h2>Notre démarche et méthodologie</h2>
        <p>Pour éliminer tout risque d'erreur d'une heure lors des changements saisonniers, notre plateforme s'appuie directement sur les définitions officielles de la base de données des fuseaux horaires IANA (TZDB) et l'identifiant <code>America/New_York</code>. Notre algorithme prend automatiquement en compte la date sélectionnée pour déterminer si le décalage applicable est l'heure normale (EST, UTC−5) ou l'heure d'été (EDT, UTC−4).</p>
        <h2>Principes éditoriaux et révision</h2>
        <p>Tous les guides, tableaux de conversion et contenus explicatifs sont rédigés et vérifiés selon des critères stricts de rigueur scientifique et de clarté pédagogique. Nous croisons nos données avec les publications de référence du Bureau International des Poids et Mesures (BIPM) et du NIST.</p>
        <h2>Nous contacter et contribuer</h2>
        <p>Vous souhaitez signaler une anomalie, poser une question technique ou suggérer une amélioration ? Rendez-vous sur notre page <a href={`/${lang.code}/contact-us/`}>Contactez-nous</a>.</p>
      </>
    ) : isIt ? (
      <>
        <p>Il <strong>Convertitore da GMT a EST</strong> è nato per offrire conversioni orarie istantanee, precise e conformi alle normative tra il Greenwich Mean Time (GMT / UTC) e l'Eastern Time nordamericano (EST / EDT). La nostra missione è rendere la pianificazione e la comunicazione internazionale semplici, affidabili e prive di errori per tutti gli utenti di lingua italiana.</p>
        <h2>La nostra metodologia</h2>
        <p>Per prevenire errori legati all'ora legale e ai cambi di stagione, i nostri strumenti si collegano direttamente alle definizioni ufficiali della banca dati IANA (TZDB) e all'identificatore <code>America/New_York</code>. Il nostro algoritmo considera sempre la data selezionata per stabilire se applicare l'ora solare (EST, UTC−5) o l'ora legale estiva (EDT, UTC−4).</p>
        <h2>Criteri editoriali e revisione scientifica</h2>
        <p>Tutti i calcolatori, le tabelle orarie e le guide di approfondimento vengono redatti e verificati secondo rigorosi criteri di precisione scientifica e chiarezza divulgativa, confrontando costantemente i dati con gli standard dell'Ufficio Internazionale dei Pesi e delle Misure (BIPM) e del NIST.</p>
        <h2>Contatti e segnalazioni</h2>
        <p>Desideri segnalare un'inesattezza, suggerire una nuova funzionalità o richiedere assistenza? Visita la nostra <a href={`/${lang.code}/contact-us/`}>pagina di contatto</a>.</p>
      </>
    ) : isNl ? (
      <>
        <p>De <strong>GMT naar EST Omrekenaar</strong> biedt snelle, datumgevoelige tijdzoneberekeningen tussen Greenwich Mean Time (GMT / UTC) en Eastern Time (EST / EDT). Onze missie is om internationale agendaplanning en communicatie tussen Europa en Noord-Amerika eenvoudig, transparant en 100% foutloos te maken.</p>
        <h2>Onze methodiek en standaarden</h2>
        <p>Om fouten rondom zomertijd en seizoenswisselingen uit te sluiten, maakt ons platform rechtstreeks gebruik van de officiële IANA-tijdzonedatabase (TZDB) en de zone <code>America/New_York</code>. Onze rekenmodule berekent aan de hand van de door u gekozen datum automatisch of het actieve tijdsverschil 5 uur (EST, UTC−5) dan wel 4 uur (EDT, UTC−4) bedraagt.</p>
        <h2>Redactionele richtlijnen en kwaliteitscontrole</h2>
        <p>Alle gidsen, tabellen en artikelen worden zorgvuldig samengesteld en geverifieerd aan de hand van gezaghebbende bronnen zoals het NIST (National Institute of Standards and Technology) en het BIPM (Bureau International des Poids et Mesures).</p>
        <h2>Contact en feedback</h2>
        <p>Wilt u een opmerking doorgeven, een vraag stellen of feedback delen? Neem gerust contact op via onze <a href={`/${lang.code}/contact-us/`}>contactpagina</a>.</p>
      </>
    ) : (
      <>
        <p>GMT to EST Converter provides fast, date-aware timezone conversions between GMT (UTC) and Eastern Time (EST/EDT). Our mission is to make scheduling across time zones simple and reliable.</p>
        <h2>Our approach</h2>
        <p>We use the IANA timezone rules (for example, <code>America/New_York</code>) to account for daylight saving transitions. The converter shows whether a result is EST or EDT and the exact offset for the selected date.</p>
        <h2>Contribute</h2>
        <p>If you'd like to help with translations, report an issue, or suggest improvements, please visit the <a href={`/${lang.code}/contact-us/`}>Contact</a> page.</p>
      </>
    )}
  </section>
</BaseLayout>
