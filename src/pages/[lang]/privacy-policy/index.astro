---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import { siteUrl } from "theme/i18n/config";

const title = "Privacy Policy";
const description = "Read the GMT to EST Converter Privacy Policy. Learn how we collect, use, and protect your data, including Google AdSense, Google Analytics, GDPR, and CCPA rights.";
const meta = {
  title,
  description,
  keywords: "GMT to EST privacy policy, data collection, cookies, Google AdSense, Google Analytics, GDPR, CCPA, data security, children privacy, privacy rights"
};

const effectiveDate = "May 08, 2026";
const lastUpdated  = "May 08, 2026";
const pageCanonical = `${siteUrl}/privacy-policy/`;

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${pageCanonical}#webpage`,
    url: pageCanonical,
    name: title,
    description,
    inLanguage: lang.code,
    dateModified: "2026-05-08",
    isPartOf: {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      url: siteUrl,
      name: "GMT to EST Converter"
    },
    breadcrumb: {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: siteUrl },
        { "@type": "ListItem", position: 2, name: "Privacy Policy", item: pageCanonical }
      ]
    },
    author: {
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      name: "GMT to EST Converter"
    },
    speakable: {
      "@type": "SpeakableSpecification",
      cssSelector: [".pp-intro", ".pp-section h2"]
    }
  }
];

const toc = [
  { href: "#s1",  label: "Information We Collect" },
  { href: "#s2",  label: "How We Use Your Information" },
  { href: "#s3",  label: "Cookies and Tracking Technologies" },
  { href: "#s4",  label: "Google AdSense & Third-Party Advertising" },
  { href: "#s5",  label: "Google Analytics" },
  { href: "#s6",  label: "Third-Party Links" },
  { href: "#s7",  label: "Data Retention" },
  { href: "#s8",  label: "Data Security" },
  { href: "#s9",  label: "Children's Privacy" },
  { href: "#s10", label: "Your Privacy Rights" },
  { href: "#s11", label: "GDPR â€“ For European Users" },
  { href: "#s12", label: "CCPA â€“ For California Users" },
  { href: "#s13", label: "Changes to This Policy" },
  { href: "#s14", label: "Contact Us" },
];
---

<BaseLayout lang={lang.code} dir={lang.dir} title={title} description={description} slug="privacy-policy" meta={meta}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} slot="head" />

  <!-- â”€â”€ HERO HEADER â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
  <div class="pp-hero">
    <span class="pp-badge">Legal Document</span>
    <h1>Privacy <span class="pp-accent">Policy</span></h1>
    <p class="pp-meta">
      gmttoestconverter.com &nbsp;Â·&nbsp; Effective Date: {effectiveDate} &nbsp;Â·&nbsp; Last Updated: {lastUpdated}
    </p>
  </div>

  <div class="pp-wrapper">

    <!-- INTRO -->
    <div class="pp-card pp-intro">
      <p>Welcome to <strong>GMT to EST Converter</strong> ("we," "our," or "us"), accessible at
        <a href={siteUrl} target="_blank" rel="noopener">gmttoestconverter.com</a>.
        We are committed to protecting your privacy. This Privacy Policy explains what information we collect,
        how we use it, and your rights regarding that information when you visit our website.
      </p>
      <p>By using our website, you agree to the collection and use of information in accordance with this policy.
        Please read it carefully before using our services.
      </p>
    </div>

    <!-- TABLE OF CONTENTS -->
    <nav class="pp-toc" aria-label="Table of contents">
      <h2>Table of Contents</h2>
      <ol>
        {toc.map((item, i) => (
          <li><a href={item.href}>{i + 1}. {item.label}</a></li>
        ))}
      </ol>
    </nav>

    <!-- SECTION 1 -->
    <section class="pp-card pp-section" id="s1" aria-labelledby="s1-h">
      <h2 id="s1-h"><span class="pp-num">1</span> Information We Collect</h2>
      <p>We collect two types of information from visitors:</p>
      <p><strong>a) Automatically Collected Information</strong><br />
        When you visit our website, certain information is automatically collected by our servers and third-party tools, including:
      </p>
      <ul>
        <li>IP address (anonymized where possible)</li>
        <li>Browser type and version</li>
        <li>Device type (desktop, mobile, tablet)</li>
        <li>Operating system</li>
        <li>Referring URL (the page that directed you to us)</li>
        <li>Pages visited and time spent on each page</li>
        <li>Date and time of your visit</li>
      </ul>
      <p><strong>b) Information You Provide Voluntarily</strong><br />
        We do not operate contact forms, user accounts, or subscription services. We do not knowingly collect
        personally identifiable information (PII) directly from users.
      </p>
    </section>

    <!-- SECTION 2 -->
    <section class="pp-card pp-section" id="s2" aria-labelledby="s2-h">
      <h2 id="s2-h"><span class="pp-num">2</span> How We Use Your Information</h2>
      <p>The information we collect is used to:</p>
      <ul>
        <li>Operate, maintain, and improve the website</li>
        <li>Analyze traffic patterns and user behavior to enhance user experience</li>
        <li>Serve relevant advertisements through Google AdSense</li>
        <li>Detect and prevent technical issues, spam, or abuse</li>
        <li>Comply with legal obligations</li>
      </ul>
      <p>We do <strong>not</strong> sell, rent, or trade your personal information to any third party for marketing purposes.</p>
    </section>

    <!-- SECTION 3 -->
    <section class="pp-card pp-section" id="s3" aria-labelledby="s3-h">
      <h2 id="s3-h"><span class="pp-num">3</span> Cookies and Tracking Technologies</h2>
      <p>Our website uses <strong>cookies</strong> â€” small text files stored on your device â€” to improve functionality
        and deliver personalized advertising. Cookies help us understand how visitors interact with our site.
      </p>
      <p>We use the following types of cookies:</p>
      <ul>
        <li><strong>Essential Cookies:</strong> Necessary for the website to function properly.</li>
        <li><strong>Analytics Cookies:</strong> Used by Google Analytics to track and report website traffic.</li>
        <li><strong>Advertising Cookies:</strong> Used by Google AdSense to serve relevant ads based on your browsing behavior.</li>
        <li><strong>Preference Cookies:</strong> Remember your settings and preferences for future visits.</li>
      </ul>
      <p>You can control and manage cookies through your browser settings. Please note that disabling cookies may affect
        the functionality of some parts of the website. For more information, visit
        <a href="https://www.aboutcookies.org" target="_blank" rel="noopener noreferrer">www.aboutcookies.org</a>.
      </p>
    </section>

    <!-- SECTION 4 -->
    <section class="pp-card pp-section" id="s4" aria-labelledby="s4-h">
      <h2 id="s4-h"><span class="pp-num">4</span> Google AdSense &amp; Third-Party Advertising</h2>
      <p>We use <strong>Google AdSense</strong> to display advertisements on our website. Google AdSense uses cookies
        and web beacons to serve ads based on your prior visits to our site and other sites on the internet.
      </p>
      <div class="pp-highlight">
        Google's use of advertising cookies enables it and its partners to serve ads based on your visit to our site
        and/or other websites on the internet. You may opt out of personalized advertising by visiting
        <a href="https://www.google.com/settings/ads" target="_blank" rel="noopener noreferrer">Google Ad Settings</a>.
      </div>
      <p>Third-party vendors, including Google, use cookies to serve ads based on your prior visits to our website or
        other websites. These third-party cookies are governed by their own privacy policies, not ours.
      </p>
      <p>For more information on how Google uses data when you use our website, please visit:
        <a href="https://policies.google.com/technologies/partner-sites" target="_blank" rel="noopener noreferrer">Google's Privacy &amp; Terms</a>.
      </p>
    </section>

    <!-- SECTION 5 -->
    <section class="pp-card pp-section" id="s5" aria-labelledby="s5-h">
      <h2 id="s5-h"><span class="pp-num">5</span> Google Analytics</h2>
      <p>We use <strong>Google Analytics</strong> to collect anonymous data about how visitors use our website.
        This helps us understand which pages are most visited, how long users stay, and where they come from.
      </p>
      <p>Google Analytics collects information such as:</p>
      <ul>
        <li>Number of visitors</li>
        <li>Session duration</li>
        <li>Pages per session</li>
        <li>Bounce rate</li>
        <li>Geographic location (country/city level)</li>
      </ul>
      <p>This data is aggregated and anonymized. We do not combine it with personally identifiable information.
        You can opt out of Google Analytics tracking by installing the
        <a href="https://tools.google.com/dlpage/gaoptout" target="_blank" rel="noopener noreferrer">Google Analytics Opt-out Browser Add-on</a>.
      </p>
    </section>

    <!-- SECTION 6 -->
    <section class="pp-card pp-section" id="s6" aria-labelledby="s6-h">
      <h2 id="s6-h"><span class="pp-num">6</span> Third-Party Links</h2>
      <p>Our website may contain links to third-party websites. These links are provided for your convenience and
        information. We have no control over the content or privacy practices of those sites.
      </p>
      <p>We encourage you to review the privacy policy of any third-party site you visit. We are not responsible for
        the privacy practices, content, or data collection methods of external websites.
      </p>
    </section>

    <!-- SECTION 7 -->
    <section class="pp-card pp-section" id="s7" aria-labelledby="s7-h">
      <h2 id="s7-h"><span class="pp-num">7</span> Data Retention</h2>
      <p>We retain automatically collected data (such as analytics data) only for as long as necessary to fulfill the
        purposes outlined in this Privacy Policy, or as required by applicable law.
      </p>
      <p>Google Analytics data is retained for <strong>26 months</strong> by default, after which it is automatically
        deleted from Google's servers. We do not store any personal data on our own servers beyond what is collected
        through cookies and analytics tools.
      </p>
    </section>

    <!-- SECTION 8 -->
    <section class="pp-card pp-section" id="s8" aria-labelledby="s8-h">
      <h2 id="s8-h"><span class="pp-num">8</span> Data Security</h2>
      <p>We take reasonable administrative and technical measures to protect your information from unauthorized access,
        disclosure, alteration, or destruction. Our website uses <strong>HTTPS encryption</strong> to ensure a secure
        connection between your browser and our server.
      </p>
      <p>However, please be aware that no method of transmission over the internet or method of electronic storage is
        100% secure. While we strive to use commercially acceptable means to protect your information, we cannot
        guarantee its absolute security.
      </p>
    </section>

    <!-- SECTION 9 -->
    <section class="pp-card pp-section" id="s9" aria-labelledby="s9-h">
      <h2 id="s9-h"><span class="pp-num">9</span> Children's Privacy</h2>
      <p>Our website is not directed to children under the age of <strong>13</strong>, and we do not knowingly collect
        personal information from children under 13. If you are a parent or guardian and believe your child has provided
        us with personal information, please contact us immediately.
      </p>
      <p>If we discover that we have inadvertently collected personal information from a child under 13, we will take
        steps to delete that information as soon as possible. We comply with the
        <strong>Children's Online Privacy Protection Act (COPPA)</strong>.
      </p>
    </section>

    <!-- SECTION 10 -->
    <section class="pp-card pp-section" id="s10" aria-labelledby="s10-h">
      <h2 id="s10-h"><span class="pp-num">10</span> Your Privacy Rights</h2>
      <p>Depending on your location, you may have certain rights regarding your personal data, including:</p>
      <ul>
        <li><strong>Right to Access:</strong> Request a copy of the personal data we hold about you.</li>
        <li><strong>Right to Correction:</strong> Request correction of inaccurate or incomplete data.</li>
        <li><strong>Right to Deletion:</strong> Request deletion of your personal data ("right to be forgotten").</li>
        <li><strong>Right to Opt-Out:</strong> Opt out of personalized advertising cookies at any time.</li>
        <li><strong>Right to Data Portability:</strong> Request your data in a structured, machine-readable format.</li>
      </ul>
      <p>To exercise any of these rights, please contact us at the details provided at the bottom of this page.</p>
    </section>

    <!-- SECTION 11 -->
    <section class="pp-card pp-section" id="s11" aria-labelledby="s11-h">
      <h2 id="s11-h"><span class="pp-num">11</span> GDPR â€“ For European Users</h2>
      <p>If you are located in the <strong>European Economic Area (EEA)</strong>, you have additional rights under the
        General Data Protection Regulation (GDPR):
      </p>
      <ul>
        <li>We process your data based on <strong>legitimate interests</strong> (website analytics and improvement)
          and <strong>consent</strong> (for advertising cookies).</li>
        <li>You have the right to withdraw consent for cookies at any time via our cookie settings or your browser.</li>
        <li>You have the right to lodge a complaint with your local data protection authority.</li>
      </ul>
      <p>We do not transfer personal data outside the EEA unless appropriate safeguards are in place (such as Google's
        Standard Contractual Clauses).
      </p>
    </section>

    <!-- SECTION 12 -->
    <section class="pp-card pp-section" id="s12" aria-labelledby="s12-h">
      <h2 id="s12-h"><span class="pp-num">12</span> CCPA â€“ For California Users</h2>
      <p>If you are a <strong>California resident</strong>, the California Consumer Privacy Act (CCPA) grants you
        additional rights:
      </p>
      <ul>
        <li><strong>Right to Know:</strong> You may request disclosure of the categories and specific pieces of personal
          information we have collected.</li>
        <li><strong>Right to Delete:</strong> You may request the deletion of personal information we have collected
          from you.</li>
        <li><strong>Right to Opt-Out:</strong> You may opt out of the sale of your personal information. We do
          <strong>not</strong> sell personal information.</li>
        <li><strong>Right to Non-Discrimination:</strong> We will not discriminate against you for exercising your
          CCPA rights.</li>
      </ul>
      <p>To submit a CCPA request, please contact us at the email address below.</p>
    </section>

    <!-- SECTION 13 -->
    <section class="pp-card pp-section" id="s13" aria-labelledby="s13-h">
      <h2 id="s13-h"><span class="pp-num">13</span> Changes to This Privacy Policy</h2>
      <p>We reserve the right to update or modify this Privacy Policy at any time. Any changes will be posted on this
        page with a revised <strong>"Last Updated"</strong> date at the top. We encourage you to review this page
        periodically to stay informed about how we are protecting your information.
      </p>
      <p>Your continued use of the website after any changes constitutes your acceptance of the updated Privacy Policy.
        If we make material changes, we will make reasonable efforts to notify users (e.g., via a prominent notice on
        our website).
      </p>
    </section>

    <!-- SECTION 14 â€“ CONTACT CARD -->
    <div class="pp-contact-card" id="s14">
      <h2>14. Contact Us</h2>
      <p>If you have any questions, concerns, or requests regarding this Privacy Policy or our data practices, please
        contact us:
      </p>
      <ul class="pp-contact-list">
        <li>
          <span class="pp-contact-label">Website</span>
          <a href={siteUrl} target="_blank" rel="noopener">gmttoestconverter.com</a>
        </li>
        <li>
          <span class="pp-contact-label">Website Name</span>
          <span>GMT to EST Converter</span>
        </li>
        <li>
          <span class="pp-contact-label">Email</span>
          <a href="mailto:gmttoestconverter@gmail.com">gmttoestconverter@gmail.com</a>
        </li>
        <li>
          <span class="pp-contact-label">Contact Form</span>
          <a href="/contact-us/">Visit our Contact page</a>
        </li>
      </ul>
      <p class="pp-response-note">We aim to respond to all privacy-related inquiries within <strong>30 days</strong> of receipt.</p>
    </div>

  </div><!-- /pp-wrapper -->
</BaseLayout>

<style>
  /* â”€â”€ Hero â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
  .pp-hero {
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    color: #fff;
    padding: 56px 24px 52px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .pp-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 80% 60% at 50% 0%, rgba(14,165,233,0.15), transparent);
    pointer-events: none;
  }
  .pp-badge {
    display: inline-block;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #93c5fd;
    background: rgba(30,58,138,0.4);
    border: 1px solid rgba(59,130,246,0.3);
    padding: 5px 14px;
    border-radius: 20px;
    margin-bottom: 18px;
  }
  .pp-hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin: 0 0 14px;
  }
  .pp-accent { color: #93c5fd; }
  .pp-meta {
    font-size: 14px;
    color: #94a3b8;
    margin: 0;
  }

  /* â”€â”€ Layout â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
  .pp-wrapper {
    max-width: 820px;
    margin: 0 auto;
    padding: 48px 24px 80px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* â”€â”€ Card base â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
  .pp-card {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 36px 40px;
    transition: box-shadow 0.2s ease;
  }
  .pp-card:hover {
    box-shadow: 0 4px 28px rgba(14, 165, 233, 0.08);
  }

  /* â”€â”€ Intro â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
  .pp-intro p {
    color: var(--muted);
    line-height: 1.8;
    margin: 0 0 12px;
    font-size: 1rem;
  }
  .pp-intro p:last-child { margin-bottom: 0; }
  .pp-intro strong { color: var(--text); font-weight: 600; }
  .pp-intro a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }

  /* â”€â”€ Table of Contents â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
  .pp-toc {
    background: color-mix(in srgb, var(--accent) 8%, var(--panel));
    border-left: 4px solid var(--accent);
    border-radius: 0 12px 12px 0;
    padding: 28px 32px;
  }
  .pp-toc h2 {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text);
    margin: 0 0 14px;
  }
  .pp-toc ol {
    padding-left: 20px;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .pp-toc li { font-size: 14.5px; color: var(--muted); }
  .pp-toc a {
    color: var(--accent);
    text-decoration: none;
    transition: color 0.2s;
  }
  .pp-toc a:hover { text-decoration: underline; }

  /* â”€â”€ Sections â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
  .pp-section h2 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text);
    margin: 0 0 16px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .pp-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 28px;
    height: 28px;
    padding: 0 6px;
    background: var(--accent);
    color: #fff;
    border-radius: 50%;
    font-size: 12px;
    font-weight: 700;
    flex-shrink: 0;
  }
  .pp-section p {
    color: var(--muted);
    line-height: 1.8;
    margin: 0 0 12px;
    font-size: 0.975rem;
  }
  .pp-section p:last-child { margin-bottom: 0; }
  .pp-section ul {
    padding-left: 20px;
    margin: 0 0 12px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .pp-section li {
    color: var(--muted);
    font-size: 0.975rem;
    line-height: 1.7;
  }
  .pp-section strong { color: var(--text); font-weight: 600; }
  .pp-section a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s;
  }
  .pp-section a:hover { color: var(--accent-2); }

  /* â”€â”€ Highlight Box â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
  .pp-highlight {
    background: color-mix(in srgb, var(--accent) 10%, var(--panel));
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    border-radius: 10px;
    padding: 16px 20px;
    font-size: 14.5px;
    color: var(--muted);
    line-height: 1.7;
    margin: 12px 0;
