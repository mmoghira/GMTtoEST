---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import RelatedConvertersWidget from "theme/components/RelatedConvertersWidget.astro";
import UsersAlsoVisitWidget from "theme/components/UsersAlsoVisitWidget.astro";
import LearnMoreWidget from "theme/components/LearnMoreWidget.astro";
import CountryCityWidget from "theme/components/CountryCityWidget.astro";
import { siteUrl } from "theme/i18n/config";

const lang = "en";
const dir = "ltr";
const slug = "cst";
const seoTitle = "CST Time: 2026 Central Standard Clocks, Cities & UTC-6";
const pageDescription = "Check CST time with live UTC-6 clocks, major cities like Chicago, and seasonal CDT transitions. Convert your Central schedule now with no signup needed.";

const pubDate = "2026-07-30T10:00:00+05:00";
const updatedDate = "2026-07-30T10:00:00+05:00";

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "CST, Central Standard Time, UTC-6, CST offset, CST time zone, CST vs CDT, Chicago time, Houston time, CST to GMT, CST to EST, CST to PST",
  image: "/assets/cst-timezone-guide.webp",
  imageAlt: "Central Standard Time (CST) UTC-6 Offset Guide",
  pubDate,
  updatedDate,
  author: "Jackie Bruce",
  faqs: [
    {
      q: "What does CST stand for?",
      a: "CST stands for Central Standard Time. It is a standard time offset observed in central North America and Central America, operating exactly 6 hours behind Coordinated Universal Time (UTC-6)."
    },
    {
      q: "What is the UTC offset for CST?",
      a: "The UTC offset for Central Standard Time (CST) is UTC-6. During standard winter months, local time in the Central zone is 6 hours behind Greenwich Mean Time (GMT/UTC)."
    },
    {
      q: "Which major cities observe Central Standard Time?",
      a: "Major metropolitan areas observing CST during winter include Chicago, Houston, Dallas, San Antonio, Austin, Minneapolis, St. Louis, Winnipeg, and Regina. Additionally, Central American nations like Guatemala City and San José observe CST (UTC-6) year-round."
    },
    {
      q: "What is the difference between CST and CDT?",
      a: "CST (Central Standard Time) is UTC-6, active during the winter months. CDT (Central Daylight Time) is UTC-5, active during the summer months when clocks are set forward by 1 hour."
    },
    {
      q: "When does CST change to CDT?",
      a: "Central Standard Time (CST) changes to Central Daylight Time (CDT) on the second Sunday of March at 2:00 AM local time. Clocks return to CST on the first Sunday of November at 2:00 AM."
    },
    {
      q: "How far behind GMT is CST?",
      a: "CST is 6 hours behind Greenwich Mean Time (GMT/UTC+0). When it is 12:00 PM (noon) GMT in London, it is 6:00 AM CST in Chicago or Dallas."
    },
    {
      q: "How do I convert CST to Eastern Standard Time (EST)?",
      a: "Central Standard Time (CST, UTC-6) is 1 hour behind Eastern Standard Time (EST, UTC-5). To convert CST to EST, add 1 hour (e.g., 9:00 AM CST equals 10:00 AM EST)."
    },
    {
      q: "How do I convert CST to Pacific Standard Time (PST)?",
      a: "Central Standard Time (CST, UTC-6) is 2 hours ahead of Pacific Standard Time (PST, UTC-8). To convert CST to PST, subtract 2 hours (e.g., 2:00 PM CST equals 12:00 PM PST)."
    },
    {
      q: "Which US states observe Central Standard Time?",
      a: "20 US states observe Central Standard Time fully or partially. States fully in Central Time include Illinois, Iowa, Missouri, Wisconsin, Oklahoma, Arkansas, Louisiana, and Mississippi. States split between Central and Eastern/Mountain time include Texas, Florida, Indiana, Kentucky, Tennessee, Alabama, Kansas, Nebraska, and the Dakotas."
    },
    {
      q: "Which Canadian provinces operate in Central Time?",
      a: "Manitoba, most of Saskatchewan, northwestern Ontario, and parts of Nunavut operate in Central Time. Note that Saskatchewan observes Central Standard Time (UTC-6) year-round without daylight saving adjustments."
    },
    {
      q: "Which countries in Central America observe CST year-round?",
      a: "Guatemala, Belize, Costa Rica, El Salvador, Honduras, and Nicaragua observe UTC-6 year-round without daylight saving shifts."
    },
    {
      q: "Does Mexico still observe Central Daylight Time?",
      a: "In October 2022, Mexico eliminated Daylight Saving Time for most of the country. Consequently, Mexico City and central Mexican states operate on Central Standard Time (UTC-6) year-round. Only northern border zones retain DST synchronization with the US."
    },
    {
      q: "What is the time difference between CST and Central European Time (CET)?",
      a: "Central European Time (CET, UTC+1) is 7 hours ahead of Central Standard Time (CST, UTC-6). When it is 10:00 AM CST in Chicago, it is 5:00 PM CET in Paris and Berlin."
    },
    {
      q: "What is the time difference between CST and India Standard Time (IST)?",
      a: "India Standard Time (IST, UTC+5:30) is 11 hours and 30 minutes ahead of Central Standard Time (CST, UTC-6). When it is 8:00 AM CST in Chicago, it is 7:30 PM IST in New Delhi."
    },
    {
      q: "Why is Chicago considered the central hub for CST?",
      a: "Chicago serves as the economic engine of the Central Time Zone due to its status as a major agricultural commodity exchange (Chicago Board of Trade), financial trading center, and global aviation hub (O'Hare International Airport)."
    },
    {
      q: "Is China Standard Time also abbreviated as CST?",
      a: "Yes. In international contexts, CST can stand for Central Standard Time (UTC-6), China Standard Time (UTC+8), or Cuba Standard Time (UTC-5). Software developers use IANA time zone identifiers (such as `America/Chicago` or `Asia/Shanghai`) to prevent ambiguity."
    },
    {
      q: "How does CST affect broadcast television schedules?",
      a: "In the United States, television network broadcasts are aligned to Eastern and Central times simultaneously (e.g., '8/7 Central', meaning 8:00 PM Eastern / 7:00 PM Central)."
    },
    {
      q: "What is the time difference between CST and Australian Eastern Standard Time (AEST)?",
      a: "Australian Eastern Standard Time (AEST, UTC+10) is 16 hours ahead of Central Standard Time (CST, UTC-6). When it is 6:00 AM CST in Dallas, it is 10:00 PM AEST in Sydney."
    },
    {
      q: "What happens to flight arrival times during the November shift back to CST?",
      a: "Airline reservation engines account for the 1-hour fall back transition by utilizing UTC timestamps in the backend, ensuring itineraries show local wall-clock times upon arrival."
    },
    {
      q: "Can CST offset change relative to GMT?",
      a: "CST itself is strictly fixed at UTC-6. However, because the UK shifts between GMT (UTC+0) and BST (UTC+1), the time difference between London and Chicago varies between 6 hours in winter and 5 or 7 hours during transitional weeks."
    }
  ]
};

const pageUrlPath = `${siteUrl}/${slug}/`;
---

<BaseLayout
  lang={lang}
  dir={dir}
  title={seoTitle}
  description={pageDescription}
  slug={slug}
  meta={meta}
  enableFaqSchema={true}
  enableArticleSchema={true}
  breadcrumbHomeLabel="Home"
  breadcrumbLabel="CST"
>
  <!-- Hero Section -->
  <section class="hero-banner" aria-labelledby="hero-title">
    <h1 id="hero-title" class="hero-banner-title speakable-headline">
      Central Standard Time (CST): <span class="gradient-text">UTC-6 Offset & Complete Guide</span>
    </h1>
  </section>

  <!-- Editorial Info Bar -->
  <div class="editorial-meta-bar" aria-label="Editorial metadata">
    <span>Last Updated: <strong>July 30, 2026</strong></span>
    <span class="separator" aria-hidden="true">•</span>
    <span>Editorially Reviewed by <a href="/author/jackie-bruce/"><strong>Jackie Bruce</strong></a></span>
    <span class="separator" aria-hidden="true">•</span>
    <span>Data Source: <a href="https://www.iana.org/time-zones" target="_blank" rel="noopener noreferrer"><strong>IANA Time Zone Database</strong></a></span>
  </div>

  <div class="article-wrapper">
    <!-- Top Answer Summary Box -->
    <div class="summary-box speakable-summary">
      <div class="summary-header">
        <span class="summary-badge">TIME ZONE PROFILE</span>
        <h2>Central Standard Time (CST) Summary</h2>
      </div>
      <div class="summary-grid">
        <div class="summary-item">
          <span class="label">UTC Offset:</span>
          <span class="val highlight">UTC-6 (6 hours behind GMT)</span>
        </div>
        <div class="summary-item">
          <span class="label">Active Window:</span>
          <span class="val">November to March (US/Canada Winter)</span>
        </div>
        <div class="summary-item">
          <span class="label">DST Counterpart:</span>
          <span class="val"><a href="/cdt/">CDT (Central Daylight Time, UTC-5)</a></span>
        </div>
        <div class="summary-item">
          <span class="label">Major Cities:</span>
          <span class="val"><a href="/chicago-time/">Chicago</a>, Houston, Dallas, Mexico City, Winnipeg</span>
        </div>
        <div class="summary-item">
          <span class="label">Year-Round Regions:</span>
          <span class="val">Guatemala, Costa Rica, Saskatchewan (most)</span>
        </div>
        <div class="summary-item">
          <span class="label">Time Diff to EST:</span>
          <span class="val">CST is 1 hour behind <a href="/est/">EST (UTC-5)</a></span>
        </div>
      </div>
      <p class="summary-text">
        <strong>Central Standard Time (CST)</strong> is the standard time zone covering central North America and Central America, keeping clocks at a constant offset of <strong>UTC-6</strong>. Encompassing major agricultural, logistics, and energy hubs such as Chicago, Houston, Dallas, and Winnipeg, CST is 1 hour behind Eastern Standard Time and 2 hours ahead of Pacific Standard Time.
      </p>
    </div>

    <!-- Table of Contents -->
    <nav class="about-toc" aria-label="Table of Contents">
      <h2>Table of Contents</h2>
      <ul>
        <li><a href="#what-is-cst">1. What is Central Standard Time (CST)?</a></li>
        <li><a href="#cst-vs-cdt">2. CST vs. CDT: Seasonal Transitions</a></li>
        <li><a href="#geographic-extent">3. Geographic Extent Across North & Central America</a></li>
        <li><a href="#conversion-tables">4. Global Time Conversion Tables (GMT, EST, PST, CET, IST)</a></li>
        <li><a href="#economic-hubs">5. Financial Exchanges, Commodity Markets & Logistics</a></li>
        <li><a href="#ambiguity-notice">6. Ambiguity Notice: CST Acronym Disambiguation</a></li>
        <li><a href="#faqs">7. Frequently Asked Questions (20 Detailed Answers)</a></li>
      </ul>
    </nav>

    <!-- Content Sections -->
    <section id="what-is-cst" class="content-section">
      <h2>1. What is Central Standard Time (CST)?</h2>
      <p>
        <strong>Central Standard Time (CST)</strong> is the second most populous time zone in North America. Positioned between the Eastern and Mountain time zones, CST maintains an offset of <strong>UTC-6</strong> (6 hours behind <a href="/utc/">Coordinated Universal Time</a> and <a href="/gmt/">Greenwich Mean Time</a>).
      </p>
      <p>
        Established by US railway companies in 1883 and formalized under the Standard Time Act of 1918, the Central Time Zone encompasses the vast agricultural heartland, Great Plains, and Gulf Coast regions of North America.
      </p>
    </section>

    <!-- SVG Diagram 1: Geographic Offset Span -->
    <section class="diagram-section">
      <div class="diagram-card">
        <h3>Figure 1: North American Time Zone Hierarchy (PST ⇄ CST ⇄ EST)</h3>
        <div class="svg-wrapper">
          <svg viewBox="0 0 800 220" width="100%" height="auto" xmlns="http://www.w3.org/2000/svg" aria-label="Central Time Zone Position relative to EST and PST">
            <rect width="800" height="220" fill="var(--panel)" rx="12" stroke="var(--line)" stroke-width="1"/>
            
            <!-- PST -->
            <rect x="50" y="60" width="200" height="100" rx="8" fill="rgba(255,255,255,0.02)" stroke="var(--line)" stroke-width="1.5"/>
            <text x="150" y="95" text-anchor="middle" fill="var(--text)" font-family="Space Grotesk, sans-serif" font-weight="bold" font-size="16">PST (UTC-8)</text>
            <text x="150" y="125" text-anchor="middle" fill="var(--muted)" font-size="12">Pacific Coast</text>

            <!-- Arrow 1 -->
            <path d="M 260 110 L 290 110" stroke="var(--line)" stroke-width="2"/>

            <!-- CST (Center Focus) -->
            <rect x="300" y="50" width="200" height="120" rx="8" fill="rgba(255,255,255,0.03)" stroke="var(--accent)" stroke-width="2"/>
            <text x="400" y="85" text-anchor="middle" fill="var(--accent)" font-family="Space Grotesk, sans-serif" font-weight="bold" font-size="18">CST (UTC-6)</text>
            <text x="400" y="115" text-anchor="middle" fill="var(--text)" font-weight="bold" font-size="13">Central Heartland</text>
            <text x="400" y="140" text-anchor="middle" fill="var(--muted)" font-size="11">Chicago / Houston</text>

            <!-- Arrow 2 -->
            <path d="M 510 110 L 540 110" stroke="var(--line)" stroke-width="2"/>

            <!-- EST -->
            <rect x="550" y="60" width="200" height="100" rx="8" fill="rgba(255,255,255,0.02)" stroke="var(--line)" stroke-width="1.5"/>
            <text x="650" y="95" text-anchor="middle" fill="var(--text)" font-family="Space Grotesk, sans-serif" font-weight="bold" font-size="16">EST (UTC-5)</text>
            <text x="650" y="125" text-anchor="middle" fill="var(--muted)" font-size="12">Eastern Seaboard</text>
          </svg>
        </div>
        <p class="diagram-caption">
          Figure 1: Position of Central Standard Time (UTC-6) situated between Pacific Standard Time (UTC-8) and Eastern Standard Time (UTC-5).
        </p>
      </div>
    </section>

    <section id="cst-vs-cdt" class="content-section">
      <h2>2. CST vs. CDT: Seasonal Transitions</h2>
      <p>
        During the warmer months, most North American jurisdictions in the Central Time zone shift to <a href="/cdt/">Central Daylight Time (CDT, UTC-5)</a>:
      </p>
      <ul>
        <li><strong>Central Standard Time (CST, UTC-6):</strong> Active from the first Sunday of November to the second Sunday of March.</li>
        <li><strong>Central Daylight Time (CDT, UTC-5):</strong> Active from the second Sunday of March to the first Sunday of November.</li>
      </ul>
      <p>
        Note that during CDT, Central Daylight Time shares the exact same UTC-5 offset as winter Eastern Standard Time (<a href="/est/">EST</a>).
      </p>
    </section>

    <section id="geographic-extent" class="content-section">
      <h2>3. Geographic Extent Across North & Central America</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Country</th>
              <th>Regions / States</th>
              <th>DST Schedule</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>United States</strong></td>
              <td>Illinois, Texas, Minnesota, Missouri, Louisiana, Wisconsin</td>
              <td>Switches to CDT (UTC-5) in summer</td>
            </tr>
            <tr>
              <td><strong>Canada</strong></td>
              <td>Manitoba, Northwestern Ontario, Nunavut</td>
              <td>Switches to CDT (UTC-5) in summer</td>
            </tr>
            <tr>
              <td><strong>Canada (Saskatchewan)</strong></td>
              <td>Most of Saskatchewan (Regina, Saskatoon)</td>
              <td>Observes CST (UTC-6) year-round (No DST)</td>
            </tr>
            <tr>
              <td><strong>Mexico</strong></td>
              <td>Mexico City, Guadalajara, Monterrey (Central Mexico)</td>
              <td>Observes CST (UTC-6) year-round (Abolished DST 2022)</td>
            </tr>
            <tr>
              <td><strong>Central America</strong></td>
              <td>Guatemala, Costa Rica, El Salvador, Honduras, Nicaragua, Belize</td>
              <td>Observes CST (UTC-6) year-round (No DST)</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p>
        For broader country timezone frameworks, visit <a href="/usa-time-zones/">USA Time Zones</a> and <a href="/canada-time-zones/">Canada Time Zones</a>.
      </p>
    </section>

    <section id="conversion-tables" class="content-section">
      <h2>4. Global Time Conversion Tables (GMT, EST, PST, CET, IST)</h2>
      <p>
        Convert Central Standard Time (CST, UTC-6) to major global time zones using the conversion grid below:
      </p>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>CST (UTC-6)</th>
              <th>GMT (UTC+0)<br/><a href="/gmt-to-cst/">CST to GMT</a></th>
              <th>EST (UTC-5)<br/><a href="/gmt-to-cst/">CST to EST</a></th>
              <th>PST (UTC-8)<br/><a href="/gmt-to-pst/">CST to PST</a></th>
              <th>CET (UTC+1)<br/><a href="/cet-to-est/">CST to CET</a></th>
              <th>IST (UTC+5:30)<br/><a href="/ist-to-est/">CST to IST</a></th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>00:00 CST (Midnight)</td>
              <td>06:00 GMT</td>
              <td>01:00 EST</td>
              <td>22:00 PST (Prev Day)</td>
              <td>07:00 CET</td>
              <td>11:30 IST</td>
            </tr>
            <tr>
              <td>06:00 CST</td>
              <td>12:00 GMT</td>
              <td>07:00 EST</td>
              <td>04:00 PST</td>
              <td>13:00 CET</td>
              <td>17:30 IST</td>
            </tr>
            <tr>
              <td>09:00 CST</td>
              <td>15:00 GMT</td>
              <td>10:00 EST</td>
              <td>07:00 PST</td>
              <td>16:00 CET</td>
              <td>20:30 IST</td>
            </tr>
            <tr>
              <td>12:00 CST (Noon)</td>
              <td>18:00 GMT</td>
              <td>13:00 EST</td>
              <td>10:00 PST</td>
              <td>19:00 CET</td>
              <td>23:30 IST</td>
            </tr>
            <tr>
              <td>15:00 CST</td>
              <td>21:00 GMT</td>
              <td>16:00 EST</td>
              <td>13:00 PST</td>
              <td>22:00 CET</td>
              <td>02:30 IST (Next Day)</td>
            </tr>
            <tr>
              <td>18:00 CST</td>
              <td>00:00 GMT (Next Day)</td>
              <td>19:00 EST</td>
              <td>16:00 PST</td>
              <td>01:00 CET (Next Day)</td>
              <td>05:30 IST (Next Day)</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p>
        For live conversions, launch our <a href="/gmt-to-cdt/">GMT to CST Time Converter</a>.
      </p>
    </section>

    <!-- SVG Diagram 2: CST Offset Dial -->
    <section class="diagram-section">
      <div class="diagram-card">
        <h3>Figure 2: CST (UTC-6) Offset Relational Dial</h3>
        <div class="svg-wrapper">
          <svg viewBox="0 0 800 220" width="100%" height="auto" xmlns="http://www.w3.org/2000/svg" aria-label="CST Offset Relational Dial">
            <rect width="800" height="220" fill="var(--panel)" rx="12" stroke="var(--line)" stroke-width="1"/>
            
            <circle cx="400" cy="110" r="38" fill="var(--accent)" stroke="#ffffff" stroke-width="2.5"/>
            <text x="400" y="115" text-anchor="middle" fill="#ffffff" font-family="Space Grotesk, sans-serif" font-weight="bold" font-size="16">CST</text>
            <text x="400" y="165" text-anchor="middle" fill="var(--accent)" font-weight="bold" font-size="12">UTC-6 Baseline</text>

            <circle cx="200" cy="110" r="30" fill="var(--panel)" stroke="var(--line)" stroke-width="2"/>
            <text x="200" y="114" text-anchor="middle" fill="var(--text)" font-weight="bold" font-size="13">PST</text>
            <text x="200" y="160" text-anchor="middle" fill="var(--muted)" font-size="11">-2 Hours</text>

            <circle cx="600" cy="110" r="30" fill="var(--panel)" stroke="var(--line)" stroke-width="2"/>
            <text x="600" y="114" text-anchor="middle" fill="var(--text)" font-weight="bold" font-size="13">GMT</text>
            <text x="600" y="160" text-anchor="middle" fill="var(--muted)" font-size="11">+6 Hours</text>

            <line x1="230" y1="110" x2="362" y2="110" stroke="var(--line)" stroke-width="2"/>
            <line x1="438" y1="110" x2="570" y2="110" stroke="var(--line)" stroke-width="2"/>
          </svg>
        </div>
        <p class="diagram-caption">
          Figure 2: Relational diagram depicting CST relative to PST (-2 hours) and GMT (+6 hours).
        </p>
      </div>
    </section>

    <section id="economic-hubs" class="content-section">
      <h2>5. Financial Exchanges, Commodity Markets & Logistics</h2>
      <p>
        The Central Time zone is home to major commodity exchanges including the <strong>Chicago Mercantile Exchange (CME)</strong> and the <strong>Chicago Board of Trade (CBOT)</strong>, which set global futures prices for agricultural products, energy contracts, and interest rate derivatives. 
      </p>
      <p>
        Additionally, the world's largest logistics distribution nodes—including FedEx's global hub in Memphis and O'Hare International Airport in Chicago—coordinate freight routing on Central Time.
      </p>
    </section>

    <section id="ambiguity-notice" class="content-section">
      <h2>6. Ambiguity Notice: CST Acronym Disambiguation</h2>
      <p>
        When configuring software APIs or international contracts, note that <strong>CST</strong> can represent multiple distinct time zones:
      </p>
      <ul>
        <li><strong>Central Standard Time (North America):</strong> UTC-6</li>
        <li><strong>China Standard Time (Beijing):</strong> UTC+8</li>
        <li><strong>Cuba Standard Time (Havana):</strong> UTC-5</li>
      </ul>
      <p>
        Always specify exact IANA identifier strings (e.g., <code>America/Chicago</code> vs. <code>Asia/Shanghai</code>) in developer code bases.
      </p>
    </section>

    <!-- Contextual Widgets Integration -->
    <RelatedConvertersWidget slug={slug} />
    <UsersAlsoVisitWidget slug={slug} />
    <LearnMoreWidget slug={slug} />
    <CountryCityWidget slug={slug} />

    <!-- FAQ Section -->
    <section id="faqs" class="content-section faqs-section">
      <h2>7. Frequently Asked Questions (CST)</h2>
      <div class="faq-list">
        {meta.faqs.map((faq, index) => (
          <details class="faq-item" open={index === 0}>
            <summary class="faq-question">
              <h3>{faq.q}</h3>
            </summary>
            <div class="faq-answer">
              <p>{faq.a}</p>
            </div>
          </details>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .article-wrapper {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 1rem 3rem;
  }
  .hero-banner {
    text-align: center;
    padding: 3rem 1rem 1.5rem;
  }
  .hero-banner-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--text);
  }
  .gradient-text {
    background: linear-gradient(135deg, var(--accent) 0%, #38bdf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .editorial-meta-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--muted);
    margin-bottom: 2rem;
    padding: 0.75rem 1rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
  }
  .editorial-meta-bar a {
    color: var(--accent);
    text-decoration: none;
  }
  .separator {
    opacity: 0.5;
  }
  .summary-box {
    background: var(--panel);
    border: 1px solid var(--accent);
    border-radius: 12px;
    padding: 1.75rem;
    margin-bottom: 2.5rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.15);
  }
  .summary-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }
  .summary-badge {
    background: var(--accent);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    letter-spacing: 0.05em;
  }
  .summary-header h2 {
    font-size: 1.35rem;
    margin: 0;
    color: var(--text);
  }
  .summary-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
