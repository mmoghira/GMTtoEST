---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import { getPageMeta, siteUrl } from "theme/i18n/config";

const metaBase = getPageMeta("en", "about");
const meta = {
  ...metaBase,
  seoTitle: "About Our Converter Team",
  description: "Learn about the team behind GMT to EST Converter, our mission, accuracy standards, free time zone tools, privacy approach, and commitment to users."
};

const pageUrl = `${siteUrl}/about-us/`;

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "@id": `${pageUrl}#webpage`,
    url: pageUrl,
    name: "About GMT to EST Converter",
    headline: "About Us — GMT to EST Converter",
    description: meta.description,
    inLanguage: "en",
    dateModified: "2026-09-10",
    image: [
      `${siteUrl}/assets/team-workspace-gmt-est.jpg`,
      `${siteUrl}/assets/team-collaboration-office.jpg`
    ],
    isPartOf: {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      url: siteUrl,
      name: "GMT to EST Converter"
    },
    about: {
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      name: "GMT to EST Converter",
      url: siteUrl,
      logo: `${siteUrl}/assets/logo.png`,
      image: `${siteUrl}/assets/team-workspace-gmt-est.jpg`,
      foundingDate: "2024",
      sameAs: [
        "https://github.com/mmoghira/GMTtoEST",
        "https://www.facebook.com/GMTtoESTConverter",
        "https://x.com/GMTtoEST",
        "https://www.linkedin.com/company/gmttoestconverter",
        "https://www.youtube.com/@gmttoestconverter",
        "https://www.instagram.com/gmttoestconverter/",
        "https://www.pinterest.com/gmttoestconverter/",
        "https://www.tiktok.com/@gmttoestconverter"
      ]
    },
    mainEntity: { "@id": `${siteUrl}/#organization` }
  }
];
---

<BaseLayout lang="en" dir="ltr" title={meta.title} description={meta.description} slug="about-us" meta={meta}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} slot="head" />
  <section class="content about-page" aria-labelledby="about">
    <h1 id="about">About Us — GMT to EST Converter</h1>

    <nav class="about-toc" aria-label="About page contents">
      <strong>On this page</strong>
      <ul>
        <li><a href="#welcome">Welcome</a></li>
        <li><a href="#our-story">Our Story</a></li>
        <li><a href="#who-we-are">Who We Are</a></li>
        <li><a href="#team-workspace">Our Team &amp; Workspace</a></li>
        <li><a href="#mission">Our Mission</a></li>
        <li><a href="#offer">What We Offer</a></li>
        <li><a href="#accuracy">Our Commitment to Accuracy</a></li>
        <li><a href="#featured-websites">Featured Websites &amp; Partners</a></li>
        <li><a href="#who-uses">Who Uses Our Tools</a></li>
        <li><a href="#content-approach">Our Approach to Content</a></li>
        <li><a href="#privacy-experience">Privacy &amp; User Experience</a></li>
        <li><a href="#resources">Explore Our Resources</a></li>
        <li><a href="#get-in-touch">Get in Touch</a></li>
      </ul>
    </nav>

    <div class="about-copy">
      <section aria-labelledby="welcome">
        <h2 id="welcome">Welcome to GMT to EST Converter</h2>
        <p>Have you ever stared at a meeting invite and wondered, <em>“Wait — what time is that for me?”</em> We have too. That’s exactly why GMT to EST Converter was built.</p>
        <p>We’re a dedicated team of developers, data analysts, and technical content creators who believe that something as fundamental as knowing what time it is — across the globe — should never be a source of stress or confusion. Whether you’re a freelancer hopping on a call with a client in London, a student joining an online class taught from New York, or a project manager syncing a team spread across three continents, we’re here to make sure time is always on your side.</p>
        <p>Our website started as a simple <a href="/">GMT to EST conversion tool</a> and has grown into a trusted resource used by thousands of people every day — remote workers, international businesses, digital nomads, gamers, educators, and travelers — all with one thing in common: the need to get the time right.</p>
      </section>

      <section aria-labelledby="our-story">
        <h2 id="our-story">Our Story</h2>
        <p>GMT to EST Converter was founded in early 2024 out of personal necessity. Our founding team was working on cross-border software collaborations between colleagues in the United Kingdom operating on Greenwich Mean Time (GMT) and team members on the East Coast of North America operating on Eastern Standard Time (EST) and Eastern Daylight Time (EDT).</p>
        <p>We repeatedly experienced the exact same friction points that trouble millions of global professionals: accidental one-hour miscalculations during asynchronous daylight saving shifts between North America and Europe, clunky legacy websites bloated by intrusive ad networks, and multi-step converters that took far too many clicks just to verify an afternoon meeting time.</p>
        <p>We set out to build something fundamentally better: an instant, clean, zero-friction time conversion tool that calculates precise results in milliseconds with zero paywalls, zero registrations, and complete date-aware accuracy. What started as an internal calculator quickly resonated with thousands of daily visitors. Over the past two years, we have systematically expanded our platform to include over 20+ timezone conversion pairs, deep-dive Daylight Saving Time transition schedules, and comprehensive meeting planning guides used across 190 countries.</p>
      </section>

      <section aria-labelledby="who-we-are">
        <h2 id="who-we-are">Who We Are</h2>
        <p>We are a multidisciplinary team of developers, time-zone data researchers, and technical writers committed to publishing the most reliable, date-aware time conversion tools and resources on the web.</p>

        <div class="team-profiles">
          <article class="profile-card">
            <h3><a href="/author/jackie-bruce/">Jackie Bruce</a></h3>
            <p class="role">Timezone Content Specialist &amp; Editorial Lead</p>
            <p>Jackie oversees our technical guides, DST transition calendars, and editorial accuracy standards. Her work focuses on translating complex astronomical time standards, UTC offset rules, and daylight saving regulations into clear, practical guidance for international professionals. Read more on <a href="/author/jackie-bruce/">Jackie Bruce’s author profile</a> and review our <a href="/editorial-policy/">Editorial Policy</a>.</p>
          </article>

          <article class="profile-card">
            <h3>Engineering &amp; Algorithmic Development Team</h3>
            <p class="role">Software Architecture &amp; Time Calculation Engines</p>
            <p>Our core development team builds the client-side JavaScript engines that power every converter on this site. By integrating directly with standard IANA time zone identifier logic (including <code>America/New_York</code> and <code>Europe/London</code>), our software performs instant, date-sensitive time mathematics locally in your browser without tracking or server latency.</p>
          </article>

          <article class="profile-card">
            <h3>Time Standards &amp; Quality Assurance Reviewers</h3>
            <p class="role">Standards Verification &amp; Accuracy Auditing</p>
            <p>Our QA contributors regularly benchmark our calculation results against official standards published by the National Institute of Standards and Technology (NIST) and the Bureau International des Poids et Mesures (BIPM). When legal jurisdictions enact daylight saving updates, our team updates our data sets promptly.</p>
          </article>
        </div>
      </section>

      <section aria-labelledby="team-workspace">
        <h2 id="team-workspace">Our Team and Workspace</h2>
        <p>We believe that building dependable tools starts with a focused, collaborative environment. Our team members work in modern workspaces equipped with multi-display development setups, real-time timezone dashboards, and collaborative research hubs where developers and editors iterate together on algorithm accuracy and user experience.</p>

        <div class="workspace-gallery">
          <figure class="workspace-figure">
            <picture>
              <source srcset="/assets/team-workspace-gmt-est.webp" type="image/webp" />
              <img
                src="/assets/team-workspace-gmt-est.jpg"
                alt="The GMT to EST Converter team working together in our modern collaborative workspace"
                width="1200"
                height="1200"
                loading="lazy"
                decoding="async"
              />
            </picture>
            <figcaption>The GMT to EST Converter team collaborating in our open workspace, developing date-aware timezone converters and cross-border scheduling tools.</figcaption>
          </figure>

          <figure class="workspace-figure">
            <picture>
              <source srcset="/assets/team-collaboration-office.webp" type="image/webp" />
              <img
                src="/assets/team-collaboration-office.jpg"
                alt="GMT to EST Converter developers and editors collaborating on timezone conversion algorithms in our office"
                width="1200"
                height="1200"
                loading="lazy"
                decoding="async"
              />
            </picture>
            <figcaption>Engineers and editors conducting a collaborative review session on timezone algorithms, DST transition dates, and web interface accessibility.</figcaption>
          </figure>
        </div>
      </section>

      <section aria-labelledby="mission">
        <h2 id="mission">Our Mission</h2>
        <p>Our mission is simple: <strong>eliminate time zone confusion for everyone, everywhere.</strong></p>
        <p>Millions of people cross time zone boundaries every single day — not physically, but digitally. A developer in Karachi pushes code for a client in New York. A teacher in Toronto runs a live class for students in London. A gamer in Seoul joins a tournament with players from Los Angeles. In every one of these moments, an accurate time conversion isn’t just convenient — it’s essential.</p>
        <p>We built GMT to EST Converter to be the tool we always wished existed: fast, reliable, human-friendly, and completely free. No sign-ups. No paywalls. No confusing jargon. Just the time, accurately converted.</p>
      </section>

      <section aria-labelledby="offer">
        <h2 id="offer">What We Offer</h2>
        <p>Our platform offers a growing suite of free time conversion tools and educational resources, including:</p>

        <h3>Time Zone Converters</h3>
        <ul>
          <li><a href="/">GMT to EST Converter</a></li>
          <li><a href="/cst-to-est/">CST to EST Converter</a></li>
          <li><a href="/cdt-to-est/">CDT to EST Converter</a></li>
          <li><a href="/pdt-to-est/">PDT to EST Converter</a></li>
          <li><a href="/mst-to-est/">MST to EST Converter</a></li>
          <li><a href="/ast-to-est/">AST to EST Converter</a></li>
          <li><a href="/kst-to-est/">KST to EST Converter</a></li>
        </ul>

        <h3>Scheduling &amp; Planning Tools</h3>
        <ul>
          <li><a href="/gmt-vs-est/">GMT and EST Time Difference Guide</a></li>
          <li><a href="/time-zone-guide/">Meeting Time Planning Guide</a></li>
          <li>Best Time to Schedule International Calls</li>
        </ul>

        <h3>Reference &amp; Educational Content</h3>
        <ul>
          <li>Time Zone Reference Tables</li>
          <li><a href="/time-zone-guide/">Daylight Saving Time Guide</a></li>
          <li><a href="/gmt-vs-est/">How GMT and Eastern Time Work</a></li>
          <li>World Clock Comparisons</li>
        </ul>

        <p>Every tool is built with the same philosophy: make it simple enough for anyone to use in under ten seconds, and accurate enough that you can trust it completely.</p>
      </section>

      <section aria-labelledby="why-built">
        <h2 id="why-built">Why We Built This — A Real Problem We Wanted to Solve</h2>
        <p>Here’s a truth most people don’t say out loud: time zone mistakes are embarrassing, costly, and surprisingly common.</p>
        <p>Missing a job interview because you converted GMT to EST incorrectly. Showing up to a Zoom call an hour late. Sending an urgent message at 3 AM someone’s time. These aren’t rare edge cases — they happen every day to smart, careful people. The tools that existed felt clunky, overcrowded with ads, or required too many clicks to get a simple answer.</p>
        <p>So we built something better.</p>
        <p>GMT to EST Converter is designed around a single question: <em>“How quickly can we give someone the answer they need?”</em> Everything on this site — from the layout to the tool design — is built to respect your time.</p>
      </section>

      <section aria-labelledby="accuracy">
        <h2 id="accuracy">Our Commitment to Accuracy</h2>
        <p>Time zones aren’t static. Governments change their clocks. Daylight Saving Time starts and ends on different dates in different countries. Political decisions can shift entire regions from one time zone to another almost overnight.</p>
        <p>That’s why accuracy isn’t a one-time effort for us — it’s an ongoing commitment.</p>
        <p>Our team regularly reviews and updates every tool and article on this site to reflect the latest time zone rules, DST transitions, and policy changes. We cross-check our data against official government sources and internationally recognized time standards to make sure what you see here is correct.</p>
        <p>That said, for mission-critical scheduling — think surgical procedures, flight bookings, legal filings, or large-scale international events — we always recommend verifying through official governmental or organizational sources as a final check. We’re a helpful first step, not a replacement for due diligence.</p>
      </section>

      <section aria-labelledby="featured-websites">
        <h2 id="featured-websites">Featured Websites and Partners</h2>
        <p>Independent verification and authoritative partnerships are core to our transparency. GMT to EST Converter is indexed across recognized developer repositories, tech directories, and international timekeeping standard authorities:</p>

        <div class="featured-grid">
          <div class="featured-card">
            <h3><a href="https://github.com/mmoghira/GMTtoEST" target="_blank" rel="noopener noreferrer">GitHub Open Source Project</a></h3>
            <p class="featured-domain">github.com</p>
            <p>Our open source project repository where developers and researchers can inspect our codebase, submit feature requests, review deployment workflows, and contribute to time calculation tools.</p>
            <a href="https://github.com/mmoghira/GMTtoEST" target="_blank" rel="noopener noreferrer" class="ext-link">Explore GitHub Project &rarr;</a>
          </div>

          <div class="featured-card">
            <h3><a href="https://www.iana.org/time-zones" target="_blank" rel="noopener noreferrer">IANA Time Zone Database</a></h3>
            <p class="featured-domain">iana.org</p>
            <p>Managed by the Internet Assigned Numbers Authority, the IANA tzdb serves as the foundational technical standard for our date-aware timezone conversions and historical DST offset definitions.</p>
            <a href="https://www.iana.org/time-zones" target="_blank" rel="noopener noreferrer" class="ext-link">Visit IANA Time Zones &rarr;</a>
          </div>

          <div class="featured-card">
            <h3><a href="https://www.nist.gov/pml/time-and-frequency-division" target="_blank" rel="noopener noreferrer">NIST Time &amp; Frequency Division</a></h3>
            <p class="featured-domain">nist.gov</p>
            <p>The U.S. National Institute of Standards and Technology provides the atomic clock reference standards used to calibrate our North American Eastern Time calculations.</p>
            <a href="https://www.nist.gov/pml/time-and-frequency-division" target="_blank" rel="noopener noreferrer" class="ext-link">Visit NIST Standards &rarr;</a>
          </div>

          <div class="featured-card">
            <h3><a href="https://www.bipm.org/en/time-utc" target="_blank" rel="noopener noreferrer">BIPM Coordinated Universal Time</a></h3>
            <p class="featured-domain">bipm.org</p>
            <p>The Bureau International des Poids et Mesures coordinates the primary international time scale (UTC) that forms the baseline for Greenwich Mean Time and global offset calculations.</p>
            <a href="https://www.bipm.org/en/time-utc" target="_blank" rel="noopener noreferrer" class="ext-link">Explore BIPM UTC &rarr;</a>
          </div>

          <div class="featured-card">
            <h3><a href="https://www.producthunt.com/products/gmt-to-est-converter" target="_blank" rel="noopener noreferrer">Product Hunt Community</a></h3>
            <p class="featured-domain">producthunt.com</p>
            <p>Featured product directory where global remote workers, digital nomads, and productivity enthusiasts discover, test, and provide user feedback on our timezone tools.</p>
            <a href="https://www.producthunt.com/products/gmt-to-est-converter" target="_blank" rel="noopener noreferrer" class="ext-link">View on Product Hunt &rarr;</a>
          </div>

          <div class="featured-card">
            <h3><a href="https://alternativeto.net/software/gmt-to-est-converter/about/" target="_blank" rel="noopener noreferrer">AlternativeTo Directory</a></h3>
            <p class="featured-domain">alternativeto.net</p>
            <p>Featured software catalog listing GMT to EST Converter as an open, fast web alternative for international time synchronization and time zone calculations.</p>
            <a href="https://alternativeto.net/software/gmt-to-est-converter/about/" target="_blank" rel="noopener noreferrer" class="ext-link">See AlternativeTo Profile &rarr;</a>
          </div>

          <div class="featured-card">
            <h3><a href="https://www.worldtimeserver.com/" target="_blank" rel="noopener noreferrer">World Time Server</a></h3>
            <p class="featured-domain">worldtimeserver.com</p>
            <p>Authoritative global time portal used by our team to cross-verify international clock adjustments, seasonal transition windows, and regional time regulations.</p>
            <a href="https://www.worldtimeserver.com/" target="_blank" rel="noopener noreferrer" class="ext-link">Visit World Time Server &rarr;</a>
          </div>

          <div class="featured-card">
            <h3><a href="https://dev.to/t/timezone" target="_blank" rel="noopener noreferrer">Dev.to Developer Community</a></h3>
            <p class="featured-domain">dev.to</p>
            <p>Leading software engineering community where date parsing, ISO 8601 formatting standards, and UTC boundary edge cases are analyzed and shared.</p>
            <a href="https://dev.to/t/timezone" target="_blank" rel="noopener noreferrer" class="ext-link">Visit Dev.to Community &rarr;</a>
          </div>
        </div>
      </section>

      <section aria-labelledby="who-uses">
        <h2 id="who-uses">Who Uses GMT to EST Converter?</h2>
        <p>Our users come from every walk of life. Here’s a snapshot of the community we serve every day:</p>
        <ul>
          <li><strong>Remote workers and freelancers</strong> coordinating with overseas clients and employers</li>
          <li><strong>International businesses</strong> scheduling cross-border meetings and deadlines</li>
          <li><strong>Students and educators</strong> participating in online classes, webinars, and virtual workshops</li>
          <li><strong>Software developers</strong> pushing releases, scheduling deploys, and joining standups across time zones</li>
          <li><strong>Project managers</strong> keeping global teams aligned and on schedule</li>
          <li><strong>Digital marketers</strong> timing campaigns, launches, and social posts for international audiences</li>
          <li><strong>Customer support teams</strong> managing shift handoffs across continents</li>
          <li><strong>Travelers</strong> planning itineraries and staying connected with people back home</li>
          <li><strong>Gamers</strong> coordinating tournaments, raids, and events with international teammates</li>
          <li><strong>Virtual assistants</strong> managing calendars and communications for clients in different time zones</li>
        </ul>
        <p>If any of that sounds like you — welcome. You’re in the right place.</p>
      </section>

      <section aria-labelledby="content-approach">
        <h2 id="content-approach">Our Approach to Content</h2>
        <p>We believe helpful content should answer real questions — not just rank on search engines.</p>
        <p>Every <a href="/blog/">time zone article and guide</a> on this site is written and reviewed by people who understand the frustrations of time zone conversion firsthand. Our <a href="/editorial-policy/">Editorial Policy</a> explains how we research, review, update, and correct that work. We don’t pad our content with filler or write for algorithms; we write for the person who arrives with a specific question and deserves a clear, honest answer.</p>
        <p>Our content philosophy rests on three pillars:</p>
        <ol>
          <li><strong>Accuracy first.</strong> Every claim we make is verified. We’d rather say less and say it correctly than fill a page with inaccurate information.</li>
          <li><strong>Clarity always.</strong> Time zones are already confusing enough. Our job is to make things simpler, not more complicated.</li>
          <li><strong>Helpfulness above all.</strong> If a page on our site doesn’t genuinely help someone, it doesn’t belong here.</li>
        </ol>
      </section>

      <section aria-labelledby="privacy-experience">
        <h2 id="privacy-experience">Privacy &amp; User Experience</h2>
        <p>We respect your time and your <a href="/privacy-policy/">privacy</a> — both equally.</p>
        <p>Our tools are 100% free and require no account creation, no email address, and no personal information of any kind. You visit, you convert, you leave knowing the right time. That’s the whole experience.</p>
        <p>We are committed to maintaining a fast, secure, and accessible website across all devices — whether you’re on a desktop at your office, a tablet at the coffee shop, or a phone on the go. Our pages are optimized for mobile, load quickly, and are designed to be readable and usable by people of all technical skill levels.</p>
      </section>

      <section aria-labelledby="improvement">
        <h2 id="improvement">Continuous Improvement</h2>
        <p>We’re not done building. Not even close.</p>
        <p>Every week, we’re working on something: a new converter tool, an updated guide, a faster page load, a cleaner interface. We listen to our users, track which questions keep coming up, and build the resources that answer them.</p>
        <p>Some of what’s on our roadmap right now:</p>
        <ul>
          <li>More international time zone converters</li>
          <li>A visual world clock with live updates</li>
          <li>A meeting planner that finds the best overlap time for teams in multiple cities</li>
          <li>Improved accessibility features</li>
          <li>Expanded educational content for schools and training programs</li>
        </ul>
        <p>We build what our users actually need — not what looks impressive on a feature list.</p>
      </section>

      <section aria-labelledby="resources">
        <h2 id="resources">Explore Our Time Zone Resources</h2>
        <p>Start with the tool or guide that best fits what you need:</p>
        <ul class="resource-links">
          <li><a href="/">Convert GMT to Eastern Time</a> with automatic EST and EDT handling.</li>
          <li><a href="/est-to-gmt/">Convert EST or EDT to GMT</a> for reverse scheduling.</li>
          <li><a href="/time-zone-guide/">Read our practical time zone guide</a> for DST, abbreviations, and meeting-planning help.</li>
          <li><a href="/blog/">Browse time zone articles</a> covering global events, schedules, and clock changes.</li>
        </ul>
      </section>

      <section aria-labelledby="get-in-touch">
        <h2 id="get-in-touch">Get in Touch</h2>
        <p>We genuinely want to hear from you.</p>
        <p>If you found an error, have a suggestion, want to request a new tool, or just want to say hello — our <a href="/contact-us/">Contact Us page</a> is always open. Every message is read by a real person, and we do our best to respond promptly.</p>
        <p>Your feedback is one of the primary ways we improve this website. If something isn’t working the way it should, we want to know. If there’s a time zone pair you need that we don’t yet support, tell us. We’ve added features based on user requests before, and we’ll keep doing it.</p>
      </section>

      <section aria-labelledby="thank-you">
        <h2 id="thank-you">Thank You for Being Here</h2>
        <p>We know you have options. There are a lot of time zone tools out there, and we don’t take it for granted that you chose this one.</p>
        <p>Our goal from day one has been to build something genuinely useful — a tool you’d actually bookmark, share with a colleague, and come back to the next time you need it. We hope we’ve earned that trust, and we’ll keep working to deserve it.</p>
        <p>Whether you’re here to <a href="/">convert a quick time</a>, plan a global event, or <a href="/time-zone-guide/">learn how time zones work</a> — welcome. We’re glad you found us.</p>
        <p><strong>The GMT to EST Converter Team</strong></p>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
