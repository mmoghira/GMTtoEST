    font-size: clamp(2.25rem, 6vw, 4rem);
    line-height: 1.05;
  }

  .about-toc {
    margin: 1rem 0 1.5rem;
    padding: 1.25rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  .about-toc strong {
    display: block;
    margin-bottom: 0.75rem;
    color: var(--text);
  }

  .about-toc ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.55rem 1.5rem;
    margin: 0;
    padding-left: 1.25rem;
  }

  .about-toc a,
  .about-copy a {
    color: var(--accent);
    font-weight: 700;
    text-underline-offset: 0.18em;
  }

  .about-copy section {
    padding: 2rem 0;
    border-bottom: 1px solid var(--line);
  }

  .about-copy section:first-child {
    padding-top: 1rem;
  }

  .about-copy section:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

