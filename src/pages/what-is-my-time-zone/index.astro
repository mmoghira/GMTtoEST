---
import BaseLayout from "theme/layouts/BaseLayout.astro";

const lang = "en";
const dir = "ltr";
const slug = "what-is-my-time-zone";
const seoTitle = "What Is My Time Zone? Find Your Time Zone & Offset";
const pageDescription = "Find your current time zone, UTC offset and daylight saving status instantly, with your local time and date.";

const pubDate = "2026-10-25T14:00:00+05:00";
const updatedDate = "2026-10-25T15:00:00+05:00";

const meta = {
  seoTitle,
  exactTitle: true,
  description: pageDescription,
  keywords: "what is my time zone, find my time zone, current time zone, current utc offset, local time and date, daylight saving status, iana time zone, time zone detector",
  pubDate,
  updatedDate,
  author: "Time Intelligence Team",
  faqs: [
    {
      q: "What time zone am I in?",
      a: "The tool at the top of this page shows the time zone set on your device, with its current UTC offset and daylight saving status."
    },
    {
      q: "Why does my UTC offset change during the year?",
      a: "Because of daylight saving time. Many zones shift their offset by one hour in summer and return to standard time in winter, so the offset depends on the date. Note that not every time zone observes DST, and some jurisdictions follow different transition dates."
    },
    {
      q: "Is my time zone the same as my location?",
      a: "Not necessarily. This page reads your device time zone setting, which can differ from where you are physically if the device was set elsewhere."
    }
  ]
};
---

<BaseLayout
  lang={lang}
  dir={dir}
  title={seoTitle}
  description={pageDescription}
  slug={slug}
  meta={meta}
  enableFaqSchema={true}
  allowAds={true}
>
  <!-- Schema: WebApplication Structured Data -->
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "What Is My Time Zone? Detector",
    "url": "https://gmttoestconverter.com/what-is-my-time-zone/",
    "applicationCategory": "UtilitiesApplication",
    "operatingSystem": "All",
    "description": pageDescription,
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    }
  })}></script>

  <!-- Schema: BreadcrumbList Structured Data -->
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://gmttoestconverter.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "What Is My Time Zone?",
        "item": "https://gmttoestconverter.com/what-is-my-time-zone/"
      }
    ]
  })}></script>

  <!-- Hero Banner -->
  <div class="hero-banner">
    <h1 class="hero-banner-title">What Is My Time Zone?</h1>
    <p style="color: #bdd2dc; font-size: clamp(1rem, 2.2vw, 1.25rem); max-width: 680px; margin: 12px auto 0;">
      Instant client-side detection of your device's configured time zone, live UTC offset, and daylight saving time status.
    </p>
  </div>

  <div style="max-width: 820px; margin: 0 auto; padding-top: 24px;">

    <!-- Interactive Time Zone Detection Tool Card (Strictly Above The Fold) -->
    <section id="tz-tool-container" aria-label="Interactive Time Zone Detection Tool">
      <div id="tz-card" style="background: var(--panel); border: 2px solid var(--line); border-radius: 16px; padding: clamp(20px, 4vw, 36px); box-shadow: var(--shadow); position: relative;">
        
        <!-- Accessible Status Live Region (for detection announcements only, not continuous ticking) -->
        <div id="tz-status-announcement" class="sr-only" role="status" aria-live="polite">
          Detecting your time zone...
        </div>

        <!-- Fallback message for JS-disabled browsers -->
        <noscript>
          <div style="background: rgba(239, 68, 68, 0.2); border: 1px solid #ef4444; border-radius: 8px; padding: 14px; margin-bottom: 20px; color: #fca5a5;">
            Automatic time zone detection requires JavaScript. Please enable JavaScript in your browser settings to detect your device's time zone.
          </div>
        </noscript>

        <!-- Detection Error Box (hidden by default) -->
        <div id="tz-error-box" style="display: none; background: rgba(239, 68, 68, 0.15); border: 1px solid #ef4444; border-radius: 10px; padding: 16px; margin-bottom: 20px; text-align: left;">
          <strong style="color: #f87171; display: block; margin-bottom: 4px;">Time Zone Detection Notice:</strong>
          <p id="tz-error-text" style="color: #fecaca; margin: 0; line-height: 1.5; font-size: 0.95rem;">
            We could not detect your time zone automatically. Please check your device time zone settings.
          </p>
          <p style="color: #bdd2dc; margin: 8px 0 0; font-size: 0.85rem;">
            Displaying the current <strong>Coordinated Universal Time (UTC)</strong> below as a reference.
          </p>
        </div>

        <!-- Primary Output Grid in exact required order -->
        <div style="display: flex; flex-direction: column; gap: 20px;">
          
          <!-- 1. Detected Time Zone & 2. Friendly City/Region -->
          <div style="background: var(--bg); border: 1px solid var(--line); border-radius: 12px; padding: 20px; text-align: left;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 10px;">
              <div>
                <span style="display: block; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent); font-weight: 800; margin-bottom: 4px;">1. Detected Time Zone</span>
                <strong id="tz-identifier" style="font-family: 'Space Grotesk', monospace, sans-serif; font-size: clamp(1.4rem, 4vw, 2.1rem); color: #ffffff; letter-spacing: -0.01em; display: block; word-break: break-all;">
                  Detecting...
                </strong>
              </div>
              <span id="tz-source-badge" style="font-size: 0.75rem; background: rgba(54, 199, 181, 0.15); color: var(--accent); border: 1px solid var(--accent); border-radius: 20px; padding: 4px 10px; font-weight: 700;">
                Device Native
              </span>
            </div>

            <div style="margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--line);">
              <span style="display: block; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); font-weight: 700; margin-bottom: 2px;">2. Friendly City / Region Name</span>
              <div id="tz-friendly-name" style="font-size: 1.15rem; font-weight: 600; color: var(--accent-2);">
                Resolving location...
              </div>
            </div>
          </div>

          <!-- Metrics Row: 3. Current UTC Offset & 4. Daylight Saving Status -->
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px;">
            
            <!-- 3. Current UTC Offset -->
            <div style="background: var(--bg); border: 1px solid var(--line); border-radius: 12px; padding: 20px; text-align: left;">
              <span style="display: block; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); font-weight: 700; margin-bottom: 6px;">3. Current UTC Offset</span>
              <strong id="tz-offset" style="font-family: 'Space Grotesk', monospace, sans-serif; font-size: clamp(1.8rem, 4.5vw, 2.3rem); color: var(--warn); display: block; font-variant-numeric: tabular-nums; line-height: 1.1;">
                --:--
              </strong>
              <span id="tz-offset-desc" style="display: block; font-size: 0.85rem; color: var(--muted); margin-top: 6px;">
                Exact difference from Universal Time
              </span>
            </div>

            <!-- 4. Daylight Saving Status -->
            <div style="background: var(--bg); border: 1px solid var(--line); border-radius: 12px; padding: 20px; text-align: left;">
              <span style="display: block; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); font-weight: 700; margin-bottom: 6px;">4. Daylight Saving Status</span>
              <strong id="tz-dst-status" style="font-family: 'Space Grotesk', sans-serif; font-size: clamp(1.8rem, 4.5vw, 2.3rem); color: var(--accent); display: block; line-height: 1.1;">
                Checking...
              </strong>
              <span id="tz-dst-desc" style="display: block; font-size: 0.85rem; color: var(--muted); margin-top: 6px;">
                Seasonal clock evaluation for today
              </span>
            </div>
          </div>

          <!-- 5. Current Local Time and Date -->
          <div style="background: var(--bg); border: 1px solid var(--line); border-radius: 12px; padding: 24px; text-align: center;">
            <span style="display: block; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); font-weight: 700; margin-bottom: 8px;">5. Current Local Time and Date</span>
            <div id="tz-local-time" style="font-family: 'Space Grotesk', monospace, sans-serif; font-size: clamp(2.4rem, 8vw, 4.2rem); font-weight: 800; color: #ffffff; line-height: 1; font-variant-numeric: tabular-nums;">
              --:--:--
            </div>
            <div id="tz-local-date" style="font-size: clamp(1rem, 2.5vw, 1.35rem); font-weight: 600; color: var(--accent-2); margin-top: 10px;">
              Loading calendar date...
            </div>
          </div>

        </div>

        <!-- Controls: Detect Again Button -->
        <div style="margin-top: 24px; display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 14px;">
          <button
            type="button"
            id="detect-again-btn"
            aria-label="Detect your device time zone again"
            style="background: var(--accent); color: #0c354a; font-weight: 800; font-size: 1rem; padding: 12px 28px; border-radius: 8px; border: none; cursor: pointer; transition: transform 0.15s, filter 0.15s; display: inline-flex; align-items: center; gap: 8px;"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0 1 18.8-4.3M22 12.5a10 10 0 0 1-18.8 4.2"/>
            </svg>
            Detect again
          </button>
        </div>
        <p style="font-size: 0.82rem; color: var(--muted); text-align: center; margin: 10px auto 0; max-width: 520px;">
          The "Detect again" button rereads your operating system's configured time zone. It does not access GPS, request device sensors, or track your physical geolocation.
        </p>

      </div>
    </section>

    <!-- Hero Editorial Image (Below the tool to protect tool primacy) -->
    <div class="infographic-wrapper" style="margin-top: 36px;">
      <figure style="margin: 0; text-align: center;">
        <img
          src="/assets/what-is-my-time-zone-hero.webp"
          alt="Map and clock showing how to find your current time zone and UTC offset"
          class="infographic-image"
          width="960"
          height="540"
          loading="lazy"
        />
        <figcaption class="infographic-caption">Client-side time zone detection reads your operating system settings directly in your browser.</figcaption>
      </figure>
    </div>

    <!-- Semantic Content Body -->
    <div style="padding-top: 20px;">

      <!-- H2: How your time zone is detected -->
      <section>
        <h2 style="font-size: clamp(1.5rem, 3.5vw, 2rem); border-bottom: 1px solid var(--line); padding-bottom: 12px; margin-bottom: 16px;">How your time zone is detected</h2>
        <p style="color: var(--muted); line-height: 1.7; max-width: 72ch;">
          When you load this page, your web browser accesses its native Internationalization API (specifically <code>Intl.DateTimeFormat().resolvedOptions().timeZone</code>) to read the time zone identifier currently registered by your operating system.
        </p>
        <p style="color: var(--muted); line-height: 1.7; max-width: 72ch; margin-top: 12px;">
          Key aspects of how this detection works include:
        </p>
        <ul style="color: var(--muted); line-height: 1.7; padding-left: 20px; margin: 14px 0;">
          <li><strong>No GPS or Physical Geolocation Tracking:</strong> This feature does not query GPS hardware, request mobile location permissions, or triangulate cell towers. It simply asks the browser what time zone your device is set to use.</li>
          <li><strong>Zero IP Address Geolocation Dependencies:</strong> The detection does not make external server requests or rely on third-party IP address databases to guess where you are located.</li>
          <li><strong>Device Configuration Governs Results:</strong> If your computer, phone, or tablet is manually configured to an incorrect time zone, this page will display that configured setting rather than your actual physical surroundings.</li>
          <li><strong>Immediate Updates:</strong> If you change your device's date and time settings in your operating system control panel, you can click the <strong>Detect again</strong> button above to instantly refresh the displayed data without reloading the webpage.</li>
          <li><strong>Browser &amp; OS Compatibility:</strong> Modern versions of Chrome, Safari, Firefox, Edge, iOS, and Android support standardized IANA time zone identifiers natively.</li>
        </ul>
      </section>

      <!-- Explanatory Diagram 2: Time Zone vs UTC Offset vs DST -->
      <div class="infographic-wrapper" style="margin-top: 36px;">
        <figure style="margin: 0; text-align: center;">
          <img
            src="/assets/time-zone-offset-explained.webp"
            alt="Diagram showing a time zone, its UTC offset, and a daylight saving shift"
            class="infographic-image"
            width="800"
            height="450"
            loading="lazy"
          />
          <figcaption class="infographic-caption">A time zone name, its offset, and its daylight saving status are three different things.</figcaption>
        </figure>
      </div>

      <!-- H2: Time zone, UTC offset, and daylight saving -->
      <section style="margin-top: 36px;">
        <h2 style="font-size: clamp(1.5rem, 3.5vw, 2rem); border-bottom: 1px solid var(--line); padding-bottom: 12px; margin-bottom: 16px;">Time zone, UTC offset, and daylight saving</h2>
        <p style="color: var(--muted); line-height: 1.7; max-width: 72ch;">
          While people often use the terms "time zone," "UTC offset," and "daylight saving" as if they were identical, they represent distinct layers of civil timekeeping:
        </p>

        <!-- Concept 1: Time Zone -->
        <div style="background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 20px; margin: 18px 0;">
          <h3 style="font-size: 1.15rem; color: var(--accent-2); margin-top: 0; margin-bottom: 8px;">1. Time Zone</h3>
          <p style="color: var(--muted); line-height: 1.65; margin: 0;">
            A <strong>time zone</strong> is a named legal jurisdiction and geographic region that adheres to a standardized set of civil timekeeping rules, codified by the global Internet Assigned Numbers Authority (IANA) database (such as <code>America/New_York</code> or <code>Europe/London</code>). A time zone encompasses all past, present, and scheduled future rules for that region.
          </p>
        </div>

        <!-- Concept 2: UTC Offset -->
        <div style="background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 20px; margin: 18px 0;">
          <h3 style="font-size: 1.15rem; color: var(--warn); margin-top: 0; margin-bottom: 8px;">2. UTC Offset</h3>
          <p style="color: var(--muted); line-height: 1.65; margin: 0;">
            A <strong>UTC offset</strong> is the exact difference in hours and minutes between local civil time and Coordinated Universal Time (UTC) at one specific instant. Because offsets shift when daylight saving begins or ends, an offset (such as <code>UTC−05:00</code> or <code>UTC+01:00</code>) is never a permanent characteristic of a time zone.
          </p>
        </div>

        <!-- Concept 3: Daylight Saving Time -->
        <div style="background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 20px; margin: 18px 0;">
          <h3 style="font-size: 1.15rem; color: var(--accent); margin-top: 0; margin-bottom: 8px;">3. Daylight Saving Time (DST)</h3>
          <p style="color: var(--muted); line-height: 1.65; margin: 0;">
            <strong>Daylight saving time</strong> is a seasonal practice observed in select countries where clocks are advanced—usually by one hour—during warmer months to extend evening daylight, returning to standard time during winter. Many equatorial and Asian nations (such as Japan, India, and Singapore) do not observe DST at all, maintaining an identical UTC offset all year round.
          </p>
        </div>

        <!-- Comparison Table -->
        <h3 style="font-size: 1.25rem; color: #ffffff; margin-top: 28px; margin-bottom: 12px;">Core Comparison: Terminology and Permanence</h3>
        <div style="background: var(--panel); border: 1px solid var(--line); border-radius: 8px; overflow-x: auto; margin: 16px 0;">
          <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.95rem; min-width: 540px;">
            <thead>
              <tr style="border-bottom: 1px solid var(--line); background: var(--bg);">
                <th style="padding: 12px 14px; color: var(--accent-2);">Term</th>
                <th style="padding: 12px 14px; color: var(--accent-2);">What It Means</th>
                <th style="padding: 12px 14px; color: var(--accent-2);">Can It Change?</th>
              </tr>
            </thead>
            <tbody style="color: var(--muted);">
              <tr style="border-bottom: 1px solid var(--line);">
                <td style="padding: 12px 14px; font-weight: 700; color: var(--text);">Time Zone</td>
                <td style="padding: 12px 14px;">The overarching geographic rulebook (e.g., <code>America/New_York</code>, <code>Europe/London</code>).</td>
                <td style="padding: 12px 14px; color: #93c5fd;">Only if government legislation formally changes the region's boundary or laws.</td>
              </tr>
              <tr style="border-bottom: 1px solid var(--line);">
                <td style="padding: 12px 14px; font-weight: 700; color: var(--text);">UTC Offset</td>
                <td style="padding: 12px 14px;">The current mathematical difference from atomic time (e.g., <code>UTC−04:00</code> in summer, <code>UTC−05:00</code> in winter).</td>
                <td style="padding: 12px 14px; color: var(--warn);">Yes, changes automatically when daylight saving starts or ends.</td>
              </tr>
              <tr>
                <td style="padding: 12px 14px; font-weight: 700; color: var(--text);">Daylight Saving Time</td>
                <td style="padding: 12px 14px;">The seasonal policy status indicating whether clocks are temporarily advanced for summer daylight.</td>
                <td style="padding: 12px 14px; color: var(--accent);">Yes, alternates between "In effect" and "Not in effect" annually in observing regions.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- H2: What if I travel or use a VPN? -->
      <section style="margin-top: 36px;">
        <h2 style="font-size: clamp(1.5rem, 3.5vw, 2rem); border-bottom: 1px solid var(--line); padding-bottom: 12px; margin-bottom: 16px;">What if I travel or use a VPN?</h2>
        <p style="color: var(--muted); line-height: 1.7; max-width: 72ch;">
          Because this tool detects the time zone configured on your physical device rather than tracking your IP address, network alterations behave differently than you might expect:
        </p>
        <ul style="color: var(--muted); line-height: 1.7; padding-left: 20px; margin: 14px 0;">
          <li><strong>Virtual Private Networks (VPNs):</strong> Connecting to a VPN server in another country changes your public IP address and network routing, but it <em>does not</em> alter your operating system's internal clock or browser time zone. For example, if you reside in London and connect to a Chicago VPN server, this page will continue reporting <code>Europe/London</code> unless you manually adjust your system clock.</li>
          <li><strong>International Travel:</strong> When traveling across borders, mobile phones connected to cellular networks generally update their time zone automatically. However, laptops and Wi-Fi-only devices without cellular radios often retain their home time zone until manually reconfigured in system settings.</li>
          <li><strong>Testing Different Zones:</strong> If you wish to test how a webpage or application renders in another region, you can adjust your computer's system time zone settings and click <strong>Detect again</strong> to see the changes reflected immediately.</li>
        </ul>
      </section>

      <!-- H2: How to fix an incorrect detected time zone -->
      <section style="margin-top: 36px;">
        <h2 style="font-size: clamp(1.5rem, 3.5vw, 2rem); border-bottom: 1px solid var(--line); padding-bottom: 12px; margin-bottom: 16px;">How to fix an incorrect detected time zone</h2>
        <p style="color: var(--muted); line-height: 1.7; max-width: 72ch;">
          If the detected time zone above does not match where you currently are, adjusting your operating system settings takes less than a minute:
        </p>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; margin: 18px 0;">
          <div style="background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 18px;">
            <h3 style="font-size: 1.05rem; color: #ffffff; margin-top: 0; margin-bottom: 6px;">Windows 11 / 10</h3>
            <p style="color: var(--muted); font-size: 0.9rem; line-height: 1.6; margin: 0;">
              Open <strong>Settings &gt; Time &amp; Language &gt; Date &amp; Time</strong>. Toggle on <em>Set time zone automatically</em>, or select your local administrative zone from the drop-down menu.
            </p>
          </div>
          <div style="background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 18px;">
            <h3 style="font-size: 1.05rem; color: #ffffff; margin-top: 0; margin-bottom: 6px;">Apple macOS</h3>
            <p style="color: var(--muted); font-size: 0.9rem; line-height: 1.6; margin: 0;">
              Go to <strong>System Settings &gt; General &gt; Date &amp; Time</strong>. Ensure <em>Set time zone automatically using your current location</em> is enabled, or pick your nearest city manually.
            </p>
          </div>
          <div style="background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 18px;">
            <h3 style="font-size: 1.05rem; color: #ffffff; margin-top: 0; margin-bottom: 6px;">iOS &amp; Android</h3>
            <p style="color: var(--muted); font-size: 0.9rem; line-height: 1.6; margin: 0;">
              In your phone's <strong>Settings &gt; Date &amp; Time</strong> menu, confirm that <em>Set Automatically</em> is enabled so your mobile carrier can calibrate your local zone upon connection.
            </p>
          </div>
        </div>
      </section>

      <!-- Contextual Internal Links Card -->
      <section style="margin-top: 36px;">
        <div class="info-callout" style="background: var(--panel); border-left: 4px solid var(--accent); padding: 20px; border-radius: 8px;">
          <h3 style="font-size: 1.15rem; color: #ffffff; margin-top: 0; margin-bottom: 8px;">Related Time &amp; Date Tools</h3>
          <p style="color: var(--muted); line-height: 1.6; margin: 0;">
            Want to see your current time and date enlarged on a secondary monitor? Open our <a href="/full-screen-clock/" style="color: var(--accent); font-weight: 700; text-decoration: underline; text-underline-offset: 3px;">Full Screen Clock</a>. Need to calculate intervals or shift deadlines? Use our <a href="/time-duration-calculator/" style="color: var(--accent); font-weight: 700; text-decoration: underline; text-underline-offset: 3px;">Time Duration Calculator</a>, count calendar spans with the <a href="/days-between-dates-calculator/" style="color: var(--accent); font-weight: 700; text-decoration: underline; text-underline-offset: 3px;">Days Between Dates Calculator</a>, or convert between global locations on the <a href="/" style="color: var(--accent); font-weight: 700; text-decoration: underline; text-underline-offset: 3px;">GMT to EST Converter</a> homepage.
          </p>
        </div>
      </section>

    </div>
  </div>

  <!-- Single Visible FAQ Section -->
  <section style="max-width: 820px; margin: 0 auto; padding: 48px 0 24px;">
    <h2 style="font-size: clamp(1.5rem, 3.5vw, 2rem); text-align: center; margin-bottom: 20px;">Frequently Asked Questions</h2>
    <div class="faq">
      {meta.faqs.map(faq => (
        <details style="padding: 16px; background: var(--panel); border: 1px solid var(--line); border-radius: 8px; margin-bottom: 12px;">
          <summary style="font-weight: 800; cursor: pointer; color: var(--text);">{faq.q}</summary>
          <p style="margin: 12px 0 0; color: var(--muted); line-height: 1.65;">{faq.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- Interactive JavaScript Engine (Scoped, Leak-Free, Resilient) -->
  <script is:inline>
    (function () {
      // Deterministic friendly mapping for prominent global IANA time zones
      var FRIENDLY_NAMES = {
        'America/New_York': 'New York, United States (Eastern Time)',
        'America/Detroit': 'Detroit, United States (Eastern Time)',
        'America/Chicago': 'Chicago, United States (Central Time)',
        'America/Denver': 'Denver, United States (Mountain Time)',
        'America/Phoenix': 'Phoenix, United States (Mountain Standard Time)',
        'America/Los_Angeles': 'Los Angeles, United States (Pacific Time)',
        'America/Anchorage': 'Anchorage, United States (Alaska Time)',
        'Pacific/Honolulu': 'Honolulu, United States (Hawaii Time)',
        'America/Toronto': 'Toronto, Canada (Eastern Time)',
        'America/Montreal': 'Montreal, Canada (Eastern Time)',
        'America/Vancouver': 'Vancouver, Canada (Pacific Time)',
        'America/Halifax': 'Halifax, Canada (Atlantic Time)',
        'America/St_Johns': "St. John's, Canada (Newfoundland Time)",
        'America/Mexico_City': 'Mexico City, Mexico',
        'America/Sao_Paulo': 'São Paulo, Brazil',
        'America/Buenos_Aires': 'Buenos Aires, Argentina',
        'America/Bogota': 'Bogotá, Colombia',
        'Europe/London': 'London, United Kingdom (GMT / BST)',
        'Europe/Dublin': 'Dublin, Ireland',
        'Europe/Paris': 'Paris, France (Central European Time)',
        'Europe/Berlin': 'Berlin, Germany (Central European Time)',
        'Europe/Rome': 'Rome, Italy (Central European Time)',
        'Europe/Madrid': 'Madrid, Spain (Central European Time)',
        'Europe/Amsterdam': 'Amsterdam, Netherlands',
        'Europe/Brussels': 'Brussels, Belgium',
        'Europe/Athens': 'Athens, Greece (Eastern European Time)',
        'Europe/Istanbul': 'Istanbul, Turkey',
        'Europe/Moscow': 'Moscow, Russia',
        'Africa/Cairo': 'Cairo, Egypt',
        'Africa/Johannesburg': 'Johannesburg, South Africa',
        'Africa/Lagos': 'Lagos, Nigeria',
        'Africa/Nairobi': 'Nairobi, Kenya',
        'Asia/Dubai': 'Dubai, United Arab Emirates',
        'Asia/Riyadh': 'Riyadh, Saudi Arabia',
        'Asia/Karachi': 'Karachi, Pakistan (Pakistan Standard Time)',
        'Asia/Kolkata': 'Kolkata, India (Indian Standard Time)',
        'Asia/Kathmandu': 'Kathmandu, Nepal (Nepal Time)',
        'Asia/Dhaka': 'Dhaka, Bangladesh',
        'Asia/Bangkok': 'Bangkok, Thailand',
        'Asia/Singapore': 'Singapore, Singapore',
        'Asia/Hong_Kong': 'Hong Kong, China',
        'Asia/Shanghai': 'Shanghai, China (China Standard Time)',
        'Asia/Tokyo': 'Tokyo, Japan (Japan Standard Time)',
        'Asia/Seoul': 'Seoul, South Korea (Korea Standard Time)',
        'Asia/Jakarta': 'Jakarta, Indonesia (Western Indonesia Time)',
        'Australia/Sydney': 'Sydney, Australia (Eastern Time)',
        'Australia/Melbourne': 'Melbourne, Australia (Eastern Time)',
        'Australia/Brisbane': 'Brisbane, Australia (Queensland)',
        'Australia/Adelaide': 'Adelaide, Australia (Central Time)',
        'Australia/Perth': 'Perth, Australia (Western Australia)',
        'Pacific/Auckland': 'Auckland, New Zealand',
        'Pacific/Chatham': 'Chatham Islands, New Zealand',
        'UTC': 'Coordinated Universal Time (UTC)'
      };

      // DOM Element References
      var tzIdEl = document.getElementById('tz-identifier');
      var friendlyNameEl = document.getElementById('tz-friendly-name');
      var offsetEl = document.getElementById('tz-offset');
      var offsetDescEl = document.getElementById('tz-offset-desc');
      var dstStatusEl = document.getElementById('tz-dst-status');
      var dstDescEl = document.getElementById('tz-dst-desc');
      var localTimeEl = document.getElementById('tz-local-time');
      var localDateEl = document.getElementById('tz-local-date');
      var errorBoxEl = document.getElementById('tz-error-box');
      var errorTextEl = document.getElementById('tz-error-text');
      var statusAnnounceEl = document.getElementById('tz-status-announcement');
      var detectAgainBtn = document.getElementById('detect-again-btn');

      var detectedTz = null;
      var clockTimerId = null;

      // Calculate signed offset in minutes between local timezone and UTC for a specific Date
      function getOffsetMinutes(date, tz) {
        var utcDate = new Date(date.toLocaleString('en-US', { timeZone: 'UTC' }));
        var tzDate = new Date(date.toLocaleString('en-US', { timeZone: tz }));
        return Math.round((tzDate.getTime() - utcDate.getTime()) / 60000);
      }

      // Format minutes into signed ISO format: UTC+05:00 or UTC−04:00
      function formatOffset(offsetMinutes) {
        var sign = offsetMinutes >= 0 ? '+' : '−';
        var abs = Math.abs(offsetMinutes);
        var hours = Math.floor(abs / 60);
        var mins = abs % 60;
        var hStr = hours < 10 ? '0' + hours : '' + hours;
        var mStr = mins < 10 ? '0' + mins : '' + mins;
        return 'UTC' + sign + hStr + ':' + mStr;
      }

      // Defensible DST calculation comparing current offset with January and July seasonal rules
      function determineDST(date, tz) {
        try {
          var year = date.getFullYear();
          var currentOffset = getOffsetMinutes(date, tz);
          // Representative mid-month dates for solstice periods
          var janOffset = getOffsetMinutes(new Date(year, 0, 15), tz);
          var julOffset = getOffsetMinutes(new Date(year, 6, 15), tz);

          // If winter and summer offsets are identical, this jurisdiction does not observe DST
          if (janOffset === julOffset) {
            return {
              status: 'Not in effect',
              detail: 'This time zone does not observe daylight saving time.'
            };
          }

          // In observing zones, the maximum offset corresponds to Daylight Saving Time
          var maxOffset = Math.max(janOffset, julOffset);
          if (currentOffset === maxOffset) {
            return {
              status: 'In effect',
              detail: 'Daylight saving time is currently active today.'
            };
          } else {
            return {
              status: 'Not in effect',
              detail: 'Standard time is currently active today.'
            };
          }
        } catch (e) {
          return {
            status: 'DST status unavailable',
            detail: 'Seasonal daylight saving calculation is unavailable for this zone.'
          };
        }
      }

      // Format friendly city/region name
      function getFriendlyName(tz) {
        if (FRIENDLY_NAMES[tz]) {
          return FRIENDLY_NAMES[tz];
        }
        // Neutral, safe fallback without fragile segment assumptions
        return 'Region not available (' + tz + ')';
      }

      // Main detection and render routine
      function detectTimezone(isUserInitiated) {
        var candidateTz = null;

        try {
          if (window.Intl && typeof Intl.DateTimeFormat === 'function') {
            var options = Intl.DateTimeFormat().resolvedOptions();
            if (options && options.timeZone && typeof options.timeZone === 'string' && options.timeZone.trim() !== '') {
              candidateTz = options.timeZone.trim();
            }
          }
        } catch (err) {
          candidateTz = null;
        }

        // Validate that candidateTz is usable by DateTimeFormat
        var isTzValid = false;
        if (candidateTz) {
          try {
            new Intl.DateTimeFormat('en-US', { timeZone: candidateTz }).format(new Date());
            isTzValid = true;
          } catch (e) {
            isTzValid = false;
          }
        }

        if (isTzValid && candidateTz) {
          detectedTz = candidateTz;
          if (errorBoxEl) errorBoxEl.style.display = 'none';

          if (tzIdEl) tzIdEl.textContent = detectedTz;
          if (friendlyNameEl) friendlyNameEl.textContent = getFriendlyName(detectedTz);

          if (statusAnnounceEl) {
            statusAnnounceEl.textContent = 'Detected time zone: ' + detectedTz + '. Information updated.';
          }
        } else {
          // Failure handling: display exact required fallback text
          detectedTz = 'UTC';
          if (errorBoxEl) {
            errorBoxEl.style.display = 'block';
            if (errorTextEl) {
              errorTextEl.textContent = 'We could not detect your time zone automatically. Please check your device time zone settings.';
            }
          }
          if (tzIdEl) tzIdEl.textContent = 'UTC (Fallback)';
          if (friendlyNameEl) friendlyNameEl.textContent = 'Coordinated Universal Time';

          if (statusAnnounceEl) {
            statusAnnounceEl.textContent = 'Could not detect time zone automatically. Showing UTC fallback.';
          }
        }

        updateClock();
        startClock();
      }

      // Clock updater
      function updateClock() {
        var now = new Date();
        var tz = detectedTz || 'UTC';

        // 1. Time string in detected time zone
        try {
          var timeFormatter = new Intl.DateTimeFormat('en-US', {
            timeZone: tz,
            hour: 'numeric',
            minute: '2-digit',
            second: '2-digit',
            hour12: true
          });
          if (localTimeEl) localTimeEl.textContent = timeFormatter.format(now);
        } catch (e) {
          if (localTimeEl) localTimeEl.textContent = '--:--:--';
        }

        // 2. Full calendar date in detected time zone
        try {
          var dateFormatter = new Intl.DateTimeFormat('en-US', {
            timeZone: tz,
            weekday: 'long',
            year: 'numeric',
            month: 'long',
            day: 'numeric'
          });
          if (localDateEl) localDateEl.textContent = dateFormatter.format(now);
        } catch (e) {
          if (localDateEl) localDateEl.textContent = 'Date unavailable';
        }

        // 3. Offset and DST calculation
        try {
          var offsetMinutes = getOffsetMinutes(now, tz);
          var formattedOffset = formatOffset(offsetMinutes);
          if (offsetEl) offsetEl.textContent = formattedOffset;

          var diffAbs = Math.abs(offsetMinutes);
          var hrs = Math.floor(diffAbs / 60);
          var mins = diffAbs % 60;
          var relation = offsetMinutes >= 0 ? 'ahead of UTC' : 'behind UTC';
          if (offsetMinutes === 0) {
            if (offsetDescEl) offsetDescEl.textContent = 'Zero difference from Universal Time (UTC±0)';
          } else {
            var diffText = hrs + ' hour' + (hrs !== 1 ? 's' : '');
            if (mins > 0) diffText += ' ' + mins + ' min';
            if (offsetDescEl) offsetDescEl.textContent = diffText + ' ' + relation;
          }

          var dstResult = determineDST(now, tz);
          if (dstStatusEl) {
            dstStatusEl.textContent = dstResult.status;
            if (dstResult.status === 'In effect') {
              dstStatusEl.style.color = 'var(--accent)';
            } else if (dstResult.status === 'Not in effect') {
              dstStatusEl.style.color = 'var(--text)';
            } else {
              dstStatusEl.style.color = 'var(--warn)';
            }
          }
          if (dstDescEl) dstDescEl.textContent = dstResult.detail;
        } catch (err) {
          if (offsetEl) offsetEl.textContent = 'UTC+00:00';
          if (dstStatusEl) dstStatusEl.textContent = 'Unavailable';
        }
      }

      function startClock() {
        if (clockTimerId) {
          clearInterval(clockTimerId);
        }
        clockTimerId = setInterval(updateClock, 1000);
      }

      // Re-detect button listener
      if (detectAgainBtn) {
        detectAgainBtn.addEventListener('click', function () {
          detectTimezone(true);
        });
      }

      // Page visibility listener: recompute when resuming from a background tab
      document.addEventListener('visibilitychange', function () {
        if (!document.hidden) {
          updateClock();
          startClock();
        }
      });

      // Initial execution
      detectTimezone(false);
    })();
  </script>
</BaseLayout>
