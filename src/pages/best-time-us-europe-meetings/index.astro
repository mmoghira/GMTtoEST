---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import { siteUrl } from "theme/i18n/config";
import RelatedConvertersWidget from "theme/components/RelatedConvertersWidget.astro";
import UsersAlsoVisitWidget from "theme/components/UsersAlsoVisitWidget.astro";
import LearnMoreWidget from "theme/components/LearnMoreWidget.astro";
import CountryCityWidget from "theme/components/CountryCityWidget.astro";

const lang = "en";
const dir = "ltr";
const slug = "best-time-us-europe-meetings";
const seoTitle = "Best Time for US–Europe Meetings: Transatlantic Scheduling Guide (2026)";
const pageDescription = "Discover the optimal time windows for US–Europe business meetings. Learn how to navigate EST, CST, PST vs GMT, BST, CET, CEST offsets and the annual 2-week DST gap.";

const pubDate = "2026-07-30T10:00:00+05:00";
const updatedDate = "2026-07-30T10:00:00+05:00";

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "Best Time for US Europe Meetings, Transatlantic Meeting Scheduler, EST to GMT meeting time, EDT to BST overlap, US Europe business hours",
  pubDate,
  updatedDate,
  author: "Jackie Bruce",
  faqs: [
    {
      q: "What is the best time for a meeting between US Eastern Time (New York) and Western Europe (London/Paris)?",
      a: "The golden overlap window is between 9:00 AM and 11:30 AM Eastern Time (EDT/EST), which corresponds to 2:00 PM to 4:30 PM in London (BST/GMT) and 3:00 PM to 5:30 PM in Paris/Berlin (CEST/CET)."
    },
    {
      q: "What is the best meeting time between US Pacific Time (California) and Europe?",
      a: "For US West Coast teams in San Francisco or Los Angeles (PDT), schedule meetings between 8:00 AM and 9:30 AM PDT. This aligns with 4:00 PM to 5:30 PM in London and 5:00 PM to 6:30 PM in Central Europe."
    },
    {
      q: "What is the 2-week DST gap phenomenon between North America and Europe?",
      a: "North America transitions to Daylight Saving Time on the second Sunday of March, while Europe transitions on the last Sunday of March. In autumn, North America ends DST on the first Sunday of November, while Europe ends DST on the last Sunday of October. During these 2-to-3 week gap periods, the time difference contracts or expands by 1 hour."
    },
    {
      q: "How many hours is New York ahead of London during standard time?",
      a: "London is 5 hours ahead of New York during standard time. When it is 10:00 AM in New York (EST), it is 3:00 PM in London (GMT)."
    },
    {
      q: "How many hours is Chicago behind Berlin?",
      a: "Chicago (Central Time) is 7 hours behind Berlin (Central European Time) under normal conditions."
    },
    {
      q: "What is the time difference between San Francisco and Paris?",
      a: "San Francisco (Pacific Time) is 9 hours behind Paris (Central European Time)."
    },
    {
      q: "How can remote teams avoid meeting fatigue across US–Europe time zones?",
      a: "Adopt asynchronous video updates (Loom), shared written agendas in Notion, and limit real-time transatlantic meetings to 30-minute high-priority syncs during peak overlap hours."
    },
    {
      q: "Which US time zone has the easiest overlap with Europe?",
      a: "US Eastern Time (EST/EDT) offers the largest overlap window, providing 3 to 4 hours of shared core working hours with Western and Central Europe."
    },
    {
      q: "What is the best time for US Central Time (Chicago) and London meetings?",
      a: "Schedule meetings between 8:00 AM and 10:30 AM Central Time (CDT), which matches 2:00 PM to 4:30 PM BST in London."
    },
    {
      q: "What is the best meeting time between US Mountain Time (Denver) and Europe?",
      a: "Schedule calls between 8:00 AM and 9:30 AM Mountain Time (MDT), which corresponds to 3:00 PM to 4:30 PM BST in London."
    },
    {
      q: "How do calendar invites handle transatlantic time zones automatically?",
      a: "Modern calendar platforms like Google Calendar and Microsoft Outlook convert meeting invitations to the recipient's local system timezone automatically, provided the organizer specifies the proper timezone context."
    },
    {
      q: "What is the worst time to schedule a US–Europe meeting?",
      a: "Avoid scheduling meetings after 12:00 PM US Eastern Time (5:00 PM London / 6:00 PM Paris), as European team members will be outside standard working hours."
    },
    {
      q: "How does the London financial market schedule overlap with New York?",
      a: "The London Stock Exchange (LSE) overlaps with the NYSE and NASDAQ between 9:30 AM and 11:30 AM Eastern Time (2:30 PM to 4:30 PM BST)."
    },
    {
      q: "What is the time gap between Eastern Europe (Athens/Helsinki) and US East Coast?",
      a: "Eastern European Time (EET/EEST, UTC+2 / UTC+3) is 7 hours ahead of US Eastern Time (EDT/EST)."
    },
    {
      q: "How do executive leaders manage cross-atlantic leadership teams?",
      a: "Establish dedicated transatlantic office hours twice per week, keeping non-meeting days clear for deep async focus work."
    },
    {
      q: "What tools help visualize US and European working hour overlaps?",
      a: "Tools like World Time Buddy, Calendly, Timeanddate.com, and GMTtoEST converter enable visual grid planning across multiple meridians."
    },
    {
      q: "How does Eastern Standard Time (EST) differ from Greenwich Mean Time (GMT)?",
      a: "EST is UTC-5, while GMT is UTC+0. Standard GMT is exactly 5 hours ahead of standard EST."
    },
    {
      q: "What happens when scheduling meetings across 4 or more time zones?",
      a: "Rotate meeting times bi-weekly so the burden of early morning or late evening calls is shared fairly across regional team members."
    },
    {
      q: "Why is 10:00 AM EDT considered the universal transatlantic meeting hour?",
      a: "10:00 AM EDT hits 3:00 PM BST in London and 4:00 PM CEST in Paris/Berlin, placing every participant firmly within standard business hours."
    },
    {
      q: "How should global company policies define transatlantic working hours?",
      a: "Publish explicit core overlap hours (e.g. 14:00 – 17:00 UTC) during which all transatlantic team members are available for real-time collaboration."
    }
  ]
};

const pageUrlPath = `${siteUrl}/best-time-us-europe-meetings/`;

const pageSchema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${pageUrlPath}#webpage`,
    "url": pageUrlPath,
    "name": seoTitle,
    "description": pageDescription,
    "inLanguage": lang,
    "isPartOf": { "@id": `${siteUrl}/#website` }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${pageUrlPath}#breadcrumb`,
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteUrl}/` },
      { "@type": "ListItem", "position": 2, "name": "US–Europe Meetings Guide", "item": pageUrlPath }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "@id": `${pageUrlPath}#article`,
    "headline": seoTitle,
    "description": pageDescription,
    "datePublished": pubDate,
    "dateModified": updatedDate,
    "author": { "@type": "Person", "name": meta.author },
    "publisher": { "@type": "Organization", "name": "GMT to EST Converter", "url": siteUrl },
    "mainEntityOfPage": pageUrlPath
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${pageUrlPath}#faq`,
    "mainEntity": meta.faqs.map(faq => ({
      "@type": "Question",
      "name": faq.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.a
      }
    }))
  }
];
---

<BaseLayout lang={lang} dir={dir} title={seoTitle} description={pageDescription} slug={slug} meta={meta} enableFaqSchema={true}>
  <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} slot="head" />

  <div class="container content-wrapper">
    <header class="page-header">
      <h1>Best Time for US–Europe Meetings: Transatlantic Scheduling Guide (2026)</h1>
      <div class="reading-meta">
        <span><strong>Author:</strong> {meta.author}</span> | 
        <span><strong>Last Updated:</strong> July 30, 2026</span> | 
        <span><strong>Reading Time:</strong> 16 mins</span>
      </div>
    </header>

    <!-- Top Answer Summary Box -->
    <div class="summary-box">
      <h2>Quick Summary: Optimal Transatlantic Meeting Windows</h2>
      <div class="summary-grid">
        <div class="summary-item">
          <strong>US Eastern (NY/Toronto) vs UK (London):</strong> 9:00 AM – 11:30 AM EDT &harr; 2:00 PM – 4:30 PM BST
        </div>
        <div class="summary-item">
          <strong>US Eastern vs Central Europe (Paris/Berlin):</strong> 9:00 AM – 11:00 AM EDT &harr; 3:00 PM – 5:00 PM CEST
        </div>
        <div class="summary-item">
          <strong>US Central (Chicago) vs Western Europe:</strong> 8:00 AM – 10:30 AM CDT &harr; 2:00 PM – 4:30 PM BST
        </div>
        <div class="summary-item">
          <strong>US Pacific (SF/LA) vs Western Europe:</strong> 8:00 AM – 9:30 AM PDT &harr; 4:00 PM – 5:30 PM BST
        </div>
        <div class="summary-item">
          <strong>Universal Transatlantic Golden Hour:</strong> 10:00 AM EDT (3:00 PM BST / 4:00 PM CEST)
        </div>
        <div class="summary-item">
          <strong>Watch Out For:</strong> The 2-week DST gap in March & October
        </div>
      </div>
    </div>

    <section class="content-section">
      <h2>The Challenge of Transatlantic Meeting Coordination</h2>
      <p>
        In today's globalized business economy, cross-atlantic collaboration between North America and Europe is standard for technology enterprise software, investment banking, pharmaceutical research, and global management consulting. However, coordinating live video calls between team members scattered across US time zones (<a href="/what-is-est/">EST</a>, <a href="/gmt-to-cst/">CST</a>, MST, <a href="/gmt-to-pst/">PST</a>) and European time zones (<a href="/what-is-gmt/">GMT</a>, <a href="/bst-to-est/">BST</a>, <a href="/cet-to-est/">CET</a>, <a href="/cest-to-est/">CEST</a>, <a href="/eet-to-est/">EET</a>) presents significant scheduling friction.
      </p>
      <p>
        The fundamental challenge stems from geography and solar positioning: Western Europe is 5 to 9 hours ahead of the contiguous United States. When US West Coast employees start their day at 9:00 AM PST in <a href="/los-angeles-time/">Los Angeles</a> or <a href="/vancouver-time/">Vancouver</a>, office workers in <a href="/london-time/">London</a> are finishing their workday at 5:00 PM BST, and teams in <a href="/paris-time/">Paris</a> or <a href="/berlin-time/">Berlin</a> are heading home at 6:00 PM CEST.
      </p>
      <p>
        This comprehensive guide breaks down exact overlap windows per region, provides visual scheduling matrices, and explains how to manage the annual 2-week Daylight Saving Time discrepancy.
      </p>

      <div class="info-callout">
        <h3>Golden Rule of Transatlantic Scheduling</h3>
        <p>
          The universal sweet spot for transatlantic video conferences is <strong>10:00 AM US Eastern Time (14:00 UTC)</strong>. This aligns with 3:00 PM in London, 4:00 PM in Paris/Berlin, 9:00 AM in Chicago, and 7:00 AM in San Francisco.
        </p>
      </div>
    </section>

    <!-- Visual SVG Diagram 1 -->
    <section class="content-section">
      <h2>Transatlantic Workday Overlap Matrix (US East Coast vs Western/Central Europe)</h2>
      <p>
        The SVG diagram below visualizes the overlap between US Eastern Time (EDT, UTC-4) and European time zones (BST, UTC+1 / CEST, UTC+2).
      </p>

      <div class="svg-diagram-container">
        <svg viewBox="0 0 800 360" width="100%" height="auto" xmlns="http://www.w3.org/2000/svg" aria-label="US Europe Meeting Overlap Visual Map">
          <rect width="800" height="360" fill="var(--panel)" rx="12" stroke="var(--line)" stroke-width="2"/>
          <text x="400" y="38" fill="var(--accent)" font-family="Space Grotesk, sans-serif" font-size="20" font-weight="bold" text-anchor="middle">Transatlantic Meeting Overlap Grid (US Eastern vs Europe)</text>

          <!-- US Workday Row -->
          <text x="120" y="90" fill="var(--text)" font-family="Space Grotesk, sans-serif" font-size="14" font-weight="bold">New York (EDT, UTC-4)</text>
          <rect x="220" y="75" width="480" height="24" fill="#36c7b5" rx="4"/>
          <text x="460" y="92" fill="#0c354a" font-size="12" font-weight="bold" text-anchor="middle">9:00 AM – 5:00 PM EDT</text>

          <!-- London Workday Row -->
          <text x="120" y="145" fill="var(--text)" font-family="Space Grotesk, sans-serif" font-size="14">London (BST, UTC+1)</text>
          <rect x="100" y="130" width="420" height="24" fill="#8fd7ff" rx="4"/>
          <text x="310" y="147" fill="#0c354a" font-size="12" font-weight="bold" text-anchor="middle">9:00 AM – 5:00 PM BST (2 PM - 5 PM EDT Equivalent)</text>

          <!-- Paris/Berlin Row -->
          <text x="120" y="200" fill="var(--text)" font-family="Space Grotesk, sans-serif" font-size="14">Paris/Berlin (CEST, UTC+2)</text>
          <rect x="60" y="185" width="400" height="24" fill="#8fd7ff" rx="4"/>
          <text x="260" y="202" fill="#0c354a" font-size="12" font-weight="bold" text-anchor="middle">9:00 AM – 5:00 PM CEST (3 PM - 5 PM EDT Equivalent)</text>

          <!-- Highlight Overlap Box -->
          <rect x="220" y="235" width="180" height="95" fill="var(--bg)" rx="8" stroke="var(--accent)" stroke-width="2"/>
          <text x="310" y="265" fill="var(--accent)" font-family="Space Grotesk, sans-serif" font-size="15" font-weight="bold" text-anchor="middle">GOLDEN OVERLAP</text>
          <text x="310" y="290" fill="var(--text)" font-size="13" font-weight="bold" text-anchor="middle">9:00 AM – 11:30 AM EDT</text>
          <text x="310" y="315" fill="var(--muted)" font-size="12" text-anchor="middle">= 2:00 PM – 4:30 PM BST (UK)</text>
        </svg>
      </div>
    </section>

    <section class="content-section">
      <h2>Recommended Meeting Windows by US Region</h2>
      <p>
        Because North America spans four primary contiguous time zones, the available overlap window contracts significantly as you move west from New York to San Francisco.
      </p>

      <div class="table-responsive">
        <table class="comparison-table">
          <thead>
            <tr>
              <th>US Time Zone</th>
              <th>Local US Call Window</th>
              <th>Equivalent London Time (BST)</th>
              <th>Equivalent Central Europe (CEST)</th>
              <th>Overlap Quality</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>US Eastern (EST/EDT)</strong></td>
              <td>9:00 AM – 11:30 AM EDT</td>
              <td>2:00 PM – 4:30 PM BST</td>
              <td>3:00 PM – 5:30 PM CEST</td>
              <td>Excellent (2.5 – 3 hours)</td>
            </tr>
            <tr>
              <td><strong>US Central (CST/CDT)</strong></td>
              <td>8:00 AM – 10:30 AM CDT</td>
              <td>2:00 PM – 4:30 PM BST</td>
              <td>3:00 PM – 5:30 PM CEST</td>
              <td>Good (2.5 hours, early US start)</td>
            </tr>
            <tr>
              <td><strong>US Mountain (MST/MDT)</strong></td>
              <td>8:00 AM – 9:30 AM MDT</td>
              <td>3:00 PM – 4:30 PM BST</td>
              <td>4:00 PM – 5:30 PM CEST</td>
              <td>Moderate (1.5 hours)</td>
            </tr>
            <tr>
              <td><strong>US Pacific (PST/PDT)</strong></td>
              <td>8:00 AM – 9:00 AM PDT</td>
              <td>4:00 PM – 5:00 PM BST</td>
              <td>5:00 PM – 6:00 PM CEST</td>
              <td>Tight (1 hour maximum overlap)</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="content-section">
      <h2>The 2-Week Transatlantic Daylight Saving Time Gap</h2>
      <p>
        One of the most frequent sources of missed meetings and scheduling errors in global business is the <strong>transatlantic DST discrepancy</strong>. The United States and Europe switch to and from Daylight Saving Time on different dates:
      </p>
      <ul>
        <li><strong>Spring Shift:</strong> The US switches to Daylight Saving Time on the <em>second Sunday of March</em>, whereas Europe switches on the <em>last Sunday of March</em>. During this 2-to-3 week window in March, the time difference between the US and Europe narrows by 1 hour (e.g. New York is only 4 hours behind London instead of 5).</li>
        <li><strong>Autumn Shift:</strong> Europe ends Daylight Saving Time on the <em>last Sunday of October</em>, whereas the US ends DST on the <em>first Sunday of November</em>. During this 1-week window in late October / early November, the time gap contracts by 1 hour.</li>
      </ul>

      <div class="tip-box">
        <h3>2026 Transatlantic DST Discrepancy Calendar</h3>
        <p>
          • <strong>March 8 – March 29, 2026:</strong> US is on Daylight Time (EDT), Europe is on Standard Time (GMT/CET). Gap is 4 hours NY-London.<br/>
          • <strong>October 25 – November 1, 2026:</strong> Europe reverts to GMT/CET, US is still on EDT. Gap is 4 hours NY-London.
        </p>
      </div>
    </section>

    <!-- Visual SVG Diagram 2 -->
    <section class="content-section">
      <h2>2-Week DST Transition Shift Visual Timeline</h2>
      <div class="svg-diagram-container">
        <svg viewBox="0 0 800 240" width="100%" height="auto" xmlns="http://www.w3.org/2000/svg" aria-label="DST Transition Shift Visual Timeline">
          <rect width="800" height="240" fill="var(--panel)" rx="12" stroke="var(--line)" stroke-width="2"/>
          <text x="400" y="35" fill="var(--accent)" font-family="Space Grotesk, sans-serif" font-size="18" font-weight="bold" text-anchor="middle">Annual Transatlantic DST Discrepancy Timeline</text>

          <!-- March Shift -->
          <rect x="80" y="70" width="300" height="130" fill="var(--bg)" rx="8" stroke="var(--line)"/>
          <text x="230" y="98" fill="var(--accent-2)" font-weight="bold" font-size="14" text-anchor="middle">Spring Shift (March)</text>
          <text x="230" y="125" fill="var(--text)" font-size="12" text-anchor="middle">US Springs Forward: March 8, 2026</text>
          <text x="230" y="148" fill="var(--text)" font-size="12" text-anchor="middle">Europe Springs Forward: March 29, 2026</text>
          <text x="230" y="175" fill="#ffd166" font-size="12" font-weight="bold" text-anchor="middle">Result: Gap narrows from 5h to 4h for 3 weeks</text>

          <!-- October Shift -->
          <rect x="420" y="70" width="300" height="130" fill="var(--bg)" rx="8" stroke="var(--line)"/>
          <text x="570" y="98" fill="var(--accent-2)" font-weight="bold" font-size="14" text-anchor="middle">Autumn Shift (Oct / Nov)</text>
          <text x="570" y="125" fill="var(--text)" font-size="12" text-anchor="middle">Europe Falls Back: October 25, 2026</text>
          <text x="570" y="148" fill="var(--text)" font-size="12" text-anchor="middle">US Falls Back: November 1, 2026</text>
          <text x="570" y="175" fill="#ffd166" font-size="12" font-weight="bold" text-anchor="middle">Result: Gap narrows from 5h to 4h for 1 week</text>
        </svg>
      </div>
    </section>

    <section class="content-section">
      <h2>Best Practices for Distributed Transatlantic Workflows</h2>
      <p>
        High-performing international organizations follow strict operational guidelines to maximize output while avoiding burnout across transatlantic teams:
      </p>
      <ol class="styled-list">
        <li><strong>Adopt Asynchronous Updates First:</strong> Use video messaging (Loom), structured documentation (Notion / Confluence), and clear ticket updates (Jira) to communicate project status without holding live calls.</li>
        <li><strong>Protect Core Focus Hours:</strong> Reserve afternoons in Europe (mornings in the US) exclusively for collaborative meetings, keeping European mornings open for uninterrupted deep focus work.</li>
        <li><strong>Rotate Meeting Offsets Fairly:</strong> If a team includes US West Coast and Central European members, alternate call times weekly so no single group is permanently forced into early 7:00 AM or late 6:30 PM slots.</li>
        <li><strong>Utilize Explicit Timezone References:</strong> When setting deadlines, always include the timezone string (e.g. "Deadline is 5:00 PM EST / 22:00 UTC") or link to an automated converter page like <a href="/gmt-to-est/">GMT to EST Converter</a>.</li>
      </ol>
    </section>

    <!-- FAQ Section -->
    <section class="content-section faq-section">
      <h2>Frequently Asked Questions About US–Europe Meeting Scheduling</h2>
      <div class="faq-list">
        {meta.faqs.map((faq) => (
          <details class="faq-item">
            <summary class="faq-question">{faq.q}</summary>
            <div class="faq-answer">
              <p>{faq.a}</p>
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- Widgets Section -->
    <RelatedConvertersWidget slug={slug} />
    <UsersAlsoVisitWidget slug={slug} />
    <LearnMoreWidget slug={slug} />
    <CountryCityWidget slug={slug} />
  </div>
</BaseLayout>

<style>
  .content-wrapper {
    padding-top: 2rem;
    padding-bottom: 4rem;
    max-width: 1100px;
    margin: 0 auto;
  }
  .page-header h1 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 2.3rem;
    color: var(--text);
    margin-bottom: 0.5rem;
  }
  .reading-meta {
    font-size: 0.9rem;
    color: var(--muted);
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }
  .summary-box {
    background: var(--panel);
    border: 2px solid var(--accent);
    border-radius: 12px;
    padding: 1.8rem;
    margin-bottom: 2.5rem;
  }
  .summary-box h2 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.4rem;
    color: var(--accent);
    margin-top: 0;
    margin-bottom: 1.2rem;
  }
  .summary-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }
  .summary-item {
    background: var(--bg);
    padding: 0.9rem 1.1rem;
    border-radius: 8px;
    border: 1px solid var(--line);
    font-size: 0.95rem;
  }
  .summary-item strong {
    display: block;
    color: var(--accent-2);
    margin-bottom: 0.25rem;
  }
  .content-section {
    margin-bottom: 3rem;
  }
  .content-section h2 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.7rem;
    color: var(--text);
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.4rem;
  }
  .content-section p {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--muted);
    margin-bottom: 1.2rem;
  }
  .info-callout, .tip-box {
    background: var(--panel);
    border-left: 4px solid var(--accent);
    padding: 1.3rem 1.6rem;
    border-radius: 6px;
    margin: 1.8rem 0;
  }
  .info-callout h3, .tip-box h3 {
    margin-top: 0;
    font-family: 'Space Grotesk', sans-serif;
    color: var(--accent);
    font-size: 1.2rem;
  }
  .svg-diagram-container {
    margin: 2rem 0;
    background: var(--bg);
    padding: 1rem;
    border-radius: 12px;
    border: 1px solid var(--line);
  }
  .table-responsive {
    overflow-x: auto;
    margin: 1.8rem 0;
  }
  .comparison-table {
    width: 100%;
    border-collapse: collapse;
    background: var(--panel);
    border-radius: 8px;
    overflow: hidden;
  }
  .comparison-table th, .comparison-table td {
    padding: 1rem;
    text-align: left;
    border-bottom: 1px solid var(--line);
    font-size: 0.95rem;
  }
  .comparison-table th {
    background: var(--bg);
    color: var(--accent-2);
    font-family: 'Space Grotesk', sans-serif;
  }
  .styled-list {
    margin: 1.5rem 0;
    padding-left: 1.5rem;
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.8;
  }
  .faq-section details {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
    margin-bottom: 1rem;
    padding: 1rem 1.2rem;
  }
  .faq-section summary {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--text);
    cursor: pointer;
  }
  .faq-answer {
