---
import BaseLayout from "theme/layouts/BaseLayout.astro";

const lang = "en";
const dir = "ltr";
const slug = "diwali-2027-date";
const seoTitle = "Diwali 2027 Date | When Is Diwali in 2027?";
const pageDescription = "Diwali 2027 is on Friday, 29 October in India, with regional dates differing. See the 5-day festival dates and what Diwali means.";

const pubDate = "2026-10-25T15:45:00+05:00";
const updatedDate = "2026-10-25T15:55:00+05:00";

const meta = {
  seoTitle,
  exactTitle: true,
  description: pageDescription,
  keywords: "diwali 2027 date, when is diwali 2027, diwali 2027 calendar, 5 days of diwali 2027, deepavali 2027, lakshmi puja 2027 date",
  pubDate,
  updatedDate,
  author: "Time Intelligence Team",
  faqs: [
    {
      q: "When is Diwali in 2027?",
      a: "In India the main Diwali night, Lakshmi Puja, is Friday 29 October 2027. In Singapore the Deepavali public holiday is Thursday 28 October 2027."
    },
    {
      q: "Is Diwali the same as Deepavali?",
      a: "Yes. Deepavali and Deepawali are other names for Diwali, used in different regions and languages."
    },
    {
      q: "How long does Diwali last?",
      a: "The main festival runs over five days, from Govatsa Dwadashi to Bhai Dooj, with regional variations."
    },
    {
      q: "Is Diwali a public holiday in the US?",
      a: "No, it is not a US federal holiday. It is widely celebrated as a cultural and religious festival."
    }
  ]
};

// Exactly 6 rows for the 5-day festival sequence in India
const DIWALI_DAYS_2027 = [
  {
    name: "Govatsa Dwadashi / Vasu Baras",
    date: "Tuesday, 26 October 2027",
    isMain: false
  },
  {
    name: "Dhanteras",
    date: "Wednesday, 27 October 2027",
    isMain: false
  },
  {
    name: "Narak Chaturdashi / Choti Diwali",
    date: "Thursday, 28 October 2027",
    isMain: false
  },
  {
    name: "Lakshmi Puja, the main Diwali night",
    date: "Friday, 29 October 2027",
    isMain: true
  },
  {
    name: "Govardhan Puja",
    date: "Saturday, 30 October 2027",
    isMain: false
  },
  {
    name: "Bhai Dooj",
    date: "Sunday, 31 October 2027",
    isMain: false
  }
];
---

<BaseLayout
  lang={lang}
  dir={dir}
  title={seoTitle}
  description={pageDescription}
  slug={slug}
  meta={meta}
  enableArticleSchema={true}
  enableFaqSchema={true}
  allowAds={true}
>
  <!-- Hero Banner -->
  <div class="hero-banner">
    <h1 class="hero-banner-title">Diwali 2027 Date</h1>
    <p style="color: #bdd2dc; font-size: clamp(1rem, 2.2vw, 1.25rem); max-width: 680px; margin: 12px auto 0;">
      Key dates for the five-day festival of lights in 2027, regional observances, and international public-holiday guides.
    </p>
  </div>

  <div style="max-width: 860px; margin: 0 auto; padding-top: 24px;">

    <!-- ═══════════════════════════════════════════════════════════════════════
         QUICK ANSWER (SERVER-RENDERED IMMEDIATELY BELOW H1)
         ═══════════════════════════════════════════════════════════════════════ -->
    <section class="quick-answer-card" style="background: var(--panel); border: 2px solid var(--accent); border-radius: 14px; padding: 22px 26px; box-shadow: var(--shadow); margin-bottom: 32px;">
      <h2 style="margin: 0 0 10px; font-size: 1.2rem; font-weight: 800; color: var(--accent); font-family: 'Space Grotesk', system-ui, sans-serif;">
        Quick Answer
      </h2>
      <p style="margin: 0; font-size: 1.05rem; line-height: 1.65; color: #ffffff; font-weight: 500;">
        Diwali 2027 is on Friday, 29 October 2027 in India, when Lakshmi Puja, the main Diwali night, is celebrated. In Singapore, Deepavali is a public holiday on Thursday, 28 October 2027. The festival lasts five days, with dates varying slightly by region and tradition.
      </p>
    </section>

    <!-- Hero Image Banner -->
    <div style="margin: 0 0 36px; text-align: center;">
      <img
        src="/assets/diwali-2027-date-hero.webp"
        alt="Diya oil lamps and festive lights marking Diwali 2027"
        width="960"
        height="540"
        loading="eager"
        decoding="async"
        style="width: 100%; height: auto; border-radius: 12px; border: 1px solid var(--line); box-shadow: var(--shadow);"
      />
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════════
         MAIN CONTENT (STRICT ORDER)
         1. H2: When is Diwali in 2027?
         2. H2: Diwali 2027 — the 5-day festival dates (India)
         3. H2: What is Diwali?
         4. H2: Is Diwali a public holiday?
         5. H2: Frequently Asked Questions About Diwali 2027
         ═══════════════════════════════════════════════════════════════════════ -->
    <article class="article-content">

      <!-- Section 1: When is Diwali in 2027? -->
      <h2>When is Diwali in 2027?</h2>
      <p>
        In India, the primary Diwali celebration culminates on the night of <strong>Friday, 29 October 2027</strong>, when families gather for Lakshmi Puja during the darkest lunar night of the Hindu month of Kartik. However, international calendars reflect notable regional variations. In Singapore, the official statutory public holiday for Deepavali is gazetted for <strong>Thursday, 28 October 2027</strong>.
      </p>
      <p>
        Diwali is also widely known across languages and communities as <em>Deepavali</em> and <em>Deepawali</em>, which translate from Sanskrit as "a row of lights." The difference between the 28 October date in Singapore and the 29 October date in India represents <strong>different regional observances</strong> rather than an error or contradiction. Regional Hindu traditions follow distinct lunar calendars and calculation methods: while northern and central Indian communities observe the main festival during Amavasya (new moon) Pradosh Kaal, southern Indian traditions and Southeast Asian diaspora communities frequently observe Deepavali at daybreak on Naraka Chaturdashi, the day preceding the new moon.
      </p>
      <p>
        Because local sunrise times, tithi transitions, and government gazette regulations vary worldwide, holiday schedules naturally adapt to respective local customs and administrative guidelines.
      </p>

      <!-- Section 2: 5-Day Festival Dates (India) -->
      <h2>Diwali 2027 — the 5-day festival dates (India)</h2>
      <p>
        Although commonly referred to as a five-day festival, the traditional observance cycle in India spans six named liturgical occasions beginning on Krishna Paksha Dwadashi and concluding on Shukla Paksha Dwitiya. The sequence of festival days for 2027 is detailed below:
      </p>

      <div class="table-wrapper" style="overflow-x: auto; margin: 24px 0 16px; border: 1px solid var(--line); border-radius: 12px; background: var(--panel);">
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.95rem;">
          <thead>
            <tr style="background: #082030; border-bottom: 2px solid var(--line);">
              <th scope="col" style="padding: 14px 16px; color: var(--accent); font-weight: 800; font-family: 'Space Grotesk', sans-serif;">Festival day</th>
              <th scope="col" style="padding: 14px 16px; color: #38bdf8; font-weight: 800; font-family: 'Space Grotesk', sans-serif; white-space: nowrap;">Date in 2027</th>
            </tr>
          </thead>
          <tbody>
            {DIWALI_DAYS_2027.map((d, idx) => (
              <tr style={`border-bottom: 1px solid rgba(255, 255, 255, 0.06); ${idx % 2 === 1 ? 'background: rgba(255, 255, 255, 0.02);' : ''}`}>
                <td style="padding: 14px 16px; font-weight: 700; color: #ffffff;">
                  {d.name}
                  {d.isMain && (
                    <span style="margin-left: 8px; font-size: 0.75rem; text-transform: uppercase; background: rgba(0, 212, 170, 0.15); color: var(--accent); padding: 2px 8px; border-radius: 4px; font-weight: 800; border: 1px solid rgba(0, 212, 170, 0.3);">
                      Main Night
                    </span>
                  )}
                </td>
                <td style="padding: 14px 16px; white-space: nowrap; font-family: 'Space Grotesk', monospace; color: d.isMain ? '#fde047' : '#bdd2dc'; font-weight: d.isMain ? '800' : '500';">
                  {d.date}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Mandatory Panchang Note Immediately After Table -->
      <p style="margin: 16px 0 32px; font-style: italic; color: #bdd2dc; line-height: 1.6; padding: 12px 16px; background: rgba(0, 212, 170, 0.05); border-left: 3px solid var(--accent); border-radius: 4px;">
        Puja timings vary by city and local Panchang — do not assume one universal muhurat clock time. Check your local Panchang closer to the date.
      </p>

      <!-- Calendar Diagram Visual Image -->
      <figure style="margin: 32px 0 36px; text-align: center;">
        <img
          src="/assets/diwali-2027-five-days.webp"
          alt="Calendar diagram for the five days of Diwali in 2027"
          width="800"
          height="450"
          loading="lazy"
          decoding="async"
          style="width: 100%; height: auto; border-radius: 12px; border: 1px solid var(--line); box-shadow: var(--shadow);"
        />
        <figcaption style="font-size: 0.88rem; color: var(--muted); margin-top: 10px; font-style: italic;">
          Diwali 2027 runs from 26 to 31 October in India, with the main night on 29 October.
        </figcaption>
      </figure>

      <!-- Section 3: What is Diwali? -->
      <h2>What is Diwali?</h2>
      <p>
        Diwali is widely celebrated as the festival of lights, symbolizing the spiritual victory of light over darkness, good over evil, and knowledge over ignorance. It is commemorated with deep reverence and joyous festivity by Hindus, Jains, Sikhs, and some Buddhists around the globe. Across communities, the celebration is marked by universally recognized customs: homes, courtyards, and businesses are decorated with vibrant rangoli patterns, sparkling strings of lights, and earthen clay lamps called diyas. Families gather for sacred prayers, prepare and share traditional sweets (mithai) and savory delicacies, exchange thoughtful gifts, and illuminate night skies with festive fireworks where authorized by local safety regulations.
      </p>
      <p>
        The religious and historical narratives associated with Diwali differ meaningfully across cultures. For many Hindus, it commemorates the joyous return of Lord Rama, Sita, and Lakshmana to Ayodhya after fourteen years of exile, or the divine descent of Goddess Lakshmi granting prosperity and peace. For Jains, Diwali honors the final liberation (Moksha) of Bhagwan Mahavira. For Sikhs, the period coincides with Bandi Chhor Divas, marking the historic release of Guru Hargobind Ji and 52 captive princes from Gwalior Fort. In Newar Buddhism, the festival honors Lakshmi and the wisdom teachings of enlightenment. This rich diversity of religious narratives highlights Diwali’s enduring international resonance as a celebration of family unity, generosity, and moral reflection.
      </p>
      <p>
        On the Gregorian calendar, Bhai Dooj falls on Sunday, 31 October 2027, the same calendar date as <a href="/halloween-2027-date/">Halloween</a>. This is a calendar coincidence, not a connection between the two observances. If you are scheduling autumn celebrations, coordinating global team availability, or arranging cross-border family visits, you can explore the complete yearly overview on our <a href="/holidays-2027/">Holidays in 2027</a> calendar, calculate working days with our <a href="/days-between-dates-calculator/">Days Between Dates Calculator</a>, or verify local call hours with our <a href="/">GMT to EST Converter</a>.
      </p>

      <!-- Section 4: Is Diwali a public holiday? -->
      <h2>Is Diwali a public holiday?</h2>
      <p>
        The public-holiday status of Diwali varies substantially depending on national legislation and municipal governance:
      </p>
      <ul style="padding-left: 24px; margin-bottom: 20px; line-height: 1.7;">
        <li style="margin-bottom: 8px;">
          <strong>India:</strong> Diwali is designated as a central government gazetted holiday, which entails the mandatory closure of federal government offices, public sector undertakings, and major financial institutions. State governments also designate official holidays for Lakshmi Puja and surrounding days.
        </li>
        <li style="margin-bottom: 8px;">
          <strong>Singapore:</strong> Deepavali is recognized by the Ministry of Manpower as an official national public holiday, providing employees nationwide with a paid day off.
        </li>
        <li style="margin-bottom: 8px;">
          <strong>United States, United Kingdom, and Other Countries:</strong> Diwali is observed primarily as a cultural and religious festival rather than a statutory federal or nationwide public holiday. While select public school districts and municipal jurisdictions (such as New York City public schools) may designate school holidays or optional excused absences, businesses and financial institutions generally remain open unless individual private employers establish holiday policies.
        </li>
      </ul>
      <p>
        Because statutory entitlements and operating policies differ by employer, jurisdiction, and region, workers and students should always check their specific organization’s official calendar regarding operational hours and holiday leave.
      </p>

      <!-- Section 5: FAQs -->
      <h2>Frequently Asked Questions About Diwali 2027</h2>
      <div class="faq-container" style="display: flex; flex-direction: column; gap: 14px; margin-top: 20px;">
        {meta.faqs.map((faq) => (
          <details style="background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 16px 20px;">
            <summary style="font-weight: 800; font-size: 1.05rem; cursor: pointer; color: var(--text);">
              {faq.q}
            </summary>
            <p style="margin: 12px 0 0; color: #bdd2dc; font-size: 0.95rem; line-height: 1.6;">
              {faq.a}
            </p>
          </details>
        ))}
      </div>

    </article>

  </div>

  <style>
    .article-content {
      line-height: 1.75;
      color: #bdd2dc;
    }
    .article-content h2 {
      color: #ffffff;
      font-size: clamp(1.35rem, 2.5vw, 1.75rem);
      margin: 36px 0 16px;
      padding-bottom: 8px;
      border-bottom: 1px solid var(--line);
      font-family: "Space Grotesk", system-ui, sans-serif;
    }
    .article-content p {
      margin-bottom: 16px;
    }
    .article-content a {
      color: var(--accent);
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    .article-content a:hover {
      color: #ffffff;
    }
  </style>
</BaseLayout>
