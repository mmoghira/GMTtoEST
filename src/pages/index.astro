---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import Converter from "theme/components/Converter.astro";
import VisualLab from "theme/components/VisualLab.astro";
import { getLang, getTranslation, getPageMeta } from "theme/i18n/config";

const lang = "en";
const dir = "ltr";
const slug = "";
const t = getTranslation(lang);
const meta = getPageMeta(lang, "home");

const pageTitle = "Universal Time Zone Converter";
const seoTitle = "Universal Time Zone Converter – Global Time Conversion Hub";
const pageDescription = "Convert times across global zones instantly. Your central hub for GMT, EST, CDT, CST, PDT, MST, and international time conversions with live clocks.";

const context = {
  from: "GMT",
  to: "EST",
  fromZone: "UTC",
  toZone: "America/New_York"
};

const canonical = "https://gmttoestconverter.com/";

// General Timezone FAQs
const faqs = [
  { 
    q: "What is a timezone offset?", 
    a: "A timezone offset is the difference in hours and minutes from Coordinated Universal Time (UTC) or Greenwich Mean Time (GMT) for a particular location. It can be positive (ahead of UTC) or negative (behind UTC)." 
  },
  { 
    q: "What is the difference between UTC and GMT?", 
    a: "UTC (Coordinated Universal Time) is a scientific time standard based on atomic clocks, while GMT (Greenwich Mean Time) is an astronomical time standard based on Earth's rotation. For civil scheduling purposes, UTC and GMT operate at the same offset (+0)." 
  },
  { 
    q: "How does Daylight Saving Time (DST) affect time zone offsets?", 
    a: "Daylight Saving Time (DST) shifts local clocks forward by one hour during the warmer months to extend evening daylight. When DST is active, a region's offset changes (for example, Eastern Standard Time at UTC-5 shifts to Eastern Daylight Time at UTC-4)." 
  },
  { 
    q: "Why is a date-aware timezone converter important?", 
    a: "Regions transition into and out of Daylight Saving Time on different dates around the world. A date-aware converter uses the precise date of your event to determine which offset is active in both the source and target locations, preventing scheduling errors." 
  },
  { 
    q: "Which timezone is the default standard for databases?", 
    a: "Standard database architecture typically stores all timestamps in UTC (equivalent to GMT) to maintain chronological consistency across systems, translating them to user-specific local timezones on the client side." 
  },
  { 
    q: "How can I schedule meetings across multiple time zones?", 
    a: "To schedule international meetings, locate a window that overlaps with the standard business hours (9:00 AM to 5:00 PM) of all participants. For example, London (GMT) and New York (EST) have a convenient 3-to-4 hour overlap during the morning in New York and afternoon in London." 
  },
  { 
    q: "What is the IANA Time Zone Database?", 
    a: "The Internet Assigned Numbers Authority (IANA) database, also known as the Olson database, is a collaborative compilation of global timezone rules, boundaries, and historical offset changes. Our converter queries this database to ensure maximum accuracy." 
  },
  { 
    q: "Are timezone offsets always in whole hours?", 
    a: "No. Several countries and territories observe timezone offsets that are offset by 30 or 45 minutes. For example, India Standard Time (IST) is UTC+5:30, and Nepal Standard Time is UTC+5:45." 
  }
];

const metaProps = {
  seoTitle,
  description: pageDescription,
  keywords: "timezone converter, universal timezone converter, global clocks, GMT, EST, CDT, PDT, CST, timezone conversion",
  image: "/assets/world-time-map.svg",
  imageAlt: "Universal Time Zone Converter - Global time zones map",
  faqs,
  appDescription: "Free online timezone converter and global clock directory. Plan meetings, coordinate remote teams, and convert hours across all time zones instantly.",
  applicationCategory: "UtilityApplication",
  operatingSystem: "Any",
  howToName: "How to Convert Time Zones",
  howToDescription: "Step-by-step guide to converting time zones using our free online converter tool.",
  howToSteps: [
    { name: "Select conversion direction", text: "Choose your starting time zone and target time zone from our directory of converters." },
    { name: "Enter source date and time", text: "Input the date and time you wish to convert. The tool defaults to the current system time." },
    { name: "Review calculated result", text: "Our tool automatically checks the date for active Daylight Saving Time changes and outputs the correct target time." },
    { name: "Copy or share", text: "Copy the converted time to your clipboard or use our widgets to plan scheduling." }
  ],
};
---

<BaseLayout
  lang={lang}
  dir={dir}
  title={seoTitle}
  description={pageDescription}
  slug={slug}
  meta={metaProps}
  mode="gmt-est"
  enableFaqSchema={true}
  allowAds={true}
  breadcrumbHomeLabel="Home"
  hreflangCodes={["en"]}
>

<!-- H1 & INTRODUCTION -->
<section class="hero-banner">
  <h1 class="hero-banner-title">
    Universal Time Zone <span class="gradient-text">Converter</span>
  </h1>
</section>

<!-- FEATURE STRIP -->
<section class="feature-strip" aria-label="Tool Features">
  <div class="feature-item">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feature-icon" aria-hidden="true">
      <circle cx="12" cy="12" r="10"></circle>
      <polyline points="12 6 12 12 16 14"></polyline>
    </svg>
    <span>Live Clocks</span>
  </div>
  <div class="feature-item">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feature-icon" aria-hidden="true">
      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
      <line x1="16" y1="2" x2="16" y2="6"></line>
      <line x1="8" y1="2" x2="8" y2="6"></line>
      <line x1="3" y1="10" x2="21" y2="10"></line>
    </svg>
    <span>DST-Aware</span>
  </div>
  <div class="feature-item">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feature-icon" aria-hidden="true">
      <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
      <circle cx="9" cy="7" r="4"></circle>
      <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
      <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
    </svg>
    <span>Business Overlap</span>
  </div>
  <div class="feature-item">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feature-icon" aria-hidden="true">
      <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"></polygon>
      <line x1="9" y1="3" x2="9" y2="18"></line>
      <line x1="15" y1="6" x2="15" y2="21"></line>
    </svg>
    <span>Global Directory</span>
  </div>
</section>

<div class="acdt-intro">
  <p>
    Welcome to the <strong>Universal Time Zone Converter</strong>. This central hub is designed to help professionals, developers, travelers, and remote teams manage their global calendars. By integrating the latest IANA Time Zone Database, our portal coordinates real-time clock conversions, maps Daylight Saving Time changes, and assists in scheduling cross-border collaborations.
  </p>
  <p>
    Timekeeping varies significantly across international borders due to regional policies and seasonal transitions. Our interactive calculator lets you compute offsets instantly, ensuring that you maintain synchronization with teams in North America, Europe, Asia, and Oceania. Use this page as your general directory for all major timezone conversions.
  </p>
</div>

<!-- INTERACTIVE CONVERTER -->
<section class="hero reveal" id="converter">
  <div class="hero-copy">
    <div class="eyebrow">Real-Time Calculator</div>
    <h2>Quick Time Zone Converter</h2>
    <p>
      Select a date and time below to convert between standard timezones. The converter defaults to Greenwich Mean Time (GMT) to Eastern Standard Time (EST) as a convenient baseline, and automatically adjusts for Daylight Saving Time (EDT) according to your chosen date.
    </p>
    <p>
      Toggle formats, copy results to your clipboard, and access dedicated guides for specific timezone pairs below.
    </p>
  </div>
  <div>
    <Converter intent="converter" t={t} context={context} />
  </div>
</section>

<!-- LIVE CLOCKS & VISUAL LAB -->
<section class="clock-grid reveal" id="visual-lab">
  <h2>Featured Live Clocks</h2>
  
  <div class="clock-card">
    <span class="eyebrow">Greenwich Mean Time</span>
    <strong id="gmtClock">--:--:-- GMT</strong>
    <p>UTC+0 Standard Baseline</p>
  </div>

  <div class="clock-card">
    <span class="eyebrow">Eastern Time (EST/EDT)</span>
    <strong id="estClock">--:--:-- ET</strong>
    <p>Current Active Offset: <em id="estZone">ET</em></p>
  </div>
</section>

<!-- THE GEOGRAPHY OF TIME STANDARDS -->
<section class="method-section reveal" id="time-geography">
  <div class="method-intro">
    <div class="eyebrow">Global Timekeeping</div>
    <h2>Understanding Meridians, Offsets, and UTC Standards</h2>
    <p>
      Civil timekeeping is governed by geographic corridors called time zones. Historically, these zones were anchored to Greenwich Mean Time (GMT), which calculates solar time based on the Prime Meridian in London. Today, global systems use Coordinated Universal Time (UTC) as the high-precision atomic reference, though GMT remains widely used as a standard timezone name.
    </p>
    <p>
      To prevent chronological conflicts, the world is divided into offsets relative to UTC. Locations to the east of Greenwich add hours (e.g., UTC+1, UTC+8), while locations to the west subtract hours (e.g., UTC-5, UTC-8). Navigating these differences requires understanding daylight transitions and regional laws.
    </p>
  </div>

  <div class="method-grid">
    <div class="method-card">
      <h3>Baseline Reference</h3>
      <code>UTC / GMT +0</code>
      <p>The Greenwich Meridian acts as the zero-point for calculating global time offsets.</p>
    </div>
    <div class="method-card">
      <h3>Negative Offsets</h3>
      <code>West of Greenwich</code>
      <p>North American zones (Eastern, Central, Pacific) subtract hours from the baseline.</p>
    </div>
    <div class="method-card">
      <h3>Positive Offsets</h3>
      <code>East of Greenwich</code>
      <p>European, African, Asian, and Australian zones add hours to the baseline.</p>
    </div>
  </div>
</section>

<!-- DIRECTORY OF POPULAR TIME ZONE CONVERTERS -->
<section class="source-notes reveal" id="directory">
  <h2>Dedicated Time Zone Converters</h2>
  <p>
    Access our deep-dive landing pages for detailed conversion charts, daylight saving transition rules, hourly examples, and specific business scheduling guidance:
  </p>
  <div class="tools-grid" style="margin-top: 24px;">
    <div class="tools-list">
      <h3>GMT &amp; UTC Converters</h3>
      <ul style="list-style: none; padding-left: 0;">
        <li style="margin-bottom: 12px;">
          <a href="/gmt-to-est/" style="color: var(--accent); font-weight: bold; text-decoration: underline;">GMT to EST Converter</a>
          <span style="display: block; font-size: 0.9em; color: var(--muted);">Flagship guide for Greenwich Mean Time to Eastern Standard/Daylight Time conversions.</span>
        </li>
        <li style="margin-bottom: 12px;">
          <a href="/est-to-gmt/" style="color: var(--accent); font-weight: bold; text-decoration: underline;">EST to GMT Converter</a>
          <span style="display: block; font-size: 0.9em; color: var(--muted);">Reverse calculator to convert Eastern Time (New York/Toronto) to Greenwich Mean Time.</span>
        </li>
        <li style="margin-bottom: 12px;">
          <a href="/gmt-vs-est/" style="color: var(--accent); font-weight: bold; text-decoration: underline;">GMT vs EST Difference</a>
          <span style="display: block; font-size: 0.9em; color: var(--muted);">Detailed breakdown of the standard 5-hour gap and 4-hour summer gap.</span>
        </li>
        <li style="margin-bottom: 12px;">
          <a href="/gmt-to-bst/" style="color: var(--accent); font-weight: bold; text-decoration: underline;">GMT to BST Converter</a>
          <span style="display: block; font-size: 0.9em; color: var(--muted);">Convert Greenwich Mean Time to British Summer Time (UTC+1).</span>
        </li>
      </ul>
    </div>
    
    <div class="tools-list">
      <h3>North American Converters</h3>
      <ul style="list-style: none; padding-left: 0;">
        <li style="margin-bottom: 12px;">
          <a href="/cdt-to-est/" style="color: var(--accent); font-weight: bold; text-decoration: underline;">CDT to EST Converter</a>
          <span style="display: block; font-size: 0.9em; color: var(--muted);">Convert Central Daylight Time (Chicago/Houston) to Eastern Standard Time.</span>
        </li>
        <li style="margin-bottom: 12px;">
          <a href="/cst-to-est/" style="color: var(--accent); font-weight: bold; text-decoration: underline;">CST to EST Converter</a>
          <span style="display: block; font-size: 0.9em; color: var(--muted);">Convert Central Standard Time to Eastern Standard Time.</span>
        </li>
        <li style="margin-bottom: 12px;">
          <a href="/pdt-to-est/" style="color: var(--accent); font-weight: bold; text-decoration: underline;">PDT to EST Converter</a>
          <span style="display: block; font-size: 0.9em; color: var(--muted);">Pacific Daylight Time (Los Angeles/Seattle) to Eastern Time conversions.</span>
        </li>
        <li style="margin-bottom: 12px;">
          <a href="/mst-to-est/" style="color: var(--accent); font-weight: bold; text-decoration: underline;">MST to EST Converter</a>
          <span style="display: block; font-size: 0.9em; color: var(--muted);">Mountain Standard Time (Denver/Phoenix) to Eastern Standard Time.</span>
        </li>
      </ul>
    </div>
  </div>
</section>

<!-- FAQ SECTION -->
<section id="faq" class="reveal">
  <h2>Frequently Asked Questions</h2>
  <p>
    Review these general answers to resolve common questions about time zones, atomic standards, and daylight saving transitions:
  </p>
  <div class="faq">
    {faqs.map((faq) => (
      <details>
        <summary>{faq.q}</summary>
        <p style="margin: 12px 0 0; color: var(--muted); line-height: 1.6;">
          {faq.a}
        </p>
      </details>
    ))}
  </div>
</section>

</BaseLayout>
