---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import HomePage from "theme/components/HomePage.astro";
import { getLang, getPageMeta, getTranslation } from "theme/i18n/config";

const lang = getLang("en");
const t = getTranslation(lang.code);
const meta = getPageMeta(lang.code, "home");
---

<BaseLayout lang={lang.code} dir={lang.dir} title={meta.title} description={meta.description} slug="" meta={meta} enableFaqSchema={true}>
  <Fragment slot="head">
    <script is:inline>
      const destination = "/gmt-to-est-converter/";
      if (window.location.pathname !== destination) {
        history.replaceState({}, "", `${destination}${window.location.search}${window.location.hash}`);
      }
    </script>
  </Fragment>

  <HomePage title={meta.title} description={meta.description} kind="converter" t={t} primaryKeyword={meta.title} />
</BaseLayout>
