    let selectedCities = [
      { name: "New York", country: "United States", zone: "America/New_York", flag: "🇺🇸" },
      { name: "London", country: "United Kingdom", zone: "Europe/London", flag: "🇬🇧" },
      { name: "Tokyo", country: "Japan", zone: "Asia/Tokyo", flag: "🇯🇵" }
    ];

    let selectedUtcHour = 14; // Default 14:00 UTC
    const dateInput = document.getElementById("meeting-date");
    const citySearchInput = document.getElementById("city-search-input");
    const suggestionsList = document.getElementById("city-suggestions-list");
    const matrixHeaderRow = document.getElementById("matrix-header-row");
    const matrixBody = document.getElementById("matrix-body");
    const summaryText = document.getElementById("summary-text");
    const btnCopySummary = document.getElementById("btn-copy-summary");
    const btnExportIcs = document.getElementById("btn-export-ics");
    const btnShare = document.getElementById("btn-share");

    const todayStr = new Date().toISOString().split("T")[0];
    dateInput.value = todayStr;

    // Search Autocomplete filtering
    citySearchInput.addEventListener("input", function() {
      const q = this.value.trim().toLowerCase();
      if (!q) {
        suggestionsList.style.display = "none";
        return;
      }
      const matches = WORLD_200_CITIES.filter(c =>
        c.name.toLowerCase().includes(q) ||
        c.country.toLowerCase().includes(q) ||
        c.zone.toLowerCase().includes(q)
      );

      if (matches.length === 0) {
        suggestionsList.innerHTML = '<div class="city-suggestion-item">No cities found</div>';
        suggestionsList.style.display = "block";
        return;
      }

      suggestionsList.innerHTML = matches.map(c => `
        <div class="city-suggestion-item" data-zone="${c.zone}">
          <span><span class="city-flag">${c.flag}</span> <strong>${c.name}</strong> (${c.country})</span>
          <small style="color: #64748b;">${c.zone}</small>
        </div>
      `).join("");
      suggestionsList.style.display = "block";
    });

    suggestionsList.addEventListener("click", function(e) {
      const item = e.target.closest(".city-suggestion-item");
      if (!item) return;
      const zone = item.getAttribute("data-zone");
      const found = WORLD_200_CITIES.find(c => c.zone === zone);
      if (found && !selectedCities.some(sc => sc.zone === zone)) {
        selectedCities.push(found);
        renderMatrix();
      }
      citySearchInput.value = "";
      suggestionsList.style.display = "none";
    });

    // Close dropdown when clicking outside
    document.addEventListener("click", function(e) {
      if (!citySearchInput.contains(e.target) && !suggestionsList.contains(e.target)) {
        suggestionsList.style.display = "none";
      }
    });

    dateInput.addEventListener("change", function() {
      renderMatrix();
    });

    btnCopySummary.addEventListener("click", function() {
      const txt = summaryText.textContent || "";
      navigator.clipboard.writeText(txt).then(function() {
        const orig = btnCopySummary.textContent;
        btnCopySummary.textContent = "✅ Copied to Clipboard!";
        setTimeout(function() { btnCopySummary.textContent = orig; }, 2000);
      });
    });

    btnShare.addEventListener("click", function() {
      const zones = selectedCities.map(c => encodeURIComponent(c.zone)).join(",");
      const url = `${window.location.origin}${window.location.pathname}?cities=${zones}&date=${dateInput.value}&hour=${selectedUtcHour}`;
      navigator.clipboard.writeText(url).then(function() {
        const orig = btnShare.textContent;
        btnShare.textContent = "✅ Share Link Copied!";
        setTimeout(function() { btnShare.textContent = orig; }, 2000);
      });
    });

    btnExportIcs.addEventListener("click", function() {
      const dateVal = dateInput.value || todayStr;
      const startTime = new Date(`${dateVal}T${String(selectedUtcHour).padStart(2, '0')}:00:00Z`);
      const endTime = new Date(startTime.getTime() + 60 * 60000);

      const formatDateStr = function(d) {
        return d.toISOString().replace(/-|:|\.\d\d\d/g, "");
      };

      let summaryDetails = "Global Sync Meeting\\n";
      selectedCities.forEach(function(c) {
        const localTime = new Intl.DateTimeFormat("en-US", {
          timeZone: c.zone,
          hour: "2-digit",
          minute: "2-digit",
          hour12: true
        }).format(startTime);
        summaryDetails += `- ${c.flag} ${c.name} (${c.country}): ${localTime}\\n`;
      });

      const icsContent = [
        "BEGIN:VCALENDAR",
        "VERSION:2.0",
        "PRODID:-//GMTtoEST//Global Meeting Planner//EN",
        "BEGIN:VEVENT",
        "SUMMARY:Global Sync Meeting",
        `DTSTART:${formatDateStr(startTime)}`,
        `DTEND:${formatDateStr(endTime)}`,
        `DESCRIPTION:${summaryDetails}`,
        "STATUS:CONFIRMED",
        "END:VEVENT",
        "END:VCALENDAR"
      ].join("\r\n");

      const blob = new Blob([icsContent], { type: "text/calendar;charset=utf-8;" });
      const link = document.createElement("a");
      link.href = URL.createObjectURL(blob);
      link.setAttribute("download", `global_meeting_${dateVal}_${selectedUtcHour}00UTC.ics`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    });

    function getHourSlotClass(localHour) {
      if (localHour >= 9 && localHour < 17) {
        return "cell-business";
      } else if ((localHour >= 7 && localHour < 9) || (localHour >= 17 && localHour < 21)) {
        return "cell-shoulder";
      } else {
        return "cell-night";
      }
    }

    function renderMatrix() {
      // Header row
      matrixHeaderRow.innerHTML = '<th class="city-col-header">Location</th>';
      for (let h = 0; h < 24; h++) {
        const th = document.createElement("th");
        th.textContent = `${String(h).padStart(2, "0")}:00 UTC`;
        matrixHeaderRow.appendChild(th);
      }

      // Body rows
      matrixBody.innerHTML = "";
      const baseDate = dateInput.value || todayStr;

      selectedCities.forEach(function(city, cityIdx) {
        const tr = document.createElement("tr");

        // Location column
        const tdLoc = document.createElement("td");
        tdLoc.className = "city-col-header";
        tdLoc.style.fontWeight = "bold";
        tdLoc.innerHTML = `
          <span>${city.flag || ''} ${city.name} <small style="color:#64748b;font-weight:normal;">(${city.country || city.zone})</small></span>
          <button class="btn-remove-city" data-idx="${cityIdx}" title="Remove city">×</button>
        `;
        tr.appendChild(tdLoc);

        // 24 hour cells
        for (let utcHour = 0; utcHour < 24; utcHour++) {
          const td = document.createElement("td");
          const utcDateObj = new Date(`${baseDate}T${String(utcHour).padStart(2, "0")}:00:00Z`);

          const localHourStr = new Intl.DateTimeFormat("en-US", {
            timeZone: city.zone,
            hour: "numeric",
            hour12: false
          }).format(utcDateObj);

          const localHour = parseInt(localHourStr, 10);
          const slotClass = getHourSlotClass(localHour);

          td.className = `hour-cell ${slotClass} ${utcHour === selectedUtcHour ? 'cell-selected' : ''}`;
          td.textContent = `${String(localHour).padStart(2, '0')}:00`;
          td.dataset.utcHour = String(utcHour);

          td.addEventListener("click", function() {
            selectedUtcHour = utcHour;
            renderMatrix();
          });

          tr.appendChild(td);
        }

        matrixBody.appendChild(tr);
      });

      // Bind remove buttons
      document.querySelectorAll(".btn-remove-city").forEach(function(btn) {
        btn.addEventListener("click", function(e) {
          const idx = parseInt(e.target.getAttribute("data-idx") || "0", 10);
          selectedCities.splice(idx, 1);
          renderMatrix();
        });
      });

      updateSummary();
    }

    function updateSummary() {
      const baseDate = dateInput.value || todayStr;
      const utcDateObj = new Date(`${baseDate}T${String(selectedUtcHour).padStart(2, "0")}:00:00Z`);

      let summaryLines = [
        `Global Meeting Proposed Schedule (${baseDate})`,
        `Selected UTC Time: ${String(selectedUtcHour).padStart(2, "0")}:00 UTC`,
        "----------------------------------------"
      ];

      selectedCities.forEach(function(c) {
        const localTimeFormatted = new Intl.DateTimeFormat("en-US", {
          timeZone: c.zone,
          weekday: "short",
          month: "short",
          day: "numeric",
          hour: "2-digit",
          minute: "2-digit",
          hour12: true
        }).format(utcDateObj);

        summaryLines.push(`• ${c.flag || ''} ${c.name} (${c.country || c.zone}): ${localTimeFormatted}`);
      });

      summaryText.textContent = summaryLines.join("\n");
    }

    // Parse query params if present
    const params = new URLSearchParams(window.location.search);
    if (params.has("cities")) {
      const cityList = (params.get("cities") || "").split(",");
      const parsed = cityList.map(function(zone) {
        const decoded = decodeURIComponent(zone);
        const match = WORLD_200_CITIES.find(function(c) { return c.zone === decoded; });
        return match || { name: decoded.split("/").pop() || decoded, country: "", zone: decoded, flag: "🌐" };
      });
      if (parsed.length > 0) selectedCities = parsed;
    }
    if (params.has("date")) dateInput.value = params.get("date") || todayStr;
    if (params.has("hour")) selectedUtcHour = parseInt(params.get("hour") || "14", 10);

    renderMatrix();
  </script>
</BaseLayout>
