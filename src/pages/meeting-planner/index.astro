---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import RelatedConvertersWidget from "theme/components/RelatedConvertersWidget.astro";
import LearnMoreWidget from "theme/components/LearnMoreWidget.astro";

const lang = "en";
const dir = "ltr";
const slug = "meeting-planner";
const seoTitle = "Global Meeting Planner — Interactive 200+ City Time Zone Matrix";
const pageDescription = "Coordinate international business meetings easily across 200+ global cities with our interactive 24-hour visual time zone matrix. Find green business hour overlaps, generate .ics calendar invites, and copy share links.";

const pubDate = "2026-07-31T00:00:00+05:00";
const updatedDate = "2026-07-31T00:00:00+05:00";

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "meeting planner, global meeting planner, cross time zone meeting scheduler, time zone matrix, visual meeting planner, 200 cities world clock matrix, ICS export, shareable meeting link, golden hours",
  pubDate,
  updatedDate,
  author: "Time Intelligence Team",
  faqs: [
    {
      q: "What is the Global Meeting Planner tool?",
      a: "The Global Meeting Planner is a visual 24-hour time matrix designed to help distributed teams align meetings across 200+ international cities. It color-codes every hour of the day into convenient business, shoulder, and night categories."
    },
    {
      q: "What do the color-coded slots mean on the visual matrix?",
      a: "<strong>Green (Business Hours):</strong> 9:00 AM to 5:00 PM local time — ideal for calls.<br/><strong>Yellow (Shoulder Hours):</strong> 7:00 AM–9:00 AM & 5:00 PM–9:00 PM — acceptable with advance notice.<br/><strong>Dark Slate (Night Hours):</strong> 9:00 PM to 7:00 AM — sleeping hours, avoid scheduling."
    },
    {
      q: "How do I search and add cities from the 200+ world city database?",
      a: "Type the name of any major city or country into the live search input (e.g., 'Tokyo', 'London', 'Berlin', or 'San Francisco'). Select your target city from the instant autocomplete suggestions to automatically add it to your matrix."
    },
    {
      q: "Can I export my chosen meeting slot directly to Google Calendar or Outlook?",
      a: "Yes! Once you click any hour column on the visual grid, click 'Export .ics File' to download an iCalendar file compatible with Outlook, Apple Calendar, Google Calendar, and mobile devices."
    },
    {
      q: "How does the 'Copy Schedule' button work?",
      a: "Clicking 'Copy Schedule' formats the selected meeting time into a clean text summary displaying local times for every participant city, which you can directly paste into Slack, Microsoft Teams, or email."
    },
    {
      q: "How do I share a pre-filled meeting matrix with colleagues?",
      a: "Click 'Share Link' to copy a unique URL encoding your selected cities and meeting date. Anyone opening the link will see your exact visual matrix loaded."
    },
    {
      q: "Does the Meeting Planner account for Daylight Saving Time (DST)?",
      a: "Yes. The planner uses standard browser timezone engines based on IANA timezone keys, automatically adjusting offsets for DST shifts on the selected calendar date."
    },
    {
      q: "What is the best time for a meeting between US East Coast and London?",
      a: "The ideal window is between 9:00 AM and 12:00 PM EST, which corresponds to 2:00 PM to 5:00 PM GMT/BST in London. Learn more in our <a href=\"/best-time-us-europe-meetings/\">US & Europe Meeting Guide</a>."
    },
    {
      q: "What is the best time for a meeting between US West Coast and Tokyo?",
      a: "The optimal window is 4:00 PM to 6:00 PM PST in North America, which translates to 9:00 AM to 11:00 AM JST the following morning in Tokyo. Read our <a href=\"/best-time-us-asia-meetings/\">US & Asia Meeting Guide</a>."
    },
    {
      q: "Can I remove a city after adding it?",
      a: "Yes. Each city row in the matrix features a red removal button (×) allowing you to adjust your participant list dynamically."
    },
    {
      q: "Why is visual color-coding better than standard converter tables?",
      a: "Traditional conversion tables require mental math to check whether a time falls during a colleague's evening or early morning. Visual matrix grids instantly expose overlapping 'green' windows across all participants at a single glance."
    },
    {
      q: "How do half-hour offset zones (like India or Adelaide) appear on the matrix?",
      a: "Half-hour timezone offsets calculate exact local minute adjustments while displaying accurate local clock hours in the cell grid."
    },
    {
      q: "Can I change the meeting date to test future DST shifts?",
      a: "Yes. Use the date picker at the top of the control panel to select any future date to evaluate how daylight saving shifts alter meeting windows."
    },
    {
      q: "What are 'Golden Hours' in global scheduling?",
      a: "Golden hours represent the narrow overlap when standard 9 AM - 5 PM working hours intersect across every participant's local timezone simultaneously."
    },
    {
      q: "How can remote teams handle zero-overlap time zone gaps?",
      a: "When scheduling between regions with zero business overlap (e.g. San Francisco and Singapore), teams should rotate morning/evening slots or adopt asynchronous communication tools."
    },
    {
      q: "Is there a limit on how many cities I can add?",
      a: "No hard limit exists, though 3 to 8 cities provide the cleanest visual display on desktop and tablet screens."
    },
    {
      q: "Does this tool store my meeting data on a server?",
      a: "No. All calculation and rendering occurs locally inside your client browser. No meeting metadata or team locations are stored on external servers."
    },
    {
      q: "Is the Global Meeting Planner tool free to use?",
      a: "Yes, it is 100% free with unlimited exports, links, and grid renders."
    }
  ]
};
---

<BaseLayout
  lang={lang}
  dir={dir}
  title={seoTitle}
  description={pageDescription}
  slug={slug}
  meta={meta}
  enableFaqSchema={true}
  allowAds={true}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "Global Meeting Planner Tool",
    "operatingSystem": "All",
    "applicationCategory": "UtilitiesApplication",
    "offers": { "@type": "Offer", "price": "0" }
  })} />

  <style>
    .planner-container {
      max-width: 1240px;
      margin: 0 auto;
      padding: 2rem 1rem;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    }
    .hero-banner {
      background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
      color: #ffffff;
      padding: 3rem 2rem;
      border-radius: 1rem;
      text-align: center;
      margin-bottom: 2rem;
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
    }
    .hero-banner h1 {
      font-size: 2.75rem;
      margin-bottom: 1rem;
      font-weight: 800;
    }
    .hero-banner p {
      font-size: 1.25rem;
      color: #94a3b8;
      max-width: 750px;
      margin: 0 auto;
    }

    .card {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 1rem;
      padding: 1.5rem;
      margin-bottom: 2rem;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    .control-row {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1.5rem;
    }
    .control-group {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
    }
    .control-group label {
      font-weight: 700;
      color: #334155;
      font-size: 0.95rem;
    }

    /* Autocomplete Dropdown Styles */
    .search-autocomplete-wrapper {
      position: relative;
      min-width: 320px;
      flex: 1;
    }
    .city-search-input {
      width: 100%;
      padding: 0.75rem 1rem;
      border: 2px solid #cbd5e1;
      border-radius: 0.5rem;
      font-size: 1rem;
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
      background: #ffffff;
      color: #0f172a;
    }
    .city-search-input:focus {
      border-color: #2563eb;
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
    }
    .city-suggestions-list {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: #ffffff;
      border: 1px solid #cbd5e1;
      border-radius: 0.5rem;
      margin-top: 4px;
      max-height: 280px;
      overflow-y: auto;
      z-index: 100;
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.15);
      display: none;
    }
    .city-suggestion-item {
      padding: 0.65rem 1rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid #f1f5f9;
      font-size: 0.95rem;
      color: #1e293b;
    }
    .city-suggestion-item:last-child {
      border-bottom: none;
    }
    .city-suggestion-item:hover, .city-suggestion-item.highlighted {
      background: #eff6ff;
      color: #2563eb;
      font-weight: 600;
    }
    .city-flag {
      margin-right: 8px;
      font-size: 1.1rem;
    }

    .date-input {
      padding: 0.65rem 1rem;
      border: 2px solid #cbd5e1;
      border-radius: 0.5rem;
      font-size: 1rem;
      outline: none;
      background: #ffffff;
      color: #0f172a;
    }

    .btn {
      padding: 0.65rem 1.25rem;
      border-radius: 0.5rem;
      font-weight: 700;
      cursor: pointer;
      border: none;
      transition: all 0.2s;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.95rem;
    }
    .btn-primary {
      background: #2563eb;
      color: #ffffff;
    }
    .btn-primary:hover {
      background: #1d4ed8;
    }
    .btn-secondary {
      background: #f1f5f9;
      color: #334155;
      border: 1px solid #cbd5e1;
    }
    .btn-secondary:hover {
      background: #e2e8f0;
    }
    .btn-accent {
      background: #10b981;
      color: #ffffff;
    }
    .btn-accent:hover {
      background: #059669;
    }

    .legend-bar {
      display: flex;
      gap: 1.5rem;
      margin-bottom: 1.5rem;
      padding: 0.75rem 1rem;
      background: #f8fafc;
      border-radius: 0.5rem;
      font-size: 0.875rem;
      font-weight: 600;
      flex-wrap: wrap;
    }
    .legend-item {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .color-box {
      width: 16px;
      height: 16px;
      border-radius: 4px;
    }
    .box-green { background: #10b981; }
    .box-yellow { background: #f59e0b; }
    .box-red { background: #64748b; }

    .matrix-wrapper {
      overflow-x: auto;
      border: 1px solid #e2e8f0;
      border-radius: 0.75rem;
      margin-bottom: 1.5rem;
    }
    .matrix-table {
      width: 100%;
      border-collapse: collapse;
      min-width: 900px;
    }
    .matrix-table th, .matrix-table td {
      border: 1px solid #e2e8f0;
      padding: 0.6rem 0.35rem;
      text-align: center;
      font-size: 0.85rem;
    }
    .matrix-table th {
      background: #f8fafc;
      font-weight: 700;
      color: #334155;
    }
    .city-col-header {
      min-width: 220px;
      text-align: left !important;
      padding-left: 1rem !important;
      background: #ffffff;
      position: sticky;
      left: 0;
      z-index: 10;
      box-shadow: 2px 0 5px rgba(0,0,0,0.05);
    }
    .hour-cell {
      cursor: pointer;
      font-weight: 600;
      user-select: none;
      transition: opacity 0.15s;
    }
    .hour-cell:hover {
      opacity: 0.8;
      outline: 2px solid #2563eb;
    }
    .cell-business {
      background: #d1fae5;
      color: #065f46;
    }
    .cell-shoulder {
      background: #fef3c7;
      color: #92400e;
    }
    .cell-night {
      background: #f1f5f9;
      color: #64748b;
    }
    .cell-selected {
      outline: 3px solid #2563eb !important;
      font-weight: 800;
    }
    .btn-remove-city {
      background: #fee2e2;
      border: 1px solid #fca5a5;
      color: #ef4444;
      font-weight: bold;
      font-size: 0.9rem;
      border-radius: 4px;
      padding: 2px 8px;
      cursor: pointer;
      margin-left: 0.5rem;
      float: right;
    }
    .btn-remove-city:hover {
      background: #ef4444;
      color: #ffffff;
    }

    .meeting-summary-card {
      background: #eff6ff;
      border: 1px solid #bfdbfe;
      border-radius: 0.75rem;
      padding: 1.25rem;
      margin-top: 1rem;
    }
    .summary-title {
      font-weight: 800;
      font-size: 1.1rem;
      color: #1e3a8a;
      margin-bottom: 0.5rem;
    }
    .summary-details {
      font-family: monospace;
      background: #ffffff;
      padding: 1rem;
      border-radius: 0.5rem;
      border: 1px solid #cbd5e1;
      white-space: pre-wrap;
      font-size: 0.9rem;
      color: #1e293b;
      margin-bottom: 1rem;
    }
    .summary-actions {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .article-section {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 1rem;
      padding: 2.5rem;
      margin-top: 3rem;
      line-height: 1.7;
      color: #334155;
    }
    .article-section h2 {
      font-size: 1.85rem;
      color: #0f172a;
      margin-top: 2rem;
      margin-bottom: 1rem;
      font-weight: 700;
    }
    .article-section h3 {
      font-size: 1.4rem;
      color: #1e293b;
      margin-top: 1.5rem;
      margin-bottom: 0.75rem;
      font-weight: 600;
    }
    .article-section p {
      margin-bottom: 1.25rem;
    }
    .article-section ul {
      margin-bottom: 1.25rem;
      padding-left: 1.5rem;
    }
    .article-section li {
      margin-bottom: 0.5rem;
    }

    /* High-contrast prominent table styles */
    .table-wrap {
      overflow-x: auto;
      border: 1px solid #cbd5e1;
      border-radius: 0.75rem;
      margin: 1.5rem 0;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }
    .table-wrap table {
      width: 100%;
      border-collapse: collapse;
      background: #ffffff;
      color: #0f172a;
    }
    .table-wrap th {
      background: #0f172a;
      color: #ffffff;
      font-weight: 700;
      font-size: 0.95rem;
      padding: 0.85rem 1.25rem;
      text-align: left;
    }
    .table-wrap td {
      padding: 0.85rem 1.25rem;
      border-bottom: 1px solid #e2e8f0;
      color: #0f172a;
      font-size: 0.95rem;
      font-weight: 600;
    }
    .table-wrap tr:nth-child(even) td {
      background: #f8fafc;
    }
    .table-wrap tr:hover td {
      background: #eff6ff;
    }

    .faq-container {
      margin-top: 3rem;
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 1rem;
      padding: 2rem;
    }
    .faq-item {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 0.5rem;
      margin-bottom: 1rem;
      padding: 1.25rem;
    }
    .faq-question {
      font-size: 1.15rem;
      font-weight: 700;
      color: #0f172a;
      margin-bottom: 0.5rem;
    }
    .faq-answer {
      color: #475569;
      margin: 0;
    }
  </style>

  <div class="planner-container">
    <div class="hero-banner">
      <h1>Global <span style="color: #60a5fa;">Meeting Planner</span></h1>
      <p>Visual 24-hour time zone matrix for 200+ world cities. Find green business hour overlaps, generate .ics calendar invites, and share links.</p>
    </div>

    <div class="card">
      <div class="control-row">
        <div class="control-group" style="flex: 1; min-width: 300px;">
          <label for="city-search-input">Add City:</label>
          <div class="search-autocomplete-wrapper">
            <input
              id="city-search-input"
              type="text"
              class="city-search-input"
              placeholder="🔍 Search 200+ cities (e.g. Tokyo, London, Paris, New York)..."
              autocomplete="off"
            />
            <div id="city-suggestions-list" class="city-suggestions-list"></div>
          </div>
        </div>

        <div class="control-group">
          <label for="meeting-date">Meeting Date:</label>
          <input id="meeting-date" type="date" class="date-input" />
        </div>

        <button id="btn-share" class="btn btn-secondary">🔗 Share Link</button>
      </div>

      <div class="legend-bar">
        <div class="legend-item">
          <div class="color-box box-green"></div>
          <span>Business Hours (09:00 - 17:00)</span>
        </div>
        <div class="legend-item">
          <div class="color-box box-yellow"></div>
          <span>Shoulder Hours (07:00-09:00 & 17:00-21:00)</span>
        </div>
        <div class="legend-item">
          <div class="color-box box-red"></div>
          <span>Sleeping / Night Hours (21:00 - 07:00)</span>
        </div>
      </div>

      <div class="matrix-wrapper">
        <table class="matrix-table">
          <thead>
            <tr id="matrix-header-row">
              <th class="city-col-header">Location</th>
            </tr>
          </thead>
          <tbody id="matrix-body"></tbody>
        </table>
      </div>

      <div class="meeting-summary-card">
        <div class="summary-title">📅 Proposed Meeting Schedule</div>
        <pre id="summary-text" class="summary-details">Select an hour column in the matrix above to view meeting times across all participant cities.</pre>
        <div class="summary-actions">
          <button id="btn-copy-summary" class="btn btn-primary">📋 Copy Schedule</button>
          <button id="btn-export-ics" class="btn btn-accent">📅 Export .ics Calendar</button>
        </div>
      </div>
    </div>

    <article class="article-section">
      <h2>Mastering Global Meeting Coordination Across Distributed Time Zones</h2>
      <p>
        In modern international business, cross-border remote teams, offshore software engineering units, and global customer support teams operate across disparate continents. While global talent provides round-the-clock continuity, organizing synchronous video calls or executive reviews across multiple time zones poses significant logistical challenges. Without structured scheduling tools, team leads risk assigning meetings during a colleague's late evening or midnight hours.
      </p>

      <h3>The Science of Visual 24-Hour Overlap Matrices</h3>
      <p>
        Traditional timezone conversion tables rely on static pairs of numbers. For complex multi-city calls involving participants in San Francisco, London, New Delhi, and Tokyo, standard tables require multi-step mental math. A visual 24-hour overlap matrix translates raw Coordinated Universal Time (UTC) offsets into intuitively color-coded human activity windows:
      </p>
      <ul>
        <li><strong>Green Slots (09:00 to 17:00 local):</strong> Core working hours when employees operate at peak cognitive energy.</li>
        <li><strong>Yellow Slots (07:00 to 09:00 & 17:00 to 21:00 local):</strong> Flexible shoulder hours suitable for urgent team syncs with advance agreement.</li>
        <li><strong>Dark Slate Slots (21:00 to 07:00 local):</strong> Rest and sleep periods that should be protected from meeting interruptions.</li>
      </ul>

      <h3>Identifying "Golden Hours" for Transatlantic & Transpacific Teams</h3>
      <p>
        When coordinating transatlantic schedules (such as New York UTC-5 and London UTC+0), teams enjoy a broad 3-to-4 hour "Golden Hour" overlap between 09:00 AM EST and 12:00 PM EST (14:00 to 17:00 GMT). Conversely, transpacific teams (such as San Francisco UTC-8 and Tokyo UTC+9) face a 17-hour gap where daytime hours rarely intersect. In zero-overlap scenarios, the optimal strategy is scheduling late afternoon US calls (16:00 to 18:00 PST) which land on early morning business hours in East Asia (09:00 to 11:00 JST the next day).
      </p>

      <h2>Universal Calendar Export (.ics)</h2>
      <p>
        The Meeting Planner allows you to export your selected meeting time as a standard <strong>RFC 5545 iCalendar (.ics)</strong> file. This internationally supported calendar format works across nearly every major calendar application without requiring manual time conversion.
      </p>

      <p>When a meeting is exported, the planner automatically includes:</p>
      <ul>
        <li>Meeting title</li>
        <li>Start and end time</li>
        <li>Meeting description</li>
        <li>Time zone information</li>
        <li>Calendar event formatting compatible with international standards</li>
      </ul>

      <p>
        Because timezone information is embedded within the calendar file, participants opening the invitation in their own calendar application automatically see the meeting in their local time. This eliminates confusion caused by manual timezone calculations and helps distributed teams avoid scheduling mistakes.
      </p>

      <h3>Calendar Platform Compatibility</h3>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Calendar Platform</th>
              <th>Supported</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Google Calendar</td>
              <td>✅ Yes</td>
            </tr>
            <tr>
              <td>Microsoft Outlook</td>
              <td>✅ Yes</td>
            </tr>
            <tr>
              <td>Apple Calendar</td>
              <td>✅ Yes</td>
            </tr>
            <tr>
              <td>Mozilla Thunderbird</td>
              <td>✅ Yes</td>
            </tr>
            <tr>
              <td>Samsung Calendar</td>
              <td>✅ Yes</td>
            </tr>
            <tr>
              <td>Most RFC-5545 Compatible Apps</td>
              <td>✅ Yes</td>
            </tr>
          </tbody>
        </table>
      </div>

      <h2>Benefits of Calendar Export</h2>
      <ul>
        <li><strong>Eliminates manual timezone conversion:</strong> No mental math or clock math required by attendees.</li>
        <li><strong>Reduces scheduling errors:</strong> Prevents missed meetings caused by daylight saving confusion or misread offsets.</li>
        <li><strong>Works across different operating systems:</strong> Seamless on iOS, Android, macOS, Windows, and Linux.</li>
        <li><strong>One-click calendar import:</strong> Direct addition into Google Calendar, Outlook, and Apple Calendar.</li>
        <li><strong>Supports remote teams worldwide:</strong> Standardizes invitations for distributed international workforces.</li>
        <li><strong>Preserves timezone accuracy during Daylight Saving Time changes:</strong> Embeds precise IANA timezone rules for seasonal shifts.</li>
      </ul>

      <div class="info-callout">
        <p>
          <strong>Tip:</strong> Always verify your selected meeting date before exporting. Daylight Saving Time transitions may change time differences between countries during certain weeks of the year. The Meeting Planner automatically calculates these adjustments using official IANA timezone data.
        </p>
      </div>

      <p>
        Combine this Meeting Planner with our companion utilities including the <a href="/world-clock/">Global World Clock</a>, <a href="/business-hours-overlap/">Business Hours Overlap Calculator</a>, and <a href="/time-difference-calculator/">Time Difference Calculator</a> for comprehensive time management across all operations.
      </p>
    </article>

    <div class="faq-container">
      <h2 style="font-size: 1.75rem; font-weight: 800; color: #0f172a; margin-bottom: 1.5rem;">Frequently Asked Questions</h2>
      {meta.faqs.map((faq) => (
        <div class="faq-item">
          <div class="faq-question">{faq.q}</div>
          <div class="faq-answer" set:html={faq.a}></div>
        </div>
      ))}
    </div>

    <RelatedConvertersWidget slug={slug} />
    <LearnMoreWidget slug={slug} />
  </div>

  <script is:inline>
    const WORLD_200_CITIES = [
      // North America
      { name: "New York", country: "United States", zone: "America/New_York", flag: "🇺🇸" },
      { name: "Los Angeles", country: "United States", zone: "America/Los_Angeles", flag: "🇺🇸" },
      { name: "Chicago", country: "United States", zone: "America/Chicago", flag: "🇺🇸" },
      { name: "Houston", country: "United States", zone: "America/Chicago", flag: "🇺🇸" },
