---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import Converter from "theme/components/Converter.astro";
import { getTranslation, siteUrl } from "theme/i18n/config";

const lang = "en";
const dir = "ltr";
const slug = "eet-to-gmt";
const t = getTranslation(lang);

const pageTitle = "EET to GMT Converter";
const seoTitle = "EET to GMT Converter – Eastern European Time";
const pageDescription = "Convert EET to GMT with our live converter. See the 2-hour time difference, 24-hour conversion chart, examples, and daylight saving information.";

const context = {
  from: "EET",
  to: "GMT",
  fromZone: "Etc/GMT-2",
  toZone: "UTC"
};

const canonical = `${siteUrl}/eet-to-gmt/`;

// 24-hour conversion table data (EET -> GMT = EET - 2)
function formatHour12(hour: number) {
  const normalized = ((hour % 24) + 24) % 24;
  const period = normalized < 12 ? "AM" : "PM";
  const displayHour = normalized % 12 || 12;
  return `${displayHour}:00 ${period}`;
}

const conversionRows = Array.from({ length: 24 }, (_, hour) => {
  const gmtHour = hour - 2;
  const gmtNormalized = ((gmtHour % 24) + 24) % 24;
  const prevDay = gmtHour < 0;
  const period = gmtNormalized < 12 ? "AM" : "PM";
  const displayHour = gmtNormalized % 12 || 12;
  return {
    eet: formatHour12(hour),
    gmt: `${displayHour}:00 ${period}${prevDay ? " (previous day)" : ""}`,
    dayNote: prevDay ? "Previous day (-1 day)" : "Same calendar day"
  };
});

// Key Conversion Milestones
const keyMilestones = [
  { eet: "12:00 AM (Midnight)", gmt: "10:00 PM (Previous Day)", note: "Midnight in EET matches late evening of the prior day in Greenwich." },
  { eet: "2:00 AM EET", gmt: "12:00 AM (Midnight) GMT", note: "The Greenwich calendar day begins when EET clocks reach 2:00 AM." },
  { eet: "6:00 AM EET", gmt: "4:00 AM GMT", note: "Early dawn in EET locations while Greenwich is in pre-dawn rest." },
  { eet: "9:00 AM EET", gmt: "7:00 AM GMT", note: "Commercial workday commences in EET as morning routines start in London." },
  { eet: "12:00 PM (Noon) EET", gmt: "10:00 AM GMT", note: "Midday break in EET aligns with mid-morning productivity in GMT." },
  { eet: "3:00 PM EET", gmt: "1:00 PM GMT", note: "Active business afternoon overlap window across European organizations." },
  { eet: "6:00 PM EET", gmt: "4:00 PM GMT", note: "Standard EET workday concludes while GMT business hours remain open." },
  { eet: "9:00 PM EET", gmt: "7:00 PM GMT", note: "Evening relaxation across EET regions during GMT post-work hours." }
];

// FAQ data
const faqs = [
  {
    q: "What is the difference between EET and GMT?",
    a: "EET operates at UTC+2 while GMT operates at UTC+0, so Greenwich Mean Time is 2 hours behind Eastern European Time."
  },
  {
    q: "How do I convert EET to GMT?",
    a: "Subtract 2 hours from the EET time. For example, 12:00 PM EET minus 2 hours equals 10:00 AM GMT."
  },
  {
    q: "What is 12 PM EET in GMT?",
    a: "12:00 PM (Noon) EET corresponds to 10:00 AM GMT on the same calendar day."
  },
  {
    q: "Is EET the same as EEST?",
    a: "No. EET is Eastern European Time (UTC+2), whereas EEST is Eastern European Summer Time (UTC+3)."
  },
  {
    q: "Does EET observe daylight saving time?",
    a: "In locations that observe daylight saving time, EET serves as the standard-time designation, transitioning to EEST during summer."
  },
  {
    q: "What happens when EET times cross midnight into GMT?",
    a: "Because GMT is 2 hours behind EET, times between 12:00 AM and 1:59 AM EET fall into the late evening of the preceding day in GMT (10:00 PM to 11:59 PM)."
  },
  {
    q: "What is the exact UTC offset for EET?",
    a: "EET has a coordinated universal offset of UTC+2 (2 hours ahead of Coordinated Universal Time)."
  }
];

const meta = {
  exactTitle: true,
  seoTitle,
  description: pageDescription,
  keywords: "EET to GMT, EET to GMT converter, Eastern European Time to GMT, convert EET to GMT, EET time difference, EET UTC offset",
  image: "/assets/eet-to-gmt-og.svg",
  imageAlt: "EET to GMT Time Converter – Eastern European Time to Greenwich Mean Time",
  faqs,
  appDescription: "Convert EET to GMT instantly with our live time converter, 2-hour difference calculation, 24-hour conversion chart, and standard time guide.",
  applicationCategory: "UtilityApplication",
  operatingSystem: "Any",
  howToName: "How to Convert EET to GMT",
  howToDescription: "Step-by-step method to convert Eastern European Time to Greenwich Mean Time.",
  howToSteps: [
    { name: "Input EET Time", text: "Select your starting EET date and time using our interactive converter." },
    { name: "Apply the 2-Hour Subtraction", text: "Subtract exactly 2 hours from the EET value to calculate the GMT timestamp." },
    { name: "Verify Date Boundary", text: "If the EET time is between 12:00 AM and 1:59 AM, roll back the calendar date to the previous day." },
    { name: "Copy or Share Result", text: "Use the copy button to save the converted GMT time for your calendar or meeting invite." }
  ]
};
---

<BaseLayout
  lang={lang}
  dir={dir}
  title={seoTitle}
  description={pageDescription}
  slug={slug}
  meta={meta}
  mode="gmt-est"
  enableFaqSchema={true}
  allowAds={true}
  breadcrumbHomeLabel="Home"
  breadcrumbLabel="EET to GMT"
>

<!-- ═══════════════════════════════════════════════════════════════════════════
     H1 & HERO BANNER
     ═══════════════════════════════════════════════════════════════════════ -->
<section class="hero-banner">
  <h1 class="hero-banner-title">
    EET to GMT <span class="gradient-text">Converter</span>
  </h1>
</section>

<!-- PRIMARY CONVERTER & LIVE CLOCKS (Above the Fold) -->
<div style="max-width: 900px; margin: 0 auto; padding: 0 16px 24px;">
  <Converter intent="dynamic" t={t} context={context} />
  
  <!-- LIVE CLOCKS -->
  <section class="clock-grid" aria-label="Live Clocks" style="margin-top: 24px;">
    <h2>Live Clocks</h2>
    <div class="clock-card">
      <span class="eyebrow">Source Time Zone</span>
      <strong id="gmtClock">--:--:--</strong>
      <p style="margin-top: 4px; font-size: 0.85rem; color: var(--muted);">Eastern European Time (EET, UTC+2)</p>
    </div>
    <div class="clock-card">
      <span class="eyebrow">Target Time Zone</span>
      <strong id="estClock">--:--:--</strong>
      <p style="margin-top: 4px; font-size: 0.85rem; color: var(--muted);">Greenwich Mean Time (GMT, UTC+0)</p>
    </div>
  </section>

  <!-- DIRECT ANSWER BLOCK -->
  <div class="info-callout" style="margin-top: 24px;">
    <h2 style="margin: 0 0 10px; font-size: 1.35rem; font-family: 'Space Grotesk', sans-serif; color: var(--text);">
      Quick Answer: EET to GMT Time Difference
    </h2>
    <p style="font-size: 1.35rem; font-weight: 800; color: var(--accent); margin: 0 0 10px;">
      GMT is 2 hours behind EET (GMT = EET − 2 hours)
    </p>
    <p style="margin: 0 0 8px; font-size: 1.1rem; line-height: 1.6;">
      <strong>EET is 2 hours ahead of GMT. To convert EET to GMT, subtract 2 hours.</strong>
    </p>
    <p style="margin: 0 0 12px; color: var(--muted); font-size: 1rem; line-height: 1.6;">
      When a time is expressed as EET (UTC+2), Greenwich Mean Time (UTC+0) is exactly two hours earlier. For times between 12:00 AM and 1:59 AM EET, subtracting two hours crosses midnight into the previous calendar day.
    </p>
    <ul style="margin: 8px 0 0 20px; padding: 0; color: var(--muted); font-size: 0.95rem; line-height: 1.6;">
      <li><strong>9:00 AM EET</strong> = 7:00 AM GMT</li>
      <li><strong>12:00 PM EET (Noon)</strong> = 10:00 AM GMT</li>
      <li><strong>3:00 PM EET</strong> = 1:00 PM GMT</li>
      <li><strong>6:00 PM EET</strong> = 4:00 PM GMT</li>
      <li><strong>9:00 PM EET</strong> = 7:00 PM GMT</li>
      <li><strong>12:00 AM EET (Midnight)</strong> = 10:00 PM GMT (previous day)</li>
    </ul>
  </div>
</div>

<!-- FEATURE STRIP -->
<section class="feature-strip" aria-label="Tool Features">
  <div class="feature-item">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feature-icon" aria-hidden="true">
      <circle cx="12" cy="12" r="10"></circle>
      <polyline points="12 6 12 12 16 14"></polyline>
    </svg>
    <span>2-Hour Difference</span>
  </div>
  <div class="feature-item">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feature-icon" aria-hidden="true">
      <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
    </svg>
    <span>UTC+2 → UTC+0</span>
  </div>
  <div class="feature-item">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feature-icon" aria-hidden="true">
      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
      <line x1="16" y1="2" x2="16" y2="6"></line>
      <line x1="8" y1="2" x2="8" y2="6"></line>
      <line x1="3" y1="10" x2="21" y2="10"></line>
    </svg>
    <span>Standard-Time Offset</span>
  </div>
</section>

<!-- INTRODUCTION -->
<section class="acdt-intro content-section" aria-labelledby="intro-heading">
  <h2 id="intro-heading">Understanding the EET to GMT Time Conversion</h2>
  <p>
    Welcome to our dedicated <strong>EET to GMT Converter</strong>. This utility calculates exact timestamps between Eastern European Time (UTC+2) and Greenwich Mean Time (UTC+0). When a time is expressed as EET, GMT is exactly two hours behind.
  </p>
  <p>
    Greenwich Mean Time (GMT) operates without seasonal shifts at UTC+0 all year round, serving as the international astronomical baseline. Eastern European Time (EET) is a label representing UTC+2, two hours ahead of Coordinated Universal Time.
  </p>
  <p>
    Because GMT is two hours behind EET, planning cross-border communication requires noting the 2-hour offset along with date transitions during late-night and midnight hours.
  </p>
</section>

<!-- HOW TO CONVERT -->
<section class="method-section content-section" id="how-to-convert" aria-labelledby="methods-heading">
  <h2 id="methods-heading">How to Convert EET to GMT</h2>
  <p class="method-intro">
    Converting any timestamp from EET to GMT involves subtracting 2 hours from the EET time:
  </p>

  <div class="method-grid">
    <article class="method-card">
      <h3>1. The Subtraction Formula</h3>
      <p>Subtract 2 hours from your starting EET timestamp. For example, 15:00 EET minus 2 hours gives 13:00 GMT.</p>
    </article>
    <article class="method-card">
      <h3>2. Midnight Rollover Rule</h3>
      <p>If the EET time is between 12:00 AM and 1:59 AM, subtracting 2 hours yields a timestamp on the previous calendar day in GMT.</p>
    </article>
    <article class="method-card">
      <h3>3. 12-Hour Notation Adjustments</h3>
      <p>Keep track of morning and evening transitions: 12:00 PM (Noon) EET converts to 10:00 AM GMT, while 12:00 AM (Midnight) EET converts to 10:00 PM GMT on the previous day.</p>
    </article>
    <article class="method-card">
      <h3>4. Fixed UTC Offset Baseline</h3>
      <p>EET represents UTC+2 and GMT represents UTC+0. This mathematical relationship between the two offset designations remains consistently 2 hours.</p>
    </article>
  </div>
</section>

<!-- 24-HOUR CONVERSION TABLE -->
<section class="table-wrap content-section" id="conversion-table" aria-labelledby="table-heading">
  <h2 id="table-heading">24-Hour EET to GMT Conversion Table</h2>
  <p>Comprehensive reference showing all 24 hours of Eastern European Time mapped to the corresponding Greenwich Mean Time alongside calendar day status.</p>
  
  <table>
    <thead>
      <tr>
        <th>EET Time (UTC+2)</th>
        <th>GMT Time (UTC+0)</th>
        <th>Calendar Day Relation</th>
      </tr>
    </thead>
    <tbody>
      {conversionRows.map((row) => (
        <tr>
          <td><strong>{row.eet}</strong></td>
          <td><span class="highlight">{row.gmt}</span></td>
          <td>{row.dayNote}</td>
        </tr>
      ))}
    </tbody>
  </table>
</section>

<!-- POPULAR MILESTONES -->
<section class="examples-section content-section" id="key-milestones" aria-labelledby="milestones-heading">
  <h2 id="milestones-heading">Key EET to GMT Time Milestones</h2>
  <p class="method-intro">Reference points showing how common daily milestones align between EET and GMT.</p>
  <div class="method-grid">
    {keyMilestones.map((item) => (
      <article class="method-card">
        <h3>{item.eet} = {item.gmt}</h3>
        <p>{item.note}</p>
      </article>
    ))}
  </div>
</section>

<!-- EET vs EEST DISTINCTION -->
<section class="content-section" id="eet-vs-eest" aria-labelledby="distinction-heading">
  <h2 id="distinction-heading">EET vs EEST: Critical Timezone Difference</h2>
  <p>
    It is important to differentiate between <strong>EET</strong> and <strong>EEST</strong>. They represent two different UTC offsets:
  </p>
  <ul style="margin: 1rem 0 1.5rem 1.5rem; line-height: 1.8; color: var(--text);">
    <li><strong>EET (Eastern European Time)</strong> operates at <strong>UTC+2</strong>, which is 2 hours ahead of GMT.</li>
    <li><strong>EEST (Eastern European Summer Time)</strong> operates at <strong>UTC+3</strong>, which is 3 hours ahead of GMT.</li>
  </ul>
  <p>
    In locations that observe daylight saving time, EET is generally the standard-time designation while EEST is used during the summer period. Exact transition dates depend on the location's applicable governance.
  </p>
  <p>
    If you need to calculate conversions for summer daylight saving time, explore our dedicated <a href="/eest-to-gmt/">EEST to GMT Converter</a>.
  </p>
</section>

<!-- DAYLIGHT SAVING EXPLANATION -->
<section class="content-section" id="dst-explanation" aria-labelledby="dst-heading">
  <h2 id="dst-heading">Daylight Saving Time and the EET Designation</h2>
  <p>
    In locations that observe daylight saving time, EET is generally the standard-time designation while EEST is used during the summer period. Exact transition dates depend on the location's current rules.
  </p>
  <p>
    Greenwich Mean Time (GMT), by international standard definition, remains permanently fixed at UTC+0 and does not observe daylight saving shifts. While the United Kingdom shifts locally to British Summer Time (BST, UTC+1) during the summer period, standard GMT remains UTC+0 throughout the entire year.
  </p>
</section>

<!-- PRACTICAL USE CASES -->
<section class="content-section" id="use-cases" aria-labelledby="usecases-heading">
  <h2 id="usecases-heading">Common Practical Applications for EET to GMT Conversion</h2>
  <div class="method-grid">
    <article class="method-card">
      <h3>International Business Scheduling</h3>
      <p>Coordinating meetings and teleconferences between EET-observing offices and Greenwich-based counterparties.</p>
    </article>
    <article class="method-card">
      <h3>Financial Desk Coordination</h3>
      <p>Aligning banking transaction cutoffs, trading desks, and international currency settlements between European time zones.</p>
    </article>
    <article class="method-card">
      <h3>Telecommunications & IT Logs</h3>
      <p>Synchronizing telecommunication logs, server cron jobs, and database replication timestamps anchored to UTC/GMT.</p>
    </article>
    <article class="method-card">
      <h3>Logistics & Cross-Border Freight</h3>
      <p>Coordinating road, rail, and air transit manifests where regional schedules interface with universal GMT timetables.</p>
    </article>
  </div>
</section>

<!-- RELATED CONVERTERS -->
<section class="other-tools" id="related-converters" aria-labelledby="related-heading">
  <h2 id="related-heading">Related Timezone Converters</h2>
  <div class="related-grid">
    <article class="related-card">
      <div class="related-card-title"><a href="/eest-to-gmt/">EEST to GMT Converter</a></div>
      <div class="related-card-text">Convert Eastern European Summer Time (UTC+3) to Greenwich Mean Time (UTC+0).</div>
    </article>
    <article class="related-card">
      <div class="related-card-title"><a href="/gmt-to-eet/">GMT to EET Converter</a></div>
      <div class="related-card-text">Convert Greenwich Mean Time (UTC+0) to Eastern European Time (UTC+2).</div>
    </article>
    <article class="related-card">
      <div class="related-card-title"><a href="/gmt-to-est/">GMT to EST Converter</a></div>
      <div class="related-card-text">Convert Greenwich Mean Time to US Eastern Standard Time.</div>
    </article>
    <article class="related-card">
      <div class="related-card-title"><a href="/est-to-gmt/">EST to GMT Converter</a></div>
      <div class="related-card-text">Convert US Eastern Standard Time back to Greenwich Mean Time.</div>
    </article>
    <article class="related-card">
      <div class="related-card-title"><a href="/gmt-vs-est/">GMT vs EST Difference</a></div>
      <div class="related-card-text">Compare time differences and schedules between GMT and Eastern Time.</div>
    </article>
  </div>
</section>

<!-- FAQ SECTION -->
<section class="faq" id="faq" aria-labelledby="faq-heading">
  <h2 id="faq-heading">Frequently Asked Questions: EET to GMT</h2>
  {faqs.map((item) => (
    <details>
      <summary>{item.q}</summary>
      <p>{item.a}</p>
    </details>
  ))}
</section>

<!-- CONCLUSION -->
<section class="source-notes" id="conclusion" style="margin-top: 40px; border-top: 1px solid var(--line); padding-top: 20px;">
  <h2>Summary of EET to GMT Conversion</h2>
  <p>
    Converting Eastern European Time (EET) to Greenwich Mean Time (GMT) requires subtracting 2 hours (GMT = EET − 2 hours). EET represents UTC+2, while GMT represents the universal zero-offset baseline UTC+0.
  </p>
  <p>
    Use our interactive converter above or consult the 24-hour reference table to calculate accurate timestamps and avoid scheduling misunderstandings across international time zones.
  </p>
</section>

</BaseLayout>

<style>
  .feature-strip {
    display: flex;
    justify-content: center;
    gap: 2rem;
    margin: 1.5rem 0 2rem;
    flex-wrap: wrap;
  }
  .feature-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.95rem;
    color: var(--muted);
    background: rgba(255, 255, 255, 0.04);
    padding: 0.5rem 1rem;
    border-radius: 20px;
    border: 1px solid var(--line);
  }
  .feature-icon {
    color: var(--accent);
  }
  .acdt-intro {
    max-width: 860px;
    margin: 0 auto 2rem;
    padding: 0 1.5rem;
  }
  .acdt-intro p {
    font-size: 1.08rem;
    line-height: 1.75;
    color: var(--muted);
    margin-bottom: 1.25rem;
  }
  .acdt-intro p:first-of-type {
    font-size: 1.15rem;
    color: var(--text);
  }
  .table-wrap table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 1rem;
  }
  .table-wrap th, .table-wrap td {
    padding: 0.75rem 1rem;
    text-align: left;
    border-bottom: 1px solid var(--line);
  }
  .table-wrap th {
    background: rgba(255, 255, 255, 0.03);
    color: var(--accent);
    font-family: 'Space Grotesk', sans-serif;
  }
  .highlight {
    color: var(--accent);
    font-weight: bold;
  }
  .info-callout {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 1.5rem;
  }
  .info-callout h2 {
    color: var(--text);
  }
</style>