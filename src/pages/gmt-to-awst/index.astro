---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import Converter from "theme/components/Converter.astro";
import { getLang, getTranslation, getPageMeta } from "theme/i18n/config";

const lang = "en";
const dir = "ltr";
const slug = "gmt-to-awst";
const t = getTranslation(lang);
const meta = getPageMeta(lang, "gmtToAwst");

const seoTitle = "GMT to AWST Converter – Convert GMT to Perth Time";
const pageDescription = "Convert GMT to AWST instantly. Access the 24-hour conversion chart, check Western Australia time rules, and plan meetings with our Perth time calculator.";

const context = {
  from: "GMT",
  to: "AWST",
  fromZone: "UTC",
  toZone: "Australia/Perth"
};

const canonical = "https://gmttoestconverter.com/gmt-to-awst/";

// Helper to format 12-hour values
function formatHour12(hour: number, minute: number = 0) {
  const normalized = ((hour % 24) + 24) % 24;
  const period = normalized < 12 ? "AM" : "PM";
  const displayHour = normalized % 12 || 12;
  return `${displayHour}:${String(minute).padStart(2, "0")} ${period}`;
}

// Generate the 24-hour comparative table rows (AWST = GMT + 8, stable year-round)
const conversionRows = Array.from({ length: 24 }, (_, hour) => {
  const awstHour = (hour + 8) % 24;
  const awstDayDiff = (hour + 8) >= 24 ? "Next day" : "Same day";
  return {
    gmt: formatHour12(hour),
    awst: `${formatHour12(awstHour)} AWST (${awstDayDiff})`,
    offset: "UTC+8",
    dayDiff: awstDayDiff,
    notes: `Stable year-round offset. ${awstDayDiff === "Next day" ? "Alaskan/Australian date shifts forward." : "Dates match."}`
  };
});

// JSON-LD Schema definitions
const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "GMT to AWST Converter",
    "applicationCategory": "UtilitiesApplication",
    "operatingSystem": "Any",
    "url": canonical,
    "description": "Free online GMT to AWST converter with real-time clocks, stable UTC+8 calculations, and Western Australia time zone guidelines."
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is GMT to AWST?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "GMT to AWST is the process of converting Greenwich Mean Time (UTC+0) to Australian Western Standard Time (UTC+8). Since Western Australia does not observe Daylight Saving Time, this offset remains exactly 8 hours ahead of GMT year-round."
        }
      },
      {
        "@type": "Question",
        "name": "How many hours ahead is AWST?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Australian Western Standard Time (AWST) is exactly 8 hours ahead of Greenwich Mean Time (GMT). When converting from GMT, you simply add 8 hours to the source time to find the local time in Perth."
        }
      },
      {
        "@type": "Question",
        "name": "Is Perth on AWST?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, Perth, the capital city of Western Australia, operates within the AWST timezone. It stays on UTC+8 throughout the entire year without changes."
        }
      },
      {
        "@type": "Question",
        "name": "Does AWST use Daylight Saving Time?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No. Australian Western Standard Time (AWST) does not observe Daylight Saving Time (DST). Clocks in Western Australia remain on the UTC+8 standard year-round, which simplifies conversion."
        }
      },
      {
        "@type": "Question",
        "name": "Why doesn't Western Australia change clocks?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Western Australia has rejected Daylight Saving Time in multiple public referendums. The state's agricultural, mining, and regional sectors generally prefer consistent morning daylight hours, keeping the clocks stable."
        }
      },
      {
        "@type": "Question",
        "name": "Is AWST always UTC+8?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. AWST is permanently fixed at UTC+8. However, when converting relative to London, the time difference shifts to 7 hours in summer because the United Kingdom observes British Summer Time (BST, UTC+1)."
        }
      },
      {
        "@type": "Question",
        "name": "GMT vs AWST?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "GMT (UTC+0) is the solar-based baseline timezone running through Greenwich, UK. AWST (UTC+8) is the standard timezone for Western Australia. AWST is exactly 8 hours ahead of GMT."
        }
      },
      {
        "@type": "Question",
        "name": "AWST vs AEST?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "AWST is Australian Western Standard Time (UTC+8), used in Western Australia. AEST is Australian Eastern Standard Time (UTC+10), used in Sydney, Melbourne, and Brisbane. AWST is 2 hours behind AEST."
        }
      },
      {
        "@type": "Question",
        "name": "Can I convert future dates?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Our date-aware converter allows you to select future dates. While AWST is constant, the tool automatically adjusts for UK transitions (GMT to BST) to maintain accurate real-world coordination."
        }
      },
      {
        "@type": "Question",
        "name": "Can I schedule meetings using this converter?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, you can use our interactive interface to find overlapping business hours and plan international calls between Europe and Western Australia."
        }
      },
      {
        "@type": "Question",
        "name": "Is this converter accurate?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, our converter is synchronized with the IANA Time Zone Database, ensuring offsets are calculated according to official global standards."
        }
      },
      {
        "@type": "Question",
        "name": "Which Australian cities use AWST?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Cities in Western Australia observing AWST include Perth, Fremantle, Kalgoorlie, Broome, Bunbury, Geraldton, and Albany."
        }
      },
      {
        "@type": "Question",
        "name": "Can I use this converter for flights?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. It helps travelers coordinate flight durations and local arrivals when booking transit between Europe, Asia, and Perth Airport (PER)."
        }
      },
      {
        "@type": "Question",
        "name": "Can I use it for business?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, it is highly useful for corporate teams coordinating with Australia's mining, logistics, and resource sectors."
        }
      },
      {
        "@type": "Question",
        "name": "Can I use it for travel?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, it is helpful for planning travel itineraries and road trips through Western Australia."
        }
      },
      {
        "@type": "Question",
        "name": "Is this converter free?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, our GMT to AWST converter is completely free to use, requiring no downloads, registration, or subscriptions."
        }
      },
      {
        "@type": "Question",
        "name": "Can I bookmark this page?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. You can bookmark this page (/gmt-to-awst/) for quick access to live clocks, comparative charts, meeting planners, and timezone rules."
        }
      },
      {
        "@type": "Question",
        "name": "How often is timezone data updated?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Our systems check for database updates periodically, applying changes as soon as they are published by the Internet Assigned Numbers Authority (IANA)."
        }
      },
      {
        "@type": "Question",
        "name": "What is Australia/Perth in the IANA database?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Australia/Perth is the standard zone identifier in the IANA Time Zone Database representing the state of Western Australia and its UTC+8 offset."
        }
      },
      {
        "@type": "Question",
        "name": "Why is AWST different from Eastern Australia?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Australia is a massive continent spanning three main timezones. Western Australia uses AWST (UTC+8), Central Australia uses ACST (UTC+9:30), and Eastern Australia uses AEST (UTC+10). Eastern states also observe Daylight Saving Time, widening the gap in summer."
        }
      },
      {
        "@type": "Question",
        "name": "What is AWST vs ACST?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "AWST is UTC+8, while ACST (Australian Central Standard Time) is UTC+9:30. AWST is exactly 1.5 hours behind ACST."
        }
      },
      {
        "@type": "Question",
        "name": "What is AWST vs AEDT?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "AEDT is Australian Eastern Daylight Time (UTC+11), active in summer in Sydney and Melbourne. AWST (UTC+8) is exactly 3 hours behind AEDT."
        }
      },
      {
        "@type": "Question",
        "name": "Does London time match GMT all year?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No. London operates on GMT (UTC+0) during the winter, but transitions to British Summer Time (BST, UTC+1) from late March to late October."
        }
      },
      {
        "@type": "Question",
        "name": "What is the best meeting time between London and Perth?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The optimal meeting window is 8:00 AM to 9:00 AM London time (4:00 PM to 5:00 PM Perth time), allowing standard business coordination before the end of the Australian workday."
        }
      },
      {
        "@type": "Question",
        "name": "Does the mining industry in WA use AWST?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, Western Australia's mining and resource sector operates entirely on AWST. This offset simplifies synchronization with major Asian trading hubs like Singapore, Hong Kong, and Beijing, which share the UTC+8 offset."
        }
      },
      {
        "@type": "Question",
        "name": "How do cruise schedules in Western Australia work?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Cruise operations in WA dock according to local AWST time. Travelers must coordinate excursions based on local clocks to avoid missing departures."
        }
      },
      {
        "@type": "Question",
        "name": "Is AWST observed in other countries?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "While AWST is legally specific to Australia, its offset (UTC+8) is shared with Singapore (SGT), China (CST), Taiwan (NST), and Malaysia (MYT)."
        }
      },
      {
        "@type": "Question",
        "name": "Can I use this calculator offline?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The calculator requires an active internet connection to load initial scripts and sync with server-side time APIs, but handles calculations in the browser once loaded."
        }
      },
      {
        "@type": "Question",
        "name": "Does this page support mobile conversions?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, our responsive layout is designed for mobile devices, tablets, and desktop displays, adjusting tables and calculators for optimal viewing."
        }
      },
      {
        "@type": "Question",
        "name": "Who reviews the timezone data on this site?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Timezone content and calculator code are reviewed by Jackie Bruce, our resident timezone specialist, ensuring technical accuracy and alignment with IANA guidelines."
        }
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://gmttoestconverter.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "GMT to AWST Converter",
        "item": canonical
      }
    ]
  }
];
---

<BaseLayout
  lang={lang}
  dir={dir}
  title={seoTitle}
  description={pageDescription}
  slug={slug}
  meta={meta}
  mode="gmt-est"
  enableFaqSchema={true}
  allowAds={true}
  breadcrumbHomeLabel="Home"
  breadcrumbLabel="GMT to AWST"
  hreflangCodes={["en"]}
>

<!-- Inject additional JSON-LD Schemas -->
<script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

<!-- ═══════════════════════════════════════════════════════════════════════════
     H1: GMT TO AWST CONVERTER
     ═══════════════════════════════════════════════════════════════════════ -->
<section class="hero-banner">
  <h1 class="hero-banner-title">
    GMT to AWST Converter
  </h1>
</section>

<!-- LIVE CONVERTER COMPONENT -->
<section class="converter-wrapper reveal" id="calculator-section">
  <div class="converter-box">
    <Converter
      lang={lang}
      dir={dir}
      slug={slug}
      t={t}
      context={context}
    />
  </div>
</section>

<!-- FEATURE STRIP -->
<section class="feature-strip" aria-label="Key Specifications">
  <div class="feature-item">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feature-icon" aria-hidden="true">
      <circle cx="12" cy="12" r="10"></circle>
      <polyline points="12 6 12 12 16 14"></polyline>
    </svg>
    <span>Real-Time Clock Sync</span>
  </div>
  <div class="feature-item">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feature-icon" aria-hidden="true">
      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
      <line x1="16" y1="2" x2="16" y2="6"></line>
      <line x1="8" y1="2" x2="8" y2="6"></line>
      <line x1="3" y1="10" x2="21" y2="10"></line>
    </svg>
    <span>No DST Complexity</span>
  </div>
  <div class="feature-item">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feature-icon" aria-hidden="true">
      <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"></polygon>
      <line x1="9" y1="3" x2="9" y2="18"></line>
      <line x1="15" y1="6" x2="15" y2="21"></line>
    </svg>
    <span>IANA Database Standards</span>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════════════════════
     1. CONVERT GMT TO AWST INSTANTLY
     ═══════════════════════════════════════════════════════════════════════ -->
<section class="method-section reveal" id="convert-instantly">
  <div class="method-intro">
    <div class="eyebrow">Instant Calculation</div>
    <h2>Convert GMT to AWST Instantly</h2>
    <p>
      Our synchronization engine converts Greenwich Mean Time (GMT) to Australian Western Standard Time (AWST) dynamically. Unlike tools that use hardcoded calculations, this converter uses date-aware parameters, handling seasonal shifts in London (GMT/BST) automatically. Input your target date and time to calculate the offset instantly.
    </p>
    <p>
      This calculator supports scheduling, travel, and logistics operations. By referencing official databases, it ensures conversions are accurate.
    </p>
  </div>
  
  <!-- SVG 1: HERO IMAGE (Modern World Clock) -->
  <div class="hero-visual" style="max-width: 800px; margin: 24px auto 0;">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 240" width="100%" height="auto" style="background: linear-gradient(135deg, #071b26 0%, #0f3446 100%); border-radius: 8px;">
      <text x="400" y="40" font-family="'Space Grotesk', sans-serif" font-size="20" font-weight="bold" fill="#36c7b5" text-anchor="middle">GMT TO AWST SYNCHRONIZED WORLD CLOCK</text>
      
      <!-- GMT Clock Dial -->
      <g transform="translate(220, 130)">
        <circle cx="0" cy="0" r="50" fill="#0c354a" stroke="#2f6278" stroke-width="3" />
        <line x1="0" y1="0" x2="0" y2="-35" stroke="#f4fbff" stroke-width="3" stroke-linecap="round" />
        <line x1="0" y1="0" x2="25" y2="0" stroke="#36c7b5" stroke-width="2" stroke-linecap="round" />
        <text x="0" y="70" font-family="'Space Grotesk', sans-serif" font-size="14" font-weight="bold" fill="#f4fbff" text-anchor="middle">GMT (UTC+0)</text>
      </g>
      
      <!-- Sync Arrow -->
      <path d="M 370 130 L 430 130" stroke="#36c7b5" stroke-width="3" fill="none" marker-end="url(#arrow)" />
      <text x="400" y="115" font-family="'Manrope', sans-serif" font-size="12" fill="#8fd7ff" text-anchor="middle">+8 Hours</text>
      
      <!-- AWST Clock Dial -->
      <g transform="translate(580, 130)">
        <circle cx="0" cy="0" r="50" fill="#0c354a" stroke="#2f6278" stroke-width="3" />
        <line x1="0" y1="0" x2="25" y2="-25" stroke="#f4fbff" stroke-width="3" stroke-linecap="round" />
        <line x1="0" y1="0" x2="-15" y2="25" stroke="#8fd7ff" stroke-width="2" stroke-linecap="round" />
        <text x="0" y="70" font-family="'Space Grotesk', sans-serif" font-size="14" font-weight="bold" fill="#36c7b5" text-anchor="middle">AWST (UTC+8)</text>
      </g>
      
      <defs>
        <marker id="arrow" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 0 L 10 5 L 0 10 z" fill="#36c7b5" />
        </marker>
      </defs>
    </svg>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════════════════════
     2. CURRENT GMT AND AWST TIME
     ═══════════════════════════════════════════════════════════════════════ -->
<section class="clock-grid reveal" id="current-clocks">
  <h2 style="grid-column: 1 / -1; margin-bottom: 8px;">Current GMT and AWST Time</h2>
  
  <div class="clock-card">
    <span class="eyebrow">Greenwich Mean Time Clock</span>
    <strong id="gmtClock">--:--:-- GMT</strong>
    <p>UTC+0 Base Meridian</p>
  </div>

  <div class="clock-card">
    <span class="eyebrow">Western Australia Time Clock (Perth)</span>
    <strong id="estClock">--:--:-- ET</strong>
    <p>Active Offset: <em id="estZone">ET</em></p>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════════════════════
     3. UNDERSTANDING AUSTRALIAN WESTERN STANDARD TIME
     ═══════════════════════════════════════════════════════════════════════ -->
<section class="method-section reveal" id="understanding-awst">
  <div class="method-intro">
    <div class="eyebrow">TimeZone Definition</div>
    <h2>Understanding Australian Western Standard Time</h2>
    <p>
      Australian Western Standard Time (AWST) is the official timezone used in Western Australia, representing a UTC+8 offset. This timezone covers one-third of the Australian continent, including Perth, Fremantle, Kalgoorlie, and Albany.
    </p>
    <p>
      AWST is synchronized with major Asian trade capitals like Singapore (SGT), Hong Kong (HKT), and Beijing (CST), which share the UTC+8 offset. This alignment supports Western Australia's export-driven economy.
    </p>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════════════════════
     4. WHY AWST STAYS THE SAME ALL YEAR
     ═══════════════════════════════════════════════════════════════════════ -->
<section class="method-section reveal" id="why-stable">
  <div class="method-intro">
    <div class="eyebrow">Consistent Timekeeping</div>
    <h2>Why AWST Stays the Same All Year</h2>
    <p>
      Unlike other Australian states, Western Australia does not observe Daylight Saving Time. As a result, AWST remains fixed at UTC+8 year-round.
    </p>
    <p>
      This consistency is highly beneficial for the mining, agricultural, and logistics sectors, as it eliminates schedule changes and simplifies timezone calculations.
    </p>
  </div>
  
  <!-- SVG 2: TIMELINE (GMT vs AWST Timeline) -->
  <div class="hero-visual" style="max-width: 800px; margin: 24px auto 0;">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 180" width="100%" height="auto" style="background: #0f172a; border-radius: 8px;">
      <text x="400" y="35" font-family="'Space Grotesk', sans-serif" font-size="16" font-weight="bold" fill="#f4fbff" text-anchor="middle">GMT VS AWST YEAR-ROUND TIMELINE OFFSET</text>
      <line x1="80" y1="100" x2="720" y2="100" stroke="#2f6278" stroke-width="4" />
      
      <!-- GMT Node -->
      <circle cx="200" cy="100" r="10" fill="#36c7b5" />
      <text x="200" y="75" font-family="'Space Grotesk', sans-serif" font-size="13" font-weight="bold" fill="#f4fbff" text-anchor="middle">GMT (UTC+0)</text>
      <text x="200" y="130" font-family="'Manrope', sans-serif" font-size="11" fill="#bdd2dc" text-anchor="middle">London (Winter)</text>

      <!-- AWST Node -->
      <circle cx="600" cy="100" r="10" fill="#8fd7ff" />
      <text x="600" y="75" font-family="'Space Grotesk', sans-serif" font-size="13" font-weight="bold" fill="#36c7b5" text-anchor="middle">AWST (UTC+8)</text>
      <text x="600" y="130" font-family="'Manrope', sans-serif" font-size="11" fill="#bdd2dc" text-anchor="middle">Perth (Year-Round)</text>

      <path d="M 200 100 L 200 115 L 600 115 L 600 100" fill="none" stroke="#36c7b5" stroke-width="1.5" opacity="0.5" />
      <text x="400" y="150" font-family="'Space Grotesk', sans-serif" font-size="14" font-weight="bold" fill="#8fd7ff" text-anchor="middle">Constant 8-Hour Difference</text>
    </svg>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════════════════════
     5. GMT VS AWST
     ═══════════════════════════════════════════════════════════════════════ -->
<section class="method-section reveal" id="gmt-vs-awst">
  <div class="method-intro">
    <div class="eyebrow">Standard Clarifications</div>
    <h2>GMT vs AWST</h2>
    <p>
      Greenwich Mean Time (GMT) is a time standard based on the Prime Meridian. It does not change seasonally. AWST is the timezone offset (UTC+8) used in Western Australia.
    </p>
    <p>
      Because AWST is exactly 8 hours ahead of GMT, converting time is straightforward. When London is on standard time, the difference is exactly 8 hours. When London switches to British Summer Time (BST, UTC+1) in the summer, the real-world gap narrows to 7 hours.
    </p>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════════════════════
     6. GMT TO AWST TIME DIFFERENCE
     ═══════════════════════════════════════════════════════════════════════ -->
<section class="method-section reveal" id="time-difference">
  <div class="method-intro">
    <div class="eyebrow">Offset Gaps</div>
    <h2>GMT to AWST Time Difference</h2>
    <p>
      The standard offset difference between GMT and AWST is exactly 8 hours. When it is 12:00 PM GMT, it is 8:00 PM AWST.
    </p>
    <p>
      This constant 8-hour gap simplifies scheduling for teams working across these zones. However, you must account for daylight saving changes in the source region, as the UK and Europe shift their clocks twice a year.
    </p>
  </div>
  
  <!-- SVG 3: TIME DIFFERENCE WHEEL -->
  <div class="hero-visual" style="max-width: 800px; margin: 24px auto 0;">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 240" width="100%" height="auto" style="background: #12455d; border-radius: 8px;">
      <text x="400" y="35" font-family="'Space Grotesk', sans-serif" font-size="16" font-weight="bold" fill="#36c7b5" text-anchor="middle">GMT TO AWST CONCENTRIC TIME SHIFT WHEEL</text>
      
      <circle cx="400" cy="130" r="60" fill="#0c354a" stroke="#2f6278" stroke-width="2" />
      <text x="400" y="135" font-family="'Space Grotesk', sans-serif" font-size="14" font-weight="bold" fill="#f4fbff" text-anchor="middle">UTC+0</text>
      
      <circle cx="260" cy="130" r="40" fill="#071b26" stroke="#36c7b5" stroke-width="2" />
