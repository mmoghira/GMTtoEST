        <div style="background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 1.25rem;">
          <h3 style="margin: 0 0 0.5rem; font-size: 1.05rem; color: var(--accent);">Example 12: Late Afternoon GMT</h3>
          <p style="margin: 0; font-size: 0.93rem;">
            <strong>18:00 GMT → 09:00 HDT (Same Day)</strong><br />
