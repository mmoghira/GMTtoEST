---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import Converter from "theme/components/Converter.astro";
import { getTranslation } from "theme/i18n/config";

const lang = "en";
const dir = "ltr";
const slug = "gmt-to-hdt";
const t = getTranslation(lang);

const pageTitle = "GMT to HDT Converter";
const seoTitle = "GMT to HDT Converter – Convert GMT to Hawaii-Aleutian Daylight Time";
const pageDescription = "Convert GMT to HDT instantly with our free timezone converter. Hawaii-Aleutian Daylight Time (HDT, UTC−9) is 9 hours behind Greenwich Mean Time (GMT, UTC+0). Features 24-hour conversion tables, previous-day date rollover guides, HDT vs HST rules, and developer timezone guides.";

const context = {
  from: "GMT",
  to: "HDT",
  fromZone: "UTC",
  toZone: "America/Adak"
};

function formatHour12(hour: number) {
  const ampm = hour >= 12 ? "PM" : "AM";
  const h = hour % 12 || 12;
  return `${h}:00 ${ampm}`;
}

// 24-hour table: GMT (UTC+0) → HDT (UTC−9) = subtract 9 hours
const conversionRows = Array.from({ length: 24 }, (_, hour) => {
  let hdtHour = hour - 9;
  const prevDay = hdtHour < 0;
  if (prevDay) hdtHour += 24;
  return {
    gmt: formatHour12(hour),
    gmt24: `${String(hour).padStart(2, "0")}:00`,
    hdt: formatHour12(hdtHour),
    hdt24: `${String(hdtHour).padStart(2, "0")}:00`,
    dayNote: prevDay ? "Previous day" : "Same day"
  };
});

const faqs = [
  {
    q: "What is GMT?",
    a: "Greenwich Mean Time (GMT) is the historic solar time standard measured at the Royal Observatory in Greenwich, London, serving as the UTC+0 baseline."
  },
  {
    q: "What is HDT?",
    a: "Hawaii-Aleutian Daylight Time (HDT) is the daylight saving time offset (UTC−9) observed in the Aleutian Islands of Alaska during summer months."
  },
  {
    q: "How many hours behind GMT is HDT?",
    a: "Hawaii-Aleutian Daylight Time (HDT, UTC−9) is exactly 9 hours behind Greenwich Mean Time (GMT, UTC+0)."
  },
  {
    q: "How do I convert GMT to HDT?",
    a: "To convert GMT to HDT, subtract 9 hours from the GMT time. If the resulting hour falls below 00:00 (midnight), add 24 hours to the result and set the date to the previous calendar day."
  },
  {
    q: "What is 12 PM GMT in HDT?",
    a: "12:00 PM (noon) GMT equals 03:00 AM HDT on the exact same calendar day."
  },
  {
    q: "What is 12 AM GMT in HDT?",
    a: "00:00 (midnight) GMT equals 15:00 (3:00 PM) HDT on the previous calendar day."
  },
  {
    q: "What is 06:00 GMT in HDT?",
    a: "06:00 AM GMT equals 21:00 (9:00 PM) HDT on the previous calendar day."
  },
  {
    q: "What is 09:00 GMT in HDT?",
    a: "09:00 AM GMT equals 00:00 (midnight) HDT at the very start of the same calendar day."
  },
  {
    q: "Does GMT to HDT change the date?",
    a: "Yes. Because HDT is 9 hours behind GMT, early morning GMT hours (from 00:00 to 08:59 GMT) take place during the afternoon or evening of the previous calendar day in HDT."
  },
  {
    q: "What is the difference between HDT and HST?",
    a: "HDT is Hawaii-Aleutian Daylight Time (UTC−9, used during summer daylight saving in the Aleutian Islands), whereas HST is Hawaii-Aleutian Standard Time (UTC−10, used during winter in the Aleutians and year-round in the state of Hawaii)."
  },
  {
    q: "Does Hawaii use HDT?",
    a: "No. The state of Hawaii does NOT observe daylight saving time and stays on Hawaii Standard Time (HST, UTC−10) year-round. HDT (UTC−9) applies specifically to the Aleutian Islands portion of Alaska during DST."
  },
  {
    q: "Does Hawaii observe daylight saving time?",
    a: "No. Hawaii is one of two US states (along with most of Arizona) that does not observe daylight saving time."
  },
  {
    q: "What is GMT to Hawaii time?",
    a: "Because Hawaii uses HST (UTC−10) year-round, Hawaii local time is calculated by subtracting 10 hours from GMT year-round. HDT (UTC−9) applies 9 hours behind GMT for the Aleutian Islands in summer."
  },
  {
    q: "Is HDT always UTC−9?",
    a: "Yes. By definition, Hawaii-Aleutian Daylight Time (HDT) represents the UTC−9 offset."
  },
  {
    q: "How can I convert GMT to HDT accurately?",
    a: "Use our interactive conversion tool above to calculate exact clock times, 9-hour offsets, and previous-day calendar shifts automatically."
  }
];

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "GMT to HDT, GMT to HDT converter, GMT HDT converter, convert GMT to HDT, GMT to Hawaii-Aleutian Daylight Time, GMT to Hawaii-Aleutian Time, GMT HDT time difference, GMT to HDT time converter, GMT HDT conversion, GMT to HDT calculator, HDT UTC-9, GMT UTC+0, GMT vs HDT, HDT vs GMT, HDT vs HST, GMT to Hawaii time, what time is GMT in HDT, GMT to HDT time difference, GMT to HDT conversion",
  image: "/assets/gmt-to-hdt-og.webp",
  imageAlt: "GMT to HDT Converter - Greenwich Mean Time to Hawaii-Aleutian Daylight Time",
  faqs,
  appDescription: "Free online GMT to HDT converter tool. Convert Greenwich Mean Time to Hawaii-Aleutian Daylight Time with instant previous-day date calculations, 24-hour schedules, and Aleutian business guides.",
  applicationCategory: "UtilityApplication",
  operatingSystem: "Any",
  howToName: "How to Convert GMT to HDT",
  howToDescription: "Convert Greenwich Mean Time (GMT, UTC+0) to Hawaii-Aleutian Daylight Time (HDT, UTC−9) by subtracting 9 hours.",
  howToSteps: [
    { name: "Obtain the GMT date and time", text: "Identify the starting Greenwich Mean Time (UTC+0)." },
    { name: "Subtract 9 hours", text: "Subtract 9 hours from the GMT time value." },
    { name: "Check for previous-day rollover", text: "If the resulting hour is below 00:00 (midnight), add 24 hours to the time and set the date to the previous calendar day." },
    { name: "Confirm final HDT output", text: "Record the final converted HDT time and calendar date (UTC−9)." }
  ]
};
