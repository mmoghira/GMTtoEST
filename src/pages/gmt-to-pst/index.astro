---
import BaseLayout from "theme/layouts/BaseLayout.astro";
import Converter from "theme/components/Converter.astro";
import { getTranslation, pageUrl, siteUrl } from "theme/i18n/config";

const lang = "en";
const dir = "ltr";
const slug = "gmt-to-pst";
const t = getTranslation(lang);

const pageTitle = "GMT to PST Converter";
const seoTitle = "GMT to PST Converter – Greenwich Mean Time to Pacific Standard Time";
const pageDescription = "Convert GMT to PST instantly. Calculate the exact 8-hour time difference between Greenwich Mean Time and Pacific Standard Time with live clocks, meeting planners, and conversion tables.";

const context = {
  from: "GMT",
  to: "PST",
  fromZone: "UTC",
  toZone: "America/Los_Angeles"
};

const canonical = `${siteUrl}/gmt-to-pst/`;

// 24-hour conversion table data (GMT → PST = GMT - 8 hours)
function formatHour12(hour: number) {
  const normalized = ((hour % 24) + 24) % 24;
  const period = normalized < 12 ? "AM" : "PM";
  const displayHour = normalized % 12 || 12;
  return `${displayHour}:00 ${period}`;
}

const conversionRows = Array.from({ length: 24 }, (_, hour) => {
  const pstHour = hour - 8;
  const pstNormalized = ((pstHour % 24) + 24) % 24;
  const prevDay = pstHour < 0;
  const period = pstNormalized < 12 ? "AM" : "PM";
  const displayHour = pstNormalized % 12 || 12;
  return {
    gmt: formatHour12(hour),
    pst: `${displayHour}:00 ${period}${prevDay ? " (-1 day)" : ""}`,
    dayNote: prevDay ? "Previous day" : "Same day"
  };
});

// Popular conversions
const popularConversions = [
  { gmt: "12:00 AM (Midnight)", pst: "4:00 PM (Prev Day)", note: "Late afternoon in Silicon Valley, midnight in London" },
  { gmt: "4:00 AM", pst: "8:00 PM (Prev Day)", note: "Night in the UK, evening in California" },
  { gmt: "8:00 AM", pst: "12:00 AM (Midnight)", note: "London workday begins, midnight on the US West Coast" },
  { gmt: "10:00 AM", pst: "2:00 AM", note: "Mid-morning focus hours in UK, deep night in San Francisco" },
  { gmt: "12:00 PM (Noon)", pst: "4:00 AM", note: "Lunchtime in Greenwich, early pre-dawn hours in Seattle" },
  { gmt: "4:00 PM", pst: "8:00 AM", note: "Late afternoon in UK, US West Coast business day kick-off" },
  { gmt: "5:00 PM", pst: "9:00 AM", note: "End of European office hours, active morning in Silicon Valley" },
  { gmt: "6:00 PM", pst: "10:00 AM", note: "Evening in London, peak morning collaboration hour in LA" },
  { gmt: "7:00 PM", pst: "11:00 AM", note: "Dinner time in Britain, late morning engineering standup in SF" },
  { gmt: "9:00 PM", pst: "1:00 PM", note: "Night in London, lunchtime in San Francisco" },
  { gmt: "11:00 PM", pst: "3:00 PM", note: "Bedtime in the UK, mid-afternoon in California" },
  { gmt: "11:59 PM", pst: "3:59 PM", note: "End of GMT calendar day, late afternoon in Pacific Time" }
];

// FAQ data
const faqs = [
  { q: "What is the time difference between GMT and PST?", a: "Pacific Standard Time (PST, UTC-8) is exactly 8 hours behind Greenwich Mean Time (GMT, UTC+0). When it is 5:00 PM GMT in London, it is 9:00 AM PST in Los Angeles or San Francisco." },
  { q: "What does PST stand for?", a: "PST stands for Pacific Standard Time. It is the standard time zone covering the western region of North America, operating at UTC-8 during winter standard time." },
  { q: "What does GMT stand for?", a: "GMT stands for Greenwich Mean Time. It is the astronomical time baseline established at the Royal Observatory in Greenwich, London, operating at UTC+0." },
  { q: "Does the 8-hour gap between GMT and PST change during daylight saving time?", a: "Yes. When the UK switches to British Summer Time (BST, UTC+1) and North America switches to Pacific Daylight Time (PDT, UTC-7), the difference between local UK time and local West Coast time becomes 8 hours. However, during the 2-to-3 week transition periods in March and October when clock changes do not align, the gap briefly shifts to 7 or 9 hours." },
  { q: "Which major cities observe Pacific Standard Time (PST)?", a: "Major cities observing PST (UTC-8) include Los Angeles, San Francisco, Seattle, San Diego, Portland, San Jose, Sacramento, Vancouver (Canada), and Tijuana (Mexico)." },
  { q: "Which major cities observe Greenwich Mean Time (GMT)?", a: "Cities observing GMT (UTC+0) during winter include London, Dublin, Lisbon, Reykjavik, Accra, and Dakar." },
  { q: "How do I calculate GMT to PST manually?", a: "To convert GMT to PST manually, subtract 8 hours from the GMT time. For example, 4:00 PM GMT (16:00) minus 8 hours equals 8:00 AM PST. If the calculation goes below 00:00, subtract from 24 to find the previous day's time." },
  { q: "What is the best time to schedule a meeting between London (GMT) and California (PST)?", a: "The optimal meeting window is between 4:00 PM and 7:00 PM GMT, which matches 8:00 AM to 11:00 AM PST. This provides a convenient morning window for Pacific Coast participants and late afternoon for European teams." },
  { q: "Does San Francisco use PST year-round?", a: "No. San Francisco observes PST (UTC-8) during winter (from early November to mid-March) and PDT (Pacific Daylight Time, UTC-7) during summer." },
  { q: "Is GMT the same as UTC?", a: "For civil timekeeping purposes, GMT and UTC (Coordinated Universal Time) are identical at offset +0. However, UTC is an atomic time standard, while GMT refers to the historical solar time zone." },
  { q: "Is London always on GMT?", a: "No. London is on GMT (UTC+0) during winter, but advances by 1 hour to British Summer Time (BST, UTC+1) from late March to late October." },
  { q: "Why is GMT to PST crucial for tech companies?", a: "Silicon Valley tech giants (Google, Apple, Meta, Microsoft) maintain major regional headquarters and engineering teams in London. Managing code deployments and architecture syncs across the 8-hour gap is vital." },
  { q: "How does movie premiere timing work between Hollywood and London?", a: "Hollywood film releases and live streaming announcements timed for 9:00 AM PST occur at 5:00 PM GMT, allowing European audiences to join evening viewings." },
  { q: "What happens to stock exchanges between London and the US West Coast?", a: "The London Stock Exchange (LSE) closes at 4:30 PM GMT (8:30 AM PST), right as business hours begin on the US Pacific Coast, allowing a 30-minute window for cross-market announcements." },
  { q: "How does international air travel handle the GMT to PST transition?", a: "Direct flights from London Heathrow (LHR) to Los Angeles (LAX) take roughly 11 hours. A flight departing London at 12:00 PM GMT lands at 3:00 PM PST local time on the same day due to gaining 8 hours flying west." },
  { q: "What is the IANA identifier for GMT?", a: "In software development, GMT is represented by the IANA database identifier 'UTC' or 'Etc/GMT'." },
  { q: "What is the IANA identifier for PST?", a: "For North American Pacific Time, the standard IANA database identifier is 'America/Los_Angeles'." },
  { q: "What is 12 PM GMT in PST?", a: "12:00 PM (Noon) GMT equals 4:00 AM PST on the same day." },
  { q: "What is 5 PM GMT in PST?", a: "5:00 PM GMT equals 9:00 AM PST on the same day, marking the start of the joint collaboration window." },
  { q: "What is 8 PM GMT in PST?", a: "8:00 PM GMT equals 12:00 PM (Noon) PST on the same day." },
  { q: "What is 10 PM GMT in PST?", a: "10:00 PM GMT equals 2:00 PM PST on the same day." },
  { q: "Does PST cover Vancouver and British Columbia?", a: "Yes, Vancouver and most of British Columbia, Canada observe Pacific Standard Time (UTC-8) in winter and Pacific Daylight Time (UTC-7) in summer." },
  { q: "Is Las Vegas in the PST time zone?", a: "Yes, Las Vegas, Nevada is located in the Pacific Time Zone, operating on PST (UTC-8) in winter." },
  { q: "Does Oregon use PST?", a: "Most of Oregon uses Pacific Standard Time (UTC-8), except for Malheur County which observes Mountain Time." },
  { q: "Why is Pacific Time abbreviated as PST rather than PT?", a: "PST specifically refers to Pacific Standard Time (UTC-8). PT (Pacific Time) is the generic term that covers both PST in winter and PDT in summer." },
  { q: "What time is 1 AM GMT in PST?", a: "1:00 AM GMT equals 5:00 PM PST on the previous calendar day." },
  { q: "What time is 6 AM GMT in PST?", a: "6:00 AM GMT equals 10:00 PM PST on the previous calendar day." },
  { q: "What time is 2 PM GMT in PST?", a: "2:00 PM GMT equals 6:00 AM PST on the same day." },
  { q: "What time is 6 PM GMT in PST?", a: "6:00 PM GMT equals 10:00 AM PST on the same day." },
  { q: "Is Seattle in PST?", a: "Yes, Seattle, Washington is in the Pacific Time Zone, operating on PST (UTC-8) in winter." },
  { q: "How many hours is California behind London during winter?", a: "California (PST, UTC-8) is exactly 8 hours behind London (GMT, UTC+0) during winter standard time." },
  { q: "What time is 3 AM GMT in PST?", a: "3:00 AM GMT equals 7:00 PM PST on the previous calendar day." },
  { q: "What time is 9 AM GMT in PST?", a: "9:00 AM GMT equals 1:00 AM PST on the same day." },
  { q: "What time is 1 PM GMT in PST?", a: "1:00 PM GMT equals 5:00 AM PST on the same day." },
  { q: "What time is 3 PM GMT in PST?", a: "3:00 PM GMT equals 7:00 AM PST on the same day." },
  { q: "What time is 8 PM GMT in PST?", a: "8:00 PM GMT equals 12:00 PM (Noon) PST on the same day." },
  { q: "Does San Diego observe PST?", a: "Yes, San Diego, California operates on Pacific Standard Time (UTC-8) during winter." },
  { q: "What time is 5 AM GMT in PST?", a: "5:00 AM GMT equals 9:00 PM PST on the previous calendar day." },
  { q: "What time is 11 AM GMT in PST?", a: "11:00 AM GMT equals 3:00 AM PST on the same day." },
  { q: "What time is 10 PM GMT in PST?", a: "10:00 PM GMT equals 2:00 PM PST on the same day." },
  { q: "What time is 7 AM GMT in PST?", a: "7:00 AM GMT equals 11:00 PM PST on the previous day." },
  { q: "What time is 4 PM GMT in PST?", a: "4:00 PM GMT equals 8:00 AM PST on the same day." },
  { q: "What time is 11 PM GMT in PST?", a: "11:00 PM GMT equals 3:00 PM PST on the same day." }
];

const meta = {
  seoTitle,
  description: pageDescription,
  keywords: "GMT to PST, Greenwich Mean Time to Pacific Standard Time, GMT PST converter, convert GMT to PST, London time to Los Angeles, London to San Francisco time, UK to California time, 8 hour time difference",
  image: "/assets/gmt-to-pst-og.svg",
  imageAlt: "GMT to PST Timezone Converter Diagram",
  faqs,
  appDescription: "Free online GMT to PST converter featuring real-time interactive clocks, DST-aware calculations, 24-hour schedules, and global team meeting planners.",
  applicationCategory: "UtilityApplication",
  operatingSystem: "Any",
  howToName: "How to Convert GMT to PST",
  howToDescription: "Simple steps to convert Greenwich Mean Time (GMT) to Pacific Standard Time (PST).",
  howToSteps: [
    { name: "Enter GMT Time", text: "Select your desired hour and date in Greenwich Mean Time." },
    { name: "Check the Offset", text: "Note the 8-hour difference (PST is 8 hours behind GMT during winter standard time)." },
    { name: "View Converted PST", text: "Read the converted Pacific Standard Time along with any calendar date shift." },
    { name: "Share or Schedule", text: "Use the copy button or meeting planner to coordinate across transatlantic teams." }
  ]
};
---

<BaseLayout
  lang={lang}
  dir={dir}
  title={seoTitle}
  description={pageDescription}
  slug={slug}
  meta={meta}
  mode="gmt-est"
  enableFaqSchema={true}
  allowAds={true}
  breadcrumbHomeLabel="Home"
  breadcrumbLabel="GMT to PST"
  hreflangCodes={["en"]}
>

<!-- ═══════════════════════════════════════════════════════════════════════════
     H1 & HERO SECTION
     ═══════════════════════════════════════════════════════════════════════ -->
<section class="hero-banner">
  <h1 class="hero-banner-title">
    GMT to PST <span class="gradient-text">Converter</span>
  </h1>
</section>

<!-- PRIMARY CONVERTER & LIVE CLOCKS (Above the Fold) -->
<div style="max-width: 720px; margin: 0 auto; padding: 0 16px 24px;">
  <Converter intent="dynamic" t={t} context={context} />
  
  <div class="live-clock-strip" style="margin-top: 16px; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px;">
    <div class="clock-card" style="text-align: center; padding: 12px 16px; background: var(--panel); border: 1px solid var(--line); border-radius: 10px;">
      <span class="eyebrow" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); display: block; margin-bottom: 4px;">Live Source Time</span>
      <strong class="top-gmt-clock" style="font-size: 1.25rem; font-family: 'Space Grotesk', sans-serif; color: var(--accent); font-weight: 700;">--:--:--</strong>
    </div>
    <div class="clock-card" style="text-align: center; padding: 12px 16px; background: var(--panel); border: 1px solid var(--line); border-radius: 10px;">
      <span class="eyebrow" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); display: block; margin-bottom: 4px;">Live Target Time</span>
      <strong class="top-est-clock" style="font-size: 1.25rem; font-family: 'Space Grotesk', sans-serif; color: var(--accent); font-weight: 700;">--:--:--</strong>
      <em class="top-est-zone" style="font-size: 0.8rem; color: var(--muted); font-style: normal; margin-left: 4px;">ET</em>
    </div>
  </div>
</div>


<!-- FEATURE ICONS STRIP -->
<section class="feature-strip" aria-label="Key Tool Features">
  <div class="feature-item">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feature-icon" aria-hidden="true">
      <circle cx="12" cy="12" r="10"></circle>
      <polyline points="12 6 12 12 16 14"></polyline>
    </svg>
    <span>8-Hour Subtraction Math</span>
  </div>
  <div class="feature-item">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feature-icon" aria-hidden="true">
      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
      <line x1="16" y1="2" x2="16" y2="6"></line>
      <line x1="8" y1="2" x2="8" y2="6"></line>
      <line x1="3" y1="10" x2="21" y2="10"></line>
    </svg>
    <span>Automated Calendar Tracking</span>
  </div>
  <div class="feature-item">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feature-icon" aria-hidden="true">
