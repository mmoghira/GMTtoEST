        </g>

        <!-- Right Clock: Pacific Standard Time (UTC-8) -->
        <g transform="translate(460, 115)">
          <circle cx="0" cy="0" r="50" fill="#12455d" stroke="#2f6278" stroke-width="3" />
          <line x1="0" y1="0" x2="-28" y2="-10" stroke="#bdd2dc" stroke-width="3" stroke-linecap="round" />
          <line x1="0" y1="0" x2="0" y2="-32" stroke="#f4fbff" stroke-width="4" stroke-linecap="round" />
          <circle cx="0" cy="0" r="4" fill="#36c7b5" />
