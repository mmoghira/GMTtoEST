  <div class="clock-card"><span>Current PST (UTC-8)</span><strong id="estClock">--:--</strong><em id="estZone">PST</em></div>
</section>

<!-- REGIONAL SKYLINE ILLUSTRATION (BIG BEN & GOLDEN GATE BRIDGE) -->
<section class="skyline-container content-section" style="text-align: center; margin: 3rem 0;">
  <h3 class="sr-only">London Big Ben & San Francisco Golden Gate Graphics</h3>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 200" width="100%" height="auto" style="display: block; max-width: 800px; margin: 0 auto; background: linear-gradient(180deg, #0c354a 0%, #12455d 100%); border-radius: 12px; border: 1px solid var(--line);">
    <!-- Stars -->
    <circle cx="100" cy="30" r="1.5" fill="#f4fbff" opacity="0.5" />
    <circle cx="280" cy="20" r="1.5" fill="#f4fbff" opacity="0.4" />
    <circle cx="520" cy="35" r="2" fill="#36c7b5" opacity="0.7" />
    <circle cx="740" cy="25" r="1" fill="#f4fbff" opacity="0.5" />

