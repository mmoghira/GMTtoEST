          <line x1="0" y1="0" x2="22" y2="0" stroke="#8fd7ff" stroke-width="4" stroke-linecap="round" />
          <circle cx="0" cy="0" r="4" fill="#36c7b5" />
          <text x="0" y="70" font-family="'Space Grotesk', sans-serif" font-weight="bold" font-size="14" fill="#f4fbff" text-anchor="middle">London / Greenwich (GMT)</text>
