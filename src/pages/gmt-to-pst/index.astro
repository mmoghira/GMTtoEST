        <path d="M40 160 C 160 60, 240 240, 380 100 C 470 40, 520 180, 560 80" fill="none" stroke="#36c7b5" stroke-width="3" opacity="0.8" />
        
        <!-- Left Clock: Greenwich Mean Time (UTC+0) -->
        <g transform="translate(140, 115)">
          <circle cx="0" cy="0" r="50" fill="#12455d" stroke="#36c7b5" stroke-width="3" />
