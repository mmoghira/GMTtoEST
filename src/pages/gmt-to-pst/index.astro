          <rect x="-45" y="-35" width="90" height="26" rx="13" fill="#1b536e" stroke="#36c7b5" stroke-width="1.5" />
          <text x="0" y="-18" font-family="'Space Grotesk', sans-serif" font-weight="bold" font-size="12" fill="#36c7b5" text-anchor="middle">PST is -8 HRS</text>
