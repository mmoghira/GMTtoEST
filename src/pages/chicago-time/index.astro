          <text x="500" y="95" fill="var(--text)" font-family="Space Grotesk, sans-serif" font-size="13" text-anchor="middle">New York (EST/EDT)</text>
          <text x="500" y="150" fill="var(--muted)" font-size="12" text-anchor="middle">UTC-5 / UTC-4</text>

